#Область ПрограммныйИнтерфейс

// Получить все статьи помощи как Соответствие(Ключ → Структура).
//
// Возвращаемое значение:
//   Соответствие: Ключ (Строка) → Структура(Заголовок, Группа, Markdown)
//
Функция ПолучитьВсеСтатьи() Экспорт

	Статьи = Новый Соответствие;

	// --- checklist_деньx_новой_станции ---
	Статьи.Вставить("checklist_деньx_новой_станции", Новый Структура(
		"Заголовок, Группа, Markdown",
		"Чек-лист: День X для следующей АЗС",
		"checklist",
		"# Чек-лист: День X для следующей АЗС"
		+ Символы.ПС + ""
		+ Символы.ПС + "Выполняется при переводе очередной станции с прежней организации (Норд-Лайн) на ГАЗИНВЕСТГРУПП. Бухгалтер выполняет действия в БП ГИГ; параллельно товаровед — в центральной базе."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Предусловия"
		+ Символы.ПС + ""
		+ Символы.ПС + "- Согласован договор купли-продажи между прежней и новой организацией."
		+ Символы.ПС + "- Согласована точная дата и время Дня X."
		+ Символы.ПС + "- Бэкап БП ГИГ сделан до начала операции."
		+ Символы.ПС + "- В БП ГИГ заведено подразделение и склад для переводимой АЗС."
		+ Символы.ПС + "- В **TradeLedger → Настройки обмена сопутки** и **Настройки обмена общепита** проверены параметры (особенно склад и подразделение по новой АЗС)."
		+ Символы.ПС + "- Маркируемые товары (Честный Знак) при переводе между АЗС одного ИНН выводить через MSN_ПеремещениеМеждуАЗС в центральной базе **до** Дня X."
		+ Символы.ПС + ""
		+ Символы.ПС + "## T − 1 час"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Открыть **TradeLedger → Сверка пакетов с источником**, проверить что нет «висящих» жёлтых/красных пакетов по этой АЗС от предыдущих смен."
		+ Символы.ПС + "- [ ] Если есть — устранить (см. [checklist_реакция_на_ошибку](checklist_реакция_на_ошибку.md))."
		+ Символы.ПС + "- [ ] В форме «Загрузка из STS» нажать **«Подробный отчёт ошибок»** — за сегодня не должно быть критичных ошибок по этой АЗС."
		+ Символы.ПС + "- [ ] Сообщить центральной базе: бухгалтерия готова к приёму Дня X."
		+ Символы.ПС + ""
		+ Символы.ПС + "## T (момент перевода)"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Центральная база проводит документ MSN_ПередачаДняX — он формирует:"
		+ Символы.ПС + "  - Корректировку остатков регистра ТоварыОрганизаций (расход у Норд-Лайн, приход у ГИГ)."
		+ Символы.ПС + "  - РеализациюТоваровУслуг (Норд-Лайн → Контрагент-ГИГ)."
		+ Символы.ПС + "  - ПоступлениеТоваровУслугНаАЗК (Контрагент-Норд-Лайн → ГИГ) — пакет с kind=purchase прилетает в БП ГИГ."
		+ Символы.ПС + "- [ ] На АЗС оператор переключает основную организацию через RDP с Норд-Лайн на ГАЗИНВЕСТГРУПП."
		+ Символы.ПС + ""
		+ Символы.ПС + "## T + 5-10 минут"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] В форме «Загрузка из STS» в меню «Ещё» → «Опросить каталог» → должен быть новый пакет переноса остатков."
		+ Символы.ПС + "- [ ] Загрузить пакет → создаётся ПТУ от контрагента-Норд-Лайн."
		+ Символы.ПС + "- [ ] Проверить документ:"
		+ Символы.ПС + "  - Контрагент — Норд-Лайн как поставщик."
		+ Символы.ПС + "  - Договор — отдельный по передаче (или общий «прочие операции»)."
		+ Символы.ПС + "  - Сумма — соответствует акту приёма-передачи."
		+ Символы.ПС + "  - Проводки — 41.02/60.01 + 19.03/60.01."
		+ Символы.ПС + "- [ ] Провести документ."
		+ Символы.ПС + ""
		+ Символы.ПС + "## T + 30 минут"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Открыть **TradeLedger → Сверка пакетов с источником**."
		+ Символы.ПС + "- [ ] Найти пакет передачи остатков."
		+ Символы.ПС + "- [ ] Проверить статус «ПринятоЦеликом», расхождение = 0."
		+ Символы.ПС + "- [ ] Если расхождение есть — срочно разобрать, до возобновления работы АЗС."
		+ Символы.ПС + ""
		+ Символы.ПС + "## T + 1 час"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Стандартный цикл приёма пакетов восстановлен — открыть форму «Загрузка из STS», переключить режим Сопутка/Общепит → должны приходить пакеты уже от ГАЗИНВЕСТГРУПП."
		+ Символы.ПС + "- [ ] Загрузить пакеты обычным способом."
		+ Символы.ПС + "- [ ] Проверить что в TL_СоответствиеИсточников новые записи привязаны к новой организации."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Период стабилизации (3-7 дней)"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Ежедневный приём — повышенное внимание к сверке."
		+ Символы.ПС + "- [ ] Сравнение остатков по 41.02 БП ГИГ с фактическими остатками АЗС."
		+ Символы.ПС + "- [ ] При обнаружении расхождений — корректировка через стандартные документы БП (Инвентаризация → Списание/Оприходование) с согласованием."
		+ Символы.ПС + "- [ ] Если за период появились ошибки маппинга оплат — устранить через **TradeLedger → Маппинг видов оплат STS** + «Перезагрузить период» → «Дозагрузить»."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Возврат назад (если что-то пошло не так)"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] В центральной базе отменить проведение MSN_ПередачаДняX → автоматически откатятся регистры остатков и связанные документы (через ОбработкаУдаленияПроведения)."
		+ Символы.ПС + "- [ ] В БП ГИГ — отменить проведение и пометить на удаление принятые документы по этой передаче."
		+ Символы.ПС + "- [ ] Если связь с пакетами нужно очистить — использовать **«Сбросить регистрацию»** (в меню «Ещё» формы «Загрузка из STS») для затронутого периода."
		+ Символы.ПС + "- [ ] Восстановить из бэкапа БП ГИГ если изменений много."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Связано"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [настройка_сопутки](настройка_сопутки.md)"
		+ Символы.ПС + "- [настройка_общепита](настройка_общепита.md)"
		+ Символы.ПС + "- [проводки_покупки](проводки_покупки.md)"
		+ Символы.ПС + "- [checklist_ежедневный_приём](checklist_ежедневный_приём.md)"
		+ Символы.ПС + "- [faq_перезагрузить_период](faq_перезагрузить_период.md)"
		+ Символы.ПС + "- [faq_подробный_отчёт_ошибок](faq_подробный_отчёт_ошибок.md)"
		+ Символы.ПС + ""
	));

	// --- checklist_ежедневный_приём ---
	Статьи.Вставить("checklist_ежедневный_приём", Новый Структура(
		"Заголовок, Группа, Markdown",
		"Чек-лист: Ежедневный приём пакетов",
		"checklist",
		"# Чек-лист: Ежедневный приём пакетов"
		+ Символы.ПС + ""
		+ Символы.ПС + "Выполняется один или несколько раз в день в зависимости от частоты поступления данных из STS API (топливо) и центральной базы (сопутка, общепит)."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Утренний приём (вчерашние смены)"
		+ Символы.ПС + ""
		+ Символы.ПС + "### Шаг 1. Топливо (STS API)"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Открыть **TradeLedger → Загрузка из STS (топливо)**."
		+ Символы.ПС + "- [ ] В меню «Ещё» проверить что режим = «Нефтепродукты»."
		+ Символы.ПС + "- [ ] Установить «Дата начала» = вчера, «Дата окончания» = вчера (или текущий период)."
		+ Символы.ПС + "- [ ] Нажать «Обновить» — данные подтянутся через STS API за указанный период."
		+ Символы.ПС + "- [ ] Внешняя таблица заполнится сменами. Если ожидаемых смен нет — проверить лог на ошибки авторизации или сети STS."
		+ Символы.ПС + "- [ ] Отметить новые смены (кнопка «Выбрать все») → «◀ Загрузить выбранные»."
		+ Символы.ПС + "- [ ] Дождаться завершения, прочитать журнал."
		+ Символы.ПС + ""
		+ Символы.ПС + "### Шаг 2. Сопутка"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] В меню «Ещё» переключить режим на «Сопутка»."
		+ Символы.ПС + "- [ ] Нажать «Опросить каталог» — журнал покажет сколько новых файлов и сколько уже загружено."
		+ Символы.ПС + "- [ ] «Обновить» → внешняя таблица заполнится."
		+ Символы.ПС + "- [ ] Отметить все строки → «◀ Загрузить выбранные»."
		+ Символы.ПС + "- [ ] Дождаться завершения, прочитать журнал."
		+ Символы.ПС + ""
		+ Символы.ПС + "### Шаг 3. Общепит"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] В меню «Ещё» переключить режим на «Общепит»."
		+ Символы.ПС + "- [ ] Повторить шаги 2 — опрос каталога и загрузка."
		+ Символы.ПС + ""
		+ Символы.ПС + "### Шаг 4. Контроль сверки"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Открыть **TradeLedger → Сверка пакетов с источником**."
		+ Символы.ПС + "- [ ] Период по умолчанию — последние 7 дней. Можно сузить до вчера."
		+ Символы.ПС + "- [ ] Проверить статусы:"
		+ Символы.ПС + "  - Зелёные («ПринятоЦеликом») — действий не требуется."
		+ Символы.ПС + "  - Жёлтые («ПринятоЧастично») — открыть «Показать ошибки пакета», см. [checklist_реакция_на_ошибку](checklist_реакция_на_ошибку.md)."
		+ Символы.ПС + "  - Красные («Отклонено») — то же, срочнее."
		+ Символы.ПС + "- [ ] Записать расхождения если они есть."
		+ Символы.ПС + ""
		+ Символы.ПС + "### Шаг 5. Подробный отчёт ошибок"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] В форме «Загрузка из STS» нажать **«Подробный отчёт ошибок»**."
		+ Символы.ПС + "- [ ] Открывшийся отчёт показывает все ошибки за сегодня сгруппированные по категориям."
		+ Символы.ПС + "- [ ] Если ошибок нет — «✓ Ошибок нет», закрыть окно."
		+ Символы.ПС + "- [ ] Если есть — для каждой категории прочитать блок «Что делать», при необходимости открыть «📖 Подробнее»."
		+ Символы.ПС + ""
		+ Символы.ПС + "### Шаг 6. Подтверждение"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Все пакеты обработаны — сообщить центральной базе (если требуется по регламенту)."
		+ Символы.ПС + "- [ ] Записать в свой журнал: «Приём за дату N — N пакетов, M ошибок, расхождение X ₽»."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Дневной приём (текущие смены)"
		+ Символы.ПС + ""
		+ Символы.ПС + "Аналогично утреннему, но обычно меньший объём. Период приёма зависит от регламента центральной базы (часто 12:00, 18:00, 24:00)."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Когда нужно подключить администратора расширения"
		+ Символы.ПС + ""
		+ Символы.ПС + "- При появлении ошибок с категорией **STS_ОшибкаСервера** (HTTP 5xx) если повторяются более 30 минут."
		+ Символы.ПС + "- При расхождениях > 100 ₽ за один пакет."
		+ Символы.ПС + "- При систематических ошибках по одному поставщику."
		+ Символы.ПС + "- При недоступности каталога OwnCloud (журнал сообщает об ошибке проверки)."
		+ Символы.ПС + "- При появлении категории **МаппингОплат_НеНайден** с новым именем — нужно завести запись в маппинге."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Связано"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [загрузка_пакета](загрузка_пакета.md)"
		+ Символы.ПС + "- [сверка_пакета](сверка_пакета.md)"
		+ Символы.ПС + "- [диагностика_ошибок](диагностика_ошибок.md)"
		+ Символы.ПС + "- [checklist_реакция_на_ошибку](checklist_реакция_на_ошибку.md)"
		+ Символы.ПС + "- [faq_подробный_отчёт_ошибок](faq_подробный_отчёт_ошибок.md)"
		+ Символы.ПС + ""
	));

	// --- checklist_конец_месяца ---
	Статьи.Вставить("checklist_конец_месяца", Новый Структура(
		"Заголовок, Группа, Markdown",
		"Чек-лист: Закрытие месяца",
		"checklist",
		"# Чек-лист: Закрытие месяца"
		+ Символы.ПС + ""
		+ Символы.ПС + "Выполняется в первой декаде следующего месяца после окончания приёма пакетов за отчётный месяц."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Шаг 1. Проверка полноты приёма"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Открыть **TradeLedger → Сверка пакетов с источником**."
		+ Символы.ПС + "- [ ] Указать период — весь отчётный месяц."
		+ Символы.ПС + "- [ ] Проверить количество пакетов:"
		+ Символы.ПС + "  - Сравнить с журналом ежедневного приёма — все ли смены центральной базы пришли."
		+ Символы.ПС + "  - Сравнить с центральной базой — все ли смены выгружены."
		+ Символы.ПС + "- [ ] Если есть недостающие пакеты — запросить переформирование в центральной базе."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Шаг 2. Сверка по статусам"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Все пакеты должны быть «ПринятоЦеликом» или «ПринятоЧастично» с понятным комментарием."
		+ Символы.ПС + "- [ ] «Отклонено» — недопустимо для закрытого месяца, разобрать и принять."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Шаг 3. Сверка сумм"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Итого сумма ЦБ vs Итого сумма БП — расхождение по модулю не должно превышать допустимое значение (обычно <0.5% от оборота)."
		+ Символы.ПС + "- [ ] Если расхождение больше — разобрать каждый пакет с расхождением, см. [faq_расхождение_в_сверке](faq_расхождение_в_сверке.md)."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Шаг 4. Сверка по контрагентам (поставщикам)"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] В стандартном отчёте БП «Расчёты с поставщиками» (по сч. 60.01 / 60.02) — проверить остатки."
		+ Символы.ПС + "- [ ] Сверить с актами сверки поставщиков (за месяц или за квартал)."
		+ Символы.ПС + "- [ ] При расхождениях — найти оригинальные ПТУ через **TradeLedger → Сверка пакетов с источником** → «Документы пакета»."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Шаг 5. Сверка по 41-м счетам (товары)"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Отчёт «Оборотно-сальдовая ведомость» по счёту 41.02 за месяц."
		+ Символы.ПС + "- [ ] Сверить с центральной базой — отчёт об остатках товара на конец периода."
		+ Символы.ПС + "- [ ] Допустимое расхождение в количественном выражении — нулевое (если расхождение есть — разбирать каждую SKU отдельно)."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Шаг 6. Розничная выручка"
		+ Символы.ПС + ""
		+ Символы.ПС + "- [ ] Отчёт «Карточка счёта 90.01.1» за месяц."
		+ Символы.ПС + "- [ ] Сверить с фискальными отчётами ККМ за месяц."
		+ Символы.ПС + "- [ ] При расхождениях — проверить полноту приёма ОРП и каналов оплат."
		+ Символы.ПС + ""
		+ Символы.ПС + "## Шаг 7. Финальная проверка ошибок"
