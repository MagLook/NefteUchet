////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_МаппингЦБ
// Расширение ElsyPlus Ledger v6.0 для 1С:БП 3.0
// Контекст: Сервер
//
// Маппинг UUID источника (ЦБ ЭЛСИ.АЗК) на объекты БП ГИГ через
// РегистрСведений.TL_СоответствиеИсточников. Источник правды:
// контракт §6 (НСИ) + §8 (Перечисления) — 09_Контракт_HTTP_ЦБ_БП.md.
//
// Каждая функция возвращает либо ссылку на объект БП, либо Неопределено.
// При создании новой связки автоматически записывает соответствие.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// ============================================================================
//  ОРГАНИЗАЦИЯ
// ============================================================================

// Найти Организацию БП по UUID источника или по ИНН (fallback).
// Контракт §6.1.
//
// Параметры:
//   ИсточникUUID - Строка - UUID Catalog.Организации в ЦБ
//   ИНН          - Строка - ИНН для fallback-поиска (опц.)
//
// Возвращаемое значение:
//   СправочникСсылка.Организации или Неопределено
//
Функция ПолучитьОрганизациюПоUUID(ИсточникUUID, ИНН = "") Экспорт

	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// 1. Через регистр соответствий
	Ссылка = НайтиСоответствие(Перечисления.TL_ТипОбъектаИсточника.Организация, ИсточникUUID);
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;

	// 2. Через ИНН в БП ГИГ
	Если ЗначениеЗаполнено(ИНН) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Организации
			|ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаписатьСоответствие(Перечисления.TL_ТипОбъектаИсточника.Организация,
				ИсточникUUID, Выборка.Ссылка);
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Организация по умолчанию для документов БП ГИГ.
// Организацию НЕ автосоздаём (юрлицо учёта). Если организация-источник из ЦБ
// (напр. Норд-Лайн, старые данные до перевода станции) не сопоставлена — все
// документы переведённой станции ведутся от ОСНОВНОЙ организации ГИГ.
// Определяем её: по ИНН из настройки расширения, иначе — единственная
// непомеченная организация в БП. Если организаций несколько и настройки нет —
// НЕ угадываем (возврат Неопределено → ошибка как раньше).
//
Функция ОпределитьОрганизациюПоУмолчанию() Экспорт

	// 1. По ИНН из настройки расширения (если задана)
	Попытка
		ИНННастр = СокрЛП(TL_Настройки.ПолучитьЗначение("TL_ОсновнаяОрганизацияИНН", ""));
		Если ЗначениеЗаполнено(ИНННастр) Тогда
			Запрос = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Организации
				|ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления");
			Запрос.УстановитьПараметр("ИНН", ИНННастр);
			Выб = Запрос.Выполнить().Выбрать();
			Если Выб.Следующий() Тогда Возврат Выб.Ссылка; КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// 2. Единственная непомеченная организация в БП (ПЕРВЫЕ 2 — чтобы отличить «ровно одна»)
	Запрос2 = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.Организации ГДЕ НЕ ПометкаУдаления");
	Выборка2 = Запрос2.Выполнить().Выбрать();
	Сс = Неопределено;
	Кол = 0;
	Пока Выборка2.Следующий() Цикл
		Кол = Кол + 1;
		Сс = Выборка2.Ссылка;
	КонецЦикла;
	Если Кол = 1 Тогда
		Возврат Сс;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// ============================================================================
//  КОНТРАГЕНТ
// ============================================================================

// Найти Контрагента БП по UUID источника или по ИНН (fallback).
// Контракт §6.2.
//
// Параметры:
//   ИсточникUUID - Строка - UUID Catalog.Контрагенты в ЦБ
//   ИНН          - Строка - ИНН для fallback (опц.)
//
// Возвращаемое значение:
//   СправочникСсылка.Контрагенты или Неопределено
//
Функция ПолучитьКонтрагентаПоUUID(ИсточникUUID, ИНН = "", Наименование = "", КПП = "") Экспорт

	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ссылка = НайтиСоответствие(Перечисления.TL_ТипОбъектаИсточника.Контрагент, ИсточникUUID);
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;

	// Поиск по ИНН с правилом «активного» (контракт §10 №8): берём не помеченного на удаление
	Если ЗначениеЗаполнено(ИНН) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты
			|ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО ДатаРедактирования УБЫВ");
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			// Реквизит ДатаРедактирования может отсутствовать — повторим без сортировки
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты
				|ГДЕ ИНН = &ИНН И НЕ ПометкаУдаления";
			Выборка = Запрос.Выполнить().Выбрать();
		КонецПопытки;
		Если Выборка.Следующий() Тогда
			ЗаписатьСоответствие(Перечисления.TL_ТипОбъектаИсточника.Контрагент,
				ИсточникUUID, Выборка.Ссылка);
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Автосоздание: контрагента-поставщика нет в БП ГИГ — создаём из НСИ-секции.
	// ИНН НЕ обязателен: техконтрагенты (наличные закупки в соседних магазинах,
	// напр. «Агроторг») в ЦБ/на станции ведутся без ИНН/КПП принципиально —
	// достаточно Наименования. Связь фиксируется по UUID (соответствие),
	// повторная загрузка дубль не создаёт. Без этого поступления падали на
	// «контрагент не найден», каскадом валился и договор.
	Если ЗначениеЗаполнено(Наименование) Тогда
		Попытка
			Контр = Справочники.Контрагенты.СоздатьЭлемент();
			Контр.Наименование = Наименование;
			Попытка Контр.НаименованиеПолное = Наименование; Исключение КонецПопытки;
			Если ЗначениеЗаполнено(ИНН) Тогда
				Контр.ИНН = СокрЛП(ИНН);
			КонецЕсли;
			Если ЗначениеЗаполнено(КПП) Тогда
				Попытка Контр.КПП = СокрЛП(КПП); Исключение КонецПопытки;
			КонецЕсли;
			// Физлицо/ИП по 12-значному ИНН; без ИНН — юрлицо (техконтрагент ООО)
			Попытка
				Если ЗначениеЗаполнено(ИНН) И СтрДлина(СокрЛП(ИНН)) = 12 Тогда
					Контр.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
				Иначе
					Контр.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
				КонецЕсли;
			Исключение
			КонецПопытки;
			Попытка
				Контр.Комментарий = "Автосоздано TL (UUID=" + ИсточникUUID + ")"
					+ ?(ЗначениеЗаполнено(ИНН), "", " [без ИНН — техконтрагент налич.закупок]");
			Исключение
			КонецПопытки;
			Контр.Записать();
			ЗаписатьСоответствие(Перечисления.TL_ТипОбъектаИсточника.Контрагент,
				ИсточникUUID, Контр.Ссылка);
			Возврат Контр.Ссылка;
		Исключение
			ЗаписьЖурналаРегистрации("TL_МаппингЦБ",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Автосоздание контрагента '" + Наименование + "' упало: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// ============================================================================
//  ДОГОВОР
// ============================================================================

// Найти или создать Договор БП по UUID источника.
// Контракт §6.3 — автосоздание при наличии параметров.
//
// Параметры:
//   ИсточникUUID - Строка - UUID Catalog.ДоговорыКонтрагентов в ЦБ
//   Контрагент   - СправочникСсылка.Контрагенты - владелец (уже найден)
//   Параметры    - Структура - { Наименование, Номер, Дата, ВидДоговора, Валюта }
//                              для автосоздания при отсутствии
//
// Возвращаемое значение:
//   СправочникСсылка.ДоговорыКонтрагентов или Неопределено
//
Функция ПолучитьДоговорПоUUID(ИсточникUUID, Контрагент, Параметры = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ссылка = НайтиСоответствие(Перечисления.TL_ТипОбъектаИсточника.Договор, ИсточникUUID);
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Договоры из ЦБ часто БЕЗ номера (Номер=''), но с наименованием
	// («основной договор» и т.п.) — идентифицируем по Номеру, иначе по Наименованию.
	НомерД = "";
	НаимД  = "";
	Если Параметры <> Неопределено Тогда
		Если Параметры.Свойство("Номер") Тогда НомерД = СокрЛП(Параметры.Номер); КонецЕсли;
		Если Параметры.Свойство("Наименование") Тогда НаимД = СокрЛП(Параметры.Наименование); КонецЕсли;
	КонецЕсли;

	// Поиск в БП: по Номеру (если задан), иначе по Наименованию
	Если ЗначениеЗаполнено(НомерД) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ДоговорыКонтрагентов
			|ГДЕ Владелец = &Контрагент И Номер = &Номер И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("Номер", НомерД);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаписатьСоответствие(Перечисления.TL_ТипОбъектаИсточника.Договор, ИсточникUUID, Выборка.Ссылка);
			Возврат Выборка.Ссылка;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(НаимД) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ДоговорыКонтрагентов
			|ГДЕ Владелец = &Контрагент И Наименование = &Наим И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("Наим", НаимД);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаписатьСоответствие(Перечисления.TL_ТипОбъектаИсточника.Договор, ИсточникUUID, Выборка.Ссылка);
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Автосоздание: достаточно Контрагента + (Номер ИЛИ Наименование)
	Если ЗначениеЗаполнено(НомерД) ИЛИ ЗначениеЗаполнено(НаимД) Тогда
		Попытка
			Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			Договор.Владелец = Контрагент;
			Если ЗначениеЗаполнено(НомерД) Тогда
				Договор.Номер = НомерД;
			КонецЕсли;
			Если Параметры <> Неопределено И Параметры.Свойство("Дата") И ЗначениеЗаполнено(Параметры.Дата) Тогда
				Договор.Дата = Параметры.Дата;
			КонецЕсли;
			Договор.Наименование = ?(ЗначениеЗаполнено(НаимД), НаимД,
				?(ЗначениеЗаполнено(НомерД), "Договор " + НомерД, "Основной договор"));
			Договор.ВидДоговора = СопоставитьВидДоговора(?(Параметры <> Неопределено И Параметры.Свойство("ВидДоговора"),
				Параметры.ВидДоговора, "СПоставщиком"));
			Попытка
				Договор.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("643");
			Исключение
			КонецПопытки;
			Договор.Записать();
			ЗаписатьСоответствие(Перечисления.TL_ТипОбъектаИсточника.Договор, ИсточникUUID, Договор.Ссылка);
			Возврат Договор.Ссылка;
		Исключение
			ЗаписьЖурналаРегистрации("TL_МаппингЦБ",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось создать договор " + ИсточникUUID + ": " + ОписаниеОшибки());
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// ============================================================================
//  СКЛАД
// ============================================================================

// Найти Склад БП по UUID источника или по эвристике имени.
// Контракт §6.4.
//
// Параметры:
//   ИсточникUUID - Строка
//   Наименование - Строка - имя склада из ЦБ для fallback (опц.)
//
// Возвращаемое значение:
//   СправочникСсылка.Склады или Неопределено
//
Функция ПолучитьСкладПоUUID(ИсточникUUID, Наименование = "") Экспорт

	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ссылка = НайтиСоответствие(Перечисления.TL_ТипОбъектаИсточника.Склад, ИсточникUUID);
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;

	// Эвристика по имени: «АЗС №208, Торговый зал» → ищем «АЗС 208» / «АЗС №208» / «АГЗС 208 Выборг»
	Если ЗначениеЗаполнено(Наименование) Тогда
		НомерАЗС = ИзвлечьНомерАЗС(Наименование);
		Если НомерАЗС > 0 Тогда
			Кандидат = НайтиСкладПоНомеру(НомерАЗС);
			Если ЗначениеЗаполнено(Кандидат) Тогда
				ЗаписатьСоответствие(Перечисления.TL_ТипОбъектаИсточника.Склад,
					ИсточникUUID, Кандидат);
				Возврат Кандидат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// ============================================================================
//  НОМЕНКЛАТУРА
// ============================================================================

// Найти Номенклатуру БП по UUID источника.
// Контракт §6.5: на A3 автосоздание ВЫКЛЮЧЕНО — приёмник полагается на ручное
// сопоставление через DataProcessor.TL_СоответствияИсточников. На A4 включается
// автосоздание + запись в TL_МСН_Зеркало (отдельная задача).
//
// Параметры:
//   ИсточникUUID - Строка
//
// Возвращаемое значение:
//   СправочникСсылка.Номенклатура или Неопределено
//
Функция ПолучитьНоменклатуруПоUUID(ИсточникUUID) Экспорт

	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НайтиСоответствие(Перечисления.TL_ТипОбъектаИсточника.Номенклатура, ИсточникUUID);

КонецФункции

// Найти Номенклатуру по UUID или создать новую карточку из данных НСИ.
// Используется на стадии обработки НСИ-секции пакета (ДО документов).
// Минимальный набор реквизитов для smoke на стенде: Наименование, Артикул,
// СтавкаНДС, БазоваяЕдиницаИзмерения (поиск в Классификаторе по имени).
//
// Параметры:
//   ИсточникUUID - Строка
//   ДанныеНСИ    - Соответствие/Структура - элемент НСИ-секции пакета
//                  Поля: Наименование, НаименованиеПолное, Артикул,
//                        СтавкаНДС, Единица (имя), КодЦБ, ВидНоменклатуры
//
// Возвращаемое значение:
//   СправочникСсылка.Номенклатура или Неопределено при ошибке
//
Функция ПолучитьИлиСоздатьНоменклатуру(ИсточникUUID, ДанныеНСИ) Экспорт

	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ссылка = НайтиСоответствие(Перечисления.TL_ТипОбъектаИсточника.Номенклатура, ИсточникUUID);
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;

	Имя = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ДанныеНСИ, "Наименование", ""));
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	КодЦБ = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ДанныеНСИ, "КодЦБ", ""));

	// Мягкое связывание: НЕ плодить дубль, если карточка уже есть в БП
	// (создана вручную/типовым обменом — у неё нет записи в TL_СоответствиеИсточников).
	// Жалоба 26.06: 508 авто-дублей при загрузке ОРП. Ищем существующую по
	// КодЦБ→Артикул, затем по точному наименованию; если нашли — привязываем UUID
	// к ней и возвращаем, не создавая дубль.
	Существующая = НайтиСуществующуюНоменклатуру(КодЦБ, Имя);
	Если Существующая <> Неопределено Тогда
		ЗаписатьСоответствие(Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
			ИсточникUUID, Существующая);
		Возврат Существующая;
	КонецЕсли;

	Попытка
		Карточка = Справочники.Номенклатура.СоздатьЭлемент();
		Карточка.Наименование = Имя;

		ПолноеИмя = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ДанныеНСИ, "НаименованиеПолное", Имя);
		Попытка Карточка.НаименованиеПолное = ПолноеИмя; Исключение КонецПопытки;

		Артикул = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ДанныеНСИ, "Артикул", ""));
		Если ЗначениеЗаполнено(Артикул) Тогда
			Попытка Карточка.Артикул = Артикул; Исключение КонецПопытки;
		ИначеЕсли ЗначениеЗаполнено(КодЦБ) Тогда
			// Артикул = КодЦБ — чтобы будущие загрузки связывались по артикулу
			// (ручные карточки 208 заведены именно так) и не плодили дубли.
			Попытка Карточка.Артикул = КодЦБ; Исключение КонецПопытки;
		КонецЕсли;

		// Ставка НДС из НСИ — критично для последующего проведения ПТУ
		ИмяСтавки = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ДанныеНСИ, "СтавкаНДС", "");
		Если ЗначениеЗаполнено(ИмяСтавки) Тогда
			Ставка = СопоставитьСтавкуНДС(ИмяСтавки);
			Если ЗначениеЗаполнено(Ставка) Тогда
				Попытка Карточка.СтавкаНДС = Ставка; Исключение КонецПопытки;
			КонецЕсли;
		КонецЕсли;

		// Единица измерения — поиск в Классификаторе по имени ("шт", "л", "кг", ...)
		ИмяЕдиницы = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ДанныеНСИ, "Единица", "шт"));
		Если ЗначениеЗаполнено(ИмяЕдиницы) Тогда
			Попытка
				Запрос = Новый Запрос(
					"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
					|ИЗ Справочник.КлассификаторЕдиницИзмерения
					|ГДЕ Наименование = &Имя И НЕ ПометкаУдаления");
				Запрос.УстановитьПараметр("Имя", ИмяЕдиницы);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Карточка.ЕдиницаИзмерения = Выборка.Ссылка;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		// ВидНоменклатуры — попытка найти типовое значение «Товары»
		Попытка
			Запрос2 = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
				|ИЗ Справочник.ВидыНоменклатуры
				|ГДЕ Наименование = ""Товары"" И НЕ ПометкаУдаления");
			Выборка2 = Запрос2.Выполнить().Выбрать();
			Если Выборка2.Следующий() Тогда
				Карточка.ВидНоменклатуры = Выборка2.Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Комментарий — отметка автосоздания для аудита
		КодЦБ = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ДанныеНСИ, "КодЦБ", ""));
		Попытка
			Карточка.Комментарий = "Автосоздано TL_СопуткаСервис (UUID=" + ИсточникUUID
				+ ?(ЗначениеЗаполнено(КодЦБ), ", КодЦБ=" + КодЦБ, "") + ")";
		Исключение
		КонецПопытки;

		// Группа-родитель: «Номенклатура 208» — свежие карточки из канала кладём рядом
		// с выверенной номенклатурой АЗС, а не в корень справочника.
		Попытка
			ЗапросГр = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Номенклатура
				|ГДЕ ЭтоГруппа И Наименование = ""Номенклатура 208"" И НЕ ПометкаУдаления");
			ВыбГр = ЗапросГр.Выполнить().Выбрать();
			Если ВыбГр.Следующий() Тогда
				Карточка.Родитель = ВыбГр.Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Карточка.Записать();
		ЗаписатьСоответствие(Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
			ИсточникUUID, Карточка.Ссылка);
		Возврат Карточка.Ссылка;

	Исключение
		ЗаписьЖурналаРегистрации("TL_МаппингЦБ",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Автосоздание номенклатуры '" + Имя + "' упало: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Нормализованный ключ имени для мягкого матча номенклатуры:
// нижний регистр + удаление пробелов/точек/запятых + хвостовая единица «гр»→«г»
// (только если перед «гр» цифра). Сводит «Американо 200 мл»=«Американо 200мл»=
// «АМЕРИКАНО 200 мл.», бургеры «250 гр.»=«250 гр..», «230 г.»=«230 гр.».
Функция НормализованноеИмя(Имя)

	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат "";
	КонецЕсли;

	Рез = НРег(СокрЛП(Имя));
	Рез = СтрЗаменить(Рез, " ", "");
	Рез = СтрЗаменить(Рез, ".", "");
	Рез = СтрЗаменить(Рез, ",", "");

	// хвостовая единица «гр» → «г» (250гр = 250г), только если перед «гр» цифра
	Если СтрДлина(Рез) > 2 И Прав(Рез, 2) = "гр" Тогда
		СимволПеред = Сред(Рез, СтрДлина(Рез) - 2, 1);
		Если СтрНайти("0123456789", СимволПеред) > 0 Тогда
			Рез = Лев(Рез, СтрДлина(Рез) - 2) + "г";
		КонецЕсли;
	КонецЕсли;

	Возврат Рез;

КонецФункции

// Найти существующую карточку номенклатуры для мягкого связывания (без дубля).
// Порядок: 1) по Артикул = КодЦБ (ручные карточки 208 заведены с Артикул = код ЦБ);
//          2) по точному Наименованию — не-автосозданную, предпочитая с заполненным
//             артикулом (чтобы привязаться к «настоящей» карточке, а не к старому авто-дублю);
//          3) по НОРМАЛИЗОВАННОМУ имени (регистр/пробелы/точки/«гр»→«г») — варианты
//             «200 мл»/«200мл»/«200 мл.»/«250 гр.»/«250 гр..».
//
// Параметры:
//   КодЦБ - Строка - код номенклатуры в ЦБ (= Артикул ручной карточки)
//   Имя   - Строка - наименование
//
// Возвращаемое значение:
//   СправочникСсылка.Номенклатура или Неопределено
//
Функция НайтиСуществующуюНоменклатуру(КодЦБ, Имя)

	// 1. По артикулу = КодЦБ
	Если ЗначениеЗаполнено(КодЦБ) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
			|ИЗ Справочник.Номенклатура
			|ГДЕ Артикул = &Арт И НЕ ПометкаУдаления И НЕ ЭтоГруппа");
		Запрос.УстановитьПараметр("Арт", КодЦБ);
		Попытка
			Выб = Запрос.Выполнить().Выбрать();
			Если Выб.Следующий() Тогда Возврат Выб.Ссылка; КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// 2. По точному наименованию — не-автосозданную, с приоритетом заполненного артикула
	Если ЗначениеЗаполнено(Имя) Тогда
		Запрос2 = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
			|ИЗ Справочник.Номенклатура
			|ГДЕ Наименование = &Имя И НЕ ПометкаУдаления И НЕ ЭтоГруппа
			|	И НЕ Комментарий ПОДОБНО ""Автосоздано TL%""
			|УПОРЯДОЧИТЬ ПО ВЫБОР КОГДА Артикул <> """" ТОГДА 0 ИНАЧЕ 1 КОНЕЦ");
		Запрос2.УстановитьПараметр("Имя", Имя);
		Попытка
			Выб2 = Запрос2.Выполнить().Выбрать();
			Если Выб2.Следующий() Тогда Возврат Выб2.Ссылка; КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// 3. По НОРМАЛИЗОВАННОМУ имени (регистр/пробелы/точки/«гр»→«г»): ловит
	//    «Американо 200 мл»=«Американо 200мл», «Латте 400 мл.»=«Латте 400мл»,
	//    бургеры «230 г.»/«230 гр.». Кандидатов берём по первому слову (не весь
	//    справочник); приоритет — не-автосозданная карточка с заполненным артикулом,
	//    но при отсутствии «настоящей» свяжемся с авто-карточкой (чтобы не плодить
	//    второй авто-дубль при разных КодЦБ одного товара).
	Если ЗначениеЗаполнено(Имя) Тогда
		Ключ = НормализованноеИмя(Имя);
		ИмяТрим = СокрЛП(Имя);
		ПробелПоз = СтрНайти(ИмяТрим, " ");
		ПервоеСлово = ?(ПробелПоз > 1, Лев(ИмяТрим, ПробелПоз - 1), ИмяТрим);
		Если ЗначениеЗаполнено(Ключ) И ЗначениеЗаполнено(ПервоеСлово) Тогда
			Запрос3 = Новый Запрос(
				"ВЫБРАТЬ Ссылка, Наименование
				|ИЗ Справочник.Номенклатура
				|ГДЕ ВРЕГ(Наименование) ПОДОБНО &Маска И НЕ ПометкаУдаления И НЕ ЭтоГруппа
				|УПОРЯДОЧИТЬ ПО
				|	ВЫБОР КОГДА ВЫРАЗИТЬ(Комментарий КАК СТРОКА(150)) ПОДОБНО ""Автосоздано TL%"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ,
				|	ВЫБОР КОГДА Артикул <> """" ТОГДА 0 ИНАЧЕ 1 КОНЕЦ");
			Запрос3.УстановитьПараметр("Маска", ВРег(ПервоеСлово) + "%");
			Попытка
				Выб3 = Запрос3.Выполнить().Выбрать();
				Пока Выб3.Следующий() Цикл
					Если НормализованноеИмя(Выб3.Наименование) = Ключ Тогда
						Возврат Выб3.Ссылка;
					КонецЕсли;
				КонецЦикла;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// ============================================================================
//  СТАВКА НДС
// ============================================================================

// Сопоставить имя ставки НДС из JSON с перечислением БП ГИГ.
// Контракт §8.1 — 14 значений. Источник нормализует имена до записи в JSON
// (`НДС05` → `НДС5`).
//
// Параметры:
//   ИмяСтавки - Строка - "НДС20" / "НДС22" / "НДС5" / ...
//
// Возвращаемое значение:
//   ПеречислениеСсылка.СтавкиНДС или ПустаяСсылка при неизвестном имени
//
Функция СопоставитьСтавкуНДС(ИмяСтавки) Экспорт

	Если Не ЗначениеЗаполнено(ИмяСтавки) Тогда
		Возврат Перечисления.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;

	Имя = СокрЛП(ИмяСтавки);

	// Прямой маппинг по имени (полный список §8.1 контракта)
	Если Имя = "НДС18"     Тогда Возврат Перечисления.СтавкиНДС.НДС18;     КонецЕсли;
	Если Имя = "НДС18_118" Тогда Возврат Перечисления.СтавкиНДС.НДС18_118; КонецЕсли;
	Если Имя = "НДС10"     Тогда Возврат Перечисления.СтавкиНДС.НДС10;     КонецЕсли;
	Если Имя = "НДС10_110" Тогда Возврат Перечисления.СтавкиНДС.НДС10_110; КонецЕсли;
	Если Имя = "НДС0"      Тогда Возврат Перечисления.СтавкиНДС.НДС0;      КонецЕсли;
	Если Имя = "БезНДС"    Тогда Возврат Перечисления.СтавкиНДС.БезНДС;    КонецЕсли;
	Если Имя = "НДС20"     Тогда Возврат Перечисления.СтавкиНДС.НДС20;     КонецЕсли;
	Если Имя = "НДС20_120" Тогда Возврат Перечисления.СтавкиНДС.НДС20_120; КонецЕсли;

	// НДС22 / НДС22_122 / НДС5 / НДС5_105 / НДС7 / НДС7_107 — fail-fast (ревизия 16.05.2026).
	// Раньше был тихий fallback на НДС20 через Попытка/Исключение — это создавало риск
	// повторения ошибки НЛ (НДС10 пищевки превращался в НДС22 через ВидСтавкиНДС=Общая).
	// Теперь: если ставка не найдена в БП ГИГ — возвращаем ПустаяСсылка, вызывающий код
	// записывает ошибку в TL_ОшибкиЗагрузки и НЕ создаёт документ.
	// На современной БП ГИГ (3.0.194.18+) эти ставки есть — Попытка не нужна.
	Если Имя = "НДС22"     Тогда Возврат Перечисления.СтавкиНДС.НДС22;     КонецЕсли;
	Если Имя = "НДС22_122" Тогда Возврат Перечисления.СтавкиНДС.НДС22_122; КонецЕсли;
	Если Имя = "НДС5"      Тогда Возврат Перечисления.СтавкиНДС.НДС5;      КонецЕсли;
	Если Имя = "НДС5_105"  Тогда Возврат Перечисления.СтавкиНДС.НДС5_105;  КонецЕсли;
	Если Имя = "НДС7"      Тогда Возврат Перечисления.СтавкиНДС.НДС7;      КонецЕсли;
	Если Имя = "НДС7_107"  Тогда Возврат Перечисления.СтавкиНДС.НДС7_107;  КонецЕсли;

	// Неизвестная ставка — fail-fast (без подмен на НДС20). Вызывающий код пишет ошибку
	// в TL_ОшибкиЗагрузки с кодом СтавкаНДС_НеСопоставлена и не создаёт документ.
	ЗаписьЖурналаРегистрации("TL_МаппингЦБ",
		УровеньЖурналаРегистрации.Ошибка, , ,
		"Неизвестная ставка НДС '" + Имя + "' — документ не будет создан (см. TL_ОшибкиЗагрузки)");
	Возврат Перечисления.СтавкиНДС.ПустаяСсылка();

КонецФункции

// ============================================================================
//  ВИД ДОГОВОРА
// ============================================================================

// Сопоставить имя вида договора из JSON с перечислением БП.
// Контракт §8.4.
//
Функция СопоставитьВидДоговора(Имя) Экспорт

	Имя = СокрЛП(Имя);
	Если Имя = "СПоставщиком"  Тогда Возврат Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;  КонецЕсли;
	Если Имя = "СПокупателем"  Тогда Возврат Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;  КонецЕсли;
	Если Имя = "СКомитентом"   Тогда Возврат Перечисления.ВидыДоговоровКонтрагентов.СКомитентом;   КонецЕсли;
	Если Имя = "СКомиссионером"Тогда Возврат Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером;КонецЕсли;
	Если Имя = "Прочее"        Тогда Возврат Перечисления.ВидыДоговоровКонтрагентов.Прочее;        КонецЕсли;
	Возврат Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;

КонецФункции

