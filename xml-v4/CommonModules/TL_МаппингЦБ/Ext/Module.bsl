// ============================================================================
//  ВИД ОПЕРАЦИИ ПОСТУПЛЕНИЯ В БП
// ============================================================================

// Сопоставить ВидОперации из JSON с ВидыОперацийПоступлениеТоваровУслуг БП.
// Контракт §8.3 — на A3 единственный маппинг ОтПоставщика → Товары.
//
Функция СопоставитьВидОперацииПоступление(ИмяИзJSON) Экспорт

	Имя = СокрЛП(ИмяИзJSON);
	Если Имя = "ОтПоставщика" Тогда
		Возврат Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Товары;
	КонецЕсли;
	// Прочие на A3 не маппятся
	Возврат Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПустаяСсылка();

КонецФункции

// ============================================================================
//  ВИД ОПЛАТЫ (РОЗНИЦА) — Catalog.ВидыОплатОрганизаций
// ============================================================================

// Сопоставить имя вида оплаты из JSON ЦБ с Catalog.ВидыОплатОрганизаций.
// Используется для kind=retail_sale_sidegoods.
//
// Логика:
//   - "Наличные" → Пустая ссылка (наличные НЕ идут в ТЧ Оплата, отражаются
//     через СчетКасса=50.01 в шапке).
//   - "Карты МПС" / "Карта МПС" / "МИР" / "Visa" / ... → ищем в Catalog
//     по точному имени или фрагменту, при отсутствии создаём новую запись.
//
Функция СопоставитьВидОплатыРозница(ИмяВидаОплаты) Экспорт

	Имя = СокрЛП(ИмяВидаОплаты);
	Если Имя = "" ИЛИ Имя = "Наличные" Тогда
		Возврат Справочники.ВидыОплатОрганизаций.ПустаяСсылка();
	КонецЕсли;

	// 1. Точное совпадение имени
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыОплатОрганизаций
		|ГДЕ Наименование = &Н И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("Н", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// 2. Эвристика: если имя содержит «карт», берём «Платежная карта» (типовой)
	Если Найти(НРег(Имя), "карт") > 0 Тогда
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыОплатОрганизаций
			|ГДЕ Наименование = ""Платежная карта"" И НЕ ПометкаУдаления";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// 3. Автосоздание новой записи (на случай экзотических каналов оплат)
	Попытка
		ВО = Справочники.ВидыОплатОрганизаций.СоздатьЭлемент();
		ВО.Наименование = Имя;
		ВО.Записать();
		Возврат ВО.Ссылка;
	Исключение
		ЗаписьЖурналаРегистрации("TL_МаппингЦБ",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось создать ВидОплатыОрганизации '" + Имя + "': " + ОписаниеОшибки());
		Возврат Справочники.ВидыОплатОрганизаций.ПустаяСсылка();
	КонецПопытки;

КонецФункции

// ============================================================================
//  ПОДРАЗДЕЛЕНИЕ ОРГАНИЗАЦИИ (по складу-АЗС)
// ============================================================================

// Найти Catalog.ПодразделенияОрганизаций по складу-АЗС.
// Шаблон: «АЗС 208 г. Выборг» → подразделение «АЗС 208 г. Выборг».
//
Функция ПолучитьПодразделениеПоСкладу(СкладИлиИмя) Экспорт

	Если ТипЗнч(СкладИлиИмя) = Тип("СправочникСсылка.Склады") Тогда
		Имя = СокрЛП(СкладИлиИмя.Наименование);
	Иначе
		Имя = СокрЛП(СкладИлиИмя);
	КонецЕсли;

	Если Имя = "" Тогда
		Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	КонецЕсли;

	// Точное совпадение
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПодразделенияОрганизаций
		|ГДЕ Наименование = &Н И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("Н", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// Поиск по номеру АЗС в имени
	Номер = ИзвлечьНомерАЗС(Имя);
	Если Номер > 0 Тогда
		НомерСтр = XMLСтрока(Номер);
		Шаблоны = Новый Массив;
		Шаблоны.Добавить("%АЗС " + НомерСтр + "%");
		Шаблоны.Добавить("%АЗС №" + НомерСтр + "%");
		Шаблоны.Добавить("%АГЗС " + НомерСтр + "%");
		Шаблоны.Добавить("%(" + НомерСтр + ")%");
		Для Каждого Шаблон Из Шаблоны Цикл
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПодразделенияОрганизаций
				|ГДЕ Наименование ПОДОБНО &Ш И НЕ ПометкаУдаления";
			Запрос.УстановитьПараметр("Ш", Шаблон);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Справочники.ПодразделенияОрганизаций.ПустаяСсылка();

КонецФункции

