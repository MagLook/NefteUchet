////////////////////////////////////////////////////////////////////////////////
// НУ_Загрузка — Рабочее место бухгалтера
//
// Два потока документов:
//   ВНЕШНИЕ — доступны в API, ещё не загружены → [Загрузить]
//   ВНУТРЕННИЕ — уже в 1С → [Провести] / [Удалить]
//
// Фильтры: сеть, станция, период, тип документа
// По умолчанию: незакрытый период, все станции, все типы
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Настройки из регистра
	URLСервера = ПолучитьНастройку("НУ_API_URL", "https://pos.autooplata.ru/tms");
	Логин = ПолучитьНастройку("НУ_API_LOGIN", "");
	Пароль = ПолучитьНастройку("НУ_API_PASSWORD", "");
	КодСистемы = Число(ПолучитьНастройку("НУ_API_SYSTEM_CODE", "65"));
	КодСтанции = Число(ПолучитьНастройку("НУ_API_STATION_CODE", "0"));

	// Незакрытый период — последние 14 дней
	ДатаНачала = НачалоДня(ТекущаяДата() - 14 * 86400);
	ДатаОкончания = КонецДня(ТекущаяДата());

	// Фильтр типа документов (по умолчанию — все)
	ТипДокументаФильтр = "Все";

	ДобавитьВЛог("НефтеУчёт запущен. Система: " + Формат(КодСистемы, "ЧГ=0"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// === ОБНОВИТЬ — загрузить данные из API и показать обе таблицы ===
&НаКлиенте
Процедура КомандаОбновить(Команда)

	Если ПустаяСтрока(Логин) ИЛИ ПустаяСтрока(Пароль) Тогда
		ПоказатьПредупреждение(, "Укажите логин и пароль API");
		Возврат;
	КонецЕсли;

	ДобавитьВЛогКлиент("Подключение к API...");
	ОбновитьДанныеНаСервере();

КонецПроцедуры

// === ЗАГРУЗИТЬ ВЫБРАННЫЕ — из внешних в 1С ===
&НаКлиенте
Процедура КомандаЗагрузить(Команда)

	Количество = ПодсчитатьОтмеченные(ВнешниеДанные);
	Если Количество = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте документы для загрузки");
		Возврат;
	КонецЕсли;

	ДобавитьВЛогКлиент("Загрузка " + Формат(Количество, "ЧГ=0") + " документов в 1С...");
	ЗагрузитьВыбранныеНаСервере();

КонецПроцедуры

// === ПРОВЕСТИ ВЫБРАННЫЕ — в 1С ===
&НаКлиенте
Процедура КомандаПровести(Команда)

	Количество = ПодсчитатьОтмеченные(ВнутренниеДанные);
	Если Количество = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте документы для проведения");
		Возврат;
	КонецЕсли;

	ДобавитьВЛогКлиент("Проведение " + Формат(Количество, "ЧГ=0") + " документов...");
	ПровестиВыбранныеНаСервере();

КонецПроцедуры

// === УДАЛИТЬ ВЫБРАННЫЕ — из 1С ===
&НаКлиенте
Процедура КомандаУдалить(Команда)

	Количество = ПодсчитатьОтмеченные(ВнутренниеДанные);
	Если Количество = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте документы для удаления");
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ОтветУдаление", ЭтотОбъект),
		"Удалить " + Формат(Количество, "ЧГ=0") + " документов из 1С?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтветУдаление(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		УдалитьВыбранныеНаСервере();
	КонецЕсли;
КонецПроцедуры

// === ВЫБРАТЬ ВСЕ ===
&НаКлиенте
Процедура КомандаВыбратьВсеВнешние(Команда)
	ПереключитьОтметки(ВнешниеДанные);
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбратьВсеВнутренние(Команда)
	ПереключитьОтметки(ВнутренниеДанные);
КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедуры

&НаСервере
Процедура ОбновитьДанныеНаСервере()

	ВнешниеДанные.Очистить();
	ВнутренниеДанные.Очистить();

	// === 1. Получаем данные из API ===
	Подключение = НУ_ApiКлиент.СоздатьПодключение(URLСервера, Логин, Пароль);
	Если Подключение = Неопределено Тогда
		ДобавитьВЛог("ОШИБКА: Не удалось подключиться к API");
		Возврат;
	КонецЕсли;
	ДобавитьВЛог("Подключение установлено");

	// Получаем смены
	Попытка
		Смены = НУ_ApiКлиент.ПолучитьСписокСмен(Подключение, КодСистемы, КодСтанции, ДатаНачала, ДатаОкончания);
	Исключение
		ДобавитьВЛог("ОШИБКА при получении смен: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если Смены = Неопределено Тогда
		ДобавитьВЛог("Смены не найдены");
		Возврат;
	КонецЕсли;

	// === 2. Определяем что уже загружено в 1С ===
	ЗагруженныеКлючи = ПолучитьЗагруженныеКлючи();

	// === 3. Обрабатываем каждую смену ===
	КолВнешних = 0;
	КолТТН = 0;

	Для Каждого Смена Из Смены Цикл

		НомерСмены = Число(ПолучитьИзJSON(Смена, "shift", 0));
		НомерСтанции = Число(ПолучитьИзJSON(Смена, "station", 0));
		ДатаОткрытия = ПолучитьИзJSON(Смена, "dt_open", "");
		ДатаСмены = ?(ПустаяСтрока(ДатаОткрытия), Дата(1,1,1), РазобратьДатуISO(ДатаОткрытия));

		// Фильтр по станции
		Если КодСтанции > 0 И НомерСтанции <> КодСтанции Тогда
			Продолжить;
		КонецЕсли;

		// Получаем полный отчёт
		Попытка
			Подключение = НУ_ApiКлиент.ОбновитьТокенПриНеобходимости(Подключение, Логин, Пароль);
			ОтчётСмены = НУ_ApiКлиент.ПолучитьСменныйОтчёт(Подключение, КодСистемы, НомерСтанции, НомерСмены);
		Исключение
			ДобавитьВЛог("ОШИБКА смена #" + Формат(НомерСмены, "ЧГ=0") + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если ОтчётСмены = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// --- Сменный отчёт ---
		Если ТипДокументаФильтр = "Все" ИЛИ ТипДокументаФильтр = "Смены" Тогда

			КлючСмены = "СМЕНА|" + Формат(КодСистемы, "ЧГ=0") + "|" + Формат(НомерСтанции, "ЧГ=0") + "|" + Формат(НомерСмены, "ЧГ=0");
			СуммаСмены = РассчитатьСуммуСмены(ОтчётСмены);

			Если ЗагруженныеКлючи[КлючСмены] = Неопределено Тогда
				// Внешний — ещё не загружен
				Стр = ВнешниеДанные.Добавить();
				Стр.Отметка = Истина;
				Стр.ТипДокумента = "Сменный отчёт";
				Стр.Дата = ДатаСмены;
				Стр.Станция = НомерСтанции;
				Стр.НомерСмены = НомерСмены;
				Стр.Описание = "Смена #" + Формат(НомерСмены, "ЧГ=0") + " АЗС-" + Формат(НомерСтанции, "ЧГ=0");
				Стр.Сумма = СуммаСмены;
				Стр.КлючЗагрузки = КлючСмены;
				Стр.ДанныеJSON = СериализоватьВJSON(ОтчётСмены);
				КолВнешних = КолВнешних + 1;
			Иначе
				// Внутренний — уже в 1С
				Стр = ВнутренниеДанные.Добавить();
				Стр.Отметка = Ложь;
				Стр.ТипДокумента = "Сменный отчёт";
				Стр.Дата = ДатаСмены;
				Стр.Станция = НомерСтанции;
				Стр.НомерСмены = НомерСмены;
				Стр.Описание = "Смена #" + Формат(НомерСмены, "ЧГ=0") + " АЗС-" + Формат(НомерСтанции, "ЧГ=0");
				Стр.Сумма = СуммаСмены;
				Стр.Статус = ЗагруженныеКлючи[КлючСмены];
				Стр.КлючЗагрузки = КлючСмены;
			КонецЕсли;

		КонецЕсли;

		// --- ТТН (поступления) ---
		Если ТипДокументаФильтр = "Все" ИЛИ ТипДокументаФильтр = "ТТН" Тогда

			МассивТТН = ПолучитьИзJSON(ОтчётСмены, "receipt", Неопределено);
			Если МассивТТН <> Неопределено Тогда
				Для Каждого ТТН Из МассивТТН Цикл

					НомерТТН = ПолучитьИзJSON(ТТН, "ttn", "");
					БлокСервис = ПолучитьИзJSON(ТТН, "service", Неопределено);
					ИмяТоплива = ПолучитьИзJSON(БлокСервис, "service_name", "");
					БлокДок = ПолучитьИзJSON(ТТН, "doc", Неопределено);
					МассаКг = Число(ПолучитьИзJSON(БлокДок, "amount", 0));
					Плотность = Число(ПолучитьИзJSON(БлокДок, "density", 0));
					Стоимость = Число(ПолучитьИзJSON(БлокДок, "cost", 0));

					Если МассаКг <= 0 Тогда
						Продолжить;
					КонецЕсли;

					КлючТТН = "ТТН|" + Формат(КодСистемы, "ЧГ=0") + "|" + Формат(НомерСтанции, "ЧГ=0") + "|" + НомерТТН;
					ОписаниеТТН = "ТТН " + НомерТТН + " " + ИмяТоплива
						+ " " + Формат(МассаКг / 1000, "ЧДЦ=3") + "т"
						+ " ρ=" + Формат(Плотность, "ЧДЦ=3");

					Если ЗагруженныеКлючи[КлючТТН] = Неопределено Тогда
						Стр = ВнешниеДанные.Добавить();
						Стр.Отметка = Истина;
						Стр.ТипДокумента = "ТТН";
						Стр.Дата = ДатаСмены;
						Стр.Станция = НомерСтанции;
						Стр.НомерСмены = НомерСмены;
						Стр.Описание = ОписаниеТТН;
						Стр.Сумма = Стоимость;
						Стр.КлючЗагрузки = КлючТТН;
						Стр.ДанныеJSON = СериализоватьВJSON(ТТН);
						КолТТН = КолТТН + 1;
					Иначе
						Стр = ВнутренниеДанные.Добавить();
						Стр.Отметка = Ложь;
						Стр.ТипДокумента = "ТТН";
						Стр.Дата = ДатаСмены;
						Стр.Станция = НомерСтанции;
						Стр.НомерСмены = НомерСмены;
						Стр.Описание = ОписаниеТТН;
						Стр.Сумма = Стоимость;
						Стр.Статус = ЗагруженныеКлючи[КлючТТН];
						Стр.КлючЗагрузки = КлючТТН;
					КонецЕсли;

				КонецЦикла;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	ДобавитьВЛог("Найдено: " + Формат(КолВнешних, "ЧГ=0") + " смен, "
		+ Формат(КолТТН, "ЧГ=0") + " ТТН (новых). В системе: "
		+ Формат(ВнутренниеДанные.Количество(), "ЧГ=0") + " документов.");

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьВыбранныеНаСервере()

	Настройки = ПолучитьНастройкиМаппинга();
	Загружено = 0;
	Ошибок = 0;

	Для Каждого Стр Из ВнешниеДанные Цикл

		Если Не Стр.Отметка Тогда
			Продолжить;
		КонецЕсли;

		Данные = ДесериализоватьИзJSON(Стр.ДанныеJSON);
		Если Данные = Неопределено Тогда
			ДобавитьВЛог("ОШИБКА: нет данных для " + Стр.Описание);
			Ошибок = Ошибок + 1;
			Продолжить;
		КонецЕсли;

		Результат = Неопределено;

		Если Стр.ТипДокумента = "Сменный отчёт" Тогда
			Результат = НУ_СозданиеДокументов.ОбработатьСменныйОтчёт(Данные, Настройки, Ложь);
		ИначеЕсли Стр.ТипДокумента = "ТТН" Тогда
			Результат = НУ_СозданиеДокументов.ОбработатьПоступление(Данные, Настройки, Ложь);
		КонецЕсли;

		Если Результат <> Неопределено Тогда
			Для Каждого Ош Из Результат.Ошибки Цикл
				ДобавитьВЛог("ОШИБКА: " + Ош);
			КонецЦикла;

			Если Результат.Ошибки.Количество() = 0 Тогда
				// Запоминаем что загружено
				ЗаписатьСтатусЗагрузки(Стр.КлючЗагрузки, "Загружен");
				Загружено = Загружено + 1;
			Иначе
				Ошибок = Ошибок + 1;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	ДобавитьВЛог("Загружено: " + Формат(Загружено, "ЧГ=0")
		+ ?(Ошибок > 0, ", ошибок: " + Формат(Ошибок, "ЧГ=0"), ""));

	// Обновляем таблицы
	ОбновитьДанныеНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПровестиВыбранныеНаСервере()

	Проведено = 0;

	Для Каждого Стр Из ВнутренниеДанные Цикл
		Если Не Стр.Отметка ИЛИ Стр.Статус = "Проведён" Тогда
			Продолжить;
		КонецЕсли;

		// TODO: найти документы по ключу и провести
		// Пока меняем статус
		ЗаписатьСтатусЗагрузки(Стр.КлючЗагрузки, "Проведён");
		Стр.Статус = "Проведён";
		Стр.Отметка = Ложь;
		Проведено = Проведено + 1;
	КонецЦикла;

	ДобавитьВЛог("Проведено: " + Формат(Проведено, "ЧГ=0"));

КонецПроцедуры

&НаСервере
Процедура УдалитьВыбранныеНаСервере()

	Удалено = 0;

	Для Каждого Стр Из ВнутренниеДанные Цикл
		Если Не Стр.Отметка Тогда
			Продолжить;
		КонецЕсли;

		// TODO: найти и удалить документы по ключу
		// Пока удаляем статус
		УдалитьСтатусЗагрузки(Стр.КлючЗагрузки);
		Удалено = Удалено + 1;
	КонецЦикла;

	ДобавитьВЛог("Удалено: " + Формат(Удалено, "ЧГ=0"));

	// Обновляем таблицы
	ОбновитьДанныеНаСервере();

КонецПроцедуры

#КонецОбласти

#Область РаботаСРегистромСтатусов

// Получает соответствие загруженных ключей → статус.
//
&НаСервере
Функция ПолучитьЗагруженныеКлючи()

	Результат = Новый Соответствие;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Ключ, Значение ИЗ РегистрСведений.НУ_Настройки
			|ГДЕ Ключ ПОДОБНО ""ЗАГР|%""";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			// Ключ: "ЗАГР|СМЕНА|65|208|45" → "СМЕНА|65|208|45"
			КлючДокумента = Сред(Выборка.Ключ, 6); // убираем "ЗАГР|"
			Результат[КлючДокумента] = Выборка.Значение; // "Загружен" или "Проведён"
		КонецЦикла;
	Исключение
		// Регистр ещё не создан — нормально
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаписатьСтатусЗагрузки(КлючДокумента, Статус)

	Попытка
		НаборЗаписей = РегистрыСведений.НУ_Настройки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Ключ.Установить("ЗАГР|" + КлючДокумента);
		Запись = НаборЗаписей.Добавить();
		Запись.Ключ = "ЗАГР|" + КлючДокумента;
		Запись.Значение = Статус;
		Запись.Описание = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm");
		НаборЗаписей.Записать(Истина);
	Исключение
		ДобавитьВЛог("ОШИБКА записи статуса: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура УдалитьСтатусЗагрузки(КлючДокумента)

	Попытка
		НаборЗаписей = РегистрыСведений.НУ_Настройки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Ключ.Установить("ЗАГР|" + КлючДокумента);
		НаборЗаписей.Записать(Истина); // пустой набор = удаление
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область КлиентскиеВспомогательные

&НаКлиенте
Функция ПодсчитатьОтмеченные(Таблица)
	К = 0;
	Для Каждого Стр Из Таблица Цикл
		Если Стр.Отметка Тогда
			К = К + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат К;
КонецФункции

&НаКлиенте
Процедура ПереключитьОтметки(Таблица)
	НоваяОтметка = Ложь;
	Если Таблица.Количество() > 0 Тогда
		НоваяОтметка = Не Таблица[0].Отметка;
	КонецЕсли;
	Для Каждого Стр Из Таблица Цикл
		Стр.Отметка = НоваяОтметка;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВЛогКлиент(Сообщение)
	ТекстЛога = Формат(ТекущаяДата(), "ДФ=dd.MM HH:mm") + "  " + Сообщение + Символы.ПС + ТекстЛога;
КонецПроцедуры

#КонецОбласти

#Область СерверныеВспомогательные

&НаСервере
Функция ПолучитьНастройкиМаппинга()

	Н = НУ_СозданиеДокументов.ПолучитьНастройкиПоУмолчанию();

	ИмяОрганизации = ПолучитьНастройку("НУ_Организация", "");
	Если Не ПустаяСтрока(ИмяОрганизации) Тогда
		Н.Организация = Справочники.Организации.НайтиПоНаименованию(ИмяОрганизации);
	КонецЕсли;

	Н.ОсновнойСклад = НайтиСкладПоНастройке("НУ_ОсновнойСклад");
	Н.СкладАЗС = НайтиСкладПоНастройке("НУ_СкладАЗС");
	Н.СкладКарты = НайтиСкладПоНастройке("НУ_СкладКарты");
	Н.СкладТалоны = НайтиСкладПоНастройке("НУ_СкладТалоны");
	Н.СкладВедомости = НайтиСкладПоНастройке("НУ_СкладВедомости");
	Н.СкладОнлайн = НайтиСкладПоНастройке("НУ_СкладОнлайн");

	ИмяПоставщика = ПолучитьНастройку("НУ_Поставщик", "");
	Если Не ПустаяСтрока(ИмяПоставщика) Тогда
		Н.Поставщик = Справочники.Контрагенты.НайтиПоНаименованию(ИмяПоставщика);
	КонецЕсли;

	ЗаполнитьМаппингТоплива(Н);

	Н.МаппингОплат["Топливные карты"] = Н.СкладКарты;
	Н.МаппингОплат["Талоны"] = Н.СкладТалоны;
	Н.МаппингОплат["Ведомости"] = Н.СкладВедомости;
	Н.МаппингОплат["Корпоративные"] = Н.СкладВедомости;
	Н.МаппингОплат["Онлайн"] = Н.СкладОнлайн;
	Н.МаппингОплат["Яндекс"] = Н.СкладОнлайн;
	Н.МаппингОплат["Benzuber"] = Н.СкладОнлайн;

	Возврат Н;

КонецФункции

&НаСервере
Процедура ЗаполнитьМаппингТоплива(Настройки)

	КодыТоплива = Новый Массив;
	КодыТоплива.Добавить(92);
	КодыТоплива.Добавить(95);
	КодыТоплива.Добавить(98);
	КодыТоплива.Добавить(5);

	Для Каждого Код Из КодыТоплива Цикл
		ИмяТонны = ПолучитьНастройку("НУ_Топливо_" + Формат(Код, "ЧГ=0") + "_Тонны", "");
		ИмяЛитры = ПолучитьНастройку("НУ_Топливо_" + Формат(Код, "ЧГ=0") + "_Литры", "");
		Если Не ПустаяСтрока(ИмяТонны) И Не ПустаяСтрока(ИмяЛитры) Тогда
			НомТонны = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТонны);
			НомЛитры = Справочники.Номенклатура.НайтиПоНаименованию(ИмяЛитры);
			Если Не НомТонны.Пустая() И Не НомЛитры.Пустая() Тогда
				Настройки.МаппингТоплива[Код] = Новый Структура("Тонны, Литры", НомТонны, НомЛитры);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция НайтиСкладПоНастройке(КлючНастройки)
	ИмяСклада = ПолучитьНастройку(КлючНастройки, "");
	Если ПустаяСтрока(ИмяСклада) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Склады.НайтиПоНаименованию(ИмяСклада);
КонецФункции

&НаСервере
Функция ПолучитьНастройку(Ключ, ЗначениеПоУмолчанию = "")
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Значение ИЗ РегистрСведений.НУ_Настройки ГДЕ Ключ = &Ключ";
		Запрос.УстановитьПараметр("Ключ", Ключ);
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

&НаСервере
Функция РассчитатьСуммуСмены(ОтчётСмены)
	Итого = 0;
	МассивПродаж = ПолучитьИзJSON(ОтчётСмены, "sales", Неопределено);
	Если МассивПродаж = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Для Каждого Блок Из МассивПродаж Цикл
		МассивТ = ПолучитьИзJSON(Блок, "fuel", Неопределено);
		Если МассивТ <> Неопределено Тогда
			Для Каждого Т Из МассивТ Цикл
				Р = ПолучитьИзJSON(Т, "release", Неопределено);
				Итого = Итого + Число(ПолучитьИзJSON(Р, "cost", 0));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Итого;
КонецФункции

&НаСервере
Функция РазобратьДатуISO(СтрокаДаты)
	Попытка
		Год = Число(Лев(СтрокаДаты, 4));
		Месяц = Число(Сред(СтрокаДаты, 6, 2));
		День = Число(Сред(СтрокаДаты, 9, 2));
		Час = 0; Мин = 0; Сек = 0;
		Если СтрДлина(СтрокаДаты) >= 19 Тогда
			Час = Число(Сред(СтрокаДаты, 12, 2));
			Мин = Число(Сред(СтрокаДаты, 15, 2));
			Сек = Число(Сред(СтрокаДаты, 18, 2));
		КонецЕсли;
		Возврат Дата(Год, Месяц, День, Час, Мин, Сек);
	Исключение
		Возврат ТекущаяДата();
	КонецПопытки;
КонецФункции

&НаСервере
Функция СериализоватьВJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаСервере
Функция ДесериализоватьИзJSON(СтрокаJSON)
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервере
Процедура ДобавитьВЛог(Сообщение)
	ТекстЛога = Формат(ТекущаяДата(), "ДФ=dd.MM HH:mm") + "  " + Сообщение + Символы.ПС + ТекстЛога;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИзJSON(Данные, Ключ, ЗначениеПоУмолчанию = Неопределено)
	Если Данные = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные[Ключ];
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство(Ключ) Тогда
			Возврат Данные[Ключ];
		КонецЕсли;
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

#КонецОбласти

