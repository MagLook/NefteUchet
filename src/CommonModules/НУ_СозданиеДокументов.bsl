#Область ПрограммныйИнтерфейс

// Обрабатывает сменный отчёт: создаёт розничные продажи и перемещения на виртуальные склады.
//
// Параметры:
//   ДанныеСмены - Структура - ответ API /v1/report/shift_report
//   Настройки   - Структура - маппинг (см. ПолучитьНастройкиПоУмолчанию)
//   Проводить   - Булево   - проводить ли созданные документы
//
// Возвращаемое значение:
//   Структура - (Документы: Массив ссылок, Ошибки: Массив строк)
//
Функция ОбработатьСменныйОтчёт(ДанныеСмены, Настройки, Проводить = Ложь) Экспорт

	Результат = Новый Структура("Документы, Ошибки", Новый Массив, Новый Массив);

	Если ДанныеСмены = Неопределено Тогда
		Результат.Ошибки.Добавить("Данные сменного отчёта не получены");
		Возврат Результат;
	КонецЕсли;

	// 1. Розничные продажи (наличные + карты)
	Попытка
		ДокРозница = СоздатьРозничныеПродажи(ДанныеСмены, Настройки, Проводить);
		Если ДокРозница <> Неопределено Тогда
			Результат.Документы.Добавить(ДокРозница);
		КонецЕсли;
	Исключение
		Результат.Ошибки.Добавить("Розничные продажи: " + ОписаниеОшибки());
	КонецПопытки;

	// 2. Перемещения на виртуальные склады (топл.карты, талоны, ведомости)
	Если ДанныеСмены.Свойство("sales") Тогда
		Для Каждого БлокПродаж Из ДанныеСмены.sales Цикл

			ИмяВидаОплаты = "";
			Если БлокПродаж.Свойство("pay_type") И БлокПродаж.pay_type.Свойство("name") Тогда
				ИмяВидаОплаты = БлокПродаж.pay_type.name;
			КонецЕсли;

			// Пропускаем наличные и карты — они в розничных продажах
			Если ЭтоФискальнаяРеализация(ИмяВидаОплаты) Тогда
				Продолжить;
			КонецЕсли;

			// Определяем виртуальный склад
			СкладПолучатель = ОпределитьВиртуальныйСклад(ИмяВидаОплаты, Настройки);
			Если СкладПолучатель = Неопределено Тогда
				Результат.Ошибки.Добавить("Не найден склад для вида оплаты: " + ИмяВидаОплаты);
				Продолжить;
			КонецЕсли;

			Попытка
				ДокПеремещение = СоздатьПеремещениеНаВиртСклад(БлокПродаж, Настройки, СкладПолучатель, Проводить);
				Если ДокПеремещение <> Неопределено Тогда
					Результат.Документы.Добавить(ДокПеремещение);
				КонецЕсли;
			Исключение
				Результат.Ошибки.Добавить("Перемещение (" + ИмяВидаОплаты + "): " + ОписаниеОшибки());
			КонецПопытки;

		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Обрабатывает поступление топлива (ТТН): создаёт Поступление + Перемещение + Комплектацию.
//
// Параметры:
//   ДанныеТТН  - Структура - элемент массива receipt[] из API
//   Настройки  - Структура - маппинг
//   Проводить  - Булево
//
// Возвращаемое значение:
//   Структура - (Документы: Массив, Ошибки: Массив)
//
Функция ОбработатьПоступление(ДанныеТТН, Настройки, Проводить = Ложь) Экспорт

	Результат = Новый Структура("Документы, Ошибки", Новый Массив, Новый Массив);

	Если ДанныеТТН = Неопределено Тогда
		Результат.Ошибки.Добавить("Данные ТТН не получены");
		Возврат Результат;
	КонецЕсли;

	// Определяем номенклатуру и плотность
	КодТоплива = 0;
	Если ДанныеТТН.Свойство("service") И ДанныеТТН.service.Свойство("service_code") Тогда
		КодТоплива = ДанныеТТН.service.service_code;
	КонецЕсли;

	Плотность = 0;
	Если ДанныеТТН.Свойство("doc") И ДанныеТТН.doc.Свойство("density") Тогда
		Плотность = Число(ДанныеТТН.doc.density);
	КонецЕсли;

	МассаКг = 0;
	Если ДанныеТТН.Свойство("doc") И ДанныеТТН.doc.Свойство("amount") Тогда
		МассаКг = Число(ДанныеТТН.doc.amount);
	КонецЕсли;

	Стоимость = 0;
	Если ДанныеТТН.Свойство("doc") И ДанныеТТН.doc.Свойство("cost") Тогда
		Стоимость = Число(ДанныеТТН.doc.cost);
	КонецЕсли;

	НомерТТН = "";
	Если ДанныеТТН.Свойство("ttn") Тогда
		НомерТТН = ДанныеТТН.ttn;
	КонецЕсли;

	// Пересчёт литров
	ОбъёмЛитров = 0;
	Если Плотность > 0 Тогда
		ОбъёмЛитров = МассаКг / Плотность;
	КонецЕсли;

	// 1. Поступление на основной склад (тонны, 41.01)
	Попытка
		ДокПоступление = СоздатьПоступлениеТоваров(ДанныеТТН, КодТоплива, МассаКг, Стоимость, Настройки, Проводить);
		Если ДокПоступление <> Неопределено Тогда
			Результат.Документы.Добавить(ДокПоступление);
		КонецЕсли;
	Исключение
		Результат.Ошибки.Добавить("Поступление (ТТН " + НомерТТН + "): " + ОписаниеОшибки());
	КонецПопытки;

	// 2. Перемещение на склад АЗС (41.01 → 41.01)
	Попытка
		ДокПеремещение = СоздатьПеремещениеНаАЗС(КодТоплива, МассаКг, Настройки, Проводить);
		Если ДокПеремещение <> Неопределено Тогда
			Результат.Документы.Добавить(ДокПеремещение);
		КонецЕсли;
	Исключение
		Результат.Ошибки.Добавить("Перемещение на АЗС (ТТН " + НомерТТН + "): " + ОписаниеОшибки());
	КонецПопытки;

	// 3. Комплектация: тонны → литры (41.01 → 41.02)
	Попытка
		ДокКомплектация = СоздатьКомплектацию(КодТоплива, МассаКг, ОбъёмЛитров, Плотность, Настройки, Проводить);
		Если ДокКомплектация <> Неопределено Тогда
			Результат.Документы.Добавить(ДокКомплектация);
		КонецЕсли;
	Исключение
		Результат.Ошибки.Добавить("Комплектация (ТТН " + НомерТТН + "): " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает структуру настроек по умолчанию для маппинга.
// В реальности заполняется из регистра НУ_Настройки.
//
// Возвращаемое значение:
//   Структура
//
Функция ПолучитьНастройкиПоУмолчанию() Экспорт

	Н = Новый Структура;

	// Организация
	Н.Вставить("Организация", Неопределено); // СправочникСсылка.Организации

	// Склады
	Н.Вставить("ОсновнойСклад", Неопределено);  // Нефтебаза (41.01)
	Н.Вставить("СкладАЗС", Неопределено);        // Склад конкретной АЗС
	Н.Вставить("СкладКарты", Неопределено);       // Виртуальный — топливные карты
	Н.Вставить("СкладТалоны", Неопределено);      // Виртуальный — талоны
	Н.Вставить("СкладВедомости", Неопределено);   // Виртуальный — ведомости

	// Контрагенты
	Н.Вставить("Поставщик", Неопределено);        // БАЛТОП АО / Сургутнефтегаз

	// Маппинг видов топлива: КодТоплива → {НоменклатураТонны, НоменклатураЛитры}
	Н.Вставить("МаппингТоплива", Новый Соответствие);
	// Пример: Н.МаппингТоплива[92] = Структура("Тонны", Ном92т, "Литры", Ном92л)

	// Маппинг видов оплаты → виртуальные склады
	Н.Вставить("МаппингОплат", Новый Соответствие);
	// Пример: Н.МаппингОплат["Топливные карты"] = СкладКарты

	// Ставка НДС
	Н.Вставить("СтавкаНДС", 22); // процент

	Возврат Н;

КонецФункции

#КонецОбласти

#Область СозданиеДокументов

// Создаёт «Отчёт о розничных продажах» из данных смены.
// Включает только прямую реализацию (наличные + карты).
//
Функция СоздатьРозничныеПродажи(ДанныеСмены, Настройки, Проводить)

	Если Не ДанныеСмены.Свойство("sales") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Фискальная реализация = наличные + банковские карты (СберБанк, МобилПр.)
	// Это ОДИН документ «Отчёт о розничных продажах» по фискальным чекам.
	// Товары агрегируются по виду топлива (не дублируются по видам оплаты).
	// Оплата разбивается на наличные / безнал внутри документа.

	// Шаг 1: Агрегация товаров по виду топлива (Соответствие: КодТоплива → {Количество, Сумма})
	ТоварыПоКоду = Новый Соответствие;
	СуммаНаличные = 0;
	СуммаБезнал = 0;

	Для Каждого БлокПродаж Из ДанныеСмены.sales Цикл

		ИмяВидаОплаты = "";
		Если БлокПродаж.Свойство("pay_type") И БлокПродаж.pay_type.Свойство("name") Тогда
			ИмяВидаОплаты = БлокПродаж.pay_type.name;
		КонецЕсли;

		// Только фискальная реализация (наличные + карты)
		Если Не ЭтоФискальнаяРеализация(ИмяВидаОплаты) Тогда
			Продолжить;
		КонецЕсли;

		ЭтоНаличные = ЭтоОплатаНаличными(ИмяВидаОплаты);

		Если БлокПродаж.Свойство("fuel") Тогда
			Для Каждого Топливо Из БлокПродаж.fuel Цикл

				КодТоплива = 0;
				Если Топливо.Свойство("service") И Топливо.service.Свойство("service_code") Тогда
					КодТоплива = Топливо.service.service_code;
				КонецЕсли;

				Объём = 0;
				Сумма = 0;
				Если Топливо.Свойство("release") Тогда
					Если Топливо.release.Свойство("volume") Тогда
						Объём = Число(Топливо.release.volume);
					КонецЕсли;
					Если Топливо.release.Свойство("cost") Тогда
						Сумма = Число(Топливо.release.cost);
					КонецЕсли;
				КонецЕсли;

				// Агрегируем по виду топлива
				Агрегат = ТоварыПоКоду[КодТоплива];
				Если Агрегат = Неопределено Тогда
					Агрегат = Новый Структура("КодТоплива, Количество, Сумма", КодТоплива, 0, 0);
					ТоварыПоКоду[КодТоплива] = Агрегат;
				КонецЕсли;
				Агрегат.Количество = Агрегат.Количество + Объём;
				Агрегат.Сумма = Агрегат.Сумма + Сумма;

				// Разбивка оплаты: наличные / безнал
				Если ЭтоНаличные Тогда
					СуммаНаличные = СуммаНаличные + Сумма;
				Иначе
					СуммаБезнал = СуммаБезнал + Сумма;
				КонецЕсли;

			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

	// Шаг 2: Формируем массив товаров из агрегированных данных
	ТаблицаТоваров = Новый Массив;
	Для Каждого КлючЗначение Из ТоварыПоКоду Цикл
		Агрегат = КлючЗначение.Значение;
		Если Агрегат.Количество <> 0 Тогда
			СтрокаТовара = Новый Структура;
			СтрокаТовара.Вставить("КодТоплива", Агрегат.КодТоплива);
			СтрокаТовара.Вставить("Количество", Агрегат.Количество);
			СтрокаТовара.Вставить("Сумма", Агрегат.Сумма);
			СтрокаТовара.Вставить("Цена", ?(Агрегат.Количество <> 0, Агрегат.Сумма / Агрегат.Количество, 0));
			ТаблицаТоваров.Добавить(СтрокаТовара);
		КонецЕсли;
	КонецЦикла;

	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Создание документа
	ДокОбъект = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДата();
	ДокОбъект.Организация = Настройки.Организация;
	ДокОбъект.СкладОрдер = Настройки.СкладАЗС;

	// Заполнение табличной части «Товары»
	Для Каждого СтрТовара Из ТаблицаТоваров Цикл

		МаппингТоплива = ПолучитьМаппингТоплива(СтрТовара.КодТоплива, Настройки);
		Если МаппингТоплива = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ДокОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = МаппингТоплива.Литры;
		НоваяСтрока.Количество = СтрТовара.Количество;
		НоваяСтрока.Цена = СтрТовара.Цена;
		НоваяСтрока.Сумма = СтрТовара.Сумма;
		НоваяСтрока.СтавкаНДС = ПолучитьСтавкуНДС(Настройки.СтавкаНДС);
		НоваяСтрока.СуммаНДС = СтрТовара.Сумма * Настройки.СтавкаНДС / (100 + Настройки.СтавкаНДС);

	КонецЦикла;

	// Запись и проведение
	Если Проводить Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ДокОбъект.Записать();
	КонецЕсли;

	Возврат ДокОбъект.Ссылка;

КонецФункции

// Создаёт «Перемещение товаров» на виртуальный склад.
//
Функция СоздатьПеремещениеНаВиртСклад(БлокПродаж, Настройки, СкладПолучатель, Проводить)

	Если Не БлокПродаж.Свойство("fuel") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Проверяем наличие данных
	ЕстьТовары = Ложь;
	Для Каждого Топливо Из БлокПродаж.fuel Цикл
		Если Топливо.Свойство("release") И Число(Топливо.release.volume) > 0 Тогда
			ЕстьТовары = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьТовары Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДокОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДата();
	ДокОбъект.Организация = Настройки.Организация;
	ДокОбъект.СкладОтправитель = Настройки.СкладАЗС;
	ДокОбъект.СкладПолучатель = СкладПолучатель;

	Для Каждого Топливо Из БлокПродаж.fuel Цикл

		КодТоплива = 0;
		Если Топливо.Свойство("service") И Топливо.service.Свойство("service_code") Тогда
			КодТоплива = Топливо.service.service_code;
		КонецЕсли;

		Объём = 0;
		Если Топливо.Свойство("release") И Топливо.release.Свойство("volume") Тогда
			Объём = Число(Топливо.release.volume);
		КонецЕсли;

		Если Объём <= 0 Тогда
			Продолжить;
		КонецЕсли;

		МаппингТоплива = ПолучитьМаппингТоплива(КодТоплива, Настройки);
		Если МаппингТоплива = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ДокОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = МаппингТоплива.Литры;
		НоваяСтрока.Количество = Объём;

	КонецЦикла;

	Если ДокОбъект.Товары.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Проводить Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ДокОбъект.Записать();
	КонецЕсли;

	Возврат ДокОбъект.Ссылка;

КонецФункции

// Создаёт «Поступление товаров и услуг» (тонны, 41.01).
//
Функция СоздатьПоступлениеТоваров(ДанныеТТН, КодТоплива, МассаКг, Стоимость, Настройки, Проводить)

	МаппингТоплива = ПолучитьМаппингТоплива(КодТоплива, Настройки);
	Если МаппингТоплива = Неопределено Тогда
		ВызватьИсключение "Не найден маппинг для кода топлива: " + Формат(КодТоплива, "ЧГ=0");
	КонецЕсли;

	ДокОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДата();
	ДокОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Товары;
	ДокОбъект.Организация = Настройки.Организация;
	ДокОбъект.Контрагент = Настройки.Поставщик;
	ДокОбъект.Склад = Настройки.ОсновнойСклад;

	// Табличная часть «Товары»
	МассаТонн = МассаКг / 1000;
	ЦенаЗаТонну = ?(МассаТонн > 0, Стоимость / МассаТонн, 0);

	НоваяСтрока = ДокОбъект.Товары.Добавить();
	НоваяСтрока.Номенклатура = МаппингТоплива.Тонны;
	НоваяСтрока.Количество = МассаТонн;
	НоваяСтрока.Цена = ЦенаЗаТонну;
	НоваяСтрока.Сумма = Стоимость;
	НоваяСтрока.СтавкаНДС = ПолучитьСтавкуНДС(Настройки.СтавкаНДС);
	НоваяСтрока.СуммаНДС = Стоимость * Настройки.СтавкаНДС / (100 + Настройки.СтавкаНДС);

	Если Проводить Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ДокОбъект.Записать();
	КонецЕсли;

	Возврат ДокОбъект.Ссылка;

КонецФункции

// Создаёт «Перемещение товаров» с основного склада на склад АЗС (41.01 → 41.01, тонны).
//
Функция СоздатьПеремещениеНаАЗС(КодТоплива, МассаКг, Настройки, Проводить)

	МаппингТоплива = ПолучитьМаппингТоплива(КодТоплива, Настройки);
	Если МаппингТоплива = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	МассаТонн = МассаКг / 1000;

	ДокОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДата();
	ДокОбъект.Организация = Настройки.Организация;
	ДокОбъект.СкладОтправитель = Настройки.ОсновнойСклад;
	ДокОбъект.СкладПолучатель = Настройки.СкладАЗС;

	НоваяСтрока = ДокОбъект.Товары.Добавить();
	НоваяСтрока.Номенклатура = МаппингТоплива.Тонны;
	НоваяСтрока.Количество = МассаТонн;

	Если Проводить Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ДокОбъект.Записать();
	КонецЕсли;

	Возврат ДокОбъект.Ссылка;

КонецФункции

// Создаёт «Комплектация номенклатуры» — пересчёт тонны → литры по плотности.
// Проводка: Дт 41.02 Кт 41.01
//
Функция СоздатьКомплектацию(КодТоплива, МассаКг, ОбъёмЛитров, Плотность, Настройки, Проводить)

	МаппингТоплива = ПолучитьМаппингТоплива(КодТоплива, Настройки);
	Если МаппингТоплива = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ОбъёмЛитров <= 0 ИЛИ Плотность <= 0 Тогда
		ВызватьИсключение "Некорректная плотность или объём для комплектации";
	КонецЕсли;

	МассаТонн = МассаКг / 1000;

	ДокОбъект = Документы.КомплектацияНоменклатуры.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДата();
	ДокОбъект.Организация = Настройки.Организация;
	ДокОбъект.Склад = Настройки.СкладАЗС;

	// Комплект (что получаем) — литры на 41.02
	ДокОбъект.Номенклатура = МаппингТоплива.Литры;
	ДокОбъект.Количество = ОбъёмЛитров;

	// Комплектующие (что тратим) — тонны на 41.01
	НоваяСтрока = ДокОбъект.Комплектующие.Добавить();
	НоваяСтрока.Номенклатура = МаппингТоплива.Тонны;
	НоваяСтрока.Количество = МассаТонн;

	// Записываем плотность в комментарий для аудита
	ДокОбъект.Комментарий = "Плотность: " + Формат(Плотность, "ЧДЦ=4")
		+ " | Масса: " + Формат(МассаКг, "ЧДЦ=1") + " кг"
		+ " | Объём: " + Формат(ОбъёмЛитров, "ЧДЦ=1") + " л"
		+ " | НефтеУчёт";

	Если Проводить Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ДокОбъект.Записать();
	КонецЕсли;

	Возврат ДокОбъект.Ссылка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Определяет, является ли вид оплаты фискальной реализацией.
// Фискальная = наличные + банковские карты — всё что идёт через ККТ/фискальные чеки.
// Это ОДИН документ «Отчёт о розничных продажах».
//
// НЕ фискальная = топливные карты, талоны, ведомости — отдельный учёт через перемещения.
//
Функция ЭтоФискальнаяРеализация(ИмяВидаОплаты)

	// Реальные названия из API STS:
	// Фискальные: "Наличные" (id=1), "СберБанк" (id=26), "МобилПр." (id=235),
	//             "Купон на сдачу" (id=16, отрицательная строка — возврат/скидка)
	// НЕ фискальные: "Топливные карты", "Талоны", "Ведомости", "Корпоративные (КР)"
	ИмяВРег = ВРег(ИмяВидаОплаты);
	Возврат СтрНайти(ИмяВРег, "НАЛИЧН") > 0
		ИЛИ СтрНайти(ИмяВРег, "СБЕРБАНК") > 0
		ИЛИ СтрНайти(ИмяВРег, "СБЕР") > 0
		ИЛИ СтрНайти(ИмяВРег, "МОБИЛ") > 0
		ИЛИ СтрНайти(ИмяВРег, "БЕЗНАЛ") > 0
		ИЛИ СтрНайти(ИмяВРег, "КУПОН") > 0
		ИЛИ СтрНайти(ИмяВРег, "КАРТ") > 0;

КонецФункции

// Определяет, является ли оплата наличными.
//
Функция ЭтоОплатаНаличными(ИмяВидаОплаты)

	// Наличные = только "Наличные" и "Купон на сдачу"
	// Всё остальное (СберБанк, МобилПр., карты) = безнал → 57.03
	ИмяВРег = ВРег(ИмяВидаОплаты);
	Возврат СтрНайти(ИмяВРег, "НАЛИЧН") > 0
		ИЛИ СтрНайти(ИмяВРег, "КУПОН") > 0;

КонецФункции

// Определяет виртуальный склад по имени вида оплаты.
//
Функция ОпределитьВиртуальныйСклад(ИмяВидаОплаты, Настройки)

	// Сначала проверяем точный маппинг
	Если Настройки.МаппингОплат <> Неопределено Тогда
		Склад = Настройки.МаппингОплат[ИмяВидаОплаты];
		Если Склад <> Неопределено Тогда
			Возврат Склад;
		КонецЕсли;
	КонецЕсли;

	// Автоопределение по ключевым словам
	ИмяВРег = ВРег(ИмяВидаОплаты);

	Если СтрНайти(ИмяВРег, "ТОПЛИВ") > 0 ИЛИ СтрНайти(ИмяВРег, "КАРТ") > 0 Тогда
		// "Топливные карты" — но не "Банковские карты" (те в прямой реализации)
		Если Не ЭтоФискальнаяРеализация(ИмяВидаОплаты) Тогда
			Возврат Настройки.СкладКарты;
		КонецЕсли;
	КонецЕсли;

	Если СтрНайти(ИмяВРег, "ТАЛОН") > 0 ИЛИ СтрНайти(ИмяВРег, "ВАУЧЕР") > 0 ИЛИ СтрНайти(ИмяВРег, "КУПОН") > 0 Тогда
		Возврат Настройки.СкладТалоны;
	КонецЕсли;

	Если СтрНайти(ИмяВРег, "ВЕДОМОСТ") > 0 ИЛИ СтрНайти(ИмяВРег, "КОРПОРАТИВ") > 0 ИЛИ СтрНайти(ИмяВРег, "КР") > 0 Тогда
		Возврат Настройки.СкладВедомости;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Получает маппинг номенклатуры по коду топлива.
//
// Возвращаемое значение:
//   Структура (Тонны, Литры) или Неопределено
//
Функция ПолучитьМаппингТоплива(КодТоплива, Настройки)

	Если Настройки.МаппингТоплива = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Настройки.МаппингТоплива[КодТоплива];

КонецФункции

// Получает значение перечисления «Ставки НДС» по числовому проценту.
//
Функция ПолучитьСтавкуНДС(ПроцентНДС)

	Если ПроцентНДС = 22 Тогда
		Возврат Перечисления.СтавкиНДС.НДС22;
	ИначеЕсли ПроцентНДС = 20 Тогда
		Возврат Перечисления.СтавкиНДС.НДС20;
	ИначеЕсли ПроцентНДС = 10 Тогда
		Возврат Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли ПроцентНДС = 0 Тогда
		Возврат Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;

	Возврат Перечисления.СтавкиНДС.НДС22;

КонецФункции

#КонецОбласти
