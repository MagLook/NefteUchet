//  ПЕРЕЗАГРУЗКА ПЕРИОДА (C-направление плана luminous-humming-curry)
// ==========================================================================

// Команда «Перезагрузить период» — открывает диалог с выбором действия:
// Дозагрузить недостающее (безопасно) / Перепровести существующие документы.
//
// Сбрасывать регистрацию — отдельная команда СбросРегистрацииПериода
// (опаснее, требует отдельного подтверждения).
//
&НаКлиенте
Процедура ПерезагрузитьПериод(Команда)

	Если Не ЗначениеЗаполнено(ДатаНачала) ИЛИ Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Заполните Период.");
		Возврат;
	КонецЕсли;
	Если ДатаНачала > ДатаОкончания Тогда
		ПоказатьПредупреждение(, "Дата начала позже даты окончания.");
		Возврат;
	КонецЕсли;

	// Шаг 1: предпросмотр — сколько смен затронем
	Предпросмотр = ПолучитьПредпросмотрПерезагрузки();
	Если Предпросмотр.СменКПрохождению = 0 Тогда
		ПоказатьПредупреждение(, "За выбранный период загруженных смен не найдено."
			+ Символы.ПС + "Сначала загрузите смены обычной кнопкой «Загрузить выбранные».");
		Возврат;
	КонецЕсли;

	// Шаг 2: диалог выбора действия — ДаНетОтмена работает как Дозагрузить/Перепровести/Отмена
	Текст = "Перезагрузка периода " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " — "
		+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy") + " (станция: "
		+ ?(КодСтанции = 0, "все", Строка(КодСтанции)) + ")"
		+ Символы.ПС + "Найдено смен: " + Предпросмотр.СменКПрохождению
		+ Символы.ПС + Символы.ПС
		+ "Выберите действие:"
		+ Символы.ПС + "• «Да» — Дозагрузить недостающее (создаст только отсутствующие подключи, дубли не плодит)"
		+ Символы.ПС + "• «Нет» — Перепровести существующие документы (запишет с проведением)"
		+ Символы.ПС + "• «Отмена» — отмена";

	Оповещение = Новый ОписаниеОповещения("ПерезагрузитьПериодЗавершение", ЭтаФорма);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

// Завершение диалога перезагрузки.
//
&НаКлиенте
Процедура ПерезагрузитьПериодЗавершение(Результат, ДопПараметры) Экспорт

	Действие = "";
	Если Результат = КодВозвратаДиалога.Да Тогда
		Действие = "Дозагрузить";
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Действие = "Перепровести";
	Иначе
		ДобавитьВЛог("Перезагрузка периода отменена.");
		Возврат;
	КонецЕсли;

	ДобавитьВЛог("Перезагрузка периода: " + Действие + "...");
	ВыполнитьПерезагрузкуНаСервере(Действие);

КонецПроцедуры

// Команда «Сбросить регистрацию периода» — отдельная (опасная) операция.
// Удаляет записи из TL_СтатусыЗагрузки за период. Документы БП не трогает.
//
&НаКлиенте
Процедура СбросРегистрацииПериода(Команда)

	Если Не ЗначениеЗаполнено(ДатаНачала) ИЛИ Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Заполните Период.");
		Возврат;
	КонецЕсли;

	Текст = "ВНИМАНИЕ! Будут удалены записи о загрузке из TL_СтатусыЗагрузки за период"
		+ Символы.ПС + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " — " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy") + "."
		+ Символы.ПС + Символы.ПС
		+ "Документы БП НЕ удаляются — но связь между сменой STS и документом будет утрачена."
		+ Символы.ПС + "Используйте только если уверены — обычно достаточно «Дозагрузить»."
		+ Символы.ПС + Символы.ПС
		+ "Продолжить?";

	Оповещение = Новый ОписаниеОповещения("СбросРегистрацииПериодаЗавершение", ЭтаФорма);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура СбросРегистрацииПериодаЗавершение(Результат, ДопПараметры) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ДобавитьВЛог("Сброс регистрации отменён.");
		Возврат;
	КонецЕсли;
	ДобавитьВЛог("Сброс регистрации периода...");
	ВыполнитьПерезагрузкуНаСервере("СбросРегистрации");
КонецПроцедуры

