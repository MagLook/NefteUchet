		ИнвССылка = TL_МаппингЦБ.НайтиСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Инвентаризация, ИнвUUID);
		Если ЗначениеЗаполнено(ИнвССылка) Тогда
			УстановитьРеквизитБезопасно(Объект, "ИнвентаризацияТоваровНаСкладе", ИнвССылка);
		КонецЕсли;
	КонецЕсли;

	Объект.СуммаДокумента = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаДокумента", 0);
	УстановитьРеквизитБезопасно(Объект, "ВалютаДокумента", ПолучитьВалютуRUB());

	Объект.Комментарий = ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат);
	Возврат Истина;

КонецФункции

Процедура ЗаполнитьТоварыWriteoff(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Товары = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Товары", Новый Массив);
	Если ТипЗнч(Товары) <> Тип("Массив") И ТипЗнч(Товары) <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение "writeoff: поле Товары не массив";
	КонецЕсли;

	Объект.Товары.Очистить();
	СчётТовара = TL_МаппингЦБ.ОпределитьСчётУчётаТовара("writeoff", "Сопутка");

	Для Каждого СтрJSON Из Товары Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "writeoff: номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;

		Стр = Объект.Товары.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Количество   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);
		УстановитьРеквизитБезопасно(Стр, "Цена",
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена", 0));
		УстановитьРеквизитБезопасно(Стр, "Сумма",
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Сумма", 0));
		УстановитьРеквизитБезопасно(Стр, "СчетУчета", СчётТовара);
	КонецЦикла;

КонецПроцедуры

// ============================================================================
//  ОБРАБОТКА ДОКУМЕНТА kind=transfer (Перемещение товаров)
// ============================================================================
//
// Источник в ЦБ ЭЛСИ.АЗК — Документ.ПеремещениеТоваров.
// Приёмник в БП ГИГ — Документ.ПеремещениеТоваров (внутренние движения по 41.02).
// Использует SeparateСкладОтправитель/СкладПолучатель (оба должны быть в БП ГИГ).
//
Процедура ОбработатьTransfer(Док, ИдентификаторПакета, ПроводитьПоУмолчанию, Результат)

	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Результат.Ошибки.Добавить("transfer: документ без ИсточникUUID — пропущен");
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Объект = НайтиИлиСоздатьПеремещение(ИсточникUUID);

		Если Не ЗаполнитьШапкуTransfer(Объект, Док, ИдентификаторПакета,
				ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		ЗаполнитьТоварыTransfer(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);

		ПометкаУдаления = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь);
		ПроведенJSON   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Проведен", Истина);

		Если ПометкаУдаления Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Объект.УстановитьПометкуУдаления(Истина);
		Иначе
			Если Объект.ПометкаУдаления Тогда
				Объект.УстановитьПометкуУдаления(Ложь);
				Объект = Объект.Ссылка.ПолучитьОбъект();
				ЗаполнитьШапкуTransfer(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
				ЗаполнитьТоварыTransfer(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
			КонецЕсли;
			Если ПроводитьПоУмолчанию = Ложь Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			ИначеЕсли ПроведенJSON Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			Иначе
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;
			Объект.Записать(РежимЗаписи);
		КонецЕсли;

		TL_МаппингЦБ.ЗаписатьСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Перемещение,
			ИсточникUUID, Объект.Ссылка, ИдентификаторПакета,
			ВычислитьХешДокумента(Док), Результат.КонтекстСмены);

		Результат.Документы.Добавить(Объект.Ссылка);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Перемещение,
			Перечисления.TL_ПолеОшибки.Прочее,
			Перечисления.TL_КодОшибкиЗагрузки.ОшибкаПроведения,
			"",
			"Ошибка transfer: " + ОписаниеОшибки(),
			Результат);
	КонецПопытки;

КонецПроцедуры

Функция НайтиИлиСоздатьПеремещение(ИсточникUUID)
	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Перемещение, ИсточникUUID);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Попытка
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Возврат Объект;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Документы.ПеремещениеТоваров.СоздатьДокумент();
КонецФункции

Функция ЗаполнитьШапкуTransfer(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Объект.Дата = ПолучитьДатуИзJSON(Док, "Дата");

	ОрганизацияUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Организация", "");
	Орг = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(ОрганизацияUUID);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Перемещение,
			Перечисления.TL_ПолеОшибки.Организация,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОрганизацияUUID,
			"Организация не найдена по UUID " + ОрганизацияUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Организация = Орг;

	// Оба склада обязательны
	ОтправUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СкладОтправитель", "");
	Отправ = TL_МаппингЦБ.ПолучитьСкладПоUUID(ОтправUUID);
	Если Не ЗначениеЗаполнено(Отправ) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Перемещение,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОтправUUID,
			"СкладОтправитель не найден по UUID " + ОтправUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.СкладОтправитель = Отправ;

	ПолучUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СкладПолучатель", "");
	Получ = TL_МаппингЦБ.ПолучитьСкладПоUUID(ПолучUUID);
	Если Не ЗначениеЗаполнено(Получ) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Перемещение,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ПолучUUID,
			"СкладПолучатель не найден по UUID " + ПолучUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.СкладПолучатель = Получ;

	УстановитьРеквизитБезопасно(Объект, "Подразделение", TL_МаппингЦБ.ПолучитьПодразделениеПоСкладу(Отправ));

	Объект.Комментарий = ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат);
	Возврат Истина;

КонецФункции

Процедура ЗаполнитьТоварыTransfer(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Товары = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Товары", Новый Массив);
	Если ТипЗнч(Товары) <> Тип("Массив") И ТипЗнч(Товары) <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение "transfer: поле Товары не массив";
	КонецЕсли;

	Объект.Товары.Очистить();

	// Перемещение внутри 41.02: счёт-отправитель = счёт-получатель = 41.02.
	// Без СчетУчета/НовыйСчетУчета проведение валит «Не заполнены оба счета»
	// в Регистре бухгалтерии (БП 3.0 не выводит проводку Дт..Кт без счетов).
	Счёт = TL_МаппингЦБ.ОпределитьСчётУчётаТовара("transfer", "Сопутка");

	Для Каждого СтрJSON Из Товары Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "transfer: номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;

		Стр = Объект.Товары.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Количество   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);
		УстановитьРеквизитБезопасно(Стр, "Цена",
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена", 0));
		УстановитьРеквизитБезопасно(Стр, "Себестоимость",
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Себестоимость", 0));
		УстановитьРеквизитБезопасно(Стр, "СчетУчета",     Счёт);
		УстановитьРеквизитБезопасно(Стр, "НовыйСчетУчета", Счёт);
	КонецЦикла;

КонецПроцедуры

// ============================================================================
//  ВСПОМОГАТЕЛЬНЫЕ
// ============================================================================

// Зафиксировать ошибку для документа неизвестного / неподдерживаемого kind.
//
Процедура ЗафиксироватьОшибкуKind(Док, Kind, ИдентификаторПакета, Результат)

	UUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	ЗаписатьОшибку(ИдентификаторПакета, UUID,
		Перечисления.TL_ТипОбъектаИсточника.Поступление,
		Перечисления.TL_ПолеОшибки.Прочее,
		Перечисления.TL_КодОшибкиЗагрузки.Прочее,
		Kind,
		"kind '" + Kind + "' не покрыт фазой A3",
		Результат);

КонецПроцедуры

// Записать ошибку маппинга НСИ.
//
Процедура ЗаписатьОшибкуНСИ(ИдентификаторПакета, UUID, ТипОбъекта, Поле, Сообщение, Результат)

	ЗаписатьОшибку(ИдентификаторПакета, UUID, ТипОбъекта, Поле,
		Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена, "", Сообщение, Результат);

КонецПроцедуры

// Универсальная запись ошибки в TL_ОшибкиЗагрузки + дублирование в Результат.Ошибки.
//
Процедура ЗаписатьОшибку(ИдентификаторПакета, UUID, ТипОбъекта, Поле,
	КодОшибки, ЗначениеИсточника, Сообщение, Результат)

	Параметры = Новый Структура;
	Параметры.Вставить("ИдентификаторПакета", ИдентификаторПакета);
	Параметры.Вставить("ИсточникUUID", UUID);
	Параметры.Вставить("ТипОбъекта", ТипОбъекта);
	Параметры.Вставить("Поле", Поле);
	Параметры.Вставить("КодОшибки", КодОшибки);
	Параметры.Вставить("ЗначениеИсточника", ЗначениеИсточника);
	Параметры.Вставить("СообщениеОшибки", Сообщение);

	TL_Сверка.ЗаписатьОшибку(Параметры);

	Результат.Ошибки.Добавить(Сообщение);

КонецПроцедуры

// Проверка идемпотентности на уровне пакета — есть ли запись TL_СверкаПакета
// со статусом ПринятоЦеликом.
//
Функция ПакетУжеЗагружен(ИдентификаторПакета)

	Если Не ЗначениеЗаполнено(ИдентификаторПакета) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Статус ИЗ РегистрСведений.TL_СверкаПакета
		|ГДЕ ИдентификаторПакета = &ИдПакета");
	Запрос.УстановитьПараметр("ИдПакета", ИдентификаторПакета);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И Выборка.Статус = Перечисления.TL_СтатусПакета.ПринятоЦеликом Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Извлечь дату из JSON-поля (поддерживает ISO 8601 и yyyy-MM-dd).
//
Функция ПолучитьДатуИзJSON(Источник, Ключ)

	Значение = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Источник, Ключ, "");
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), Строка(Значение));
	Исключение
		Попытка
			С = Строка(Значение);
			Возврат Дата(Число(Лев(С, 4)), Число(Сред(С, 6, 2)), Число(Сред(С, 9, 2)));
		Исключение
			Возврат '00010101';
		КонецПопытки;
	КонецПопытки;

КонецФункции

// Построить параметры для автосоздания договора из JSON-объекта НСИ.
//
Функция ПостроитьПараметрыДоговора(Объект)

	Параметры = Новый Структура;
	Имя = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Наименование", "");
	Если ЗначениеЗаполнено(Имя) Тогда
		Параметры.Вставить("Наименование", Имя);
	КонецЕсли;

	Номер = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Номер", "");
	Если ЗначениеЗаполнено(Номер) Тогда
		Параметры.Вставить("Номер", Номер);
	КонецЕсли;

	ДатаСтр = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Дата", "");
	Если ЗначениеЗаполнено(ДатаСтр) Тогда
		Попытка
			Параметры.Вставить("Дата", XMLЗначение(Тип("Дата"), Строка(ДатаСтр)));
		Исключение
		КонецПопытки;
	КонецЕсли;

	Вид = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "ВидДоговора", "СПоставщиком");
	Параметры.Вставить("ВидДоговора", Вид);

	Возврат Параметры;

КонецФункции

// Безопасная установка реквизита (для опциональных полей которые могут отсутствовать).
//
Процедура УстановитьРеквизитБезопасно(Объект, Имя, Значение)
	Попытка
		Объект[Имя] = Значение;
	Исключение
	КонецПопытки;
КонецПроцедуры

// Поиск рублёвой валюты.
//
Функция ПолучитьВалютуRUB()
	Попытка
		Возврат Справочники.Валюты.НайтиПоКоду("643");
	Исключение
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецПопытки;
КонецФункции

// Хеш отдельного документа в пакете — для отслеживания «пустых» повторов
// (если ЦБ перевыгрузил тот же документ без изменений). Простая функция:
// SHA-256 от сериализованного JSON-фрагмента документа.
//
Функция ВычислитьХешДокумента(Док)

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Док);
		Тело = ЗаписьJSON.Закрыть();

		Двоичные = ПолучитьДвоичныеДанныеИзСтроки(Тело, "UTF-8", Ложь);
		Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеш.Добавить(Двоичные);
		Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Извлечь контекст смены из шапки Смена{} пакета формата v2.
// Возвращает Структура {КодАЗС, СкладUUID, ОрганизацияUUID, НомерСмены,
//   Открытие (Дата), Закрытие (Дата), ДатаСмены (Дата), Оператор, Касса, ОСЭНомер}
// или Неопределено, если шапка Смена{} отсутствует (формат v1).
//
Функция ИзвлечьКонтекстСмены(Пакет)

	Смена = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Смена", Неопределено);
	Если Смена = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Контекст = Новый Структура;

	КодАЗС = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "КодАЗС", 0);
	Попытка
		Контекст.Вставить("КодАЗС", Число(КодАЗС));
	Исключение
		Контекст.Вставить("КодАЗС", 0);
	КонецПопытки;

	Контекст.Вставить("СкладUUID",       TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "СкладUUID", ""));
	Контекст.Вставить("ОрганизацияUUID", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "ОрганизацияUUID", ""));
	Контекст.Вставить("НомерСмены",      TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "НомерСмены", ""));

	Открытие = ПолучитьДатуИзJSON(Смена, "Открытие");
	Закрытие = ПолучитьДатуИзJSON(Смена, "Закрытие");
	Контекст.Вставить("Открытие", Открытие);
	Контекст.Вставить("Закрытие", Закрытие);
	// ДатаСмены = дата без времени из Открытия (для регистров с типом Date)
	Контекст.Вставить("ДатаСмены", ?(ЗначениеЗаполнено(Открытие), НачалоДня(Открытие), '00010101'));

	Контекст.Вставить("Оператор", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "Оператор", ""));
	Контекст.Вставить("Касса",    TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "Касса",    ""));
	Контекст.Вставить("ОСЭНомер", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "ОСЭНомер", ""));

	Возврат Контекст;

КонецФункции

// Построить Комментарий созданного документа БП: UX-подсказка о смене + технический хвост.
// Если КонтекстСмены пуст (старый формат v1) — оставляем только технический хвост.
//
Функция ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат)

	Технический = "TL|ЦБ|" + ИдентификаторПакета + "|" + ИсточникUUID;

	Если Результат = Неопределено Или Не Результат.Свойство("КонтекстСмены")
			Или Результат.КонтекстСмены = Неопределено Тогда
		Возврат Технический;
	КонецЕсли;

	К = Результат.КонтекстСмены;
	Префикс = "Смена АЗС" + Формат(К.КодАЗС, "ЧЦ=3; ЧВН=; ЧГ=0")
		+ " №" + СокрЛП(К.НомерСмены)
		+ " от " + Формат(К.ДатаСмены, "ДФ='dd.MM.yyyy'");

	Возврат Префикс + " | " + Технический;

КонецФункции

#КонецОбласти
