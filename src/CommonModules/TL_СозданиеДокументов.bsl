////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_СозданиеДокументов
// Расширение ElsyPlus Ledger для 1С:БП 3.0
// Контекст: Сервер
// Создание типовых документов 1С из данных API STS.
//
// Каждый обработчик возвращает Структуру("Документы, Ошибки"):
//   Документы - Массив ссылок на созданные документы
//   Ошибки   - Массив строк с описаниями ошибок
//
// Маппинг и настройки — через единый модуль TL_Настройки (v4).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработать сменный отчёт: создать Отчёт о розничных продажах
// и Перемещения на виртуальные склады (по каналам оплат).
//
// Параметры:
//   ДанныеJSON    - Строка - JSON сменного отчёта из API
//   КлючЗагрузки  - Строка - уникальный ключ "TL|СМЕНА|система|станция|смена"
//   Проводить     - Булево - проводить документ сразу (по умолчанию Ложь)
//
// Возвращаемое значение:
//   Структура - ("Документы, Ошибки")
//
Функция ОбработатьСмену(ДанныеJSON, КлючЗагрузки, Проводить = Ложь, ДатаДокумента = Неопределено) Экспорт

	Результат = Новый Структура("Документы, Ошибки", Новый Массив, Новый Массив);

	// Нормализация ключа (без висячих пробелов — иначе сломается связь по комментарию)
	КлючЗагрузки = СокрЛП(КлючЗагрузки);

	// Защита от дублей
	ИнфоСуществует = TL_РегистрСтатусов.ПолучитьСтатус(КлючЗагрузки);
	Если ИнфоСуществует <> Неопределено Тогда
		Результат.Ошибки.Добавить("Документ уже загружен: " + КлючЗагрузки);
		Возврат Результат;
	КонецЕсли;

	Попытка
		Данные = ПолучитьИзJSON(ДанныеJSON);
	Исключение
		Результат.Ошибки.Добавить("Ошибка разбора JSON: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Если Данные = Неопределено Тогда
		// Пустые данные обычно означают что STS не отдал отчёт (HTTP 500, таймаут).
		// Сообщение указывает бухгалтеру что искать причину НЕ в настройках БП.
		Текст =
			"Нет данных смены — STS-сервер не вернул отчёт." + Символы.ПС
			+ "Проверьте в Описании смены пометку «⚠ STS HTTP 500» (серверная ошибка STS)" + Символы.ПС
			+ "или «⚠ ошибка авторизации» (проверьте логин/пароль в Настройках TradeLedger)." + Символы.ПС
			+ "Это не настройка БП ГИГ — обратитесь в техподдержку pos.autooplata.ru с номером смены.";
		Результат.Ошибки.Добавить(Текст);
		// F: структурированная запись с категорией для детального отчёта
		ЗаписатьОшибкуСмены(КлючЗагрузки, Перечисления.TL_КодОшибкиЗагрузки.STS_ОшибкаСервера,
			"Сервер STS не вернул сменный отчёт (пустые данные)", КлючЗагрузки);
		Возврат Результат;
	КонецЕсли;

	// Организация
	Организация = TL_Настройки.ПолучитьОрганизацию();
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.Ошибки.Добавить("Организация не найдена в справочнике");
		Возврат Результат;
	КонецЕсли;

	// Склад АЗС по номеру станции
	КодСтанции = TL_ApiКлиент.ПолучитьЗначение(Данные, "station", 0);
	СкладАЗС = TL_Настройки.НайтиСкладСтанции(КодСтанции);
	Если Не ЗначениеЗаполнено(СкладАЗС) Тогда
		Результат.Ошибки.Добавить("Склад для станции " + XMLСтрока(КодСтанции) + " не найден");
		Возврат Результат;
	КонецЕсли;

	// Дата смены: приоритет — переданная из формы, затем из API, затем текущая
	ДатаСмены = ДатаДокумента;
	Если Не ЗначениеЗаполнено(ДатаСмены) Тогда
		ДатаСмены = TL_ApiКлиент.ПолучитьДатуИзДанных(Данные, "dt_open");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаСмены) Тогда
		ДатаСмены = TL_ApiКлиент.ПолучитьДатуИзДанных(Данные, "date");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаСмены) Тогда
		ДатаСмены = ТекущаяДата();
	КонецЕсли;
	ДатаСмены = TL_Настройки.НормализоватьДатуСмены(ДатаСмены, КодСтанции);

	// Ставка НДС
	СтавкаНДС = TL_Настройки.ПолучитьСтавкуНДС();

	// --- Единый источник данных: sales (транзакции с pay_type + fuel + volume) ---
	// Из sales строим ВСЁ: розничные продажи + перемещения на виртуальные склады.
	// Это исключает двойной учёт (pumps содержит ВСЕ литры, а нам нужно разделение).

	МассивПродаж = TL_ApiКлиент.ПолучитьЗначение(Данные, "sales", Неопределено);

	// --- Предупреждение (не блокер): незамапленные pay_type ---
	// Раньше это был блокер (Возврат), но в проде это значит «упало всё» из-за одного
	// нового канала (например, Газпромнефть появился на АЗС 8). Теперь — предупреждение
	// в лог, незамапленные строки пропускаются автоматически (как купоны), смена грузится.
	// Бухгалтер увидит предупреждение и сможет настроить маппинг для следующих загрузок.
	НезамапленныеИмена = ПроверитьМаппингОплат(МассивПродаж);
	Если НезамапленныеИмена.Количество() > 0 Тогда
		СписокИмён = "";
		Для Каждого Имя Из НезамапленныеИмена Цикл
			СписокИмён = СписокИмён + ?(ЗначениеЗаполнено(СписокИмён), ", ", "") + """" + Имя + """";
		КонецЦикла;
		// Не блокер — Предупреждение (массив Результат.Предупреждения если есть,
		// иначе в Ошибки, но без Возврата — чтобы смена грузилась)
		ТекстПредупреждения = "⚠ Обнаружены новые виды оплат, не настроенные в маппинге: " + СписокИмён + "."
			+ " Эти строки пропущены (без потерь, источник в STS остался)." + Символы.ПС
			+ "Чтобы учитывать их в следующих сменах: «Настройки TradeLedger» → «Маппинг оплат» → создайте запись с"
			+ " каналом (cards / online / ledger / voucher / retail_cash / retail_card / writeoff_fuel) или"
			+ " оставьте канал пустым для игнорирования (как купоны/прокачка).";
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("Предупреждения") Тогда
			Результат.Предупреждения.Добавить(ТекстПредупреждения);
		Иначе
			Результат.Ошибки.Добавить(ТекстПредупреждения);
		КонецЕсли;
		ЗаписьЖурналаРегистрации("TL_СозданиеДокументов",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Незамапленные pay_type: " + СписокИмён + " (загрузка продолжена)");
		// F: структурированная запись каждого незамапленного имени отдельно
		Для Каждого Имя Из НезамапленныеИмена Цикл
			ЗаписатьОшибкуСмены(КлючЗагрузки, Перечисления.TL_КодОшибкиЗагрузки.МаппингОплат_НеНайден,
				"Не настроен маппинг для pay_type «" + Имя + "» — строки пропущены", Имя);
		КонецЦикла;
		// НЕ Возврат — продолжаем загрузку!
	КонецЕсли;

	// Агрегировать продажи: (Канал × КодТоплива) → {Литры, Сумма}
	// Канал: "retail_cash" (наличные), "retail_card" (эквайринг), "cards" (топл.карты), "online" (Яндекс)
	АгрегатПоКаналам = АгрегироватьПродажиПоКаналам(МассивПродаж);

	// --- Шаг 1: Отчёт о розничных продажах (ТОЛЬКО канал retail) ---
	// Время документа из настроек (по умолчанию 23:50)
	ДатаДокументаСмены = TL_Настройки.ПрименитьВремяДокумента(ДатаСмены, "СменныйОтчёт");

	НачатьТранзакцию();
	Попытка
		Док = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
		Док.Дата = ДатаДокументаСмены;
		Док.Организация = Организация;
		Док.Комментарий = КлючЗагрузки;

		// ВидОперации = ОтчетККМОПродажах (в 1С:БП 2018 = "Розничный магазин")
		Попытка
			Док.ВидОперации = Перечисления.ВидыОперацийОтчетОРозничныхПродажах.ОтчетККМОПродажах;
		Исключение
		КонецПопытки;

		// Ответственный = текущий пользователь
		Попытка
			Док.Ответственный = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя(), Истина);
		Исключение
		КонецПопытки;

		УстановитьРеквизитБезопасно(Док, "СкладОрганизации", СкладАЗС);
		УстановитьРеквизитБезопасно(Док, "Склад", СкладАЗС);

		// Обязательные реквизиты для проведения
		Попытка Док.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду("643"); Исключение КонецПопытки;
		УстановитьРеквизитБезопасно(Док, "КурсДокумента", 1);
		УстановитьРеквизитБезопасно(Док, "КратностьДокумента", 1);
		УстановитьРеквизитБезопасно(Док, "СуммаВключаетНДС", Истина);
		Попытка Док.СчетКасса = ПланыСчетов.Хозрасчетный.НайтиПоКоду("50.01"); Исключение КонецПопытки;
		// СтатьяДвиженияДенежныхСредств
		Попытка
			Док.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Розничная выручка", Истина);
		Исключение
		КонецПопытки;

		// Счета учёта (для программного создания)
		СчетаБУ = ПолучитьСчетаУчёта();

		// Заполнить товарами ТОЛЬКО из канала retail
		Для Каждого КлючЗначение Из АгрегатПоКаналам Цикл
			Агрегат = КлючЗначение.Значение;

			Если Агрегат.КлючКанала <> "retail_cash" И Агрегат.КлючКанала <> "retail_card" Тогда
				Продолжить;
			КонецЕсли;

			Если Агрегат.Литры <= 0 Тогда
				Продолжить;
			КонецЕсли;

			Номенклатура = TL_Настройки.НайтиНоменклатуруТоплива(Агрегат.КодТоплива, "л", КодСтанции);
			Если Не ЗначениеЗаполнено(Номенклатура) Тогда
				Результат.Ошибки.Добавить("Номенклатура не найдена: " + Агрегат.КодТоплива + " (л)");
				Продолжить;
			КонецЕсли;

			НоваяСтрока = Док.Товары.Добавить();
			НоваяСтрока.Номенклатура = Номенклатура;
			НоваяСтрока.Количество   = Агрегат.Литры;
			НоваяСтрока.Сумма        = Агрегат.Сумма;
			// Цена: Сумма / Литры, округлённая до 2 знаков (как привыкли бухгалтеры: 63.90, не 63.9).
			// Сумма из API первична — она не меняется. Цена — для отображения.
			Если Агрегат.Литры <> 0 Тогда
				НоваяСтрока.Цена = Окр(Агрегат.Сумма / Агрегат.Литры, 2);
			КонецЕсли;

			// Счета учёта (розница: 41.02 учёт, 90.01.1 доходы, 90.02.1 расходы)
			УстановитьРеквизитБезопасно(НоваяСтрока, "СчетУчета", СчетаБУ.Счёт4102);
			УстановитьРеквизитБезопасно(НоваяСтрока, "СчетДоходов", СчетаБУ.Счёт9001);
			УстановитьРеквизитБезопасно(НоваяСтрока, "СчетРасходов", СчетаБУ.Счёт9002);
			УстановитьРеквизитБезопасно(НоваяСтрока, "СчетУчетаНДСПоРеализации", СчетаБУ.Счёт9003);

			// Розничные цены (обязательны для складов типа «Розничный магазин»,
			// иначе ОбработкаПроведения делит на 0 при расчёте наценки)
			УстановитьРеквизитБезопасно(НоваяСтрока, "ЦенаВРознице", НоваяСтрока.Цена);
			УстановитьРеквизитБезопасно(НоваяСтрока, "СуммаВРознице", Агрегат.Сумма);

			Если ЗначениеЗаполнено(СтавкаНДС) Тогда
				УстановитьРеквизитБезопасно(НоваяСтрока, "СтавкаНДС", СтавкаНДС);
				СуммаНДС = РассчитатьСуммуНДС(Агрегат.Сумма, СтавкаНДС);
				УстановитьРеквизитБезопасно(НоваяСтрока, "СуммаНДС", СуммаНДС);
			КонецЕсли;
		КонецЦикла;

		// Информация по каналам — в комментарий
		ТекстКаналов = СформироватьТекстКаналов(АгрегатПоКаналам);
		Если ЗначениеЗаполнено(ТекстКаналов) Тогда
			Док.Комментарий = Док.Комментарий + " | " + ТекстКаналов;
		КонецЕсли;

		// Не записывать пустой документ (нет розничных строк)
		Если Док.Товары.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			Результат.Ошибки.Добавить("Нет розничных продаж (retail) для создания Отчёта");
			Возврат Результат;
		КонецЕсли;

		// Табличная часть "Оплата" — сумма по банковским картам (retail_card).
		// 1С автоматически считает наличные = Итого - Безнал.
		СуммаБезнал = 0;
		Для Каждого КлючЗначение Из АгрегатПоКаналам Цикл
			Если КлючЗначение.Значение.КлючКанала = "retail_card" Тогда
				СуммаБезнал = СуммаБезнал + КлючЗначение.Значение.Сумма;
			КонецЕсли;
		КонецЦикла;

		Если СуммаБезнал > 0 Тогда
			Попытка
				СтрокаОплаты = Док.Оплата.Добавить();
				СтрокаОплаты.ВидОплаты = Справочники.ВидыОплатОрганизаций.НайтиПоНаименованию("Платежная карта", Истина);
				СтрокаОплаты.СуммаОплаты = Окр(СуммаБезнал, 2);
			Исключение
			КонецПопытки;
		КонецЕсли;

		// Запись
		Если Проводить Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		Результат.Документы.Добавить(Док.Ссылка);
		TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючЗагрузки, Док.Ссылка, "Смена");
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Ошибка создания Отчёта о розн. продажах: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// --- Шаг 2: Перемещения на виртуальные склады (каналы cards, online) ---
	// Время из настроек (по умолчанию 23:50)
	ДатаПеремещенийКаналов = TL_Настройки.ПрименитьВремяДокумента(ДатаСмены, "ПеремещениеКаналов");
	СоздатьПеремещенияИзАгрегата(Результат, Организация, СкладАЗС, КодСтанции,
		АгрегатПоКаналам, ДатаПеремещенийКаналов, КлючЗагрузки);

	// --- Шаг 3: ПКО на сумму наличных (для кассовой книги, без проводок) ---
	// Бухгалтер ГИГ делает такой ПКО руками — мы воспроизводим то же поведение.
	// Документ не делает движений в Хозрасчетном (проводка Дт 50.01 Кт 62.Р
	// уже сделана самим ОРП), но попадает в кассовую книгу и КО-1 печатается.
	СуммаНаличных = 0;
	Для Каждого КЗ Из АгрегатПоКаналам Цикл
		Если КЗ.Значение.КлючКанала = "retail_cash" Тогда
			СуммаНаличных = СуммаНаличных + КЗ.Значение.Сумма;
		КонецЕсли;
	КонецЦикла;
	Если СуммаНаличных > 0 И Результат.Документы.Количество() > 0 Тогда
		ОРПСсылка = Результат.Документы[0];
		КлючПКО = КлючЗагрузки + "|ПКО";
		СоздатьПКО(Результат, Организация, СкладАЗС, КодСтанции,
			СуммаНаличных, ОРПСсылка, ДатаДокументаСмены, КлючПКО, Проводить);
	КонецЕсли;

	// --- Шаг 4: Списания топлива (канал writeoff_fuel — техсписания pay_type=Прочие) ---
	// Создаёт Документ.СписаниеТоваров на склад АЗС с топливом по литрам.
	// Аналог ручных ГИОГ-документов бухгалтера с комментарием «тех пролив».
	// Время документа = тоже время Сменного Отчёта (по умолчанию 23:50).
	СоздатьСписанияИзАгрегата(Результат, Организация, СкладАЗС, КодСтанции,
		АгрегатПоКаналам, ДатаДокументаСмены, КлючЗагрузки, Проводить);

	Возврат Результат;

КонецФункции

// Обработать ТТН: создать цепочку из 3 документов:
//   1. Поступление товаров (тонны → основной склад)
//   2. Перемещение на склад АЗС (тонны)
//   3. Комплектация (тонны → литры по плотности из ТТН)
//
// Параметры:
//   ДанныеJSON    - Строка - JSON поступления из API
//   КлючЗагрузки  - Строка - уникальный ключ "TL|ТТН|система|станция|номерТТН"
//   Проводить     - Булево
//
// Возвращаемое значение:
//   Структура - ("Документы, Ошибки")
//
Функция ОбработатьТТН(ДанныеJSON, КлючЗагрузки, Проводить = Ложь, ДатаДокумента = Неопределено) Экспорт

	Результат = Новый Структура("Документы, Ошибки", Новый Массив, Новый Массив);

	// Защита от дублей
	ИнфоСуществует = TL_РегистрСтатусов.ПолучитьСтатус(КлючЗагрузки);
	Если ИнфоСуществует <> Неопределено Тогда
		Результат.Ошибки.Добавить("Документ уже загружен: " + КлючЗагрузки);
		Возврат Результат;
	КонецЕсли;

	Попытка
		Данные = ПолучитьИзJSON(ДанныеJSON);
	Исключение
		Результат.Ошибки.Добавить("Ошибка разбора JSON ТТН: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Если Данные = Неопределено Тогда
		Результат.Ошибки.Добавить("Пустые данные ТТН");
		Возврат Результат;
	КонецЕсли;

	// Организация
	Организация = TL_Настройки.ПолучитьОрганизацию();
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.Ошибки.Добавить("Организация не найдена");
		Возврат Результат;
	КонецЕсли;

	// Склады
	ОсновнойСклад = TL_Настройки.ПолучитьОсновнойСклад();
	Если Не ЗначениеЗаполнено(ОсновнойСклад) Тогда
		Результат.Ошибки.Добавить("Основной склад не найден");
		Возврат Результат;
	КонецЕсли;

	КодСтанции = Число(TL_ApiКлиент.ПолучитьЗначение(Данные, "station", 0));
	СкладАЗС = TL_Настройки.НайтиСкладСтанции(КодСтанции);
	Если Не ЗначениеЗаполнено(СкладАЗС) Тогда
		Результат.Ошибки.Добавить("Склад АЗС для станции " + XMLСтрока(КодСтанции)
			+ " не найден — ТТН не может быть загружена без склада станции");
		Возврат Результат;
	КонецЕсли;

	// Дата: приоритет — переданная из формы, затем из API, затем текущая
	ДатаТТН = ДатаДокумента;
	Если Не ЗначениеЗаполнено(ДатаТТН) Тогда
		ДатаТТН = TL_ApiКлиент.ПолучитьДатуИзДанных(Данные, "date");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаТТН) Тогда
		ДатаТТН = ТекущаяДата();
	КонецЕсли;

	// Данные по топливу из ТТН
	НомерТТН   = Строка(TL_ApiКлиент.ПолучитьЗначение(Данные, "ttn", ""));
	КодТоплива = Строка(TL_ApiКлиент.ПолучитьЗначение(Данные, "fuel", ""));
	Плотность  = Число(TL_ApiКлиент.ПолучитьЗначение(Данные, "density", 0));

	// Из ТТН берём только физические данные: массу и объём.
	// Стоимость нас не касается — поступление от поставщика ведётся отдельно.
	ДокДанные = TL_ApiКлиент.ПолучитьЗначение(Данные, "doc", Неопределено);
	Если ДокДанные <> Неопределено Тогда
		ОбъёмЛитров = Число(TL_ApiКлиент.ПолучитьЗначение(ДокДанные, "volume", 0));
		МассаКг     = Число(TL_ApiКлиент.ПолучитьЗначение(ДокДанные, "amount", 0));
	Иначе
		ОбъёмЛитров = Число(TL_ApiКлиент.ПолучитьЗначение(Данные, "doc_volume", 0));
		МассаКг     = Число(TL_ApiКлиент.ПолучитьЗначение(Данные, "doc_amount", 0));
		Если МассаКг = 0 И ОбъёмЛитров > 0 И Плотность > 0 Тогда
			МассаКг = Окр(ОбъёмЛитров * Плотность, 3);
		КонецЕсли;
	КонецЕсли;

	МассаТонн = Окр(МассаКг / 1000, 3); // 3 знака — практика ГИГ (6.673, 9.244 т)

	// Номенклатура тонн
	НоменклатураТонн = TL_Настройки.НайтиНоменклатуруТоплива(КодТоплива, "т");
	Если Не ЗначениеЗаполнено(НоменклатураТонн) И МассаТонн > 0 Тогда
		Результат.Ошибки.Добавить("Номенклатура не найдена: " + КодТоплива + " (т)");
		Возврат Результат;
	КонецЕсли;

	// Время документов из настроек (по умолчанию: Перемещение 11:00, Комплектация 13:00)
	ДатаПеремещенияТТН = TL_Настройки.ПрименитьВремяДокумента(ДатаТТН, "ПеремещениеТТН");
	ДатаКомплектацииТТН = TL_Настройки.ПрименитьВремяДокумента(ДатаТТН, "Комплектация");

	// === Шаг 1: Перемещение на склад АЗС (тонны: основной → станция) ===
	Если МассаТонн > 0 И ЗначениеЗаполнено(СкладАЗС) Тогда
		КлючПеремещения = КлючЗагрузки + "|ПЕРЕМ";
		// Тонны: счёт 41.01
		СчетТонн = Неопределено;
		Попытка СчетТонн = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01"); Исключение КонецПопытки;
		СоздатьПеремещение(Результат, Организация, ОсновнойСклад, СкладАЗС,
			НоменклатураТонн, МассаТонн, ДатаПеремещенияТТН, КлючПеремещения, Проводить, СчетТонн);

		// Регистрируем ТТН по ключу перемещения (первый документ = основной)
		Если Результат.Документы.Количество() > 0 Тогда
			TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючЗагрузки,
				Результат.Документы[Результат.Документы.Количество() - 1], "ТТН");
		КонецЕсли;
	КонецЕсли;

	// === Шаг 2: Комплектация тонны → литры (по плотности из ТТН) ===
	Если МассаТонн > 0 И ОбъёмЛитров > 0 И ЗначениеЗаполнено(СкладАЗС) Тогда
		НоменклатураЛитры = TL_Настройки.НайтиНоменклатуруТоплива(КодТоплива, "л", КодСтанции);
		Если ЗначениеЗаполнено(НоменклатураЛитры) Тогда
			КлючКомплектации = КлючЗагрузки + "|КОМПЛ";
			СоздатьКомплектациюПоДокументу(Результат, Организация, СкладАЗС,
				НоменклатураТонн, НоменклатураЛитры,
				МассаТонн, ОбъёмЛитров, Плотность, ДатаКомплектацииТТН, КлючКомплектации, Проводить);

			Если Плотность > 0 Тогда
				TL_Настройки.ЗаписатьПлотность(КодТоплива, КодСтанции, ДатаТТН,
					Плотность, МассаКг, ОбъёмЛитров, НомерТТН);
			КонецЕсли;
		Иначе
			Результат.Ошибки.Добавить("Номенклатура (л) не найдена для " + КодТоплива + " — комплектация пропущена");
		КонецЕсли;
	ИначеЕсли МассаТонн > 0 И ОбъёмЛитров = 0 Тогда
		Результат.Ошибки.Добавить("Объём литров = 0 в ТТН №" + НомерТТН + " — комплектация пропущена");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Провести документ (для COM-вызовов и сервисных операций).
// Нужно потому что enum РежимЗаписиДокумента не передаётся напрямую через COM.
//
Функция ПровестиДокумент(ДокСсылка) Экспорт

	Если Не ЗначениеЗаполнено(ДокСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Об = ДокСсылка.ПолучитьОбъект();
		Если Об <> Неопределено Тогда
			Об.Записать(РежимЗаписиДокумента.Проведение);
			Возврат Истина;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("TL_СозданиеДокументов",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка проведения " + Строка(ДокСсылка) + ": " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Десериализовать JSON-строку в Соответствие/Массив.
//
Функция ПолучитьИзJSON(ТекстJSON) Экспорт

	Если Не ЗначениеЗаполнено(ТекстJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Возврат ПрочитатьJSON(Чтение, Истина);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создать ПКО (Поступление наличных, КО-1) — точная копия ручной схемы ГИГ:
// сумма = retail_cash из ОРП, контрагент = склад, без проводок.
// Документ нужен только для кассовой книги и печати КО-1.
//
// Параметры:
//   Результат      - Структура - сюда добавляется ссылка на созданный ПКО
//   Организация    - СправочникСсылка.Организации
//   Склад          - СправочникСсылка.Склады - АЗС, по которой выручка
//   КодСтанции     - Число - используется для определения КонтрагентаКассы
//   СуммаНаличных  - Число - сумма retail_cash
//   ОРПСсылка      - ДокументСсылка.ОтчетОРозничныхПродажах - для ДокументОснование
//   Дата           - Дата
//   КлючЗагрузки   - Строка
//   Проводить      - Булево
//
Процедура СоздатьПКО(Результат, Организация, Склад, КодСтанции, СуммаНаличных, ОРПСсылка, Дата, КлючЗагрузки, Проводить)

	НачатьТранзакцию();
	Попытка
		Док = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
		Док.Дата = Дата;
		Док.Организация = Организация;
		Док.СуммаДокумента = Окр(СуммаНаличных, 2);
		Док.Комментарий = КлючЗагрузки;

		// ВидОперации — РозничнаяВыручка (БП 3.0). Старое имя ПриемРозничнойВыручки
		// существовало только в БП 2.0 / ранних 3.0 — поэтому ищем по обоим именам.
		ВидОперацииПКО = НайтиВидОперацииПКОРозничнаяВыручка();
		Если ВидОперацииПКО <> Неопределено Тогда
			Док.ВидОперации = ВидОперацииПКО;
		Иначе
			Результат.Ошибки.Добавить("ПКО " + КлючЗагрузки
				+ ": не найден элемент перечисления ВидыОперацийПКО.РозничнаяВыручка");
		КонецЕсли;

		// Валюта = валюта учёта организации (рубли)
		Попытка
			Док.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		Исключение
			ЗалогироватьИсключение(Результат, "ПКО.ВалютаДокумента", КлючЗагрузки);
		КонецПопытки;

		// Касса 50.01
		Попытка
			Док.СчетКасса = ПланыСчетов.Хозрасчетный.НайтиПоКоду("50.01");
		Исключение
			ЗалогироватьИсключение(Результат, "ПКО.СчетКасса", КлючЗагрузки);
		КонецПопытки;

		// На форме ПКО для ВидОперации=РозничнаяВыручка поле "Склад" — это
		// реквизит Контрагент (составной тип), куда бухгалтер кладёт ссылку на
		// Справочник.Склады (например "АГЗС Витебский", "АЗС 5"). Эталон —
		// бухгалтерские ПКО ГИГ. Без этого реквизита поле "Склад" на форме пустое.
		Если ЗначениеЗаполнено(Склад) Тогда
			Попытка
				Док.Контрагент = Склад;
			Исключение
				ЗалогироватьИсключение(Результат, "ПКО.Контрагент(Склад)", КлючЗагрузки);
			КонецПопытки;
		КонецЕсли;

		УстановитьРеквизитБезопасно(Док, "ПринятоОт", Строка(Склад));
		УстановитьРеквизитБезопасно(Док, "Основание", "Розничная выручка");
		УстановитьРеквизитБезопасно(Док, "ДокументОснование", ОРПСсылка);

		// Ставка НДС в шапке (для отображения)
		СтавкаНДС = TL_Настройки.ПолучитьСтавкуНДС();
		Если ЗначениеЗаполнено(СтавкаНДС) Тогда
			УстановитьРеквизитБезопасно(Док, "СтавкаНДС", СтавкаНДС);
		КонецЕсли;

		// Счёт расчётов с контрагентом (в шапке) — 62.Р
		СчетРасчетов = Неопределено;
		Попытка
			СчетРасчетов = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.Р");
			Если ЗначениеЗаполнено(СчетРасчетов) Тогда
				Док.СчетУчетаРасчетовСКонтрагентом = СчетРасчетов;
			КонецЕсли;
		Исключение
			ЗалогироватьИсключение(Результат, "ПКО.СчетУчетаРасчетовСКонтрагентом", КлючЗагрузки);
		КонецПопытки;

		// Табличная часть РасшифровкаПлатежа — основное место где живут
		// СтатьяДвиженияДенежныхСредств ("Статья доходов" на форме), СуммаНДС, СуммаПлатежа.
		Попытка
			СтрокаРасш = Док.РасшифровкаПлатежа.Добавить();
			СтрокаРасш.СуммаПлатежа = Окр(СуммаНаличных, 2);
			СтрокаРасш.СуммаВзаиморасчетов = Окр(СуммаНаличных, 2);
			СтрокаРасш.КурсВзаиморасчетов = 1;
			СтрокаРасш.КратностьВзаиморасчетов = 1;
			Если ЗначениеЗаполнено(СтавкаНДС) Тогда
				СтрокаРасш.СтавкаНДС = СтавкаНДС;
				СтрокаРасш.СуммаНДС = РассчитатьСуммуНДС(Окр(СуммаНаличных, 2), СтавкаНДС);
			КонецЕсли;
			Если ЗначениеЗаполнено(СчетРасчетов) Тогда
				СтрокаРасш.СчетУчетаРасчетовСКонтрагентом = СчетРасчетов;
			КонецЕсли;
			// Контрагент в строке РасшифровкаПлатежа не хранится напрямую —
			// он только в шапке документа (см. блок выше).
			// Статья ДДС — обязательна для отчёта о движении ДС
			СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Розничная выручка", Истина);
			Если ЗначениеЗаполнено(СтатьяДДС) Тогда
				СтрокаРасш.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
			КонецЕсли;
		Исключение
			ЗалогироватьИсключение(Результат, "ПКО.РасшифровкаПлатежа", КлючЗагрузки);
		КонецПопытки;

		// Ответственный
		Попытка
			Док.Ответственный = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя(), Истина);
		Исключение
			ЗалогироватьИсключение(Результат, "ПКО.Ответственный", КлючЗагрузки);
		КонецПопытки;

		// Запись + проведение. ПКО на «Розничную выручку» в БП 3.0 не делает
		// проводок (если ОРП уже создал Дт 50.01 Кт 62.Р) — это ожидаемо;
		// документ нужен для кассовой книги и КО-1.
		Если Проводить Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		// Post-create assertions: ловим все случаи когда реквизит молча не записался.
		ПроверитьЗаполнениеПКО(Результат, Док, КлючЗагрузки);

		Результат.Документы.Добавить(Док.Ссылка);
		TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючЗагрузки, Док.Ссылка, "ПКО");
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Ошибка создания ПКО на наличные: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Создать документ Перемещение товаров.
//
Процедура СоздатьПеремещение(Результат, Организация, СкладОт, СкладДо, Номенклатура, Количество, Дата, КлючЗагрузки, Проводить, СчетСтроки = Неопределено)

	НачатьТранзакцию();
	Попытка
		Док = Документы.ПеремещениеТоваров.СоздатьДокумент();
		Док.Дата = Дата;
		Док.Организация = Организация;
		Док.Комментарий = КлючЗагрузки;

		// Ответственный = текущий пользователь
		Попытка
			Док.Ответственный = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя(), Истина);
		Исключение
		КонецПопытки;

		УстановитьРеквизитБезопасно(Док, "СкладОтправитель", СкладОт);
		УстановитьРеквизитБезопасно(Док, "СкладПолучатель", СкладДо);

		НоваяСтрока = Док.Товары.Добавить();
		НоваяСтрока.Номенклатура = Номенклатура;
		НоваяСтрока.Количество   = Количество;

		// Счета перемещения: СчетУчета (откуда) + НовыйСчетУчета (куда)
		Если Не ЗначениеЗаполнено(СчетСтроки) Тогда
			СчетаБУ = ПолучитьСчетаУчёта();
			СчетСтроки = СчетаБУ.Счёт4102; // по умолчанию — литры (для каналов оплат)
		КонецЕсли;
		УстановитьРеквизитБезопасно(НоваяСтрока, "СчетУчета", СчетСтроки);
		УстановитьРеквизитБезопасно(НоваяСтрока, "НовыйСчетУчета", СчетСтроки);

		Если Проводить Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		Результат.Документы.Добавить(Док.Ссылка);
		TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючЗагрузки, Док.Ссылка, "Перемещение");
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Ошибка создания Перемещения: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Создать документ Комплектация номенклатуры (тонны → литры).
// Все значения берутся из ТТН документа — ничего не вычисляется.
//
// Параметры:
//   МассаТонн    - Число - масса из ТТН (doc.amount / 1000)
//   ОбъёмЛитров  - Число - объём из ТТН (doc.volume) — готовое значение!
//   Плотность    - Число - плотность из ТТН (density)
//
Процедура СоздатьКомплектациюПоДокументу(Результат, Организация, Склад, НоменклТонн, НоменклЛитры, МассаТонн, ОбъёмЛитров, Плотность, Дата, КлючЗагрузки, Проводить)

	НачатьТранзакцию();
	Попытка
		Док = Документы.КомплектацияНоменклатуры.СоздатьДокумент();
		Док.Дата = Дата;
		Док.Организация = Организация;
		Док.Комментарий = КлючЗагрузки
			+ " | " + Формат(МассаТонн, "ЧДЦ=3") + "т → " + Формат(ОбъёмЛитров, "ЧДЦ=2") + "л"
			+ ?(Плотность > 0, ", плотность=" + Формат(Плотность, "ЧДЦ=4"), "");

		// Ответственный = текущий пользователь
		Попытка
			Док.Ответственный = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя(), Истина);
		Исключение
		КонецПопытки;

		УстановитьРеквизитБезопасно(Док, "Склад", Склад);

		// ВидОперации обязателен — без него ОбработкаПроведения не формирует движения
		Попытка
			Док.ВидОперации = Перечисления.ВидыОперацийКомплектацияНоменклатуры.Комплектация;
		Исключение
		КонецПопытки;

		// Комплектующие (расход): тонны, счёт 41.01
		СчетаБУ = ПолучитьСчетаУчёта();
		СтрокаРасход = Док.Комплектующие.Добавить();
		СтрокаРасход.Номенклатура = НоменклТонн;
		СтрокаРасход.Количество   = МассаТонн;
		УстановитьРеквизитБезопасно(СтрокаРасход, "СчетУчета", СчетаБУ.Счёт4101);
		// СтранаПроисхождения — обязательна для проведения в БП 3.0
		Попытка
			Россия = Справочники.СтраныМира.НайтиПоНаименованию("РОССИЯ", Истина);
			Если Не ЗначениеЗаполнено(Россия) Тогда
				Россия = Справочники.СтраныМира.НайтиПоКоду("643");
			КонецЕсли;
			Если ЗначениеЗаполнено(Россия) Тогда
				СтрокаРасход.СтранаПроисхождения = Россия;
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Выпуск: в части конфигураций это табличная часть Продукция,
		// в БП 3.0 — реквизиты самого документа.
		Попытка
			СтрокаВыпуск = Док.Продукция.Добавить();
			СтрокаВыпуск.Номенклатура = НоменклЛитры;
			СтрокаВыпуск.Количество   = ОбъёмЛитров;
			УстановитьРеквизитБезопасно(СтрокаВыпуск, "СчетУчета", СчетаБУ.Счёт4102);
		Исключение
			УстановитьРеквизитБезопасно(Док, "Номенклатура", НоменклЛитры);
			УстановитьРеквизитБезопасно(Док, "Количество", ОбъёмЛитров);
			УстановитьРеквизитБезопасно(Док, "СчетУчета", СчетаБУ.Счёт4102);
		КонецПопытки;

		Если Проводить Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		Результат.Документы.Добавить(Док.Ссылка);
		TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючЗагрузки, Док.Ссылка, "Комплектация");
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Ошибка создания Комплектации: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Агрегировать массив sales по каналам оплат и видам топлива.
// Возвращает: Соответствие("канал|код" → Структура(КлючКанала, КодТоплива, Литры, Сумма))
//
Функция АгрегироватьПродажиПоКаналам(МассивПродаж)

	Агрегат = Новый Соответствие;

	Если ТипЗнч(МассивПродаж) <> Тип("Массив") Тогда
		Возврат Агрегат;
	КонецЕсли;

	Для Каждого Продажа Из МассивПродаж Цикл

		ТипОплаты = TL_ApiКлиент.ПолучитьЗначение(Продажа, "pay_type", Неопределено);
		Если ТипОплаты = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяОплаты = НРег(Строка(TL_ApiКлиент.ПолучитьЗначение(ТипОплаты, "name", "")));
		Если Не ЗначениеЗаполнено(ИмяОплаты) Тогда
			Продолжить;
		КонецЕсли;

		Запись = НайтиЗаписьМаппинга(ИмяОплаты);
		Если Запись = Неопределено Тогда
			Продолжить; // Блокер уже сработал в ОбработатьСмену
		КонецЕсли;

		КлючКанала = Запись.КаналОплаты;
		СкладПереопр = Запись.Склад;
		Если Не ЗначениеЗаполнено(КлючКанала) Тогда
			Продолжить; // Купоны и неизвестные — пропускаем
		КонецЕсли;

		МассивТоплива = TL_ApiКлиент.ПолучитьЗначение(Продажа, "fuel", Неопределено);
		Если ТипЗнч(МассивТоплива) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ЭлементТоплива Из МассивТоплива Цикл
			Сервис = TL_ApiКлиент.ПолучитьЗначение(ЭлементТоплива, "service", Неопределено);
			Если Сервис = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			КодТоплива = Строка(TL_ApiКлиент.ПолучитьЗначение(Сервис, "service_code", ""));

			Выпуск = TL_ApiКлиент.ПолучитьЗначение(ЭлементТоплива, "release", Неопределено);
			Если Выпуск = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Литры = Число(TL_ApiКлиент.ПолучитьЗначение(Выпуск, "volume", 0));
			Стоимость = Число(TL_ApiКлиент.ПолучитьЗначение(Выпуск, "cost", 0));

			Если Литры <= 0 Тогда
				Продолжить;
			КонецЕсли;

			// Учётная сумма формируется ТОЛЬКО для розничных каналов (наличные + эквайринг).
			// Для безналичных корпоративных каналов (cards, online, ledger, voucher)
			// цена реализации не известна в момент смены — она согласована в договоре
			// и применяется при месячной реализации с виртуального склада.
			Если КлючКанала <> "retail_cash" И КлючКанала <> "retail_card" Тогда
				Стоимость = 0;
			КонецЕсли;

			// Ключ агрегата учитывает переопределение склада из маппинга:
			// если у двух имён один канал, но разные склады (например, VIAcard→VIAcard и БАЛТОП→БАЛТОП),
			// они НЕ должны сливаться — складываются раздельно.
			СкладКлюч = ?(ЗначениеЗаполнено(СкладПереопр), XMLСтрока(СкладПереопр.УникальныйИдентификатор()), "");
			КлючАгрегата = КлючКанала + "|" + СкладКлюч + "|" + КодТоплива;
			Существующий = Агрегат.Получить(КлючАгрегата);
			Если Существующий <> Неопределено Тогда
				Существующий.Литры = Существующий.Литры + Литры;
				Существующий.Сумма = Существующий.Сумма + Стоимость;
			Иначе
				Агрегат.Вставить(КлючАгрегата,
					Новый Структура("КлючКанала, КодТоплива, Литры, Сумма, СкладПереопределение",
						КлючКанала, КодТоплива, Литры, Стоимость, СкладПереопр));
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Агрегат;

КонецФункции

// Создать перемещения на виртуальные склады из агрегата (только cards и online).
// Группировка: один документ на (канал → склад), все виды топлива — строки табличной части.
//
Процедура СоздатьПеремещенияИзАгрегата(Результат, Организация, СкладАЗС, КодСтанции, АгрегатПоКаналам, Дата, КлючБазовый)

	// Группируем по складу-получателю: Склад → Массив строк {Номенклатура, Литры, КодТоплива, КлючКанала}
	ГруппыПоСкладам = Новый Соответствие; // Склад(ссылка) → {Склад, КлючКанала, Строки[]}

	Для Каждого КлючЗначение Из АгрегатПоКаналам Цикл

		Агрегат = КлючЗначение.Значение;

		// retail — уже обработан в Отчёте о розн. продажах, пропускаем
		Если Агрегат.КлючКанала = "retail_cash" ИЛИ Агрегат.КлючКанала = "retail_card" Тогда
			Продолжить;
		КонецЕсли;

		// writeoff_fuel — техсписания топлива (pay_type=Прочие). Не перемещение, а СписаниеТоваров.
		// Обрабатывается отдельно в СоздатьСписанияИзАгрегата.
		Если Агрегат.КлючКанала = "writeoff_fuel" Тогда
			Продолжить;
		КонецЕсли;

		ВидОплаты = TL_Настройки.НайтиВидОплаты(Агрегат.КлючКанала);
		Если ВидОплаты = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Приоритет переопределения: склад из строки маппинга > склад канала.
		СкладПолучатель = ВидОплаты.Склад;
		Попытка
			Если ЗначениеЗаполнено(Агрегат.СкладПереопределение) Тогда
				СкладПолучатель = Агрегат.СкладПереопределение;
			КонецЕсли;
		Исключение
			// Свойство отсутствует — оставляем склад канала
		КонецПопытки;

		Если Не ВидОплаты.ТребуетПеремещения ИЛИ Не ЗначениеЗаполнено(СкладПолучатель) Тогда
			Продолжить;
		КонецЕсли;

		Номенклатура = TL_Настройки.НайтиНоменклатуруТоплива(Агрегат.КодТоплива, "л", КодСтанции);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		Группа = ГруппыПоСкладам.Получить(СкладПолучатель);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Склад, КлючКанала, Строки", СкладПолучатель, Агрегат.КлючКанала, Новый Массив);
			ГруппыПоСкладам.Вставить(СкладПолучатель, Группа);
		КонецЕсли;

		Группа.Строки.Добавить(Новый Структура("Номенклатура, Количество, КодТоплива",
			Номенклатура, Агрегат.Литры, Агрегат.КодТоплива));

	КонецЦикла;

	// Создаём один документ на каждый склад-получатель
	СчетаБУ = ПолучитьСчетаУчёта();

	Для Каждого КлючЗначение Из ГруппыПоСкладам Цикл

		Группа = КлючЗначение.Значение;
		КлючПеремещения = КлючБазовый + "|" + Группа.КлючКанала;

		НачатьТранзакцию();
		Попытка
			Док = Документы.ПеремещениеТоваров.СоздатьДокумент();
			Док.Дата = Дата;
			Док.Организация = Организация;
			Док.Комментарий = КлючПеремещения;

			Попытка
				Док.Ответственный = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя(), Истина);
			Исключение
			КонецПопытки;

			УстановитьРеквизитБезопасно(Док, "СкладОтправитель", СкладАЗС);
			УстановитьРеквизитБезопасно(Док, "СкладПолучатель", Группа.Склад);

			Для Каждого СтрокаТовара Из Группа.Строки Цикл
				НоваяСтрока = Док.Товары.Добавить();
				НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
				НоваяСтрока.Количество   = СтрокаТовара.Количество;
				УстановитьРеквизитБезопасно(НоваяСтрока, "СчетУчета", СчетаБУ.Счёт4102);
				УстановитьРеквизитБезопасно(НоваяСтрока, "НовыйСчетУчета", СчетаБУ.Счёт4101);
			КонецЦикла;

			Док.Записать(РежимЗаписиДокумента.Запись);

			Результат.Документы.Добавить(Док.Ссылка);
			TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючПеремещения, Док.Ссылка, "Перемещение");
			ЗафиксироватьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			Результат.Ошибки.Добавить("Ошибка создания Перемещения: " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Создать Документ.СписаниеТоваров для канала writeoff_fuel (техсписания топлива,
// pay_type=Прочие в STS). Аналог ручных ГИОГ-документов бухгалтера с комментарием
// «тех пролив»: ВидОперации=СписаниеСоСклада, ТЧ Товары — литры топлива.
//
// При проведении типовая БП 3.0 сама строит проводки Дт «счёт затрат из карточки
// номенклатуры» Кт 41.02 (или Дт 91.02 если затрат не определён).
//
// Идемпотентность: ключ = КлючБазовый + "|СПИСАНИЕ" в TL_СтатусыЗагрузки.
//
Процедура СоздатьСписанияИзАгрегата(Результат, Организация, СкладАЗС, КодСтанции, АгрегатПоКаналам, Дата, КлючБазовый, Проводить = Ложь)

	Строки = Новый Массив;

	Для Каждого КлючЗначение Из АгрегатПоКаналам Цикл
		Агрегат = КлючЗначение.Значение;

		Если Агрегат.КлючКанала <> "writeoff_fuel" Тогда
			Продолжить;
		КонецЕсли;

		Если Агрегат.Литры <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Номенклатура = TL_Настройки.НайтиНоменклатуруТоплива(Агрегат.КодТоплива, "л", КодСтанции);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Результат.Ошибки.Добавить(
				"Списание (writeoff_fuel): номенклатура не найдена для топлива «" + Агрегат.КодТоплива + "» (л)");
			Продолжить;
		КонецЕсли;

		Строки.Добавить(Новый Структура("Номенклатура, Количество, КодТоплива",
			Номенклатура, Агрегат.Литры, Агрегат.КодТоплива));
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	КлючСписания = КлючБазовый + "|СПИСАНИЕ";

	// Идемпотентность — повторная загрузка не плодит дубли
	Если TL_РегистрСтатусов.ПолучитьСтатус(КлючСписания) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	СчетаБУ = ПолучитьСчетаУчёта();

	НачатьТранзакцию();
	Попытка
		Док = Документы.СписаниеТоваров.СоздатьДокумент();
		Док.Дата = Дата;
		Док.Организация = Организация;
		Док.Комментарий = "Тех. списание топлива (Прочие) | " + КлючСписания;

		// ВидОперации = СписаниеСоСклада (как в ручных ГИОГ-документах Журавлевой/Ирины)
		Попытка
			Док.ВидОперации = Перечисления.ВидыОперацийСписанияТоваров.СписаниеСоСклада;
		Исключение
			// На случай нестандартной БП — оставляем по умолчанию
		КонецПопытки;

		УстановитьРеквизитБезопасно(Док, "Склад", СкладАЗС);

		Попытка
			Док.Ответственный = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя(), Истина);
		Исключение
		КонецПопытки;

		Для Каждого СтрокаТовара Из Строки Цикл
			НоваяСтрока = Док.Товары.Добавить();
			НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
			НоваяСтрока.Количество = СтрокаТовара.Количество;
			УстановитьРеквизитБезопасно(НоваяСтрока, "СчетУчета", СчетаБУ.Счёт4102);
			// СчётЗатрат / СтатьяЗатрат / СтранаПроисхождения — оставляем пустыми.
			// БП 3.0 при проведении заполнит из карточки номенклатуры и учётной политики.
		КонецЦикла;

		Если Проводить Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		Результат.Документы.Добавить(Док.Ссылка);
		TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючСписания, Док.Ссылка, "Списание");
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Ошибка создания Документа.СписаниеТоваров (writeoff_fuel): " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Сформировать текст каналов для комментария документа.
// Для розничных каналов (retail_cash, retail_card) — сумма ₽.
// Для безналичных (cards, online, ledger, voucher) — литры (без суммы, расценка в конце месяца).
//
Функция СформироватьТекстКаналов(АгрегатПоКаналам)

	ИтогиПоКаналам = Новый Соответствие; // канал → Структура(Литры, Сумма)
	Для Каждого КлючЗначение Из АгрегатПоКаналам Цикл
		Агрегат = КлючЗначение.Значение;
		Существ = ИтогиПоКаналам.Получить(Агрегат.КлючКанала);
		Если Существ <> Неопределено Тогда
			Существ.Литры = Существ.Литры + Агрегат.Литры;
			Существ.Сумма = Существ.Сумма + Агрегат.Сумма;
		Иначе
			ИтогиПоКаналам.Вставить(Агрегат.КлючКанала,
				Новый Структура("Литры, Сумма", Агрегат.Литры, Агрегат.Сумма));
		КонецЕсли;
	КонецЦикла;

	Текст = "";
	Для Каждого КЗ Из ИтогиПоКаналам Цикл
		Канал = КЗ.Ключ;
		ЭтоРозница = (Канал = "retail_cash") ИЛИ (Канал = "retail_card");

		Если ЭтоРозница Тогда
			Если КЗ.Значение.Сумма > 0 Тогда
				Текст = Текст + ?(ЗначениеЗаполнено(Текст), "; ", "")
					+ Канал + ": " + Формат(КЗ.Значение.Сумма, "ЧДЦ=2");
			КонецЕсли;
		Иначе
			Если КЗ.Значение.Литры > 0 Тогда
				Текст = Текст + ?(ЗначениеЗаполнено(Текст), "; ", "")
					+ Канал + ": " + Формат(КЗ.Значение.Литры, "ЧДЦ=2") + " л";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Определить канал оплаты по имени из API (нормализация).
//
// Каналы реализации:
//   "retail_cash" — Наличные → строка в Отчёте о розн. продажах
//   "retail_card" — Банк.карты (Сбербанк, эквайринг) → отдельная строка в Отчёте
//   "cards"       — Топливные/корпоративные карты → виртуальный склад «Карты»
//   "online"      — Онлайн-заказы (Яндекс, мобильные, Benzuber) → склад «ЯНДЕКС»
//   "ledger"      — Ведомости → склад «Ведомости»
//   "voucher"     — Талоны → склад «Талоны»
//   ""            — игнорировать (купоны на сдачу и прочее служебное)
//
// Источник правды — регистр TL_МаппингОплат. Если для имени маппинга нет,
// возвращает Неопределено — это сигнал блокера в ОбработатьСмену.
//
// Параметры:
//   ИмяОплатыНРег - Строка - имя в нижнем регистре (НРег)
//
// Возвращаемое значение:
//   Строка     — ключ канала или "" для игнорируемых
//   Неопределено — маппинг не найден, нужна настройка
//
Функция ОпределитьКаналОплаты(ИмяОплатыНРег) Экспорт

	Запись = НайтиЗаписьМаппинга(ИмяОплатыНРег);
	Если Запись = Неопределено Тогда
		Возврат Неопределено; // блокер сработает
	КонецЕсли;
	Возврат Запись.КаналОплаты;

КонецФункции

// Найти запись маппинга для имени оплаты. Возвращает Структуру(КаналОплаты, Склад)
// или Неопределено, если маппинг не найден.
//
Функция НайтиЗаписьМаппинга(ИмяОплатыНРег) Экспорт

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ОбразецИмени,
			|	КаналОплаты,
			|	Склад
			|ИЗ
			|	РегистрСведений.TL_МаппингОплат
			|УПОРЯДОЧИТЬ ПО
			|	ОбразецИмени";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.ОбразецИмени)
				И СтрНайти(ИмяОплатыНРег, НРег(Выборка.ОбразецИмени)) > 0 Тогда
				Возврат Новый Структура("КаналОплаты, Склад",
					Выборка.КаналОплаты, Выборка.Склад);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Регистр TL_МаппингОплат не существует — это аварийная ситуация
		ЗаписьЖурналаРегистрации("TL_СозданиеДокументов",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Регистр TL_МаппингОплат не доступен: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Проверить, что для всех pay_type из sales настроен маппинг.
// Возвращает Массив незамапленных имён (пусто = всё ОК).
//
Функция ПроверитьМаппингОплат(МассивПродаж) Экспорт

	Незамапленные = Новый Массив;
	Если ТипЗнч(МассивПродаж) <> Тип("Массив") Тогда
		Возврат Незамапленные;
	КонецЕсли;

	УникальныеИмена = Новый Соответствие;
	Для Каждого Продажа Из МассивПродаж Цикл
		ТипОплаты = TL_ApiКлиент.ПолучитьЗначение(Продажа, "pay_type", Неопределено);
		Если ТипОплаты = Неопределено Тогда Продолжить; КонецЕсли;
		ИмяОригинал = Строка(TL_ApiКлиент.ПолучитьЗначение(ТипОплаты, "name", ""));
		Если Не ЗначениеЗаполнено(ИмяОригинал) Тогда Продолжить; КонецЕсли;

		// Дедупликация по нижнему регистру
		ИмяНРегВр = НРег(ИмяОригинал);
		Если УникальныеИмена.Получить(ИмяНРегВр) <> Неопределено Тогда Продолжить; КонецЕсли;
		УникальныеИмена.Вставить(ИмяНРегВр, ИмяОригинал);

		Запись = НайтиЗаписьМаппинга(ИмяНРегВр);
		Если Запись = Неопределено Тогда
			Незамапленные.Добавить(ИмяОригинал);
		КонецЕсли;
	КонецЦикла;

	Возврат Незамапленные;

КонецФункции

// Записать структурированную ошибку загрузки смены STS в TL_ОшибкиЗагрузки.
// Используется в F для группировки ошибок по категориям в детальном отчёте.
//
// Параметры:
//   КлючЗагрузки     - Строка - "TL|СМЕНА|sysid|station|num", используется как ИдентификаторПакета
//   КодОшибки        - ПеречислениеСсылка.TL_КодОшибкиЗагрузки - категория для группировки
//   Сообщение        - Строка - текст ошибки для бухгалтера
//   ЗначениеИсточника - Строка - значение поля из STS (для отладки)
//
Процедура ЗаписатьОшибкуСмены(КлючЗагрузки, КодОшибки, Сообщение, ЗначениеИсточника = "") Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ИдентификаторПакета", КлючЗагрузки);
	Параметры.Вставить("ИсточникUUID", "");
	Параметры.Вставить("ТипОбъекта", Перечисления.TL_ТипОбъектаИсточника.ПустаяСсылка());
	Параметры.Вставить("Поле", Перечисления.TL_ПолеОшибки.Прочее);
	Параметры.Вставить("КодОшибки", КодОшибки);
	Параметры.Вставить("ЗначениеИсточника", ЗначениеИсточника);
	Параметры.Вставить("СообщениеОшибки", Сообщение);

	TL_Сверка.ЗаписатьОшибку(Параметры);

КонецПроцедуры

// Получить счета учёта для программного заполнения документов.
// При интерактивном создании 1С заполняет их автоматически,
// при программном — нужно заполнять явно.
//
Функция ПолучитьСчетаУчёта() Экспорт

	Счета = Новый Структура;
	Попытка Счета.Вставить("Счёт4101", ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01")); Исключение Счета.Вставить("Счёт4101", Неопределено); КонецПопытки;
	Попытка Счета.Вставить("Счёт4102", ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.02")); Исключение Счета.Вставить("Счёт4102", Неопределено); КонецПопытки;
	Попытка Счета.Вставить("Счёт9001", ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.1")); Исключение Счета.Вставить("Счёт9001", Неопределено); КонецПопытки;
	Попытка Счета.Вставить("Счёт9002", ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.1")); Исключение Счета.Вставить("Счёт9002", Неопределено); КонецПопытки;
	Попытка Счета.Вставить("Счёт9003", ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.03")); Исключение Счета.Вставить("Счёт9003", Неопределено); КонецПопытки;

	Возврат Счета;

КонецФункции

// Безопасно установить значение реквизита документа/строки.
//
Процедура УстановитьРеквизитБезопасно(Объект, ИмяСвойства, Значение)

	Попытка
		Объект[ИмяСвойства] = Значение;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Рассчитать сумму НДС из суммы с НДС.
// Определяет процент по ставке (22% или 20%).
//
Функция РассчитатьСуммуНДС(СуммаСНДС, СтавкаНДС)

	ПроцентНДС = 22;
	Попытка
		Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
			ПроцентНДС = 20;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Окр(СуммаСНДС * ПроцентНДС / (100 + ПроцентНДС), 2);

КонецФункции

// Найти элемент перечисления ВидыОперацийПКО для розничной выручки.
// БП 3.0 — РозничнаяВыручка, БП 2.0 / ранние 3.0 — ПриемРозничнойВыручки.
//
Функция НайтиВидОперацииПКОРозничнаяВыручка()

	Попытка
		Возврат Перечисления.ВидыОперацийПКО.РозничнаяВыручка;
	Исключение
	КонецПопытки;

	Попытка
		Возврат Перечисления.ВидыОперацийПКО.ПриемРозничнойВыручки;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Залогировать поглощённое исключение в Результат.Ошибки и журнал регистрации.
// Используется вместо немых "Исключение КонецПопытки" — чтобы баги не жили незаметно.
//
Процедура ЗалогироватьИсключение(Результат, ТочкаКода, КлючЗагрузки)

	Описание = ТочкаКода + " (" + КлючЗагрузки + "): " + ОписаниеОшибки();
	Результат.Ошибки.Добавить(Описание);
	ЗаписьЖурналаРегистрации("TL_СозданиеДокументов",
		УровеньЖурналаРегистрации.Предупреждение, , , Описание);

КонецПроцедуры

// Post-create проверка ПКО: какие обязательные реквизиты остались пустыми
// после записи. Сигнализирует через Результат.Ошибки чтобы вызывающая сторона
// увидела проблему даже если все Попытки внутри СоздатьПКО прошли молча.
//
// БП 3.0 устройство ПКО:
//   В шапке: ВидОперации, СтавкаНДС, СчетКасса, СчетУчетаРасчетовСКонтрагентом, ДокументОснование
//   В РасшифровкаПлатежа: СуммаПлатежа, СуммаНДС, СтатьяДвиженияДенежныхСредств
//   Склад на форме отображается из ДокументОснование (нашего ОРП).
//
Процедура ПроверитьЗаполнениеПКО(Результат, Док, КлючЗагрузки)

	ПустыеРеквизиты = Новый Массив;

	// Шапка
	Если Не ЗначениеЗаполнено(Док.ВидОперации) Тогда
		ПустыеРеквизиты.Добавить("ВидОперации");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Док.СчетКасса) Тогда
		ПустыеРеквизиты.Добавить("СчетКасса");
	КонецЕсли;

	// Контрагент — на форме РозничнойВыручки показывается как "Склад"
	// (там лежит ссылка на Справочник.Склады, тип реквизита составной)
	Попытка
		Если Не ЗначениеЗаполнено(Док.Контрагент) Тогда
			ПустыеРеквизиты.Добавить("Контрагент=Склад");
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если Не ЗначениеЗаполнено(Док.СтавкаНДС) Тогда
			ПустыеРеквизиты.Добавить("СтавкаНДС");
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если Не ЗначениеЗаполнено(Док.ДокументОснование) Тогда
			ПустыеРеквизиты.Добавить("ДокументОснование");
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Табличная часть РасшифровкаПлатежа — должна быть ровно одна строка с заполненными полями
	Попытка
		Если Док.РасшифровкаПлатежа.Количество() = 0 Тогда
			ПустыеРеквизиты.Добавить("РасшифровкаПлатежа (нет строк)");
		Иначе
			Стр = Док.РасшифровкаПлатежа[0];
			Если Не ЗначениеЗаполнено(Стр.СуммаПлатежа) ИЛИ Стр.СуммаПлатежа = 0 Тогда
				ПустыеРеквизиты.Добавить("РасшифровкаПлатежа.СуммаПлатежа");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Стр.СтатьяДвиженияДенежныхСредств) Тогда
				ПустыеРеквизиты.Добавить("РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств");
			КонецЕсли;
		КонецЕсли;
	Исключение
		ПустыеРеквизиты.Добавить("РасшифровкаПлатежа (ошибка проверки: " + ОписаниеОшибки() + ")");
	КонецПопытки;

	Если ПустыеРеквизиты.Количество() > 0 Тогда
		Результат.Ошибки.Добавить("ПКО " + Строка(Док.Номер) + " (" + КлючЗагрузки
			+ "): не заполнены реквизиты — " + СтрСоединить(ПустыеРеквизиты, ", "));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
