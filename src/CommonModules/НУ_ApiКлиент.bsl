// Создаёт структуру подключения для передачи в другие методы.
//
// Параметры:
//   URLСервера - Строка - базовый URL API
//   Логин      - Строка - логин
//   Пароль     - Строка - пароль
//
// Возвращаемое значение:
//   Структура - (URLСервера, Токен) или Неопределено при ошибке авторизации
//
Функция СоздатьПодключение(URLСервера, Логин, Пароль) Экспорт

	Токен = ПолучитьТокен(URLСервера, Логин, Пароль);

	Если Токен = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Подключение = Новый Структура;
	Подключение.Вставить("URLСервера", URLСервера);
	Подключение.Вставить("Токен", Токен);
	Подключение.Вставить("ВремяПолучения", ТекущаяДата());

	Возврат Подключение;

КонецФункции

// Проверяет, не истёк ли токен (18 минут), при необходимости обновляет.
//
// Параметры:
//   Подключение - Структура - текущее подключение
//   Логин       - Строка
//   Пароль      - Строка
//
// Возвращаемое значение:
//   Структура - обновлённое подключение
//
Функция ОбновитьТокенПриНеобходимости(Подключение, Логин, Пароль) Экспорт

	Если ТекущаяДата() - Подключение.ВремяПолучения > 18 * 60 Тогда
		НовоеПодключение = СоздатьПодключение(Подключение.URLСервера, Логин, Пароль);
		Если НовоеПодключение <> Неопределено Тогда
			Возврат НовоеПодключение;
		КонецЕсли;
	КонецЕсли;

	Возврат Подключение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет HTTP-запрос к API.
//
// Параметры:
//   URLСервера    - Строка - базовый URL
//   МетодHTTP     - Строка - GET или POST
//   Путь          - Строка - путь эндпоинта (/v1/shifts)
//   Токен         - Строка - JWT-токен (необязательно для login)
//   ТелоЗапроса   - Структура - тело POST-запроса (необязательно)
//   ПараметрыURL  - Структура - параметры строки запроса (необязательно)
//
// Возвращаемое значение:
//   Произвольный - десериализованный JSON ответа или Неопределено при ошибке
//
Функция ВыполнитьЗапросHTTP(URLСервера, МетодHTTP, Путь, Токен = "", ТелоЗапроса = Неопределено, ПараметрыURL = Неопределено)

	МаксПопыток = 3;
	Задержки = Новый Массив;
	Задержки.Добавить(1);
	Задержки.Добавить(2);
	Задержки.Добавить(4);

	Для НомерПопытки = 1 По МаксПопыток Цикл

		Попытка
			Результат = ВыполнитьЗапросHTTPОднократно(URLСервера, МетодHTTP, Путь, Токен, ТелоЗапроса, ПараметрыURL);
			Возврат Результат;
		Исключение
			Если НомерПопытки < МаксПопыток Тогда
				ЗадержкаСекунд = Задержки[НомерПопытки - 1];
				// Пауза перед повтором
				ДатаОкончания = ТекущаяДата() + ЗадержкаСекунд;
				Пока ТекущаяДата() < ДатаОкончания Цикл
				КонецЦикла;
			Иначе
				ВызватьИсключение "Ошибка API после " + Формат(МаксПопыток, "ЧГ=0") + " попыток: " + ОписаниеОшибки();
			КонецЕсли;
		КонецПопытки;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ВыполнитьЗапросHTTPОднократно(URLСервера, МетодHTTP, Путь, Токен, ТелоЗапроса, ПараметрыURL)

	// Разбор URL
	СтруктураURL = РазобратьURL(URLСервера);

	// Формирование строки запроса
	ПолныйПуть = Путь;
	Если ПараметрыURL <> Неопределено Тогда
		СтрокаПараметров = "";
		Для Каждого КлючЗначение Из ПараметрыURL Цикл
			Разделитель = ?(СтрокаПараметров = "", "?", "&");
			СтрокаПараметров = СтрокаПараметров + Разделитель + КлючЗначение.Ключ + "=" + КлючЗначение.Значение;
		КонецЦикла;
		ПолныйПуть = ПолныйПуть + СтрокаПараметров;
	КонецЕсли;

	// Полный путь с базовым путём сервера
	Если Не ПустаяСтрока(СтруктураURL.ПутьНаСервере) Тогда
		ПолныйПуть = СтруктураURL.ПутьНаСервере + ПолныйПуть;
	КонецЕсли;

	// Создание соединения
	Соединение = Новый HTTPСоединение(
		СтруктураURL.Хост,
		СтруктураURL.Порт,
		, , , 30, // таймаут 30 сек
		Новый ЗащищенноеСоединениеOpenSSL);

	// Создание запроса
	Запрос = Новый HTTPЗапрос(ПолныйПуть);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.Заголовки.Вставить("Accept", "application/json");

	Если Не ПустаяСтрока(Токен) Тогда
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;

	// Тело запроса (для POST)
	Если ТелоЗапроса <> Неопределено Тогда
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
		Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
	КонецЕсли;

	// Выполнение запроса
	Если ВРег(МетодHTTP) = "POST" Тогда
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Иначе
		Ответ = Соединение.Получить(Запрос);
	КонецЕсли;

	// Обработка ответа
	КодОтвета = Ответ.КодСостояния;

	Если КодОтвета < 200 ИЛИ КодОтвета >= 300 Тогда
		ВызватьИсключение "HTTP " + Формат(КодОтвета, "ЧГ=0") + ": " + Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	КонецЕсли;

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

	Если ПустаяСтрока(ТелоОтвета) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Десериализация JSON
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Возврат Результат;

КонецФункции

// Разбирает URL на компоненты.
//
// Параметры:
//   URL - Строка - полный URL (https://pos.autooplata.ru/tms)
//
// Возвращаемое значение:
//   Структура - (Хост, Порт, ПутьНаСервере)
//
Функция РазобратьURL(URL)

	Результат = Новый Структура("Хост, Порт, ПутьНаСервере");
	Результат.Порт = 443;
	Результат.ПутьНаСервере = "";

	АдресБезПротокола = URL;

	Если СтрНачинаетсяС(ВРег(URL), "HTTPS://") Тогда
		АдресБезПротокола = Сред(URL, 9);
		Результат.Порт = 443;
	ИначеЕсли СтрНачинаетсяС(ВРег(URL), "HTTP://") Тогда
		АдресБезПротокола = Сред(URL, 8);
		Результат.Порт = 80;
	КонецЕсли;

	ПозицияСлеш = СтрНайти(АдресБезПротокола, "/");
	Если ПозицияСлеш > 0 Тогда
		Результат.ПутьНаСервере = Сред(АдресБезПротокола, ПозицияСлеш);
		АдресБезПротокола = Лев(АдресБезПротокола, ПозицияСлеш - 1);
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(АдресБезПротокола, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Порт = Число(Сред(АдресБезПротокола, ПозицияДвоеточия + 1));
		Результат.Хост = Лев(АдресБезПротокола, ПозицияДвоеточия - 1);
	Иначе
		Результат.Хост = АдресБезПротокола;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
