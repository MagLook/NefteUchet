// Зафиксировать ошибку для документа неизвестного / неподдерживаемого kind.
//
Процедура ЗафиксироватьОшибкуKind(Док, Kind, ИдентификаторПакета, Результат)

	UUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	ЗаписатьОшибку(ИдентификаторПакета, UUID,
		Перечисления.TL_ТипОбъектаИсточника.Поступление,
		Перечисления.TL_ПолеОшибки.Прочее,
		Перечисления.TL_КодОшибкиЗагрузки.Прочее,
		Kind,
		"kind '" + Kind + "' не покрыт фазой A3",
		Результат);

КонецПроцедуры

// Записать ошибку маппинга НСИ.
//
Процедура ЗаписатьОшибкуНСИ(ИдентификаторПакета, UUID, ТипОбъекта, Поле, Сообщение, Результат)

	ЗаписатьОшибку(ИдентификаторПакета, UUID, ТипОбъекта, Поле,
		Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена, "", Сообщение, Результат);

КонецПроцедуры

// Универсальная запись ошибки в TL_ОшибкиЗагрузки + дублирование в Результат.Ошибки.
//
Процедура ЗаписатьОшибку(ИдентификаторПакета, UUID, ТипОбъекта, Поле,
	КодОшибки, ЗначениеИсточника, Сообщение, Результат)

	Параметры = Новый Структура;
	Параметры.Вставить("ИдентификаторПакета", ИдентификаторПакета);
	Параметры.Вставить("ИсточникUUID", UUID);
	Параметры.Вставить("ТипОбъекта", ТипОбъекта);
	Параметры.Вставить("Поле", Поле);
	Параметры.Вставить("КодОшибки", КодОшибки);
	Параметры.Вставить("ЗначениеИсточника", ЗначениеИсточника);
	Параметры.Вставить("СообщениеОшибки", Сообщение);

	TL_Сверка.ЗаписатьОшибку(Параметры);

	Результат.Ошибки.Добавить(Сообщение);

КонецПроцедуры

// Проверка идемпотентности на уровне пакета — есть ли запись TL_СверкаПакета
// со статусом ПринятоЦеликом.
//
Функция ПакетУжеЗагружен(ИдентификаторПакета)

	Если Не ЗначениеЗаполнено(ИдентификаторПакета) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Статус ИЗ РегистрСведений.TL_СверкаПакета
		|ГДЕ ИдентификаторПакета = &ИдПакета");
	Запрос.УстановитьПараметр("ИдПакета", ИдентификаторПакета);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И Выборка.Статус = Перечисления.TL_СтатусПакета.ПринятоЦеликом Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Извлечь дату из JSON-поля (поддерживает ISO 8601 и yyyy-MM-dd).
//
Функция ПолучитьДатуИзJSON(Источник, Ключ)

	Значение = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Источник, Ключ, "");
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), Строка(Значение));
	Исключение
		Попытка
			С = Строка(Значение);
			Возврат Дата(Число(Лев(С, 4)), Число(Сред(С, 6, 2)), Число(Сред(С, 9, 2)));
		Исключение
			Возврат '00010101';
		КонецПопытки;
	КонецПопытки;

КонецФункции

// Построить параметры для автосоздания договора из JSON-объекта НСИ.
//
Функция ПостроитьПараметрыДоговора(Объект)

	Параметры = Новый Структура;
	Имя = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Наименование", "");
	Если ЗначениеЗаполнено(Имя) Тогда
		Параметры.Вставить("Наименование", Имя);
	КонецЕсли;

	Номер = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Номер", "");
	Если ЗначениеЗаполнено(Номер) Тогда
		Параметры.Вставить("Номер", Номер);
	КонецЕсли;

	ДатаСтр = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Дата", "");
	Если ЗначениеЗаполнено(ДатаСтр) Тогда
		Попытка
			Параметры.Вставить("Дата", XMLЗначение(Тип("Дата"), Строка(ДатаСтр)));
		Исключение
		КонецПопытки;
	КонецЕсли;

	Вид = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "ВидДоговора", "СПоставщиком");
	Параметры.Вставить("ВидДоговора", Вид);

	Возврат Параметры;

КонецФункции

// Безопасная установка реквизита (для опциональных полей которые могут отсутствовать).
//
Процедура УстановитьРеквизитБезопасно(Объект, Имя, Значение)
	Попытка
		Объект[Имя] = Значение;
	Исключение
	КонецПопытки;
КонецПроцедуры

// Поиск рублёвой валюты.
//
Функция ПолучитьВалютуRUB()
	Попытка
		Возврат Справочники.Валюты.НайтиПоКоду("643");
	Исключение
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецПопытки;
КонецФункции

// Хеш отдельного документа в пакете — для отслеживания «пустых» повторов
// (если ЦБ перевыгрузил тот же документ без изменений). Простая функция:
// SHA-256 от сериализованного JSON-фрагмента документа.
//
Функция ВычислитьХешДокумента(Док)

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Док);
		Тело = ЗаписьJSON.Закрыть();

		Двоичные = ПолучитьДвоичныеДанныеИзСтроки(Тело, "UTF-8", Ложь);
		Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеш.Добавить(Двоичные);
		Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти
