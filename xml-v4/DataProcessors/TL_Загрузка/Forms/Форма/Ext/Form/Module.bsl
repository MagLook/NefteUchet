// === Унификация имён складов АЗС ===

&НаКлиенте
Процедура ОткрытьУнификациюСкладов(Команда)

	ИнфоОбИзменениях = ПодготовитьТекстПланаУнификации();
	// Структура: ЕстьИзменения, Текст
	Если ИнфоОбИзменениях.ЕстьИзменения Тогда
		Оповещение = Новый ОписаниеОповещения("ОткрытьУнификациюСкладов_Завершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ИнфоОбИзменениях.Текст, РежимДиалогаВопрос.ДаНет, ,
			КодВозвратаДиалога.Нет, "Унификация имён складов АЗС");
	Иначе
		// Изменений нет — но всё равно покажем сводку, чтобы бухгалтер видел что проверка прошла
		ПоказатьПредупреждение(, ИнфоОбИзменениях.Текст, , "Унификация имён складов АЗС");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьУнификациюСкладов_Завершение(Результат, Параметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ПрименитьУнификациюНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПодготовитьТекстПланаУнификации()

	План = TL_Настройки.ПолучитьПланУнификацииСкладовАЗС();

	СтрокиПлана = "";
	СтрокиСводки = "";
	СтрокиКонфликтов = "";
	КолвоПлан = 0;
	КолвоОК   = 0;

	Для Каждого Стр Из План Цикл
		Если Стр.Применить Тогда
			КолвоПлан = КолвоПлан + 1;
			СтрокиПлана = СтрокиПлана + ?(ЗначениеЗаполнено(СтрокиПлана), Символы.ПС, "")
				+ "  ст." + Стр.Код + ":  «" + Стр.ТекущееИмя + "»  →  «" + Стр.ЦелевоеИмя + "»";
		ИначеЕсли ЗначениеЗаполнено(Стр.Конфликт) Тогда
			СтрокиКонфликтов = СтрокиКонфликтов + ?(ЗначениеЗаполнено(СтрокиКонфликтов), Символы.ПС, "")
				+ "  ст." + Стр.Код + ":  " + Стр.Конфликт;
		Иначе
			КолвоОК = КолвоОК + 1;
			СтрокиСводки = СтрокиСводки + ?(ЗначениеЗаполнено(СтрокиСводки), Символы.ПС, "")
				+ "  ✓ ст." + Стр.Код + ":  " + Стр.ТекущееИмя;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура("ЕстьИзменения, Текст", Ложь, "");

	Если КолвоПлан > 0 Тогда
		Результат.ЕстьИзменения = Истина;
		Результат.Текст = "Будут переименованы следующие склады АЗС (" + КолвоПлан + " шт.):"
			+ Символы.ПС + Символы.ПС + СтрокиПлана;
		Если ЗначениеЗаполнено(СтрокиКонфликтов) Тогда
			Результат.Текст = Результат.Текст + Символы.ПС + Символы.ПС
				+ "Пропущены из-за конфликтов имён:" + Символы.ПС + СтрокиКонфликтов;
		КонецЕсли;
		Результат.Текст = Результат.Текст + Символы.ПС + Символы.ПС + "Применить переименование?";
	Иначе
		// Изменений нет — показываем сводку всех проверенных позиций
		Результат.Текст = "Проверка завершена: все " + КолвоОК
			+ " складов АЗС соответствуют стандарту наименования."
			+ Символы.ПС + Символы.ПС + СтрокиСводки;
		Если ЗначениеЗаполнено(СтрокиКонфликтов) Тогда
			Результат.Текст = Результат.Текст + Символы.ПС + Символы.ПС
				+ "Конфликты:" + Символы.ПС + СтрокиКонфликтов;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПрименитьУнификациюНаСервере()

	План = TL_Настройки.ПолучитьПланУнификацииСкладовАЗС();
	Пары = Новый Соответствие;
	Для Каждого Стр Из План Цикл
		Если Стр.Применить Тогда
			Пары.Вставить(Стр.Код, Стр.ЦелевоеИмя);
		КонецЕсли;
	КонецЦикла;

	Рез = TL_Настройки.ПрименитьУнификациюСкладовАЗС(Пары);

	Лог = ?(ЗначениеЗаполнено(ТекстЛога), ТекстЛога + Символы.ПС, "")
		+ "=== Унификация имён складов АЗС ===";
	Для Каждого С Из Рез.Применено Цикл
		Лог = Лог + Символы.ПС + "✓ " + С;
	КонецЦикла;
	Для Каждого О Из Рез.Ошибки Цикл
		Лог = Лог + Символы.ПС + "✗ " + О;
	КонецЦикла;
	Лог = Лог + Символы.ПС + "Итого: переименовано " + Строка(Рез.Применено.Количество())
		+ ", ошибок " + Строка(Рез.Ошибки.Количество());
	ТекстЛога = Лог;

КонецПроцедуры

// ============================================================================
//  Кнопки: Опросить каталог / Последние документы / Экспорт дашборда
// ============================================================================

&НаКлиенте
Процедура ОпроситьКаталогКлик(Команда)
	Результат = ОпроситьКаталогНаСервере();
	ТекстЛога = Результат;
	Сообщить(Результат);
	// Если есть новые — предложить загрузить
	НовыхНайдено = ИзвлечьЧислоНовых(Результат);
	Если НовыхНайдено > 0 Тогда
		Ответ = Вопрос("Найдено новых пакетов: " + НовыхНайдено
				+ ". Загрузить все сейчас (с автопроведением)?",
			РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ЛогЗагрузки = ЗагрузитьВсеНовыеНаСервере();
			Сообщить(ЛогЗагрузки);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ИзвлечьЧислоНовых(Текст)
	// Парсим строку «Новых: N, уже загружено: M»
	Поз = СтрНайти(Текст, "Новых: ");
	Если Поз = 0 Тогда Возврат 0; КонецЕсли;
	Остаток = Сред(Текст, Поз + СтрДлина("Новых: "));
	КонцПоз = СтрНайти(Остаток, ",");
	Если КонцПоз = 0 Тогда Возврат 0; КонецЕсли;
	Стр = СокрЛП(Лев(Остаток, КонцПоз - 1));
	Попытка
		Возврат Число(Стр);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ЗагрузитьВсеНовыеНаСервере()
	КаталогПуть = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
	Если Не ЗначениеЗаполнено(КаталогПуть) Тогда
		Возврат "Каталог не настроен";
	КонецЕсли;
	Лог = "Загрузка началась: " + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + Символы.ПС;
	Загружено = 0;
	Ошибок = 0;
	// Маска *.json — оба формата (старый tl_*.json + новый АЗС*_*.json)
	Файлы = НайтиФайлы(КаталогПуть, "*.json", Истина);
	// Список уже загруженных
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ИдентификаторПоследнегоПакета КАК ИдПакета
		|ИЗ РегистрСведений.TL_СоответствиеИсточников
		|ГДЕ НЕ ИдентификаторПоследнегоПакета = """"");
	ЗагрСоотв = Новый Соответствие;
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		ЗагрСоотв.Вставить(СокрЛП(Выб.ИдПакета), Истина);
	КонецЦикла;
	Для Каждого Ф Из Файлы Цикл
		ИмяНорм = НРег(Ф.ИмяБезРасширения);
		ЭтоНовый = Истина;
		Для Каждого КЗ Из ЗагрСоотв Цикл
			Если СтрНайти(ИмяНорм, НРег(КЗ.Ключ)) > 0 Тогда
				ЭтоНовый = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЭтоНовый Тогда Продолжить; КонецЕсли;
		Попытка
			ЧТекст = Новый ЧтениеТекста(Ф.ПолноеИмя, "UTF-8");
			JSONСтр = ЧТекст.Прочитать();
			ЧТекст.Закрыть();
			ЧJSON = Новый ЧтениеJSON;
			ЧJSON.УстановитьСтроку(JSONСтр);
			Пакет = ПрочитатьJSON(ЧJSON);
			ЧJSON.Закрыть();
			TL_СопуткаСервис.ОбработатьПакет(Пакет, Истина);
			Загружено = Загружено + 1;
			Лог = Лог + "  ✓ " + Ф.Имя + Символы.ПС;
		Исключение
			Ошибок = Ошибок + 1;
			Лог = Лог + "  ✗ " + Ф.Имя + ": " + ОписаниеОшибки() + Символы.ПС;
		КонецПопытки;
	КонецЦикла;
	Лог = Лог + Символы.ПС + "ИТОГО: загружено " + Загружено + ", ошибок " + Ошибок;
	Возврат Лог;
КонецФункции

&НаСервере
Функция ОпроситьКаталогНаСервере()
	КаталогПуть = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
	Если Не ЗначениеЗаполнено(КаталогПуть) Тогда
		Возврат "Каталог OwnCloud не настроен. Открой TL_НастройкаОбменаСопутка → Заполнить → Сохранить.";
	КонецЕсли;
	Попытка
		// Маска *.json — оба формата (старый tl_*.json + новый АЗС*_*.json)
		Файлы = НайтиФайлы(КаталогПуть, "*.json", Истина);
	Исключение
		Возврат "Ошибка опроса каталога " + КаталогПуть + ": " + ОписаниеОшибки();
	КонецПопытки;
	Если Файлы.Количество() = 0 Тогда
		Возврат "Каталог " + КаталогПуть + " пуст (.json не найдены).";
	КонецЕсли;
	// Считаем загруженные / новые через TL_СоответствиеИсточников.ИдентификаторПоследнегоПакета
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИдентификаторПоследнегоПакета КАК ИдПакета
		|ИЗ РегистрСведений.TL_СоответствиеИсточников
		|ГДЕ НЕ ИдентификаторПоследнегоПакета = """"");
	ЗагруженныеПакеты = Новый Соответствие;
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		ЗагруженныеПакеты.Вставить(СокрЛП(Выб.ИдПакета), Истина);
	КонецЦикла;
	Новых = 0;
	Загруженных = 0;
	Лог = "Каталог: " + КаталогПуть + Символы.ПС
		+ "Найдено tl_*.json: " + Файлы.Количество() + Символы.ПС;
	Для Каждого Ф Из Файлы Цикл
		ИмяНорм = НРег(Ф.ИмяБезРасширения);
		ЭтоНовый = Истина;
		Для Каждого КлючЗначение Из ЗагруженныеПакеты Цикл
			Если СтрНайти(ИмяНорм, НРег(КлючЗначение.Ключ)) > 0 Тогда
				ЭтоНовый = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЭтоНовый Тогда
			Новых = Новых + 1;
			Лог = Лог + "  НОВЫЙ: " + Ф.Имя + " (" + ОкруглитьРазмер(Ф.Размер()) + ")" + Символы.ПС;
		Иначе
			Загруженных = Загруженных + 1;
		КонецЕсли;
	КонецЦикла;
	Лог = Лог + Символы.ПС
		+ "Новых: " + Новых + ", уже загружено: " + Загруженных;
	Возврат Лог;
КонецФункции

&НаСервереБезКонтекста
Функция ОкруглитьРазмер(Байт)
	// Ф.Размер() в редких случаях возвращает Неопределено / строку. Защищаемся
	// приведением к Числу с Попыткой — иначе сравнение «Байт < 1024» валит
	// форму ошибкой «Преобразование значения к типу Число не может быть выполнено».
	Попытка
		ЧислоБайт = Число(Байт);
	Исключение
		Возврат "?";
	КонецПопытки;
	Если ЧислоБайт < 1024 Тогда
		Возврат Формат(ЧислоБайт, "ЧДЦ=0") + " Б";
	ИначеЕсли ЧислоБайт < 1024 * 1024 Тогда
		Возврат Формат(ЧислоБайт / 1024, "ЧДЦ=1") + " КБ";
	Иначе
		Возврат Формат(ЧислоБайт / 1024 / 1024, "ЧДЦ=2") + " МБ";
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ПоказатьПоследниеДокументыКлик(Команда)
	ПерейтиПоНавигационнойСсылке("e1cib/list/РегистрСведений.TL_СоответствиеИсточников");
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортДашбордаКлик(Команда)
	Если Не ЗначениеЗаполнено(HTMLДашборд) Тогда
		Сообщить("Дашборд пуст. Сначала нажмите Обновить.");
		Возврат;
	КонецЕсли;
	ИмяФайла = "Дашборд_TradeLedger_"
		+ Формат(ТекущаяДата(), "ДФ=ггггММдд_ЧЧммсс") + ".html";
	ПутьИзНастроек = "";
	Попытка
		ПутьИзНастроек = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
	Исключение
	КонецПопытки;
	НачальныйПуть = ?(ЗначениеЗаполнено(ПутьИзНастроек), ПутьИзНастроек, "");
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить дашборд";
	Диалог.Расширение = "html";
	Диалог.Фильтр = "HTML-файлы (*.html)|*.html|Все файлы|*.*";
	Диалог.ПолноеИмяФайла = ИмяФайла;
	Если ЗначениеЗаполнено(НачальныйПуть) Тогда
		Диалог.Каталог = НачальныйПуть;
	КонецЕсли;
	Если Диалог.Выбрать() Тогда
		СохранитьДашбордНаСервере(Диалог.ПолноеИмяФайла);
		Сообщить("Дашборд сохранён: " + Диалог.ПолноеИмяФайла);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьДашбордНаСервере(ПолноеИмя)
	Запись = Новый ЗаписьТекста(ПолноеИмя, "UTF-8");
	Запись.Записать(HTMLДашборд);
	Запись.Закрыть();
КонецПроцедуры

// ==========================================================================
//  СОПУТКА / ОБЩЕПИТ — заполнение из каталога пакетов ЦБ
// ==========================================================================
//
// Источник: каталог OwnCloud (из настройки КаталогOwnCloud_ЦБ или дефолт
// C:\TL_BP_Export\). Файлы АЗС*_*.json (формат v2 пакета смены).
//
// Заполнение таблиц:
//   ВнешниеДанные  — пакеты, которых ещё нет в TL_СоответствиеИсточников
//   ВнутренниеДанные — уже-загруженные (статус «Загружен»)
//
// Поле «ДанныеJSON» = полный путь к файлу (не содержимое — оно читается на
// этапе загрузки через TL_СопуткаСервис.ОбработатьПакетИзФайла).
//
&НаСервере
Процедура ОбновитьДанныеИзКаталогаПакетов(Режим)

	Каталог = "";
	Попытка
		Каталог = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
	Исключение
	КонецПопытки;
	Если Не ЗначениеЗаполнено(Каталог) Тогда
		Каталог = "C:\TL_BP_Export\";
	КонецЕсли;

	Файл = Новый Файл(Каталог);
	Если Не Файл.Существует() Тогда
		ДобавитьВЛогСервер("Каталог пакетов не существует: " + Каталог);
		Возврат;
	КонецЕсли;

	// Маска *.json охватывает оба формата имён: старый tl_*.json и новый АЗС*_*.json.
	Список = TL_HTTPКлиентЦБ.ПолучитьСписокНовыхПакетов(Каталог, Истина, Неопределено, "*.json");
	ДобавитьВЛогСервер("Каталог " + Каталог + " — найдено файлов: " + Список.Количество()
		+ ", фильтр: " + Формат(ДатаНачала, "ДФ='dd.MM.yyyy'") + " .. "
		+ Формат(ДатаОкончания, "ДФ='dd.MM.yyyy'")
		+ ?(КодСтанции > 0, ", станция=" + XMLСтрока(КодСтанции), ""));

	Если Список.Количество() = 0 Тогда
		ОбновитьДашборд();
		Возврат;
	КонецЕсли;

	// Дедупликация: в каталоге могут лежать несколько файлов на одну смену
	// (повторные прогоны выгрузки → каждый раз новый UUID имени). Группируем
	// по (КодАЗС, НомерСмены) и оставляем только самый свежий + считаем копии.
	Список = ДедуплицироватьСписокПакетов(Список);

	// Счётчики для диагностики «почему пусто»
	ОтсеяноПериод = 0;
	ОтсеяноСтанция = 0;
	ОтсеяноРежим = 0;
	ОшибкаЧтения = 0;

	Для Каждого СтрФ Из Список Цикл

		// Прочитать заголовок пакета (Смена{} + Документы[])
		Чтение = TL_HTTPКлиентЦБ.ПрочитатьПакетИзФайла(СтрФ.ПолныйПуть);
		Если ЗначениеЗаполнено(Чтение.Ошибка) Или Чтение.Пакет = Неопределено Тогда
			ОшибкаЧтения = ОшибкаЧтения + 1;
			Продолжить;
		КонецЕсли;
		Пакет = Чтение.Пакет;

		Смена = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Смена", Неопределено);
		КодАЗС = 0;
		НомерСменыСтр = "";
		ЗакрытиеСмены = '00010101';
		Если ТипЗнч(Смена) = Тип("Соответствие") Тогда
			Попытка КодАЗС = Число(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "КодАЗС", 0)); Исключение КонецПопытки;
			НомерСменыСтр = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "НомерСмены", "")));
			ЗакрытиеСтрока = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "Закрытие", "");
			Если ЗначениеЗаполнено(ЗакрытиеСтрока) Тогда
				Попытка
					ЗакрытиеСмены = XMLЗначение(Тип("Дата"), Строка(ЗакрытиеСтрока));
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;

		// «Документы» — зарезервированное слово 1С (глобальная коллекция).
		// Используем ДокСписок чтобы не конфликтовать с парсером.
		ДокСписок = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Документы", Новый Массив);
		КолДок = ?(ТипЗнч(ДокСписок) = Тип("Массив") Или ТипЗнч(ДокСписок) = Тип("ФиксированныйМассив"),
			ДокСписок.Количество(), 0);

		СуммаПакета = 0;
		ЕстьСопутки = Ложь;
		ЕстьОбщепита = Ложь;
		Если ТипЗнч(ДокСписок) = Тип("Массив") Или ТипЗнч(ДокСписок) = Тип("ФиксированныйМассив") Тогда
			Для Каждого Д Из ДокСписок Цикл
				СуммаПакета = СуммаПакета
					+ TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Д, "СуммаДокумента", 0);
				ТипД = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Д, "Тип", ""));
				Если ТипД = "production_release" Тогда
					ЕстьОбщепита = Истина;
				ИначеЕсли ТипД = "retail_sale_sidegoods" ИЛИ ТипД = "purchase"
						ИЛИ ТипД = "return_purchase" ИЛИ ТипД = "inventory"
						ИЛИ ТипД = "gain" ИЛИ ТипД = "writeoff" ИЛИ ТипД = "transfer" Тогда
					ЕстьСопутки = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Фильтр режима: показывать только пакеты с релевантным содержимым
		// (Сопутка — есть хотя бы один не-общепит kind; Общепит — есть production_release).
		Если Режим = "Общепит" И НЕ ЕстьОбщепита Тогда
			ОтсеяноРежим = ОтсеяноРежим + 1;
			Продолжить;
		КонецЕсли;
		Если Режим = "Сопутка" И НЕ ЕстьСопутки Тогда
			ОтсеяноРежим = ОтсеяноРежим + 1;
			Продолжить;
		КонецЕсли;

		// Фильтр периода формы
		Если ЗначениеЗаполнено(ЗакрытиеСмены)
				И (ЗакрытиеСмены < НачалоДня(ДатаНачала) ИЛИ ЗакрытиеСмены > КонецДня(ДатаОкончания)) Тогда
			ОтсеяноПериод = ОтсеяноПериод + 1;
			Продолжить;
		КонецЕсли;

		// Фильтр станции
		Если КодСтанции > 0 И КодАЗС <> КодСтанции Тогда
			ОтсеяноСтанция = ОтсеяноСтанция + 1;
			Продолжить;
		КонецЕсли;

		Описание = "Смена " + НомерСменыСтр + " · " + XMLСтрока(КолДок) + " док · "
			+ СтрФ.ИмяФайла;
		КлючЗагрузки = СтрФ.ИдентификаторПакета;
		ТипДок = Режим;

		Если СтрФ.УжеЗагружен Тогда
			НовВ = ВнутренниеДанные.Добавить();
			НовВ.Отметка              = Ложь;
			НовВ.Статус               = "Загружен";
			НовВ.ТипДокумента         = ТипДок;
			НовВ.Дата                 = ЗакрытиеСмены;
			НовВ.Станция              = КодАЗС;
			НовВ.Описание             = Описание;
			НовВ.Сумма                = СуммаПакета;
			НовВ.КлючЗагрузки         = КлючЗагрузки;
			НовВ.КлючБазовый          = КлючЗагрузки;
			НовВ.ДанныеJSON           = СтрФ.ПолныйПуть;
			НовВ.ДокументПредставление = "Пакет " + Лев(КлючЗагрузки, 8);
		Иначе
			НовВ = ВнешниеДанные.Добавить();
			НовВ.Отметка       = Ложь;
			НовВ.ТипДокумента  = ТипДок;
			НовВ.Дата          = ЗакрытиеСмены;
			НовВ.Станция       = КодАЗС;
			// НомерСмены — реквизит формы тип «Число». Длинный строковый номер
			// (16 цифр) не помещается, поэтому кладём 0 + полный номер в Описание.
			НовВ.НомерСмены    = 0;
			НовВ.Описание      = Описание;
			НовВ.Сумма         = СуммаПакета;
			НовВ.КлючЗагрузки  = КлючЗагрузки;
			НовВ.ДанныеJSON    = СтрФ.ПолныйПуть;
		КонецЕсли;

	КонецЦикла;

	ВнешниеДанные.Сортировать("Дата УБЫВ");
	ВнутренниеДанные.Сортировать("Дата УБЫВ");

	// Сводка фильтрации — чтобы было видно, почему таблицы могут быть пустыми
	ИтогоПрошло = ВнешниеДанные.Количество() + ВнутренниеДанные.Количество();
	Если ИтогоПрошло = 0 И Список.Количество() > 0 Тогда
		Подсказка = "";
		Если ОтсеяноПериод > 0 Тогда
			Подсказка = " — расширьте период (Дата начала / Дата окончания)";
		ИначеЕсли ОтсеяноРежим > 0 Тогда
			Подсказка = " — в каталоге нет пакетов под режим " + Режим;
		ИначеЕсли ОтсеяноСтанция > 0 Тогда
			Подсказка = " — поменяйте Код станции";
		КонецЕсли;
		ДобавитьВЛогСервер("В таблицах 0 строк" + Подсказка);
	КонецЕсли;
	ДобавитьВЛогСервер("Прошло фильтр: " + ИтогоПрошло
		+ " | Отсеяно: период=" + ОтсеяноПериод
		+ ", станция=" + ОтсеяноСтанция
		+ ", режим=" + ОтсеяноРежим
		+ ?(ОшибкаЧтения > 0, ", ошибка чтения=" + ОшибкаЧтения, ""));

	ОбновитьДашборд();

КонецПроцедуры

// Загрузить отмеченные пакеты Сопутки/Общепита из ВнешниеДанные.
//
&НаСервере
Процедура ЗагрузитьВыбранныеПакетыНаСервере(Режим)

	Счётчик = 0;
	ИндексыУдаления = Новый Массив;

	Для Инд = 0 По ВнешниеДанные.Количество() - 1 Цикл
		Стр = ВнешниеДанные[Инд];
		Если Не Стр.Отметка Тогда
			Продолжить;
		КонецЕсли;

		ПутьФайла = Стр.ДанныеJSON;
		Если Не ЗначениеЗаполнено(ПутьФайла) Тогда
			ДобавитьВЛогСервер("Пропуск (пустой путь): " + Стр.КлючЗагрузки);
			Продолжить;
		КонецЕсли;

		Попытка
			Результат = TL_СопуткаСервис.ОбработатьПакетИзФайла(ПутьФайла, Истина);
		Исключение
			ДобавитьВЛогСервер("Ошибка загрузки " + Стр.КлючЗагрузки + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		КолСоздано = Результат.Документы.Количество();
		КолОшибок  = Результат.Ошибки.Количество();
		ДобавитьВЛогСервер("Пакет " + Стр.КлючЗагрузки + ": создано " + XMLСтрока(КолСоздано)
			+ " док, ошибок " + XMLСтрока(КолОшибок));

		// Логируем ошибки в форму
		Для НомОш = 0 По КолОшибок - 1 Цикл
			ДобавитьВЛогСервер("  · " + Результат.Ошибки[НомОш]);
		КонецЦикла;

		Если КолСоздано > 0 Тогда
			НоваяСтр = ВнутренниеДанные.Добавить();
			НоваяСтр.Отметка              = Ложь;
			НоваяСтр.ТипДокумента         = Режим;
			НоваяСтр.Дата                 = Стр.Дата;
			НоваяСтр.Станция              = Стр.Станция;
			НоваяСтр.Описание             = Стр.Описание + " → создано " + XMLСтрока(КолСоздано);
			НоваяСтр.Сумма                = Стр.Сумма;
			НоваяСтр.Статус               = ?(КолОшибок = 0, "Загружен", "Частично");
			НоваяСтр.КлючЗагрузки         = Стр.КлючЗагрузки;
			НоваяСтр.КлючБазовый          = Стр.КлючЗагрузки;
			НоваяСтр.ДанныеJSON           = ПутьФайла;
			НоваяСтр.ДокументПредставление = "Пакет " + Лев(Стр.КлючЗагрузки, 8)
				+ " (" + XMLСтрока(КолСоздано) + " док)";

			ИндексыУдаления.Добавить(Инд);
			Счётчик = Счётчик + 1;
		КонецЕсли;
	КонецЦикла;

	Сч = ИндексыУдаления.Количество() - 1;
	Пока Сч >= 0 Цикл
		ВнешниеДанные.Удалить(ИндексыУдаления[Сч]);
		Сч = Сч - 1;
	КонецЦикла;

	ВнутренниеДанные.Сортировать("Дата УБЫВ");
	ДобавитьВЛогСервер("Загружено пакетов: " + XMLСтрока(Счётчик)
		+ " (всего в 1С: " + ВнутренниеДанные.Количество() + ")");
	ОбновитьДашборд();

КонецПроцедуры

// Удалить пакеты Сопутки/Общепита — пометить ВСЕ связанные документы БП
// на удаление + почистить регистры TL_СоответствиеИсточников и TL_СверкаПакета.
// КлючБазовый строки = ИдентификаторПакета (UUID).
//
&НаСервере
Процедура УдалитьВыбранныеПакетыНаСервере()

	Счётчик = 0;
	Ошибок = 0;
	УспешныеПакеты = Новый Соответствие; // ИдПакета → Истина

	// Собрать отмеченные ИдПакета
	КлючиДляУдаления = Новый Массив;
	Для Каждого Стр Из ВнутренниеДанные Цикл
		Если Стр.Отметка И ЗначениеЗаполнено(Стр.КлючБазовый) Тогда
			КлючиДляУдаления.Добавить(Стр.КлючБазовый);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИдПакета Из КлючиДляУдаления Цикл

		НачатьТранзакцию();
		Попытка
			// 1. Найти все документы пакета через TL_СоответствиеИсточников
			Запрос = Новый Запрос(
				"ВЫБРАТЬ Тип, ИсточникUUID, СсылкаОбъект
				|ИЗ РегистрСведений.TL_СоответствиеИсточников
				|ГДЕ ИдентификаторПоследнегоПакета = &Ид");
			Запрос.УстановитьПараметр("Ид", ИдПакета);
			В = Запрос.Выполнить().Выбрать();

			СсылкиПакета = Новый Массив;
			Пока В.Следующий() Цикл
				Если ЗначениеЗаполнено(В.СсылкаОбъект) Тогда
					СсылкиПакета.Добавить(В.СсылкаОбъект);
				КонецЕсли;
			КонецЦикла;

			// 2. Каждый документ: отменить проведение + пометить на удаление
			КолДок = 0;
			Для Каждого Ссылка Из СсылкиПакета Цикл
				Попытка
					ДокОбъект = Ссылка.ПолучитьОбъект();
					Если ДокОбъект <> Неопределено Тогда
						Если ДокОбъект.Проведен Тогда
							ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
							// Перечитываем после ОтменаПроведения
							ДокОбъект = Ссылка.ПолучитьОбъект();
						КонецЕсли;
						Если ДокОбъект <> Неопределено И НЕ ДокОбъект.ПометкаУдаления Тогда
							ДокОбъект.УстановитьПометкуУдаления(Истина);
						КонецЕсли;
						КолДок = КолДок + 1;
					КонецЕсли;
				Исключение
					ДобавитьВЛогСервер("  Документ " + Ссылка + ": " + ОписаниеОшибки());
				КонецПопытки;
			КонецЦикла;

			// 3. Зачистить регистр TL_СоответствиеИсточников (записи по этому пакету)
			Попытка
				НаборЗаписей = РегистрыСведений.TL_СоответствиеИсточников.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ИдентификаторПоследнегоПакета.Установить(ИдПакета);
				НаборЗаписей.Прочитать();
				НаборЗаписей.Очистить();
				НаборЗаписей.Записать();
			Исключение
				// Если измерение по другому имени — пробуем альтернативу
				Попытка
					Запрос2 = Новый Запрос(
						"ВЫБРАТЬ Тип, ИсточникUUID
						|ИЗ РегистрСведений.TL_СоответствиеИсточников
						|ГДЕ ИдентификаторПоследнегоПакета = &Ид");
					Запрос2.УстановитьПараметр("Ид", ИдПакета);
					В2 = Запрос2.Выполнить().Выбрать();
					Пока В2.Следующий() Цикл
						МЗ = РегистрыСведений.TL_СоответствиеИсточников.СоздатьМенеджерЗаписи();
						МЗ.Тип = В2.Тип;
						МЗ.ИсточникUUID = В2.ИсточникUUID;
						МЗ.Удалить();
					КонецЦикла;
				Исключение
					ДобавитьВЛогСервер("  Регистр TL_СоответствиеИсточников: " + ОписаниеОшибки());
				КонецПопытки;
			КонецПопытки;

			// 4. Зачистить TL_СверкаПакета
			Попытка
				НаборЗаписей = РегистрыСведений.TL_СверкаПакета.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ИдентификаторПакета.Установить(ИдПакета);
				НаборЗаписей.Записать(Истина); // Истина = заменить = пусто
			Исключение
			КонецПопытки;

			// 5. Зачистить TL_ОшибкиЗагрузки (если есть)
			Попытка
				НаборЗаписей = РегистрыСведений.TL_ОшибкиЗагрузки.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ИдентификаторПакета.Установить(ИдПакета);
				НаборЗаписей.Записать(Истина);
			Исключение
			КонецПопытки;

			ЗафиксироватьТранзакцию();
			УспешныеПакеты.Вставить(ИдПакета, Истина);
			ДобавитьВЛогСервер("Пакет " + Лев(ИдПакета, 8) + ": помечено документов " + КолДок);

		Исключение
			ОтменитьТранзакцию();
			ДобавитьВЛогСервер("Пакет " + Лев(ИдПакета, 8) + " не удалён: " + ОписаниеОшибки());
			Ошибок = Ошибок + 1;
		КонецПопытки;

	КонецЦикла;

	// 6. Удалить строки из таблицы для успешно обработанных пакетов
	Инд = ВнутренниеДанные.Количество() - 1;
	Пока Инд >= 0 Цикл
		Стр = ВнутренниеДанные[Инд];
		Если УспешныеПакеты.Получить(Стр.КлючБазовый) = Истина Тогда
			ВнутренниеДанные.Удалить(Инд);
			Счётчик = Счётчик + 1;
		КонецЕсли;
		Инд = Инд - 1;
	КонецЦикла;

	ДобавитьВЛогСервер("Удалено пакетов из левой панели: " + XMLСтрока(Счётчик)
		+ ?(Ошибок > 0, ", ошибок: " + XMLСтрока(Ошибок), ""));
	ОбновитьДашборд();

КонецПроцедуры

// Дедуплицировать список файлов пакетов по (КодАЗС, НомерСмены).
// Возвращает ту же таблицу значений, но с одной строкой на смену — самой свежей
// по ДатаМодификации. В колонке ИмяФайла к имени самого свежего добавляется
// суффикс «(N копий)» при N > 1, чтобы было видно в карточке файла.
//
&НаСервере
Функция ДедуплицироватьСписокПакетов(СписокФайлов)

	// Группировка: ключ = "КодАЗС|НомерСмены"
	Группы = Новый Соответствие; // ключ → Структура{Свежая=строка ТЗ, Копий=число}

	Для Каждого СтрФ Из СписокФайлов Цикл
		// Прочитать шапку чтобы достать КодАЗС + НомерСмены
		Попытка
			Чтение = TL_HTTPКлиентЦБ.ПрочитатьПакетИзФайла(СтрФ.ПолныйПуть);
		Исключение
			Продолжить;
		КонецПопытки;
		Если ЗначениеЗаполнено(Чтение.Ошибка) Или Чтение.Пакет = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Смена = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Чтение.Пакет, "Смена", Неопределено);
		Если ТипЗнч(Смена) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		КодАЗС = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "КодАЗС", 0);
		НомерСмены = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "НомерСмены", "")));
		Если Не ЗначениеЗаполнено(НомерСмены) Тогда
			Продолжить;
		КонецЕсли;

		Ключ = XMLСтрока(КодАЗС) + "|" + НомерСмены;
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Свежая, Копий", СтрФ, 1);
			Группы.Вставить(Ключ, Группа);
		Иначе
			Группа.Копий = Группа.Копий + 1;
			Если СтрФ.ДатаМодификации > Группа.Свежая.ДатаМодификации Тогда
				Группа.Свежая = СтрФ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Собрать обратно в ТаблицуЗначений с той же структурой колонок
	Результат = СписокФайлов.Скопировать(Новый Массив); // пустая ТЗ с теми же колонками
	Для Каждого КЗ Из Группы Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, КЗ.Значение.Свежая);
		Если КЗ.Значение.Копий > 1 Тогда
			НоваяСтрока.ИмяФайла = НоваяСтрока.ИмяФайла + " (копий: " + XMLСтрока(КЗ.Значение.Копий) + ")";
		КонецЕсли;
	КонецЦикла;

	Результат.Сортировать("ДатаМодификации УБЫВ");
	ДобавитьВЛогСервер("Дедупликация: " + СписокФайлов.Количество()
		+ " файлов → " + Результат.Количество() + " уникальных смен");
	Возврат Результат;

КонецФункции

// Детали пакета смены (Сопутка/Общепит) — генерация HTML вынесена в
// общий модуль TL_HTMLГенератор.СформироватьДеталиПакетаСмены, чтобы
// эту же функцию могла использовать ФормаДетали (отдельная форма-окно).

&НаСервере
Функция СформироватьДеталиПакетаСмены_УДАЛЕНО(ПутьФайла, Заголовок)

	// 1. Прочитать пакет
	Чтение = TL_HTTPКлиентЦБ.ПрочитатьПакетИзФайла(ПутьФайла);
	Если ЗначениеЗаполнено(Чтение.Ошибка) Или Чтение.Пакет = Неопределено Тогда
		Возврат _ДетПак_ШаблонОшибка("Не удалось прочитать пакет: " + Чтение.Ошибка);
	КонецЕсли;
	Пакет = Чтение.Пакет;

	ИдПакета  = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ИдентификаторПакета", "");
	Источник  = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Источник", "");
	Версия    = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ВерсияФормата", "1");

	// Шапка смены
	Смена = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Смена", Неопределено);
	КодАЗС = 0; НомерСмены = ""; Открытие = '00010101'; Закрытие = '00010101';
	Оператор = ""; Касса = ""; ОСЭНомер = "";
	СкладUUID = ""; ОрганизацияUUID = "";
	Если ТипЗнч(Смена) = Тип("Соответствие") Тогда
		Попытка КодАЗС = Число(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "КодАЗС", 0)); Исключение КонецПопытки;
		НомерСмены = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "НомерСмены", "")));
		Открытие   = _ДетПак_ПарсДата(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "Открытие", ""));
		Закрытие   = _ДетПак_ПарсДата(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "Закрытие", ""));
		Оператор   = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "Оператор", "")));
		Касса      = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "Касса", "")));
		ОСЭНомер   = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "ОСЭНомер", "")));
		СкладUUID  = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "СкладUUID", "")));
		ОрганизацияUUID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "ОрганизацияUUID", "")));
	КонецЕсли;

	// Документы — массив
	ДокМассив = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Документы", Новый Массив);
	НСИМассив = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "НСИ", Новый Массив);

	// 2. Подсчитать KPI по типам
	Счёт = _ДетПак_Счётчики();
	СуммаПакета = 0;
	Если ТипЗнч(ДокМассив) = Тип("Массив") Или ТипЗнч(ДокМассив) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Д Из ДокМассив Цикл
			ТипД = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Д, "Тип", ""));
			Если Счёт.Свойство(ТипД) Тогда Счёт[ТипД] = Счёт[ТипД] + 1; КонецЕсли;
			СуммаПакета = СуммаПакета + TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Д, "СуммаДокумента", 0);
		КонецЦикла;
	КонецЕсли;

	// 3. НСИ-кэш для разрешения UUID → Наименование
	НСИКэш = Новый Соответствие;
	Если ТипЗнч(НСИМассив) = Тип("Массив") Или ТипЗнч(НСИМассив) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Эл Из НСИМассив Цикл
			UUID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Эл, "ИсточникUUID", "")));
			Имя  = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Эл, "Наименование", "")));
			Если ЗначениеЗаполнено(UUID) Тогда НСИКэш.Вставить(UUID, Имя); КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// 4. Соответствия в БП (UUID → Ссылка) — пакет может быть уже загружен
	СопостBP = _ДетПак_ЗагрузитьСопоставления(ИдПакета);

	// 5. Сверка ЦБ↔БП и Ошибки
	СверкаЗапись = _ДетПак_НайтиСверку(ИдПакета);
	СписокОшибок = _ДетПак_НайтиОшибки(ИдПакета);

	// 6. Собираем HTML
	HTML = _ДетПак_HTMLШаблон();
	HTML = HTML + _ДетПак_HTMLШапка(Заголовок, КодАЗС, НомерСмены, Открытие, Закрытие, ОСЭНомер, Версия, СуммаПакета, Счёт);
	HTML = HTML + _ДетПак_HTMLКарточкаСмены(КодАЗС, НомерСмены, Открытие, Закрытие, Оператор, Касса, ОСЭНомер, ОрганизацияUUID, СкладUUID, НСИКэш);
	HTML = HTML + _ДетПак_HTMLСверка(СверкаЗапись, СуммаПакета);
	HTML = HTML + _ДетПак_HTMLОшибки(СписокОшибок);
	HTML = HTML + _ДетПак_HTMLДокументы(ДокМассив, НСИКэш, СопостBP);
	HTML = HTML + "</div></body></html>";

	Возврат HTML;

КонецФункции

&НаСервере
Функция _ДетПак_Счётчики()
	Стр = Новый Структура;
	Стр.Вставить("purchase", 0);
	Стр.Вставить("retail_sale_sidegoods", 0);
	Стр.Вставить("production_release", 0);
	Стр.Вставить("return_purchase", 0);
	Стр.Вставить("inventory", 0);
	Стр.Вставить("gain", 0);
	Стр.Вставить("writeoff", 0);
	Стр.Вставить("transfer", 0);
	Возврат Стр;
КонецФункции

&НаСервере
Функция _ДетПак_ПарсДата(Стр)
	Если Не ЗначениеЗаполнено(Стр) Тогда Возврат '00010101'; КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Строка(Стр));
	Исключение
		Возврат '00010101';
	КонецПопытки;
КонецФункции

&НаСервере
Функция _ДетПак_ЦветТипа(Тип)
	Если Тип = "purchase"             Тогда Возврат "#3B82F6"; КонецЕсли;
	Если Тип = "retail_sale_sidegoods" Тогда Возврат "#16A34A"; КонецЕсли;
	Если Тип = "production_release"    Тогда Возврат "#EAB308"; КонецЕсли;
	Если Тип = "return_purchase"       Тогда Возврат "#EF4444"; КонецЕсли;
	Если Тип = "inventory"             Тогда Возврат "#6B7280"; КонецЕсли;
	Если Тип = "gain"                  Тогда Возврат "#8B5CF6"; КонецЕсли;
	Если Тип = "writeoff"              Тогда Возврат "#DC2626"; КонецЕсли;
	Если Тип = "transfer"              Тогда Возврат "#06B6D4"; КонецЕсли;
	Возврат "#6B7280";
КонецФункции

&НаСервере
Функция _ДетПак_ИмяТипа(Тип)
	Если Тип = "purchase"             Тогда Возврат "Поступление"; КонецЕсли;
	Если Тип = "retail_sale_sidegoods" Тогда Возврат "Розничные продажи"; КонецЕсли;
	Если Тип = "production_release"    Тогда Возврат "Выпуск продукции"; КонецЕсли;
	Если Тип = "return_purchase"       Тогда Возврат "Возврат поставщику"; КонецЕсли;
	Если Тип = "inventory"             Тогда Возврат "Инвентаризация"; КонецЕсли;
	Если Тип = "gain"                  Тогда Возврат "Оприходование"; КонецЕсли;
	Если Тип = "writeoff"              Тогда Возврат "Списание"; КонецЕсли;
	Если Тип = "transfer"              Тогда Возврат "Перемещение"; КонецЕсли;
	Возврат Тип;
КонецФункции

&НаСервере
Функция _ДетПак_ФорматСуммы(Сумма)
	Возврат Формат(Сумма, "ЧДЦ=2; ЧРГ=' '") + " ₽";
КонецФункции

&НаСервере
Функция _ДетПак_HTMLШаблон()
	// В 1С строковые литералы не могут содержать переносы строк (нужен синтаксис «|»
	// или конкатенация). Здесь — конкатенация: каждый CSS-блок одной строкой.
	Стиль = "body{margin:0;padding:0;font-family:-apple-system,'Segoe UI',sans-serif;font-size:13px;background:#F0F4F8;color:#1F2937;}"
		+ ".wrap{padding:12px 16px;}"
		+ "h1{font-size:18px;margin:0 0 4px 0;color:#1F2937;}"
		+ ".sub{font-size:11px;color:#6B7280;margin-bottom:12px;}"
		+ ".kpi{display:grid;grid-template-columns:repeat(9,1fr);gap:6px;margin-bottom:12px;}"
		+ ".kpi-card{background:#fff;border:1px solid #E2E8F0;border-radius:6px;padding:8px;text-align:center;}"
		+ ".kpi-card .val{font-size:18px;font-weight:600;}"
		+ ".kpi-card .lbl{font-size:10px;color:#6B7280;text-transform:uppercase;letter-spacing:0.4px;}"
		+ ".section{background:#fff;border:1px solid #E2E8F0;border-radius:6px;padding:10px 12px;margin-bottom:10px;}"
		+ ".section h2{font-size:13px;margin:0 0 8px 0;color:#374151;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;}"
		+ ".meta{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;font-size:12px;}"
		+ ".meta .lbl{color:#6B7280;font-size:10px;text-transform:uppercase;letter-spacing:0.4px;}"
		+ ".meta .val{font-weight:500;}"
		+ ".doc{background:#fff;border:1px solid #E2E8F0;border-left:4px solid;border-radius:6px;padding:10px 12px;margin-bottom:8px;}"
		+ ".doc-hdr{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px;}"
		+ ".doc-hdr .left{font-weight:600;font-size:14px;}"
		+ ".doc-hdr .badge{font-size:10px;padding:2px 6px;border-radius:3px;color:#fff;text-transform:uppercase;font-weight:600;letter-spacing:0.4px;}"
		+ ".doc-hdr .right{text-align:right;font-size:13px;}"
		+ ".doc-meta{font-size:11px;color:#6B7280;margin-bottom:6px;}"
		+ ".doc-meta span{margin-right:12px;}"
		+ ".tbl{width:100%;border-collapse:collapse;font-size:11px;margin-top:6px;}"
		+ ".tbl th{background:#F8FAFC;color:#475569;font-weight:600;text-align:left;padding:4px 6px;border-bottom:1px solid #E2E8F0;}"
		+ ".tbl td{padding:3px 6px;border-bottom:1px solid #F1F5F9;}"
		+ ".tbl td.num{text-align:right;font-variant-numeric:tabular-nums;}"
		+ ".tbl tr:hover{background:#F8FAFC;}"
		+ ".warn{background:#FEF3C7;color:#92400E;padding:8px 10px;border-radius:4px;border-left:4px solid #EAB308;margin-bottom:10px;}"
		+ ".err{background:#FEE2E2;color:#991B1B;padding:8px 10px;border-radius:4px;border-left:4px solid #EF4444;margin-bottom:10px;}"
		+ ".ok-pill{display:inline-block;background:#DCFCE7;color:#15803D;padding:1px 8px;border-radius:10px;font-size:10px;font-weight:600;}"
		+ ".ko-pill{display:inline-block;background:#FEE2E2;color:#991B1B;padding:1px 8px;border-radius:10px;font-size:10px;font-weight:600;}";
	Возврат "<!DOCTYPE html><html><head><meta charset=""utf-8""><style>" + Стиль + "</style></head><body><div class=""wrap"">";
КонецФункции

&НаСервере
Функция _ДетПак_HTMLШапка(Заголовок, КодАЗС, НомерСмены, Открытие, Закрытие, ОСЭНомер, Версия, СуммаПакета, Счёт)
	ДнДата = Формат(Закрытие, "ДФ='dd.MM.yyyy HH:mm'");
	ОткрСтр = Формат(Открытие, "ДФ='dd.MM HH:mm'");
	Заг = "Смена " + НомерСмены + " · АЗС " + Формат(КодАЗС, "ЧГ=0") + " · " + ОткрСтр + " → " + ДнДата;

	Длительность = (Закрытие - Открытие) / 3600;
	СубТитр = "ОСЭ " + ОСЭНомер + " · длительность " + Формат(Длительность, "ЧДЦ=1") + " ч · формат v" + Версия;

	HTML = "<h1>" + Заг + "</h1><div class=""sub"">" + СубТитр + "</div>";
	HTML = HTML + "<div class=""kpi"">";
	HTML = HTML + _ДетПак_KPIКарточка(Счёт.purchase,             "Поступл.",   "#3B82F6");
	HTML = HTML + _ДетПак_KPIКарточка(Счёт.retail_sale_sidegoods, "Розница",    "#16A34A");
	HTML = HTML + _ДетПак_KPIКарточка(Счёт.production_release,    "Произв.",    "#EAB308");
	HTML = HTML + _ДетПак_KPIКарточка(Счёт.return_purchase,       "Возвр.",     "#EF4444");
	HTML = HTML + _ДетПак_KPIКарточка(Счёт.inventory,             "Инвент.",    "#6B7280");
	HTML = HTML + _ДетПак_KPIКарточка(Счёт.gain,                  "Оприход.",   "#8B5CF6");
	HTML = HTML + _ДетПак_KPIКарточка(Счёт.writeoff,              "Списан.",    "#DC2626");
	HTML = HTML + _ДетПак_KPIКарточка(Счёт.transfer,              "Перем.",     "#06B6D4");

	// Карточка суммы
	HTML = HTML + "<div class=""kpi-card"" style=""background:#1F2937;color:#fff;"">"
		+ "<div class=""val"" style=""color:#fff;"">" + Формат(СуммаПакета, "ЧДЦ=0; ЧРГ=' '") + "</div>"
		+ "<div class=""lbl"" style=""color:#9CA3AF;"">Сумма ₽</div></div>";
	HTML = HTML + "</div>";
	Возврат HTML;
КонецФункции

&НаСервере
Функция _ДетПак_KPIКарточка(Значение, Метка, Цвет)
	Возврат "<div class=""kpi-card"">"
		+ "<div class=""val"" style=""color:" + Цвет + ";"">" + Формат(Значение, "ЧГ=0") + "</div>"
		+ "<div class=""lbl"">" + Метка + "</div></div>";
КонецФункции

&НаСервере
Функция _ДетПак_HTMLКарточкаСмены(КодАЗС, НомерСмены, Открытие, Закрытие, Оператор, Касса, ОСЭНомер, ОргUUID, СклUUID, НСИКэш)
	ОргИмя  = НСИКэш.Получить(ОргUUID);
	СклИмя  = НСИКэш.Получить(СклUUID);
	ОргТекст = ?(ОргИмя <> Неопределено И ЗначениеЗаполнено(ОргИмя), ОргИмя, ОргUUID);
	СклТекст = ?(СклИмя <> Неопределено И ЗначениеЗаполнено(СклИмя), СклИмя, СклUUID);

	HTML = "<div class=""section""><h2>Шапка смены</h2><div class=""meta"">"
		+ _ДетПак_МетаПара("КодАЗС", Формат(КодАЗС, "ЧГ=0"))
		+ _ДетПак_МетаПара("Номер смены", НомерСмены)
		+ _ДетПак_МетаПара("Открытие", Формат(Открытие, "ДФ='dd.MM.yyyy HH:mm:ss'"))
		+ _ДетПак_МетаПара("Закрытие", Формат(Закрытие, "ДФ='dd.MM.yyyy HH:mm:ss'"))
		+ _ДетПак_МетаПара("Оператор", ?(ЗначениеЗаполнено(Оператор), Оператор, "—"))
		+ _ДетПак_МетаПара("Касса", ?(ЗначениеЗаполнено(Касса), Касса, "—"))
		+ _ДетПак_МетаПара("ОСЭ_Номер", ОСЭНомер)
		+ _ДетПак_МетаПара("Организация", ОргТекст)
		+ _ДетПак_МетаПара("Склад", СклТекст);
	HTML = HTML + "</div></div>";
	Возврат HTML;
КонецФункции

&НаСервере
Функция _ДетПак_МетаПара(Метка, Значение)
	Возврат "<div><div class=""lbl"">" + Метка + "</div><div class=""val"">" + Значение + "</div></div>";
КонецФункции

&НаСервере
Функция _ДетПак_HTMLСверка(СверкаЗапись, СуммаПакетаJSON)
	Если СверкаЗапись = Неопределено Тогда
		Возврат "<div class=""warn"">Пакет ещё не загружен в БП ГИГ (нет записи в TL_СверкаПакета). Нажмите «Загрузить выбранные».</div>";
	КонецЕсли;
	Расх = СверкаЗапись.СуммаЦБ - СверкаЗапись.СуммаБП;
	ЦветРасх = ?(Расх = 0, "#15803D", ?(Расх > 0, "#EAB308", "#EF4444"));
	Статус = Строка(СверкаЗапись.Статус);
	HTML = "<div class=""section""><h2>Сверка ЦБ ↔ БП ГИГ</h2><div class=""meta"">"
		+ _ДетПак_МетаПара("Время загрузки", Формат(СверкаЗапись.ВремяЗагрузки, "ДФ='dd.MM.yyyy HH:mm:ss'"))
		+ _ДетПак_МетаПара("Статус", Статус)
		+ _ДетПак_МетаПара("Создано документов", Формат(СверкаЗапись.СтрокДокументов, "ЧГ=0"))
		+ _ДетПак_МетаПара("Сумма ЦБ", _ДетПак_ФорматСуммы(СверкаЗапись.СуммаЦБ))
		+ _ДетПак_МетаПара("Сумма БП", _ДетПак_ФорматСуммы(СверкаЗапись.СуммаБП))
		+ "<div><div class=""lbl"">Расхождение</div><div class=""val"" style=""color:" + ЦветРасх + ";font-weight:600;"">"
		+ _ДетПак_ФорматСуммы(Расх) + "</div></div>"
		+ "</div></div>";
	Возврат HTML;
КонецФункции

&НаСервере
Функция _ДетПак_HTMLОшибки(СписокОшибок)
	Если СписокОшибок.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	HTML = "<div class=""section""><h2 style=""color:#991B1B;"">Ошибки загрузки (" + СписокОшибок.Количество() + ")</h2>";
	Для Каждого Стр Из СписокОшибок Цикл
		HTML = HTML + "<div class=""err"">"
			+ "<b>" + Стр.Сообщение + "</b>"
			+ ?(ЗначениеЗаполнено(Стр.КодОшибки), " · код: " + Стр.КодОшибки, "")
			+ ?(ЗначениеЗаполнено(Стр.ТипОбъекта), " · объект: " + Стр.ТипОбъекта, "")
			+ ?(ЗначениеЗаполнено(Стр.ЗначениеИсточника), " · UUID: " + Стр.ЗначениеИсточника, "")
			+ "</div>";
	КонецЦикла;
	HTML = HTML + "</div>";
	Возврат HTML;
КонецФункции

&НаСервере
Функция _ДетПак_HTMLДокументы(ДокМассив, НСИКэш, СопостBP)
	Если ТипЗнч(ДокМассив) <> Тип("Массив") И ТипЗнч(ДокМассив) <> Тип("ФиксированныйМассив") Тогда
		Возврат "";
	КонецЕсли;
	HTML = "<div class=""section""><h2>Документы пакета (" + ДокМассив.Количество() + ")</h2></div>";

	НомерДок = 0;
	Для Каждого Д Из ДокМассив Цикл
		НомерДок = НомерДок + 1;
		HTML = HTML + _ДетПак_ОдинДок(Д, НомерДок, НСИКэш, СопостBP);
	КонецЦикла;
	Возврат HTML;
КонецФункции

&НаСервере
Функция _ДетПак_ОдинДок(Док, НомерДок, НСИКэш, СопостBP)
	Тип    = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Тип", ""));
	UUID   = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", ""));
	Номер  = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Номер", ""));
	Дата   = _ДетПак_ПарсДата(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Дата", ""));
	Сумма  = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаДокумента", 0);
	Цвет   = _ДетПак_ЦветТипа(Тип);
	ИмяТип = _ДетПак_ИмяТипа(Тип);

	// Связь с БП ГИГ
	Ссылка = СопостBP.Получить(UUID);
	СтатусСтр = "";
	Если Ссылка <> Неопределено Тогда
		Попытка
			Проведен = Ссылка.Проведен;
			СтатусСтр = "<span class=""ok-pill"">" + ?(Проведен, "✓ Проведён", "● Записан") + "</span> "
				+ "<span style=""font-size:11px;color:#6B7280;"">" + Строка(Ссылка) + "</span>";
		Исключение
			СтатусСтр = "<span class=""ok-pill"">создан</span>";
		КонецПопытки;
	Иначе
		СтатусСтр = "<span class=""ko-pill"">не создан</span>";
	КонецЕсли;

	HTML = "<div class=""doc"" style=""border-left-color:" + Цвет + ";"">";
	HTML = HTML + "<div class=""doc-hdr"">"
		+ "<div class=""left""><span class=""badge"" style=""background:" + Цвет + ";"">"
		+ ИмяТип + "</span> #" + Формат(НомерДок, "ЧГ=0")
		+ ?(ЗначениеЗаполнено(Номер), " · " + Номер, "") + "</div>"
		+ "<div class=""right"">"
		+ "<div style=""font-size:11px;color:#6B7280;"">" + Формат(Дата, "ДФ='dd.MM HH:mm:ss'") + "</div>"
		+ "<div style=""font-weight:600;"">" + _ДетПак_ФорматСуммы(Сумма) + "</div>"
		+ "</div></div>";

	// Мета-строка (Контрагент / Склад / Подразделение / etc.)
	HTML = HTML + "<div class=""doc-meta"">" + _ДетПак_МетаДок(Док, НСИКэш) + СтатусСтр + "</div>";

	// ТЧ Товары
	HTML = HTML + _ДетПак_ТЧТовары(Док, НСИКэш);

	// Спец-блоки по типу
	Если Тип = "production_release" Тогда
		HTML = HTML + _ДетПак_ТЧИнгредиенты(Док, НСИКэш);
	КонецЕсли;
	Если Тип = "retail_sale_sidegoods" Тогда
		HTML = HTML + _ДетПак_ТЧОплаты(Док);
	КонецЕсли;

	HTML = HTML + "</div>";
	Возврат HTML;
КонецФункции

&НаСервере
Функция _ДетПак_МетаДок(Док, НСИКэш)
	Куски = Новый Массив;
	КонтрUUID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Контрагент", "")));
	Если ЗначениеЗаполнено(КонтрUUID) Тогда
		Имя = НСИКэш.Получить(КонтрUUID);
		Куски.Добавить("<span><b>Контрагент:</b> " + ?(Имя = Неопределено, КонтрUUID, Имя) + "</span>");
	КонецЕсли;
	СклUUID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Склад", "")));
	Если ЗначениеЗаполнено(СклUUID) Тогда
		Имя = НСИКэш.Получить(СклUUID);
		Куски.Добавить("<span><b>Склад:</b> " + ?(Имя = Неопределено, "—", Имя) + "</span>");
	КонецЕсли;
	ОтпрUUID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СкладОтправитель", "")));
	ПолучUUID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СкладПолучатель", "")));
	Если ЗначениеЗаполнено(ОтпрUUID) И ЗначениеЗаполнено(ПолучUUID) Тогда
		Имя1 = НСИКэш.Получить(ОтпрUUID); Имя2 = НСИКэш.Получить(ПолучUUID);
		Напр = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Направление", "");
		Куски.Добавить("<span><b>" + ?(Имя1=Неопределено,"?",Имя1) + " → " + ?(Имя2=Неопределено,"?",Имя2)
			+ "</b> · " + Напр + "</span>");
	КонецЕсли;
	Подр = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Подразделение", "")));
	Если ЗначениеЗаполнено(Подр) Тогда
		Куски.Добавить("<span><b>Подразделение:</b> " + Подр + "</span>");
	КонецЕсли;
	Возврат СтрСоединить(Куски, " ");
КонецФункции

&НаСервере
Функция _ДетПак_ТЧТовары(Док, НСИКэш)
	Тип = СокрЛП(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Тип", ""));
	// Для production_release ТЧ называется ВыпускБлюд
	ИмяТЧ = ?(Тип = "production_release", "ВыпускБлюд", "Товары");
	Массив = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, ИмяТЧ, Новый Массив);
	Если ТипЗнч(Массив) <> Тип("Массив") И ТипЗнч(Массив) <> Тип("ФиксированныйМассив") Тогда
		Возврат "";
	КонецЕсли;
	Если Массив.Количество() = 0 Тогда
		Возврат "<div style=""font-size:11px;color:#6B7280;font-style:italic;"">ТЧ Товары пуста</div>";
	КонецЕсли;

	// Колонки в зависимости от типа
	ЕстьУчетКол = (Тип = "inventory");

	HTML = "<table class=""tbl""><thead><tr>"
		+ "<th style=""width:30px;"">#</th>"
		+ "<th>Номенклатура</th>"
		+ "<th style=""text-align:right;width:70px;"">Кол</th>"
		+ ?(ЕстьУчетКол, "<th style=""text-align:right;width:70px;color:#6B7280;"">Уч.кол</th>", "")
		+ ?(ЕстьУчетКол, "<th style=""text-align:right;width:70px;color:#EF4444;"">Δ</th>", "")
		+ "<th style=""width:50px;"">Ед.</th>"
		+ "<th style=""text-align:right;width:80px;"">Цена</th>"
		+ "<th style=""text-align:right;width:90px;"">Сумма</th>"
		+ "<th style=""width:60px;"">НДС</th>"
		+ "<th style=""text-align:right;width:80px;"">∑ НДС</th>"
		+ "</tr></thead><tbody>";

	Для Каждого Стр Из Массив Цикл
		НомСтр = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "НомерСтроки", 0);
		НомUUID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "Номенклатура", "")));
		НомИмя = НСИКэш.Получить(НомUUID);
		Если НомИмя = Неопределено Тогда НомИмя = "[" + Лев(НомUUID, 8) + "...]"; КонецЕсли;
		Кол  = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "Количество", 0);
		Цена = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "Цена", 0);
		Сум  = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "Сумма", 0);
		НДС  = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "СтавкаНДС", "")));
		СумНДС = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "СуммаНДС", 0);
		Ед   = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "Единица", "")));

		HTML = HTML + "<tr><td>" + Формат(НомСтр, "ЧГ=0") + "</td>"
			+ "<td>" + НомИмя + "</td>"
			+ "<td class=""num"">" + Формат(Кол, "ЧДЦ=3") + "</td>";
		Если ЕстьУчетКол Тогда
			КолУч = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "КоличествоУчет", 0);
			Дельта = Кол - КолУч;
			ЦветД = ?(Дельта = 0, "#6B7280", ?(Дельта > 0, "#16A34A", "#EF4444"));
			HTML = HTML + "<td class=""num"" style=""color:#6B7280;"">" + Формат(КолУч, "ЧДЦ=3") + "</td>"
				+ "<td class=""num"" style=""color:" + ЦветД + ";font-weight:600;"">"
				+ ?(Дельта > 0, "+", "") + Формат(Дельта, "ЧДЦ=3") + "</td>";
		КонецЕсли;
		HTML = HTML + "<td>" + Ед + "</td>"
			+ "<td class=""num"">" + Формат(Цена, "ЧДЦ=2") + "</td>"
			+ "<td class=""num""><b>" + Формат(Сум, "ЧДЦ=2") + "</b></td>"
			+ "<td>" + НДС + "</td>"
			+ "<td class=""num"">" + Формат(СумНДС, "ЧДЦ=2") + "</td></tr>";
	КонецЦикла;
	HTML = HTML + "</tbody></table>";
	Возврат HTML;
КонецФункции

&НаСервере
Функция _ДетПак_ТЧИнгредиенты(Док, НСИКэш)
	Массив = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Ингредиенты", Новый Массив);
	Если ТипЗнч(Массив) <> Тип("Массив") И ТипЗнч(Массив) <> Тип("ФиксированныйМассив") Тогда
		Возврат "";
	КонецЕсли;
	Если Массив.Количество() = 0 Тогда Возврат ""; КонецЕсли;

	HTML = "<div style=""margin-top:8px;font-size:11px;font-weight:600;color:#374151;"">Ингредиенты (" + Массив.Количество() + ")</div>";
	HTML = HTML + "<table class=""tbl""><thead><tr>"
		+ "<th style=""width:30px;"">#</th>"
		+ "<th>Номенклатура</th>"
		+ "<th>Продукция-источник</th>"
		+ "<th style=""text-align:right;width:90px;"">Кол</th>"
		+ "<th style=""width:50px;"">Ед.</th>"
		+ "</tr></thead><tbody>";

	Для Каждого Стр Из Массив Цикл
		НомСтр = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "НомерСтроки", 0);
		НомUUID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "Номенклатура", "")));
		НомИмя = НСИКэш.Получить(НомUUID);
		Если НомИмя = Неопределено Тогда НомИмя = "[" + Лев(НомUUID, 8) + "...]"; КонецЕсли;
		ИдПрод = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "ИдентификаторПродукция", "")));
		Кол = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "Количество", 0);
		Ед = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "Единица", "")));

		HTML = HTML + "<tr><td>" + Формат(НомСтр, "ЧГ=0") + "</td>"
			+ "<td>" + НомИмя + "</td>"
			+ "<td style=""font-size:10px;color:#6B7280;"">" + ИдПрод + "</td>"
			+ "<td class=""num"">" + Формат(Кол, "ЧДЦ=3") + "</td>"
			+ "<td>" + Ед + "</td></tr>";
	КонецЦикла;
	HTML = HTML + "</tbody></table>";
	Возврат HTML;
КонецФункции

&НаСервере
Функция _ДетПак_ТЧОплаты(Док)
	Массив = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Оплаты", Новый Массив);
	Если ТипЗнч(Массив) <> Тип("Массив") И ТипЗнч(Массив) <> Тип("ФиксированныйМассив") Тогда
		Возврат "";
	КонецЕсли;
	Если Массив.Количество() = 0 Тогда Возврат ""; КонецЕсли;

	HTML = "<div style=""margin-top:8px;font-size:11px;font-weight:600;color:#374151;"">Оплаты</div>";
	HTML = HTML + "<table class=""tbl""><thead><tr>"
		+ "<th>Вид оплаты</th>"
		+ "<th style=""text-align:right;width:120px;"">Сумма</th>"
		+ "</tr></thead><tbody>";
	Для Каждого Стр Из Массив Цикл
		Вид = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "ВидОплаты", "")));
		Сум = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Стр, "Сумма", 0);
		HTML = HTML + "<tr><td>" + Вид + "</td><td class=""num""><b>" + _ДетПак_ФорматСуммы(Сум) + "</b></td></tr>";
	КонецЦикла;
	HTML = HTML + "</tbody></table>";
	Возврат HTML;
КонецФункции

&НаСервере
Функция _ДетПак_ЗагрузитьСопоставления(ИдПакета)
	Результат = Новый Соответствие;
	Если Не ЗначениеЗаполнено(ИдПакета) Тогда Возврат Результат; КонецЕсли;
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ИсточникUUID, СсылкаОбъект
			|ИЗ РегистрСведений.TL_СоответствиеИсточников
			|ГДЕ ИдентификаторПоследнегоПакета = &Ид");
		Запрос.УстановитьПараметр("Ид", ИдПакета);
		В = Запрос.Выполнить().Выбрать();
		Пока В.Следующий() Цикл
			Результат.Вставить(СокрЛП(В.ИсточникUUID), В.СсылкаОбъект);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция _ДетПак_НайтиСверку(ИдПакета)
	Если Не ЗначениеЗаполнено(ИдПакета) Тогда Возврат Неопределено; КонецЕсли;
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 ВремяЗагрузки, Статус, СтрокДокументов, СуммаЦБ, СуммаБП
			|ИЗ РегистрСведений.TL_СверкаПакета
			|ГДЕ ИдентификаторПакета = &Ид
			|УПОРЯДОЧИТЬ ПО ВремяЗагрузки УБЫВ");
		Запрос.УстановитьПараметр("Ид", ИдПакета);
		В = Запрос.Выполнить().Выбрать();
		Если В.Следующий() Тогда
			Стр = Новый Структура("ВремяЗагрузки, Статус, СтрокДокументов, СуммаЦБ, СуммаБП",
				В.ВремяЗагрузки, В.Статус, В.СтрокДокументов, В.СуммаЦБ, В.СуммаБП);
			Возврат Стр;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция _ДетПак_НайтиОшибки(ИдПакета)
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(ИдПакета) Тогда Возврат Результат; КонецЕсли;
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ СообщениеОшибки, ТипОбъекта, КодОшибки, ЗначениеИсточника
			|ИЗ РегистрСведений.TL_ОшибкиЗагрузки
			|ГДЕ ИдентификаторПакета = &Ид
			|УПОРЯДОЧИТЬ ПО ВремяРегистрации УБЫВ");
		Запрос.УстановитьПараметр("Ид", ИдПакета);
		В = Запрос.Выполнить().Выбрать();
		Пока В.Следующий() Цикл
			Стр = Новый Структура("Сообщение, ТипОбъекта, КодОшибки, ЗначениеИсточника",
				В.СообщениеОшибки, Строка(В.ТипОбъекта), Строка(В.КодОшибки), В.ЗначениеИсточника);
			Результат.Добавить(Стр);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция _ДетПак_ШаблонОшибка(Текст)
	Возврат "<!DOCTYPE html><html><body style=""font-family:'Segoe UI',sans-serif;padding:20px;"">"
		+ "<div style=""background:#FEE2E2;color:#991B1B;padding:16px;border-radius:6px;border-left:4px solid #EF4444;"">"
		+ Текст + "</div></body></html>";
КонецФункции

