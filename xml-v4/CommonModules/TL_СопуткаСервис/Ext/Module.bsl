// Хеш отдельного документа в пакете — для отслеживания «пустых» повторов
// (если ЦБ перевыгрузил тот же документ без изменений). Простая функция:
// SHA-256 от сериализованного JSON-фрагмента документа.
//
Функция ВычислитьХешДокумента(Док)

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Док);
		Тело = ЗаписьJSON.Закрыть();

		Двоичные = ПолучитьДвоичныеДанныеИзСтроки(Тело, "UTF-8", Ложь);
		Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеш.Добавить(Двоичные);
		Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Извлечь контекст смены из шапки Смена{} пакета формата v2.
// Возвращает Структура {КодАЗС, СкладUUID, ОрганизацияUUID, НомерСмены,
//   Открытие (Дата), Закрытие (Дата), ДатаСмены (Дата), Оператор, Касса, ОСЭНомер}
// или Неопределено, если шапка Смена{} отсутствует (формат v1).
//
Функция ИзвлечьКонтекстСмены(Пакет)

	Смена = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Смена", Неопределено);
	Если Смена = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Контекст = Новый Структура;

	КодАЗС = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "КодАЗС", 0);
	Попытка
		Контекст.Вставить("КодАЗС", Число(КодАЗС));
	Исключение
		Контекст.Вставить("КодАЗС", 0);
	КонецПопытки;

	Контекст.Вставить("СкладUUID",       TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "СкладUUID", ""));
	Контекст.Вставить("ОрганизацияUUID", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "ОрганизацияUUID", ""));
	Контекст.Вставить("НомерСмены",      TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "НомерСмены", ""));

	Открытие = ПолучитьДатуИзJSON(Смена, "Открытие");
	Закрытие = ПолучитьДатуИзJSON(Смена, "Закрытие");
	Контекст.Вставить("Открытие", Открытие);
	Контекст.Вставить("Закрытие", Закрытие);
	// ДатаСмены = дата без времени из Открытия (для регистров с типом Date)
	Контекст.Вставить("ДатаСмены", ?(ЗначениеЗаполнено(Открытие), НачалоДня(Открытие), '00010101'));

	Контекст.Вставить("Оператор", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "Оператор", ""));
	Контекст.Вставить("Касса",    TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "Касса",    ""));
	Контекст.Вставить("ОСЭНомер", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "ОСЭНомер", ""));

	Возврат Контекст;

КонецФункции

// Построить Комментарий созданного документа БП: UX-подсказка о смене + технический хвост.
// Если КонтекстСмены пуст (старый формат v1) — оставляем только технический хвост.
//
Функция ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат)

	Технический = "TL|ЦБ|" + ИдентификаторПакета + "|" + ИсточникUUID;

	Если Результат = Неопределено Или Не Результат.Свойство("КонтекстСмены")
			Или Результат.КонтекстСмены = Неопределено Тогда
		Возврат Технический;
	КонецЕсли;

	К = Результат.КонтекстСмены;
	Префикс = "Смена АЗС" + Формат(К.КодАЗС, "ЧЦ=3; ЧВН=; ЧГ=0")
		+ " №" + СокрЛП(К.НомерСмены)
		+ " от " + Формат(К.ДатаСмены, "ДФ='dd.MM.yyyy'");

	Возврат Префикс + " | " + Технический;

КонецФункции

#КонецОбласти
