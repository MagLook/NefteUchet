// Найти связанные документы (Перемещения, Комплектации) по базовому ключу.
//
&НаСервере
Процедура ДобавитьСвязанныеДокументы(КлючБазовый, ЗагруженныеДокументы)
	Для Каждого КЗ Из ЗагруженныеДокументы Цикл
		Если СтрНачинаетсяС(КЗ.Ключ, КлючБазовый + "|") Тогда
			// Это дочерний документ (|ПЕРЕМ, |КОМПЛ, |cash|92 и т.д.)
			Инфо = КЗ.Значение;
			ТипДоч = ОпределитьТипПоКлючу(КЗ.Ключ);
			ОписДоч = ОпределитьОписаниеПоКлючу(КЗ.Ключ);

			Стр = ВнутренниеДанные.Добавить();
			Стр.Отметка              = Ложь;
			Стр.КлючЗагрузки        = КЗ.Ключ;
			Стр.КлючБазовый          = КлючБазовый;
			Стр.ТипДокумента         = "  " + ТипДоч;
			Стр.Описание             = "  " + ОписДоч;
			Стр.Статус               = Инфо.Статус;
			Стр.ДокументПредставление = Строка(Инфо.Ссылка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Нормализовать ответ API со списком смен (3 формата).
//
&НаСервере
Функция НормализоватьОтветСмен(ОтветСмены)

	Смены = Новый Массив;

	Если ТипЗнч(ОтветСмены) = Тип("Массив") Тогда
		Если ОтветСмены.Количество() > 0 Тогда
			Первый = ОтветСмены[0];
			Если ТипЗнч(Первый) = Тип("Соответствие") И Первый.Получить("shift") <> Неопределено Тогда
				Смены = ОтветСмены;
			ИначеЕсли ТипЗнч(Первый) = Тип("Соответствие") И Первый.Получить("shifts") <> Неопределено Тогда
				Вложенные = Первый.Получить("shifts");
				Если ТипЗнч(Вложенные) = Тип("Массив") Тогда
					Смены = Вложенные;
				КонецЕсли;
			Иначе
				Смены = ОтветСмены;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ОтветСмены) = Тип("Соответствие") Тогда
		Вложенные = ОтветСмены.Получить("shifts");
		Если ТипЗнч(Вложенные) = Тип("Массив") Тогда
			Смены = Вложенные;
		КонецЕсли;
	КонецЕсли;

	Возврат Смены;

КонецФункции

// Проверить наличие ненастроенных станций в API.
// Если найдены — записать предупреждение в лог с кодами.
//
&НаСервере
Процедура ПроверитьНенастроенныеСтанции(Токен)

	Попытка
		ВсеСтанции = TL_ApiКлиент.ПолучитьСписокСтанций(URLСервера, Токен, КодСистемы);
	Исключение
		Возврат;
	КонецПопытки;

	Если ВсеСтанции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Ненастроенные = Новый Массив;
	Для Каждого КодСт Из ВсеСтанции Цикл
		Склад = TL_Настройки.НайтиСкладСтанции(КодСт);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			Ненастроенные.Добавить(XMLСтрока(КодСт));
		КонецЕсли;
	КонецЦикла;

	Если Ненастроенные.Количество() > 0 Тогда
		ДобавитьВЛогСервер("Обнаружены ненастроенные станции: "
			+ СтрСоединить(Ненастроенные, ", ")
			+ ". Откройте Настройки расширения для подключения.");
	КонецЕсли;

КонецПроцедуры

// Определить тип документа по суффиксу ключа.
//
&НаСервере
Функция ОпределитьТипПоКлючу(Ключ)
	Если СтрНайти(Ключ, "|КОМПЛ") > 0 Тогда
		Возврат "Комплектация";
	ИначеЕсли СтрНайти(Ключ, "|ПЕРЕМ") > 0 Тогда
		Возврат "Перемещение";
	Иначе
		Возврат "Перемещение";
	КонецЕсли;
КонецФункции

// Определить описание по суффиксу ключа.
//
&НаСервере
Функция ОпределитьОписаниеПоКлючу(Ключ)
	Если СтрНайти(Ключ, "|КОМПЛ") > 0 Тогда
		Возврат "т → л";
	ИначеЕсли СтрНайти(Ключ, "|ПЕРЕМ") > 0 Тогда
		Возврат "→ АЗС";
	Иначе
		// Перемещение по оплате: ключ = TL|СМЕНА|65|5|91|online|2
		Части = СтрРазделить(Ключ, "|");
		Если Части.Количество() > 6 Тогда
			Канал = Части[Части.Количество() - 2];
			КодТопл = Части[Части.Количество() - 1];
			ИмяТопл = TL_Настройки.ПолучитьНаименованиеТоплива(КодТопл);
			Возврат "→ " + ВРег(Канал) + ", " + ИмяТопл;
		ИначеЕсли Части.Количество() > 5 Тогда
			Возврат "→ " + ВРег(Части[Части.Количество() - 2]);
		КонецЕсли;
		Возврат "→ склад";
	КонецЕсли;
КонецФункции

// Определить тип документа 1С по ссылке.
//
&НаСервере
Функция ОпределитьТипДокумента(ДокСсылка)
	ИмяТипа = Строка(ТипЗнч(ДокСсылка));
	Если СтрНайти(ИмяТипа, "Перемещение") > 0 Тогда
		Возврат "Перемещение";
	ИначеЕсли СтрНайти(ИмяТипа, "Комплектация") > 0 Тогда
		Возврат "Комплектация";
	ИначеЕсли СтрНайти(ИмяТипа, "Поступление") > 0 Тогда
		Возврат "ТТН";
	Иначе
		Возврат "Документ";
	КонецЕсли;
КонецФункции

// Определить описание дочернего документа.
//
&НаСервере
Функция ОпределитьОписаниеДочернего(ДокСсылка, ТипДоч)
	Если ТипДоч = "Комплектация" Тогда
		Возврат "т → л";
	ИначеЕсли ТипДоч = "Перемещение" Тогда
		Возврат "→ склад";
	Иначе
		Возврат Строка(ДокСсылка);
	КонецЕсли;
КонецФункции

// Найти ключ загрузки по ссылке документа (обратный поиск).
//
&НаСервере
Функция НайтиКлючПоДокументу(ДокСсылка)
	Попытка
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		Комментарий = ДокОбъект.Комментарий;
		ПозРазделителя = СтрНайти(Комментарий, " | ");
		Если ПозРазделителя > 0 Тогда
			Возврат Лев(Комментарий, ПозРазделителя - 1);
		КонецЕсли;
		Возврат СокрЛП(Комментарий);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Обновить HTML-дашборд (KPI-карточки).
//
&НаСервере
Процедура ОбновитьДашборд()

	ВсегоСмен = ВнешниеДанные.Количество() + ВнутренниеДанные.Количество();
	Загружено = ВнутренниеДанные.Количество();
	Новых = ВнешниеДанные.Количество();

	// Подсчёт ошибок (документы без ссылки или с проблемами)
	Ошибок = 0;

	// Сумма за период
	СуммаЗаПериод = 0;
	Для Каждого Стр Из ВнешниеДанные Цикл
		СуммаЗаПериод = СуммаЗаПериод + Стр.Сумма;
	КонецЦикла;
	Для Каждого Стр Из ВнутренниеДанные Цикл
		// Считаем только основные документы (Смена, ТТН), не дочерние
		Если Стр.ТипДокумента = "Смена" ИЛИ Стр.ТипДокумента = "ТТН" Тогда
			СуммаЗаПериод = СуммаЗаПериод + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;

	HTMLДашборд = TL_HTMLГенератор.СформироватьДашборд(ВсегоСмен, Загружено, Новых, Ошибок, СуммаЗаПериод);

КонецПроцедуры

