////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_РегистрСтатусов
// Расширение ElsyPlus Ledger для 1С:БП 3.0
// Контекст: Сервер, Экспорт
// Работа с регистром сведений TL_СтатусыЗагрузки.
//
// Заменяет хрупкий поиск по полю Комментарий документов.
// Если регистр не существует — fallback на поиск по Комментарию.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Зарегистрировать загрузку документа.
//
// Параметры:
//   КлючЗагрузки   - Строка - уникальный ключ "TL|СМЕНА|15|208|142"
//   ДокументСсылка  - ДокументСсылка - ссылка на созданный документ
//   ТипДокумента    - Строка - "Смена" или "ТТН"
//
Процедура ЗарегистрироватьЗагрузку(КлючЗагрузки, ДокументСсылка, ТипДокумента) Экспорт

	Попытка
		МенеджерЗаписи = РегистрыСведений.TL_СтатусыЗагрузки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КлючЗагрузки = КлючЗагрузки;
		// ДокументСсылка — поле отсутствует в живой базе, поиск через НайтиДокументПоКомментарию
		МенеджерЗаписи.Статус = "Загружен";
		МенеджерЗаписи.ДатаЗагрузки = ТекущаяДата();
		МенеджерЗаписи.ТипДокумента = ТипДокумента;
		МенеджерЗаписи.Записать();
	Исключение
		// Регистр не существует — пропускаем
		ЗаписьЖурналаРегистрации("TL_РегистрСтатусов",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось зарегистрировать загрузку: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Получить статус загрузки по ключу.
//
// Параметры:
//   КлючЗагрузки - Строка
//
// Возвращаемое значение:
//   Структура("ДокументСсылка, Статус, ДатаЗагрузки") или Неопределено
//
Функция ПолучитьСтатус(КлючЗагрузки) Экспорт

	// Единый источник истины — регистр TL_СтатусыЗагрузки.
	// Если ключа нет в регистре — документ не загружен.
	// Fallback по комментарию убран — он находил удалённые документы.
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Статус,
			|	ДатаЗагрузки
			|ИЗ
			|	РегистрСведений.TL_СтатусыЗагрузки
			|ГДЕ
			|	КлючЗагрузки = &КлючЗагрузки";

		Запрос.УстановитьПараметр("КлючЗагрузки", КлючЗагрузки);
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			ДокументСсылка = НайтиДокументПоКомментарию(КлючЗагрузки);
			Возврат Новый Структура("ДокументСсылка, Статус, ДатаЗагрузки",
				ДокументСсылка,
				Выборка.Статус,
				Выборка.ДатаЗагрузки);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Обновить статус загрузки.
//
// Параметры:
//   КлючЗагрузки - Строка
//   НовыйСтатус  - Строка - "Загружен", "Проведён"
//
Процедура ОбновитьСтатус(КлючЗагрузки, НовыйСтатус) Экспорт

	Попытка
		МенеджерЗаписи = РегистрыСведений.TL_СтатусыЗагрузки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КлючЗагрузки = КлючЗагрузки;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Статус = НовыйСтатус;
			МенеджерЗаписи.Записать();
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Получить все загруженные документы за период.
// Сначала из регистра TL_СтатусыЗагрузки, потом дополняет
// поиском по Комментарию (для документов, созданных до регистра).
//
// Параметры:
//   ДатаНачала    - Дата
//   ДатаОкончания - Дата
//
// Возвращаемое значение:
//   Соответствие - КлючЗагрузки → Структура("Ссылка, Статус")
//
Функция ПолучитьЗагруженныеДокументы(ДатаНачала, ДатаОкончания) Экспорт

	Результат = Новый Соответствие;

	// 1. Из регистра TL_СтатусыЗагрузки (без фильтра по дате —
	//    ДатаЗагрузки ≠ бизнес-дата смены, фильтр приводил к потере документов)
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КлючЗагрузки,
			|	Статус
			|ИЗ
			|	РегистрСведений.TL_СтатусыЗагрузки";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.КлючЗагрузки,
				Новый Структура("Ссылка, Статус", Неопределено, Выборка.Статус));
		КонецЦикла;
	Исключение
		// Регистр не существует — используем только fallback
	КонецПопытки;

	// Fallback по комментарию убран — регистр = единый источник истины.

	Возврат Результат;

КонецФункции

// Удалить запись о загрузке.
//
Процедура УдалитьЗапись(КлючЗагрузки) Экспорт

	Попытка
		МенеджерЗаписи = РегистрыСведений.TL_СтатусыЗагрузки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КлючЗагрузки = КлючЗагрузки;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Найти документ 1С по ключу загрузки.
// Сначала из регистра, потом по Комментарию.
//
// Возвращаемое значение:
//   ДокументСсылка или Неопределено
//
Функция НайтиДокументПоКлючу(КлючЗагрузки) Экспорт

	// 1. Из регистра
	Инфо = ПолучитьСтатус(КлючЗагрузки);
	Если Инфо <> Неопределено И ЗначениеЗаполнено(Инфо.ДокументСсылка) Тогда
		Возврат Инфо.ДокументСсылка;
	КонецЕсли;

	// 2. Fallback: по Комментарию
	Возврат НайтиДокументПоКомментарию(КлючЗагрузки);

КонецФункции

// Получить все документы пакета по базовому ключу (включая дочерние).
// Ищет записи регистра с ключами начинающимися на БазовыйКлюч.
//
// Возвращаемое значение:
//   Массив из Структура("Ключ, Ссылка, Статус")
//
Функция ПолучитьДокументыПоБазовомуКлючу(БазовыйКлюч) Экспорт

	Результат = Новый Массив;

	// 1. Из регистра TL_СтатусыЗагрузки
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КлючЗагрузки,
			|	Статус
			|ИЗ
			|	РегистрСведений.TL_СтатусыЗагрузки
			|ГДЕ
			|	КлючЗагрузки = &Ключ
			|	ИЛИ КлючЗагрузки ПОДОБНО &Маска
			|УПОРЯДОЧИТЬ ПО
			|	КлючЗагрузки";
		Запрос.УстановитьПараметр("Ключ", БазовыйКлюч);
		Запрос.УстановитьПараметр("Маска", БазовыйКлюч + "|%");
		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			ДокСсылка = НайтиДокументПоКлючу(Выборка.КлючЗагрузки);
			// Возвращаем запись ВСЕГДА — даже если документ не найден.
			// Нужно чтобы при удалении ключ из регистра тоже удалялся.
			Результат.Добавить(Новый Структура("Ключ, Ссылка, Статус",
				Выборка.КлючЗагрузки, ДокСсылка, Выборка.Статус));
		КонецЦикла;
	Исключение
	КонецПопытки;

	// 2. Fallback: поиск по комментарию (если регистр пуст)
	Если Результат.Количество() = 0 Тогда
		ДокСсылка = НайтиДокументПоКомментарию(БазовыйКлюч);
		Если ЗначениеЗаполнено(ДокСсылка) Тогда
			Результат.Добавить(Новый Структура("Ключ, Ссылка, Статус",
				БазовыйКлюч, ДокСсылка, "Загружен"));
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дополнить результат поиском по Комментарию документов (обратная совместимость).
//
Процедура ДополнитьИзКомментариев(Результат, ДатаНачала, ДатаОкончания)

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	""Смена"" КАК ТипИсточника,
			|	Т.Ссылка КАК Ссылка,
			|	Т.Комментарий КАК Комментарий,
			|	Т.Проведен КАК Проведен
			|ИЗ
			|	Документ.ОтчетОРозничныхПродажах КАК Т
			|ГДЕ
			|	Т.Комментарий ПОДОБНО ""TL|%""
			|	И Т.Дата >= &ДатаНачала
			|	И Т.Дата <= &ДатаОкончания
			|	И НЕ Т.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""ТТН"",
			|	Т.Ссылка,
			|	Т.Комментарий,
			|	Т.Проведен
			|ИЗ
			|	Документ.ПоступлениеТоваровУслуг КАК Т
			|ГДЕ
			|	Т.Комментарий ПОДОБНО ""TL|%""
			|	И Т.Дата >= &ДатаНачала
			|	И Т.Дата <= &ДатаОкончания
			|	И НЕ Т.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""Перемещение"",
			|	Т.Ссылка,
			|	Т.Комментарий,
			|	Т.Проведен
			|ИЗ
			|	Документ.ПеремещениеТоваров КАК Т
			|ГДЕ
			|	Т.Комментарий ПОДОБНО ""TL|%""
			|	И Т.Дата >= &ДатаНачала
			|	И Т.Дата <= &ДатаОкончания
			|	И НЕ Т.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""Комплектация"",
			|	Т.Ссылка,
			|	Т.Комментарий,
			|	Т.Проведен
			|ИЗ
			|	Документ.КомплектацияНоменклатуры КАК Т
			|ГДЕ
			|	Т.Комментарий ПОДОБНО ""TL|%""
			|	И Т.Дата >= &ДатаНачала
			|	И Т.Дата <= &ДатаОкончания
			|	И НЕ Т.ПометкаУдаления";

		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			// Извлечь ключ из комментария (до " | ")
			Комментарий = Выборка.Комментарий;
			Если Не ЗначениеЗаполнено(Комментарий) Тогда
				Продолжить;
			КонецЕсли;
			ПозРазделителя = СтрНайти(Комментарий, " | ");
			Если ПозРазделителя > 0 Тогда
				Ключ = Лев(Комментарий, ПозРазделителя - 1);
			Иначе
				Ключ = СокрЛП(Комментарий);
			КонецЕсли;

			Статус = ?(Выборка.Проведен, "Проведён", "Загружен");
			Инфо = Результат.Получить(Ключ);
			Если Инфо = Неопределено Тогда
				Результат.Вставить(Ключ,
					Новый Структура("Ссылка, Статус", Выборка.Ссылка, Статус));
			ИначеЕсли Не ЗначениеЗаполнено(Инфо.Ссылка) Тогда
				Инфо.Ссылка = Выборка.Ссылка;
				Если Не ЗначениеЗаполнено(Инфо.Статус) Тогда
					Инфо.Статус = Статус;
				КонецЕсли;
				Результат.Вставить(Ключ, Инфо);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Найти документ по комментарию (fallback).
//
Функция НайтиДокументПоКомментарию(КлючЗагрузки)

	Попытка
		Запрос = Новый Запрос;
		// Поиск по 6 типам документов с фильтром по комментарию.
		// Комментарий в БП 3.0 имеет тип Произвольный — нужен ВЫРАЗИТЬ
		// для сравнения. Используем ПОДОБНО с тремя шаблонами:
		//   - точное совпадение: КлючТочно (для дочерних типа TL|...|247|ПКО)
		//   - составной комментарий: "ключ | %" (для ОРП с описанием каналов)
		//   - ключ в конце: "% | ключ" (для СписаниеТоваров — "Тех. списание | TL|...")
		ШТочно = "ВЫРАЗИТЬ(Т.Комментарий КАК СТРОКА(200))";
		ВыражениеУсловия = "(" + ШТочно + " ПОДОБНО &КлючТочно ИЛИ "
			+ ШТочно + " ПОДОБНО &ШаблонВНачале ИЛИ "
			+ ШТочно + " ПОДОБНО &ШаблонВКонце) И НЕ Т.ПометкаУдаления";
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Документ.ОтчетОРозничныхПродажах КАК Т
			|ГДЕ " + ВыражениеУсловия + "
			|ОБЪЕДИНИТЬ ВСЕ
			|ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Документ.ПоступлениеТоваровУслуг КАК Т
			|ГДЕ " + ВыражениеУсловия + "
			|ОБЪЕДИНИТЬ ВСЕ
			|ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Документ.ПеремещениеТоваров КАК Т
			|ГДЕ " + ВыражениеУсловия + "
			|ОБЪЕДИНИТЬ ВСЕ
			|ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Документ.КомплектацияНоменклатуры КАК Т
			|ГДЕ " + ВыражениеУсловия + "
			|ОБЪЕДИНИТЬ ВСЕ
			|ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Документ.ПриходныйКассовыйОрдер КАК Т
			|ГДЕ " + ВыражениеУсловия + "
			|ОБЪЕДИНИТЬ ВСЕ
			|ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Документ.СписаниеТоваров КАК Т
			|ГДЕ " + ВыражениеУсловия;

		Запрос.УстановитьПараметр("КлючТочно", КлючЗагрузки);
		Запрос.УстановитьПараметр("ШаблонВНачале", КлючЗагрузки + " | %");
		Запрос.УстановитьПараметр("ШаблонВКонце", "% | " + КлючЗагрузки);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
