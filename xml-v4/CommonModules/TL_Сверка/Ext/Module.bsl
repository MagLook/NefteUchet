// ============================================================================

// Зафиксировать факт получения пакета (статус «Получен»).
// Вызывать в самом начале обработки.
//
// Параметры:
//   ИдентификаторПакета - Строка
//   Источник            - Строка - "ЭЛСИ.АЗК ЦБ"
//   ПериодС, ПериодПо   - Дата
//   КонтекстСмены       - Структура - {КодАЗС, НомерСмены, ДатаСмены, ОСЭНомер} (опц.)
//
Процедура ЗафиксироватьСтартПакета(ИдентификаторПакета, Источник, ПериодС = Неопределено,
	ПериодПо = Неопределено, КонтекстСмены = Неопределено) Экспорт

	Попытка
		МЗ = РегистрыСведений.TL_СверкаПакета.СоздатьМенеджерЗаписи();
		МЗ.ИдентификаторПакета = ИдентификаторПакета;
		МЗ.Прочитать();
		МЗ.ИдентификаторПакета = ИдентификаторПакета;
		МЗ.Источник = Источник;
		МЗ.ВремяЗагрузки = ТекущаяДата();
		Если ЗначениеЗаполнено(ПериодС) Тогда МЗ.ПериодС = ПериодС; КонецЕсли;
		Если ЗначениеЗаполнено(ПериодПо) Тогда МЗ.ПериодПо = ПериодПо; КонецЕсли;

		// Поля смены (формат пакета v2)
		Если ТипЗнч(КонтекстСмены) = Тип("Структура") Тогда
			Если КонтекстСмены.Свойство("КодАЗС") И ЗначениеЗаполнено(КонтекстСмены.КодАЗС) Тогда
				ЗаписатьРеквизитБезопасно(МЗ, "КодАЗС", КонтекстСмены.КодАЗС);
			КонецЕсли;
			Если КонтекстСмены.Свойство("НомерСмены") И ЗначениеЗаполнено(КонтекстСмены.НомерСмены) Тогда
				ЗаписатьРеквизитБезопасно(МЗ, "НомерСмены", КонтекстСмены.НомерСмены);
			КонецЕсли;
			Если КонтекстСмены.Свойство("ДатаСмены") И ЗначениеЗаполнено(КонтекстСмены.ДатаСмены) Тогда
				ЗаписатьРеквизитБезопасно(МЗ, "ДатаСмены", КонтекстСмены.ДатаСмены);
			КонецЕсли;
			Если КонтекстСмены.Свойство("ОСЭНомер") И ЗначениеЗаполнено(КонтекстСмены.ОСЭНомер) Тогда
				ЗаписатьРеквизитБезопасно(МЗ, "ОСЭНомер", КонтекстСмены.ОСЭНомер);
			КонецЕсли;
		КонецЕсли;

		МЗ.Статус = Перечисления.TL_СтатусПакета.Получен;
		МЗ.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("TL_Сверка",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось записать сверку пакета " + ИдентификаторПакета + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Безопасная запись реквизита регистра — если поле ещё не существует в БД
// (например, расширение накатано в файлы но F7 не сделан), не падать.
//
Процедура ЗаписатьРеквизитБезопасно(МенеджерЗаписи, ИмяРеквизита, Значение)
	Попытка
		МенеджерЗаписи[ИмяРеквизита] = Значение;
	Исключение
	КонецПопытки;
КонецПроцедуры

// Записать итоги сверки пакета.
// Вызывать в конце обработки.
//
// Параметры:
//   ИдентификаторПакета - Строка
//   Итоги               - Структура - см. РассчитатьИтоги()
//   Статус              - ПеречислениеСсылка.TL_СтатусПакета
//
Процедура ЗаписатьСверку(ИдентификаторПакета, Итоги, Статус, Комментарий = "") Экспорт

	Попытка
		МЗ = РегистрыСведений.TL_СверкаПакета.СоздатьМенеджерЗаписи();
		МЗ.ИдентификаторПакета = ИдентификаторПакета;
		МЗ.Прочитать();
		МЗ.ИдентификаторПакета = ИдентификаторПакета;

		Если Итоги.Свойство("Источник")        Тогда МЗ.Источник = Итоги.Источник; КонецЕсли;
		Если Итоги.Свойство("ПериодС")         Тогда МЗ.ПериодС = Итоги.ПериодС;   КонецЕсли;
		Если Итоги.Свойство("ПериодПо")        Тогда МЗ.ПериодПо = Итоги.ПериодПо; КонецЕсли;

		МЗ.ВремяЗагрузки   = ТекущаяДата();
		МЗ.СтрокНСИ        = ?(Итоги.Свойство("СтрокНСИ"), Итоги.СтрокНСИ, 0);
		МЗ.СтрокДокументов = ?(Итоги.Свойство("СтрокДокументов"), Итоги.СтрокДокументов, 0);
		МЗ.СуммаЦБ         = ?(Итоги.Свойство("СуммаЦБ"), Итоги.СуммаЦБ, 0);
		МЗ.НДС_ЦБ          = ?(Итоги.Свойство("НДС_ЦБ"), Итоги.НДС_ЦБ, 0);
		МЗ.СуммаБП         = ?(Итоги.Свойство("СуммаБП"), Итоги.СуммаБП, 0);
		МЗ.НДС_БП          = ?(Итоги.Свойство("НДС_БП"), Итоги.НДС_БП, 0);
		МЗ.Расхождение     = ?(Итоги.Свойство("Расхождение"), Итоги.Расхождение, 0);
		МЗ.Статус          = Статус;
		МЗ.Комментарий     = Лев(Комментарий, 500);
		МЗ.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("TL_Сверка",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Сбой записи итоговой сверки пакета " + ИдентификаторПакета + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Рассчитать итоги пакета: суммы и НДС со стороны ЦБ (из JSON) и со стороны БП
// (по созданным/обновлённым документам).
//
// Параметры:
//   Пакет     - Соответствие - десериализованный JSON
//   Документы - Массив ссылок - созданные/обновлённые документы БП
//
// Возвращаемое значение:
//   Структура - {
//     СтрокНСИ, СтрокДокументов,
//     СуммаЦБ, НДС_ЦБ, СуммаБП, НДС_БП, Расхождение
//   }
//
Функция РассчитатьИтоги(Пакет, Документы) Экспорт

	Итоги = Новый Структура(
		"СтрокНСИ, СтрокДокументов, СуммаЦБ, НДС_ЦБ, СуммаБП, НДС_БП, Расхождение",
		0, 0, 0, 0, 0, 0, 0);

	НСИ = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "НСИ", Неопределено);
	Если ТипЗнч(НСИ) = Тип("Массив") Тогда
		Итоги.СтрокНСИ = НСИ.Количество();
	КонецЕсли;

	ДокументыJSON = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Документы", Неопределено);
	Если ТипЗнч(ДокументыJSON) = Тип("Массив") Тогда
		Итоги.СтрокДокументов = ДокументыJSON.Количество();
		Для Каждого Док Из ДокументыJSON Цикл
			Сумма = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаДокумента", 0);
			НДС   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаНДС", 0);
			Итоги.СуммаЦБ = Итоги.СуммаЦБ + ?(ТипЗнч(Сумма) = Тип("Число"), Сумма, 0);
			Итоги.НДС_ЦБ  = Итоги.НДС_ЦБ  + ?(ТипЗнч(НДС) = Тип("Число"),   НДС,   0);
		КонецЦикла;
	КонецЕсли;

	// Со стороны БП: суммируем по созданным документам
	Для Каждого СсылкаДок Из Документы Цикл
		Если Не ЗначениеЗаполнено(СсылкаДок) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДок,
				"СуммаДокумента");
			Итоги.СуммаБП = Итоги.СуммаБП + ?(ЗначениеЗаполнено(Реквизиты.СуммаДокумента),
				Реквизиты.СуммаДокумента, 0);
		Исключение
			// Если ОбщегоНазначения недоступно — читаем напрямую через Объект
			Попытка
				Объект = СсылкаДок.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Итоги.СуммаБП = Итоги.СуммаБП + Объект.СуммаДокумента;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецПопытки;

		// НДС суммируем по табличной части Товары
		Попытка
			Запрос = Новый Запрос(
				"ВЫБРАТЬ
				|	СУММА(Т.СуммаНДС) КАК НДС
				|ИЗ
				|	Документ.ПоступлениеТоваровУслуг.Товары КАК Т
				|ГДЕ
				|	Т.Ссылка = &Ссылка");
			Запрос.УстановитьПараметр("Ссылка", СсылкаДок);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.НДС) Тогда
				Итоги.НДС_БП = Итоги.НДС_БП + Выборка.НДС;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Итоги.Расхождение = Итоги.СуммаЦБ - Итоги.СуммаБП;

	Возврат Итоги;

КонецФункции

// Определить итоговый статус пакета на основе количества созданных документов и ошибок.
// Контракт §11.3.
//
// Параметры:
//   КоличествоДокументов - Число - сколько успешно создано/обновлено
//   КоличествоОшибок     - Число - сколько ошибок маппинга
//   ВсегоВПакете         - Число - сколько документов было в исходном пакете
//
// Возвращаемое значение:
//   ПеречислениеСсылка.TL_СтатусПакета
//
Функция ОпределитьСтатусПакета(КоличествоДокументов, КоличествоОшибок, ВсегоВПакете) Экспорт

	Если ВсегоВПакете = 0 Тогда
		// Пакет без документов — НСИ-only, технически принят
		Возврат Перечисления.TL_СтатусПакета.ПринятоЦеликом;
	КонецЕсли;

	Если КоличествоДокументов = ВсегоВПакете И КоличествоОшибок = 0 Тогда
		Возврат Перечисления.TL_СтатусПакета.ПринятоЦеликом;
	ИначеЕсли КоличествоДокументов > 0 Тогда
		Возврат Перечисления.TL_СтатусПакета.ПринятоЧастично;
	Иначе
		Возврат Перечисления.TL_СтатусПакета.Отклонено;
	КонецЕсли;

КонецФункции

// ============================================================================
//  ЖУРНАЛ ОШИБОК
// ============================================================================

// Записать ошибку в TL_ОшибкиЗагрузки.
// Контракт §12.
//
// Параметры:
//   Параметры - Структура - {
//     ИдентификаторПакета  (обяз.),
//     ИсточникUUID         (обяз.),
//     ТипОбъекта           - ПеречислениеСсылка.TL_ТипОбъектаИсточника,
//     Поле                 - ПеречислениеСсылка.TL_ПолеОшибки,
//     КодОшибки            - ПеречислениеСсылка.TL_КодОшибкиЗагрузки,
//     ЗначениеИсточника    - Строка,
//     СообщениеОшибки      - Строка,
//     Документ             - Произвольный (опц.)
//   }
//
Процедура ЗаписатьОшибку(Параметры) Экспорт

	Попытка
		// Подсчитать следующий номер записи в пакете
		Запрос = Новый Запрос(
			"ВЫБРАТЬ МАКСИМУМ(Т.НомерЗаписи) КАК Макс
			|ИЗ РегистрСведений.TL_ОшибкиЗагрузки КАК Т
			|ГДЕ Т.ИдентификаторПакета = &Пакет");
		Запрос.УстановитьПараметр("Пакет", Параметры.ИдентификаторПакета);
		Выборка = Запрос.Выполнить().Выбрать();
		НомерЗаписи = 1;
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Макс) Тогда
			НомерЗаписи = Выборка.Макс + 1;
		КонецЕсли;

		МЗ = РегистрыСведений.TL_ОшибкиЗагрузки.СоздатьМенеджерЗаписи();
		МЗ.ИдентификаторПакета = Параметры.ИдентификаторПакета;
		МЗ.НомерЗаписи         = НомерЗаписи;
		МЗ.ИсточникUUID        = Лев(СтрокоеЗначение(Параметры, "ИсточникUUID"), 36);
		МЗ.ТипОбъекта          = ПолучитьЗначение(Параметры, "ТипОбъекта",
			Перечисления.TL_ТипОбъектаИсточника.ПустаяСсылка());
		МЗ.Поле                = ПолучитьЗначение(Параметры, "Поле",
			Перечисления.TL_ПолеОшибки.Прочее);
		МЗ.КодОшибки           = ПолучитьЗначение(Параметры, "КодОшибки",
			Перечисления.TL_КодОшибкиЗагрузки.Прочее);
		МЗ.ЗначениеИсточника   = Лев(СтрокоеЗначение(Параметры, "ЗначениеИсточника"), 200);
		МЗ.СообщениеОшибки     = Лев(СтрокоеЗначение(Параметры, "СообщениеОшибки"), 500);
		МЗ.ВремяРегистрации    = ТекущаяДата();
		Если Параметры.Свойство("Документ") И ЗначениеЗаполнено(Параметры.Документ) Тогда
			МЗ.Документ = Параметры.Документ;
		КонецЕсли;
		МЗ.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("TL_Сверка",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Сбой записи в TL_ОшибкиЗагрузки: " + ОписаниеОшибки()
			+ Символы.ПС + "Параметры: " + ОписаниеПараметровДляЛога(Параметры));
	КонецПопытки;

КонецПроцедуры

// Сводка недостающей НСИ — дедуплицированный список того, что бухгалтеру надо
// завести в БП ГИГ (по журналу TL_ОшибкиЗагрузки). Одна и та же недостающая НСИ
// по многим сменам схлопывается в одну строку с подсчётом смен/записей — чтобы
// бухгалтер видел уникальные задачи и приоритет (по скольким сменам блокирует).
// Канал НЕ создаёт НСИ сам — только показывает, чего не хватает.
//
// Параметры:
//   НачалоПериода - Дата - фильтр по ВремяРегистрации (Неопределено = весь журнал)
//   КонецПериода  - Дата
//
// Возвращаемое значение:
//   ТаблицаЗначений (ТипОбъекта, КодОшибки, Значение, Сообщение, КолСмен, КолЗаписей),
//   отсортированная по убыванию числа затронутых смен.
//
Функция ПолучитьСводкуНедостающейНСИ(НачалоПериода = Неопределено, КонецПериода = Неопределено) Экспорт

	БезПериода = (НачалоПериода = Неопределено);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОшЗ.ТипОбъекта КАК ТипОбъекта,
	|	ОшЗ.КодОшибки КАК КодОшибки,
	|	ОшЗ.СообщениеОшибки КАК Сообщение,
	|	МАКСИМУМ(ОшЗ.ЗначениеИсточника) КАК Значение,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОшЗ.ИдентификаторПакета) КАК КолСмен,
	|	КОЛИЧЕСТВО(*) КАК КолЗаписей
	|ИЗ
	|	РегистрСведений.TL_ОшибкиЗагрузки КАК ОшЗ
	|ГДЕ
	|	(&БезПериода ИЛИ ОшЗ.ВремяРегистрации МЕЖДУ &НП И &КП)
	|СГРУППИРОВАТЬ ПО
	|	ОшЗ.ТипОбъекта, ОшЗ.КодОшибки, ОшЗ.СообщениеОшибки
	|УПОРЯДОЧИТЬ ПО
	|	КолСмен УБЫВ, Сообщение";
	Запрос.УстановитьПараметр("БезПериода", БезПериода);
	Запрос.УстановитьПараметр("НП", ?(БезПериода, '00010101', НачалоДня(НачалоПериода)));
	Запрос.УстановитьПараметр("КП",
		?(БезПериода, '39991231', КонецДня(?(КонецПериода = Неопределено, НачалоПериода, КонецПериода))));

	Таб = Новый ТаблицаЗначений;
	Таб.Колонки.Добавить("ТипОбъекта", Новый ОписаниеТипов("Строка"));
	Таб.Колонки.Добавить("КодОшибки",  Новый ОписаниеТипов("Строка"));
	Таб.Колонки.Добавить("Значение",   Новый ОписаниеТипов("Строка"));
	Таб.Колонки.Добавить("Сообщение",  Новый ОписаниеТипов("Строка"));
	Таб.Колонки.Добавить("КолСмен",    Новый ОписаниеТипов("Число"));
	Таб.Колонки.Добавить("КолЗаписей", Новый ОписаниеТипов("Число"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Таб.Добавить();
		Стр.ТипОбъекта = Строка(Выборка.ТипОбъекта);
		Стр.КодОшибки  = Строка(Выборка.КодОшибки);
		Стр.Значение   = Строка(Выборка.Значение);
		Стр.Сообщение  = Строка(Выборка.Сообщение);
		Стр.КолСмен    = Выборка.КолСмен;
		Стр.КолЗаписей = Выборка.КолЗаписей;
	КонецЦикла;

	Возврат Таб;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьЗначение(Структура, Ключ, Умолчание)
	Если Структура.Свойство(Ключ) И ЗначениеЗаполнено(Структура[Ключ]) Тогда
		Возврат Структура[Ключ];
	КонецЕсли;
	Возврат Умолчание;
КонецФункции

Функция СтрокоеЗначение(Структура, Ключ, Умолчание = "")
	Если Структура.Свойство(Ключ) Тогда
		Возврат Строка(Структура[Ключ]);
	КонецЕсли;
	Возврат Умолчание;
КонецФункции

Функция ОписаниеПараметровДляЛога(Параметры)
	Текст = "";
	Для Каждого КЗ Из Параметры Цикл
		Текст = Текст + КЗ.Ключ + "=" + Лев(Строка(КЗ.Значение), 80) + "; ";
	КонецЦикла;
	Возврат Лев(Текст, 400);
КонецФункции

#КонецОбласти
