Процедура ЗагрузитьНастройки()
	URLСервера = TL_Настройки.ПолучитьЗначение("URLСервера", "");
	Логин      = TL_Настройки.ПолучитьЗначение("Логин", "");
	Пароль     = TL_Настройки.ПолучитьЗначение("Пароль", "");
