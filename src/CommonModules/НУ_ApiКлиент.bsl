#Область ПрограммныйИнтерфейс

// Получает JWT-токен авторизации в API STS.
//
// Параметры:
//   URLСервера  - Строка - базовый URL API (https://pos.autooplata.ru/tms)
//   Логин       - Строка - имя пользователя API
//   Пароль      - Строка - пароль API
//
// Возвращаемое значение:
//   Строка - JWT-токен или Неопределено при ошибке
//
Функция ПолучитьТокен(URLСервера, Логин, Пароль) Экспорт

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("login", Логин);
	ТелоЗапроса.Вставить("password", Пароль);

	Ответ = ВыполнитьЗапросHTTP(URLСервера, "POST", "/v2/login", , ТелоЗапроса);

	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Ответ.Свойство("token") Тогда
		Возврат Ответ.token;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Получает список смен за период.
//
// Параметры:
//   Подключение - Структура - (URLСервера, Токен)
//   Система     - Число    - код системы (сети АЗС), ГИГ = 65
//   Станция     - Число    - код станции (0 = все)
//   ДатаНачала  - Дата     - начало периода
//   ДатаОкончания - Дата   - конец периода
//
// Возвращаемое значение:
//   Массив - массив структур с данными смен
//
Функция ПолучитьСписокСмен(Подключение, Система, Станция = 0, ДатаНачала = Неопределено, ДатаОкончания = Неопределено) Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("system", Формат(Система, "ЧГ=0"));

	Если Станция > 0 Тогда
		Параметры.Вставить("station", Формат(Станция, "ЧГ=0"));
	КонецЕсли;

	Если ДатаНачала <> Неопределено Тогда
		Параметры.Вставить("dt_beg", Формат(ДатаНачала, "ДФ=yyyy-MM-dd"));
	КонецЕсли;

	Если ДатаОкончания <> Неопределено Тогда
		Параметры.Вставить("dt_end", Формат(ДатаОкончания, "ДФ=yyyy-MM-dd"));
	КонецЕсли;

	Возврат ВыполнитьЗапросHTTP(Подключение.URLСервера, "GET", "/v1/shifts", Подключение.Токен, , Параметры);

КонецФункции

// Получает полный сменный отчёт.
//
// Параметры:
//   Подключение - Структура - (URLСервера, Токен)
