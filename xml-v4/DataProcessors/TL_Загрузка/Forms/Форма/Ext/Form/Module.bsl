// === Сбор метрик СОПУТКИ ===
&НаСервере
Функция МетрикиСопутка()
	M = Новый Структура;
	M.Вставить("КолПТУ",         0);
	M.Вставить("КолОРП",         0);
	M.Вставить("КолВозврат",     0);
	M.Вставить("НовыхПакетов",   0);
	M.Вставить("Ошибок",         0);
	M.Вставить("СуммаЗаПериод",  0);
	M.Вставить("КаталогДоступен", Ложь);
	M.Вставить("ОписаниеКанала", "");
	M.Вставить("HTMLСверкаПакетов", "");

	ДатаОт = НачалоДня(ДатаНачала);
	ДатаДо = КонецДня(ДатаОкончания);

	// Документы по маркеру TL|ЦБ| в Комментарии
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К, ЕстьNULL(СУММА(СуммаДокумента), 0) КАК Сум "
			+ "ИЗ Документ.ПоступлениеТоваровУслуг "
			+ "ГДЕ Дата МЕЖДУ &ДатаОт И &ДатаДо И ВЫРАЗИТЬ(Комментарий КАК СТРОКА(200)) ПОДОБНО ""TL|ЦБ|%""");
		Запрос.УстановитьПараметр("ДатаОт", ДатаОт);
		Запрос.УстановитьПараметр("ДатаДо", ДатаДо);
		В = Запрос.Выполнить().Выбрать();
		Если В.Следующий() Тогда
			M.КолПТУ = В.К;
			M.СуммаЗаПериод = M.СуммаЗаПериод + В.Сум;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К, ЕстьNULL(СУММА(СуммаДокумента), 0) КАК Сум "
			+ "ИЗ Документ.ОтчетОРозничныхПродажах "
			+ "ГДЕ Дата МЕЖДУ &ДатаОт И &ДатаДо И ВЫРАЗИТЬ(Комментарий КАК СТРОКА(200)) ПОДОБНО ""TL|ЦБ|%""");
		Запрос.УстановитьПараметр("ДатаОт", ДатаОт);
		Запрос.УстановитьПараметр("ДатаДо", ДатаДо);
		В = Запрос.Выполнить().Выбрать();
		Если В.Следующий() Тогда
			M.КолОРП = В.К;
			M.СуммаЗаПериод = M.СуммаЗаПериод + В.Сум;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К "
			+ "ИЗ Документ.КорректировкаПоступления "
			+ "ГДЕ Дата МЕЖДУ &ДатаОт И &ДатаДо И ВЫРАЗИТЬ(Комментарий КАК СТРОКА(200)) ПОДОБНО ""TL|ЦБ|%""");
		Запрос.УстановитьПараметр("ДатаОт", ДатаОт);
		Запрос.УстановитьПараметр("ДатаДо", ДатаДо);
		В = Запрос.Выполнить().Выбрать();
		Если В.Следующий() Тогда
			M.КолВозврат = В.К;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Ошибки TL_ОшибкиЗагрузки за период
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрСведений.TL_ОшибкиЗагрузки "
			+ "ГДЕ Период МЕЖДУ &ДатаОт И &ДатаДо");
		Запрос.УстановитьПараметр("ДатаОт", ДатаОт);
		Запрос.УстановитьПараметр("ДатаДо", ДатаДо);
		В = Запрос.Выполнить().Выбрать();
		Если В.Следующий() Тогда
			M.Ошибок = В.К;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Каталог OwnCloud и новые пакеты Сопутки
	Попытка
		КаталогПуть = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
		Если ЗначениеЗаполнено(КаталогПуть) Тогда
			Ф = Новый Файл(КаталогПуть);
			M.КаталогДоступен = Ф.Существует();
			M.ОписаниеКанала = КаталогПуть;
			Если M.КаталогДоступен Тогда
				СписокKind = Новый Массив;
				СписокKind.Добавить("purchase");
				СписокKind.Добавить("retail_sale_sidegoods");
				СписокKind.Добавить("return_purchase");
				ТЗ = TL_HTTPКлиентЦБ.ПолучитьСписокНовыхПакетов(КаталогПуть, Ложь, СписокKind);
				M.НовыхПакетов = ТЗ.Количество();
			КонецЕсли;
		Иначе
			M.ОписаниеКанала = "Путь не задан в TL_Настройки.КаталогOwnCloud_ЦБ";
		КонецЕсли;
	Исключение
	КонецПопытки;

	// HTML блок сверки пакетов
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего, "
			+ "  СУММА(ВЫБОР КОГДА Статус = &СтЦел ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Цел, "
			+ "  СУММА(ВЫБОР КОГДА Статус = &СтЧаст ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Част, "
			+ "  ЕстьNULL(СУММА(Расхождение), 0) КАК РасхСумма "
			+ "ИЗ РегистрСведений.TL_СверкаПакета "
			+ "ГДЕ ВремяЗагрузки МЕЖДУ &ДатаОт И &ДатаДо");
		Запрос.УстановитьПараметр("ДатаОт", ДатаОт);
		Запрос.УстановитьПараметр("ДатаДо", ДатаДо);
		Запрос.УстановитьПараметр("СтЦел", Перечисления.TL_СтатусПакета.ПринятоЦеликом);
		Запрос.УстановитьПараметр("СтЧаст", Перечисления.TL_СтатусПакета.ПринятоЧастично);
		В = Запрос.Выполнить().Выбрать();
		Если В.Следующий() И В.Всего > 0 Тогда
			M.HTMLСверкаПакетов = "<div style=""line-height:1.6;"">"
				+ "<div><b>Всего пакетов:</b> " + Формат(В.Всего, "ЧН=0") + "</div>"
				+ "<div><span style=""color:#16A34A;"">●</span> Целиком: " + Формат(В.Цел, "ЧН=0") + "</div>"
				+ "<div><span style=""color:#F59E0B;"">●</span> Частично: " + Формат(В.Част, "ЧН=0") + "</div>"
				+ "<div style=""color:" + ?(В.РасхСумма > 0.01, "#EF4444", "#16A34A") + ";"">"
				+ "<b>Расхождение:</b> " + ФорматСуммыКомпакт(В.РасхСумма) + "</div>"
				+ "</div>";
		Иначе
			M.HTMLСверкаПакетов = "<div style=""color:#CBD5E1;"">Нет пакетов за период</div>";
		КонецЕсли;
	Исключение
		M.HTMLСверкаПакетов = "<div style=""color:#CBD5E1;"">Регистр TL_СверкаПакета недоступен</div>";
	КонецПопытки;

	Возврат M;
КонецФункции


// === Сбор метрик ОБЩЕПИТА ===
&НаСервере
Функция МетрикиОбщепит()
	M = Новый Структура;
	M.Вставить("КолОПЗС",          0);
	M.Вставить("СтрокПродукции",   0);
	M.Вставить("СтрокИнгредиентов",0);
	M.Вставить("НовыхПакетов",     0);
	M.Вставить("Ошибок",           0);
	M.Вставить("СуммаСырья",       0);
	M.Вставить("КаталогДоступен",  Ложь);
	M.Вставить("ОписаниеКанала",   "");
	M.Вставить("HTMLОстатки",      "");

	ДатаОт = НачалоДня(ДатаНачала);
	ДатаДо = КонецДня(ДатаОкончания);

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОПЗС.Ссылка) КАК Док, "
			+ "  ЕстьNULL(СУММА(ОПЗСМат.Количество), 0) КАК КолМат, "
			+ "  ЕстьNULL(СУММА(ОПЗСПрод.Количество), 0) КАК КолПрод, "
			+ "  ЕстьNULL(СУММА(ОПЗСМат.Себестоимость), 0) КАК СумСырья "
			+ "ИЗ Документ.ОтчетПроизводстваЗаСмену КАК ОПЗС "
			+ "  ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетПроизводстваЗаСмену.Материалы КАК ОПЗСМат "
			+ "    ПО ОПЗСМат.Ссылка = ОПЗС.Ссылка "
			+ "  ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетПроизводстваЗаСмену.Продукция КАК ОПЗСПрод "
			+ "    ПО ОПЗСПрод.Ссылка = ОПЗС.Ссылка "
			+ "ГДЕ ОПЗС.Дата МЕЖДУ &ДатаОт И &ДатаДо "
			+ "  И ВЫРАЗИТЬ(ОПЗС.Комментарий КАК СТРОКА(200)) ПОДОБНО ""TL|ЦБ|%""");
		Запрос.УстановитьПараметр("ДатаОт", ДатаОт);
		Запрос.УстановитьПараметр("ДатаДо", ДатаДо);
		В = Запрос.Выполнить().Выбрать();
		Если В.Следующий() Тогда
			M.КолОПЗС = В.Док;
			M.СтрокПродукции = В.КолПрод;
			M.СтрокИнгредиентов = В.КолМат;
			M.СуммаСырья = В.СумСырья;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрСведений.TL_ОшибкиЗагрузки "
			+ "ГДЕ Период МЕЖДУ &ДатаОт И &ДатаДо");
		Запрос.УстановитьПараметр("ДатаОт", ДатаОт);
		Запрос.УстановитьПараметр("ДатаДо", ДатаДо);
		В = Запрос.Выполнить().Выбрать();
		Если В.Следующий() Тогда
			M.Ошибок = В.К;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Каталог OwnCloud и новые пакеты Общепита
	Попытка
		КаталогПуть = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
		Если ЗначениеЗаполнено(КаталогПуть) Тогда
			Ф = Новый Файл(КаталогПуть);
			M.КаталогДоступен = Ф.Существует();
			M.ОписаниеКанала = КаталогПуть;
			Если M.КаталогДоступен Тогда
				СписокKind = Новый Массив;
				СписокKind.Добавить("production_release");
				ТЗ = TL_HTTPКлиентЦБ.ПолучитьСписокНовыхПакетов(КаталогПуть, Ложь, СписокKind);
				M.НовыхПакетов = ТЗ.Количество();
			КонецЕсли;
		Иначе
			M.ОписаниеКанала = "Путь не задан в TL_Настройки.КаталогOwnCloud_ЦБ";
		КонецЕсли;
	Исключение
	КонецПопытки;

	// HTML блок остатков по 44.01 и 41.02 (общая сумма)
	Попытка
		Сч4401 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("44.01");
		Сч4102 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.02");
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ЕстьNULL(СУММА(СуммаОстатокДт - СуммаОстатокКт), 0) КАК Сум "
			+ "ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет = &Счёт)");
		Запрос.УстановитьПараметр("Счёт", Сч4401);
		В = Запрос.Выполнить().Выбрать(); В.Следующий();
		Сум4401 = В.Сум;
		Запрос.УстановитьПараметр("Счёт", Сч4102);
		В = Запрос.Выполнить().Выбрать(); В.Следующий();
		Сум4102 = В.Сум;
		M.HTMLОстатки = "<div style=""line-height:1.7;"">"
			+ "<div><b>44.01 (издержки):</b> " + ФорматСуммыКомпакт(Сум4401) + "</div>"
			+ "<div><b>41.02 (товары/сырьё):</b> " + ФорматСуммыКомпакт(Сум4102) + "</div>"
			+ "</div>";
	Исключение
		M.HTMLОстатки = "<div style=""color:#CBD5E1;"">Остатки недоступны</div>";
	КонецПопытки;

	Возврат M;
КонецФункции


// === Универсальный конструктор дашборда (4 колонки) ===
&НаСервере
Функция СформироватьДашбордКастом(ЗаголовокРежима, ЗаголовокКанала, СтатусКанала,
	КаналДоступен, ОписаниеКанала, ЗаголовокОстатков, HTMLОстатки, KPIМассив, ЛогТекст)

	СтильПанели = "background:#fff; border:1px solid #E2E8F0; border-radius:6px; padding:6px 10px;";

	HTML = "<!DOCTYPE html><html><head><meta charset=""utf-8""></head>"
		+ "<body style=""margin:0; padding:6px 8px; font-family:-apple-system,'Segoe UI',sans-serif;"
		+ " background:#F0F4F8; font-size:12px;"">"
		+ "<div style=""display:flex; gap:6px; height:100%;"">";

	// КОЛОНКА 1: KPI (25%), 3x2 сетка
	HTML = HTML + "<div style=""width:25%; " + СтильПанели + " display:flex; flex-direction:column;"">"
		+ "<div style=""font-size:10px; color:#94A3B8; font-weight:600; margin-bottom:5px; text-transform:uppercase; letter-spacing:0.5px;"">KPI · "
		+ Экранировать(ЗаголовокРежима) + "</div>"
		+ "<div style=""display:grid; grid-template-columns:1fr 1fr 1fr; grid-template-rows:1fr 1fr; gap:4px; flex:1;"">";
	Для Каждого K Из KPIМассив Цикл
		HTML = HTML + K;
	КонецЦикла;
	HTML = HTML + "</div></div>";

	// КОЛОНКА 2: Канал (20%)
	ЦветК = ?(КаналДоступен, "#16A34A", "#EF4444");
	HTML = HTML + "<div style=""width:20%; " + СтильПанели + """>"
		+ "<div style=""font-size:10px; color:#94A3B8; font-weight:600; margin-bottom:4px; text-transform:uppercase; letter-spacing:0.5px;"">"
		+ Экранировать(ЗаголовокКанала) + "</div>"
		+ "<div style=""margin-bottom:3px;""><span style=""color:" + ЦветК + "; font-size:14px;"">&#9679;</span> "
		+ "<span style=""color:#475569; font-size:11px;"">" + Экранировать(СтатусКанала) + "</span></div>"
		+ "<div style=""color:#64748B; font-size:10px; line-height:1.4; word-break:break-all;"">"
		+ Экранировать(ОписаниеКанала) + "</div>"
		+ "</div>";

	// КОЛОНКА 3: Остатки (25%)
	HTML = HTML + "<div style=""width:25%; " + СтильПанели + """>"
		+ "<div style=""font-size:10px; color:#94A3B8; font-weight:600; margin-bottom:5px; text-transform:uppercase; letter-spacing:0.5px;"">"
		+ Экранировать(ЗаголовокОстатков) + "</div>"
		+ HTMLОстатки + "</div>";

	// КОЛОНКА 4: ЛОГ (30%)
	HTML = HTML + "<div style=""width:30%; " + СтильПанели
		+ " font-family:Consolas,'Courier New',monospace; font-size:10px;"">"
		+ "<div style=""font-size:10px; color:#94A3B8; font-weight:600; margin-bottom:4px; text-transform:uppercase; letter-spacing:0.5px; font-family:-apple-system,'Segoe UI',sans-serif;"">Лог</div>";
	Если ЗначениеЗаполнено(ЛогТекст) Тогда
		Строки = СтрРазделить(ЛогТекст, Символы.ПС);
		МаксСтрок = ?(Строки.Количество() > 6, 6, Строки.Количество());
		Для Инд = 0 По МаксСтрок - 1 Цикл
			Стр = Строки[Инд];
			Если Не ЗначениеЗаполнено(Стр) Тогда Продолжить; КонецЕсли;
			Если СтрНайти(НРег(Стр), "ошибка") > 0 ИЛИ СтрНайти(НРег(Стр), "error") > 0 Тогда
				ЦветЛог = "#EF4444";
			ИначеЕсли СтрНайти(НРег(Стр), "ok") > 0 ИЛИ СтрНайти(НРег(Стр), "загружен") > 0 ИЛИ СтрНайти(НРег(Стр), "проведен") > 0 Тогда
				ЦветЛог = "#16A34A";
			Иначе
				ЦветЛог = "#94A3B8";
			КонецЕсли;
			HTML = HTML + "<div style=""color:#475569; line-height:1.4; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"">"
				+ "<span style=""color:" + ЦветЛог + ";"">&#9679;</span> " + Экранировать(Стр) + "</div>";
		КонецЦикла;
	Иначе
		HTML = HTML + "<div style=""color:#CBD5E1;"">Нет записей</div>";
	КонецЕсли;
	HTML = HTML + "</div>";

	HTML = HTML + "</div></body></html>";
	Возврат HTML;

КонецФункции


&НаСервере
Функция KPIКарточка(Значение, Подпись, Цвет)
	Возврат "<div style=""background:#F8FAFC; border-radius:4px; padding:4px 6px; text-align:center; display:flex; flex-direction:column; justify-content:center;"">"
		+ "<div style=""font-size:16px; font-weight:700; color:" + Цвет + "; line-height:1;"">" + Экранировать(Значение) + "</div>"
		+ "<div style=""font-size:9px; color:#94A3B8; margin-top:2px; text-transform:uppercase; letter-spacing:0.3px;"">" + Экранировать(Подпись) + "</div>"
		+ "</div>";
КонецФункции


&НаСервере
Функция ФорматСуммыКомпакт(Сумма)
	Если Сумма >= 1000000 Тогда
		Возврат Формат(Сумма / 1000000, "ЧДЦ=1") + " М";
	ИначеЕсли Сумма >= 1000 Тогда
		Возврат Формат(Сумма / 1000, "ЧДЦ=0") + " К";
	КонецЕсли;
	Возврат Формат(Сумма, "ЧДЦ=0; ЧРГ=' '");
КонецФункции


&НаСервере
Функция Экранировать(Текст)
	Т = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Т = СтрЗаменить(Т, "<", "&lt;");
	Т = СтрЗаменить(Т, ">", "&gt;");
	Т = СтрЗаменить(Т, """", "&quot;");
	Возврат Т;
КонецФункции

// Получить HTML с остатками на складе АКЗС (41.02, литры).
//
&НаСервере
Функция ПолучитьОстаткиСкладаHTML()

	Попытка
		НаимСклада = TL_Настройки.ПолучитьЗначение("Станция_" + XMLСтрока(КодСтанции) + "_Склад", "");
		Если Не ЗначениеЗаполнено(НаимСклада) Тогда
			Возврат "";
		КонецЕсли;

		Склад = Справочники.Склады.НайтиПоНаименованию(НаимСклада, Истина);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			Возврат "";
		КонецЕсли;

		Счёт4102 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.02");

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Субконто1.Наименование КАК Номенклатура,
			|	КоличествоОстатокДт КАК Количество
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет = &Счет, , Субконто2 = &Склад) КАК Остатки
			|ГДЕ
			|	КоличествоОстатокДт > 0
			|УПОРЯДОЧИТЬ ПО
			|	Номенклатура";
		Запрос.УстановитьПараметр("Счет", Счёт4102);
		Запрос.УстановитьПараметр("Склад", Склад);

		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();

		HTML = "";
		Пока Выборка.Следующий() Цикл
			Наим = Строка(Выборка.Номенклатура);
			Кол = Выборка.Количество;

			// Цвет бара по типу топлива
			Если СтрНайти(НРег(Наим), "92") > 0 Тогда
				ЦветБара = "#c8a820";
			ИначеЕсли СтрНайти(НРег(Наим), "95") > 0 Тогда
				ЦветБара = "#3070c0";
			ИначеЕсли СтрНайти(НРег(Наим), "дт") > 0 ИЛИ СтрНайти(НРег(Наим), "дизель") > 0 Тогда
				ЦветБара = "#30a040";
			Иначе
				ЦветБара = "#94A3B8";
			КонецЕсли;

			КолТекст = Формат(Кол, "ЧДЦ=0; ЧРГ=' '");
			HTML = HTML + "<div style=""white-space:nowrap;"">"
				+ "<span style=""display:inline-block; width:8px; height:8px; border-radius:2px;"
				+ " background:" + ЦветБара + "; margin-right:5px; vertical-align:middle;""></span>"
				+ "<b style=""font-size:13px;"">" + КолТекст + "</b>"
				+ "<span style=""color:#94A3B8; font-size:10px;""> л</span> "
				+ "<span style=""color:#94A3B8; font-size:10px;"">" + Наим + "</span>"
				+ "</div>";
		КонецЦикла;

		Возврат HTML;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// ==========================================================================
//  СЕРВЕРНЫЕ ОБЁРТКИ ДЛЯ HTML-ДЕТАЛЕЙ
//  (HTMLГенератор — серверный модуль, нужны обёртки для вызова с клиента)
// ==========================================================================

// Обновить детали для внешнего документа (правая панель).
//
&НаСервере
Процедура ОбновитьДеталиВнешнегоДокумента(ТипДокумента, ДанныеJSON, Заголовок)

	// Сопутка/Общепит: ДанныеJSON это путь к файлу пакета смены
	Если (ТипДокумента = "Сопутка" Или ТипДокумента = "Общепит")
			И ЗначениеЗаполнено(ДанныеJSON) И СтрНайти(ДанныеJSON, ".json") > 0 Тогда
		HTMLДетали = TL_HTMLГенератор.СформироватьДеталиПакетаСмены(ДанныеJSON, Заголовок);
	ИначеЕсли ТипДокумента = "Смена" И ЗначениеЗаполнено(ДанныеJSON) Тогда
		HTMLДетали = TL_HTMLГенератор.СформироватьДеталиСмены(ДанныеJSON, Заголовок);
	ИначеЕсли ТипДокумента = "ТТН" И ЗначениеЗаполнено(ДанныеJSON) Тогда
		HTMLДетали = TL_HTMLГенератор.СформироватьДеталиТТН(ДанныеJSON, Заголовок);
	Иначе
		HTMLДетали = TL_HTMLГенератор.ПустыеДетали();
	КонецЕсли;

КонецПроцедуры

// Обновить детали для внутреннего документа (левая панель) со связанными.
//
&НаСервере
Процедура ОбновитьДеталиВнутреннегоДокумента(КлючБазовый, ДанныеJSON, Заголовок, СвязанныеДокументы)

	// Сопутка/Общепит: КлючБазовый = ИдентификаторПакета (UUID), ДанныеJSON = путь
	Если ЗначениеЗаполнено(ДанныеJSON) И СтрНайти(ДанныеJSON, ".json") > 0
			И СтрНайти(ДанныеJSON, "\") > 0 Тогда
		HTMLДетали = TL_HTMLГенератор.СформироватьДеталиПакетаСмены(ДанныеJSON, Заголовок);
	ИначеЕсли СтрНайти(КлючБазовый, "|СМЕНА|") > 0 Тогда
		HTMLДетали = TL_HTMLГенератор.СформироватьДеталиСмены(
			ДанныеJSON, Заголовок, СвязанныеДокументы);
	ИначеЕсли СтрНайти(КлючБазовый, "|ТТН|") > 0 Тогда
		HTMLДетали = TL_HTMLГенератор.СформироватьДеталиТТН(
			ДанныеJSON, Заголовок, СвязанныеДокументы);
	Иначе
		HTMLДетали = TL_HTMLГенератор.ПустыеДетали();
	КонецЕсли;

КонецПроцедуры

