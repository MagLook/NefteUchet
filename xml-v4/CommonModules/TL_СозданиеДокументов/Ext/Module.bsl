////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_СозданиеДокументов
// Расширение TradeLedger для 1С:БП 3.0
// Контекст: Сервер
// Создание типовых документов 1С из данных API STS.
//
// Каждый обработчик возвращает Структуру("Документы, Ошибки"):
//   Документы - Массив ссылок на созданные документы
//   Ошибки   - Массив строк с описаниями ошибок
//
// Маппинг и настройки — через единый модуль TL_Настройки (v4).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработать сменный отчёт: создать Отчёт о розничных продажах
// и Перемещения на виртуальные склады (по каналам оплат).
//
// Параметры:
//   ДанныеJSON    - Строка - JSON сменного отчёта из API
//   КлючЗагрузки  - Строка - уникальный ключ "TL|СМЕНА|система|станция|смена"
//   Проводить     - Булево - проводить документ сразу (по умолчанию Ложь)
//
// Возвращаемое значение:
//   Структура - ("Документы, Ошибки")
//
Функция ОбработатьСмену(ДанныеJSON, КлючЗагрузки, Проводить = Ложь) Экспорт

	Результат = Новый Структура("Документы, Ошибки", Новый Массив, Новый Массив);

	// Защита от дублей
	ИнфоСуществует = TL_РегистрСтатусов.ПолучитьСтатус(КлючЗагрузки);
	Если ИнфоСуществует <> Неопределено Тогда
		Результат.Ошибки.Добавить("Документ уже загружен: " + КлючЗагрузки);
		Возврат Результат;
	КонецЕсли;

	Попытка
		Данные = ПолучитьИзJSON(ДанныеJSON);
	Исключение
		Результат.Ошибки.Добавить("Ошибка разбора JSON: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Если Данные = Неопределено Тогда
		Результат.Ошибки.Добавить("Пустые данные смены");
		Возврат Результат;
	КонецЕсли;

	// Организация
	Организация = TL_Настройки.ПолучитьОрганизацию();
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.Ошибки.Добавить("Организация не найдена в справочнике");
		Возврат Результат;
	КонецЕсли;

	// Склад АЗС по номеру станции
	КодСтанции = TL_ApiКлиент.ПолучитьЗначение(Данные, "station", 0);
	СкладАЗС = TL_Настройки.НайтиСкладСтанции(КодСтанции);
	Если Не ЗначениеЗаполнено(СкладАЗС) Тогда
		Результат.Ошибки.Добавить("Склад для станции " + XMLСтрока(КодСтанции) + " не найден");
		Возврат Результат;
	КонецЕсли;

	// Дата смены (dt_open приоритетнее date, как в форме)
	ДатаСмены = TL_ApiКлиент.ПолучитьДатуИзДанных(Данные, "dt_open");
	Если Не ЗначениеЗаполнено(ДатаСмены) Тогда
		ДатаСмены = TL_ApiКлиент.ПолучитьДатуИзДанных(Данные, "date");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаСмены) Тогда
		ДатаСмены = ТекущаяДата();
	КонецЕсли;
	ДатаСмены = TL_Настройки.НормализоватьДатуСмены(ДатаСмены, КодСтанции);

	// Ставка НДС
	СтавкаНДС = TL_Настройки.ПолучитьСтавкуНДС();

	// --- Единый источник данных: sales (транзакции с pay_type + fuel + volume) ---
	// Из sales строим ВСЁ: розничные продажи + перемещения на виртуальные склады.
	// Это исключает двойной учёт (pumps содержит ВСЕ литры, а нам нужно разделение).

	МассивПродаж = TL_ApiКлиент.ПолучитьЗначение(Данные, "sales", Неопределено);

	// Агрегировать продажи: (Канал × КодТоплива) → {Литры, Сумма}
	// Канал: "retail" (наличные+эквайринг), "cards" (топл.карты), "online" (Яндекс)
	АгрегатПоКаналам = АгрегироватьПродажиПоКаналам(МассивПродаж);

	// --- Шаг 1: Отчёт о розничных продажах (ТОЛЬКО канал retail) ---
	НачатьТранзакцию();
	Попытка
		Док = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
		Док.Дата = ДатаСмены;
		Док.Организация = Организация;
		Док.Комментарий = КлючЗагрузки;

		УстановитьРеквизитБезопасно(Док, "СкладОрганизации", СкладАЗС);
		УстановитьРеквизитБезопасно(Док, "Склад", СкладАЗС);

		// Обязательные реквизиты для проведения
		Попытка Док.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду("643"); Исключение КонецПопытки;
		УстановитьРеквизитБезопасно(Док, "КурсДокумента", 1);
		УстановитьРеквизитБезопасно(Док, "КратностьДокумента", 1);
		УстановитьРеквизитБезопасно(Док, "СуммаВключаетНДС", Истина);
		Попытка Док.СчетКасса = ПланыСчетов.Хозрасчетный.НайтиПоКоду("50.01"); Исключение КонецПопытки;
		// СтатьяДвиженияДенежныхСредств
		Попытка
			Док.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Розничная выручка", Истина);
		Исключение
		КонецПопытки;

		// Счета учёта (для программного создания)
		СчетаБУ = ПолучитьСчетаУчёта();

		// Заполнить товарами ТОЛЬКО из канала retail
		Для Каждого КлючЗначение Из АгрегатПоКаналам Цикл
			Агрегат = КлючЗначение.Значение;

			Если Агрегат.КлючКанала <> "retail" Тогда
				Продолжить;
			КонецЕсли;

			Если Агрегат.Литры <= 0 Тогда
				Продолжить;
			КонецЕсли;

			Номенклатура = TL_Настройки.НайтиНоменклатуруТоплива(Агрегат.КодТоплива, "л", КодСтанции);
			Если Не ЗначениеЗаполнено(Номенклатура) Тогда
				Результат.Ошибки.Добавить("Номенклатура не найдена: " + Агрегат.КодТоплива + " (л)");
				Продолжить;
			КонецЕсли;

			НоваяСтрока = Док.Товары.Добавить();
			НоваяСтрока.Номенклатура = Номенклатура;
			НоваяСтрока.Количество   = Агрегат.Литры;
			НоваяСтрока.Цена         = ?(Агрегат.Литры <> 0, Окр(Агрегат.Сумма / Агрегат.Литры, 2), 0);
			НоваяСтрока.Сумма        = Агрегат.Сумма;

			// Счета учёта (розница: 41.02 учёт, 90.01.1 доходы, 90.02.1 расходы)
			УстановитьРеквизитБезопасно(НоваяСтрока, "СчетУчета", СчетаБУ.Счёт4102);
			УстановитьРеквизитБезопасно(НоваяСтрока, "СчетДоходов", СчетаБУ.Счёт9001);
			УстановитьРеквизитБезопасно(НоваяСтрока, "СчетРасходов", СчетаБУ.Счёт9002);
			УстановитьРеквизитБезопасно(НоваяСтрока, "СчетУчетаНДСПоРеализации", СчетаБУ.Счёт9003);

			// Розничные цены (обязательны для складов типа «Розничный магазин»,
			// иначе ОбработкаПроведения делит на 0 при расчёте наценки)
			УстановитьРеквизитБезопасно(НоваяСтрока, "ЦенаВРознице", НоваяСтрока.Цена);
			УстановитьРеквизитБезопасно(НоваяСтрока, "СуммаВРознице", Агрегат.Сумма);

			Если ЗначениеЗаполнено(СтавкаНДС) Тогда
				УстановитьРеквизитБезопасно(НоваяСтрока, "СтавкаНДС", СтавкаНДС);
				СуммаНДС = РассчитатьСуммуНДС(Агрегат.Сумма, СтавкаНДС);
				УстановитьРеквизитБезопасно(НоваяСтрока, "СуммаНДС", СуммаНДС);
			КонецЕсли;
		КонецЦикла;

		// Информация по каналам — в комментарий
		ТекстКаналов = СформироватьТекстКаналов(АгрегатПоКаналам);
		Если ЗначениеЗаполнено(ТекстКаналов) Тогда
			Док.Комментарий = Док.Комментарий + " | " + ТекстКаналов;
		КонецЕсли;

		// Не записывать пустой документ (нет розничных строк)
		Если Док.Товары.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			Результат.Ошибки.Добавить("Нет розничных продаж (retail) для создания Отчёта");
			Возврат Результат;
		КонецЕсли;

		// Запись
		Если Проводить Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		Результат.Документы.Добавить(Док.Ссылка);
		TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючЗагрузки, Док.Ссылка, "Смена");
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Ошибка создания Отчёта о розн. продажах: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	// --- Шаг 2: Перемещения на виртуальные склады (каналы cards, online) ---
	// Используем тот же агрегат — точные литры из sales.
	СоздатьПеремещенияИзАгрегата(Результат, Организация, СкладАЗС, КодСтанции,
		АгрегатПоКаналам, ДатаСмены, КлючЗагрузки);

	Возврат Результат;

КонецФункции

// Обработать ТТН: создать цепочку из 3 документов:
//   1. Поступление товаров (тонны → основной склад)
//   2. Перемещение на склад АЗС (тонны)
//   3. Комплектация (тонны → литры по плотности из ТТН)
//
// Параметры:
//   ДанныеJSON    - Строка - JSON поступления из API
//   КлючЗагрузки  - Строка - уникальный ключ "TL|ТТН|система|станция|номерТТН"
//   Проводить     - Булево
//
// Возвращаемое значение:
//   Структура - ("Документы, Ошибки")
//
Функция ОбработатьТТН(ДанныеJSON, КлючЗагрузки, Проводить = Ложь) Экспорт

	Результат = Новый Структура("Документы, Ошибки", Новый Массив, Новый Массив);

	// Защита от дублей
	ИнфоСуществует = TL_РегистрСтатусов.ПолучитьСтатус(КлючЗагрузки);
	Если ИнфоСуществует <> Неопределено Тогда
		Результат.Ошибки.Добавить("Документ уже загружен: " + КлючЗагрузки);
		Возврат Результат;
	КонецЕсли;

	Попытка
		Данные = ПолучитьИзJSON(ДанныеJSON);
	Исключение
		Результат.Ошибки.Добавить("Ошибка разбора JSON ТТН: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Если Данные = Неопределено Тогда
		Результат.Ошибки.Добавить("Пустые данные ТТН");
		Возврат Результат;
	КонецЕсли;

	// Организация
	Организация = TL_Настройки.ПолучитьОрганизацию();
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.Ошибки.Добавить("Организация не найдена");
		Возврат Результат;
	КонецЕсли;

	// Склады
	ОсновнойСклад = TL_Настройки.ПолучитьОсновнойСклад();
	Если Не ЗначениеЗаполнено(ОсновнойСклад) Тогда
		Результат.Ошибки.Добавить("Основной склад не найден");
		Возврат Результат;
	КонецЕсли;

	КодСтанции = Число(TL_ApiКлиент.ПолучитьЗначение(Данные, "station", 0));
	СкладАЗС = TL_Настройки.НайтиСкладСтанции(КодСтанции);
	Если Не ЗначениеЗаполнено(СкладАЗС) Тогда
		Результат.Ошибки.Добавить("Склад АЗС для станции " + XMLСтрока(КодСтанции)
			+ " не найден — ТТН не может быть загружена без склада станции");
		Возврат Результат;
	КонецЕсли;

	// Дата
	ДатаТТН = TL_ApiКлиент.ПолучитьДатуИзДанных(Данные, "date");
	Если Не ЗначениеЗаполнено(ДатаТТН) Тогда
		ДатаТТН = ТекущаяДата();
	КонецЕсли;

	// Данные по топливу из ТТН
	НомерТТН   = Строка(TL_ApiКлиент.ПолучитьЗначение(Данные, "ttn", ""));
	КодТоплива = Строка(TL_ApiКлиент.ПолучитьЗначение(Данные, "fuel", ""));
	Плотность  = Число(TL_ApiКлиент.ПолучитьЗначение(Данные, "density", 0));

	// Из ТТН берём только физические данные: массу и объём.
	// Стоимость нас не касается — поступление от поставщика ведётся отдельно.
	ДокДанные = TL_ApiКлиент.ПолучитьЗначение(Данные, "doc", Неопределено);
	Если ДокДанные <> Неопределено Тогда
		ОбъёмЛитров = Число(TL_ApiКлиент.ПолучитьЗначение(ДокДанные, "volume", 0));
		МассаКг     = Число(TL_ApiКлиент.ПолучитьЗначение(ДокДанные, "amount", 0));
	Иначе
		ОбъёмЛитров = Число(TL_ApiКлиент.ПолучитьЗначение(Данные, "doc_volume", 0));
		МассаКг     = Число(TL_ApiКлиент.ПолучитьЗначение(Данные, "doc_amount", 0));
		Если МассаКг = 0 И ОбъёмЛитров > 0 И Плотность > 0 Тогда
			МассаКг = ОбъёмЛитров * Плотность;
		КонецЕсли;
	КонецЕсли;

	МассаТонн = МассаКг / 1000;

	// Номенклатура тонн
	НоменклатураТонн = TL_Настройки.НайтиНоменклатуруТоплива(КодТоплива, "т");
	Если Не ЗначениеЗаполнено(НоменклатураТонн) И МассаТонн > 0 Тогда
		Результат.Ошибки.Добавить("Номенклатура не найдена: " + КодТоплива + " (т)");
		Возврат Результат;
	КонецЕсли;

	// === Шаг 1: Перемещение на склад АЗС (тонны: основной → станция) ===
	Если МассаТонн > 0 И ЗначениеЗаполнено(СкладАЗС) Тогда
		КлючПеремещения = КлючЗагрузки + "|ПЕРЕМ";
		// Тонны: счёт 41.01
		СчетТонн = Неопределено;
		Попытка СчетТонн = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01"); Исключение КонецПопытки;
		СоздатьПеремещение(Результат, Организация, ОсновнойСклад, СкладАЗС,
			НоменклатураТонн, МассаТонн, ДатаТТН, КлючПеремещения, Проводить, СчетТонн);

		// Регистрируем ТТН по ключу перемещения (первый документ = основной)
		Если Результат.Документы.Количество() > 0 Тогда
			TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючЗагрузки,
				Результат.Документы[Результат.Документы.Количество() - 1], "ТТН");
		КонецЕсли;
	КонецЕсли;

	// === Шаг 2: Комплектация тонны → литры (по плотности из ТТН) ===
	Если МассаТонн > 0 И ОбъёмЛитров > 0 И ЗначениеЗаполнено(СкладАЗС) Тогда
		НоменклатураЛитры = TL_Настройки.НайтиНоменклатуруТоплива(КодТоплива, "л", КодСтанции);
		Если ЗначениеЗаполнено(НоменклатураЛитры) Тогда
			КлючКомплектации = КлючЗагрузки + "|КОМПЛ";
			СоздатьКомплектациюПоДокументу(Результат, Организация, СкладАЗС,
				НоменклатураТонн, НоменклатураЛитры,
				МассаТонн, ОбъёмЛитров, Плотность, ДатаТТН, КлючКомплектации, Проводить);

			Если Плотность > 0 Тогда
				TL_Настройки.ЗаписатьПлотность(КодТоплива, КодСтанции, ДатаТТН,
					Плотность, МассаКг, ОбъёмЛитров, НомерТТН);
			КонецЕсли;
		Иначе
			Результат.Ошибки.Добавить("Номенклатура (л) не найдена для " + КодТоплива + " — комплектация пропущена");
		КонецЕсли;
	ИначеЕсли МассаТонн > 0 И ОбъёмЛитров = 0 Тогда
		Результат.Ошибки.Добавить("Объём литров = 0 в ТТН №" + НомерТТН + " — комплектация пропущена");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Десериализовать JSON-строку в Соответствие/Массив.
//
Функция ПолучитьИзJSON(ТекстJSON) Экспорт

	Если Не ЗначениеЗаполнено(ТекстJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Возврат ПрочитатьJSON(Чтение, Истина);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создать документ Перемещение товаров.
//
Процедура СоздатьПеремещение(Результат, Организация, СкладОт, СкладДо, Номенклатура, Количество, Дата, КлючЗагрузки, Проводить, СчетСтроки = Неопределено)

	НачатьТранзакцию();
	Попытка
		Док = Документы.ПеремещениеТоваров.СоздатьДокумент();
		Док.Дата = Дата;
		Док.Организация = Организация;
		Док.Комментарий = КлючЗагрузки;

		УстановитьРеквизитБезопасно(Док, "СкладОтправитель", СкладОт);
		УстановитьРеквизитБезопасно(Док, "СкладПолучатель", СкладДо);

		НоваяСтрока = Док.Товары.Добавить();
		НоваяСтрока.Номенклатура = Номенклатура;
		НоваяСтрока.Количество   = Количество;

		// Счета перемещения: СчетУчета (откуда) + НовыйСчетУчета (куда)
		Если Не ЗначениеЗаполнено(СчетСтроки) Тогда
			СчетаБУ = ПолучитьСчетаУчёта();
			СчетСтроки = СчетаБУ.Счёт4102; // по умолчанию — литры (для каналов оплат)
		КонецЕсли;
		УстановитьРеквизитБезопасно(НоваяСтрока, "СчетУчета", СчетСтроки);
		УстановитьРеквизитБезопасно(НоваяСтрока, "НовыйСчетУчета", СчетСтроки);

		Если Проводить Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		Результат.Документы.Добавить(Док.Ссылка);
		TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючЗагрузки, Док.Ссылка, "Перемещение");
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Ошибка создания Перемещения: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Создать документ Комплектация номенклатуры (тонны → литры).
// Все значения берутся из ТТН документа — ничего не вычисляется.
//
// Параметры:
//   МассаТонн    - Число - масса из ТТН (doc.amount / 1000)
//   ОбъёмЛитров  - Число - объём из ТТН (doc.volume) — готовое значение!
//   Плотность    - Число - плотность из ТТН (density)
//
Процедура СоздатьКомплектациюПоДокументу(Результат, Организация, Склад, НоменклТонн, НоменклЛитры, МассаТонн, ОбъёмЛитров, Плотность, Дата, КлючЗагрузки, Проводить)

	НачатьТранзакцию();
	Попытка
		Док = Документы.КомплектацияНоменклатуры.СоздатьДокумент();
		Док.Дата = Дата;
		Док.Организация = Организация;
		Док.Комментарий = КлючЗагрузки
			+ " | " + Формат(МассаТонн, "ЧДЦ=3") + "т → " + Формат(ОбъёмЛитров, "ЧДЦ=1") + "л"
			+ ?(Плотность > 0, ", плотность=" + Формат(Плотность, "ЧДЦ=4"), "");

		УстановитьРеквизитБезопасно(Док, "Склад", Склад);

		// Комплектующие (расход): тонны, счёт 41.01
		СчетаБУ = ПолучитьСчетаУчёта();
		СтрокаРасход = Док.Комплектующие.Добавить();
		СтрокаРасход.Номенклатура = НоменклТонн;
		СтрокаРасход.Количество   = МассаТонн;
		УстановитьРеквизитБезопасно(СтрокаРасход, "СчетУчета", СчетаБУ.Счёт4101);
		// ДоляСтоимости = 1 — единственный компонент забирает 100% себестоимости.
		// Себестоимость рассчитывается 1С автоматически из остатков на 41.01.
		// Если остатков нет (приход ещё не введён) — проводки будут с нулевой суммой,
		// пересчёт произойдёт после ввода приходных накладных.
		УстановитьРеквизитБезопасно(СтрокаРасход, "ДоляСтоимости", 1);

		// Выпуск: в части конфигураций это табличная часть Продукция,
		// в БП 3.0 — реквизиты самого документа.
		Попытка
			СтрокаВыпуск = Док.Продукция.Добавить();
			СтрокаВыпуск.Номенклатура = НоменклЛитры;
			СтрокаВыпуск.Количество   = ОбъёмЛитров;
			УстановитьРеквизитБезопасно(СтрокаВыпуск, "СчетУчета", СчетаБУ.Счёт4102);
		Исключение
			УстановитьРеквизитБезопасно(Док, "Номенклатура", НоменклЛитры);
			УстановитьРеквизитБезопасно(Док, "Количество", ОбъёмЛитров);
			УстановитьРеквизитБезопасно(Док, "СчетУчета", СчетаБУ.Счёт4102);
		КонецПопытки;

		Если Проводить Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		Результат.Документы.Добавить(Док.Ссылка);
		TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(КлючЗагрузки, Док.Ссылка, "Комплектация");
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Ошибка создания Комплектации: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Агрегировать массив sales по каналам оплат и видам топлива.
// Возвращает: Соответствие("канал|код" → Структура(КлючКанала, КодТоплива, Литры, Сумма))
//
Функция АгрегироватьПродажиПоКаналам(МассивПродаж)

	Агрегат = Новый Соответствие;

	Если ТипЗнч(МассивПродаж) <> Тип("Массив") Тогда
		Возврат Агрегат;
	КонецЕсли;

	Для Каждого Продажа Из МассивПродаж Цикл

		ТипОплаты = TL_ApiКлиент.ПолучитьЗначение(Продажа, "pay_type", Неопределено);
		Если ТипОплаты = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяОплаты = НРег(Строка(TL_ApiКлиент.ПолучитьЗначение(ТипОплаты, "name", "")));
		Если Не ЗначениеЗаполнено(ИмяОплаты) Тогда
			Продолжить;
		КонецЕсли;

		КлючКанала = ОпределитьКаналОплаты(ИмяОплаты);
		Если Не ЗначениеЗаполнено(КлючКанала) Тогда
			Продолжить; // Купоны и неизвестные — пропускаем
		КонецЕсли;

		МассивТоплива = TL_ApiКлиент.ПолучитьЗначение(Продажа, "fuel", Неопределено);
		Если ТипЗнч(МассивТоплива) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ЭлементТоплива Из МассивТоплива Цикл
			Сервис = TL_ApiКлиент.ПолучитьЗначение(ЭлементТоплива, "service", Неопределено);
			Если Сервис = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			КодТоплива = Строка(TL_ApiКлиент.ПолучитьЗначение(Сервис, "service_code", ""));

			Выпуск = TL_ApiКлиент.ПолучитьЗначение(ЭлементТоплива, "release", Неопределено);
			Если Выпуск = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Литры = Число(TL_ApiКлиент.ПолучитьЗначение(Выпуск, "volume", 0));
			Стоимость = Число(TL_ApiКлиент.ПолучитьЗначение(Выпуск, "cost", 0));

			Если Литры <= 0 Тогда
				Продолжить;
			КонецЕсли;

			КлючАгрегата = КлючКанала + "|" + КодТоплива;
			Существующий = Агрегат.Получить(КлючАгрегата);
			Если Существующий <> Неопределено Тогда
				Существующий.Литры = Существующий.Литры + Литры;
				Существующий.Сумма = Существующий.Сумма + Стоимость;
			Иначе
				Агрегат.Вставить(КлючАгрегата,
					Новый Структура("КлючКанала, КодТоплива, Литры, Сумма",
						КлючКанала, КодТоплива, Литры, Стоимость));
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Агрегат;

КонецФункции

// Создать перемещения на виртуальные склады из агрегата (только cards и online).
//
Процедура СоздатьПеремещенияИзАгрегата(Результат, Организация, СкладАЗС, КодСтанции, АгрегатПоКаналам, Дата, КлючБазовый)

	Для Каждого КлючЗначение Из АгрегатПоКаналам Цикл

		Агрегат = КлючЗначение.Значение;

		// retail — уже обработан в Отчёте о розн. продажах, пропускаем
		Если Агрегат.КлючКанала = "retail" Тогда
			Продолжить;
		КонецЕсли;

		ВидОплаты = TL_Настройки.НайтиВидОплаты(Агрегат.КлючКанала);
		Если ВидОплаты = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Не ВидОплаты.ТребуетПеремещения ИЛИ Не ЗначениеЗаполнено(ВидОплаты.Склад) Тогда
			Продолжить;
		КонецЕсли;

		Номенклатура = TL_Настройки.НайтиНоменклатуруТоплива(Агрегат.КодТоплива, "л", КодСтанции);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		КлючПеремещения = КлючБазовый + "|" + Агрегат.КлючКанала + "|" + Агрегат.КодТоплива;
		СоздатьПеремещение(Результат, Организация, СкладАЗС, ВидОплаты.Склад,
			Номенклатура, Агрегат.Литры, Дата, КлючПеремещения, Ложь);

	КонецЦикла;

КонецПроцедуры

// Сформировать текст каналов для комментария документа.
//
Функция СформироватьТекстКаналов(АгрегатПоКаналам)

	ИтогиПоКаналам = Новый Соответствие; // канал → сумма
	Для Каждого КлючЗначение Из АгрегатПоКаналам Цикл
		Агрегат = КлючЗначение.Значение;
		Существующий = ИтогиПоКаналам.Получить(Агрегат.КлючКанала);
		Если Существующий <> Неопределено Тогда
			ИтогиПоКаналам.Вставить(Агрегат.КлючКанала, Существующий + Агрегат.Сумма);
		Иначе
			ИтогиПоКаналам.Вставить(Агрегат.КлючКанала, Агрегат.Сумма);
		КонецЕсли;
	КонецЦикла;

	Текст = "";
	Для Каждого КЗ Из ИтогиПоКаналам Цикл
		Если КЗ.Значение > 0 Тогда
			Текст = Текст + ?(ЗначениеЗаполнено(Текст), "; ", "")
				+ КЗ.Ключ + ": " + Формат(КЗ.Значение, "ЧДЦ=2");
		КонецЕсли;
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Определить канал оплаты по имени из API (нормализация).
//
// Три канала реализации:
//   "retail"  — Розница (наличные + банк.карты) → прямая продажа, без перемещения
//   "cards"   — Топливные/корпоративные карты всех эмитентов → виртуальный склад
//   "online"  — Онлайн-заказы (Яндекс, мобильные, Benzuber) → виртуальный склад
//
// Купоны ("купон на сдачу") — сервисный механизм, не канал реализации. Игнорируем.
//
// Возвращаемое значение:
//   Строка — ключ канала ("retail", "cards", "online"), или "" для игнорируемых
//
Функция ОпределитьКаналОплаты(ИмяОплатыНРег)

	// 1. Поиск через регистр TL_МаппингОплат (настраиваемый маппинг)
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ОбразецИмени,
			|	КаналОплаты
			|ИЗ
			|	РегистрСведений.TL_МаппингОплат
			|УПОРЯДОЧИТЬ ПО
			|	Приоритет";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.ОбразецИмени)
				И СтрНайти(ИмяОплатыНРег, НРег(Выборка.ОбразецИмени)) > 0 Тогда
				Возврат Выборка.КаналОплаты; // "" = игнорировать, "retail"/"cards"/"online"/"voucher"
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Регистр TL_МаппингОплат не существует — используем fallback
	КонецПопытки;

	// 2. Fallback: хардкод (работает если регистр пуст или не создан)
	Если СтрНайти(ИмяОплатыНРег, "купон") > 0 Тогда
		Возврат "";
	ИначеЕсли СтрНайти(ИмяОплатыНРег, "талон") > 0 Тогда
		Возврат "voucher";
	ИначеЕсли ИмяОплатыНРег = "кр"
		ИЛИ СтрНайти(ИмяОплатыНРег, "корпоратив") > 0
		ИЛИ СтрНайти(ИмяОплатыНРег, "топливн") > 0
		ИЛИ СтрНайти(ИмяОплатыНРег, "агора") > 0 Тогда
		Возврат "cards";
	ИначеЕсли СтрНайти(ИмяОплатыНРег, "мобил") > 0
		ИЛИ СтрНайти(ИмяОплатыНРег, "яндекс") > 0
		ИЛИ СтрНайти(ИмяОплатыНРег, "benzuber") > 0 Тогда
		Возврат "online";
	ИначеЕсли СтрНайти(ИмяОплатыНРег, "наличн") > 0
		ИЛИ СтрНайти(ИмяОплатыНРег, "сбербанк") > 0
		ИЛИ СтрНайти(ИмяОплатыНРег, "карт") > 0
		ИЛИ СтрНайти(ИмяОплатыНРег, "безнал") > 0 Тогда
		Возврат "retail";
	КонецЕсли;

	// 3. Неизвестный вид оплаты — fallback в retail + warning
	ЗаписьЖурналаРегистрации("TL_СозданиеДокументов",
		УровеньЖурналаРегистрации.Предупреждение, , ,
		"Неизвестный вид оплаты: """ + ИмяОплатыНРег
		+ """ — обработан как розница (retail). Добавьте маппинг в настройках.");
	Возврат "retail";

КонецФункции

// Получить счета учёта для программного заполнения документов.
// При интерактивном создании 1С заполняет их автоматически,
// при программном — нужно заполнять явно.
//
Функция ПолучитьСчетаУчёта() Экспорт

	Счета = Новый Структура;
	Попытка Счета.Вставить("Счёт4101", ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01")); Исключение Счета.Вставить("Счёт4101", Неопределено); КонецПопытки;
	Попытка Счета.Вставить("Счёт4102", ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.02")); Исключение Счета.Вставить("Счёт4102", Неопределено); КонецПопытки;
	Попытка Счета.Вставить("Счёт9001", ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.1")); Исключение Счета.Вставить("Счёт9001", Неопределено); КонецПопытки;
	Попытка Счета.Вставить("Счёт9002", ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.1")); Исключение Счета.Вставить("Счёт9002", Неопределено); КонецПопытки;
	Попытка Счета.Вставить("Счёт9003", ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.03")); Исключение Счета.Вставить("Счёт9003", Неопределено); КонецПопытки;

	Возврат Счета;

КонецФункции

// Безопасно установить значение реквизита документа/строки.
//
Процедура УстановитьРеквизитБезопасно(Объект, ИмяСвойства, Значение)

	Попытка
		Объект[ИмяСвойства] = Значение;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Рассчитать сумму НДС из суммы с НДС.
// Определяет процент по ставке (22% или 20%).
//
Функция РассчитатьСуммуНДС(СуммаСНДС, СтавкаНДС)

	ПроцентНДС = 22;
	Попытка
		Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
			ПроцентНДС = 20;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Окр(СуммаСНДС * ПроцентНДС / (100 + ПроцентНДС), 2);

КонецФункции

#КонецОбласти
