////////////////////////////////////////////////////////////////////////////////
// Обработка TL_НастройкаОбменаОбщепит, Форма
// Расширение TradeLedger — настройки приёма пакетов общепита из ЦБ ЭЛСИ.АЗК.
//
// Все значения хранятся в РегистрСведений.TL_Настройки (key-value) с префиксом
// "Общепит_". Каталог OwnCloud общий с Сопуткой (КаталогOwnCloud_ЦБ).
//
// Реквизиты формы (для сборки Form.bin):
//   ОбщепитВключён          - Булево (default Ложь) — главный переключатель режима.
//                              ВЫКЛ: документы kind=production_release/ingredients_writeoff
//                              пропускаются приёмником, в БП ГИГ создаются только обычные
//                              сопутка-документы (purchase/retail_sale_sidegoods/...).
//                              ВКЛ: production_release создаёт ОтчетПроизводстваЗаСмену
//                              с проводками 41.02 ↔ 44.01.
//   КаталогOwnCloud         - Строка(255) - путь к общему каталогу обмена
//   Организация             - СправочникСсылка.Организации - ГИГ
//   Подразделение           - СправочникСсылка.ПодразделенияОрганизаций
//   СчётЗатрат              - ПланСчетов.Хозрасчетный — 44.01 (издержки общепита)
//   СчётГП                  - ПланСчетов.Хозрасчетный — 41.02 (готовая продукция/сырьё)
//   СтатьяЗатрат            - СправочникСсылка.СтатьиЗатрат
//   НоменклатурнаяГруппа    - СправочникСсылка.НоменклатурныеГруппы
//   ПроводитьАвтоматически  - Булево (default Истина)
//   ТекстЛога               - Строка многострочная
//
// Команды:
//   КомандаЗаполнитьПоУмолчанию  → ЗаполнитьПоУмолчанию()
//   КомандаЗагрузить             → ЗагрузитьНастройки()
//   КомандаСохранить             → СохранитьНастройки()
//   КомандаПроверитьКаталог      → ПроверитьКаталог()
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбщепитВключён = Ложь;
	ПроводитьАвтоматически = Истина;
	ЗагрузитьНастройкиНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьНастройки(Команда) Экспорт
	ЗагрузитьНастройкиНаСервере();
	ДобавитьВЛог("Настройки прочитаны из TL_Настройки");
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда) Экспорт
	СохранитьНастройкиНаСервере();
	ДобавитьВЛог("Настройки сохранены");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда) Экспорт
	Если Вопрос("Заполнить значения по умолчанию для ГИГ? Текущие значения формы будут перезаписаны.",
			РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьПоУмолчаниюНаСервере();
	ДобавитьВЛог("Заполнены значения по умолчанию");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКаталог(Команда) Экспорт
	Результат = ПроверитьКаталогНаСервере();
	ДобавитьВЛог(Результат);
КонецПроцедуры

// Обработчики кнопок (для сборки Form.bin).
// Директива &НаКлиенте обязательна — без неё компилятор делает процедуру серверной,
// а её тело вызывает клиентские процедуры (ЗагрузитьНастройки и др.) → ошибка
// «Процедура с указанным именем не определена (Проверка: Сервер)».
&НаКлиенте
Процедура КнопкаЗагрузитьНажатие(Кнопка)
	ЗагрузитьНастройки(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаСохранитьНажатие(Кнопка)
	СохранитьНастройки(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаЗаполнитьПоУмолчаниюНажатие(Кнопка)
	ЗаполнитьПоУмолчанию(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаПроверитьКаталогНажатие(Кнопка)
	ПроверитьКаталог(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьНастройкиНаСервере()
	ОбщепитВключён       = TL_Настройки.ОбщепитВключён();
	КаталогOwnCloud      = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
	Организация          = ПолучитьСсылкуПоUUID("Общепит_Организация_UUID",
		"Справочник.Организации");
	Подразделение        = ПолучитьСсылкуПоUUID("Общепит_Подразделение_UUID",
		"Справочник.ПодразделенияОрганизаций");
	СчётЗатрат           = ПолучитьСчётПоКоду(TL_Настройки.ПолучитьЗначение("Общепит_СчетЗатрат_Код", "44.01"));
	СчётГП               = ПолучитьСчётПоКоду(TL_Настройки.ПолучитьЗначение("Общепит_СчетГП_Код", "41.02"));
	СтатьяЗатрат         = ПолучитьСсылкуПоUUID("Общепит_СтатьяЗатрат_UUID",
		"Справочник.СтатьиЗатрат");
	НоменклатурнаяГруппа = ПолучитьСсылкуПоUUID("Общепит_НомГруппа_UUID",
		"Справочник.НоменклатурныеГруппы");
	Стр = TL_Настройки.ПолучитьЗначение("Общепит_ПроводитьАвто", "Истина");
	ПроводитьАвтоматически = (Стр <> "Ложь");
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()
	TL_Настройки.УстановитьЗначение("ОбщепитВключён",
		?(ОбщепитВключён, "1", "0"),
		"Главный переключатель режима зеркалирования общепита в БП ГИГ");
	Если ЗначениеЗаполнено(КаталогOwnCloud) Тогда
		TL_Настройки.УстановитьЗначение("КаталогOwnCloud_ЦБ", КаталогOwnCloud,
			"Каталог обмена ЦБ ↔ БП ГИГ (общий для Сопутки и Общепита)");
	КонецЕсли;
	СохранитьСсылку("Общепит_Организация_UUID", Организация,
		"Организация-получатель (ГИГ) для документов общепита");
	СохранитьСсылку("Общепит_Подразделение_UUID", Подразделение,
		"Подразделение по умолчанию для общепита");
	Если ЗначениеЗаполнено(СчётЗатрат) Тогда
		TL_Настройки.УстановитьЗначение("Общепит_СчетЗатрат_Код",
			СчётЗатрат.Код, "Счёт затрат общепита (44.01)");
	КонецЕсли;
	Если ЗначениеЗаполнено(СчётГП) Тогда
		TL_Настройки.УстановитьЗначение("Общепит_СчетГП_Код",
			СчётГП.Код, "Счёт готовой продукции / сырья общепита (41.02)");
	КонецЕсли;
	СохранитьСсылку("Общепит_СтатьяЗатрат_UUID", СтатьяЗатрат,
		"Статья затрат для списания сырья общепита");
	СохранитьСсылку("Общепит_НомГруппа_UUID", НоменклатурнаяГруппа,
		"Номенклатурная группа общепита");
	TL_Настройки.УстановитьЗначение("Общепит_ПроводитьАвто",
		?(ПроводитьАвтоматически, "Истина", "Ложь"),
		"Проводить созданные документы общепита автоматически");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчаниюНаСервере()
	// Организация
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Попытка
			Орг = Справочники.Организации.НайтиПоРеквизиту("ИНН", "7839440090");
			Если Не ЗначениеЗаполнено(Орг) Тогда
				Запрос = Новый Запрос(
					"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Организации ГДЕ НЕ ПометкаУдаления");
				В = Запрос.Выполнить().Выбрать();
				Если В.Следующий() Тогда Орг = В.Ссылка; КонецЕсли;
			КонецЕсли;
			Организация = Орг;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Подразделение
	Если Не ЗначениеЗаполнено(Подразделение) Тогда
		Попытка
			Запрос = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПодразделенияОрганизаций
				|ГДЕ Наименование ПОДОБНО ""%208%"" И НЕ ПометкаУдаления");
			В = Запрос.Выполнить().Выбрать();
			Если В.Следующий() Тогда Подразделение = В.Ссылка; КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Счёт затрат 44.01
	Если Не ЗначениеЗаполнено(СчётЗатрат) Тогда
		СчётЗатрат = ПолучитьСчётПоКоду("44.01");
	КонецЕсли;
	// Счёт ГП 41.02
	Если Не ЗначениеЗаполнено(СчётГП) Тогда
		СчётГП = ПолучитьСчётПоКоду("41.02");
	КонецЕсли;
	// Статья затрат «Списание материалов»
	Если Не ЗначениеЗаполнено(СтатьяЗатрат) Тогда
		Попытка
			С = Справочники.СтатьиЗатрат.НайтиПоНаименованию("Списание материалов", Истина);
			Если ЗначениеЗаполнено(С) Тогда СтатьяЗатрат = С; КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Номенклатурная группа «Общепит» / «Производство»
	Если Не ЗначениеЗаполнено(НоменклатурнаяГруппа) Тогда
		Попытка
			Запрос = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.НоменклатурныеГруппы
				|ГДЕ (Наименование = ""Общепит"" ИЛИ Наименование = ""Производство""
				|     ИЛИ Наименование ПОДОБНО ""%бщепит%"")
				|  И НЕ ПометкаУдаления");
			В = Запрос.Выполнить().Выбрать();
			Если В.Следующий() Тогда НоменклатурнаяГруппа = В.Ссылка; КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьКаталогНаСервере()
	Если Не ЗначениеЗаполнено(КаталогOwnCloud) Тогда
		Возврат "Каталог не указан";
	КонецЕсли;
	Попытка
		Ф = Новый Файл(КаталогOwnCloud);
		Если Не Ф.Существует() Тогда
			Возврат "Каталог НЕ существует: " + КаталогOwnCloud;
		КонецЕсли;
		Кол = НайтиФайлы(КаталогOwnCloud, "tl_*.json", Ложь).Количество();
		Возврат "Каталог доступен. Файлов tl_*.json: " + Кол;
	Исключение
		Возврат "Ошибка проверки: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаСервере
Функция ПолучитьСчётПоКоду(Код)
	Если Не ЗначениеЗаполнено(Код) Тогда
		Возврат ПланыСчетов.Хозрасчетный.ПустаяСсылка();
	КонецЕсли;
	Попытка
		Возврат ПланыСчетов.Хозрасчетный.НайтиПоКоду(Код);
	Исключение
		Возврат ПланыСчетов.Хозрасчетный.ПустаяСсылка();
	КонецПопытки;
КонецФункции

&НаСервере
Функция ПолучитьСсылкуПоUUID(КлючНастройки, ПолноеИмяТипа)
	Менеджер = ОбщегоНазначения_МенеджерПоИмени(ПолноеИмяТипа);
	Если Менеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	UUIDСтр = TL_Настройки.ПолучитьЗначение(КлючНастройки, "");
	Если Не ЗначениеЗаполнено(UUIDСтр) Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	Попытка
		Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(UUIDСтр));
	Исключение
		Возврат Менеджер.ПустаяСсылка();
	КонецПопытки;
КонецФункции

&НаСервере
Процедура СохранитьСсылку(КлючНастройки, Ссылка, Описание = "")
	Если ЗначениеЗаполнено(Ссылка) Тогда
		TL_Настройки.УстановитьЗначение(КлючНастройки,
			XMLСтрока(Ссылка.УникальныйИдентификатор()), Описание);
	Иначе
		TL_Настройки.УстановитьЗначение(КлючНастройки, "", Описание);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОбщегоНазначения_МенеджерПоИмени(ПолноеИмя)
	Части = СтрРазделить(ПолноеИмя, ".", Истина);
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части[0] = "Справочник" Тогда
		Возврат Справочники[Части[1]];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ДобавитьВЛог(Текст)
	Префикс = "[" + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + "] ";
	Если ПустаяСтрока(ТекстЛога) Тогда
		ТекстЛога = Префикс + Текст;
	Иначе
		ТекстЛога = ТекстЛога + Символы.ПС + Префикс + Текст;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
