////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_СопуткаСервис
// Расширение ElsyPlus Ledger v6.0 для 1С:БП 3.0
// Контекст: Сервер
//
// Главный сервис обработки пакета ЦБ для подсистемы TL_Сопутка.
// На A3 — поддерживается единственный kind="purchase":
//   Document.ПоступлениеТоваровУслугНаАЗК (ЦБ) → Document.ПоступлениеТоваровУслуг (БП ГИГ).
//
// Прочие kind (transfer/writeoff/inventory/gain) пишутся в TL_ОшибкиЗагрузки
// с пометкой «не покрыто A3» и игнорируются.
//
// Контракт: 09_Контракт_HTTP_ЦБ_БП.md.
// Архитектура: 02_TradeLedger_cfe_проект.md §3 (алгоритм ЗагрузитьPurchase).
// Маппинг счетов: 08_Разведка_BP_GIG/05_Pre_A3_gate_заполненный.md.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработать пакет, полученный от ЦБ (десериализованный JSON).
//
// Параметры:
//   Пакет     - Соответствие - тело пакета согласно §5 контракта
//   Проводить - Булево       - проводить созданные документы (по умолчанию по полю Проведен JSON)
//
// Возвращаемое значение:
//   Структура - {
//     ИдентификаторПакета - Строка
//     Статус              - ПеречислениеСсылка.TL_СтатусПакета
//     Документы           - Массив ссылок на созданные/обновлённые документы БП
//     Ошибки              - Массив строк (краткие сообщения для UI)
//     ВсегоДокументов     - Число (в исходном пакете)
//     ВсегоНСИ            - Число
//   }
//
Функция ОбработатьПакет(Пакет, Проводить = Истина) Экспорт

	Результат = Новый Структура(
		"ИдентификаторПакета, Статус, Документы, Ошибки, ВсегоДокументов, ВсегоНСИ, КонтекстСмены",
		"", Перечисления.TL_СтатусПакета.Получен, Новый Массив, Новый Массив, 0, 0, Неопределено);

	// 1. Валидация структуры пакета
	Валид = TL_HTTPКлиентЦБ.ВалидироватьПакет(Пакет);
	Если Не Валид.Корректен Тогда
		Для Каждого Сообщение Из Валид.Ошибки Цикл
			Результат.Ошибки.Добавить(Сообщение);
		КонецЦикла;
		Результат.Статус = Перечисления.TL_СтатусПакета.Отклонено;
		Возврат Результат;
	КонецЕсли;

	ИдентификаторПакета = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ИдентификаторПакета", "");
	Источник = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Источник", "ЭЛСИ.АЗК ЦБ");
	ВерсияФормата = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ВерсияФормата", "1");
	Результат.ИдентификаторПакета = ИдентификаторПакета;

	// 2. Сверка идемпотентности на уровне пакета
	Если ПакетУжеЗагружен(ИдентификаторПакета) Тогда
		Результат.Ошибки.Добавить("Пакет " + ИдентификаторПакета + " уже загружен ранее");
		Результат.Статус = Перечисления.TL_СтатусПакета.ПринятоЦеликом;
		Возврат Результат;
	КонецЕсли;

	// Извлечь шапку: формат v2 = Смена{}, формат v1 = Пакет.{Период}
	Результат.КонтекстСмены = ИзвлечьКонтекстСмены(Пакет);

	Если Результат.КонтекстСмены <> Неопределено Тогда
		ПериодС = Результат.КонтекстСмены.Открытие;
		ПериодПо = Результат.КонтекстСмены.Закрытие;
	Иначе
		// Обратная совместимость с форматом v1
		ПакетФильтр = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Пакет", Неопределено);
		ПериодС = ПолучитьДатуИзJSON(ПакетФильтр, "ПериодС");
		ПериодПо = ПолучитьДатуИзJSON(ПакетФильтр, "ПериодПо");
	КонецЕсли;

	TL_Сверка.ЗафиксироватьСтартПакета(ИдентификаторПакета, Источник,
		ПериодС, ПериодПо, Результат.КонтекстСмены);

	// Переобработка: чистим прежние ошибки этого пакета, чтобы журнал не накапливал устаревшее
	Попытка
		НаборОшибок = РегистрыСведений.TL_ОшибкиЗагрузки.СоздатьНаборЗаписей();
		НаборОшибок.Отбор.ИдентификаторПакета.Установить(ИдентификаторПакета);
		НаборОшибок.Записать(Истина);
	Исключение
	КонецПопытки;

	// 3. НСИ — обработка справочников до документов
	НСИ = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "НСИ", Новый Массив);
	Если ТипЗнч(НСИ) = Тип("Массив") Тогда
		Результат.ВсегоНСИ = НСИ.Количество();
		Для Каждого Объект Из НСИ Цикл
			ОбработатьЭлементНСИ(Объект, ИдентификаторПакета, Результат);
		КонецЦикла;
	КонецЕсли;

	// 4. Документы
	// production_release обрабатывается всегда — в НЛ ОПЗС создаётся каналом на каждую
	// смену с общепитом (разведка 20.05.2026: 4 ОПЗС за 30.04 на сети без ручных дублей).
	// Без выпуска (Дт 41.02 Кт 44.01) + списания сырья (Дт 44.01 Кт 41.02) закрытие
	// месяца сломается: ингредиенты останутся на 41.02, а готовые блюда уйдут в
	// продажу с отрицательного остатка.
	ДокументыСписок = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Документы", Новый Массив);
	Если ТипЗнч(ДокументыСписок) = Тип("Массив") Тогда
		Результат.ВсегоДокументов = ДокументыСписок.Количество();
		Для Каждого Док Из ДокументыСписок Цикл
			Kind = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Тип", "");
			Если Kind = "purchase" Тогда
				ОбработатьPurchase(Док, ИдентификаторПакета, Проводить, Результат);
			ИначеЕсли Kind = "retail_sale_sidegoods" Тогда
				ОбработатьRetailSale(Док, ИдентификаторПакета, Проводить, Результат);
			ИначеЕсли Kind = "recipe" Тогда
				// B4-синхронизация ТТК из ЦБ ЭЛСИ.АЗК (вариант B общепита).
				// Создаёт/обновляет Справочник.СпецификацииНоменклатуры по UUID блюда.
				ОбработатьРецепт(Док, ИдентификаторПакета, Результат);
			ИначеЕсли Kind = "production_release" Тогда
				// Модель учёта общепита: A = через 44.01 (НЛ, статус-кво), B = прямо
				// на 90.02.1 по ингредиентам (выбор Галины 22.05.2026). При B
				// ОПЗС не создаётся — себестоимость уходит при продаже в ОРП.
				Если ЭтоМодельОбщепитаB() Тогда
					ПропуститьProductionReleaseB(Док, ИдентификаторПакета, Результат);
				Иначе
					ОбработатьProductionRelease(Док, ИдентификаторПакета, Проводить, Результат);
				КонецЕсли;
			ИначеЕсли Kind = "ingredients_writeoff" Тогда
				// Обработчик пока не реализован — фиксируем как неизвестный
				ЗафиксироватьОшибкуKind(Док, Kind, ИдентификаторПакета, Результат);
			ИначеЕсли Kind = "return_purchase" Тогда
				ОбработатьReturnPurchase(Док, ИдентификаторПакета, Проводить, Результат);
			ИначеЕсли Kind = "inventory" Тогда
				ОбработатьInventory(Док, ИдентификаторПакета, Проводить, Результат);
			ИначеЕсли Kind = "gain" Тогда
				ОбработатьGain(Док, ИдентификаторПакета, Проводить, Результат);
			ИначеЕсли Kind = "writeoff" Тогда
				ОбработатьWriteoff(Док, ИдентификаторПакета, Проводить, Результат);
			ИначеЕсли Kind = "transfer" Тогда
				ОбработатьTransfer(Док, ИдентификаторПакета, Проводить, Результат);
			Иначе
				ЗафиксироватьОшибкуKind(Док, Kind, ИдентификаторПакета, Результат);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// 5. Сверка итоговая
	Итоги = TL_Сверка.РассчитатьИтоги(Пакет, Результат.Документы);
	Итоги.Вставить("Источник", Источник);
	Итоги.Вставить("ПериодС", ПериодС);
	Итоги.Вставить("ПериодПо", ПериодПо);

	Статус = TL_Сверка.ОпределитьСтатусПакета(
		Результат.Документы.Количество(),
		Результат.Ошибки.Количество(),
		Результат.ВсегоДокументов);

	Результат.Статус = Статус;
	TL_Сверка.ЗаписатьСверку(ИдентификаторПакета, Итоги, Статус);

	Возврат Результат;

КонецФункции

// Удобная обёртка: прочитать пакет из JSON-файла и передать в ОбработатьПакет.
//
// Возвращает тот же Результат что и ОбработатьПакет. Если файл не удалось
// прочитать — Статус=Отклонено + Ошибки[0]=сообщение чтения.
//
Функция ОбработатьПакетИзФайла(ПутьКФайлу, Проводить = Истина) Экспорт

	Чтение = TL_HTTPКлиентЦБ.ПрочитатьПакетИзФайла(ПутьКФайлу);
	Если ЗначениеЗаполнено(Чтение.Ошибка) Или Чтение.Пакет = Неопределено Тогда
		Результат = Новый Структура(
			"ИдентификаторПакета, Статус, Документы, Ошибки, ВсегоДокументов, ВсегоНСИ, КонтекстСмены",
			"", Перечисления.TL_СтатусПакета.Отклонено, Новый Массив, Новый Массив, 0, 0, Неопределено);
		Результат.Ошибки.Добавить(Чтение.Ошибка);
		Возврат Результат;
	КонецЕсли;

	Возврат ОбработатьПакет(Чтение.Пакет, Проводить);

КонецФункции

// Обработать пакет из готовой JSON-строки (содержимое, не путь к файлу).
// Канал приёмки через внешнее соединение (COM): продюсер ЦБ выгружает смену
// в JSON-строку, она передаётся параметром в gig2018 и обрабатывается в памяти
// сервера — без общей файловой папки между ЦБ и БП ГИГ.
//
// Параметры:
//   ТекстJSON - Строка  - тело пакета согласно §5 контракта
//   Проводить - Булево  - проводить созданные документы (по умолчанию Истина;
//                         для COM-приёмки передавать Ложь — проводит бухгалтер)
//
// Возвращает тот же Результат что и ОбработатьПакет. Если строку не удалось
// разобрать — Статус=Отклонено + Ошибки[0]=сообщение.
//
Функция ОбработатьПакетИзСтроки(ТекстJSON, Проводить = Истина) Экспорт

	Чтение = TL_HTTPКлиентЦБ.ПрочитатьПакетИзСтроки(ТекстJSON);
	Если ЗначениеЗаполнено(Чтение.Ошибка) Или Чтение.Пакет = Неопределено Тогда
		Результат = Новый Структура(
			"ИдентификаторПакета, Статус, Документы, Ошибки, ВсегоДокументов, ВсегоНСИ, КонтекстСмены",
			"", Перечисления.TL_СтатусПакета.Отклонено, Новый Массив, Новый Массив, 0, 0, Неопределено);
		Результат.Ошибки.Добавить(Чтение.Ошибка);
		Возврат Результат;
	КонецЕсли;

	Возврат ОбработатьПакет(Чтение.Пакет, Проводить);

КонецФункции

// Витрина прямого канала: документы, созданные приёмником из ЦБ, за период —
// для левой таблицы «Внутренние данные» формы TL_Загрузка. Источник —
// РегистрСведений.TL_СоответствиеИсточников (источник↔документ+хеш+смена).
// Не обращается к ЦБ: показывает уже созданные документы БП ГИГ.
//
// Параметры:
//   НачалоПериода, КонецПериода - Дата   - период по дате смены
//   КодСтанции                  - Число  - фильтр станции (0 = все)
//
// Возвращаемое значение:
//   ТаблицаЗначений (Документ, ТипДокумента, Статус, Дата, Станция,
//                    НомерСмены, Описание, ИсточникUUID, Проведён)
//   Статус: "Проведён" / "Загружен (не проведён)" / "⚠ Изменён в ЦБ после проведения".
//
Функция ПолучитьВитринуКанала(НачалоПериода, КонецПериода, КодСтанции = 0, ПоказыватьПроведённые = Ложь, ПоказыватьАннулированные = Ложь) Экспорт

	Таб = Новый ТаблицаЗначений;
	Таб.Колонки.Добавить("Документ");
	Таб.Колонки.Добавить("ТипДокумента",  Новый ОписаниеТипов("Строка"));
	Таб.Колонки.Добавить("Статус",        Новый ОписаниеТипов("Строка"));
	Таб.Колонки.Добавить("Дата",          Новый ОписаниеТипов("Дата"));
	Таб.Колонки.Добавить("Станция",       Новый ОписаниеТипов("Число"));
	Таб.Колонки.Добавить("НомерСмены",    Новый ОписаниеТипов("Строка"));
	Таб.Колонки.Добавить("Описание",      Новый ОписаниеТипов("Строка"));
	Таб.Колонки.Добавить("ИсточникUUID",  Новый ОписаниеТипов("Строка"));
	Таб.Колонки.Добавить("Проведён",      Новый ОписаниеТипов("Булево"));
	Таб.Колонки.Добавить("Сумма",         Новый ОписаниеТипов("Число"));
	Таб.Колонки.Добавить("ЕстьРасхождение", Новый ОписаниеТипов("Булево"));
	Таб.Колонки.Добавить("Аннулирован",   Новый ОписаниеТипов("Булево"));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоотвИст.СсылкаОбъект КАК Документ,
	|	СоотвИст.Тип КАК Тип,
	|	СоотвИст.КодАЗС КАК КодАЗС,
	|	СоотвИст.НомерСмены КАК НомерСмены,
	|	СоотвИст.ДатаСмены КАК ДатаСмены,
	|	СоотвИст.ИсточникUUID КАК ИсточникUUID,
	|	СоотвИст.ХешПоследнегоПакета КАК Хеш,
	|	СоотвИст.ДатаПоследнейЗагрузки КАК ДатаЗагрузки
	|ИЗ
	|	РегистрСведений.TL_СоответствиеИсточников КАК СоотвИст
	|ГДЕ
	|	СоотвИст.ДатаСмены МЕЖДУ &НП И &КП
	|	И (&КодСт = 0 ИЛИ СоотвИст.КодАЗС = &КодСт)
	|УПОРЯДОЧИТЬ ПО
	|	СоотвИст.ДатаСмены, СоотвИст.КодАЗС, СоотвИст.НомерСмены";
	Запрос.УстановитьПараметр("НП", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КП", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("КодСт", ?(КодСтанции = Неопределено, 0, КодСтанции));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Выборка.Документ;
		Если Не ЗначениеЗаполнено(Док) Тогда
			Продолжить;
		КонецЕсли;

		Проведён = Ложь;
		Сумма = 0;
		ПометкаУдал = Ложь;
		Попытка Проведён = Док.Проведен; Исключение КонецПопытки;
		Попытка Сумма = Док.СуммаДокумента; Исключение КонецПопытки;
		Попытка ПометкаУдал = Док.ПометкаУдаления; Исключение КонецПопытки;

		// Аннулированные (помечены на удаление — напр. отменённое в ЦБ перемещение):
		// в список дел НЕ показываем — провести их нельзя («помеченный на удаление
		// не может быть проведён»), действий не требуют. Показываем только когда
		// бухгалтер явно включил «Показать аннулированные» — чтобы их можно было
		// отметить и удалить (кнопка «Удалить»/«Зачистить аннулированные»).
		Если ПометкаУдал И Не ПоказыватьАннулированные Тогда
			Продолжить;
		КонецЕсли;

		// Расхождение «изменён в ЦБ после проведения»: обработчик защиты проведённых
		// (ОбработатьЗащитуПроведённого) ставит флаг ИзмененПослеПроведения, когда из ЦБ
		// пришли изменённые данные по уже проведённому документу. Чтение через Попытку —
		// если ресурс ещё не в БД (UpdateDBCfg не сделан), вернётся Ложь.
		ЕстьРасхождение = TL_МаппингЦБ.ПрочитатьФлагРасхождения(Выборка.Тип, Выборка.ИсточникUUID);

		// Левая панель = «список дел»: проведённые и НЕ изменённые в ЦБ скрываем,
		// чтобы бухгалтер видел только то, что требует действия (непроведённые +
		// расхождения). Чекбокс ПоказыватьПроведённые отключает скрытие.
		Если Проведён И Не ПоказыватьПроведённые И Не ЕстьРасхождение Тогда
			Продолжить;
		КонецЕсли;

		Стр = Таб.Добавить();
		Стр.Документ      = Док;
		// Реальный тип документа по метаданным (различаем ОРП-продажу и закупку —
		// в регистре оба под типом источника «Поступление»).
		ИмяМД = "";
		Попытка ИмяМД = Док.Метаданные().Имя; Исключение КонецПопытки;
		Если ИмяМД = "ОтчетОРозничныхПродажах" Тогда
			Стр.ТипДокумента = "ОРП (продажа)";
		ИначеЕсли ИмяМД = "ПоступлениеТоваровУслуг" Тогда
			Стр.ТипДокумента = "Поступление (закупка)";
		ИначеЕсли ИмяМД = "ИнвентаризацияТоваровНаСкладе" Тогда
			Стр.ТипДокумента = "Инвентаризация";
		ИначеЕсли ИмяМД = "ОприходованиеТоваров" Тогда
			Стр.ТипДокумента = "Оприходование";
		ИначеЕсли ИмяМД = "СписаниеТоваров" Тогда
			Стр.ТипДокумента = "Списание";
		ИначеЕсли ИмяМД = "ВозвратТоваровПоставщику" Тогда
			Стр.ТипДокумента = "Возврат поставщику";
		ИначеЕсли ИмяМД = "ПеремещениеТоваров" Тогда
			Стр.ТипДокумента = "Перемещение";
		Иначе
			Стр.ТипДокумента = ?(ЗначениеЗаполнено(ИмяМД), ИмяМД, Строка(Выборка.Тип));
		КонецЕсли;
		Стр.Станция       = ?(ЗначениеЗаполнено(Выборка.КодАЗС), Выборка.КодАЗС, 0);
		Стр.НомерСмены    = СокрЛП(Строка(Выборка.НомерСмены));
		Стр.Дата          = ?(ЗначениеЗаполнено(Выборка.ДатаСмены), Выборка.ДатаСмены, Выборка.ДатаЗагрузки);
		Стр.ИсточникUUID  = Строка(Выборка.ИсточникUUID);
		Стр.Проведён      = Проведён;
		Стр.Сумма         = Сумма;
		Стр.ЕстьРасхождение = ЕстьРасхождение;
		Стр.Аннулирован   = ПометкаУдал;

		Если ПометкаУдал Тогда
			// Аннулирован в ЦБ — доступно только удаление (провести нельзя).
			Стр.Статус = "✖ Аннулирован (к удалению)";
		ИначеЕсли ЕстьРасхождение Тогда
			Стр.Статус = "⚠ Изменён в ЦБ после проведения";
		ИначеЕсли Проведён Тогда
			Стр.Статус = "Проведён";
		Иначе
			Стр.Статус = "Загружен (не проведён)";
		КонецЕсли;

		Стр.Описание = "Смена " + Стр.НомерСмены
			+ ?(Сумма > 0, " · " + Формат(Сумма, "ЧДЦ=2; ЧРГ=' '") + " ₽", "")
			+ " · " + Строка(Док);
	КонецЦикла;

	Возврат Таб;

КонецФункции

// Диагностика отрицательных остатков 41.02 по складу станции с КЛАССИФИКАЦИЕЙ ПРИЧИНЫ.
// Минусы для оценки МПЗ «По средней» — норма в моменте (себестоимость выравнивает
// закрытие месяца), НО если по позиции есть НЕПРОВЕДЁННЫЙ приход — это требует действия
// бухгалтера (провести поступление), а не ожидания закрытия. Функция разделяет эти случаи,
// чтобы бухгалтер понимал «что и почему», а не видел голый минус в ОСВ.
//
// Параметры:
//   Склад - СправочникСсылка.Склады - склад станции (41.02, розница)
//
// Возвращаемое значение:
//   ТаблицаЗначений (Номенклатура, Количество, Сумма, ТребуетДействия, Причина)
//   ТребуетДействия=Истина → есть непроведённый приход; Ложь → норма (закрытие месяца)
//
Функция ДиагностикаОтрицательныхОстатков(Склад) Экспорт

	Таб = Новый ТаблицаЗначений;
	Таб.Колонки.Добавить("Номенклатура");
	Таб.Колонки.Добавить("Количество",     Новый ОписаниеТипов("Число"));
	Таб.Колонки.Добавить("Сумма",          Новый ОписаниеТипов("Число"));
	Таб.Колонки.Добавить("ТребуетДействия", Новый ОписаниеТипов("Булево"));
	Таб.Колонки.Добавить("Причина",        Новый ОписаниеТипов("Строка"));

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Таб;
	КонецЕсли;

	Попытка
		Счёт4102 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.02");

		// Номенклатуры с НЕПРОВЕДЁННЫМ приходом (Поступление/Оприходование) на этом складе —
		// именно они требуют действия (провести), остальные минусы выровняет закрытие месяца.
		НепровПриход = Новый Соответствие;
		Попытка
			ЗапросП = Новый Запрос(
				"ВЫБРАТЬ РАЗЛИЧНЫЕ Т.Номенклатура КАК Ном
				|ИЗ Документ.ПоступлениеТоваровУслуг.Товары КАК Т
				|ГДЕ НЕ Т.Ссылка.Проведен И Т.Ссылка.Склад = &Склад
				|ОБЪЕДИНИТЬ
				|ВЫБРАТЬ РАЗЛИЧНЫЕ Т2.Номенклатура
				|ИЗ Документ.ОприходованиеТоваров.Товары КАК Т2
				|ГДЕ НЕ Т2.Ссылка.Проведен И Т2.Ссылка.Склад = &Склад");
			ЗапросП.УстановитьПараметр("Склад", Склад);
			ВыбП = ЗапросП.Выполнить().Выбрать();
			Пока ВыбП.Следующий() Цикл
				НепровПриход.Вставить(ВыбП.Ном, Истина);
			КонецЦикла;
		Исключение
		КонецПопытки;

		// Отрицательные остатки 41.02 по складу (Субконто1=Номенклатура, Субконто2=Склад)
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Ост.Субконто1 КАК Номенклатура,
			|	Ост.КоличествоОстаток КАК Количество,
			|	Ост.СуммаОстаток КАК Сумма
			|ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет = &Счет, , Субконто2 = &Склад) КАК Ост
			|ГДЕ Ост.КоличествоОстаток < 0
			|УПОРЯДОЧИТЬ ПО Количество ВОЗР");
		Запрос.УстановитьПараметр("Счет", Счёт4102);
		Запрос.УстановитьПараметр("Склад", Склад);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр = Таб.Добавить();
			Стр.Номенклатура = Выборка.Номенклатура;
			Стр.Количество   = Выборка.Количество;
			Стр.Сумма        = Выборка.Сумма;
			Если НепровПриход.Получить(Выборка.Номенклатура) <> Неопределено Тогда
				Стр.ТребуетДействия = Истина;
				Стр.Причина = "Не проведён приход — проведите поступление/оприходование этой позиции";
			Иначе
				Стр.ТребуетДействия = Ложь;
				Стр.Причина = "Норма для «По средней» — выровняется закрытием месяца";
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Диагностика не должна ронять дашборд — возвращаем что собрали
	КонецПопытки;

	Возврат Таб;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ============================================================================
//  ОБРАБОТКА ОДНОГО ЭЛЕМЕНТА НСИ
// ============================================================================

// Обработать элемент НСИ — занести соответствие в TL_СоответствиеИсточников
// либо сгенерировать ошибку, если объект не находится в БП.
//
Процедура ОбработатьЭлементНСИ(Объект, ИдентификаторПакета, Результат)

	Тип = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Тип", "");
	UUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "ИсточникUUID", "");

	Если Тип = "Организация" Тогда
		ИНН = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "ИНН", "");
		Ссылка = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(UUID, ИНН);
		Если Ссылка = Неопределено Тогда
			// Организация-источник (напр. Норд-Лайн) не сопоставлена — маппим на
			// основную организацию ГИГ (документы переведённой станции ведутся от неё).
			Ссылка = TL_МаппингЦБ.ОпределитьОрганизациюПоУмолчанию();
			Если ЗначениеЗаполнено(Ссылка) Тогда
				TL_МаппингЦБ.ЗаписатьСоответствие(
					Перечисления.TL_ТипОбъектаИсточника.Организация, UUID, Ссылка);
			КонецЕсли;
		КонецЕсли;
		Если Ссылка = Неопределено Тогда
			ЗаписатьОшибкуНСИ(ИдентификаторПакета, UUID,
				Перечисления.TL_ТипОбъектаИсточника.Организация,
				Перечисления.TL_ПолеОшибки.Организация,
				"Организация не найдена в БП ГИГ (ИНН=" + ИНН + ")",
				Результат);
		КонецЕсли;

	ИначеЕсли Тип = "Контрагент" Тогда
		ИНН = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "ИНН", "");
		Имя = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Наименование", "");
		КПП = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "КПП", "");
		Ссылка = TL_МаппингЦБ.ПолучитьКонтрагентаПоUUID(UUID, ИНН, Имя, КПП);
		Если Ссылка = Неопределено Тогда
			ЗаписатьОшибкуНСИ(ИдентификаторПакета, UUID,
				Перечисления.TL_ТипОбъектаИсточника.Контрагент,
				Перечисления.TL_ПолеОшибки.Контрагент,
				"Контрагент не найден: " + Имя + " (ИНН=" + ИНН + ")",
				Результат);
		КонецЕсли;

	ИначеЕсли Тип = "Договор" Тогда
		ВладелецUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "ВладелецКонтрагент", "");
		Контрагент = TL_МаппингЦБ.ПолучитьКонтрагентаПоUUID(ВладелецUUID, "");
		Параметры = ПостроитьПараметрыДоговора(Объект);
		Ссылка = TL_МаппингЦБ.ПолучитьДоговорПоUUID(UUID, Контрагент, Параметры);
		Если Ссылка = Неопределено Тогда
			ЗаписатьОшибкуНСИ(ИдентификаторПакета, UUID,
				Перечисления.TL_ТипОбъектаИсточника.Договор,
				Перечисления.TL_ПолеОшибки.Договор,
				"Договор не найден и не создан (Контрагент=" + Строка(Контрагент) + ")",
				Результат);
		КонецЕсли;

	ИначеЕсли Тип = "Склад" Тогда
		Имя = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Наименование", "");
		Ссылка = TL_МаппингЦБ.ПолучитьСкладПоUUID(UUID, Имя);
		Если Ссылка = Неопределено Тогда
			ЗаписатьОшибкуНСИ(ИдентификаторПакета, UUID,
				Перечисления.TL_ТипОбъектаИсточника.Склад,
				Перечисления.TL_ПолеОшибки.Склад,
				"Склад не найден: " + Имя,
				Результат);
		КонецЕсли;

	ИначеЕсли Тип = "Номенклатура" Тогда
		// Автосоздание включено (фаза A4-stand): если не нашли по UUID — создаём
		// карточку из данных НСИ пакета (Наименование, Артикул, СтавкаНДС, Единица).
		// На фазе A3-production вернётся к Получить...ПоUUID и ручному маппингу.
		Ссылка = TL_МаппингЦБ.ПолучитьИлиСоздатьНоменклатуру(UUID, Объект);
		Если Ссылка = Неопределено Тогда
			Имя = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Наименование", "");
			Код = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "КодЦБ", "");
			ЗаписатьОшибкуНСИ(ИдентификаторПакета, UUID,
				Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
				Перечисления.TL_ПолеОшибки.Номенклатура,
				"Номенклатура не создана: " + Имя + " (КодЦБ=" + Код + ")",
				Результат);
		КонецЕсли;

	Иначе
		ЗаписатьОшибкуНСИ(ИдентификаторПакета, UUID,
			Перечисления.TL_ТипОбъектаИсточника.ПустаяСсылка(),
			Перечисления.TL_ПолеОшибки.Прочее,
			"Неизвестный тип НСИ: " + Тип,
			Результат);
	КонецЕсли;

КонецПроцедуры

// ============================================================================
//  ОБРАБОТКА ДОКУМЕНТА kind=purchase
// ============================================================================

Процедура ОбработатьPurchase(Док, ИдентификаторПакета, ПроводитьПоУмолчанию, Результат)

	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Результат.Ошибки.Добавить("Документ без ИсточникUUID — пропущен");
		Возврат;
	КонецЕсли;

	// Проверка ВидОперации (на A3 принимаем только ОтПоставщика)
	ВидОпJSON = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ВидОперации", "");
	Если ВидОпJSON <> "ОтПоставщика" Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Прочее,
			Перечисления.TL_КодОшибкиЗагрузки.ВидОперацииНеСопоставлен,
			ВидОпJSON,
			"Вид операции '" + ВидОпJSON + "' не покрыт A3 (только ОтПоставщика)",
			Результат);
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		// Идемпотентность
		Объект = НайтиИлиСоздатьПоступление(ИсточникUUID);

		// Защита проведённого: бухгалтер уже провёл документ — не перезаписываем сменными
		// данными из ЦБ (иначе затрутся ручные правки/движения). Аннулирование из ЦБ
		// (ПометкаУдаления) — исключение, должно проходить.
		Если ЭтоЗащитаПроведённыхВкл() И Объект.Проведен
			И НЕ TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь) Тогда
			ОтменитьТранзакцию();
			ОбработатьЗащитуПроведённого(Объект, Док,
				Перечисления.TL_ТипОбъектаИсточника.Поступление, ИсточникUUID,
				ИдентификаторПакета, Результат);
			Возврат;
		КонецЕсли;

		// Шапка
		Если Не ЗаполнитьШапкуPurchase(Объект, Док, ИдентификаторПакета,
				ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		// Товары
		ЗаполнитьТоварыPurchase(Объект, Док, ИдентификаторПакета,
			ИсточникUUID, Результат);

		// Запись + пометка удаления.
		// УстановитьПометкуУдаления требует чтобы объект уже был сохранён в БД
		// и не имел незаписанных модификаций — иначе «данные объекта модифицированы».
		// Поэтому: сначала Записать с актуальной шапкой/товарами, потом отдельно пометить.
		ПометкаУдаления = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь);
		ПроведенJSON = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Проведен", Истина);

		Если ПометкаУдаления Тогда
			// Помеченный документ нельзя проводить — пишем без проведения, потом помечаем.
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Объект.УстановитьПометкуУдаления(Истина);
		Иначе
			// Если до этого был помечен — снимаем пометку (через отдельный вызов
			// ДО модификации объекта в этом проходе уже не сработает; платформа
			// корректно сохранит снятие пометки в составе обычной записи).
			Если Объект.ПометкаУдаления Тогда
				// Объект уже заполнен шапкой/товарами выше → снять пометку сразу нельзя
				// («данные объекта модифицированы»). Сначала записать (сброс флага
				// модификации), затем снять пометку; ниже — перечитывание/перезаполнение.
				Объект.Записать(РежимЗаписиДокумента.Запись);
				Объект.УстановитьПометкуУдаления(Ложь);
				// После УстановитьПометкуУдаления объект может быть устаревшим — перечитываем
				Объект = Объект.Ссылка.ПолучитьОбъект();
				// Перезаполняем шапку и товары
				Если Не ЗаполнитьШапкуPurchase(Объект, Док, ИдентификаторПакета,
						ИсточникUUID, Результат) Тогда
					ОтменитьТранзакцию();
					Возврат;
				КонецЕсли;
				ЗаполнитьТоварыPurchase(Объект, Док, ИдентификаторПакета,
					ИсточникUUID, Результат);
			КонецЕсли;
			Если ПроводитьПоУмолчанию = Ложь Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			ИначеЕсли ПроведенJSON Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			Иначе
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;
			Объект.Записать(РежимЗаписи);
		КонецЕсли;

		// Регистрация соответствия
		TL_МаппингЦБ.ЗаписатьСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			ИсточникUUID, Объект.Ссылка, ИдентификаторПакета,
			ВычислитьХешДокумента(Док), Результат.КонтекстСмены);

		Результат.Документы.Добавить(Объект.Ссылка);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Текст = ОписаниеОшибки();
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Прочее,
			Перечисления.TL_КодОшибкиЗагрузки.ОшибкаПроведения,
			"",
			"Ошибка проведения: " + Текст,
			Результат);
	КонецПопытки;

КонецПроцедуры

// Найти существующий документ или создать новый.
//
Функция НайтиИлиСоздатьПоступление(ИсточникUUID)

	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Поступление, ИсточникUUID);

	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Возврат Объект;
		КонецЕсли;
	КонецЕсли;

	Возврат Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();

КонецФункции

// Заполнить шапку. Возвращает Истина при успехе, Ложь при ошибке маппинга.
//
Функция ЗаполнитьШапкуPurchase(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Объект.Дата = ПолучитьДатуИзJSON(Док, "Дата");

	// Организация
	ОрганизацияUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Организация", "");
	Орг = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(ОрганизацияUUID);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		// Страховка: организация-источник не сопоставлена — основная организация ГИГ.
		Орг = TL_МаппингЦБ.ОпределитьОрганизациюПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Орг) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Организация,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОрганизацияUUID,
			"Организация не найдена по UUID " + ОрганизацияUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Организация = Орг;

	// Контрагент
	КонтрагентUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Контрагент", "");
	Контр = TL_МаппингЦБ.ПолучитьКонтрагентаПоUUID(КонтрагентUUID);
	Если Не ЗначениеЗаполнено(Контр) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Контрагент,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			КонтрагентUUID,
			"Контрагент не найден по UUID " + КонтрагентUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Контрагент = Контр;

	// Договор
	ДоговорUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ДоговорКонтрагента", "");
	Если ЗначениеЗаполнено(ДоговорUUID) Тогда
		Договор = TL_МаппингЦБ.ПолучитьДоговорПоUUID(ДоговорUUID, Контр, Неопределено);
		Если ЗначениеЗаполнено(Договор) Тогда
			Объект.ДоговорКонтрагента = Договор;
		КонецЕсли;
	КонецЕсли;

	// Склад
	СкладUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Склад", "");
	Склад = TL_МаппингЦБ.ПолучитьСкладПоUUID(СкладUUID);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			СкладUUID,
			"Склад не найден по UUID " + СкладUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Склад = Склад;

	// Сумма / валюта / флаги НДС
	Объект.СуммаДокумента = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаДокумента", 0);
	УстановитьРеквизитБезопасно(Объект, "ВалютаДокумента", ПолучитьВалютуRUB());
	УстановитьРеквизитБезопасно(Объект, "СуммаВключаетНДС",
		TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаВключаетНДС", Истина));
	УстановитьРеквизитБезопасно(Объект, "НДСВключенВСтоимость", Ложь);
	УстановитьРеквизитБезопасно(Объект, "НДСНеВыделять", Ложь);

	// Вид операции БП
	ВидОпБП = TL_МаппингЦБ.СопоставитьВидОперацииПоступление(
		TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ВидОперации", ""));
	Объект.ВидОперации = ВидОпБП;

	// Счета расчётов в шапке
	УстановитьРеквизитБезопасно(Объект, "СчетУчетаРасчетовСКонтрагентом",
		TL_МаппингЦБ.ОпределитьСчётРасчётовКонтрагент());
	УстановитьРеквизитБезопасно(Объект, "СчетУчетаРасчетовПоАвансам",
		TL_МаппингЦБ.ОпределитьСчётРасчётовАвансы());

	// Способ зачёта авансов — «Автоматически» (требование учёта ГИГ). Обёрнуто в
	// Попытку: типовое перечисление БП 3.0, но не роняем приёмку если релиз иной.
	Попытка
		УстановитьРеквизитБезопасно(Объект, "СпособЗачетаАвансов",
			Перечисления.СпособыЗачетаАвансов.Автоматически);
	Исключение
	КонецПопытки;

	// Входящий документ
	НомерВх = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "НомерВходящегоДокумента", "");
	ДатаВх  = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ДатаВходящегоДокумента", "");
	Если ЗначениеЗаполнено(НомерВх) Тогда
		УстановитьРеквизитБезопасно(Объект, "НомерВходящегоДокумента", НомерВх);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаВх) Тогда
		Попытка
			УстановитьРеквизитБезопасно(Объект, "ДатаВходящегоДокумента",
				XMLЗначение(Тип("Дата"), Строка(ДатаВх)));
		Исключение
		КонецПопытки;
	КонецЕсли;

	// Комментарий с префиксом TL|ЦБ|<пакет>|<UUID>
	Объект.Комментарий = ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат);

	Возврат Истина;

КонецФункции

// Заполнить табличную часть Товары.
//
Процедура ЗаполнитьТоварыPurchase(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Товары = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Товары", Новый Массив);
	Если ТипЗнч(Товары) <> Тип("Массив") Тогда
		ВызватьИсключение "Поле Товары отсутствует или не массив";
	КонецЕсли;

	Объект.Товары.Очистить();

	СчётТовара = TL_МаппингЦБ.ОпределитьСчётУчётаТовара("purchase", "Сопутка");
	СчётНДС    = TL_МаппингЦБ.ОпределитьСчётНДС();

	Для Каждого СтрJSON Из Товары Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);

		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "Номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;

		Стр = Объект.Товары.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Количество   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);
		Стр.Цена         = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена", 0);
		Стр.Сумма        = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Сумма", 0);

		ИмяСтавки = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "СтавкаНДС", "");
		СтавкаНДС = TL_МаппингЦБ.СопоставитьСтавкуНДС(ИмяСтавки);
		Если ЗначениеЗаполнено(СтавкаНДС) Тогда
			Стр.СтавкаНДС = СтавкаНДС;
		Иначе
			ВызватьИсключение "Ставка НДС '" + ИмяСтавки + "' не сопоставлена";
		КонецЕсли;

		Стр.СуммаНДС = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "СуммаНДС", 0);

		УстановитьРеквизитБезопасно(Стр, "СчетУчета",    СчётТовара);
		УстановитьРеквизитБезопасно(Стр, "СчетУчетаНДС", СчётНДС);
	КонецЦикла;

КонецПроцедуры

// ============================================================================
//  ОБРАБОТКА ДОКУМЕНТА kind=retail_sale_sidegoods
// ============================================================================
//
// Розничная продажа сопутки. Источник в ЦБ ЭЛСИ.АЗК — Документ.ОтчетОРозничныхПродажах
// с массовой ТЧ Товары (НДС10 + НДС22 mixed) и оплатами через ФормаОплаты
// (Карты МПС, Наличные, МИР, ...).
//
// Приёмник в БП ГИГ: Документ.ОтчетОРозничныхПродажах с ВидОперации=ОтчетНТТОПродажах.
// Проводки:
//   Дт 62.Р Кт 90.01.1 — выручка
//   Дт 90.02.1 Кт 41.02 — себестоимость
//   Дт 90.03 Кт 68.02 — НДС
//   Дт 50.01 Кт 62.Р — наличные через кассу (СчетКасса в шапке)
//   Дт 57.03 Кт 62.Р — безнал через эквайринг (создаётся типовой логикой по ТЧ Оплата)
//
// Только безналичные оплаты идут в ТЧ Оплата. Наличные = СуммаДокумента − Σ(ТЧ Оплата),
// проводятся через СчетКасса=50.01 в шапке (типовая логика БП 3.0).
//
// РЕЖИМ РАЗДЕЛЬНОГО УЧЁТА (TL_Настройки.РежимРаздельногоУчёта() = Истина):
//   Один retail_sale_sidegoods из пакета должен порождать ДВА ОРП в БП ГИГ:
//     1) только сопутка (товары не из ВыпускБлюд этого пакета)
//     2) только готовая продукция общепита (товары, совпадающие по UUID
//        с production_release.ВыпускБлюд того же пакета)
//   Разделение даёт раздельный анализ выручки/маржи через НоменклатурнуюГруппу
//   ("Сопутка" / "Общепит") или Подразделение.
//   Пока НЕ реализовано: требует доступа к контексту пакета (production_release
//   нужен здесь, а сейчас передаётся только один Док). На время оставляем один
//   сводный ОРП (как у Норд-Лайн); флаг есть, но пока влияет только на UI/легенду.
//
Процедура ОбработатьRetailSale(Док, ИдентификаторПакета, ПроводитьПоУмолчанию, Результат)

	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Результат.Ошибки.Добавить("retail_sale: документ без ИсточникUUID — пропущен");
		Возврат;
	КонецЕсли;

	// TODO раздельный учёт: при TL_Настройки.РежимРаздельногоУчёта() = Истина —
	// разделить ТЧ Товары на сопутку и готовую продукцию общепита, создать ДВА
	// ОРП. См. комментарий процедуры. Требует доступа к ВыпускБлюд из
	// production_release того же пакета.
	Если TL_Настройки.РежимРаздельногоУчёта() Тогда
		ЗаписьЖурналаРегистрации("TL_СопуткаСервис",
			УровеньЖурналаРегистрации.Информация, , ,
			"Пакет " + ИдентификаторПакета + ": режим раздельного учёта ВКЛ, "
			+ "но разделение retail_sale_sidegoods на 2 ОРП пока не реализовано. "
			+ "Документ обрабатывается как один сводный ОРП.");
	КонецЕсли;

	// Вариант A: ДО транзакции ОРП собрать блюда в Комплектации (сборка из ингредиентов
	// по ТТК). Вне транзакции ОРП — чтобы партии блюда были зафиксированы и видны
	// проведению ОРП, без вложенности транзакций. Сборка идёт и по времени, и по коду
	// РАНЬШЕ ОРП → правильный порядок «Комплектация → ОРП».
	// Разбор возвратов (Разукомплектация) генерируется НИЖЕ, ПОСЛЕ проведения ОРП —
	// он должен идти после того, как ОРП-возврат вернул блюдо на склад 41.02.
	// Аннулированный в ЦБ документ (ПометкаУдаления) не порождает сборку блюд.
	ПометкаУдаленияJSON = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь);
	ОРПЗаписан = Ложь;
	Если ЭтоВариантКомплектацияБлюд() И НЕ ПометкаУдаленияJSON Тогда
		// Обёрнуто в Попытку (симметрично разбору ниже) — сбой сборки не должен ронять
		// весь пакет: ОРП всё равно проведётся, просто без собранной себестоимости.
		Попытка
			Выпуск = СобратьВыпускБлюдИзRetailSale(Док, Результат);
			СгенерироватьКомплектацииБлюд(Док, ИсточникUUID, Выпуск,
				ИдентификаторПакета, ПроводитьПоУмолчанию, Результат);
		Исключение
			ЗаписатьОшибкуНСИ(ИдентификаторПакета, ИсточникUUID,
				Перечисления.TL_ТипОбъектаИсточника.Номенклатура, Перечисления.TL_ПолеОшибки.Прочее,
				"Сборка блюд смены: " + ОписаниеОшибки(), Результат);
		КонецПопытки;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Объект = НайтиИлиСоздатьОРП(ИсточникUUID);

		// Защита проведённого: бухгалтер уже провёл ОРП — не перезаписываем сменными
		// данными из ЦБ (иначе затрутся ручные правки/движения). Аннулирование (ПометкаУдаления)
		// проходит. Сборка блюд выше идемпотентна и сама защищает проведённые Комплектации.
		Если ЭтоЗащитаПроведённыхВкл() И Объект.Проведен И НЕ ПометкаУдаленияJSON Тогда
			ОтменитьТранзакцию();
			ОбработатьЗащитуПроведённого(Объект, Док,
				Перечисления.TL_ТипОбъектаИсточника.Поступление, ИсточникUUID,
				ИдентификаторПакета, Результат);
			Возврат;
		КонецЕсли;

		Если Не ЗаполнитьШапкуRetailSale(Объект, Док, ИдентификаторПакета,
				ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		Если Не ЗаполнитьТоварыRetailSale(Объект, Док, ИдентификаторПакета,
				ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		ЗаполнитьОплатуRetailSale(Объект, Док, ИдентификаторПакета,
			ИсточникUUID, Результат);

		ЗаполнитьВозвратыRetailSale(Объект, Док, ИдентификаторПакета,
			ИсточникUUID, Результат);

		ПометкаУдаления = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь);
		ПроведенJSON   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Проведен", Истина);

		Если ПометкаУдаления Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Объект.УстановитьПометкуУдаления(Истина);
			// Каскад: парные Комплектации/Разукомплектации блюд смены тоже аннулировать,
			// иначе собранное блюдо повиснет на 41.02 без продажи (склад разъедется).
			Если ЭтоВариантКомплектацияБлюд() Тогда
				АннулироватьСборкуБлюд(ИсточникUUID);
			КонецЕсли;
		Иначе
			Если Объект.ПометкаУдаления Тогда
				// Объект уже заполнен шапкой/товарами выше → снять пометку сразу нельзя
				// («данные объекта модифицированы»). Сначала записать (сброс флага
				// модификации), затем снять пометку; ниже — перечитывание/перезаполнение.
				Объект.Записать(РежимЗаписиДокумента.Запись);
				Объект.УстановитьПометкуУдаления(Ложь);
				Объект = Объект.Ссылка.ПолучитьОбъект();
				Если Не ЗаполнитьШапкуRetailSale(Объект, Док, ИдентификаторПакета,
						ИсточникUUID, Результат) Тогда
					ОтменитьТранзакцию();
					Возврат;
				КонецЕсли;
				ЗаполнитьТоварыRetailSale(Объект, Док, ИдентификаторПакета,
					ИсточникUUID, Результат);
				ЗаполнитьОплатуRetailSale(Объект, Док, ИдентификаторПакета,
					ИсточникUUID, Результат);
				ЗаполнитьВозвратыRetailSale(Объект, Док, ИдентификаторПакета,
					ИсточникUUID, Результат);
			КонецЕсли;
			Если ПроводитьПоУмолчанию = Ложь Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			ИначеЕсли ПроведенJSON Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			Иначе
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;
			Объект.Записать(РежимЗаписи);
			ОРПЗаписан = Истина; // разбор возвратов генерируем ПОСЛЕ ОРП (Вариант A)
		КонецЕсли;

		// Раскладка блюд общепита → регистр TL_РаскладкаБлюд (только для ОРП; для прочих
		// документов РаскладкаБлюд не заполнена — процедура сразу выйдет).
		ЗаписатьРаскладкуБлюд(Объект.Ссылка, Результат);

		TL_МаппингЦБ.ЗаписатьСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			ИсточникUUID, Объект.Ссылка, ИдентификаторПакета,
			ВычислитьХешДокумента(Док), Результат.КонтекстСмены);

		Результат.Документы.Добавить(Объект.Ссылка);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Текст = ОписаниеОшибки();
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Прочее,
			Перечисления.TL_КодОшибкиЗагрузки.ОшибкаПроведения,
			"",
			"Ошибка проведения retail_sale: " + Текст,
			Результат);
	КонецПопытки;

	// Разбор возвратов блюд — генерируем ПОСЛЕ обработки ОРП (блюдо-возврат уже вернулось
	// на 41.02 проведением ОРП). Разукомплектация: Дт 41.02 ингредиенты ← Кт 41.02 блюдо.
	// Так гарантируется порядок ОРП → Разукомплектация даже при автопроведении
	// (Проводить=Истина). При Проводить=Ложь разбор пишется непроведённым, витрина
	// проведёт его после ОРП. Гейт ОРПЗаписан — не создавать разбор, если ОРП упал.
	Если ЭтоВариантКомплектацияБлюд() И ОРПЗаписан Тогда
		Попытка
			Разбор = СобратьРазборБлюдИзRetailSale(Док, Результат);
			СгенерироватьРазукомплектацииБлюд(Док, ИсточникUUID, Разбор,
				ИдентификаторПакета, ПроводитьПоУмолчанию, Результат);
		Исключение
			// ОРП уже проведён — ошибка разбора не должна ронять пакет.
			ЗаписатьОшибкуНСИ(ИдентификаторПакета, "",
				Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
				Перечисления.TL_ПолеОшибки.Прочее,
				"Разбор возвратов блюд: " + ОписаниеОшибки(), Результат);
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Найти существующий ОРП по соответствию или создать новый.
//
Функция НайтиИлиСоздатьОРП(ИсточникUUID)

	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Поступление, ИсточникUUID);

	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Возврат Объект;
		КонецЕсли;
	КонецЕсли;

	Возврат Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();

КонецФункции

// Заполнить шапку ОРП. Возвращает Истина при успехе.
//
Функция ЗаполнитьШапкуRetailSale(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Объект.Дата = ПолучитьДатуИзJSON(Док, "Дата");
	// БП ГИГ 3.0.194.18: розница активного пилота (АКЗС-5, Первомайское-4) работает
	// через ОтчетККМОПродажах без явной КассаККМ. См. эталон от 2026-05-05 АКЗС-5.
	Объект.ВидОперации = Перечисления.ВидыОперацийОтчетОРозничныхПродажах.ОтчетККМОПродажах;

	// Организация
	ОрганизацияUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Организация", "");
	Орг = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(ОрганизацияUUID);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		// Страховка: организация-источник не сопоставлена — основная организация ГИГ.
		Орг = TL_МаппингЦБ.ОпределитьОрганизациюПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Орг) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Организация,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОрганизацияUUID,
			"Организация не найдена по UUID " + ОрганизацияUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Организация = Орг;

	// Склад
	СкладUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Склад", "");
	Склад = TL_МаппингЦБ.ПолучитьСкладПоUUID(СкладUUID);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			СкладUUID,
			"Склад не найден по UUID " + СкладUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Склад = Склад;

	// Подразделение по складу (или из JSON напрямую если задано)
	ПодразделениеImpl = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Подразделение", "");
	Если ЗначениеЗаполнено(ПодразделениеImpl) Тогда
		Подразделение = TL_МаппингЦБ.ПолучитьПодразделениеПоСкладу(ПодразделениеImpl);
	Иначе
		Подразделение = TL_МаппингЦБ.ПолучитьПодразделениеПоСкладу(Склад);
	КонецЕсли;
	УстановитьРеквизитБезопасно(Объект, "ПодразделениеОрганизации", Подразделение);

	// Сумма / валюта / флаги
	Объект.СуммаДокумента = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаДокумента", 0);
	УстановитьРеквизитБезопасно(Объект, "ВалютаДокумента", ПолучитьВалютуRUB());
	УстановитьРеквизитБезопасно(Объект, "СуммаВключаетНДС", Истина);

	// Касса для наличных
	УстановитьРеквизитБезопасно(Объект, "СчетКасса", TL_МаппингЦБ.ОпределитьСчётКассы());
	УстановитьРеквизитБезопасно(Объект, "СтатьяДвиженияДенежныхСредств",
		TL_МаппингЦБ.ОпределитьСтатьюДДСРозница());

	// Комментарий с префиксом TL|ЦБ|<пакет>|<UUID> — для поиска и идемпотентности
	Объект.Комментарий = ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат);

	Возврат Истина;

КонецФункции

// Заполнить ТЧ Товары. Возвращает Истина если все строки добавлены.
//
// В модели B (общепит = списание на 90.02.1 по ингредиентам) при флаге
// "ЭтоБлюдо": true для строки JSON — блюдо заменяется на список ингредиентов
// по активной СпецификацииНоменклатуры (синхронизированной из ЦБ через kind=recipe).
// Цена/сумма/НДС блюда сохраняются на ПЕРВОЙ строке ингредиента (для выручки),
// остальные строки идут с нулевой ценой (только списание со склада).
//
Функция ЗаполнитьТоварыRetailSale(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Товары = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Товары", Новый Массив);
	Если ТипЗнч(Товары) <> Тип("Массив") Тогда
		ВызватьИсключение "Поле Товары отсутствует или не массив";
	КонецЕсли;

	Объект.Товары.Очистить();

	// Накопитель раскладки блюд (ингредиент→блюдо) для регистра TL_РаскладкаБлюд.
	// Пересоздаём на каждый ОРП (Результат — общий на пакет).
	Результат.Вставить("РаскладкаБлюд", Новый Массив);

	СчётТовара  = TL_МаппингЦБ.ОпределитьСчётУчётаТовара("retail_sale_sidegoods", "Сопутка");
	СчётДохода  = TL_МаппингЦБ.ОпределитьСчётДоходов();
	СчётРасхода = TL_МаппингЦБ.ОпределитьСчётРасходов();
	СчётНДСРеал = TL_МаппингЦБ.ОпределитьСчётНДСРеализация();
	ГруппаСопутка = TL_МаппингЦБ.ОпределитьНоменклатурнуюГруппуСопутка();
	МодельB     = ЭтоМодельОбщепитаB();
	ВариантКомпл = ЭтоВариантКомплектацияБлюд(); // блюдо одной строкой + Комплектация
	ФорсНДС22    = ФорсироватьНДС22Розницы();     // розница ГИГ = товар с НДС 22%

	Для Каждого СтрJSON Из Товары Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "Номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;

		ЭтоБлюдо   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "ЭтоБлюдо", Ложь);
		КлассSKU   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "КлассSKU", "");
		Количество = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);
		Цена       = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена", 0);
		Сумма      = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Сумма", 0);
		ИмяСтавки  = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "СтавкаНДС", "");
		СтавкаНДС  = TL_МаппингЦБ.СопоставитьСтавкуНДС(ИмяСтавки);
		// Форс НДС 22% для розницы ГИГ (перекрывает аномальные 18%/5% из ЦБ) — до
		// проверки заполнения, чтобы кривая ставка из пакета не роняла загрузку.
		Если ФорсНДС22 Тогда
			СтавкаНДС = Перечисления.СтавкиНДС.НДС22;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
			ВызватьИсключение "Ставка НДС '" + ИмяСтавки + "' не сопоставлена";
		КонецЕсли;
		СуммаНДС   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "СуммаНДС", 0);
		Если ФорсНДС22 Тогда
			СуммаНДС = РассчитатьНДС22(Сумма);
		КонецЕсли;

		// Вариант A: блюдо продаётся ОДНОЙ строкой (стандартная ветка ниже) как товар,
		// а себестоимость собирается отдельным документом Комплектация. Здесь только
		// наполняем РаскладкаБлюд (группировка ингредиентов под блюдом в карточке/учёте).
		Если ВариантКомпл И (ЭтоБлюдо ИЛИ ВРег(СокрЛП(КлассSKU)) = МаркерОбщепит()) Тогда
			Раскл = РазвернутьБлюдоНаИнгредиенты(Номенклатура, Количество);
			Если Раскл.Покрыто Тогда
				Для Каждого Ингр Из Раскл.Ингредиенты Цикл
					Результат.РаскладкаБлюд.Добавить(Новый Структура("Ингредиент, Блюдо",
						Ингр.Номенклатура, Раскл.Блюдо));
				КонецЦикла;
			КонецЕсли;
			// Блюдо без ТТК: предупреждение пишет ГенерироватьДокументыБлюд (здесь НЕ дублируем,
			// иначе +2 к счётчику ошибок → пакет никогда не «ПринятоЦеликом» → вечный пересинк).
			// НЕ Продолжить — блюдо падает в стандартную ветку (одной строкой с полной Суммой).

		// Модель B (без комплектации): раскладываем на ингредиенты по ТТК прямо в ОРП
		ИначеЕсли МодельB И (ЭтоБлюдо ИЛИ ВРег(СокрЛП(КлассSKU)) = МаркерОбщепит()) Тогда
			Раскладка = РазвернутьБлюдоНаИнгредиенты(Номенклатура, Количество);
			Если Раскладка.Покрыто Тогда
				Первая = Истина;
				Для Каждого Ингр Из Раскладка.Ингредиенты Цикл
					СтрИ = Объект.Товары.Добавить();
					СтрИ.Номенклатура = Ингр.Номенклатура;
					СтрИ.Количество   = Ингр.Количество;
					// Выручка/НДС идут на ПЕРВУЮ строку — суммарная цена блюда.
					// На остальных строках Цена=0 (только списание со склада).
					Если Первая Тогда
						СтрИ.Цена     = Цена;
						СтрИ.Сумма    = Сумма;
						СтрИ.СтавкаНДС = СтавкаНДС;
						СтрИ.СуммаНДС = СуммаНДС;
						Первая = Ложь;
					Иначе
						СтрИ.Цена     = 0;
						СтрИ.Сумма    = 0;
						СтрИ.СтавкаНДС = СтавкаНДС;
						СтрИ.СуммаНДС = 0;
					КонецЕсли;
					УстановитьРеквизитБезопасно(СтрИ, "СчетУчета",                 СчётТовара);
					УстановитьРеквизитБезопасно(СтрИ, "СчетДоходов",               СчётДохода);
					УстановитьРеквизитБезопасно(СтрИ, "СчетРасходов",              СчётРасхода);
					УстановитьРеквизитБезопасно(СтрИ, "СчетУчетаНДСПоРеализации", СчётНДСРеал);
					УстановитьРеквизитБезопасно(СтрИ, "Субконто",                 ГруппаСопутка);
					// Связь «ингредиент → блюдо» — в регистр TL_РаскладкаБлюд (пишется
					// после записи документа). Не трогает строку ОРП и проводки; нужна,
					// чтобы в учёте и карточке ингредиенты группировались под блюдом «Кофе».
					Результат.РаскладкаБлюд.Добавить(Новый Структура("Ингредиент, Блюдо",
						Ингр.Номенклатура, Раскладка.Блюдо));
				КонецЦикла;
				Продолжить; // блюдо обработано — переходим к следующей строке JSON
			Иначе
				// Раскладка не удалась — пишем предупреждение, продолжаем как товар
				ЗаписатьОшибкуНСИ(ИдентификаторПакета, НоменклатураUUID,
					Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
					Перечисления.TL_ПолеОшибки.Прочее,
					"retail_sale (B): блюдо «" + Строка(Номенклатура) + "» не раскрыто — "
					+ Раскладка.Ошибка + ". Списано как товар.", Результат);
			КонецЕсли;
		КонецЕсли;

		// Стандартная обработка (товар, либо блюдо в модели A, либо блюдо при провале раскладки)
		Стр = Объект.Товары.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Количество   = Количество;
		Стр.Цена         = Цена;
		Стр.Сумма        = Сумма;
		Стр.СтавкаНДС    = СтавкаНДС;
		Стр.СуммаНДС     = СуммаНДС;

		УстановитьРеквизитБезопасно(Стр, "СчетУчета",                 СчётТовара);
		УстановитьРеквизитБезопасно(Стр, "СчетДоходов",               СчётДохода);
		УстановитьРеквизитБезопасно(Стр, "СчетРасходов",              СчётРасхода);
		УстановитьРеквизитБезопасно(Стр, "СчетУчетаНДСПоРеализации", СчётНДСРеал);
		УстановитьРеквизитБезопасно(Стр, "Субконто",                 ГруппаСопутка);
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Заполнить ТЧ Оплата — только безналичные оплаты.
// Наличные = СуммаДокумента − Σ(ТЧ Оплата), не отражаются в ТЧ.
//
Процедура ЗаполнитьОплатуRetailSale(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Оплаты = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Оплаты", Новый Массив);
	Если ТипЗнч(Оплаты) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Объект.Оплата.Очистить();

	Для Каждого СтрОплат Из Оплаты Цикл
		Имя = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрОплат, "ВидОплаты", "");
		Сумма = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрОплат, "Сумма", 0);

		// Наличные пропускаем — они отражаются автоматически через СчетКасса
		Если СокрЛП(Имя) = "Наличные" ИЛИ Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		ВидОплаты = TL_МаппингЦБ.СопоставитьВидОплатыРозница(Имя);
		Если Не ЗначениеЗаполнено(ВидОплаты) Тогда
			// Записываем ошибку маппинга вида оплаты, но не прерываем —
			// сумма станет «наличными» по факту разности.
			ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
				Перечисления.TL_ТипОбъектаИсточника.Поступление,
				Перечисления.TL_ПолеОшибки.Прочее,
				Перечисления.TL_КодОшибкиЗагрузки.Прочее,
				Имя,
				"Вид оплаты '" + Имя + "' не сопоставлен — сумма " + Сумма + " ушла в наличные",
				Результат);
			Продолжить;
		КонецЕсли;

		СтрТЧ = Объект.Оплата.Добавить();
		СтрТЧ.ВидОплаты   = ВидОплаты;
		СтрТЧ.СуммаОплаты = Сумма;
	КонецЦикла;

КонецПроцедуры

// Заполнить ТЧ Возвраты + ВозвратОплаты (если есть в JSON).
//
Процедура ЗаполнитьВозвратыRetailSale(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Возвраты = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ВозвращенныеТовары", Новый Массив);
	Если ТипЗнч(Возвраты) <> Тип("Массив") ИЛИ Возвраты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Объект.Возвраты.Очистить();

	СчётТовара  = TL_МаппингЦБ.ОпределитьСчётУчётаТовара("retail_sale_sidegoods", "Сопутка");
	СчётДохода  = TL_МаппингЦБ.ОпределитьСчётДоходов();
	СчётРасхода = TL_МаппингЦБ.ОпределитьСчётРасходов();
	СчётНДСРеал = TL_МаппингЦБ.ОпределитьСчётНДСРеализация();
	ГруппаСопутка = TL_МаппингЦБ.ОпределитьНоменклатурнуюГруппуСопутка();

	Для Каждого СтрJSON Из Возвраты Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "Возврат: Номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;
		Стр = Объект.Возвраты.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Количество   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);
		Стр.Цена         = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена", 0);
		Стр.Сумма        = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Сумма", 0);

		// ДатаРеализации — ОБЯЗАТЕЛЬНЫЙ реквизит ТЧ Возвраты: без него ОРП с возвратами
		// не проходит ПроверкуЗаполнения и не проводится. Дефолт — дата ОРП; из ЦБ может
		// прийти дата исходной продажи (поле «ДатаРеализации»).
		ДатаРеал = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "ДатаРеализации", "");
		Если ЗначениеЗаполнено(ДатаРеал) Тогда
			Попытка
				Стр.ДатаРеализации = XMLЗначение(Тип("Дата"), Строка(ДатаРеал));
			Исключение
				Стр.ДатаРеализации = Объект.Дата;
			КонецПопытки;
		Иначе
			Стр.ДатаРеализации = Объект.Дата;
		КонецЕсли;

		ИмяСтавки = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "СтавкаНДС", "");
		СтавкаНДС = TL_МаппингЦБ.СопоставитьСтавкуНДС(ИмяСтавки);
		// Форс НДС 22% для розницы ГИГ — симметрично продаже (ЗаполнитьТоварыRetailSale)
		Если ФорсироватьНДС22Розницы() Тогда
			СтавкаНДС = Перечисления.СтавкиНДС.НДС22;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
			ВызватьИсключение "Возврат: ставка НДС '" + ИмяСтавки + "' не сопоставлена";
		КонецЕсли;
		Стр.СтавкаНДС = СтавкаНДС;
		Если ФорсироватьНДС22Розницы() Тогда
			Стр.СуммаНДС = РассчитатьНДС22(Стр.Сумма);
		Иначе
			Стр.СуммаНДС = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "СуммаНДС", 0);
		КонецЕсли;

		УстановитьРеквизитБезопасно(Стр, "СчетУчета",                 СчётТовара);
		УстановитьРеквизитБезопасно(Стр, "СчетДоходов",               СчётДохода);
		УстановитьРеквизитБезопасно(Стр, "СчетРасходов",              СчётРасхода);
		УстановитьРеквизитБезопасно(Стр, "СчетУчетаНДСПоРеализации", СчётНДСРеал);
		УстановитьРеквизитБезопасно(Стр, "Субконто",                 ГруппаСопутка);
	КонецЦикла;

КонецПроцедуры

// ============================================================================
//  ВАРИАНТ A ОБЩЕПИТА: сборка/разбор блюда через Документ.КомплектацияНоменклатуры
// ============================================================================
//
// Блюдо продаётся ОДНОЙ строкой ОРП как товар; себестоимость собирается из
// ингредиентов по ТТК отдельным документом Комплектация (Дт 41.02 блюдо ← Кт 41.02
// ингредиенты). Возврат зеркалится Разукомплектацией. Документы пишутся
// НЕпроведёнными — проводит бухгалтер в порядке Комплектация → ОРП → Разукомплектация.
// Идемпотентность — через TL_РегистрСтатусов (ключ = Комментарий документа).

// Маркеры/префиксы (константы) — чтобы формирование и поиск ключа не разъезжались.
Функция МаркерОбщепит()       Возврат "ОБЩЕПИТ";        КонецФункции
Функция ПрефиксКлючаВыпуск()  Возврат "TL|ВЫПУСКБЛЮД|"; КонецФункции
Функция ПрефиксКлючаРазбор()  Возврат "TL|РАЗБОРБЛЮД|"; КонецФункции

// Число из JSON-значения (может прийти строкой) — безопасно, дефолт 0.
// ВАЖНО: имя параметра НЕ "Знач" — это зарезервированное слово (модификатор
// передачи по значению), иначе ScriptCompileError «Ожидается имя формального параметра».
Функция ЧислоБезопасно(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Собрать список выпуска блюд из продаж retail_sale (JSON-массив "Товары").
//
Функция СобратьВыпускБлюдИзRetailSale(Док, Результат)
	Возврат СобратьБлюдаПоМассиву(Док, "Товары");
КонецФункции

// Собрать список разбора блюд из возвратов retail_sale (JSON-массив "ВозвращенныеТовары").
//
Функция СобратьРазборБлюдИзRetailSale(Док, Результат)
	Возврат СобратьБлюдаПоМассиву(Док, "ВозвращенныеТовары");
КонецФункции

// Общий сбор блюд по имени JSON-массива: агрегирует порции по блюду (несколько строк
// одного кофе → один выпуск) и разворачивает каждое по ТТК. Возврат — Массив структур
// {Блюдо, Количество, Спецификация, Ингредиенты, Покрыто, Ошибка}.
//
Функция СобратьБлюдаПоМассиву(Док, ИмяМассива)

	Итог = Новый Массив;
	Строки = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, ИмяМассива, Новый Массив);
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Возврат Итог;
	КонецЕсли;

	ПорцииПоБлюду = Новый Соответствие; // БлюдоСсылка → суммарное количество порций
	Для Каждого СтрJSON Из Строки Цикл
		ЭтоБлюдо = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "ЭтоБлюдо", Ложь);
		КлассSKU = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "КлассSKU", "");
		Если Не (ЭтоБлюдо ИЛИ ВРег(СокрЛП(КлассSKU)) = МаркерОбщепит()) Тогда
			Продолжить;
		КонецЕсли;
		UUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Блюдо = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(UUID);
		Если Не ЗначениеЗаполнено(Блюдо) Тогда
			Продолжить; // несопоставленную номенклатуру зафиксирует основной путь ОРП
		КонецЕсли;
		Кол = ЧислоБезопасно(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0));
		Тек = ПорцииПоБлюду.Получить(Блюдо);
		ПорцииПоБлюду.Вставить(Блюдо, ?(Тек = Неопределено, 0, Тек) + Кол);
	КонецЦикла;

	Для Каждого КЗ Из ПорцииПоБлюду Цикл
		Блюдо  = КЗ.Ключ;
		Порций = КЗ.Значение;
		Если Порций = 0 Тогда
			Продолжить;
		КонецЕсли;
		Раскл = РазвернутьБлюдоНаИнгредиенты(Блюдо, Порций);
		Итог.Добавить(Новый Структура(
			"Блюдо, Количество, Спецификация, Ингредиенты, Покрыто, Ошибка",
			Блюдо, Порций, Раскл.Спецификация, Раскл.Ингредиенты, Раскл.Покрыто, Раскл.Ошибка));
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Сгенерировать документы Комплектация (сборка блюда из ингредиентов по ТТК).
//
Процедура СгенерироватьКомплектацииБлюд(Док, ИсточникUUID, ВыпускМассив, ИдПакета, Проводить, Результат)
	ГенерироватьДокументыБлюд(Док, ИсточникUUID, ВыпускМассив, ИдПакета, Проводить, Истина, Результат);
КонецПроцедуры

// Сгенерировать документы Разукомплектация (разбор возвращённого блюда на ингредиенты).
//
Процедура СгенерироватьРазукомплектацииБлюд(Док, ИсточникUUID, РазборМассив, ИдПакета, Проводить, Результат)
	ГенерироватьДокументыБлюд(Док, ИсточникUUID, РазборМассив, ИдПакета, Проводить, Ложь, Результат);
КонецПроцедуры

// Общая генерация документов сборки (ЭтоСборка=Истина) / разбора (Ложь) блюд.
// Контекст смены (Организация/Склад/счёт/Россия/Ответственный) вычисляется ОДИН раз;
// существующие документы смены берутся ОДНИМ bulk-запросом (вместо N поисков на блюдо).
//
Процедура ГенерироватьДокументыБлюд(Док, ИсточникUUID, Массив, ИдПакета, Проводить, ЭтоСборка, Результат)

	Если Массив.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Контекст = КонтекстКомплектации(Док);
	Если Контекст = Неопределено Тогда
		ЗаписатьОшибкуНСИ(ИдПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Номенклатура, Перечисления.TL_ПолеОшибки.Прочее,
			?(ЭтоСборка, "Сборка", "Разбор") + " блюд: не определены организация/склад — документы не созданы",
			Результат);
		Возврат;
	КонецЕсли;

	БазКлюч = ?(ЭтоСборка, ПрефиксКлючаВыпуск(), ПрефиксКлючаРазбор()) + ИсточникUUID;
	Существующие = СуществующиеДокументыПоБазКлючу(БазКлюч);
	ВидОп = ?(ЭтоСборка, Перечисления.ВидыОперацийКомплектацияНоменклатуры.Комплектация,
		Перечисления.ВидыОперацийКомплектацияНоменклатуры.Разукомплектация);

	АктуальныеКлючи = Новый Соответствие; // ключи блюд, реально присутствующих в пакете сейчас
	Для Каждого Данные Из Массив Цикл
		Если Не Данные.Покрыто Тогда
			ЗаписатьОшибкуНСИ(ИдПакета, ИсточникUUID,
				Перечисления.TL_ТипОбъектаИсточника.Номенклатура, Перечисления.TL_ПолеОшибки.Прочее,
				?(ЭтоСборка, "Комплектация", "Разукомплектация") + " блюда «" + Строка(Данные.Блюдо)
				+ "» пропущена: " + Данные.Ошибка + " (продано как товар, себестоимость не собрана)",
				Результат);
			Продолжить;
		КонецЕсли;
		Ключ = ?(ЭтоСборка, КлючКомплектацииБлюда(ИсточникUUID, Данные.Блюдо),
			КлючРазбораБлюда(ИсточникUUID, Данные.Блюдо));
		АктуальныеКлючи.Вставить(Ключ, Истина);
		Существующий = Существующие.Получить(Ключ);
		СоздатьДокументКомплектации(Данные, ВидОп, Ключ, ЭтоСборка, Контекст, Существующий,
			Док, ИдПакета, Проводить, Результат);
	КонецЦикла;

	// Orphan-очистка: документы смены, которых больше нет в текущем пакете (блюдо/возврат
	// исчезли из ЦБ при пересинке) → пометить на удаление (только непроведённые).
	Для Каждого КЗ Из Существующие Цикл
		Если АктуальныеКлючи.Получить(КЗ.Ключ) = Неопределено Тогда
			ПометитьОрфанБлюдаНаУдаление(КЗ.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Пометить на удаление осиротевший документ Комплектации/Разукомплектации (блюдо ушло
// из пакета). Проведённые НЕ трогаем — их судьба за бухгалтером.
//
Процедура ПометитьОрфанБлюдаНаУдаление(ДокСсылка)
	Попытка
		Если ТипЗнч(ДокСсылка) <> Тип("ДокументСсылка.КомплектацияНоменклатуры") Тогда
			Возврат;
		КонецЕсли;
		Об = ДокСсылка.ПолучитьОбъект();
		Если Об = Неопределено ИЛИ Об.Проведен Тогда
			Возврат;
		КонецЕсли;
		Об.УстановитьПометкуУдаления(Истина);
	Исключение
	КонецПопытки;
КонецПроцедуры

// Аннулировать сборку/разбор блюд смены при аннулировании ОРП (ПометкаУдаления):
// пометить на удаление парные Комплектации/Разукомплектации; проведённые сначала
// распровести. Иначе собранное блюдо повиснет на 41.02 без продажи.
//
Процедура АннулироватьСборкуБлюд(ИсточникUUID)
	Базы = Новый Массив;
	Базы.Добавить(ПрефиксКлючаВыпуск() + ИсточникUUID);
	Базы.Добавить(ПрефиксКлючаРазбор() + ИсточникUUID);
	Для Каждого БазКлюч Из Базы Цикл
		Для Каждого КЗ Из СуществующиеДокументыПоБазКлючу(БазКлюч) Цикл
			Попытка
				Ссылка = КЗ.Значение;
				Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.КомплектацияНоменклатуры") Тогда
					Продолжить;
				КонецЕсли;
				Об = Ссылка.ПолучитьОбъект();
				Если Об = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если Об.Проведен Тогда
					Об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					Об = Ссылка.ПолучитьОбъект();
				КонецЕсли;
				Об.УстановитьПометкуУдаления(Истина);
			Исключение
				// Сбой распроведения/пометки (напр. закрытый период) не должен ронять
				// аннулирование ОРП, но обязан оставить след: иначе собранное блюдо
				// повиснет проведённым на 41.02 без продажи и незаметно разъедет склад.
				ЗаписьЖурналаРегистрации("TL_СопуткаСервис.АннулированиеСборки",
					УровеньЖурналаРегистрации.Ошибка, , ,
					"Не удалось аннулировать документ блюда (ключ " + БазКлюч + "): "
					+ ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Снять ВСЕ служебные ссылки расширения на документ. Нужно, чтобы штатное
// «Удаление помеченных объектов» смогло физически удалить помеченный документ:
// независимые регистры сведений TradeLedger держат ссылку на документ и блокируют
// удаление (контроль ссылочной целостности), а механизм удаления их не чистит.
// Чистит: TL_РаскладкаБлюд (изм. Документ), TL_СтатусыЗагрузки (рес. ДокументСсылка),
// TL_СоответствиеИсточников (рес. СсылкаОбъект). Типовые ссылки
// (ДанныеПервичныхДокументов, ключи доступа) механизм удаления обрабатывает сам.
//
// Параметры:
//   ДокументСсылка - ДокументСсылка - документ, с которого снимаем служебные ссылки
//
Процедура ОчиститьСлужебныеСсылкиДокумента(ДокументСсылка) Экспорт

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;

	// 1. TL_РаскладкаБлюд — замещение пустым набором по отбору Документ
	Попытка
		НаборРБ = РегистрыСведений.TL_РаскладкаБлюд.СоздатьНаборЗаписей();
		НаборРБ.Отбор.Документ.Установить(ДокументСсылка);
		НаборРБ.Записать(Истина); // Истина = замещение = очистка по отбору
	Исключение
		ЗаписьЖурналаРегистрации("TL_СопуткаСервис.ОчисткаСсылок",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"TL_РаскладкаБлюд не очищена для " + Строка(ДокументСсылка) + ": " + ОписаниеОшибки());
	КонецПопытки;

	// 2. TL_СтатусыЗагрузки — найти ключи по ДокументСсылка и удалить записи
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КлючЗагрузки ИЗ РегистрСведений.TL_СтатусыЗагрузки
			|ГДЕ ДокументСсылка = &Сс");
		Запрос.УстановитьПараметр("Сс", ДокументСсылка);
		В = Запрос.Выполнить().Выбрать();
		Пока В.Следующий() Цикл
			TL_РегистрСтатусов.УдалитьЗапись(В.КлючЗагрузки);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("TL_СопуткаСервис.ОчисткаСсылок",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"TL_СтатусыЗагрузки не очищены для " + Строка(ДокументСсылка) + ": " + ОписаниеОшибки());
	КонецПопытки;

	// 3. TL_СоответствиеИсточников — удалить записи по СсылкаОбъект (через Тип+ИсточникUUID)
	Попытка
		Запрос2 = Новый Запрос(
			"ВЫБРАТЬ Тип, ИсточникUUID ИЗ РегистрСведений.TL_СоответствиеИсточников
			|ГДЕ СсылкаОбъект = &Сс");
		Запрос2.УстановитьПараметр("Сс", ДокументСсылка);
		В2 = Запрос2.Выполнить().Выбрать();
		Пока В2.Следующий() Цикл
			МЗ = РегистрыСведений.TL_СоответствиеИсточников.СоздатьМенеджерЗаписи();
			МЗ.Тип = В2.Тип;
			МЗ.ИсточникUUID = В2.ИсточникUUID;
			МЗ.Удалить();
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("TL_СопуткаСервис.ОчисткаСсылок",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"TL_СоответствиеИсточников не очищено для " + Строка(ДокументСсылка) + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Массив ссылок на помеченные на удаление документы канала TradeLedger за период.
// Наши документы опознаём по метке "TL|" в комментарии (её ставят все обработчики
// канала). Захватывает и Комплектации блюд (общепит). Используется кнопкой
// «Зачистить аннулированные» — не зависит от витрины (аннулированные в ней скрыты).
//
// Параметры:
//   НачалоПериода, КонецПериода - Дата  - период по дате документа
//   КодСтанции                  - Число - зарезервировано (фильтр по комментарию)
//
// Возвращаемое значение:
//   Массив (ДокументСсылка) — помеченные на удаление документы канала
//
Функция ПолучитьПомеченныеДокументыКанала(НачалоПериода, КонецПериода, КодСтанции = 0) Экспорт

	ИменаТипов = Новый Массив;
	ИменаТипов.Добавить("ОтчетОРозничныхПродажах");
	ИменаТипов.Добавить("ПоступлениеТоваровУслуг");
	ИменаТипов.Добавить("ПеремещениеТоваров");
	ИменаТипов.Добавить("ОприходованиеТоваров");
	ИменаТипов.Добавить("СписаниеТоваров");
	ИменаТипов.Добавить("ИнвентаризацияТоваровНаСкладе");
	ИменаТипов.Добавить("ВозвратТоваровПоставщику");
	ИменаТипов.Добавить("КомплектацияНоменклатуры");
	ИменаТипов.Добавить("ПриходныйКассовыйОрдер");

	Результат = Новый Массив;
	Для Каждого ИмяТипа Из ИменаТипов Цикл
		Попытка
			Запрос = Новый Запрос(
				"ВЫБРАТЬ Д.Ссылка КАК Ссылка
				|ИЗ Документ." + ИмяТипа + " КАК Д
				|ГДЕ Д.ПометкаУдаления
				|	И Д.Дата МЕЖДУ &НП И &КП
				|	И Д.Комментарий ПОДОБНО ""%TL|%""");
			Запрос.УстановитьПараметр("НП", НачалоДня(НачалоПериода));
			Запрос.УстановитьПараметр("КП", КонецДня(КонецПериода));
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Результат.Добавить(Выборка.Ссылка);
			КонецЦикла;
		Исключение
			// тип документа мог отсутствовать в конфигурации — пропускаем
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Подготовить документы канала к физическому удалению: отменить проведение,
// пометить на удаление и снять все служебные ссылки расширения. Само удаление
// затем выполняет штатное «Удаление помеченных объектов» 1С (с полным контролем
// ссылочной целостности типовых ссылок). Возвращает счётчики + текстовый лог.
//
// Параметры:
//   МассивСсылок - Массив - документы канала к зачистке
//
// Возвращаемое значение:
//   Структура (Обработано, Ошибок, Лог) — Лог: Массив строк
//
Функция ПодготовитьКУдалениюДокументыКанала(МассивСсылок) Экспорт

	Результат = Новый Структура("Обработано, Ошибок, Лог", 0, 0, Новый Массив);

	// Каскад на блюда: удаление ОРП сопутки/общепита должно захватить парные
	// Комплектации/Разукомплектации блюд смены (ключи ВЫПУСКБЛЮД/РАЗБОРБЛЮД), иначе
	// собранное блюдо повиснет проведённым на 41.02 без продажи. Зеркало авто-пути
	// аннулирования (АннулироватьСборкуБлюд). Тип документа — по метаданным (не Тип(),
	// чтобы не зависеть от заимствования в расширение).
	ПолныйСписок = Новый Массив;
	ДобавленныеСсылки = Новый Соответствие;
	Префиксы = Новый Массив;
	Префиксы.Добавить(ПрефиксКлючаВыпуск());
	Префиксы.Добавить(ПрефиксКлючаРазбор());
	Для Каждого Ссылка Из МассивСсылок Цикл
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Если ДобавленныеСсылки.Получить(Ссылка) = Неопределено Тогда
			ПолныйСписок.Добавить(Ссылка);
			ДобавленныеСсылки.Вставить(Ссылка, Истина);
		КонецЕсли;
		ЭтоОРП = Ложь;
		Попытка ЭтоОРП = (Ссылка.Метаданные().Имя = "ОтчетОРозничныхПродажах"); Исключение КонецПопытки;
		Если ЭтоОРП Тогда
			UUIDСмены = ПолучитьИсточникUUIDДокумента(Ссылка);
			Если ЗначениеЗаполнено(UUIDСмены) Тогда
				Для Каждого Преф Из Префиксы Цикл
					Для Каждого КЗ Из СуществующиеДокументыПоБазКлючу(Преф + UUIDСмены) Цикл
						Блюдо = КЗ.Значение;
						Если ЗначениеЗаполнено(Блюдо) И ДобавленныеСсылки.Получить(Блюдо) = Неопределено Тогда
							ПолныйСписок.Добавить(Блюдо);
							ДобавленныеСсылки.Вставить(Блюдо, Истина);
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Ссылка Из ПолныйСписок Цикл
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		НачатьТранзакцию();
		Попытка
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				ОтменитьТранзакцию();
				Продолжить;
			КонецЕсли;
			Если Объект.Проведен Тогда
				Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Объект = Ссылка.ПолучитьОбъект();
			КонецЕсли;
			Если Не Объект.ПометкаУдаления Тогда
				Объект.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
			ОчиститьСлужебныеСсылкиДокумента(Ссылка);
			ЗафиксироватьТранзакцию();
			Результат.Обработано = Результат.Обработано + 1;
		Исключение
			ОтменитьТранзакцию();
			Результат.Ошибок = Результат.Ошибок + 1;
			Результат.Лог.Добавить("✗ " + Строка(Ссылка) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Результат.Лог.Добавить("Подготовлено к удалению: " + XMLСтрока(Результат.Обработано)
		+ ?(Результат.Ошибок > 0, ", ошибок: " + XMLСтрока(Результат.Ошибок), ""));

	Возврат Результат;

КонецФункции

// ИсточникUUID (ключ смены) по ссылке документа канала — из TL_СоответствиеИсточников.
// Нужен для каскада удаления ОРП на парные Комплектации/Разукомплектации блюд смены.
//
Функция ПолучитьИсточникUUIDДокумента(ДокументСсылка)
	Рез = "";
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 ИсточникUUID ИЗ РегистрСведений.TL_СоответствиеИсточников
			|ГДЕ СсылкаОбъект = &Сс");
		Запрос.УстановитьПараметр("Сс", ДокументСсылка);
		Выб = Запрос.Выполнить().Выбрать();
		Если Выб.Следующий() Тогда
			Рез = Выб.ИсточникUUID;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Рез;
КонецФункции

// Создать или обновить (find-or-refill) документ КомплектацияНоменклатуры.
//   Данные      — Структура {Блюдо, Количество, Ингредиенты[]}
//   ВидОперации — Комплектация | Разукомплектация
//   Ключ        — TL|ВЫПУСКБЛЮД|… | TL|РАЗБОРБЛЮД|… (кладётся в конец Комментария)
//   ЭтоСборка   — Истина (дата раньше ОРП) | Ложь (разбор, дата после ОРП)
//   Контекст    — Структура смены (Организация/Склад/СчётТовара/Россия/Ответственный)
//   Существующий— ДокументСсылка (из bulk) или Неопределено
//
Процедура СоздатьДокументКомплектации(Данные, ВидОперации, Ключ, ЭтоСборка, Контекст, Существующий,
	Док, ИдПакета, Проводить, Результат)

	НачатьТранзакцию();
	Попытка
		Если ЗначениеЗаполнено(Существующий)
			И ТипЗнч(Существующий) = Тип("ДокументСсылка.КомплектацияНоменклатуры") Тогда
			// Гейт проведённых: смену уже провёл бухгалтер — сборку/разбор не трогаем.
			Проведён = Ложь;
			Попытка Проведён = Существующий.Проведен; Исключение КонецПопытки;
			Если Проведён Тогда
				ОтменитьТранзакцию();
				Возврат;
			КонецЕсли;
			ДокК = Существующий.ПолучитьОбъект();
			ДокК.Комплектующие.Очистить();
		Иначе
			ДокК = Документы.КомплектацияНоменклатуры.СоздатьДокумент();
		КонецЕсли;

		ДокК.Дата         = ДатаДокументаКомплектации(Результат, Док, ЭтоСборка);
		ДокК.Организация  = Контекст.Организация;
		ДокК.ВидОперации  = ВидОперации; // обязателен — иначе ОбработкаПроведения не даёт движений
		ДокК.Комментарий  = ПостроитьКомментарийКомплектации(ЭтоСборка, Данные, Ключ, Результат);
		УстановитьРеквизитБезопасно(ДокК, "Склад", Контекст.Склад);
		Если ЗначениеЗаполнено(Контекст.Ответственный) Тогда
			УстановитьРеквизитБезопасно(ДокК, "Ответственный", Контекст.Ответственный);
		КонецЕсли;

		// Выпуск блюда — в реквизиты ШАПКИ (ТЧ Продукция в БП ГИГ отсутствует, проверено)
		ДокК.Номенклатура = Данные.Блюдо;
		ДокК.Количество   = Данные.Количество;
		УстановитьРеквизитБезопасно(ДокК, "СчетУчета", Контекст.СчётТовара);

		// Ингредиенты — ТЧ Комплектующие (счёт 41.02, СтранаПроисхождения обязательна)
		Для Каждого Ингр Из Данные.Ингредиенты Цикл
			СтрК = ДокК.Комплектующие.Добавить();
			СтрК.Номенклатура = Ингр.Номенклатура;
			СтрК.Количество   = Ингр.Количество;
			УстановитьРеквизитБезопасно(СтрК, "СчетУчета", Контекст.СчётТовара);
			Если ЗначениеЗаполнено(Контекст.Россия) Тогда
				УстановитьРеквизитБезопасно(СтрК, "СтранаПроисхождения", Контекст.Россия);
			КонецЕсли;
			// Разукомплектация (разбор возврата блюда): ДоляСтоимости обязательна — по ней
			// себестоимость набора-блюда распределяется на ингредиенты. Равные доли (=1 на
			// строку, сумма долей = N > 0); при Комплектации поле не проверяется. Оценка МПЗ
			// «По средней» выравнивает себестоимость закрытием месяца.
			Если Не ЭтоСборка Тогда
				УстановитьРеквизитБезопасно(СтрК, "ДоляСтоимости", 1);
			КонецЕсли;
		КонецЦикла;

		Если Проводить Тогда
			ДокК.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокК.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		ТипДок = ?(ЭтоСборка, "КомплектацияБлюд", "РазборБлюд");
		Результат.Документы.Добавить(ДокК.Ссылка);
		TL_РегистрСтатусов.ЗарегистрироватьЗагрузку(Ключ, ДокК.Ссылка, ТипДок);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписатьОшибкуНСИ(ИдПакета, "",
			Перечисления.TL_ТипОбъектаИсточника.Номенклатура, Перечисления.TL_ПолеОшибки.Прочее,
			"Ошибка создания " + ?(ЭтоСборка, "Комплектации", "Разукомплектации")
			+ " блюда «" + Строка(Данные.Блюдо) + "»: " + ОписаниеОшибки(), Результат);
	КонецПопытки;

КонецПроцедуры

// Контекст смены для документов Комплектации (вычисляется ОДИН раз на смену).
// Возврат: Структура(Организация, Склад, СчётТовара, Россия, Ответственный)
// или Неопределено при невалидной организации/складе (тогда сборку не создаём — иначе
// orphan-документ без склада повиснет).
//
Функция КонтекстКомплектации(Док)
	Орг   = ОрганизацияИзДок(Док);
	Склад = СкладИзДок(Док);
	Если Не ЗначениеЗаполнено(Орг) ИЛИ Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Организация, Склад, СчётТовара, Россия, Ответственный",
		Орг, Склад,
		TL_МаппингЦБ.ОпределитьСчётУчётаТовара("retail_sale_sidegoods", "Сопутка"), // 41.02
		ПолучитьСтрануРоссия(),
		ТекущийОтветственный());
КонецФункции

// Существующие документы смены по базовому ключу — ОДИН bulk-запрос. Возврат: Соответствие
// ПолныйКлюч → ДокументСсылка (вместо N поисков НайтиДокументПоКлючу на блюдо).
//
Функция СуществующиеДокументыПоБазКлючу(БазКлюч)
	Соотв = Новый Соответствие;
	Попытка
		Для Каждого Инфо Из TL_РегистрСтатусов.ПолучитьДокументыПоБазовомуКлючу(БазКлюч) Цикл
			Если ЗначениеЗаполнено(Инфо.Ссылка) Тогда
				Соотв.Вставить(Инфо.Ключ, Инфо.Ссылка);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Соотв;
КонецФункции

// Читаемый Комментарий Комплектации: «Сборка блюда «Кофе» ×5, смена АЗС208 №… | <ключ>».
// Ключ ОБЯЗАТЕЛЬНО в конце после « | » — так идемпотентный поиск (по шаблону «% | ключ»)
// продолжает находить документ.
//
Функция ПостроитьКомментарийКомплектации(ЭтоСборка, Данные, Ключ, Результат)
	Действие = ?(ЭтоСборка, "Сборка", "Разбор");
	Смена = "";
	Контекст = ?(Результат.Свойство("КонтекстСмены"), Результат.КонтекстСмены, Неопределено);
	Если Контекст <> Неопределено Тогда
		Смена = ", смена АЗС" + Формат(Контекст.КодАЗС, "ЧГ=0") + " №" + Строка(Контекст.НомерСмены);
	КонецЕсли;
	Возврат Действие + " блюда «" + Строка(Данные.Блюдо) + "» ×"
		+ Формат(Данные.Количество, "ЧГ=0") + Смена + " | " + Ключ;
КонецФункции

// Текущий пользователь как Ответственный (с фолбэком на пустую ссылку).
//
Функция ТекущийОтветственный()
	Отв = Справочники.Пользователи.ПустаяСсылка();
	Попытка
		Найден = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя(), Истина);
		Если ЗначениеЗаполнено(Найден) Тогда
			Отв = Найден;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Отв;
КонецФункции

// Дата документа сборки/разбора относительно ОРП (по времени смены).
//   ЭтоСборка=Истина — строго РАНЬШЕ ОРП (партия блюда до продажи);
//   ЭтоСборка=Ложь   — ПОСЛЕ ОРП (блюдо сначала вернулось на склад проведением ОРП-возврата).
//
Функция ДатаДокументаКомплектации(Результат, Док, ЭтоСборка)
	ДатаОРП = ПолучитьДатуИзJSON(Док, "Дата");
	Контекст = ?(Результат.Свойство("КонтекстСмены"), Результат.КонтекстСмены, Неопределено);
	Если ЭтоСборка Тогда
		Если Контекст <> Неопределено И ЗначениеЗаполнено(Контекст.Открытие) Тогда
			ДатаСборки = Контекст.Открытие + 1;
		ИначеЕсли ЗначениеЗаполнено(ДатаОРП) Тогда
			ДатаСборки = НачалоДня(ДатаОРП) + 1;
		Иначе
			Возврат ТекущаяДата();
		КонецЕсли;
		// Гарантия: сборка строго РАНЬШЕ ОРП (кейс ДатаОРП=полночь → НачалоДня+1 > ОРП).
		Если ЗначениеЗаполнено(ДатаОРП) И ДатаСборки >= ДатаОРП Тогда
			ДатаСборки = ДатаОРП - 1;
		КонецЕсли;
		Возврат ДатаСборки;
	Иначе
		Возврат ?(ЗначениеЗаполнено(ДатаОРП), ДатаОРП + 1, ТекущаяДата());
	КонецЕсли;
КонецФункции

// Организация комплектации = как в шапке ОРП (по UUID с фолбэком на основную ГИГ).
//
Функция ОрганизацияИзДок(Док)
	UUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Организация", "");
	Орг = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(UUID);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		Орг = TL_МаппингЦБ.ОпределитьОрганизациюПоУмолчанию();
	КонецЕсли;
	Возврат Орг;
КонецФункции

// Склад комплектации = склад ОРП (по UUID). Пустой склад отсекается в КонтекстКомплектации.
//
Функция СкладИзДок(Док)
	UUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Склад", "");
	Возврат TL_МаппингЦБ.ПолучитьСкладПоUUID(UUID);
КонецФункции

// Россия для реквизита СтранаПроисхождения (обязателен для проведения в БП 3.0).
//
Функция ПолучитьСтрануРоссия()
	Стр = Справочники.СтраныМира.НайтиПоНаименованию("Россия", Истина);
	Если Не ЗначениеЗаполнено(Стр) Тогда
		Стр = Справочники.СтраныМира.НайтиПоКоду("643");
	КонецЕсли;
	Возврат Стр;
КонецФункции

// ============================================================================
//  ОБРАБОТКА ДОКУМЕНТА kind=production_release (общепит: выпуск + списание сырья)
// ============================================================================
//
// Источник в ЦБ ЭЛСИ.АЗК — Документ.ВыпускПродукции с ТЧ Товары (11 блюд) и
// ТЧ Ингредиенты (51 строк), связь через ИдентификаторПродукция.
//
// Приёмник в БП ГИГ: Документ.ОтчетПроизводстваЗаСмену с ВидОперации=ВыпускПродукции.
// ТЧ Продукция (блюда, КлючСтроки=новый GUID) + ТЧ Материалы (ингредиенты,
// Продукция=КлючСтроки соответствующего блюда).
//
// Проводки (типовая БП 3.0 для общепита, плановая стоимость = 0):
//   Дт 41.02 Кт 44.01 — выпуск (плановая = 0, корректировка позже)
//   Дт 44.01 Кт 41.02 — списание сырья в издержки
//
// В JSON-пакете 2 массива: ВыпускБлюд (Продукция в БП) + Ингредиенты (Материалы в БП).
//
Процедура ОбработатьProductionRelease(Док, ИдентификаторПакета, ПроводитьПоУмолчанию, Результат)

	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Результат.Ошибки.Добавить("production_release: документ без ИсточникUUID — пропущен");
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Объект = НайтиИлиСоздатьОПЗС(ИсточникUUID);

		// Защита проведённого: бухгалтер уже провёл документ — не перезаписываем сменными
		// данными из ЦБ. Аннулирование (ПометкаУдаления) проходит.
		Если ЭтоЗащитаПроведённыхВкл() И Объект.Проведен
			И НЕ TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь) Тогда
			ОтменитьТранзакцию();
			ОбработатьЗащитуПроведённого(Объект, Док,
				Перечисления.TL_ТипОбъектаИсточника.Поступление, ИсточникUUID,
				ИдентификаторПакета, Результат);
			Возврат;
		КонецЕсли;

		Если Не ЗаполнитьШапкуProductionRelease(Объект, Док, ИдентификаторПакета,
				ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		// Заполнение Продукции (ВыпускБлюд) с генерацией КлючСтроки.
		// Возвращает Соответствие Идентификатор_ЦБ → КлючСтроки_БП.
		КарточкаКлючей = Новый Соответствие;
		Если Не ЗаполнитьПродукциюProductionRelease(Объект, Док, КарточкаКлючей,
				ИдентификаторПакета, ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		// Заполнение Материалов с связкой Продукция=КлючСтроки
		ЗаполнитьМатериалыProductionRelease(Объект, Док, КарточкаКлючей,
			ИдентификаторПакета, ИсточникUUID, Результат);

		ПометкаУдаления = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь);
		ПроведенJSON   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Проведен", Истина);

		Если ПометкаУдаления Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Объект.УстановитьПометкуУдаления(Истина);
		Иначе
			Если Объект.ПометкаУдаления Тогда
				// Объект уже заполнен шапкой/товарами выше → снять пометку сразу нельзя
				// («данные объекта модифицированы»). Сначала записать (сброс флага
				// модификации), затем снять пометку; ниже — перечитывание/перезаполнение.
				Объект.Записать(РежимЗаписиДокумента.Запись);
				Объект.УстановитьПометкуУдаления(Ложь);
				Объект = Объект.Ссылка.ПолучитьОбъект();
				ЗаполнитьШапкуProductionRelease(Объект, Док, ИдентификаторПакета,
					ИсточникUUID, Результат);
				КарточкаКлючей = Новый Соответствие;
				ЗаполнитьПродукциюProductionRelease(Объект, Док, КарточкаКлючей,
					ИдентификаторПакета, ИсточникUUID, Результат);
				ЗаполнитьМатериалыProductionRelease(Объект, Док, КарточкаКлючей,
					ИдентификаторПакета, ИсточникUUID, Результат);
			КонецЕсли;
			Если ПроводитьПоУмолчанию = Ложь Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			ИначеЕсли ПроведенJSON Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			Иначе
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;
			Объект.Записать(РежимЗаписи);
		КонецЕсли;

		// Раскладка блюд общепита → регистр TL_РаскладкаБлюд (только для ОРП; для прочих
		// документов РаскладкаБлюд не заполнена — процедура сразу выйдет).
		ЗаписатьРаскладкуБлюд(Объект.Ссылка, Результат);

		TL_МаппингЦБ.ЗаписатьСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			ИсточникUUID, Объект.Ссылка, ИдентификаторПакета,
			ВычислитьХешДокумента(Док), Результат.КонтекстСмены);

		Результат.Документы.Добавить(Объект.Ссылка);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Текст = ОписаниеОшибки();
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Прочее,
			Перечисления.TL_КодОшибкиЗагрузки.ОшибкаПроведения,
			"",
			"Ошибка проведения production_release: " + Текст,
			Результат);
	КонецПопытки;

КонецПроцедуры

// ==========================================================================
//  Общепит модель B (Дт 90.02.1 Кт 41.02 без ОПЗС, выбор Галины 22.05.2026)
//  + B4-синхронизация ТТК из ЦБ (kind=recipe)
// ==========================================================================

// Проверка текущей модели учёта общепита.
// Хранится в TL_Настройки.Общепит_МодельУчёта: "B" (по умолчанию для ГИГ) / "A" (legacy).
//
Функция ЭтоМодельОбщепитаB() Экспорт
	Возврат TL_Настройки.ПолучитьЗначение("Общепит_МодельУчёта", "B") = "B";
КонецФункции

// Вариант A общепита: блюдо продаётся одной строкой ОРП как товар, а себестоимость
// собирается отдельным документом КомплектацияНоменклатуры из ингредиентов по ТТК.
// Активен только поверх модели B (Общепит_МодельУчёта="B") при флаге
// Общепит_КомплектацияБлюд="1" (дефолт). Возврат зеркалится Разукомплектацией.
//
Функция ЭтоВариантКомплектацияБлюд() Экспорт
	Возврат ЭтоМодельОбщепитаB()
		И TL_Настройки.ПолучитьЗначение("Общепит_КомплектацияБлюд", "1") = "1";
КонецФункции

// Форсировать ставку НДС 22% на розничные строки сопутки/общепита ГИГ.
// Розница ГИГ продаётся как товар (ставки общепита не применяются); флаг перекрывает
// аномальные ставки из ЦБ (18%/5%). Ключ Розница_ФорсНДС22="1" (дефолт).
//
Функция ФорсироватьНДС22Розницы()
	Возврат TL_Настройки.ПолучитьЗначение("Розница_ФорсНДС22", "1") = "1";
КонецФункции

// Защита проведённых включена? (дефолт "1"). Когда включена — повторная загрузка из ЦБ
// НЕ перезаписывает документ, который бухгалтер уже провёл (сохраняются ручные правки и
// проводки). Флаг позволяет отключить поведение без передеплоя, если понадобится.
//
Функция ЭтоЗащитаПроведённыхВкл()
	Возврат TL_Настройки.ПолучитьЗначение("Защита_НеПерезаписыватьПроведённые", "1") = "1";
КонецФункции

// Обработать защиту уже проведённого документа: перезапись пропущена. Если данные ЦБ
// ИЗМЕНИЛИСЬ против последней синхронизации (хеш другой) — помечаем расхождение
// (витрина покажет ⚠ «изменён в ЦБ после проведения»). Совпадение хеша = доброкачественный
// повторный проход (ночная пересинхронизация без изменений), молча пропускаем.
// Пакет НЕ роняем и статус не портим — пишем только в журнал регистрации + флаг витрины.
//
Процедура ОбработатьЗащитуПроведённого(Объект, Док, Тип, ИсточникUUID, ИдПакета, Результат)

	// Вся процедура обёрнута в Попытку: вызывается ПОСЛЕ ОтменитьТранзакцию() в обработчике,
	// поэтому не должна бросать исключение (иначе Исключение обработчика повторно вызовет
	// ОтменитьТранзакцию() без активной транзакции).
	Попытка
		ХешВходящий    = ВычислитьХешДокумента(Док);
		ХешСохранённый = TL_МаппингЦБ.ПрочитатьХешСоответствия(Тип, ИсточникUUID);
		ЕстьИзменение  = ЗначениеЗаполнено(ХешСохранённый) И ХешВходящий <> ХешСохранённый;

		Если ЕстьИзменение Тогда
			TL_МаппингЦБ.ПометитьРасхождениеПроведённого(Тип, ИсточникUUID);
		КонецЕсли;

		ЗаписьЖурналаРегистрации("TL_СопуткаСервис.ЗащитаПроведённых",
			УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"Пакет " + ИдПакета + ": документ уже проведён — перезапись пропущена."
			+ ?(ЕстьИзменение,
				" Данные ЦБ изменились: помечено расхождение для проверки бухгалтером.",
				""));
	Исключение
	КонецПопытки;

КонецПроцедуры

// Пропустить пакет production_release в модели B.
// При продаже блюда в retail_sale_sidegoods себестоимость уже спишется
// прямо на 90.02.1 по ингредиентам через ТТК. Создавать ОПЗС бессмысленно.
//
Процедура ПропуститьProductionReleaseB(Док, ИдентификаторПакета, Результат)
	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	Сообщение = "production_release пропущен (модель B): "
		+ "себестоимость спишется при продаже через ТТК. "
		+ "ИсточникUUID=" + ИсточникUUID;
	ЗаписьЖурналаРегистрации("TL_СопуткаСервис",
		УровеньЖурналаРегистрации.Информация, , , Сообщение);
	// Не считаем ошибкой — это штатное поведение.
	Результат.ВсегоДокументов = Результат.ВсегоДокументов - 1;
КонецПроцедуры

// Обработать kind=recipe: создать/обновить Справочник.СпецификацииНоменклатуры
// для блюда по составу ингредиентов из ЦБ ЭЛСИ.АЗК (B4-синхронизация).
//
// Параметры:
//   Док                - Структура из JSON
//   ИдентификаторПакета - Строка
//   Результат          - Структура
//
// Ожидаемая структура JSON для kind=recipe:
//   {
//     "Тип": "recipe",
//     "ИсточникUUID": "uuid ТТК в ЦБ",
//     "БлюдоUUID": "uuid номенклатуры блюда в БП ГИГ",
//     "БлюдоНаименование": "Эспрессо 60мл",
//     "Ингредиенты": [
//       { "НоменклатураUUID": "uuid ингредиента", "Количество": 9, "Наименование": "Кофе зерно" },
//       { "НоменклатураUUID": "...", "Количество": 60, "Наименование": "Вода" },
//       { "НоменклатураUUID": "...", "Количество": 1, "Наименование": "Стакан 60мл" }
//     ]
//   }
//
Процедура ОбработатьРецепт(Док, ИдентификаторПакета, Результат) Экспорт

	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	БлюдоUUID    = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "БлюдоUUID", "");

	Если ПустаяСтрока(ИсточникUUID) ИЛИ ПустаяСтрока(БлюдоUUID) Тогда
		ЗаписатьОшибкуНСИ(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
			Перечисления.TL_ПолеОшибки.ИсточникUUID,
			"recipe: пустой ИсточникUUID или БлюдоUUID", Результат);
		Возврат;
	КонецЕсли;

	// Найти блюдо по UUID
	БлюдоСсылка = НайтиНоменклатуруПоUUID(БлюдоUUID);
	Если НЕ ЗначениеЗаполнено(БлюдоСсылка) Тогда
		ЗаписатьОшибкуНСИ(ИдентификаторПакета, БлюдоUUID,
			Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
			Перечисления.TL_ПолеОшибки.ИсточникUUID,
			"recipe: блюдо с UUID " + БлюдоUUID + " не найдено в Справочник.Номенклатура",
			Результат);
		Возврат;
	КонецЕсли;

	Ингредиенты = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Ингредиенты", Новый Массив);
	Если ТипЗнч(Ингредиенты) <> Тип("Массив") ИЛИ Ингредиенты.Количество() = 0 Тогда
		ЗаписатьОшибкуНСИ(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
			Перечисления.TL_ПолеОшибки.Прочее,
			"recipe: пустой массив Ингредиенты", Результат);
		Возврат;
	КонецЕсли;

	// Найти/создать СпецификациюНоменклатуры
	НачатьТранзакцию();
	Попытка
		Объект = НайтиИлиСоздатьСпецификацию(ИсточникUUID, БлюдоСсылка);
		Объект.Владелец = БлюдоСсылка;
		Объект.Наименование = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док,
			"БлюдоНаименование", "ТТК " + Строка(БлюдоСсылка));

		Объект.ИсходныеКомплектующие.Очистить();
		ПропущеноСтрок = 0;
		Для Каждого Ингр Из Ингредиенты Цикл
			НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Ингр,
				"НоменклатураUUID", "");
			Количество = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Ингр, "Количество", 0);
			Если ПустаяСтрока(НоменклатураUUID) ИЛИ Количество = 0 Тогда
				ПропущеноСтрок = ПропущеноСтрок + 1;
				Продолжить;
			КонецЕсли;

			ИнгрСсылка = НайтиНоменклатуруПоUUID(НоменклатураUUID);
			Если НЕ ЗначениеЗаполнено(ИнгрСсылка) Тогда
				ЗаписатьОшибкуНСИ(ИдентификаторПакета, НоменклатураUUID,
					Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
					Перечисления.TL_ПолеОшибки.ИсточникUUID,
					"recipe: ингредиент с UUID " + НоменклатураUUID
						+ " не найден (блюдо «" + Строка(БлюдоСсылка) + "»)",
					Результат);
				ПропущеноСтрок = ПропущеноСтрок + 1;
				Продолжить;
			КонецЕсли;

			НовСтр = Объект.ИсходныеКомплектующие.Добавить();
			НовСтр.Номенклатура = ИнгрСсылка;
			НовСтр.Количество = Количество;
		КонецЦикла;

		Если Объект.ИсходныеКомплектующие.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			ЗаписатьОшибкуНСИ(ИдентификаторПакета, ИсточникUUID,
				Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
				Перечисления.TL_ПолеОшибки.Прочее,
				"recipe: все ингредиенты пропущены — спецификация не сохранена",
				Результат);
			Возврат;
		КонецЕсли;

		Объект.Записать();
		СпецСсылка = Объект.Ссылка;
		// Регистрация соответствия ИсточникUUID → СпецификацияНоменклатуры
		TL_МаппингЦБ.ЗаписатьСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Номенклатура,
			ИсточникUUID, СпецСсылка);

		Результат.Документы.Добавить(СпецСсылка);
		ЗафиксироватьТранзакцию();

		ЗаписьЖурналаРегистрации("TL_СопуткаСервис",
			УровеньЖурналаРегистрации.Информация, , ,
			"recipe сохранён: блюдо «" + Строка(БлюдоСсылка) + "», ингредиентов "
			+ Объект.ИсходныеКомплектующие.Количество()
			+ ?(ПропущеноСтрок > 0, ", пропущено " + ПропущеноСтрок, ""));

	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Ошибка сохранения recipe: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Найти существующую СпецификациюНоменклатуры по соответствию или создать новую.
// Возвращает ОБЪЕКТ (для записи), не ссылку: у нового СправочникОбъект нет метода
// ПолучитьСсылку(), а .Ссылка нового элемента нельзя ПолучитьОбъект() до записи.
//
Функция НайтиИлиСоздатьСпецификацию(ИсточникUUID, БлюдоСсылка)
	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Номенклатура, ИсточникUUID);
	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("СправочникСсылка.СпецификацииНоменклатуры") Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено И Объект.Владелец = БлюдоСсылка Тогда
			Возврат Объект;
		КонецЕсли;
	КонецЕсли;
	// По соответствию не нашли (или чужое блюдо/висячая ссылка) — ищем спецификацию самого блюда
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Спец.Ссылка КАК Ссылка
		|ИЗ Справочник.СпецификацииНоменклатуры КАК Спец
		|ГДЕ Спец.Владелец = &Блюдо И НЕ Спец.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Спец.Код УБЫВ";
	Запрос.УстановитьПараметр("Блюдо", БлюдоСсылка);
	Попытка
		Выб = Запрос.Выполнить().Выбрать();
		Если Выб.Следующий() Тогда
			Об = Выб.Ссылка.ПолучитьОбъект();
			Если Об <> Неопределено Тогда
				Возврат Об;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	НовОбъект = Справочники.СпецификацииНоменклатуры.СоздатьЭлемент();
	НовОбъект.Владелец = БлюдоСсылка;
	Возврат НовОбъект;
КонецФункции

// Найти номенклатуру (ингредиент) по UUID. Сначала через TL_СоответствиеИсточников,
// потом напрямую как ссылку Справочник.Номенклатура.
//
Функция НайтиНоменклатуруПоUUID(UUID)

	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Номенклатура, UUID);
	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат Ссылка;
	КонецЕсли;

	Попытка
		ПрямаяСсылка = Справочники.Номенклатура.ПолучитьСсылку(
			Новый УникальныйИдентификатор(UUID));
		// Проверить что ссылка реально существует — обращением к реквизиту
		Тест = ПрямаяСсылка.Наименование;
		Если НЕ ПустаяСтрока(Тест) Тогда
			Возврат ПрямаяСсылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Справочники.Номенклатура.ПустаяСсылка();

КонецФункции

// Развернуть блюдо на ингредиенты по ТТК (для модели B при retail_sale_sidegoods).
// Возвращает Структуру("Ингредиенты, Покрыто, Ошибка"):
//   Ингредиенты - Массив(Структура("Номенклатура, Количество")) — пропорционально порциям
//   Покрыто    - Булево — найдена ли валидная активная спецификация
//   Ошибка     - Строка — описание если не покрыто (пустая если ОК)
//
// Записать раскладку блюд (ингредиент→блюдо) в независимый регистр TL_РаскладкаБлюд.
// Замещает все записи по документу. Проводок не касается — только справочная связь
// для отображения общепита в карточке и учёте («🍴 Кофе»).
//
Процедура ЗаписатьРаскладкуБлюд(ДокументСсылка, Результат)

	Если Не Результат.Свойство("РаскладкаБлюд") Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// Дедупликация: ключ регистра {Документ, Ингредиент} должен быть УНИКАЛЕН,
		// а один ингредиент (Сироп, Кофе…) встречается в нескольких блюдах одной
		// смены. Без дедупликации НаборЗаписей.Записать падает на дубле ключа и
		// роняет транзакцию пакета. Берём последнее блюдо для ингредиента.
		УникРаскладка = Новый Соответствие;
		Для Каждого РБ Из Результат.РаскладкаБлюд Цикл
			Если ЗначениеЗаполнено(РБ.Ингредиент) И ЗначениеЗаполнено(РБ.Блюдо) Тогда
				УникРаскладка.Вставить(РБ.Ингредиент, РБ.Блюдо);
			КонецЕсли;
		КонецЦикла;
		НаборЗ = РегистрыСведений.TL_РаскладкаБлюд.СоздатьНаборЗаписей();
		НаборЗ.Отбор.Документ.Установить(ДокументСсылка);
		Для Каждого КЗ Из УникРаскладка Цикл
			Зап = НаборЗ.Добавить();
			Зап.Документ   = ДокументСсылка;
			Зап.Ингредиент = КЗ.Ключ;
			Зап.Блюдо      = КЗ.Значение;
		КонецЦикла;
		НаборЗ.Записать(Истина); // замещение по отбору Документ (старые записи очищаются)
	Исключение
		ЗаписьЖурналаРегистрации("TL_СопуткаСервис",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось записать раскладку блюд (TL_РаскладкаБлюд): " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция РазвернутьБлюдоНаИнгредиенты(БлюдоСсылка, КоличествоПорций) Экспорт

	// Спецификация (ТТК) и Блюдо возвращаем, чтобы приёмник проставил их в строки
	// ОРП — тогда в учёте и в карточке видно «Кофе (раскладка: ...)», а не «Сироп».
	Результат = Новый Структура("Ингредиенты, Покрыто, Ошибка, Спецификация, Блюдо",
		Новый Массив, Ложь, "", Неопределено, БлюдоСсылка);

	Если НЕ ЗначениеЗаполнено(БлюдоСсылка) Тогда
		Результат.Ошибка = "Пустая ссылка на блюдо";
		Возврат Результат;
	КонецЕсли;
	Если КоличествоПорций = 0 Тогда
		Результат.Ошибка = "0 порций — сборка не требуется"; // не маскировать под «нет ТТК»
		Возврат Результат;
	КонецЕсли;

	// Найти последнюю (по дате редактирования) спецификацию для блюда
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Блюдо", БлюдоСсылка);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Спец.Ссылка КАК Ссылка
		|ИЗ Справочник.СпецификацииНоменклатуры КАК Спец
		|ГДЕ Спец.Владелец = &Блюдо
		|	И НЕ Спец.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Спец.Код УБЫВ";
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Результат.Ошибка = "Для блюда «" + Строка(БлюдоСсылка)
				+ "» нет спецификации (ТТК не синхронизирован из ЦБ)";
			Возврат Результат;
		КонецЕсли;
		СпецСсылка = Выборка.Ссылка;
		Результат.Спецификация = СпецСсылка;
	Исключение
		Результат.Ошибка = "Не удалось получить спецификацию для блюда «"
			+ Строка(БлюдоСсылка) + "»: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	// Получить состав
	Запрос2 = Новый Запрос;
	Запрос2.УстановитьПараметр("Спец", СпецСсылка);
	Запрос2.Текст =
		"ВЫБРАТЬ
		|	Сост.Номенклатура КАК Номенклатура,
		|	Сост.Количество КАК Количество
		|ИЗ Справочник.СпецификацииНоменклатуры.ИсходныеКомплектующие КАК Сост
		|ГДЕ Сост.Ссылка = &Спец";
	Попытка
		Выб = Запрос2.Выполнить().Выбрать();
	Исключение
		Результат.Ошибка = "Не удалось получить состав ТТК блюда «"
			+ Строка(БлюдоСсылка) + "»: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	Пока Выб.Следующий() Цикл
		Результат.Ингредиенты.Добавить(Новый Структура("Номенклатура, Количество",
			Выб.Номенклатура, Выб.Количество * КоличествоПорций));
	КонецЦикла;

	Если Результат.Ингредиенты.Количество() > 0 Тогда
		Результат.Покрыто = Истина;
	Иначе
		Результат.Ошибка = "Спецификация для блюда «" + Строка(БлюдоСсылка)
			+ "» не содержит ингредиентов";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Найти существующий ОПЗС по соответствию или создать новый.
//
Функция НайтиИлиСоздатьОПЗС(ИсточникUUID)

	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Поступление, ИсточникUUID);

	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОтчетПроизводстваЗаСмену") Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Возврат Объект;
		КонецЕсли;
	КонецЕсли;

	Возврат Документы.ОтчетПроизводстваЗаСмену.СоздатьДокумент();

КонецФункции

// Заполнить шапку ОПЗС.
//
Функция ЗаполнитьШапкуProductionRelease(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	// Дата ОПЗС = ДатаВремяОткрытия смены + 1 сек (если есть КонтекстСмены формата v2).
	// Без сдвига ОПЗС идёт с датой закрытия смены = равен ОРП → ФИФО ОРП по общепиту
	// не находит партий, ОРП валит «нет партий» по блюдам Капучино/Пицца.
	// Fallback на JSON-«Дата» если контекста смены нет (формат v1 или ранний пакет).
	ДатаОПЗС = Неопределено;
	Попытка
		Если Результат.КонтекстСмены <> Неопределено
				И ЗначениеЗаполнено(Результат.КонтекстСмены.Открытие) Тогда
			ДатаОПЗС = Результат.КонтекстСмены.Открытие + 1;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если ДатаОПЗС = Неопределено Тогда
		ДатаОПЗС = ПолучитьДатуИзJSON(Док, "Дата");
	КонецЕсли;
	Объект.Дата = ДатаОПЗС;
	Объект.ВидОперации = Перечисления.ВидыОперацийОтчетПроизводстваЗаСмену.ОтчетПроизводстваЗаСмену;

	// Организация
	ОрганизацияUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Организация", "");
	Орг = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(ОрганизацияUUID);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		// Страховка: организация-источник не сопоставлена — основная организация ГИГ.
		Орг = TL_МаппингЦБ.ОпределитьОрганизациюПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Орг) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Организация,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОрганизацияUUID,
			"Организация не найдена по UUID " + ОрганизацияUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Организация = Орг;

	// Склад
	СкладUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Склад", "");
	Склад = TL_МаппингЦБ.ПолучитьСкладПоUUID(СкладUUID);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			СкладUUID,
			"Склад не найден по UUID " + СкладUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	УстановитьРеквизитБезопасно(Объект, "Склад", Склад);

	// Подразделение по складу
	Подразделение = TL_МаппингЦБ.ПолучитьПодразделениеПоСкладу(Склад);
	УстановитьРеквизитБезопасно(Объект, "ПодразделениеОрганизации", Подразделение);
	УстановитьРеквизитБезопасно(Объект, "ПодразделениеЗатрат", Подразделение);

	// Счёт затрат шапки (44.01) — Кт для продукции, Дт для материалов
	УстановитьРеквизитБезопасно(Объект, "СчетЗатрат",
		TL_МаппингЦБ.ОпределитьСчётЗатратОбщепит());

	Объект.Комментарий = ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат);
	Возврат Истина;

КонецФункции

// Заполнить ТЧ Продукция (ВыпускБлюд). Для каждого блюда генерирует КлючСтроки (GUID).
// КарточкаКлючей: Идентификатор_ЦБ (строка) → КлючСтроки_БП (UUID).
//
Функция ЗаполнитьПродукциюProductionRelease(Объект, Док, КарточкаКлючей,
	ИдентификаторПакета, ИсточникUUID, Результат)

	ВыпускБлюд = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ВыпускБлюд", Новый Массив);
	Если ТипЗнч(ВыпускБлюд) <> Тип("Массив") Тогда
		ВызватьИсключение "Поле ВыпускБлюд отсутствует или не массив";
	КонецЕсли;

	Объект.Продукция.Очистить();

	СчётГП = TL_МаппингЦБ.ОпределитьСчётГотовойПродукции();
	НомГруппа = TL_МаппингЦБ.ОпределитьНоменклатурнуюГруппуОбщепит();

	Для Каждого СтрJSON Из ВыпускБлюд Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "Продукция: Номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;

		Стр = Объект.Продукция.Добавить();
		Стр.Номенклатура   = Номенклатура;
		Стр.Количество     = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);
		Стр.ПлановаяСтоимость = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена", 0);
		Стр.СуммаПлановая  = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Сумма", 0);

		// Уникальный КлючСтроки — связь с ТЧ Материалы через Продукция=КлючСтроки
		КлючСтроки = Новый УникальныйИдентификатор;
		Стр.КлючСтроки = КлючСтроки;

		УстановитьРеквизитБезопасно(Стр, "Счет",                СчётГП);
		УстановитьРеквизитБезопасно(Стр, "НоменклатурнаяГруппа", НомГруппа);

		// КРИТИЧНО: без РучнаяКорректировкаМатериалов=Истина типовое ОПЗС
		// стирает ТЧ Материалы при проведении, пытаясь рассчитать по Спецификации.
		УстановитьРеквизитБезопасно(Стр, "РучнаяКорректировкаМатериалов", Истина);

		// Сохранить связь Идентификатор ЦБ → КлючСтроки БП
		ИдЦБ = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Идентификатор", "");
		Если ЗначениеЗаполнено(ИдЦБ) Тогда
			КарточкаКлючей.Вставить(СокрЛП(Строка(ИдЦБ)), КлючСтроки);
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Заполнить ТЧ Материалы (Ингредиенты) с связкой через КарточкуКлючей.
//
Процедура ЗаполнитьМатериалыProductionRelease(Объект, Док, КарточкаКлючей,
	ИдентификаторПакета, ИсточникUUID, Результат)

	Ингредиенты = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Ингредиенты", Новый Массив);
	Если ТипЗнч(Ингредиенты) <> Тип("Массив") И ТипЗнч(Ингредиенты) <> Тип("ФиксированныйМассив") Тогда
		Возврат;
	КонецЕсли;
	Если Ингредиенты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Объект.Материалы.Очистить();

	СчётМат = TL_МаппингЦБ.ОпределитьСчётГотовойПродукции();  // 41.02 — сырьё тоже на 41.02
	СтатьяЗатрат = TL_МаппингЦБ.ОпределитьСтатьюЗатратМатериалы();
	НомГруппа = TL_МаппингЦБ.ОпределитьНоменклатурнуюГруппуОбщепит();

	Для Каждого СтрJSON Из Ингредиенты Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "Материалы: Номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;

		Стр = Объект.Материалы.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Количество   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);

		УстановитьРеквизитБезопасно(Стр, "Счет",                СчётМат);
		УстановитьРеквизитБезопасно(Стр, "НоменклатурнаяГруппа", НомГруппа);
		УстановитьРеквизитБезопасно(Стр, "СтатьяЗатрат",         СтатьяЗатрат);

		// Связь с продукцией через КарточкуКлючей
		ИдПрод = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "ИдентификаторПродукция", "");
		Если ЗначениеЗаполнено(ИдПрод) Тогда
			КлючСтроки = КарточкаКлючей.Получить(СокрЛП(Строка(ИдПрод)));
			Если КлючСтроки <> Неопределено Тогда
				УстановитьРеквизитБезопасно(Стр, "КлючСтроки", Новый УникальныйИдентификатор);
				// Связь Материалы→Продукция через КлючСтроки продукции
				УстановитьРеквизитБезопасно(Стр, "Продукция", КлючСтроки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// ============================================================================
//  ОБРАБОТКА ДОКУМЕНТА kind=return_purchase (возврат поставщику через Корректировку)
// ============================================================================
//
// Источник в ЦБ — Документ.ВозвратТоваровПоставщику с ТЧ Товары.
// Приёмник в БП ГИГ: Документ.КорректировкаПоступления с ВидОперации=СогласованноеИзменение
// (типовой режим). Корректировка работает БЕЗ партий FIFO — критично для нашего сценария.
//
// JSON-поле "ПервичнаяПТУ_UUID" указывает на исходную ПТУ, по которой делается корректировка.
// Приёмник находит её через TL_СоответствиеИсточников.
//
// ТЧ Товары заполняется парами "ДоИзменения" / "После" — для возврата уменьшаем
// Количество/Сумма (Сумма становится 0 или меньше, выводя сумму возврата в проводку).
//
// Проводки (типовая БП 3.0 для СогласованноеИзменение со уменьшением):
//   Дт 41.02 Кт 60.01 (сторно)     — возврат товара
//   Дт 19.03 Кт 60.01 (сторно)     — восстановление НДС
//
Процедура ОбработатьReturnPurchase(Док, ИдентификаторПакета, ПроводитьПоУмолчанию, Результат)

	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Результат.Ошибки.Добавить("return_purchase: документ без ИсточникUUID — пропущен");
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Объект = НайтиИлиСоздатьВозвратПоставщику(ИсточникUUID);

		// Защита проведённого: не перезаписываем проведённый бухгалтером документ.
		// Аннулирование (ПометкаУдаления) проходит.
		Если ЭтоЗащитаПроведённыхВкл() И Объект.Проведен
			И НЕ TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь) Тогда
			ОтменитьТранзакцию();
			ОбработатьЗащитуПроведённого(Объект, Док,
				Перечисления.TL_ТипОбъектаИсточника.Поступление, ИсточникUUID,
				ИдентификаторПакета, Результат);
			Возврат;
		КонецЕсли;

		Если Не ЗаполнитьШапкуReturnPurchase(Объект, Док, ИдентификаторПакета,
				ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		ЗаполнитьТоварыReturnPurchase(Объект, Док, ИдентификаторПакета,
			ИсточникUUID, Результат);

		ПометкаУдаления = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь);
		ПроведенJSON   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Проведен", Истина);

		Если ПометкаУдаления Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Объект.УстановитьПометкуУдаления(Истина);
		Иначе
			Если Объект.ПометкаУдаления Тогда
				// Объект уже заполнен шапкой/товарами выше → снять пометку сразу нельзя
				// («данные объекта модифицированы»). Сначала записать (сброс флага
				// модификации), затем снять пометку; ниже — перечитывание/перезаполнение.
				Объект.Записать(РежимЗаписиДокумента.Запись);
				Объект.УстановитьПометкуУдаления(Ложь);
				Объект = Объект.Ссылка.ПолучитьОбъект();
				ЗаполнитьШапкуReturnPurchase(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
				ЗаполнитьТоварыReturnPurchase(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
			КонецЕсли;
			Если ПроводитьПоУмолчанию = Ложь Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			ИначеЕсли ПроведенJSON Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			Иначе
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;
			Объект.Записать(РежимЗаписи);
		КонецЕсли;

		// Раскладка блюд общепита → регистр TL_РаскладкаБлюд (только для ОРП; для прочих
		// документов РаскладкаБлюд не заполнена — процедура сразу выйдет).
		ЗаписатьРаскладкуБлюд(Объект.Ссылка, Результат);

		TL_МаппингЦБ.ЗаписатьСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			ИсточникUUID, Объект.Ссылка, ИдентификаторПакета,
			ВычислитьХешДокумента(Док), Результат.КонтекстСмены);

		Результат.Документы.Добавить(Объект.Ссылка);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		Текст = ОписаниеОшибки();
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Прочее,
			Перечисления.TL_КодОшибкиЗагрузки.ОшибкаПроведения,
			"",
			"Ошибка проведения return_purchase: " + Текст,
			Результат);
	КонецПопытки;

КонецПроцедуры

Функция НайтиИлиСоздатьВозвратПоставщику(ИсточникUUID)

	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Поступление, ИсточникUUID);

	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Возврат Объект;
		КонецЕсли;
	КонецЕсли;

	Возврат Документы.КорректировкаПоступления.СоздатьДокумент();

КонецФункции

Функция ЗаполнитьШапкуReturnPurchase(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Объект.Дата = ПолучитьДатуИзJSON(Док, "Дата");
	// СогласованноеИзменение — типовой режим Корректировки для возврата (эталон БП ГИГ)
	// Перечисление: ВидыОперацийИсправленияПоступленияРеализации (не Корректировки!)
	Объект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение;

	// Исходный документ поступления — критично для Корректировки
	ПервичнаяПТУ_UUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПервичнаяПТУ_UUID", "");
	Если ЗначениеЗаполнено(ПервичнаяПТУ_UUID) Тогда
		ПервичнаяПТУ = TL_МаппингЦБ.НайтиСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Поступление, ПервичнаяПТУ_UUID);
		Если ЗначениеЗаполнено(ПервичнаяПТУ) Тогда
			УстановитьРеквизитБезопасно(Объект, "ИсправляемыйДокументПоступления", ПервичнаяПТУ);
		КонецЕсли;
	КонецЕсли;

	// Организация
	ОрганизацияUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Организация", "");
	Орг = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(ОрганизацияUUID);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		// Страховка: организация-источник не сопоставлена — основная организация ГИГ.
		Орг = TL_МаппингЦБ.ОпределитьОрганизациюПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Орг) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Организация,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОрганизацияUUID,
			"Организация не найдена по UUID " + ОрганизацияUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Организация = Орг;

	// Контрагент
	КонтрагентUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Контрагент", "");
	Контр = TL_МаппингЦБ.ПолучитьКонтрагентаПоUUID(КонтрагентUUID);
	Если Не ЗначениеЗаполнено(Контр) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Контрагент,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			КонтрагентUUID,
			"Контрагент не найден по UUID " + КонтрагентUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Контрагент = Контр;

	// Договор
	ДоговорUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ДоговорКонтрагента", "");
	Если Не ЗначениеЗаполнено(ДоговорUUID) Тогда
		ДоговорUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Договор", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДоговорUUID) Тогда
		Договор = TL_МаппингЦБ.ПолучитьДоговорПоUUID(ДоговорUUID, Контр, Неопределено);
		Если ЗначениеЗаполнено(Договор) Тогда
			Объект.ДоговорКонтрагента = Договор;
		КонецЕсли;
	КонецЕсли;

	// Склад
	СкладUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Склад", "");
	Склад = TL_МаппингЦБ.ПолучитьСкладПоUUID(СкладUUID);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Поступление,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			СкладUUID,
			"Склад не найден по UUID " + СкладUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Склад = Склад;

	// Сумма / валюта / флаги
	Объект.СуммаДокумента = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаДокумента", 0);
	УстановитьРеквизитБезопасно(Объект, "ВалютаДокумента", ПолучитьВалютуRUB());
	УстановитьРеквизитБезопасно(Объект, "СуммаВключаетНДС", Истина);
	УстановитьРеквизитБезопасно(Объект, "ВосстановитьНДС", Истина);
	УстановитьРеквизитБезопасно(Объект, "КорректироватьНДС", Истина);
	// КорректироватьБУиНУ — КорректировкаПоступления создаётся через СоздатьДокумент()
	// (ОбработкаЗаполнения не вызывается), поэтому флаг остаётся Ложь и БУ-сторно
	// Дт41.02 Кт60.01 по возврату не формируется — корректируется только НДС. Ставим явно.
	УстановитьРеквизитБезопасно(Объект, "КорректироватьБУиНУ", Истина);

	Объект.Комментарий = ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат);
	Возврат Истина;

КонецФункции

// Заполнить ТЧ Товары КорректировкиПоступления — пары ДоИзменения / После.
// Для возврата: КоличествоДоИзменения и СуммаДоИзменения = что было в ПТУ,
// Количество и Сумма = что осталось после возврата (для полного возврата = 0).
// JSON-поле "Количество" в строке = сколько ВОЗВРАЩАЕМ (а не оставляем).
//
Процедура ЗаполнитьТоварыReturnPurchase(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Товары = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Товары", Новый Массив);
	Если ТипЗнч(Товары) <> Тип("Массив") И ТипЗнч(Товары) <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение "Поле Товары отсутствует или не массив";
	КонецЕсли;

	Объект.Товары.Очистить();

	СчётТовара = TL_МаппингЦБ.ОпределитьСчётУчётаТовара("return_purchase", "Сопутка");

	Для Каждого СтрJSON Из Товары Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "return_purchase: Номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;

		Стр = Объект.Товары.Добавить();
		Стр.Номенклатура = Номенклатура;
		// КоличествоДоКорректировки = "Количество" из JSON (сколько было в ПТУ)
		ВозвратКол = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);
		ВозвратСум = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Сумма", 0);
		ВозвратНДС = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "СуммаНДС", 0);
		Цена = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена", 0);

		Стр.КоличествоДоКорректировки = ВозвратКол;
		Стр.КоличествоДоИзменения     = ВозвратКол;
		Стр.Количество                = 0;  // после корректировки — полный возврат
		Стр.ЦенаДоКорректировки       = Цена;
		Стр.ЦенаДоИзменения           = Цена;
		Стр.Цена                      = Цена;
		Стр.СуммаДоКорректировки      = ВозвратСум;
		Стр.СуммаДоИзменения          = ВозвратСум;
		Стр.Сумма                     = 0;

		ИмяСтавки = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "СтавкаНДС", "");
		СтавкаНДС = TL_МаппингЦБ.СопоставитьСтавкуНДС(ИмяСтавки);
		Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
			ВызватьИсключение "return_purchase: ставка НДС '" + ИмяСтавки + "' не сопоставлена";
		КонецЕсли;
		Стр.СтавкаНДСДоИзменения = СтавкаНДС;
		Стр.СтавкаНДС            = СтавкаНДС;
		Стр.СуммаНДСДоКорректировки = ВозвратНДС;
		Стр.СуммаНДСДоИзменения     = ВозвратНДС;
		Стр.СуммаНДС                = 0;

		УстановитьРеквизитБезопасно(Стр, "СчетУчета",    СчётТовара);
		УстановитьРеквизитБезопасно(Стр, "СчетУчетаНДС", TL_МаппингЦБ.ОпределитьСчётНДС());
		УстановитьРеквизитБезопасно(Стр, "СпособУчетаНДС",
			Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету);
		УстановитьРеквизитБезопасно(Стр, "ЕстьВДокументеПоступления", Истина);
	КонецЦикла;

КонецПроцедуры

// ============================================================================
//  ОБРАБОТКА ДОКУМЕНТА kind=inventory (Инвентаризация товаров на складе)
// ============================================================================
//
// Источник в ЦБ ЭЛСИ.АЗК — Документ.ИнвентаризацияТоваровНаСкладе.
// Приёмник в БП ГИГ — Документ.ИнвентаризацияТоваров (типовой БП 3.0).
// Носитель факта пересчёта без бухгалтерских проводок. Ссылка сохраняется в
// TL_СоответствиеИсточников и используется приёмниками gain/writeoff этого же
// пакета через поле ИнвентаризацияUUID.
//
Процедура ОбработатьInventory(Док, ИдентификаторПакета, ПроводитьПоУмолчанию, Результат)

	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Результат.Ошибки.Добавить("inventory: документ без ИсточникUUID — пропущен");
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Объект = НайтиИлиСоздатьИнвентаризацию(ИсточникUUID);

		// Защита проведённого: не перезаписываем проведённый бухгалтером документ.
		// Аннулирование (ПометкаУдаления) проходит.
		Если ЭтоЗащитаПроведённыхВкл() И Объект.Проведен
			И НЕ TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь) Тогда
			ОтменитьТранзакцию();
			ОбработатьЗащитуПроведённого(Объект, Док,
				Перечисления.TL_ТипОбъектаИсточника.Инвентаризация, ИсточникUUID,
				ИдентификаторПакета, Результат);
			Возврат;
		КонецЕсли;

		Если Не ЗаполнитьШапкуInventory(Объект, Док, ИдентификаторПакета,
				ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		ЗаполнитьТоварыInventory(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);

		ПометкаУдаления = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь);

		Если ПометкаУдаления Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Объект.УстановитьПометкуУдаления(Истина);
		Иначе
			Если Объект.ПометкаУдаления Тогда
				// Объект уже заполнен шапкой/товарами выше → снять пометку сразу нельзя
				// («данные объекта модифицированы»). Сначала записать (сброс флага
				// модификации), затем снять пометку; ниже — перечитывание/перезаполнение.
				Объект.Записать(РежимЗаписиДокумента.Запись);
				Объект.УстановитьПометкуУдаления(Ложь);
				Объект = Объект.Ссылка.ПолучитьОбъект();
				ЗаполнитьШапкуInventory(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
				ЗаполнитьТоварыInventory(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
			КонецЕсли;
			// Инвентаризация — носитель, без бухгалтерских проводок. Только Запись.
			Объект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		TL_МаппингЦБ.ЗаписатьСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Инвентаризация,
			ИсточникUUID, Объект.Ссылка, ИдентификаторПакета,
			ВычислитьХешДокумента(Док), Результат.КонтекстСмены);

		Результат.Документы.Добавить(Объект.Ссылка);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Инвентаризация,
			Перечисления.TL_ПолеОшибки.Прочее,
			Перечисления.TL_КодОшибкиЗагрузки.ОшибкаПроведения,
			"",
			"Ошибка inventory: " + ОписаниеОшибки(),
			Результат);
	КонецПопытки;

КонецПроцедуры

Функция НайтиИлиСоздатьИнвентаризацию(ИсточникUUID)
	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Инвентаризация, ИсточникUUID);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Попытка
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Возврат Объект;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// В БП 3.0 документ называется ИнвентаризацияТоваровНаСкладе (полное имя как в ЦБ).
	Возврат Документы.ИнвентаризацияТоваровНаСкладе.СоздатьДокумент();
КонецФункции

Функция ЗаполнитьШапкуInventory(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Объект.Дата = ПолучитьДатуИзJSON(Док, "Дата");

	ОрганизацияUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Организация", "");
	Орг = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(ОрганизацияUUID);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Инвентаризация,
			Перечисления.TL_ПолеОшибки.Организация,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОрганизацияUUID,
			"Организация не найдена по UUID " + ОрганизацияUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Организация = Орг;

	СкладUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Склад", "");
	Склад = TL_МаппингЦБ.ПолучитьСкладПоUUID(СкладUUID);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Инвентаризация,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			СкладUUID,
			"Склад не найден по UUID " + СкладUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Склад = Склад;

	Объект.Комментарий = ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат);
	Возврат Истина;

КонецФункции

Процедура ЗаполнитьТоварыInventory(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Товары = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Товары", Новый Массив);
	Если ТипЗнч(Товары) <> Тип("Массив") И ТипЗнч(Товары) <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение "inventory: поле Товары не массив";
	КонецЕсли;

	Объект.Товары.Очистить();

	Для Каждого СтрJSON Из Товары Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			// Битая ссылка ЦБ (товар физически удалён из номенклатуры) НЕ должна ронять всю
			// смену: пропускаем строку инвентаризации с записью в журнал ошибок. Инвентаризация
			// информационная, удалённого товара в ней быть не должно; связанные
			// Оприходования/Списания смены при этом создаются и проводятся.
			// Для продаж/поступлений (retail/purchase) fail-fast сохраняется — там пропуск недопустим.
			ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
				Перечисления.TL_ТипОбъектаИсточника.Инвентаризация,
				Перечисления.TL_ПолеОшибки.Номенклатура,
				Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
				НоменклатураUUID,
				"inventory: номенклатура " + НоменклатураUUID
					+ " не сопоставлена (удалена в ЦБ?) — строка пропущена, смена загружена",
				Результат);
			Продолжить;
		КонецЕсли;

		Стр = Объект.Товары.Добавить();
		Стр.Номенклатура   = Номенклатура;
		Стр.Количество     = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество",     0);
		Стр.Цена           = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена",           0);
		Стр.Сумма          = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Сумма",          0);
		УстановитьРеквизитБезопасно(Стр, "КоличествоУчет",
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "КоличествоУчет", 0));
		УстановитьРеквизитБезопасно(Стр, "СуммаУчет",
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "СуммаУчет", 0));
	КонецЦикла;

КонецПроцедуры

// ============================================================================
//  ОБРАБОТКА ДОКУМЕНТА kind=gain (Оприходование товаров)
// ============================================================================
//
// Источник в ЦБ ЭЛСИ.АЗК — Документ.ОприходованиеТоваров.
// Приёмник в БП ГИГ — Документ.ОприходованиеТоваров. Проводки Дт 41.02 Кт 91.01.
// Если в JSON задан ИнвентаризацияUUID — ссылка на inventory того же пакета
// проставляется в реквизит шапки «ИнвентаризацияТоваров» (на стороне БП 3.0).
//
Процедура ОбработатьGain(Док, ИдентификаторПакета, ПроводитьПоУмолчанию, Результат)

	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Результат.Ошибки.Добавить("gain: документ без ИсточникUUID — пропущен");
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Объект = НайтиИлиСоздатьОприходование(ИсточникUUID);

		// Защита проведённого: не перезаписываем проведённый бухгалтером документ.
		// Аннулирование (ПометкаУдаления) проходит.
		Если ЭтоЗащитаПроведённыхВкл() И Объект.Проведен
			И НЕ TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь) Тогда
			ОтменитьТранзакцию();
			ОбработатьЗащитуПроведённого(Объект, Док,
				Перечисления.TL_ТипОбъектаИсточника.Оприходование, ИсточникUUID,
				ИдентификаторПакета, Результат);
			Возврат;
		КонецЕсли;

		Если Не ЗаполнитьШапкуGain(Объект, Док, ИдентификаторПакета,
				ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		ЗаполнитьТоварыGain(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);

		ПометкаУдаления = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь);
		ПроведенJSON   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Проведен", Истина);

		Если ПометкаУдаления Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Объект.УстановитьПометкуУдаления(Истина);
		Иначе
			Если Объект.ПометкаУдаления Тогда
				// Объект уже заполнен шапкой/товарами выше → снять пометку сразу нельзя
				// («данные объекта модифицированы»). Сначала записать (сброс флага
				// модификации), затем снять пометку; ниже — перечитывание/перезаполнение.
				Объект.Записать(РежимЗаписиДокумента.Запись);
				Объект.УстановитьПометкуУдаления(Ложь);
				Объект = Объект.Ссылка.ПолучитьОбъект();
				ЗаполнитьШапкуGain(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
				ЗаполнитьТоварыGain(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
			КонецЕсли;
			Если ПроводитьПоУмолчанию = Ложь Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			ИначеЕсли ПроведенJSON Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			Иначе
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;
			Объект.Записать(РежимЗаписи);
		КонецЕсли;

		TL_МаппингЦБ.ЗаписатьСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Оприходование,
			ИсточникUUID, Объект.Ссылка, ИдентификаторПакета,
			ВычислитьХешДокумента(Док), Результат.КонтекстСмены);

		Результат.Документы.Добавить(Объект.Ссылка);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Оприходование,
			Перечисления.TL_ПолеОшибки.Прочее,
			Перечисления.TL_КодОшибкиЗагрузки.ОшибкаПроведения,
			"",
			"Ошибка gain: " + ОписаниеОшибки(),
			Результат);
	КонецПопытки;

КонецПроцедуры

Функция НайтиИлиСоздатьОприходование(ИсточникUUID)
	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Оприходование, ИсточникUUID);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Попытка
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Возврат Объект;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Документы.ОприходованиеТоваров.СоздатьДокумент();
КонецФункции

Функция ЗаполнитьШапкуGain(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Объект.Дата = ПолучитьДатуИзJSON(Док, "Дата");

	ОрганизацияUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Организация", "");
	Орг = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(ОрганизацияUUID);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Оприходование,
			Перечисления.TL_ПолеОшибки.Организация,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОрганизацияUUID,
			"Организация не найдена по UUID " + ОрганизацияUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Организация = Орг;

	СкладUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Склад", "");
	Склад = TL_МаппингЦБ.ПолучитьСкладПоUUID(СкладUUID);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Оприходование,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			СкладUUID,
			"Склад не найден по UUID " + СкладUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Склад = Склад;

	УстановитьРеквизитБезопасно(Объект, "Подразделение", TL_МаппингЦБ.ПолучитьПодразделениеПоСкладу(Склад));

	// Статья доходов — «Оприходование излишков» (требование учёта ГИГ). Обёрнуто в
	// Попытку: справочник/элемент типовые, но не роняем приёмку если наименование иное.
	Попытка
		СтатьяИзлишков = Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию(
			"Оприходование излишков", Истина);
		Если ЗначениеЗаполнено(СтатьяИзлишков) Тогда
			УстановитьРеквизитБезопасно(Объект, "СтатьяПрочихДоходовРасходов", СтатьяИзлишков);
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Связка с inventory того же пакета через ИнвентаризацияUUID → ссылка из TL_СоответствиеИсточников
	ИнвUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИнвентаризацияUUID", "");
	Если ЗначениеЗаполнено(ИнвUUID) Тогда
		ИнвССылка = TL_МаппингЦБ.НайтиСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Инвентаризация, ИнвUUID);
		Если ЗначениеЗаполнено(ИнвССылка) Тогда
			УстановитьРеквизитБезопасно(Объект, "ИнвентаризацияТоваровНаСкладе", ИнвССылка);
		КонецЕсли;
	КонецЕсли;

	Объект.СуммаДокумента = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаДокумента", 0);
	УстановитьРеквизитБезопасно(Объект, "ВалютаДокумента", ПолучитьВалютуRUB());
	УстановитьРеквизитБезопасно(Объект, "СуммаВключаетНДС",
		TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаВключаетНДС", Истина));

	Объект.Комментарий = ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат);
	Возврат Истина;

КонецФункции

Процедура ЗаполнитьТоварыGain(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Товары = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Товары", Новый Массив);
	Если ТипЗнч(Товары) <> Тип("Массив") И ТипЗнч(Товары) <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение "gain: поле Товары не массив";
	КонецЕсли;

	Объект.Товары.Очистить();
	СчётТовара = TL_МаппингЦБ.ОпределитьСчётУчётаТовара("gain", "Сопутка");

	Для Каждого СтрJSON Из Товары Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "gain: номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;

		Стр = Объект.Товары.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Количество   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);
		Стр.Цена         = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена",       0);
		Стр.Сумма        = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Сумма",      0);

		// НДС у Оприходования излишков НЕ применяется: проводка Дт41.02 Кт91.01 без НДС.
		// В ТЧ Товары нет реквизитов СтавкаНДС/СуммаНДС/СчетУчетаНДС (только СтавкаНДСВРознице),
		// поэтому их установка была no-op, а сопоставление ставки — латентным риском исключения.
		УстановитьРеквизитБезопасно(Стр, "СчетУчета", СчётТовара);
	КонецЦикла;

КонецПроцедуры

// ============================================================================
//  ОБРАБОТКА ДОКУМЕНТА kind=writeoff (Списание товаров)
// ============================================================================
//
// Источник в ЦБ ЭЛСИ.АЗК — Документ.СписаниеТоваров.
// Приёмник в БП ГИГ — Документ.СписаниеТоваров. Проводки Дт 94 Кт 41.02.
// Связка с inventory через ИнвентаризацияUUID (если задан).
//
Процедура ОбработатьWriteoff(Док, ИдентификаторПакета, ПроводитьПоУмолчанию, Результат)

	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Результат.Ошибки.Добавить("writeoff: документ без ИсточникUUID — пропущен");
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Объект = НайтиИлиСоздатьСписание(ИсточникUUID);

		// Защита проведённого: не перезаписываем проведённый бухгалтером документ.
		// Аннулирование (ПометкаУдаления) проходит.
		Если ЭтоЗащитаПроведённыхВкл() И Объект.Проведен
			И НЕ TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь) Тогда
			ОтменитьТранзакцию();
			ОбработатьЗащитуПроведённого(Объект, Док,
				Перечисления.TL_ТипОбъектаИсточника.Списание, ИсточникUUID,
				ИдентификаторПакета, Результат);
			Возврат;
		КонецЕсли;

		Если Не ЗаполнитьШапкуWriteoff(Объект, Док, ИдентификаторПакета,
				ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		ЗаполнитьТоварыWriteoff(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);

		ПометкаУдаления = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь);
		ПроведенJSON   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Проведен", Истина);

		Если ПометкаУдаления Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Объект.УстановитьПометкуУдаления(Истина);
		Иначе
			Если Объект.ПометкаУдаления Тогда
				// Объект уже заполнен шапкой/товарами выше → снять пометку сразу нельзя
				// («данные объекта модифицированы»). Сначала записать (сброс флага
				// модификации), затем снять пометку; ниже — перечитывание/перезаполнение.
				Объект.Записать(РежимЗаписиДокумента.Запись);
				Объект.УстановитьПометкуУдаления(Ложь);
				Объект = Объект.Ссылка.ПолучитьОбъект();
				ЗаполнитьШапкуWriteoff(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
				ЗаполнитьТоварыWriteoff(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
			КонецЕсли;
			Если ПроводитьПоУмолчанию = Ложь Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			ИначеЕсли ПроведенJSON Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			Иначе
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;
			Объект.Записать(РежимЗаписи);
		КонецЕсли;

		TL_МаппингЦБ.ЗаписатьСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Списание,
			ИсточникUUID, Объект.Ссылка, ИдентификаторПакета,
			ВычислитьХешДокумента(Док), Результат.КонтекстСмены);

		Результат.Документы.Добавить(Объект.Ссылка);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Списание,
			Перечисления.TL_ПолеОшибки.Прочее,
			Перечисления.TL_КодОшибкиЗагрузки.ОшибкаПроведения,
			"",
			"Ошибка writeoff: " + ОписаниеОшибки(),
			Результат);
	КонецПопытки;

КонецПроцедуры

Функция НайтиИлиСоздатьСписание(ИсточникUUID)
	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Списание, ИсточникUUID);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Попытка
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Возврат Объект;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Документы.СписаниеТоваров.СоздатьДокумент();
КонецФункции

Функция ЗаполнитьШапкуWriteoff(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Объект.Дата = ПолучитьДатуИзJSON(Док, "Дата");

	ОрганизацияUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Организация", "");
	Орг = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(ОрганизацияUUID);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Списание,
			Перечисления.TL_ПолеОшибки.Организация,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОрганизацияUUID,
			"Организация не найдена по UUID " + ОрганизацияUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Организация = Орг;

	СкладUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Склад", "");
	Склад = TL_МаппингЦБ.ПолучитьСкладПоUUID(СкладUUID);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Списание,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			СкладUUID,
			"Склад не найден по UUID " + СкладUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Склад = Склад;

	УстановитьРеквизитБезопасно(Объект, "Подразделение", TL_МаппингЦБ.ПолучитьПодразделениеПоСкладу(Склад));

	ИнвUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИнвентаризацияUUID", "");
	Если ЗначениеЗаполнено(ИнвUUID) Тогда
		ИнвССылка = TL_МаппингЦБ.НайтиСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Инвентаризация, ИнвUUID);
		Если ЗначениеЗаполнено(ИнвССылка) Тогда
			УстановитьРеквизитБезопасно(Объект, "ИнвентаризацияТоваровНаСкладе", ИнвССылка);
		КонецЕсли;
	КонецЕсли;

	Объект.СуммаДокумента = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СуммаДокумента", 0);
	УстановитьРеквизитБезопасно(Объект, "ВалютаДокумента", ПолучитьВалютуRUB());

	Объект.Комментарий = ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат);
	Возврат Истина;

КонецФункции

Процедура ЗаполнитьТоварыWriteoff(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Товары = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Товары", Новый Массив);
	Если ТипЗнч(Товары) <> Тип("Массив") И ТипЗнч(Товары) <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение "writeoff: поле Товары не массив";
	КонецЕсли;

	Объект.Товары.Очистить();
	СчётТовара = TL_МаппингЦБ.ОпределитьСчётУчётаТовара("writeoff", "Сопутка");

	Для Каждого СтрJSON Из Товары Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "writeoff: номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;

		Стр = Объект.Товары.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Количество   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);
		УстановитьРеквизитБезопасно(Стр, "Цена",
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена", 0));
		УстановитьРеквизитБезопасно(Стр, "Сумма",
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Сумма", 0));
		УстановитьРеквизитБезопасно(Стр, "СчетУчета", СчётТовара);
	КонецЦикла;

КонецПроцедуры

// ============================================================================
//  ОБРАБОТКА ДОКУМЕНТА kind=transfer (Перемещение товаров)
// ============================================================================
//
// Источник в ЦБ ЭЛСИ.АЗК — Документ.ПеремещениеТоваров.
// Приёмник в БП ГИГ — Документ.ПеремещениеТоваров (внутренние движения по 41.02).
// Использует SeparateСкладОтправитель/СкладПолучатель (оба должны быть в БП ГИГ).
//
Процедура ОбработатьTransfer(Док, ИдентификаторПакета, ПроводитьПоУмолчанию, Результат)

	ИсточникUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "");
	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Результат.Ошибки.Добавить("transfer: документ без ИсточникUUID — пропущен");
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Объект = НайтиИлиСоздатьПеремещение(ИсточникUUID);

		// Защита проведённого: не перезаписываем проведённый бухгалтером документ.
		// Аннулирование (ПометкаУдаления) проходит.
		Если ЭтоЗащитаПроведённыхВкл() И Объект.Проведен
			И НЕ TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь) Тогда
			ОтменитьТранзакцию();
			ОбработатьЗащитуПроведённого(Объект, Док,
				Перечисления.TL_ТипОбъектаИсточника.Перемещение, ИсточникUUID,
				ИдентификаторПакета, Результат);
			Возврат;
		КонецЕсли;

		Если Не ЗаполнитьШапкуTransfer(Объект, Док, ИдентификаторПакета,
				ИсточникUUID, Результат) Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;

		ЗаполнитьТоварыTransfer(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);

		ПометкаУдаления = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ПометкаУдаления", Ложь);
		ПроведенJSON   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Проведен", Истина);

		Если ПометкаУдаления Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Объект.УстановитьПометкуУдаления(Истина);
		Иначе
			Если Объект.ПометкаУдаления Тогда
				// Объект уже заполнен шапкой/товарами выше → снять пометку сразу нельзя
				// («данные объекта модифицированы»). Сначала записать (сброс флага
				// модификации), затем снять пометку; ниже — перечитывание/перезаполнение.
				Объект.Записать(РежимЗаписиДокумента.Запись);
				Объект.УстановитьПометкуУдаления(Ложь);
				Объект = Объект.Ссылка.ПолучитьОбъект();
				ЗаполнитьШапкуTransfer(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
				ЗаполнитьТоварыTransfer(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат);
			КонецЕсли;
			Если ПроводитьПоУмолчанию = Ложь Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			ИначеЕсли ПроведенJSON Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			Иначе
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;
			Объект.Записать(РежимЗаписи);
		КонецЕсли;

		TL_МаппингЦБ.ЗаписатьСоответствие(
			Перечисления.TL_ТипОбъектаИсточника.Перемещение,
			ИсточникUUID, Объект.Ссылка, ИдентификаторПакета,
			ВычислитьХешДокумента(Док), Результат.КонтекстСмены);

		Результат.Документы.Добавить(Объект.Ссылка);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Перемещение,
			Перечисления.TL_ПолеОшибки.Прочее,
			Перечисления.TL_КодОшибкиЗагрузки.ОшибкаПроведения,
			"",
			"Ошибка transfer: " + ОписаниеОшибки(),
			Результат);
	КонецПопытки;

КонецПроцедуры

Функция НайтиИлиСоздатьПеремещение(ИсточникUUID)
	Ссылка = TL_МаппингЦБ.НайтиСоответствие(
		Перечисления.TL_ТипОбъектаИсточника.Перемещение, ИсточникUUID);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Попытка
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Возврат Объект;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Документы.ПеремещениеТоваров.СоздатьДокумент();
КонецФункции

Функция ЗаполнитьШапкуTransfer(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Объект.Дата = ПолучитьДатуИзJSON(Док, "Дата");

	ОрганизацияUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Организация", "");
	Орг = TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(ОрганизацияUUID);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Перемещение,
			Перечисления.TL_ПолеОшибки.Организация,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОрганизацияUUID,
			"Организация не найдена по UUID " + ОрганизацияUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.Организация = Орг;

	// Оба склада обязательны
	ОтправUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СкладОтправитель", "");
	Отправ = TL_МаппингЦБ.ПолучитьСкладПоUUID(ОтправUUID);
	Если Не ЗначениеЗаполнено(Отправ) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Перемещение,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ОтправUUID,
			"СкладОтправитель не найден по UUID " + ОтправUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.СкладОтправитель = Отправ;

	ПолучUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "СкладПолучатель", "");
	Получ = TL_МаппингЦБ.ПолучитьСкладПоUUID(ПолучUUID);
	Если Не ЗначениеЗаполнено(Получ) Тогда
		ЗаписатьОшибку(ИдентификаторПакета, ИсточникUUID,
			Перечисления.TL_ТипОбъектаИсточника.Перемещение,
			Перечисления.TL_ПолеОшибки.Склад,
			Перечисления.TL_КодОшибкиЗагрузки.НСИ_НеНайдена,
			ПолучUUID,
			"СкладПолучатель не найден по UUID " + ПолучUUID,
			Результат);
		Возврат Ложь;
	КонецЕсли;
	Объект.СкладПолучатель = Получ;

	УстановитьРеквизитБезопасно(Объект, "Подразделение", TL_МаппингЦБ.ПолучитьПодразделениеПоСкладу(Отправ));

	Объект.Комментарий = ПостроитьКомментарийДокумента(ИдентификаторПакета, ИсточникUUID, Результат);
	Возврат Истина;

КонецФункции

Процедура ЗаполнитьТоварыTransfer(Объект, Док, ИдентификаторПакета, ИсточникUUID, Результат)

	Товары = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Товары", Новый Массив);
	Если ТипЗнч(Товары) <> Тип("Массив") И ТипЗнч(Товары) <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение "transfer: поле Товары не массив";
	КонецЕсли;

	Объект.Товары.Очистить();

	// Перемещение внутри 41.02: счёт-отправитель = счёт-получатель = 41.02.
	// Без СчетУчета/НовыйСчетУчета проведение валит «Не заполнены оба счета»
	// в Регистре бухгалтерии (БП 3.0 не выводит проводку Дт..Кт без счетов).
	Счёт = TL_МаппингЦБ.ОпределитьСчётУчётаТовара("transfer", "Сопутка");

	Для Каждого СтрJSON Из Товары Цикл
		НоменклатураUUID = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Номенклатура", "");
		Номенклатура = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(НоменклатураUUID);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ВызватьИсключение "transfer: номенклатура " + НоменклатураUUID + " не сопоставлена";
		КонецЕсли;

		Стр = Объект.Товары.Добавить();
		Стр.Номенклатура = Номенклатура;
		Стр.Количество   = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Количество", 0);
		УстановитьРеквизитБезопасно(Стр, "Цена",
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Цена", 0));
		УстановитьРеквизитБезопасно(Стр, "Себестоимость",
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрJSON, "Себестоимость", 0));
		УстановитьРеквизитБезопасно(Стр, "СчетУчета",     Счёт);
		УстановитьРеквизитБезопасно(Стр, "НовыйСчетУчета", Счёт);
	КонецЦикла;

КонецПроцедуры

