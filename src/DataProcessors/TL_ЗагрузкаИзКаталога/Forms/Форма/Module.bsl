////////////////////////////////////////////////////////////////////////////////
// Обработка TL_ЗагрузкаИзКаталога, Форма
// Расширение TradeLedger — приём пакетов из ЦБ ЭЛСИ.АЗК через файловый каталог
// (OwnCloud / SMB / локальная папка).
//
// Назначение:
//   Бухгалтерская точка входа для опроса каталога пакетов TL_BP_Export_GIG/,
//   просмотра новых файлов tl_<UUID>_<ts>.json и пакетной загрузки в БП ГИГ.
//
// Реквизиты формы (для сборки Form.bin):
//   КаталогOwnCloud         - Строка - путь к каталогу обмена (источник для опроса)
//   ПроводитьДокументы      - Булево  - проводить созданные документы (default Ложь)
//   МаксФайловЗаПроход      - Число  - ограничение пакета (default 0 — без лимита)
//   ИнфоПоиска              - Строка - сводка после опроса («Найдено N новых из M»)
//   ТекстЛога               - Строка многострочная - журнал операций
//   ТаблицаПакетов          - ТаблицаЗначений с колонками:
//     * Отметка             - Булево
//     * ИмяФайла            - Строка
//     * ИдентификаторПакета - Строка
//     * РазмерКБ            - Число (15,2)
//     * ДатаМодификации     - Дата
//     * УжеЗагружен         - Булево
//     * ПолныйПуть          - Строка
//
// Команды (для сборки Form.bin):
//   КомандаПрочитатьНастройки  → ПрочитатьНастройки()
//   КомандаСохранитьНастройки  → СохранитьНастройки()
//   КомандаОпроситьКаталог     → ОпроситьКаталог()
//   КомандаЗагрузитьВыбранные  → ЗагрузитьВыбранные()
//   КомандаЗагрузитьВсеНовые   → ЗагрузитьВсеНовые()
//   КомандаОчиститьЛог         → ОчиститьЛог()
//
// Источник данных опроса каталога — TL_HTTPКлиентЦБ (новые функции 17.05.2026).
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Перем КонтейнерLOCK; // для предотвращения параллельных загрузок


Процедура ПриОткрытии()
	ПрочитатьНастройки();
	ПроводитьДокументы = Ложь;
	МаксФайловЗаПроход = 0;
	ДобавитьВЛог("Форма открыта. Каталог: " + КаталогOwnCloud);
КонецПроцедуры


// ============================================================================
//   НАСТРОЙКИ
// ============================================================================

Процедура ПрочитатьНастройки() Экспорт
	Попытка
		КаталогOwnCloud = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
		ДобавитьВЛог("Настройки прочитаны. Каталог: " + КаталогOwnCloud);
	Исключение
		ДобавитьВЛог("Ошибка чтения настроек: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры


Процедура СохранитьНастройки() Экспорт
	Если Не ЗначениеЗаполнено(КаталогOwnCloud) Тогда
		Предупреждение("Заполните поле «Каталог OwnCloud».");
		Возврат;
	КонецЕсли;
	Попытка
		TL_Настройки.УстановитьЗначение("КаталогOwnCloud_ЦБ", КаталогOwnCloud,
			"Путь к каталогу обмена ЦБ ↔ БП ГИГ через OwnCloud");
		ДобавитьВЛог("Настройки сохранены. Каталог: " + КаталогOwnCloud);
	Исключение
		ДобавитьВЛог("Ошибка сохранения настроек: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры


// ============================================================================
//   ОПРОС КАТАЛОГА
// ============================================================================

Процедура ОпроситьКаталог() Экспорт

	Если Не ЗначениеЗаполнено(КаталогOwnCloud) Тогда
		Предупреждение("Заполните поле «Каталог OwnCloud» и нажмите «Сохранить настройки».");
		Возврат;
	КонецЕсли;

	ВремяСтарт = ТекущаяДата();
	ДобавитьВЛог("Опрос каталога: " + КаталогOwnCloud);

	Попытка
		// Сначала с фильтром — только новые
		ТЗНовые = TL_HTTPКлиентЦБ.ПолучитьСписокНовыхПакетов(КаталогOwnCloud, Ложь);
		// И всего (без фильтра) для статистики
		ТЗВсе = TL_HTTPКлиентЦБ.ПолучитьСписокНовыхПакетов(КаталогOwnCloud, Истина);

		ТаблицаПакетов.Очистить();
		Для Каждого Стр Из ТЗНовые Цикл
			Новая = ТаблицаПакетов.Добавить();
			Новая.Отметка             = Ложь;
			Новая.ИмяФайла            = Стр.ИмяФайла;
			Новая.ИдентификаторПакета = Стр.ИдентификаторПакета;
			Новая.РазмерКБ            = Стр.РазмерКБ;
			Новая.ДатаМодификации     = Стр.ДатаМодификации;
			Новая.УжеЗагружен         = Стр.УжеЗагружен;
			Новая.ПолныйПуть          = Стр.ПолныйПуть;
		КонецЦикла;

		Длит = ?(ТекущаяДата() - ВремяСтарт = 0, 0, (ТекущаяДата() - ВремяСтарт));
		ИнфоПоиска = "Найдено новых: " + ТаблицаПакетов.Количество()
			+ " (всего в каталоге: " + ТЗВсе.Количество() + ")";
		ДобавитьВЛог(ИнфоПоиска + ", " + Формат(Длит, "ЧДЦ=0") + " сек");
	Исключение
		ИнфоПоиска = "Ошибка";
		ДобавитьВЛог("Ошибка опроса каталога: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры


// ============================================================================
//   ЗАГРУЗКА ПАКЕТОВ
// ============================================================================

Процедура ЗагрузитьВыбранные() Экспорт
	Выбранные = СобратьВыбранныеПути();
	Если Выбранные.Количество() = 0 Тогда
		Предупреждение("Не выбрано ни одного пакета. Установите Отметку в нужных строках.");
		Возврат;
	КонецЕсли;
	ВопросТекст = "Загрузить " + Выбранные.Количество() + " пакет(ов) в БП ГИГ?"
		+ ?(ПроводитьДокументы, " Документы будут проведены.", " Документы будут записаны без проведения.");
	Если Вопрос(ВопросТекст, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗапуститьЗагрузку(Выбранные);
КонецПроцедуры


Процедура ЗагрузитьВсеНовые() Экспорт
	Если ТаблицаПакетов.Количество() = 0 Тогда
		Предупреждение("Сначала нажмите «Опросить каталог».");
		Возврат;
	КонецЕсли;
	ВопросТекст = "Загрузить ВСЕ " + ТаблицаПакетов.Количество() + " пакетов из таблицы?"
		+ ?(МаксФайловЗаПроход > 0, " (с лимитом " + МаксФайловЗаПроход + ")", "")
		+ ?(ПроводитьДокументы, " Документы будут проведены.", " Документы будут записаны без проведения.");
	Если Вопрос(ВопросТекст, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ВремяСтарт = ТекущаяДата();
	Попытка
		Итоги = TL_HTTPКлиентЦБ.ОбработатьВсеНовыеИзКаталога(КаталогOwnCloud,
			ПроводитьДокументы, МаксФайловЗаПроход);
		Длит = ?(ТекущаяДата() - ВремяСтарт = 0, 0, ТекущаяДата() - ВремяСтарт);
		ДобавитьВЛог("Обработка завершена за " + Формат(Длит, "ЧДЦ=0") + " сек:"
			+ " найдено " + Итоги.ВсегоНайдено
			+ ", обработано " + Итоги.Обработано
			+ ", ошибок " + Итоги.Ошибок);
		Если Итоги.Ошибок > 0 Тогда
			Для Каждого Сооб Из Итоги.СписокОшибок Цикл
				ДобавитьВЛог("  [ОШИБКА] " + Сооб);
			КонецЦикла;
		КонецЕсли;
		// Обновить таблицу
		ОпроситьКаталог();
	Исключение
		ДобавитьВЛог("Ошибка пакетной загрузки: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры


Процедура ОчиститьЛог() Экспорт
	ТекстЛога = "";
КонецПроцедуры


// ============================================================================
//   СЛУЖЕБНЫЕ
// ============================================================================

Функция СобратьВыбранныеПути()
	Результат = Новый Массив;
	Для Каждого Стр Из ТаблицаПакетов Цикл
		Если Стр.Отметка = Истина И ЗначениеЗаполнено(Стр.ПолныйПуть) Тогда
			Результат.Добавить(Стр.ПолныйПуть);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции


Процедура ЗапуститьЗагрузку(СписокПутей)
	Обработано = 0;
	Ошибок = 0;
	ВремяСтарт = ТекущаяДата();

	Для Каждого Путь Из СписокПутей Цикл
		Попытка
			Чтение = TL_HTTPКлиентЦБ.ПрочитатьПакетИзФайла(Путь);
			Если ЗначениеЗаполнено(Чтение.Ошибка) Тогда
				ДобавитьВЛог("  [ОШИБКА] чтение " + ИмяФайлаИзПути(Путь) + ": " + Чтение.Ошибка);
				Ошибок = Ошибок + 1;
				Продолжить;
			КонецЕсли;
			Рез = TL_СопуткаСервис.ОбработатьПакет(Чтение.Пакет, ПроводитьДокументы);
			Если Рез.Ошибки.Количество() > 0 Тогда
				ДобавитьВЛог("  [ОШИБКА] обработка " + ИмяФайлаИзПути(Путь) + " ("
					+ Рез.Ошибки.Количество() + " замечаний)");
				Для Сч = 0 По Мин(Рез.Ошибки.Количество() - 1, 4) Цикл
					ДобавитьВЛог("    " + Рез.Ошибки.Получить(Сч));
				КонецЦикла;
				Ошибок = Ошибок + 1;
			Иначе
				Обработано = Обработано + 1;
				ДобавитьВЛог("  [OK] " + ИмяФайлаИзПути(Путь) + " — создано документов: "
					+ Рез.Документы.Количество());
				TL_HTTPКлиентЦБ.ПометитьПакетОбработанным(Путь);
			КонецЕсли;
		Исключение
			Ошибок = Ошибок + 1;
			ДобавитьВЛог("  [ИСКЛЮЧЕНИЕ] " + ИмяФайлаИзПути(Путь) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Длит = ?(ТекущаяДата() - ВремяСтарт = 0, 0, ТекущаяДата() - ВремяСтарт);
	ДобавитьВЛог("Итого за " + Формат(Длит, "ЧДЦ=0") + " сек: обработано " + Обработано
		+ ", ошибок " + Ошибок);

	// Обновить таблицу (загруженные исчезнут из списка)
	ОпроситьКаталог();
КонецПроцедуры


Функция ИмяФайлаИзПути(Путь)
	Попытка
		Файл = Новый Файл(Путь);
		Возврат Файл.Имя;
	Исключение
		Возврат Путь;
	КонецПопытки;
КонецФункции


Процедура ДобавитьВЛог(Текст)
	Префикс = "[" + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + "] ";
	Если ПустаяСтрока(ТекстЛога) Тогда
		ТекстЛога = Префикс + Текст;
	Иначе
		ТекстЛога = ТекстЛога + Символы.ПС + Префикс + Текст;
	КонецЕсли;
КонецПроцедуры


// Обработчики событий командных кнопок (вызываются после сборки Form.bin)
Процедура КнопкаПрочитатьНастройкиНажатие(Кнопка)
	ПрочитатьНастройки();
КонецПроцедуры

Процедура КнопкаСохранитьНастройкиНажатие(Кнопка)
	СохранитьНастройки();
КонецПроцедуры

Процедура КнопкаОпроситьКаталогНажатие(Кнопка)
	ОпроситьКаталог();
КонецПроцедуры

Процедура КнопкаЗагрузитьВыбранныеНажатие(Кнопка)
	ЗагрузитьВыбранные();
КонецПроцедуры

Процедура КнопкаЗагрузитьВсеНовыеНажатие(Кнопка)
	ЗагрузитьВсеНовые();
КонецПроцедуры

Процедура КнопкаОчиститьЛогНажатие(Кнопка)
	ОчиститьЛог();
КонецПроцедуры
