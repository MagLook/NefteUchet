	УстановитьЗначение("Топливо_6_Литры",     "Дизельное топливо ЗИМА (л)","ДТ зимний литры");
	УстановитьЗначение("Топливо_6_Плотность", "0.840",                    "Плотность ДТ зимний");
	УстановитьЗначение("Топливо_7_Тонны",     "СУГ (т)",                  "СУГ тонны");
	УстановитьЗначение("Топливо_7_Литры",     "СУГ (л)",                  "СУГ литры");
	УстановитьЗначение("Топливо_7_Плотность", "0.550",                    "Плотность СУГ");

	// === Оплаты — 4 канала ===
	// retail (Наличные + СберБанк)
	УстановитьЗначение("Оплата_retail_Наименование",       "Розница (наличные + эквайринг)",  "Канал retail");
	УстановитьЗначение("Оплата_retail_Склад",              "",                                "Без перемещения");
	УстановитьЗначение("Оплата_retail_ТребуетПеремещения",  "Нет",                            "");
	// cards (топливные карты)
	УстановитьЗначение("Оплата_cards_Наименование",       "Топливные карты",    "Канал cards");
	УстановитьЗначение("Оплата_cards_Склад",              "Карты",              "Виртуальный склад");
	УстановитьЗначение("Оплата_cards_ТребуетПеремещения",  "Да",                "");
	// online (МобилПр., Яндекс, Benzuber)
	УстановитьЗначение("Оплата_online_Наименование",       "Онлайн (Яндекс, МобилПр.)",  "Канал online");
	УстановитьЗначение("Оплата_online_Склад",              "ЯНДЕКС",                     "Виртуальный склад");
	УстановитьЗначение("Оплата_online_ТребуетПеремещения",  "Да",                         "");
	// ledger (ведомости)
	УстановитьЗначение("Оплата_ledger_Наименование",       "Ведомости",          "Канал ledger");
	УстановитьЗначение("Оплата_ledger_Склад",              "Ведомости",          "Виртуальный склад");
	УстановитьЗначение("Оплата_ledger_ТребуетПеремещения",  "Да",                "");
	// voucher (талоны)
	УстановитьЗначение("Оплата_voucher_Наименование",      "Талоны",             "Канал voucher");
	УстановитьЗначение("Оплата_voucher_Склад",             "Талоны",             "Виртуальный склад");
	УстановитьЗначение("Оплата_voucher_ТребуетПеремещения", "Да",                "");
	// writeoff_fuel (техсписания топлива, pay_type=Прочие)
	УстановитьЗначение("Оплата_writeoff_fuel_Наименование",      "Списание топлива (Прочие)",
		"Канал writeoff_fuel — автосоздание СписаниеТоваров для pay_type=Прочие из STS");
	УстановитьЗначение("Оплата_writeoff_fuel_Склад",             "",           "Без виртуального склада");
	УстановитьЗначение("Оплата_writeoff_fuel_ТребуетПеремещения", "Нет",        "Это списание со склада АЗС");

	// === Время проведения документов ===
	УстановитьЗначение("ВремяДок_СменныйОтчёт",       "23:50",  "Время: Отчёт о розничных продажах");
	УстановитьЗначение("ВремяДок_ПеремещениеТТН",      "11:00",  "Время: Перемещение тонн (ТТН)");
	УстановитьЗначение("ВремяДок_Комплектация",        "13:00",  "Время: Комплектация тонны → литры");
	УстановитьЗначение("ВремяДок_ПеремещениеКаналов",  "23:50",  "Время: Перемещения по каналам оплат");

	// === Маппинг оплат STS → канал + склад ===
	// Делегируем в отдельную экспортную процедуру — её можно вызывать
	// без перетирания остальных настроек (URL/Логин/Топливо/Каналы).
	ЗаполнитьТолькоМаппингОплат();

КонецПроцедуры

// Идемпотентно заполнить ВСЮ конфигурацию TradeLedger значениями по умолчанию.
// Главная экспортная точка для процедуры обновления (G4 плана luminous-humming-curry).
//
// Принципы:
//   - НЕ перетирает существующие настройки. Ручные правки бухгалтера сохраняются.
//   - Только дополняет недостающее (использует УстановитьЗначениеЕслиНет
//     и УстановитьМаппингОплатыПоУмолчанию — обе идемпотентные).
//   - Заполняет: TL_Настройки (URL/Логин/НДС/Время/Канал/Топливо/12 АЗС),
//                TL_МаппингОплат (20 строк),
//                — виртуальные склады НЕ создаёт (это НСИ бухгалтера).
//
// Параметры:
//   ТолькоПроверить - Булево - если Истина, только подсчитывает что НЕ заполнено,
//                             ничего не пишет. Возвращает количества как при реальной записи.
//
// Возвращаемое значение:
//   Структура("СозданоВидовОплат, СозданоМаппингов, СозданоСтанций, СозданоНастроек, Лог")
//
Функция ЗаполнитьВсюКонфигурациюПоУмолчанию(ТолькоПроверить = Ложь) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("СозданоВидовОплат", 0);
	Результат.Вставить("СозданоМаппингов",  0);
	Результат.Вставить("СозданоСтанций",    0);
	Результат.Вставить("СозданоНастроек",   0);
	Результат.Вставить("Лог", Новый Массив);

	// --- 1. Базовые TL_Настройки (мягкое заполнение — пустое заполнить, заполненное не трогать) ---
	БазовыеНастройки = Новый Массив;
	БазовыеНастройки.Добавить(Новый Структура("Ключ, Значение, Описание",
		"URLСервера",       "https://pos.autooplata.ru/tms",  "API STS"));
	БазовыеНастройки.Добавить(Новый Структура("Ключ, Значение, Описание",
		"Логин",            "UserApi",                        "API STS"));
	БазовыеНастройки.Добавить(Новый Структура("Ключ, Значение, Описание",
		"Пароль",           "lHQfLZHzB3tn",                   "API STS"));
	БазовыеНастройки.Добавить(Новый Структура("Ключ, Значение, Описание",
		"КодСистемы",       "65",                             "ГИГ = 65"));
	БазовыеНастройки.Добавить(Новый Структура("Ключ, Значение, Описание",
		"Сети",             "15",                             "Дополнительные системы STS (АЗС 8,208,209,210)"));
	БазовыеНастройки.Добавить(Новый Структура("Ключ, Значение, Описание",
		"Организация",      "ГАЗИНВЕСТГРУПП ООО",             "Основная организация"));
	БазовыеНастройки.Добавить(Новый Структура("Ключ, Значение, Описание",
		"ОсновнойСклад",    "Основной склад",                 "Склад 41.01 (тонны)"));
	БазовыеНастройки.Добавить(Новый Структура("Ключ, Значение, Описание",
		"СтавкаНДС",        "22",                             "НДС 22%"));
	БазовыеНастройки.Добавить(Новый Структура("Ключ, Значение, Описание",
		"КаталогOwnCloud_ЦБ", "C:\TL_BP_Export\",            "Каталог обмена ЦБ→БП (SQL1, сопутка+общепит)"));

	// Топливо — service_code по справочнику STS:
	//   1=АИ-100  2=АИ-92  3=АИ-95  4=АИ-98  5=ДТ  6=ДТ зим.  7=СУГ
	//   (0=Руб. — служебный, не топливо)
	ДобавитьВ(БазовыеНастройки, "Топливо_1_Тонны",     "АИ-100(т)",                "АИ-100 тонны");
	ДобавитьВ(БазовыеНастройки, "Топливо_1_Литры",     "АИ-100(л)",                "АИ-100 литры");
	ДобавитьВ(БазовыеНастройки, "Топливо_1_Плотность", "0.760",                    "Плотность АИ-100");
	ДобавитьВ(БазовыеНастройки, "Топливо_2_Тонны",     "АИ-92(т)",                 "АИ-92 тонны");
	ДобавитьВ(БазовыеНастройки, "Топливо_2_Литры",     "АИ-92 (л)",                "АИ-92 литры");
	ДобавитьВ(БазовыеНастройки, "Топливо_2_Плотность", "0.738",                    "Плотность АИ-92");
	ДобавитьВ(БазовыеНастройки, "Топливо_3_Тонны",     "АИ-95(т)",                 "АИ-95 тонны");
	ДобавитьВ(БазовыеНастройки, "Топливо_3_Литры",     "АИ-95 (л)",                "АИ-95 литры");
	ДобавитьВ(БазовыеНастройки, "Топливо_3_Плотность", "0.741",                    "Плотность АИ-95");
	ДобавитьВ(БазовыеНастройки, "Топливо_4_Тонны",     "АИ-98(т)",                 "АИ-98 тонны");
	ДобавитьВ(БазовыеНастройки, "Топливо_4_Литры",     "АИ-98(л)",                 "АИ-98 литры");
	ДобавитьВ(БазовыеНастройки, "Топливо_4_Плотность", "0.755",                    "Плотность АИ-98");
	ДобавитьВ(БазовыеНастройки, "Топливо_5_Тонны",     "Дизельное топливо (т)",    "ДТ тонны");
	ДобавитьВ(БазовыеНастройки, "Топливо_5_Литры",     "Дизельное топливо (л)",    "ДТ литры");
	ДобавитьВ(БазовыеНастройки, "Топливо_5_Плотность", "0.819",                    "Плотность ДТ");
	ДобавитьВ(БазовыеНастройки, "Топливо_6_Тонны",     "Дизельное топливо ЗИМА (т)","ДТ зимний тонны");
	ДобавитьВ(БазовыеНастройки, "Топливо_6_Литры",     "Дизельное топливо ЗИМА (л)","ДТ зимний литры");
	ДобавитьВ(БазовыеНастройки, "Топливо_6_Плотность", "0.840",                    "Плотность ДТ зимний");
	ДобавитьВ(БазовыеНастройки, "Топливо_7_Тонны",     "СУГ (т)",                  "СУГ тонны");
	ДобавитьВ(БазовыеНастройки, "Топливо_7_Литры",     "СУГ (л)",                  "СУГ литры");
	ДобавитьВ(БазовыеНастройки, "Топливо_7_Плотность", "0.550",                    "Плотность СУГ");

	// Время документов
	ДобавитьВ(БазовыеНастройки, "ВремяДок_СменныйОтчёт",       "23:50", "Время: Отчёт о розничных продажах");
	ДобавитьВ(БазовыеНастройки, "ВремяДок_ПеремещениеТТН",     "11:00", "Время: Перемещение тонн (ТТН)");
	ДобавитьВ(БазовыеНастройки, "ВремяДок_Комплектация",       "13:00", "Время: Комплектация тонны → литры");
	ДобавитьВ(БазовыеНастройки, "ВремяДок_ПеремещениеКаналов", "23:50", "Время: Перемещения по каналам оплат");

	// Каналы оплат (6 — добавлен writeoff_fuel)
	ДобавитьВ(БазовыеНастройки, "Оплата_retail_Наименование",       "Розница (наличные + эквайринг)", "");
	ДобавитьВ(БазовыеНастройки, "Оплата_retail_Склад",              "",                               "");
	ДобавитьВ(БазовыеНастройки, "Оплата_retail_ТребуетПеремещения", "Нет",                            "");
	ДобавитьВ(БазовыеНастройки, "Оплата_cards_Наименование",        "Топливные карты",                "");
	ДобавитьВ(БазовыеНастройки, "Оплата_cards_Склад",               "Карты",                          "");
	ДобавитьВ(БазовыеНастройки, "Оплата_cards_ТребуетПеремещения",  "Да",                             "");
	ДобавитьВ(БазовыеНастройки, "Оплата_online_Наименование",       "Онлайн (Яндекс, МобилПр.)",      "");
	ДобавитьВ(БазовыеНастройки, "Оплата_online_Склад",              "ЯНДЕКС",                         "");
	ДобавитьВ(БазовыеНастройки, "Оплата_online_ТребуетПеремещения", "Да",                             "");
	ДобавитьВ(БазовыеНастройки, "Оплата_ledger_Наименование",       "Ведомости",                      "");
	ДобавитьВ(БазовыеНастройки, "Оплата_ledger_Склад",              "Ведомости",                      "");
	ДобавитьВ(БазовыеНастройки, "Оплата_ledger_ТребуетПеремещения", "Да",                             "");
	ДобавитьВ(БазовыеНастройки, "Оплата_voucher_Наименование",      "Талоны",                         "");
	ДобавитьВ(БазовыеНастройки, "Оплата_voucher_Склад",             "Талоны",                         "");
	ДобавитьВ(БазовыеНастройки, "Оплата_voucher_ТребуетПеремещения","Да",                             "");
	ДобавитьВ(БазовыеНастройки, "Оплата_writeoff_fuel_Наименование","Списание топлива (Прочие)",
		"Канал для автосоздания СписаниеТоваров при pay_type=Прочие");
	ДобавитьВ(БазовыеНастройки, "Оплата_writeoff_fuel_Склад",       "",                               "");
	ДобавитьВ(БазовыеНастройки, "Оплата_writeoff_fuel_ТребуетПеремещения","Нет",                      "");

	// Модель учёта общепита (вариант Галины 22.05.2026):
	//   "B" = Дт 90.02.1 Кт 41.02 по каждому ингредиенту, ОПЗС не создаётся
	//   "A" = Дт 41.02 Кт 44.01 (выпуск) + Дт 44.01 Кт 41.02 (списание сырья) — legacy НЛ
	ДобавитьВ(БазовыеНастройки, "Общепит_МодельУчёта",  "B",
		"Модель учёта общепита: B = списание на 90.02.1 по ТТК (ГИГ), A = через 44.01 (legacy НЛ)");

	Для Каждого Н Из БазовыеНастройки Цикл
		Если ТолькоПроверить Тогда
			// Только проверяем, что ключа нет или он пуст
			ТекЗнач = ПолучитьЗначение(Н.Ключ, "");
			Если ПустаяСтрока(ТекЗнач) Тогда
				Результат.СозданоНастроек = Результат.СозданоНастроек + 1;
				Результат.Лог.Добавить("Будет создано: " + Н.Ключ + " = " + Н.Значение);
			КонецЕсли;
		Иначе
			Создано = УстановитьЗначениеЕслиНет(Н.Ключ, Н.Значение, Н.Описание);
			Если Создано Тогда
				Результат.СозданоНастроек = Результат.СозданоНастроек + 1;
				Результат.Лог.Добавить("Создано: " + Н.Ключ + " = " + Н.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// --- 2. 12 АЗС сети ГИГ (мягкое заполнение Станция_*_*) ---
	СписокАЗС = ПолучитьСтандартныйСписокАЗС();
	Для Каждого АЗС Из СписокАЗС Цикл
		Префикс = "Станция_" + АЗС.КодСтанции + "_";
		Ключи = Новый Массив;
		Ключи.Добавить(Новый Структура("Ключ, Значение",
			Префикс + "Наименование", АЗС.Наименование));
		Ключи.Добавить(Новый Структура("Ключ, Значение",
			Префикс + "Склад", АЗС.Склад));
		Ключи.Добавить(Новый Структура("Ключ, Значение",
			Префикс + "ВремяЗакрытия", "00:00"));
		Ключи.Добавить(Новый Структура("Ключ, Значение",
			Префикс + "КодСистемы", АЗС.КодСистемы));

		СтанцияСоздана = Ложь;
		Для Каждого К Из Ключи Цикл
			Если ТолькоПроверить Тогда
				ТекЗнач = ПолучитьЗначение(К.Ключ, "");
				Если ПустаяСтрока(ТекЗнач) Тогда
					СтанцияСоздана = Истина;
					Результат.Лог.Добавить("Будет создано: " + К.Ключ + " = " + К.Значение);
				КонецЕсли;
			Иначе
				Если УстановитьЗначениеЕслиНет(К.Ключ, К.Значение, "Станция АЗС " + АЗС.КодСтанции) Тогда
					СтанцияСоздана = Истина;
					Результат.Лог.Добавить("Создано: " + К.Ключ + " = " + К.Значение);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Если СтанцияСоздана Тогда
			Результат.СозданоСтанций = Результат.СозданоСтанций + 1;
		КонецЕсли;
	КонецЦикла;

	// --- 3. Маппинг оплат TL_МаппингОплат (20 строк) ---
	// УстановитьМаппингОплатыПоУмолчанию — уже идемпотентная (не трогает существующие записи).
	КолДоМаппинга = ПодсчитатьЗаписейМаппинга();
	Если Не ТолькоПроверить Тогда
		ЗаполнитьТолькоМаппингОплат();
		КолПослеМаппинга = ПодсчитатьЗаписейМаппинга();
		Результат.СозданоМаппингов = КолПослеМаппинга - КолДоМаппинга;
		Результат.Лог.Добавить("Маппингов добавлено: " + Результат.СозданоМаппингов
			+ " (было " + КолДоМаппинга + ", стало " + КолПослеМаппинга + ")");
	Иначе
		// В режиме ТолькоПроверить — не можем вызвать без записи. Считаем приблизительно
		// по списку из эталона (20 строк) минус уже существующие.
		Попытка
			Эталон = ПолучитьЭталонныйСписокМаппингов();
			Для Каждого Имя Из Эталон Цикл
				МЗ = РегистрыСведений.TL_МаппингОплат.СоздатьМенеджерЗаписи();
				МЗ.ОбразецИмени = Имя;
				МЗ.Прочитать();
				Если Не МЗ.Выбран() Тогда
					Результат.СозданоМаппингов = Результат.СозданоМаппингов + 1;
					Результат.Лог.Добавить("Будет создан маппинг: " + Имя);
				КонецЕсли;
			КонецЦикла;
		Исключение
			// Регистр не создан в БД — норма при первой проверке до UpdateDBCfg
			Результат.Лог.Добавить("Регистр TL_МаппингОплат недоступен (ожидается после обновления конфигурации)");
		КонецПопытки;
	КонецЕсли;

	// --- 4. Подсчёт «видов оплат» — это количество уникальных каналов в TL_Настройки ---
	// (Каналы хранятся в TL_Настройки через ключи Оплата_<канал>_*. Считаем уникальные <канал>.)
	Результат.СозданоВидовОплат = 6; // retail, cards, online, ledger, voucher, writeoff_fuel — эталон

	ЗаписьЖурналаРегистрации("TL_Настройки",
		УровеньЖурналаРегистрации.Информация, , ,
		"ЗаполнитьВсюКонфигурациюПоУмолчанию (" + ?(ТолькоПроверить, "проверка", "запись") + ")"
		+ ": настроек +" + Результат.СозданоНастроек
		+ ", станций +" + Результат.СозданоСтанций
		+ ", маппингов +" + Результат.СозданоМаппингов);

	Возврат Результат;

КонецФункции

