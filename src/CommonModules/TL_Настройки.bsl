////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_Настройки
// Расширение TradeLedger для 1С:БП 3.0
// Контекст: Сервер, Экспорт
// Работа с настройками расширения через регистр сведений TL_Настройки.
//
// Паттерн key-value: Ключ → Значение (строка).
// Если регистр TL_Настройки не существует — fallback на ХранилищеОбщихНастроек.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Получить строковое значение настройки.
//
// Параметры:
//   Ключ                 - Строка - ключ настройки
//   ЗначениеПоУмолчанию  - Строка - если настройка не найдена
//
// Возвращаемое значение:
//   Строка
//
Функция ПолучитьЗначение(Ключ, ЗначениеПоУмолчанию = "") Экспорт

	// Попытка чтения из регистра TL_Настройки
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	TL_Настройки.Значение КАК Значение
			|ИЗ
			|	РегистрСведений.TL_Настройки КАК TL_Настройки
			|ГДЕ
			|	TL_Настройки.Ключ = &Ключ";

		Запрос.УстановитьПараметр("Ключ", Ключ);
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Значение) Тогда
			Возврат Выборка.Значение;
		КонецЕсли;
	Исключение
		// Регистр TL_Настройки не существует — fallback ниже
	КонецПопытки;

	// Fallback: ХранилищеОбщихНастроек (обратная совместимость)
	Попытка
		Зн = ХранилищеОбщихНастроек.Загрузить("TL_" + Ключ);
		Если Зн <> Неопределено И ЗначениеЗаполнено(Зн) Тогда
			Возврат Строка(Зн);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Получить числовое значение настройки.
//
Функция ПолучитьЧисло(Ключ, ЗначениеПоУмолчанию = 0) Экспорт

	СтроковоеЗначение = ПолучитьЗначение(Ключ, XMLСтрока(ЗначениеПоУмолчанию));

	Попытка
		Возврат Число(СтроковоеЗначение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

// Установить значение настройки.
//
// Параметры:
//   Ключ      - Строка
//   Значение  - Строка
//   Описание  - Строка (необязательно)
//
Процедура УстановитьЗначение(Ключ, Значение, Описание = "") Экспорт

	Попытка
		МенеджерЗаписи = РегистрыСведений.TL_Настройки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Ключ = Ключ;
		МенеджерЗаписи.Прочитать();

		МенеджерЗаписи.Ключ = Ключ;
		МенеджерЗаписи.Значение = Значение;

		Если Не ПустаяСтрока(Описание) Тогда
			МенеджерЗаписи.Описание = Описание;
		КонецЕсли;

		МенеджерЗаписи.Записать();
	Исключение
		// Регистр не существует — пишем в ХранилищеОбщихНастроек
		Попытка
			ХранилищеОбщихНастроек.Сохранить("TL_" + Ключ, , Значение);
		Исключение
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

// Получить организацию из настроек.
// Ищет по наименованию из настройки "Организация".
// Fallback: первая неудалённая организация.
//
// Возвращаемое значение:
//   СправочникСсылка.Организации
//
Функция ПолучитьОрганизацию() Экспорт

	Наименование = ПолучитьЗначение("Организация", "");

	Если ЗначениеЗаполнено(Наименование) Тогда
		Результат = Справочники.Организации.НайтиПоНаименованию(Наименование, Истина);
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// Fallback: первая неудалённая
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ссылка
		|ИЗ
		|	Справочник.Организации
		|ГДЕ
		|	НЕ ПометкаУдаления";

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

// Получить основной склад из настроек.
// Fallback: первый неудалённый склад.
//
// Возвращаемое значение:
//   СправочникСсылка.Склады
//
Функция ПолучитьОсновнойСклад() Экспорт

	Наименование = ПолучитьЗначение("ОсновнойСклад", "");

	Если ЗначениеЗаполнено(Наименование) Тогда
		Результат = Справочники.Склады.НайтиПоНаименованию(Наименование, Истина);
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// Fallback: первый неудалённый
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ссылка
		|ИЗ
		|	Справочник.Склады
		|ГДЕ
		|	НЕ ПометкаУдаления";

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Склады.ПустаяСсылка();

КонецФункции

// Получить поставщика из настроек.
// Fallback: БАЛТОП / Сургутнефтегаз.
//
// Возвращаемое значение:
//   СправочникСсылка.Контрагенты
//
Функция ПолучитьПоставщика() Экспорт

	Наименование = ПолучитьЗначение("Поставщик", "");

	Если ЗначениеЗаполнено(Наименование) Тогда
		Результат = Справочники.Контрагенты.НайтиПоНаименованию(Наименование, Истина);
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// Fallback: стандартные поставщики
	ИскатьИмена = Новый Массив;
	ИскатьИмена.Добавить("БАЛТОП");
	ИскатьИмена.Добавить("Балтоп");
	ИскатьИмена.Добавить("СУРГУТНЕФТЕГАЗ");
	ИскатьИмена.Добавить("Сургутнефтегаз");

	Для Каждого Имя Из ИскатьИмена Цикл
		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(Имя, Истина);
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Возврат Контрагент;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Получить ставку НДС (22% или 20% для старых конфигураций).
//
// Возвращаемое значение:
//   ПеречислениеСсылка.СтавкиНДС или Неопределено
//
Функция ПолучитьСтавкуНДС() Экспорт

	Попытка
		Возврат Перечисления.СтавкиНДС.НДС22;
	Исключение
	КонецПопытки;

	Попытка
		Возврат Перечисления.СтавкиНДС.НДС20;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
