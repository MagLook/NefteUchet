// Выполнить выбранное действие перезагрузки на сервере, вылить лог в журнал формы.
//
&НаСервере
Процедура ВыполнитьПерезагрузкуНаСервере(Действие)

	Р = Неопределено;

	Если Действие = "Дозагрузить" Тогда
		Р = TL_СозданиеДокументов.ПерезагрузкаПериода_Дозагрузить(
			ДатаНачала, ДатаОкончания, КодСтанции);
		ИтоговаяСтрока = "Дозагрузка завершена: затронуто " + Р.Затронуто
			+ ", создано документов +" + Р.Создано
			+ ", пропущено " + Р.Пропущено + ", ошибок " + Р.Ошибок;
	ИначеЕсли Действие = "Перепровести" Тогда
		Р = TL_СозданиеДокументов.ПерезагрузкаПериода_ПерепровестиСвязанные(
			ДатаНачала, ДатаОкончания, КодСтанции);
		ИтоговаяСтрока = "Перепроведение завершено: проведено " + Р.Проведено
			+ " из " + Р.Затронуто + ", ошибок " + Р.Ошибок;
	ИначеЕсли Действие = "СбросРегистрации" Тогда
		Р = TL_СозданиеДокументов.ПерезагрузкаПериода_СбросРегистрации(
			ДатаНачала, ДатаОкончания, КодСтанции);
		ИтоговаяСтрока = "Сброс завершён: удалено " + Р.Удалено + " записей";
	Иначе
		ДобавитьВЛогСервер("Неизвестное действие: " + Действие);
		Возврат;
	КонецЕсли;

	Если Р <> Неопределено Тогда
		Для Каждого СтрокаЛога Из Р.Лог Цикл
			ДобавитьВЛогСервер(СтрокаЛога);
		КонецЦикла;
		ДобавитьВЛогСервер(ИтоговаяСтрока);
	КонецЕсли;

	// Обновить дашборд + список загруженных
	ОбновитьДанныеНаСервере();

КонецПроцедуры

// Открыть отдельную форму деталей документа (на весь экран).
// КлючБазовый передаётся когда документ загружен в БП — для показа
// «📂 открыть» рядом со связанными документами.
//
&НаКлиенте
Процедура ОткрытьФормуДеталей(ТипДокумента, ДанныеJSON, ЗаголовокДетали, КлючБазовый = "")

	Если Не ЗначениеЗаполнено(ДанныеJSON) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТипДокумента", ТипДокумента);
	ПараметрыФормы.Вставить("ДанныеJSON", ДанныеJSON);
	ПараметрыФормы.Вставить("Заголовок", ЗаголовокДетали);
	ПараметрыФормы.Вставить("КлючБазовый", КлючБазовый);

	ОткрытьФорму("Обработка.TL_Загрузка.Форма.ФормаДетали",
		ПараметрыФормы, ЭтотОбъект, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// При нажатии кнопки "Сохранить" в HTML-настройках.
// ID кнопки = "btnSave", данные в window.settingsJSON.
//
&НаКлиенте
Процедура HTMLДеталиПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Element = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдЭлемента = "";
	Попытка ИдЭлемента = ДанныеСобытия.Element.id; Исключение КонецПопытки;

	// data-action атрибут — универсальный механизм действий из HTML.
	// Формат: "help|оглавление", "help|ключ-статьи", "error|категория" и т.п.
	ДействиеЭлемента = "";
	Попытка ДействиеЭлемента = ДанныеСобытия.Element.getAttribute("data-action"); Исключение КонецПопытки;
	Если ДействиеЭлемента = Неопределено Тогда ДействиеЭлемента = ""; КонецЕсли;

	// --- Кнопка "Сохранить" настройки ---
	Если ИдЭлемента = "btnSave" Тогда
		СтандартнаяОбработка = Ложь;
		Попытка
			СтрокаJSON = Элементы.HTMLДетали.Документ.defaultView.settingsJSON;
		Исключение
			СтрокаJSON = Неопределено;
		КонецПопытки;
		Если СтрокаJSON <> Неопределено И ЗначениеЗаполнено(СтрокаJSON) Тогда
			СохранитьНастройкиИзHTML(СтрокаJSON);
			ДобавитьВЛог("Настройки сохранены");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// --- Действия помощи (H): help|оглавление или help|<ключ> ---
	Если СтрНачинаетсяС(ДействиеЭлемента, "help|") Тогда
		СтандартнаяОбработка = Ложь;
		Ключ = Сред(ДействиеЭлемента, 6);
		Если Ключ = "оглавление" ИЛИ ПустаяСтрока(Ключ) Тогда
			ОткрытьПомощьНаСервере();
		Иначе
			ОткрытьСтатьюПомощиНаСервере(Ключ);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// --- Открыть документ БП по UUID: open|<ВидДок>|<UUID> ---
	// Из HTML-деталей: «📂 открыть» рядом со созданным документом
	Если СтрНачинаетсяС(ДействиеЭлемента, "open|") Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьДокументПоUUIDИзHTML(Сред(ДействиеЭлемента, 6));
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Открыть документ БП по action-строке вида "<ВидДок>|<UUID>".
// ВидДок = "Перемещение", "Комплектация", "ОРП", "ПКО", "Списание", "ПТУ".
//
&НаКлиенте
Процедура ОткрытьДокументПоUUIDИзHTML(Парам)
	Части = СтрРазделить(Парам, "|");
	Если Части.Количество() < 2 Тогда Возврат; КонецЕсли;
	Вид = Части[0];
	UUID = Части[1];
	Попытка
		Ссылка = ПолучитьСсылкуНаДокументНаСервере(Вид, UUID);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			ОткрытьЗначение(Ссылка);
		Иначе
			ДобавитьВЛог("Документ не найден: " + Вид + " " + UUID);
		КонецЕсли;
	Исключение
		ДобавитьВЛог("Не удалось открыть документ: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ПолучитьСсылкуНаДокументНаСервере(Вид, UUID)
	Менеджеры = Новый Соответствие;
	Менеджеры.Вставить("Перемещение",   Документы.ПеремещениеТоваров);
	Менеджеры.Вставить("Комплектация",  Документы.КомплектацияНоменклатуры);
	Менеджеры.Вставить("ОРП",           Документы.ОтчетОРозничныхПродажах);
	Менеджеры.Вставить("ПКО",           Документы.ПриходныйКассовыйОрдер);
	Менеджеры.Вставить("Списание",      Документы.СписаниеТоваров);
	Менеджеры.Вставить("ПТУ",           Документы.ПоступлениеТоваровУслуг);

	М = Менеджеры.Получить(Вид);
	Если М = Неопределено Тогда Возврат Неопределено; КонецЕсли;

	Попытка
		Возврат М.ПолучитьСсылку(Новый УникальныйИдентификатор(UUID));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// При активизации строки — ничего не делаем (подавляем старое поведение).
//
&НаКлиенте
Процедура ВнешниеДанныеПриАктивизацииСтроки(Элемент)
КонецПроцедуры

// По двойному клику — открыть полноэкранную форму деталей.
//
&НаКлиенте
Процедура ВнешниеДанныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Не открывать при клике на колонку "Отметка" (галочка)
	Если Поле.Имя = "ВнешниеДанныеОтметка" Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОткрытьФормуДеталей(
		ТекущаяСтрока.ТипДокумента,
		ТекущаяСтрока.ДанныеJSON,
		ТекущаяСтрока.Описание + ", АЗС " + ТекущаяСтрока.Станция
			+ ", " + Формат(ТекущаяСтрока.Дата, "ДФ='dd.MM.yyyy'"));

КонецПроцедуры

// При активизации строки в левой панели — ничего не делаем.
//
&НаКлиенте
Процедура ВнутренниеДанныеПриАктивизацииСтроки(Элемент)
КонецПроцедуры

// По двойному клику в левой панели — открыть полноэкранную форму деталей.
// Если JSON нет (ранее загруженный документ) — подгрузить из API.
//
&НаКлиенте
Процедура ВнутренниеДанныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ВнутренниеДанныеОтметка" Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Определить тип базового документа
	КлючБаз = ТекущаяСтрока.КлючБазовый;
	ТипДок = СокрЛП(ТекущаяСтрока.ТипДокумента);
	Если ТипДок = "Перемещение" ИЛИ ТипДок = "Комплектация" Тогда
		Если СтрНайти(КлючБаз, "|СМЕНА|") > 0 Тогда
			ТипДок = "Смена";
		ИначеЕсли СтрНайти(КлючБаз, "|ТТН|") > 0 Тогда
			ТипДок = "ТТН";
		КонецЕсли;
	КонецЕсли;

	// Если документ УЖЕ в БД (любой статус, не помечен) — открываем его напрямую.
	// Так не идём в STS API (1-3 сек) для каждого клика. Бухгалтер сразу видит
	// проводки в типовой форме документа БП.
	СсылкаДок = ПолучитьГлавныйДокументПакетаНаСервере(КлючБаз);
	Если ЗначениеЗаполнено(СсылкаДок) Тогда
		Попытка
			ОткрытьЗначение(СсылкаДок);
			Возврат;
		Исключение
			ДобавитьВЛог("Не удалось открыть документ: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	// Документа в БД нет — пробуем HTML-просмотр из STS (как раньше).
	// 1. Кеш: сохранённое в текущей строке (после первой подгрузки)
	ДанныеJSON = СокрЛП(ТекущаяСтрока.ДанныеJSON);

	// 2. Если в строке пусто — поискать в других строках текущей сессии
	Если Не ЗначениеЗаполнено(ДанныеJSON) Тогда
		ДанныеJSON = НайтиJSONПоКлючу(КлючБаз);
	КонецЕсли;

	// 3. Если всё ещё пусто — подгрузить из API (1-3 сек) и СОХРАНИТЬ в строке
	Если Не ЗначениеЗаполнено(ДанныеJSON) Тогда
		ДанныеJSON = ПодгрузитьJSONИзAPI(КлючБаз, ТипДок);
		Если ЗначениеЗаполнено(ДанныеJSON) Тогда
			ТекущаяСтрока.ДанныеJSON = ДанныеJSON; // кэш на повторные клики
		КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДанныеJSON) Тогда
		ДобавитьВЛог("Нет данных для просмотра — API недоступен или документ не найден");
		Возврат;
	КонецЕсли;

	ОткрытьФормуДеталей(ТипДок, ДанныеJSON,
		СокрЛП(ТекущаяСтрока.Описание) + ", АЗС " + ТекущаяСтрока.Станция
			+ ", " + Формат(ТекущаяСтрока.Дата, "ДФ='dd.MM.yyyy'"),
		КлючБаз);

КонецПроцедуры

// Найти главный документ пакета (Перемещение для ТТН, ОРП для смены) в БД.
// Используется в двойном клике — если документ есть, открываем его напрямую
// без обращения к STS API.
//
&НаСервереБезКонтекста
Функция ПолучитьГлавныйДокументПакетаНаСервере(КлючБазовый)
	СписокДок = TL_РегистрСтатусов.ПолучитьДокументыПоБазовомуКлючу(КлючБазовый);
	// 1. Сначала ищем именно базовый ключ (ОРП у смены) если документ есть
	Для Каждого ИнфоДок Из СписокДок Цикл
		Если ИнфоДок.Ключ = КлючБазовый И ЗначениеЗаполнено(ИнфоДок.Ссылка) Тогда
			Возврат ИнфоДок.Ссылка;
		КонецЕсли;
	КонецЦикла;
	// 2. Для ТТН (где базового ключа нет в БД) — берём первое Перемещение
	Для Каждого ИнфоДок Из СписокДок Цикл
		Если СтрНайти(ИнфоДок.Ключ, "|ПЕРЕМ") > 0 И ЗначениеЗаполнено(ИнфоДок.Ссылка) Тогда
			Возврат ИнфоДок.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Подгрузить JSON из API по ключу загрузки.
// Ключ: TL|СМЕНА|65|5|91 → система=65, станция=5, смена=91
// Ключ: TL|ТТН|65|5|12345 → система=65, станция=5, ТТН=12345
//
&НаСервере
Функция ПодгрузитьJSONИзAPI(КлючБазовый, ТипДок)

	Части = СтрРазделить(КлючБазовый, "|");
	// TL|СМЕНА|65|5|91 → Части[2]=система, Части[3]=станция, Части[4]=номер
	Если Части.Количество() < 5 Тогда
		Возврат "";
	КонецЕсли;

	КодСистемы_API = Число(Части[2]);
	КодСтанции_API = Число(Части[3]);
	НомерСмены_API = Число(Части[4]);

	Если Не ЗначениеЗаполнено(URLСервера) Тогда
		Возврат "";
	КонецЕсли;

	// Авторизация (или кэш)
	Токен = ТокенAPI;
	Если Не ЗначениеЗаполнено(Токен) Тогда
		Попытка
			Токен = TL_ApiКлиент.Авторизация(URLСервера, Логин, Пароль, КодСистемы_API);
			ТокенAPI = Токен;
		Исключение
			Возврат "";
		КонецПопытки;
	КонецЕсли;

	Если ТипДок = "Смена" Тогда
		Попытка
			Отчёт = TL_ApiКлиент.ПолучитьСменныйОтчёт(
				URLСервера, Токен, КодСистемы_API, КодСтанции_API, НомерСмены_API);
			Если Отчёт <> Неопределено Тогда
				Если ТипЗнч(Отчёт) = Тип("Соответствие") Тогда
					Отчёт.Вставить("station", КодСтанции_API);
				КонецЕсли;
				Возврат TL_ApiКлиент.ОбъектВJSON(Отчёт);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// ТТН: ключ TL|ТТН|65|5|НомерТТН|КодТоплива
	// Нужно найти смену, в которой была эта ТТН, и получить поступления по ней
	Если ТипДок = "ТТН" Тогда
		НомерТТН = Части[4];
		КодТоплива = "";
		Если Части.Количество() >= 6 Тогда
			КодТоплива = Части[5];
		КонецЕсли;
		// Перебираем смены за период — ищем ТТН по номеру
		Попытка
			ОтветСмены = TL_ApiКлиент.ПолучитьСписокСмен(URLСервера, Токен, КодСистемы_API, КодСтанции_API);
			Если ТипЗнч(ОтветСмены) = Тип("Массив") Тогда
				Для Каждого ЭлСмены Из ОтветСмены Цикл
					НомСмены = Число(TL_ApiКлиент.ПолучитьЗначение(ЭлСмены, "shift", 0));
					Поступления = TL_ApiКлиент.ПолучитьПоступления(
						URLСервера, Токен, КодСистемы_API, КодСтанции_API, НомСмены);
					Для Каждого ЭлТТН Из Поступления Цикл
						НомТТНТек = Строка(TL_ApiКлиент.ПолучитьЗначение(ЭлТТН, "ttn", ""));
						Если НомТТНТек = НомерТТН Тогда
							Если ТипЗнч(ЭлТТН) = Тип("Соответствие") Тогда
								ЭлТТН.Вставить("station", КодСтанции_API);
							КонецЕсли;
							Возврат TL_ApiКлиент.ОбъектВJSON(ЭлТТН);
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат "";

КонецФункции

// Собрать связанные документы для панели деталей (смена или ТТН).
// Каждый элемент = Структура(ТипДокумента, Описание, Статус, UUID, ВидДокумента),
// где UUID/ВидДокумента используются для кнопки «📂 открыть» в HTML.
//
&НаКлиенте
Функция СобратьСвязанныеДокументыДляДеталей(КлючБазовый)

	Связанные = Новый Массив;
	Для Каждого Стр Из ВнутренниеДанные Цикл
		Если Стр.КлючБазовый = КлючБазовый И Стр.КлючЗагрузки <> КлючБазовый Тогда
			СвязДок = Новый Структура("ТипДокумента, Описание, Статус, UUID, ВидДокумента");
			СвязДок.ТипДокумента = Стр.ТипДокумента;
			СвязДок.Описание = Стр.Описание;
			СвязДок.Статус = Стр.Статус;
			СвязДок.UUID = "";
			СвязДок.ВидДокумента = "";
			Связанные.Добавить(СвязДок);
		КонецЕсли;
	КонецЦикла;
	// Дополнить UUID-ами на сервере (поиск документов по ключам)
	ЗаполнитьUUIDСвязанных(КлючБазовый, Связанные);

	Возврат Связанные;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьUUIDСвязанных(КлючБазовый, Связанные)
	Документы = TL_РегистрСтатусов.ПолучитьДокументыПоБазовомуКлючу(КлючБазовый);
	// Документы — Массив(Структура(Ключ, Ссылка, Статус)).
	// Связанные — клиентский массив, мапим по подключу.
	ПоКлючу = Новый Соответствие;
	Для Каждого ИнфоДок Из Документы Цикл
		Если ЗначениеЗаполнено(ИнфоДок.Ссылка) Тогда
			ПоКлючу.Вставить(ИнфоДок.Ключ, ИнфоДок.Ссылка);
		КонецЕсли;
	КонецЦикла;
	// Для каждой строки массива — найти ссылку по подключу
	Для Каждого СвязДок Из Связанные Цикл
		// Подключ восстанавливаем из описания? — нет, тут проще: возьмём по типу
		// и грубо привяжем по ТипДокумента. Точнее — ищем подключ соответствующего типа.
		ТипК = ?(ВРег(СвязДок.ТипДокумента) = "ПЕРЕМЕЩЕНИЕ", "|ПЕРЕМ",
				?(ВРег(СвязДок.ТипДокумента) = "КОМПЛЕКТАЦИЯ", "|КОМПЛ",
				?(ВРег(СвязДок.ТипДокумента) = "ПКО", "|ПКО",
				?(ВРег(СвязДок.ТипДокумента) = "СПИСАНИЕ", "|СПИСАНИЕ", ""))));
		Если ПустаяСтрока(ТипК) Тогда Продолжить; КонецЕсли;
		Для Каждого КЗ Из ПоКлючу Цикл
			Если СтрНайти(КЗ.Ключ, ТипК) > 0 Тогда
				СвязДок.UUID = XMLСтрока(КЗ.Значение.УникальныйИдентификатор());
				СвязДок.ВидДокумента = СвязДок.ТипДокумента;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ==========================================================================
//  ОБНОВЛЕНИЕ ДАННЫХ (загрузка списка из API + сверка с 1С)
// ==========================================================================

&НаСервере
Процедура ОбновитьДанныеНаСервере()

	ВнешниеДанные.Очистить();
	ВнутренниеДанные.Очистить();
	HTMLДетали = TL_HTMLГенератор.ПустыеДетали();

	Если Не ЗначениеЗаполнено(ТипДокументаФильтр) Тогда
		ТипДокументаФильтр = "Все";
	КонецЕсли;

	СохранитьНастройки();

	// Развилка по режиму: Сопутка/Общепит читают пакеты из каталога OwnCloud
	// (наши АЗС*_*.json от TL_ЭкспортБП), Нефтепродукты — через STS API ниже.
	ТекРежим = ПолучитьТекущийРежимНаСервере();
	Если ТекРежим = "Сопутка" ИЛИ ТекРежим = "Общепит" Тогда
		ОбновитьДанныеИзКаталогаПакетов(ТекРежим);
		Возврат;
	КонецЕсли;

	// --- Валидация периода ---
	Если ДатаНачала > ДатаОкончания Тогда
		ДобавитьВЛогСервер("Ошибка: дата начала (" + Формат(ДатаНачала, "ДФ='dd.MM.yyyy'")
			+ ") позже даты окончания (" + Формат(ДатаОкончания, "ДФ='dd.MM.yyyy'") + ")");
		Возврат;
	КонецЕсли;

	// --- 1. Построить карту сетей и станций ---
	// СтанцииПоСетям: Соответствие (КодСистемы → Массив кодов станций)
	СтанцииПоСетям = Новый Соответствие;

	Если КодСтанции > 0 Тогда
		// Конкретная станция — берём её сеть
		КСт = TL_Настройки.ПолучитьКодСистемыСтанции(КодСтанции);

		// Проверка: настроен ли склад? Если нет — предупреждение, но запросы делаем
		// (чтобы пользователь видел количество смен) — а ошибка вылезет при загрузке.
		СкладПрив = TL_Настройки.НайтиСкладСтанции(КодСтанции);
		Если Не ЗначениеЗаполнено(СкладПрив) Тогда
			ДобавитьВЛогСервер("Внимание: для станции " + XMLСтрока(КодСтанции)
				+ " не настроен склад. Откройте «Настройка расширения» → выберите склад.");
		КонецЕсли;

		МассивСт = Новый Массив;
		МассивСт.Добавить(КодСтанции);
		СтанцииПоСетям.Вставить(КСт, МассивСт);
	Иначе
		// Все станции — группируем по сетям
		ВсеСтанции = TL_Настройки.ПолучитьВсеСтанции();
		Если ВсеСтанции.Количество() = 0 Тогда
			// Fallback: одна сеть из глобальных настроек
			СтанцииПоСетям.Вставить(КодСистемы, Новый Массив);
		Иначе
			Для Каждого Ст Из ВсеСтанции Цикл
				КСт = Ст.КодСистемы;
				Если СтанцииПоСетям.Получить(КСт) = Неопределено Тогда
					СтанцииПоСетям.Вставить(КСт, Новый Массив);
				КонецЕсли;
				Попытка КодЧисло = Число(Ст.Код); Исключение КодЧисло = 0; КонецПопытки;
				Если КодЧисло > 0 Тогда
					СтанцииПоСетям.Получить(КСт).Добавить(КодЧисло);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// --- 2. Кеш токенов по сетям ---
	ТокеныСетей = Новый Соответствие; // КодСистемы → Токен

	// --- 3. Загруженные документы из 1С ---
	ЗагруженныеДокументы = ПолучитьЗагруженныеДокументы();

	// Дополнить базовыми ТТН-ключами из дочерних (ПЕРЕМ/КОМПЛ).
	ДопКлючи = Новый Соответствие;
	Для Каждого КлючЗнач Из ЗагруженныеДокументы Цикл
		Ключ = КлючЗнач.Ключ;
		Если СтрНайти(Ключ, "|ПЕРЕМ") > 0 ИЛИ СтрНайти(Ключ, "|КОМПЛ") > 0 Тогда
			Части = СтрРазделить(Ключ, "|");
			Если Части.Количество() >= 6 Тогда
				БазовыйКлюч = Части[0] + "|" + Части[1] + "|" + Части[2]
					+ "|" + Части[3] + "|" + Части[4] + "|" + Части[5];
				Если ЗагруженныеДокументы.Получить(БазовыйКлюч) = Неопределено Тогда
					ДопКлючи.Вставить(БазовыйКлюч, КлючЗнач.Значение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючЗнач Из ДопКлючи Цикл
		ЗагруженныеДокументы.Вставить(КлючЗнач.Ключ, КлючЗнач.Значение);
	КонецЦикла;

	// --- 4. Цикл по сетям → станциям ---
	Для Каждого КЗСеть Из СтанцииПоСетям Цикл

		ТекКодСистемы = КЗСеть.Ключ;
		ТекСтанции = КЗСеть.Значение;

		// Авторизация для этой сети
		Токен = ТокеныСетей.Получить(ТекКодСистемы);
		Если Не ЗначениеЗаполнено(Токен) Тогда
			Попытка
				Токен = TL_ApiКлиент.Авторизация(URLСервера, Логин, Пароль, ТекКодСистемы);
			Исключение
				ДобавитьВЛогСервер("Исключение при авторизации сети " + XMLСтрока(ТекКодСистемы) + ": " + ОписаниеОшибки());
				Продолжить;
			КонецПопытки;
			Если Не ЗначениеЗаполнено(Токен) Тогда
				ДобавитьВЛогСервер("Ошибка авторизации сети " + XMLСтрока(ТекКодСистемы));
				Продолжить;
			КонецЕсли;
			ТокеныСетей.Вставить(ТекКодСистемы, Токен);
			ТокенAPI = Токен; // запоминаем для статуса STS
			ДобавитьВЛогСервер("Авторизация сеть " + XMLСтрока(ТекКодСистемы) + " — OK");
		КонецЕсли;

		// Обнаружение ненастроенных станций (для режима "Все")
		Если КодСтанции = 0 Тогда
			ПроверитьНенастроенныеСтанции(Токен);
		КонецЕсли;

		// Если в массиве нет конкретных станций — запрос без фильтра (station=0)
		Если ТекСтанции.Количество() = 0 Тогда
			ТекСтанции.Добавить(0);
		КонецЕсли;

		Для Каждого СтанцияКод Из ТекСтанции Цикл

		ОтветСмены = TL_ApiКлиент.ПолучитьСписокСмен(URLСервера, Токен, ТекКодСистемы, СтанцияКод);
		Смены = НормализоватьОтветСмен(ОтветСмены);
		// (детальный счёт по станциям — в свод после всех сетей)

		Для Каждого ЭлементСмены Из Смены Цикл

			НомерСмены = Число(TL_ApiКлиент.ПолучитьЗначение(ЭлементСмены, "shift", 0));
			СтанцияИзОтвета = Число(TL_ApiКлиент.ПолучитьЗначение(ЭлементСмены, "station", СтанцияКод));

			// Пропустить незакрытые смены (текущая открытая)
			ДатаЗакрытия = TL_ApiКлиент.ПолучитьДатуИзДанных(ЭлементСмены, "dt_close");
			Если Не ЗначениеЗаполнено(ДатаЗакрытия) Тогда
				Продолжить;
			КонецЕсли;

			ДатаСмены = TL_ApiКлиент.ПолучитьДатуИзДанных(ЭлементСмены, "dt_open");
			Если Не ЗначениеЗаполнено(ДатаСмены) Тогда
				ДатаСмены = TL_ApiКлиент.ПолучитьДатуИзДанных(ЭлементСмены, "date");
			КонецЕсли;

			// Нормализация финансового дня (смена закрытая в 07:00 → предыдущий день)
			ДатаСмены = TL_Настройки.НормализоватьДатуСмены(ДатаСмены, СтанцияИзОтвета);

			// Фильтр по периоду
			Если ЗначениеЗаполнено(ДатаСмены) Тогда
				Если ДатаСмены < НачалоДня(ДатаНачала) ИЛИ ДатаСмены > КонецДня(ДатаОкончания) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			// --- Смены ---
			Если ТипДокументаФильтр = "Все" ИЛИ ТипДокументаФильтр = "Смены" Тогда

				ОтчётРасш = TL_ApiКлиент.ПолучитьСменныйОтчётРасш(
					URLСервера, Токен, ТекКодСистемы, СтанцияИзОтвета, НомерСмены);

				КлючСмены = "TL|СМЕНА|" + XMLСтрока(ТекКодСистемы)
					+ "|" + XMLСтрока(СтанцияИзОтвета)
					+ "|" + XMLСтрока(НомерСмены);

				Если ОтчётРасш.Успех Тогда
					Отчёт = ОтчётРасш.Данные;
					Описание = "Смена №" + XMLСтрока(НомерСмены);
				ИначеЕсли ОтчётРасш.HTTPКод = 500 Тогда
					Отчёт = Неопределено;
					Описание = "Смена №" + XMLСтрока(НомерСмены) + " — ⚠ STS HTTP 500 (сервер STS не отвечает, не настройка БП)";
					ДобавитьВЛогСервер("STS-сервер не отдал отчёт по смене "
						+ XMLСтрока(СтанцияИзОтвета) + "/" + XMLСтрока(НомерСмены)
						+ ": HTTP 500. Это серверная ошибка STS — обратитесь в техподдержку pos.autooplata.ru.");
				ИначеЕсли ОтчётРасш.ТипОшибки = "Авторизация" Тогда
					Отчёт = Неопределено;
					Описание = "Смена №" + XMLСтрока(НомерСмены) + " — ⚠ ошибка авторизации STS";
					ДобавитьВЛогСервер("Ошибка авторизации STS для смены "
						+ XMLСтрока(СтанцияИзОтвета) + "/" + XMLСтрока(НомерСмены)
						+ " (HTTP " + XMLСтрока(ОтчётРасш.HTTPКод) + "). Проверьте логин/пароль в Настройках TradeLedger.");
				ИначеЕсли ОтчётРасш.ТипОшибки = "Сеть" Тогда
					Отчёт = Неопределено;
					Описание = "Смена №" + XMLСтрока(НомерСмены) + " — ⚠ сетевая ошибка";
					ДобавитьВЛогСервер("Сетевая ошибка для смены "
						+ XMLСтрока(СтанцияИзОтвета) + "/" + XMLСтрока(НомерСмены)
						+ ". Проверьте подключение к интернету / VPN к STS.");
				Иначе
					Отчёт = Неопределено;
					Описание = "Смена №" + XMLСтрока(НомерСмены) + " — ⚠ HTTP " + XMLСтрока(ОтчётРасш.HTTPКод);
					ДобавитьВЛогСервер("Неожиданный ответ STS для смены "
						+ XMLСтрока(СтанцияИзОтвета) + "/" + XMLСтрока(НомерСмены)
						+ ": HTTP " + XMLСтрока(ОтчётРасш.HTTPКод));
				КонецЕсли;

				СуммаИтого = ВычислитьСуммуСмены(Отчёт);

				ДанныеJSON = "";
				Если Отчёт <> Неопределено Тогда
					Если ТипЗнч(Отчёт) = Тип("Соответствие") Тогда
						Отчёт.Вставить("station", СтанцияИзОтвета);
					КонецЕсли;
					ДанныеJSON = TL_ApiКлиент.ОбъектВJSON(Отчёт);
				КонецЕсли;

				ИнфоДок = ЗагруженныеДокументы.Получить(КлючСмены);
				Если ИнфоДок <> Неопределено Тогда
					ДобавитьВнутреннюю(КлючСмены, КлючСмены, "Смена", ДатаСмены,
						СтанцияИзОтвета, Описание, СуммаИтого, ИнфоДок);
				Иначе
					ДобавитьВнешнюю("Смена", ДатаСмены, СтанцияИзОтвета,
						НомерСмены, Описание, СуммаИтого, КлючСмены, ДанныеJSON);
				КонецЕсли;

			КонецЕсли;

			// --- ТТН ---
			Если ТипДокументаФильтр = "Все" ИЛИ ТипДокументаФильтр = "ТТН" Тогда

				Поступления = TL_ApiКлиент.ПолучитьПоступления(
					URLСервера, Токен, ТекКодСистемы, СтанцияИзОтвета, НомерСмены);

				Для Каждого ЭлементТТН Из Поступления Цикл

					НомерТТН = Строка(TL_ApiКлиент.ПолучитьЗначение(ЭлементТТН, "ttn", ""));
					КодТоплива = Строка(TL_ApiКлиент.ПолучитьЗначение(ЭлементТТН, "fuel", ""));

					// Парсим doc.volume/doc.amount (новый формат) или doc_volume/amount (старый)
					ДокДанные = TL_ApiКлиент.ПолучитьЗначение(ЭлементТТН, "doc", Неопределено);
					Если ДокДанные <> Неопределено Тогда
						МассаКг = Число(TL_ApiКлиент.ПолучитьЗначение(ДокДанные, "amount", 0));
						СуммаТТН = Число(TL_ApiКлиент.ПолучитьЗначение(ДокДанные, "cost", 0));
					Иначе
						МассаКг = Число(TL_ApiКлиент.ПолучитьЗначение(ЭлементТТН, "doc_volume", 0)) * 1000;
						СуммаТТН = Число(TL_ApiКлиент.ПолучитьЗначение(ЭлементТТН, "amount", 0));
					КонецЕсли;
					МассаТонн = МассаКг / 1000;

					ДатаТТН = TL_ApiКлиент.ПолучитьДатуИзДанных(ЭлементТТН, "date");
					Если Не ЗначениеЗаполнено(ДатаТТН) Тогда
						ДатаТТН = ДатаСмены;
					КонецЕсли;

					КлючТТН = "TL|ТТН|" + XMLСтрока(ТекКодСистемы)
						+ "|" + XMLСтрока(СтанцияИзОтвета)
						+ "|" + НомерТТН
						+ "|" + КодТоплива;

					ИмяТоплива = TL_Настройки.ПолучитьНаименованиеТоплива(КодТоплива);
					ОписаниеТТН = "ТТН №" + НомерТТН + " " + ИмяТоплива
						+ " " + Формат(МассаТонн, "ЧДЦ=3") + "т";

					Если ТипЗнч(ЭлементТТН) = Тип("Соответствие") Тогда
						ЭлементТТН.Вставить("station", СтанцияИзОтвета);
					КонецЕсли;
					ДанныеТТНJSON = TL_ApiКлиент.ОбъектВJSON(ЭлементТТН);

					ИнфоДок = ЗагруженныеДокументы.Получить(КлючТТН);
					Если ИнфоДок <> Неопределено Тогда
						ДобавитьВнутреннюю(КлючТТН, КлючТТН, "ТТН", ДатаТТН,
							СтанцияИзОтвета, ОписаниеТТН, СуммаТТН, ИнфоДок);
					Иначе
						ДобавитьВнешнюю("ТТН", ДатаТТН, СтанцияИзОтвета,
							НомерСмены, ОписаниеТТН, СуммаТТН, КлючТТН, ДанныеТТНJSON);
					КонецЕсли;

				КонецЦикла;

			КонецЕсли;

		КонецЦикла;

	КонецЦикла; // Для Каждого СтанцияКод

	КонецЦикла; // Для Каждого КЗСеть (цикл по сетям)

	ВнешниеДанные.Сортировать("Дата УБЫВ");
	ВнутренниеДанные.Сортировать("Дата УБЫВ, КлючБазовый, ТипДокумента");

	// --- 5. Обновить HTML-дашборд ---
	ОбновитьДашборд();

КонецПроцедуры

// ==========================================================================
//  ЗАГРУЗКА ВЫБРАННЫХ (правая → левая панель)
// ==========================================================================

&НаСервере
Процедура ЗагрузитьВыбранныеНаСервере()

	// Развилка по режиму: для Сопутки/Общепита — отдельная процедура,
	// которая для каждой отмеченной строки вызывает ОбработатьПакетИзФайла.
	ТекРежим = ПолучитьТекущийРежимНаСервере();
	Если ТекРежим = "Сопутка" ИЛИ ТекРежим = "Общепит" Тогда
		ЗагрузитьВыбранныеПакетыНаСервере(ТекРежим);
		Возврат;
	КонецЕсли;

	Счётчик = 0;
	СчИдемпотент = 0;
	СчОшибок = 0;
	ИндексыУдаления = Новый Массив;

	// Прогресс: считаем сколько отмечено, пишем сводку каждые 10 док в лог.
	// Состояние() недоступно на сервере, real-time прогресс через статус-бар
	// невозможен в синхронной серверной процедуре — только в лог.
	ВсегоОтмечено = 0;
	Для Каждого СтрПодсчёт Из ВнешниеДанные Цикл
		Если СтрПодсчёт.Отметка Тогда ВсегоОтмечено = ВсегоОтмечено + 1; КонецЕсли;
	КонецЦикла;
	ТекущийНомер = 0;
	НачалоВр = ТекущаяДата();
	ДобавитьВЛогСервер("▶ Старт загрузки: " + ВсегоОтмечено + " документов отмечено");

	Для Инд = 0 По ВнешниеДанные.Количество() - 1 Цикл

		Стр = ВнешниеДанные[Инд];

		Если Не Стр.Отметка Тогда
			Продолжить;
		КонецЕсли;

		ТекущийНомер = ТекущийНомер + 1;
		// Прогресс — только в лог каждые 10 документов
		Если ТекущийНомер % 10 = 0 ИЛИ ТекущийНомер = ВсегоОтмечено Тогда
			Прошло = (ТекущаяДата() - НачалоВр);
			Темп = ?(Прошло > 0, Окр(ТекущийНомер / Прошло, 1), 0);
			Осталось = ?(Темп > 0, Окр((ВсегоОтмечено - ТекущийНомер) / Темп, 0), 0);
			ДобавитьВЛогСервер("   обработано " + ТекущийНомер + "/" + ВсегоОтмечено
				+ " · ✓" + Счётчик + " ℹ" + СчИдемпотент + " ✗" + СчОшибок
				+ " · темп " + Темп + " док/сек"
				+ " · осталось ~" + Осталось + " сек");
		КонецЕсли;

		Результат = Неопределено;

		Если Стр.ТипДокумента = "Смена" Тогда
			Результат = TL_СозданиеДокументов.ОбработатьСмену(
				Стр.ДанныеJSON, Стр.КлючЗагрузки, Ложь, Стр.Дата);
		ИначеЕсли Стр.ТипДокумента = "ТТН" Тогда
			Результат = TL_СозданиеДокументов.ОбработатьТТН(
				Стр.ДанныеJSON, Стр.КлючЗагрузки, Ложь, Стр.Дата);
		КонецЕсли;

		Если Результат <> Неопределено Тогда
			УжеБылЗагружен = Ложь;
			БылиОшибки = Ложь;
			ПерваяОшибка = "";
			Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
				Если СтрНайти(ТекстОшибки, "уже загружен") > 0 ИЛИ СтрНайти(ТекстОшибки, "уже загружена") > 0 Тогда
					УжеБылЗагружен = Истина;
				Иначе
					БылиОшибки = Истина;
					Если ПустаяСтрока(ПерваяОшибка) Тогда
						ПерваяОшибка = ТекстОшибки;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если БылиОшибки И Не УжеБылЗагружен И Результат.Документы.Количество() = 0 Тогда
				СчОшибок = СчОшибок + 1;
				// В лог — только КОРОТКАЯ сводка: тип, ID, первая ошибка (детали в Подробном отчёте)
				ДобавитьВЛогСервер("✗ " + Стр.ТипДокумента + " " + Стр.Станция + "/"
					+ Стр.НомерСмены + ": " + Лев(ПерваяОшибка, 100)
					+ ?(Результат.Ошибки.Количество() > 1, " (+" + (Результат.Ошибки.Количество()-1) + ")", ""));
			КонецЕсли;
			Если УжеБылЗагружен Тогда
				СчИдемпотент = СчИдемпотент + 1;
			КонецЕсли;

			Если Результат.Документы.Количество() > 0 Тогда
				// Основной документ
				НоваяСтр = ВнутренниеДанные.Добавить();
				НоваяСтр.Отметка              = Ложь;
				НоваяСтр.ТипДокумента         = Стр.ТипДокумента;
				НоваяСтр.Дата                 = Стр.Дата;
				НоваяСтр.Станция              = Стр.Станция;
				НоваяСтр.НомерСмены           = Стр.НомерСмены;
				НоваяСтр.Описание             = Стр.Описание;
				НоваяСтр.Сумма                = Стр.Сумма;
				// Документы создаются в режиме «Записать» (без проведения) —
				// проведение через отдельную кнопку «Провести выбранные».
				// Реальный флаг Проведён всё равно сверяем — на случай если документ
				// был обнаружен через идемпотентность и уже проведён ранее.
				НоваяСтр.Статус               = ?(Результат.Документы[0].Проведен, "Проведён", "Загружен");
				НоваяСтр.КлючЗагрузки        = Стр.КлючЗагрузки;
				НоваяСтр.КлючБазовый          = Стр.КлючЗагрузки;
				НоваяСтр.ДанныеJSON           = Стр.ДанныеJSON; // Сохраняем для деталей
				НоваяСтр.ДокументПредставление = Строка(Результат.Документы[0]);

				// Дочерние документы (Перемещения, Комплектация) не показываем —
				// они видны в деталях основного документа (смены или ТТН).

				ИндексыУдаления.Добавить(Инд);
				Счётчик = Счётчик + 1;
			ИначеЕсли УжеБылЗагружен Тогда
				// Идемпотентность сработала — документ уже есть в БД.
				// Переносим строку из правой панели в левую, чтобы пользователь
				// видел что эта смена/ТТН уже загружена.
				СсылкаСущ = TL_РегистрСтатусов.НайтиДокументПоКлючу(Стр.КлючЗагрузки);
				НоваяСтр = ВнутренниеДанные.Добавить();
				НоваяСтр.Отметка              = Ложь;
				НоваяСтр.ТипДокумента         = Стр.ТипДокумента;
				НоваяСтр.Дата                 = Стр.Дата;
				НоваяСтр.Станция              = Стр.Станция;
				НоваяСтр.НомерСмены           = Стр.НомерСмены;
				НоваяСтр.Описание             = Стр.Описание;
				НоваяСтр.Сумма                = Стр.Сумма;
				НоваяСтр.Статус               = ?(ЗначениеЗаполнено(СсылкаСущ) И СсылкаСущ.Проведен, "Проведён", "Загружен");
				НоваяСтр.КлючЗагрузки        = Стр.КлючЗагрузки;
				НоваяСтр.КлючБазовый          = Стр.КлючЗагрузки;
				НоваяСтр.ДанныеJSON           = Стр.ДанныеJSON;
				НоваяСтр.ДокументПредставление = ?(ЗначениеЗаполнено(СсылкаСущ), Строка(СсылкаСущ), "(уже в БД)");

				ИндексыУдаления.Добавить(Инд);
				Счётчик = Счётчик + 1;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Сч = ИндексыУдаления.Количество() - 1;
	Пока Сч >= 0 Цикл
		ВнешниеДанные.Удалить(ИндексыУдаления[Сч]);
		Сч = Сч - 1;
	КонецЦикла;

	ВнутренниеДанные.Сортировать("Дата УБЫВ, КлючБазовый, ТипДокумента");
	// Сводка по итогам загрузки — с разбивкой по результатам, если они были
	СводкаЛог = "✓ Загружено новых: " + XMLСтрока(Счётчик);
	Если СчИдемпотент > 0 Тогда
		СводкаЛог = СводкаЛог + "   ℹ Уже было: " + XMLСтрока(СчИдемпотент);
	КонецЕсли;
	Если СчОшибок > 0 Тогда
		СводкаЛог = СводкаЛог + "   ✗ С ошибками: " + XMLСтрока(СчОшибок)
			+ " (см. Подробный отчёт)";
	КонецЕсли;
	СводкаЛог = СводкаЛог + "   ·   всего в 1С: " + ВнутренниеДанные.Количество();
	ДобавитьВЛогСервер(СводкаЛог);
	ОбновитьДашборд();

КонецПроцедуры

// ==========================================================================
//  ПРОВЕДЕНИЕ / РАСПРОВЕДЕНИЕ / УДАЛЕНИЕ
// ==========================================================================

// Проведение: атомарно по КлючБазовый.
// Каждый пакет — в отдельной транзакции. Если один документ в пакете не провёлся —
// вся транзакция откатывается и ни один документ пакета не проводится.
//
&НаСервере
Процедура ПровестиВыбранныеФаза1НаСервере()
	ПровестиВыбранныеВнутреннее(Ложь); // Ложь = пропустить КОМПЛ
КонецПроцедуры

// Фаза 2: провести КОМПЛ (остатки от ПЕРЕМ уже в БД)
&НаСервере
Процедура ПровестиВыбранныеФаза2НаСервере()
	ПровестиВыбранныеВнутреннее(Истина); // Истина = только КОМПЛ
КонецПроцедуры

&НаСервере
Процедура ПровестиВыбранныеВнутреннее(ТолькоКомплектации)

	Счётчик = 0;
	Ошибок = 0;

	// Собрать уникальные базовые ключи
	КлючиДляПроведения = Новый Соответствие;
	Для Каждого Стр Из ВнутренниеДанные Цикл
		// Фаза 2 (ТолькоКомплектации) ищет по всем отмеченным,
		// т.к. фаза 1 уже обновила статус базовой строки на "Проведён"
		Если Стр.Отметка И (ТолькоКомплектации ИЛИ Стр.Статус <> "Проведён") Тогда
			КлючиДляПроведения.Вставить(Стр.КлючБазовый, Истина);
		КонецЕсли;
	КонецЦикла;

	// Проведение: находим все документы по базовому ключу из регистра
	// (включая дочерние Перемещения/Комплектации, которые не показаны в таблице)
	Для Каждого КлючПакета Из КлючиДляПроведения Цикл

		Попытка
			СчётчикПакета = 0;

			// Получить все документы пакета из регистра (базовый + дочерние)
			ДокументыПакета = TL_РегистрСтатусов.ПолучитьДокументыПоБазовомуКлючу(КлючПакета.Ключ);

			// Фильтр по фазе
			Для Каждого ИнфоДок Из ДокументыПакета Цикл
				ЭтоКомпл = СтрНайти(ИнфоДок.Ключ, "|КОМПЛ") > 0;
				Если ТолькоКомплектации И Не ЭтоКомпл Тогда Продолжить; КонецЕсли;
				Если Не ТолькоКомплектации И ЭтоКомпл Тогда Продолжить; КонецЕсли;

				Если Не ЗначениеЗаполнено(ИнфоДок.Ссылка) Тогда
					// Базовый ключ ТТН — placeholder без своего документа
					// (наш канал ТТН не создаёт ПТУ, только Перемещение + Комплектация).
					// Обновляем статус ключа на «Проведён» если он базовый — он подтянется
					// в форме как проведённая ТТН.
					Если ИнфоДок.Ключ = КлючПакета.Ключ Тогда
						TL_РегистрСтатусов.ОбновитьСтатус(ИнфоДок.Ключ, "Проведён");
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				Попытка
					ДокОбъект = ИнфоДок.Ссылка.ПолучитьОбъект();
					Если ДокОбъект <> Неопределено Тогда
						ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
						TL_РегистрСтатусов.ОбновитьСтатус(ИнфоДок.Ключ, "Проведён");
						СчётчикПакета = СчётчикПакета + 1;
					КонецЕсли;
				Исключение
					ДобавитьВЛогСервер("Ошибка проведения: " + ИнфоДок.Ключ + " — " + ОписаниеОшибки());
				КонецПопытки;
			КонецЦикла;

			// Транзакция прошла — обновляем UI
			Для Каждого Стр Из ВнутренниеДанные Цикл
				Если Стр.КлючБазовый = КлючПакета.Ключ И Стр.Статус <> "Проведён" Тогда
					Стр.Статус = "Проведён";
					// Отметку снимаем только в Фазе 2 (КОМПЛ),
					// иначе Фаза 2 не найдёт ключи для проведения комплектаций
					Если ТолькоКомплектации Тогда
						Стр.Отметка = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Счётчик = Счётчик + СчётчикПакета;

		Исключение
			ДобавитьВЛогСервер("Пакет " + КлючПакета.Ключ + " ошибка: " + ОписаниеОшибки());
			Ошибок = Ошибок + 1;
		КонецПопытки;

	КонецЦикла;

	ДобавитьВЛогСервер("Проведено: " + XMLСтрока(Счётчик)
		+ ?(Ошибок > 0, ", пакетов с ошибками: " + XMLСтрока(Ошибок), ""));
	ОбновитьДашборд();

КонецПроцедуры

// Распроведение: атомарно по КлючБазовый.
// Обратный порядок: Смена → Комплектация → Перемещение → ТТН.
// Каждый пакет в транзакции — при ошибке откатывается весь.
//
&НаСервере
Процедура РаспровестиВыбранныеНаСервере()

	Счётчик = 0;
	Ошибок = 0;

	КлючиДляРаспроведения = Новый Соответствие;
	Для Каждого Стр Из ВнутренниеДанные Цикл
		Если Стр.Отметка И Стр.Статус = "Проведён" Тогда
			КлючиДляРаспроведения.Вставить(Стр.КлючБазовый, Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючПакета Из КлючиДляРаспроведения Цикл

		НачатьТранзакцию();
		Попытка
			СчётчикПакета = 0;

			// Получаем ВСЕ документы пакета из регистра (включая дочерние)
			ДокументыПакета = TL_РегистрСтатусов.ПолучитьДокументыПоБазовомуКлючу(КлючПакета.Ключ);

			// Распроведение в обратном порядке (дочерние первыми)
			Для Обр = ДокументыПакета.Количество() - 1 По 0 Цикл
				ИнфоДок = ДокументыПакета[Обр];
				Если Не ЗначениеЗаполнено(ИнфоДок.Ссылка) Тогда
					// Документ не найден — логируем, но не откатываем пакет
					ДобавитьВЛогСервер("Документ не найден для распроведения: " + ИнфоДок.Ключ);
					Продолжить;
				КонецЕсли;
				Попытка
					ДокОбъект = ИнфоДок.Ссылка.ПолучитьОбъект();
					Если ДокОбъект <> Неопределено И ДокОбъект.Проведен Тогда
						ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
						TL_РегистрСтатусов.ОбновитьСтатус(ИнфоДок.Ключ, "Загружен");
						СчётчикПакета = СчётчикПакета + 1;
					КонецЕсли;
				Исключение
					ДобавитьВЛогСервер("Ошибка распроведения: " + ИнфоДок.Ключ + " — " + ОписаниеОшибки());
				КонецПопытки;
			КонецЦикла;

			ЗафиксироватьТранзакцию();

			// Обновить статусы в таблице UI
			Для Каждого Стр Из ВнутренниеДанные Цикл
				Если Стр.КлючБазовый = КлючПакета.Ключ И Стр.Статус = "Проведён" Тогда
					Стр.Статус = "Загружен";
					Стр.Отметка = Ложь;
				КонецЕсли;
			КонецЦикла;
			Счётчик = Счётчик + СчётчикПакета;

		Исключение
			ОтменитьТранзакцию();
			ДобавитьВЛогСервер("Пакет " + КлючПакета.Ключ + " откачен: " + ОписаниеОшибки());
			Ошибок = Ошибок + 1;
		КонецПопытки;

	КонецЦикла;

	ДобавитьВЛогСервер("Распроведено: " + XMLСтрока(Счётчик)
		+ ?(Ошибок > 0, ", пакетов с ошибками: " + XMLСтрока(Ошибок), ""));
	ОбновитьДашборд();

КонецПроцедуры

// Удаление: атомарно по КлючБазовый.
// Каждый пакет в транзакции — если один документ не удалился, весь пакет откатывается.
//
&НаСервере
Процедура УдалитьВыбранныеНаСервере()

	// Развилка по режиму: Сопутка/Общепит — отдельный обработчик через
	// РегистрСведений.TL_СоответствиеИсточников (ИдентификаторПоследнегоПакета),
	// Нефтепродукты — существующая логика через TL_РегистрСтатусов (STS).
	ТекРежим = ПолучитьТекущийРежимНаСервере();
	Если ТекРежим = "Сопутка" ИЛИ ТекРежим = "Общепит" Тогда
		УдалитьВыбранныеПакетыНаСервере();
		Возврат;
	КонецЕсли;

	Счётчик = 0;
	Ошибок = 0;

	КлючиДляУдаления = Новый Соответствие;
	Для Каждого Стр Из ВнутренниеДанные Цикл
		Если Стр.Отметка Тогда
			КлючиДляУдаления.Вставить(Стр.КлючБазовый, Истина);
		КонецЕсли;
	КонецЦикла;

	УспешныеПакеты = Новый Массив; // Ключи успешно удалённых пакетов

	Для Каждого КлючПакета Из КлючиДляУдаления Цикл

		НачатьТранзакцию();
		Попытка
			// Удаляем ВСЕ документы и записи по базовому ключу (включая дочерние |ПЕРЕМ, |КОМПЛ)
			ДокументыПакета = TL_РегистрСтатусов.ПолучитьДокументыПоБазовомуКлючу(КлючПакета.Ключ);
			Для Каждого ИнфоДок Из ДокументыПакета Цикл
				Если ЗначениеЗаполнено(ИнфоДок.Ссылка) Тогда
					Попытка
						ДокОбъект = ИнфоДок.Ссылка.ПолучитьОбъект();
						Если ДокОбъект <> Неопределено Тогда
							Если ДокОбъект.Проведен Тогда
								ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
							КонецЕсли;
							ДокОбъект.УстановитьПометкуУдаления(Истина);
						КонецЕсли;
					Исключение
					КонецПопытки;
				КонецЕсли;
				TL_РегистрСтатусов.УдалитьЗапись(ИнфоДок.Ключ);
			КонецЦикла;
			// Удалить базовый ключ тоже (если не в списке дочерних)
			TL_РегистрСтатусов.УдалитьЗапись(КлючПакета.Ключ);

			ЗафиксироватьТранзакцию();
			УспешныеПакеты.Добавить(КлючПакета.Ключ);

		Исключение
			ОтменитьТранзакцию();
			ДобавитьВЛогСервер("Пакет " + КлючПакета.Ключ + " не удалён: " + ОписаниеОшибки());
			Ошибок = Ошибок + 1;
		КонецПопытки;

	КонецЦикла;

	// Удалить строки из таблицы только для успешных пакетов
	Инд = ВнутренниеДанные.Количество() - 1;
	Пока Инд >= 0 Цикл
		Стр = ВнутренниеДанные[Инд];
		Для Каждого УспешныйКлюч Из УспешныеПакеты Цикл
			Если Стр.КлючБазовый = УспешныйКлюч Тогда
				ВнутренниеДанные.Удалить(Инд);
				Счётчик = Счётчик + 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Инд = Инд - 1;
	КонецЦикла;

	ДобавитьВЛогСервер("Помечено на удаление: " + XMLСтрока(Счётчик)
		+ ?(Ошибок > 0, ", пакетов с ошибками: " + XMLСтрока(Ошибок), ""));
	ОбновитьДашборд();

КонецПроцедуры

// ==========================================================================
//  НАСТРОЙКИ И ПОИСК ДОКУМЕНТОВ
// ==========================================================================

&НаСервере
Функция ПолучитьЗагруженныеДокументы()
	Возврат TL_РегистрСтатусов.ПолучитьЗагруженныеДокументы(ДатаНачала, ДатаОкончания);
КонецФункции

&НаСервере
Процедура ЗагрузитьНастройки()
	URLСервера = TL_Настройки.ПолучитьЗначение("URLСервера", "");
	Логин      = TL_Настройки.ПолучитьЗначение("Логин", "");
	Пароль     = TL_Настройки.ПолучитьЗначение("Пароль", "");
	КодСистемы = TL_Настройки.ПолучитьЧисло("КодСистемы", 0);
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
	TL_Настройки.УстановитьЗначение("URLСервера", URLСервера, "URL API STS");
	TL_Настройки.УстановитьЗначение("Логин", Логин, "Логин API");
	TL_Настройки.УстановитьЗначение("Пароль", Пароль, "Пароль API");
	TL_Настройки.УстановитьЗначение("КодСистемы", XMLСтрока(КодСистемы), "Код системы");
КонецПроцедуры

// Открыть HTML-настройки в панели деталей
&НаСервере
Процедура ОткрытьНастройкиНаСервере()

	// Собрать текущие настройки в JSON
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ключ, Значение ИЗ РегистрСведений.TL_Настройки";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		HTMLДетали = TL_HTMLГенератор.СформироватьНастройки("");
		Возврат;
	КонецПопытки;

	Данные = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Данные.Вставить(Выборка.Ключ, Выборка.Значение);
	КонецЦикла;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	HTMLДетали = TL_HTMLГенератор.СформироватьНастройки(СтрокаJSON);

КонецПроцедуры

// Сохранить настройки из HTML-формы (JSON от клиента)
&НаСервере
Процедура СохранитьНастройкиИзHTML(СтрокаJSON)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого КлючЗначение Из Данные Цикл
		TL_Настройки.УстановитьЗначение(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

	// Обновить локальные реквизиты формы
	ЗагрузитьНастройки();

КонецПроцедуры

