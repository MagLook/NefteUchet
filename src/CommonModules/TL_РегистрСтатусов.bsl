////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_РегистрСтатусов
// Расширение TradeLedger для 1С:БП 3.0
// Контекст: Сервер, Экспорт
// Работа с регистром сведений TL_СтатусыЗагрузки.
//
// Заменяет хрупкий поиск по полю Комментарий документов.
// Если регистр не существует — fallback на поиск по Комментарию.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Зарегистрировать загрузку документа.
//
// Параметры:
//   КлючЗагрузки   - Строка - уникальный ключ "TL|СМЕНА|15|208|142"
//   ДокументСсылка  - ДокументСсылка - ссылка на созданный документ
//   ТипДокумента    - Строка - "Смена" или "ТТН"
//
Процедура ЗарегистрироватьЗагрузку(КлючЗагрузки, ДокументСсылка, ТипДокумента) Экспорт

	Попытка
		МенеджерЗаписи = РегистрыСведений.TL_СтатусыЗагрузки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КлючЗагрузки = КлючЗагрузки;
		МенеджерЗаписи.ДокументСсылка = ДокументСсылка;
		МенеджерЗаписи.Статус = "Загружен";
		МенеджерЗаписи.ДатаЗагрузки = ТекущаяДата();
		МенеджерЗаписи.ТипДокумента = ТипДокумента;
		МенеджерЗаписи.Записать();
	Исключение
		// Регистр не существует — пропускаем
		ЗаписьЖурналаРегистрации("TL_РегистрСтатусов",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось зарегистрировать загрузку: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Получить статус загрузки по ключу.
//
// Параметры:
//   КлючЗагрузки - Строка
//
// Возвращаемое значение:
//   Структура("ДокументСсылка, Статус, ДатаЗагрузки") или Неопределено
//
Функция ПолучитьСтатус(КлючЗагрузки) Экспорт

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ДокументСсылка,
			|	Статус,
			|	ДатаЗагрузки
			|ИЗ
			|	РегистрСведений.TL_СтатусыЗагрузки
			|ГДЕ
			|	КлючЗагрузки = &КлючЗагрузки";

		Запрос.УстановитьПараметр("КлючЗагрузки", КлючЗагрузки);
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Возврат Новый Структура("ДокументСсылка, Статус, ДатаЗагрузки",
				Выборка.ДокументСсылка,
				Выборка.Статус,
				Выборка.ДатаЗагрузки);
		КонецЕсли;
	Исключение
		// Регистр не существует
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Обновить статус загрузки.
//
// Параметры:
//   КлючЗагрузки - Строка
//   НовыйСтатус  - Строка - "Загружен", "Проведён"
//
Процедура ОбновитьСтатус(КлючЗагрузки, НовыйСтатус) Экспорт

	Попытка
		МенеджерЗаписи = РегистрыСведений.TL_СтатусыЗагрузки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КлючЗагрузки = КлючЗагрузки;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Статус = НовыйСтатус;
			МенеджерЗаписи.Записать();
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Получить все загруженные документы за период.
// Сначала из регистра TL_СтатусыЗагрузки, потом дополняет
// поиском по Комментарию (для документов, созданных до регистра).
//
// Параметры:
//   ДатаНачала    - Дата
//   ДатаОкончания - Дата
//
// Возвращаемое значение:
//   Соответствие - КлючЗагрузки → Структура("Ссылка, Статус")
//
Функция ПолучитьЗагруженныеДокументы(ДатаНачала, ДатаОкончания) Экспорт

	Результат = Новый Соответствие;

	// 1. Из регистра TL_СтатусыЗагрузки
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КлючЗагрузки,
			|	ДокументСсылка,
			|	Статус
			|ИЗ
			|	РегистрСведений.TL_СтатусыЗагрузки
			|ГДЕ
			|	ДатаЗагрузки >= &ДатаНачала
			|	И ДатаЗагрузки <= &ДатаОкончания";

		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.КлючЗагрузки,
				Новый Структура("Ссылка, Статус", Выборка.ДокументСсылка, Выборка.Статус));
		КонецЦикла;
	Исключение
		// Регистр не существует — используем только fallback
	КонецПопытки;

	// 2. Fallback: поиск по Комментарию (для старых документов)
	ДополнитьИзКомментариев(Результат, ДатаНачала, ДатаОкончания);

	Возврат Результат;

КонецФункции

// Удалить запись о загрузке.
//
Процедура УдалитьЗапись(КлючЗагрузки) Экспорт

	Попытка
		МенеджерЗаписи = РегистрыСведений.TL_СтатусыЗагрузки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КлючЗагрузки = КлючЗагрузки;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Найти документ 1С по ключу загрузки.
// Сначала из регистра, потом по Комментарию.
//
// Возвращаемое значение:
//   ДокументСсылка или Неопределено
//
Функция НайтиДокументПоКлючу(КлючЗагрузки) Экспорт

	// 1. Из регистра
	Инфо = ПолучитьСтатус(КлючЗагрузки);
	Если Инфо <> Неопределено И ЗначениеЗаполнено(Инфо.ДокументСсылка) Тогда
		Возврат Инфо.ДокументСсылка;
	КонецЕсли;

	// 2. Fallback: по Комментарию
	Возврат НайтиДокументПоКомментарию(КлючЗагрузки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дополнить результат поиском по Комментарию документов (обратная совместимость).
//
Процедура ДополнитьИзКомментариев(Результат, ДатаНачала, ДатаОкончания)

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	""Смена"" КАК ТипИсточника,
			|	Т.Ссылка КАК Ссылка,
			|	Т.Комментарий КАК Комментарий,
			|	Т.Проведен КАК Проведен
			|ИЗ
			|	Документ.ОтчетОРозничныхПродажах КАК Т
			|ГДЕ
			|	Т.Комментарий ПОДОБНО ""TL|%""
			|	И Т.Дата >= &ДатаНачала
			|	И Т.Дата <= &ДатаОкончания
			|	И НЕ Т.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""ТТН"",
			|	Т.Ссылка,
			|	Т.Комментарий,
			|	Т.Проведен
			|ИЗ
			|	Документ.ПоступлениеТоваровУслуг КАК Т
			|ГДЕ
			|	Т.Комментарий ПОДОБНО ""TL|%""
			|	И Т.Дата >= &ДатаНачала
			|	И Т.Дата <= &ДатаОкончания
			|	И НЕ Т.ПометкаУдаления";

		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			// Извлечь ключ из комментария (до " | ")
			Комментарий = Выборка.Комментарий;
			Если Не ЗначениеЗаполнено(Комментарий) Тогда
				Продолжить;
			КонецЕсли;
			ПозРазделителя = СтрНайти(Комментарий, " | ");
			Если ПозРазделителя > 0 Тогда
				Ключ = Лев(Комментарий, ПозРазделителя - 1);
			Иначе
				Ключ = СокрЛП(Комментарий);
			КонецЕсли;

			// Добавляем только если нет в результате (регистр приоритетнее)
			Если Результат.Получить(Ключ) = Неопределено Тогда
				Статус = ?(Выборка.Проведен, "Проведён", "Загружен");
				Результат.Вставить(Ключ,
					Новый Структура("Ссылка, Статус", Выборка.Ссылка, Статус));
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Найти документ по комментарию (fallback).
//
Функция НайтиДокументПоКомментарию(КлючЗагрузки)

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Ссылка
			|ИЗ
			|	Документ.ОтчетОРозничныхПродажах КАК Т
			|ГДЕ
			|	Т.Комментарий ПОДОБНО &Шаблон
			|	И НЕ Т.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Ссылка
			|ИЗ
			|	Документ.ПоступлениеТоваровУслуг КАК Т
			|ГДЕ
			|	Т.Комментарий ПОДОБНО &Шаблон
			|	И НЕ Т.ПометкаУдаления";

		Запрос.УстановитьПараметр("Шаблон", КлючЗагрузки + "%");

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
