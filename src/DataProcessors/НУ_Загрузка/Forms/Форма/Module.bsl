////////////////////////////////////////////////////////////////////////////////
// НУ_Загрузка — Обработка загрузки данных из API в 1С
//
// Модуль управляемой формы обработки.
// Расширение «НефтеУчёт» для 1С:БП 3.0
//
// Интерфейс:
//   [Загрузить новые данные] → получает смены и ТТН из API
//   Таблица с чекбоксами → бухгалтер выбирает что проводить
//   [Создать документы] → формирует документы в 1С
//   [Провести выбранные] → проводит созданные документы
//   Лог операций внизу формы
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Инициализация настроек из регистра или значений по умолчанию
	URLСервера = ПолучитьНастройку("НУ_API_URL", "https://pos.autooplata.ru/tms");
	Логин = ПолучитьНастройку("НУ_API_LOGIN", "");
	Пароль = ПолучитьНастройку("НУ_API_PASSWORD", "");
	КодСистемы = Число(ПолучитьНастройку("НУ_API_SYSTEM_CODE", "65"));
	КодСтанции = Число(ПолучитьНастройку("НУ_API_STATION_CODE", "0"));

	// Период по умолчанию — последние 7 дней
	ДатаНачала = НачалоДня(ТекущаяДата() - 7 * 86400);
	ДатаОкончания = КонецДня(ТекущаяДата());

	ДобавитьВЛог("Расширение НефтеУчёт загружено. Система: " + Формат(КодСистемы, "ЧГ=0"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Кнопка «Загрузить новые данные»
//
&НаКлиенте
Процедура КомандаЗагрузить(Команда)

	Если ПустаяСтрока(Логин) ИЛИ ПустаяСтрока(Пароль) Тогда
		ПоказатьПредупреждение(, "Укажите логин и пароль API в настройках");
		Возврат;
	КонецЕсли;

	ДобавитьВЛог("Подключение к API...");
	ЗагрузитьДанныеНаСервере();

КонецПроцедуры

// Кнопка «Создать документы»
//
&НаКлиенте
Процедура КомандаСоздатьДокументы(Команда)

	КоличествоВыбранных = 0;
	Для Каждого СтрТаблицы Из СписокДанных Цикл
		Если СтрТаблицы.Отметка Тогда
			КоличествоВыбранных = КоличествоВыбранных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоВыбранных = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте строки для создания документов");
		Возврат;
	КонецЕсли;

	ДобавитьВЛог("Создание документов: " + Формат(КоличествоВыбранных, "ЧГ=0") + " позиций...");
	СоздатьДокументыНаСервере(Ложь);

КонецПроцедуры

// Кнопка «Провести выбранные»
//
&НаКлиенте
Процедура КомандаПровести(Команда)

	КоличествоВыбранных = 0;
	Для Каждого СтрТаблицы Из СписокДанных Цикл
		Если СтрТаблицы.Отметка Тогда
			КоличествоВыбранных = КоличествоВыбранных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоВыбранных = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте строки для проведения");
		Возврат;
	КонецЕсли;

	ДобавитьВЛог("Проведение документов: " + Формат(КоличествоВыбранных, "ЧГ=0") + " позиций...");
	СоздатьДокументыНаСервере(Истина);

КонецПроцедуры

// Кнопка «Выбрать все / Снять все»
//
&НаКлиенте
Процедура КомандаВыбратьВсе(Команда)

	НоваяОтметка = Ложь;
	Если СписокДанных.Количество() > 0 Тогда
		НоваяОтметка = Не СписокДанных[0].Отметка;
	КонецЕсли;

	Для Каждого СтрТаблицы Из СписокДанных Цикл
		СтрТаблицы.Отметка = НоваяОтметка;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеНаСервере()

	// Очищаем таблицу
	СписокДанных.Очистить();

	// Подключение к API
	Подключение = НУ_ApiКлиент.СоздатьПодключение(URLСервера, Логин, Пароль);
	Если Подключение = Неопределено Тогда
		ДобавитьВЛог("ОШИБКА: Не удалось подключиться к API");
		Возврат;
	КонецЕсли;
	ДобавитьВЛог("Подключение установлено");

	// Получаем список смен
	Попытка
		Смены = НУ_ApiКлиент.ПолучитьСписокСмен(Подключение, КодСистемы, КодСтанции, ДатаНачала, ДатаОкончания);
	Исключение
		ДобавитьВЛог("ОШИБКА при получении смен: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если Смены = Неопределено Тогда
		ДобавитьВЛог("Смены не найдены за указанный период");
		Возврат;
	КонецЕсли;

	КоличествоСмен = 0;
	КоличествоТТН = 0;

	Для Каждого Смена Из Смены Цикл

		НомерСмены = 0;
		Если Смена.Свойство("shift") Тогда
			НомерСмены = Число(Смена.shift);
		КонецЕсли;

		НомерСтанции = 0;
		Если Смена.Свойство("station") Тогда
			НомерСтанции = Число(Смена.station);
		КонецЕсли;

		ДатаСмены = Дата(1, 1, 1);
		Если Смена.Свойство("dt_open") Тогда
			ДатаСмены = РазобратьДатуISO(Смена.dt_open);
		КонецЕсли;

		// Получаем полный сменный отчёт
		Попытка
			Подключение = НУ_ApiКлиент.ОбновитьТокенПриНеобходимости(Подключение, Логин, Пароль);
			ОтчётСмены = НУ_ApiКлиент.ПолучитьСменныйОтчёт(Подключение, КодСистемы, НомерСтанции, НомерСмены);
		Исключение
			ДобавитьВЛог("ОШИБКА при получении смены #" + Формат(НомерСмены, "ЧГ=0") + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если ОтчётСмены = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Добавляем сменный отчёт в таблицу
		СуммаСмены = РассчитатьСуммуСмены(ОтчётСмены);

		НоваяСтрока = СписокДанных.Добавить();
		НоваяСтрока.Отметка = Истина;
		НоваяСтрока.ТипДокумента = "Сменный отчёт";
		НоваяСтрока.Дата = ДатаСмены;
		НоваяСтрока.Станция = НомерСтанции;
		НоваяСтрока.НомерСмены = НомерСмены;
		НоваяСтрока.Описание = "Смена #" + Формат(НомерСмены, "ЧГ=0") + " АЗС-" + Формат(НомерСтанции, "ЧГ=0");
		НоваяСтрока.Сумма = СуммаСмены;
		НоваяСтрока.Статус = "Загружен";
		НоваяСтрока.ДанныеJSON = СериализоватьВJSON(ОтчётСмены);

		КоличествоСмен = КоличествоСмен + 1;

		// Извлекаем поступления (ТТН) из сменного отчёта
		Если ОтчётСмены.Свойство("receipt") Тогда
			Для Каждого ТТН Из ОтчётСмены.receipt Цикл

				НомерТТН = "";
				Если ТТН.Свойство("ttn") Тогда
					НомерТТН = ТТН.ttn;
				КонецЕсли;

				ИмяТоплива = "";
				Если ТТН.Свойство("service") И ТТН.service.Свойство("service_name") Тогда
					ИмяТоплива = ТТН.service.service_name;
				КонецЕсли;

				МассаКг = 0;
				Если ТТН.Свойство("doc") И ТТН.doc.Свойство("amount") Тогда
					МассаКг = Число(ТТН.doc.amount);
				КонецЕсли;

				Плотность = 0;
				Если ТТН.Свойство("doc") И ТТН.doc.Свойство("density") Тогда
					Плотность = Число(ТТН.doc.density);
				КонецЕсли;

				Стоимость = 0;
				Если ТТН.Свойство("doc") И ТТН.doc.Свойство("cost") Тогда
					Стоимость = Число(ТТН.doc.cost);
				КонецЕсли;

				Если МассаКг > 0 Тогда
					НоваяСтрокаТТН = СписокДанных.Добавить();
					НоваяСтрокаТТН.Отметка = Истина;
					НоваяСтрокаТТН.ТипДокумента = "Поступление (ТТН)";
					НоваяСтрокаТТН.Дата = ДатаСмены;
					НоваяСтрокаТТН.Станция = НомерСтанции;
					НоваяСтрокаТТН.НомерСмены = НомерСмены;
					НоваяСтрокаТТН.Описание = "ТТН " + НомерТТН + " " + ИмяТоплива
						+ " " + Формат(МассаКг / 1000, "ЧДЦ=3") + "т"
						+ " ρ=" + Формат(Плотность, "ЧДЦ=3");
					НоваяСтрокаТТН.Сумма = Стоимость;
					НоваяСтрокаТТН.Статус = "Загружен";
					НоваяСтрокаТТН.ДанныеJSON = СериализоватьВJSON(ТТН);

					КоличествоТТН = КоличествоТТН + 1;
				КонецЕсли;

			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

	ДобавитьВЛог("Загружено: " + Формат(КоличествоСмен, "ЧГ=0") + " смен, "
		+ Формат(КоличествоТТН, "ЧГ=0") + " поступлений");

КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыНаСервере(Проводить)

	Настройки = ПолучитьНастройкиМаппинга();

	Если Настройки.Организация = Неопределено Тогда
		ДобавитьВЛог("ОШИБКА: Не настроена организация. Откройте настройки расширения.");
		Возврат;
	КонецЕсли;

	ВсегоДокументов = 0;
	ВсегоОшибок = 0;

	Для Каждого СтрТаблицы Из СписокДанных Цикл

		Если Не СтрТаблицы.Отметка Тогда
			Продолжить;
		КонецЕсли;

		Если СтрТаблицы.Статус = "Проведён" Тогда
			Продолжить;
		КонецЕсли;

		// Десериализация данных
		Данные = ДесериализоватьИзJSON(СтрТаблицы.ДанныеJSON);
		Если Данные = Неопределено Тогда
			ДобавитьВЛог("ОШИБКА: Не удалось разобрать данные для: " + СтрТаблицы.Описание);
			ВсегоОшибок = ВсегоОшибок + 1;
			Продолжить;
		КонецЕсли;

		Результат = Неопределено;

		Если СтрТаблицы.ТипДокумента = "Сменный отчёт" Тогда
			Результат = НУ_СозданиеДокументов.ОбработатьСменныйОтчёт(Данные, Настройки, Проводить);
		ИначеЕсли СтрТаблицы.ТипДокумента = "Поступление (ТТН)" Тогда
			Результат = НУ_СозданиеДокументов.ОбработатьПоступление(Данные, Настройки, Проводить);
		КонецЕсли;

		Если Результат <> Неопределено Тогда
			ВсегоДокументов = ВсегоДокументов + Результат.Документы.Количество();
			ВсегоОшибок = ВсегоОшибок + Результат.Ошибки.Количество();

			Для Каждого Ошибка Из Результат.Ошибки Цикл
				ДобавитьВЛог("ОШИБКА: " + Ошибка);
			КонецЦикла;

			Если Результат.Ошибки.Количество() = 0 Тогда
				СтрТаблицы.Статус = ?(Проводить, "Проведён", "Создан");
			Иначе
				СтрТаблицы.Статус = "Ошибка";
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Действие = ?(Проводить, "Проведено", "Создано");
	ДобавитьВЛог(Действие + " документов: " + Формат(ВсегоДокументов, "ЧГ=0")
		+ ?(ВсегоОшибок > 0, ", ошибок: " + Формат(ВсегоОшибок, "ЧГ=0"), ""));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получает настройки маппинга из регистра НУ_Настройки.
// В MVP — заглушка, заполняется вручную при первой настройке.
//
&НаСервере
Функция ПолучитьНастройкиМаппинга()

	Н = НУ_СозданиеДокументов.ПолучитьНастройкиПоУмолчанию();

	// Организация
	ИмяОрганизации = ПолучитьНастройку("НУ_Организация", "");
	Если Не ПустаяСтрока(ИмяОрганизации) Тогда
		Н.Организация = Справочники.Организации.НайтиПоНаименованию(ИмяОрганизации);
	КонецЕсли;

	// Склады
	Н.ОсновнойСклад = НайтиСкладПоНастройке("НУ_ОсновнойСклад");
	Н.СкладАЗС = НайтиСкладПоНастройке("НУ_СкладАЗС");
	Н.СкладКарты = НайтиСкладПоНастройке("НУ_СкладКарты");
	Н.СкладТалоны = НайтиСкладПоНастройке("НУ_СкладТалоны");
	Н.СкладВедомости = НайтиСкладПоНастройке("НУ_СкладВедомости");

	// Поставщик
	ИмяПоставщика = ПолучитьНастройку("НУ_Поставщик", "");
	Если Не ПустаяСтрока(ИмяПоставщика) Тогда
		Н.Поставщик = Справочники.Контрагенты.НайтиПоНаименованию(ИмяПоставщика);
	КонецЕсли;

	// Маппинг топлива
	ЗаполнитьМаппингТоплива(Н);

	// Маппинг оплат
	Н.МаппингОплат["Топливные карты"] = Н.СкладКарты;
	Н.МаппингОплат["Талоны"] = Н.СкладТалоны;
	Н.МаппингОплат["Ведомости"] = Н.СкладВедомости;
	Н.МаппингОплат["Корпоративные"] = Н.СкладВедомости;

	Возврат Н;

КонецФункции

&НаСервере
Процедура ЗаполнитьМаппингТоплива(Настройки)

	// Коды топлива из API → номенклатура 1С
	// Формат настройки: НУ_Топливо_92_Тонны = "АИ-92 (т)"
	КодыТоплива = Новый Массив;
	КодыТоплива.Добавить(92);
	КодыТоплива.Добавить(95);
	КодыТоплива.Добавить(98);
	КодыТоплива.Добавить(5); // ДТ

	Для Каждого Код Из КодыТоплива Цикл

		ИмяТонны = ПолучитьНастройку("НУ_Топливо_" + Формат(Код, "ЧГ=0") + "_Тонны", "");
		ИмяЛитры = ПолучитьНастройку("НУ_Топливо_" + Формат(Код, "ЧГ=0") + "_Литры", "");

		Если Не ПустаяСтрока(ИмяТонны) И Не ПустаяСтрока(ИмяЛитры) Тогда
			НомТонны = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТонны);
			НомЛитры = Справочники.Номенклатура.НайтиПоНаименованию(ИмяЛитры);

			Если Не НомТонны.Пустая() И Не НомЛитры.Пустая() Тогда
				Маппинг = Новый Структура("Тонны, Литры", НомТонны, НомЛитры);
				Настройки.МаппингТоплива[Код] = Маппинг;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция НайтиСкладПоНастройке(КлючНастройки)

	ИмяСклада = ПолучитьНастройку(КлючНастройки, "");
	Если ПустаяСтрока(ИмяСклада) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Справочники.Склады.НайтиПоНаименованию(ИмяСклада);

КонецФункции

// Читает настройку из регистра НУ_Настройки или возвращает значение по умолчанию.
//
&НаСервере
Функция ПолучитьНастройку(Ключ, ЗначениеПоУмолчанию = "")

	// В MVP: пытаемся прочитать из регистра НУ_Настройки
	// Если регистр ещё не создан — возвращаем значение по умолчанию
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Значение ИЗ РегистрСведений.НУ_Настройки ГДЕ Ключ = &Ключ";
		Запрос.УстановитьПараметр("Ключ", Ключ);
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Значение;
		КонецЕсли;
	Исключение
		// Регистр ещё не создан — нормально для первого запуска
	КонецПопытки;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Рассчитывает общую сумму смены из блока sales.
//
&НаСервере
Функция РассчитатьСуммуСмены(ОтчётСмены)

	Итого = 0;

	Если Не ОтчётСмены.Свойство("sales") Тогда
		Возврат 0;
	КонецЕсли;

	Для Каждого БлокПродаж Из ОтчётСмены.sales Цикл
		Если БлокПродаж.Свойство("fuel") Тогда
			Для Каждого Топливо Из БлокПродаж.fuel Цикл
				Если Топливо.Свойство("release") И Топливо.release.Свойство("cost") Тогда
					Итого = Итого + Число(Топливо.release.cost);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат Итого;

КонецФункции

// Разбирает дату в формате ISO 8601.
//
&НаСервере
Функция РазобратьДатуISO(СтрокаДаты)

	Попытка
		// Формат: 2025-10-03T00:00:00
		Год = Число(Лев(СтрокаДаты, 4));
		Месяц = Число(Сред(СтрокаДаты, 6, 2));
		День = Число(Сред(СтрокаДаты, 9, 2));
		Час = 0; Мин = 0; Сек = 0;
		Если СтрДлина(СтрокаДаты) >= 19 Тогда
			Час = Число(Сред(СтрокаДаты, 12, 2));
			Мин = Число(Сред(СтрокаДаты, 15, 2));
			Сек = Число(Сред(СтрокаДаты, 18, 2));
		КонецЕсли;
		Возврат Дата(Год, Месяц, День, Час, Мин, Сек);
	Исключение
		Возврат ТекущаяДата();
	КонецПопытки;

КонецФункции

&НаСервере
Функция СериализоватьВJSON(Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

&НаСервере
Функция ДесериализоватьИзJSON(СтрокаJSON)

	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Добавляет строку в лог операций на форме.
//
&НаСервере
Процедура ДобавитьВЛог(Сообщение)

	ТекстЛога = ТекстЛога
		+ Формат(ТекущаяДата(), "ДФ=dd.MM HH:mm") + "  " + Сообщение + Символы.ПС;

КонецПроцедуры

#КонецОбласти

