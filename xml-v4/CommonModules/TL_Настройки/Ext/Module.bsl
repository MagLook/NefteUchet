//
Функция ПодсчитатьЗаписейМаппинга()
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ РегистрСведений.TL_МаппингОплат");
		Выборка = Запрос.Выполнить().Выбрать();
