// Номенклатурная группа топливной строки ОРП — субконто счёта 90.01.1.
// Приоритет — группа из КАРТОЧКИ номенклатуры (то же поведение, что при ручном
// вводе документов бухгалтерией: АИ/ДТ → «Нефтепродукты (л)», газ → «СУГ (л)»).
// Пустая группа в карточке → «Нефтепродукты (л)» (историческая группа розницы).
// Решение бухгалтерии 13.07.2026 (Ирина): вернуть «Нефтепродукты (л)» вместо
// «Нефтепродукты розница», введённой cfe92 в начале июля.
Функция ОпределитьГруппуТопливаПоКарточке(Номенклатура) Экспорт
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Попытка
			Группа = Номенклатура.НоменклатурнаяГруппа;
			Если ЗначениеЗаполнено(Группа) И НЕ Группа.ПометкаУдаления Тогда
				Возврат Группа;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат НайтиИлиСоздатьНоменклатурнуюГруппу("Нефтепродукты (л)");
КонецФункции

// Найти номенклатурную группу по точному наименованию; создать при отсутствии.
// Помеченную на удаление НЕ дублируем: возвращаем её с предупреждением в ЖР —
// дубль группы хуже ссылки на помеченную (бухгалтерия снимет пометку/заменит).
Функция НайтиИлиСоздатьНоменклатурнуюГруппу(Наименование)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.НоменклатурныеГруппы
		|ГДЕ Наименование = &Имя И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("Имя", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	// Есть ли помеченная с тем же именем?
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.НоменклатурныеГруппы
		|ГДЕ Наименование = &Имя";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаписьЖурналаРегистрации("TL_МаппингЦБ",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Номенклатурная группа '" + Наименование + "' помечена на удаление — "
			+ "использована существующая (дубль не создан). Снимите пометку либо "
			+ "настройте другую группу.");
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Попытка
		Гр = Справочники.НоменклатурныеГруппы.СоздатьЭлемент();
		Гр.Наименование = Наименование;
		Гр.Записать();
		Возврат Гр.Ссылка;
	Исключение
		ЗаписьЖурналаРегистрации("TL_МаппингЦБ",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось создать номенклатурную группу '" + Наименование + "': " + ОписаниеОшибки());
		Возврат Справочники.НоменклатурныеГруппы.ПустаяСсылка();
	КонецПопытки;
КонецФункции

// ============================================================================
//  ОПЕРАЦИИ С РЕГИСТРОМ TL_СоответствиеИсточников
// ============================================================================

// Записать соответствие (Тип, ИсточникUUID) → СсылкаОбъект.
//
// КонтекстСмены — Структура {КодАЗС, НомерСмены, ДатаСмены, ОСЭНомер} (формат v2),
// при наличии записывается в одноимённые ресурсы регистра. Если расширение ещё не
// накатано в БД (F7 не сделан) — лишние реквизиты молча игнорируются.
//
Процедура ЗаписатьСоответствие(Тип, ИсточникUUID, СсылкаОбъект,
	ИдентификаторПакета = "", ХешДокумента = "", КонтекстСмены = Неопределено) Экспорт

	МЗ = РегистрыСведений.TL_СоответствиеИсточников.СоздатьМенеджерЗаписи();
	МЗ.Тип = Тип;
	МЗ.ИсточникUUID = ИсточникUUID;
	МЗ.СсылкаОбъект = СсылкаОбъект;
	МЗ.ДатаПоследнейЗагрузки = ТекущаяДата();
	Если ЗначениеЗаполнено(ИдентификаторПакета) Тогда
		МЗ.ИдентификаторПоследнегоПакета = ИдентификаторПакета;
	КонецЕсли;
	Если ЗначениеЗаполнено(ХешДокумента) Тогда
		МЗ.ХешПоследнегоПакета = ХешДокумента;
	КонецЕсли;

	// Поля смены (формат пакета v2)
	Если ТипЗнч(КонтекстСмены) = Тип("Структура") Тогда
		ЗаписатьРеквизитСмены(МЗ, КонтекстСмены, "КодАЗС");
		ЗаписатьРеквизитСмены(МЗ, КонтекстСмены, "НомерСмены");
		ЗаписатьРеквизитСмены(МЗ, КонтекстСмены, "ДатаСмены");
		ЗаписатьРеквизитСмены(МЗ, КонтекстСмены, "ОСЭНомер");
	КонецЕсли;

	МЗ.Записать();

КонецПроцедуры

Процедура ЗаписатьРеквизитСмены(МЗ, КонтекстСмены, Имя)
	Если КонтекстСмены.Свойство(Имя) И ЗначениеЗаполнено(КонтекстСмены[Имя]) Тогда
		Попытка
			МЗ[Имя] = КонтекстСмены[Имя];
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Прочитать сохранённый хеш последнего пакета по (Тип, ИсточникUUID).
// Используется защитой проведённых для сверки «изменились ли данные ЦБ».
//
Функция ПрочитатьХешСоответствия(Тип, ИсточникUUID) Экспорт

	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СоотвИст.ХешПоследнегоПакета КАК Хеш
		|ИЗ
		|	РегистрСведений.TL_СоответствиеИсточников КАК СоотвИст
		|ГДЕ
		|	СоотвИст.Тип = &Тип
		|	И СоотвИст.ИсточникUUID = &UUID");
	Запрос.УстановитьПараметр("Тип", Тип);
	Запрос.УстановитьПараметр("UUID", ИсточникUUID);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Хеш));
	КонецЕсли;
	Возврат "";

КонецФункции

// Пометить расхождение «изменён в ЦБ после проведения»: документ проведён
// бухгалтером, а из ЦБ пришли ИЗМЕНЁННЫЕ данные. Флаг читает витрина (⚠).
// Read-modify-write — сохраняем существующий хеш и остальные поля, ставим только флаг.
// Попытка: если ресурс ИзмененПослеПроведения ещё не в БД (UpdateDBCfg не сделан) —
// молча пропускаем (защита от перезаписи всё равно уже сработала на уровне обработчика).
//
Процедура ПометитьРасхождениеПроведённого(Тип, ИсточникUUID) Экспорт

	Попытка
		МЗ = РегистрыСведений.TL_СоответствиеИсточников.СоздатьМенеджерЗаписи();
		МЗ.Тип = Тип;
		МЗ.ИсточникUUID = ИсточникUUID;
		МЗ.Прочитать();
		Если Не МЗ.Выбран() Тогда
			Возврат;
		КонецЕсли;
		МЗ.ИзмененПослеПроведения = Истина;
		МЗ.Записать();
	Исключение
	КонецПопытки;

КонецПроцедуры

// Прочитать флаг расхождения «изменён в ЦБ после проведения» по (Тип, ИсточникUUID).
// Через Попытку: если ресурс ещё не в БД (UpdateDBCfg не сделан) — вернуть Ложь,
// чтобы витрина строилась без ошибок.
//
Функция ПрочитатьФлагРасхождения(Тип, ИсточникUUID) Экспорт

	Результат = Ложь;
	Попытка
		МЗ = РегистрыСведений.TL_СоответствиеИсточников.СоздатьМенеджерЗаписи();
		МЗ.Тип = Тип;
		МЗ.ИсточникUUID = ИсточникUUID;
		МЗ.Прочитать();
		Если МЗ.Выбран() Тогда
			Результат = МЗ.ИзмененПослеПроведения = Истина;
		КонецЕсли;
	Исключение
		Результат = Ложь;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Найти соответствие — вернуть ссылку на объект БП или Неопределено.
//
Функция НайтиСоответствие(Тип, ИсточникUUID) Экспорт

	Если Не ЗначениеЗаполнено(ИсточникUUID) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СсылкаОбъект
		|ИЗ
		|	РегистрСведений.TL_СоответствиеИсточников
		|ГДЕ
		|	Тип = &Тип И ИсточникUUID = &UUID");
	Запрос.УстановитьПараметр("Тип", Тип);
	Запрос.УстановитьПараметр("UUID", ИсточникUUID);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если ЗначениеЗаполнено(Выборка.СсылкаОбъект) Тогда
				Возврат Выборка.СсылкаОбъект;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Регистр ещё не создан в конфигурации — fallback Неопределено
		ЗаписьЖурналаРегистрации("TL_МаппингЦБ",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Регистр TL_СоответствиеИсточников недоступен: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Извлечь номер АЗС из имени склада ЦБ.
// "АЗС №208, Торговый зал" → 208
// "АЗС №5" → 5
//
Функция ИзвлечьНомерАЗС(Наименование)

	Имя = СокрЛП(Наименование);
	// Удалить «АЗС №», «АЗС », «АГЗС № » и др. префиксы
	НормИмя = НРег(Имя);
	НормИмя = СтрЗаменить(НормИмя, "азс №", "");
	НормИмя = СтрЗаменить(НормИмя, "азс ", "");
	НормИмя = СтрЗаменить(НормИмя, "агзс №", "");
	НормИмя = СтрЗаменить(НормИмя, "агзс ", "");
	НормИмя = СтрЗаменить(НормИмя, "акзс ", "");
	НормИмя = СтрЗаменить(НормИмя, "акзс №", "");
	НормИмя = СокрЛП(НормИмя);

	// Прочитать ведущие цифры
	Цифры = "";
	Для i = 1 По СтрДлина(НормИмя) Цикл
		Сим = Сред(НормИмя, i, 1);
		Если Сим >= "0" И Сим <= "9" Тогда
			Цифры = Цифры + Сим;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Цифры) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(Цифры);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Найти склад БП по номеру АЗС, перебирая распространённые шаблоны имён.
// БП ГИГ имеет «АЗС 208 г.Выборг», «АГЗС Симагино», «АКЗС Витебский (5)» и т.п.
//
Функция НайтиСкладПоНомеру(НомерАЗС)

	НомерСтр = XMLСтрока(НомерАЗС);

	Шаблоны = Новый Массив;
	Шаблоны.Добавить("%АЗС " + НомерСтр + "%");
	Шаблоны.Добавить("%АЗС №" + НомерСтр + "%");
	Шаблоны.Добавить("%АГЗС " + НомерСтр + "%");
	Шаблоны.Добавить("%АГЗС №" + НомерСтр + "%");
	Шаблоны.Добавить("%АКЗС " + НомерСтр + "%");
	Шаблоны.Добавить("%(" + НомерСтр + ")%");

	Для Каждого Шаблон Из Шаблоны Цикл
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Склады
			|ГДЕ Наименование ПОДОБНО &Шаблон И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("Шаблон", Шаблон);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.Склады.ПустаяСсылка();

КонецФункции

// Поиск счёта по коду (хозрасчётный план счетов).
//
Функция ПолучитьСчётПоКоду(Код)

	Попытка
		Счёт = ПланыСчетов.Хозрасчетный.НайтиПоКоду(Код);
		Если ЗначениеЗаполнено(Счёт) Тогда
			Возврат Счёт;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ПланыСчетов.Хозрасчетный.ПустаяСсылка();

КонецФункции

#КонецОбласти
