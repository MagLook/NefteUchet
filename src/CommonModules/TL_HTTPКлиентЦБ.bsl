////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_HTTPКлиентЦБ
// Расширение ElsyPlus Ledger v6.0 для 1С:БП 3.0
// Контекст: Сервер, ВызовСервера
//
// HTTP-клиент канала ЦБ → БП. Получает пакеты из расширения TL_ЭкспортБП
// (на стороне ЭЛСИ.АЗК ЦБ) для подсистем TL_Сопутка и TL_Общепит.
//
// Контракт: D:\Users\magsp\OneDrive\GIG Ledger\Проекты_перехода\
//   АЗС_208_Сопутка_Общепит\04_Техническое\TradeLedger_Phase_A\
//   09_Контракт_HTTP_ЦБ_БП.md
//
// Поддерживаемые транспорты:
//   A. HTTP pull (целевой)        — GET /tl/bp/v1/package?... + Basic Auth
//   B. Файл из OwnCloud (старт A3) — чтение <ИдентификаторПакета>.json из каталога
//
// Ключи настройки в РегистрСведений.TL_Настройки:
//   URL_ЦБ              — например "https://ts-cb.elsy-balttrade.local/tl/bp/v1"
//   Логин_ЦБ            — пользователь для Basic Auth (например "tl_export_bp")
//   Пароль_ЦБ           — пароль
//   КаталогOwnCloud_ЦБ  — путь для варианта B (например "\\BT\OwnCloud\TL_BP_Export")
//
// Если URL_ЦБ пустой — клиент автоматически переключается на вариант B.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Получить пакет от источника (HTTP или файл).
//
// Параметры:
//   Параметры - Структура - параметры запроса:
//     * Kind            - Строка - тип документа: "purchase" / "transfer" / ...
//     * ПериодС         - Дата   - левая граница (включительно)
//     * ПериодПо        - Дата   - правая граница (включительно)
//     * Организация     - Строка - UUID организации ЦБ (опционально)
//     * Склад           - Строка - UUID склада ЦБ (опционально)
//     * ВидОперации     - Строка - "ОтПоставщика" / "ВнутреннееПеремещение" (опционально)
//     * ПутьКФайлу      - Строка - явный путь к JSON-файлу для варианта B
//                                  (если задан — приоритет над HTTP)
//
// Возвращаемое значение:
//   Структура - {
//     Пакет          - Соответствие — десериализованный JSON или Неопределено
//     Ошибка         - Строка       — описание ошибки или ""
//     ИсточникДанных - Строка       — "HTTP" / "Файл" / "Ошибка"
//     ХешСовпал      - Булево       — результат сверки SHA-256 с пакетом (Истина если совпал
//                                     либо если хеш не передан в пакете)
//   }
//
Функция ПолучитьПакет(Параметры) Экспорт

	Результат = Новый Структура("Пакет, Ошибка, ИсточникДанных, ХешСовпал",
		Неопределено, "", "Ошибка", Истина);

	// Приоритет: явный путь к файлу → файл из настроек → HTTP
	ПутьКФайлу = ПолучитьЗначениеСтруктуры(Параметры, "ПутьКФайлу", "");

	URL = TL_Настройки.ПолучитьЗначение("URL_ЦБ", "");
	КаталогOwnCloud = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");

	Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Результат.ИсточникДанных = "Файл";
		Результат = ПрочитатьПакетИзФайла(ПутьКФайлу);
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(URL) И ЗначениеЗаполнено(КаталогOwnCloud) Тогда
		// Вариант B — каталог задан, URL не задан.
		// Вызывающий должен передать конкретный файл через ПутьКФайлу.
		// Без файла мы не знаем, какой именно пакет читать.
		Результат.Ошибка = "URL_ЦБ не задан, ожидался путь к файлу через ПутьКФайлу";
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(URL) Тогда
		Результат.Ошибка = "URL_ЦБ не задан в настройках TL_Настройки";
		Возврат Результат;
	КонецЕсли;

	// Вариант A — HTTP GET /package
	Логин  = TL_Настройки.ПолучитьЗначение("Логин_ЦБ", "");
	Пароль = TL_Настройки.ПолучитьЗначение("Пароль_ЦБ", "");

	СтрокаПараметров = ПостроитьСтрокуЗапроса(Параметры);
	Путь = "/package?" + СтрокаПараметров;

	Лог("Запрос HTTP: " + URL + Путь, "Информация");

	ОтветТело = ВыполнитьЗапросПакета(URL, Путь, Логин, Пароль, Результат);
	Если Не ЗначениеЗаполнено(ОтветТело) Тогда
		// Ошибка уже записана в Результат.Ошибка функцией ВыполнитьЗапросПакета
		Возврат Результат;
	КонецЕсли;

	Пакет = РазобратьJSON(ОтветТело);
	Если Пакет = Неопределено Тогда
		Результат.Ошибка = "Не удалось десериализовать тело ответа как JSON";
		Лог(Результат.Ошибка, "Ошибка");
		Возврат Результат;
	КонецЕсли;

	Результат.Пакет = Пакет;
	Результат.ИсточникДанных = "HTTP";
	Результат.Ошибка = "";

	// Сверка хеша
	Результат.ХешСовпал = СверитьХешПакета(ОтветТело, Пакет);

	Возврат Результат;

КонецФункции

// Прочитать пакет из локального файла (вариант B / тестовый запуск).
//
// Параметры:
//   ПутьКФайлу - Строка - абсолютный путь к .json
//
// Возвращаемое значение:
//   Структура - тот же формат что у ПолучитьПакет
//
Функция ПрочитатьПакетИзФайла(ПутьКФайлу) Экспорт

	Результат = Новый Структура("Пакет, Ошибка, ИсточникДанных, ХешСовпал",
		Неопределено, "", "Файл", Истина);

	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Результат.Ошибка = "Путь к файлу не задан";
		Результат.ИсточникДанных = "Ошибка";
		Возврат Результат;
	КонецЕсли;

	Файл = Новый Файл(ПутьКФайлу);
	Если Не Файл.Существует() Тогда
		Результат.Ошибка = "Файл не найден: " + ПутьКФайлу;
		Результат.ИсточникДанных = "Ошибка";
		Лог(Результат.Ошибка, "Ошибка");
		Возврат Результат;
	КонецЕсли;

	Попытка
		Содержимое = ПрочитатьСодержимоеФайла(ПутьКФайлу);
	Исключение
		Результат.Ошибка = "Ошибка чтения файла: " + ОписаниеОшибки();
		Результат.ИсточникДанных = "Ошибка";
		Лог(Результат.Ошибка, "Ошибка");
		Возврат Результат;
	КонецПопытки;

	Пакет = РазобратьJSON(Содержимое);
	Если Пакет = Неопределено Тогда
		Результат.Ошибка = "Не удалось десериализовать файл как JSON: " + ПутьКФайлу;
		Результат.ИсточникДанных = "Ошибка";
		Лог(Результат.Ошибка, "Ошибка");
		Возврат Результат;
	КонецЕсли;

	Результат.Пакет = Пакет;

	// Сверка хеша
	Результат.ХешСовпал = СверитьХешПакета(Содержимое, Пакет);

	Лог("Прочитан пакет из файла: " + ПутьКФайлу
		+ " (размер " + XMLСтрока(СтрДлина(Содержимое)) + " символов)",
		"Информация");

	Возврат Результат;

КонецФункции

// Получить список новых пакетов из каталога OwnCloud для обработки.
// Сканирует каталог на наличие файлов tl_*.json, фильтрует уже-загруженные
// через TL_СверкаПакета, опционально фильтрует по kind документов.
//
// Параметры:
//   КаталогПуть         - Строка  - путь к каталогу (если пусто, берётся из TL_Настройки.КаталогOwnCloud_ЦБ)
//   ВключатьЗагруженные - Булево  - не фильтровать уже-загруженные (по умолчанию Ложь)
//   СписокKind          - Массив или СписокЗначений - перечень допустимых kind ("purchase",
//                                  "retail_sale_sidegoods", "production_release", "return_purchase").
//                                  Если Неопределено или пуст — без фильтра.
//
// Возвращаемое значение:
//   ТаблицаЗначений (ПолныйПуть, ИмяФайла, ИдентификаторПакета, Kind, РазмерКБ, ДатаМодификации, УжеЗагружен)
//
Функция ПолучитьСписокНовыхПакетов(КаталогПуть = "", ВключатьЗагруженные = Ложь,
		СписокKind = Неопределено, Маска = "*.json") Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ПолныйПуть",         Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИмяФайла",           Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИдентификаторПакета", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Kind",               Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("РазмерКБ",           Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2)));
	Результат.Колонки.Добавить("ДатаМодификации",    Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("УжеЗагружен",        Новый ОписаниеТипов("Булево"));

	Если Не ЗначениеЗаполнено(КаталогПуть) Тогда
		КаталогПуть = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КаталогПуть) Тогда
		// Стенд: дефолт на локальный каталог, если в настройках пусто
		КаталогПуть = "C:\TL_BP_Export\";
	КонецЕсли;

	Файл = Новый Файл(КаталогПуть);
	Если Не Файл.Существует() Тогда
		Лог("Каталог не существует: " + КаталогПуть, "Ошибка");
		Возврат Результат;
	КонецЕсли;

	// Маска по умолчанию *.json — охватывает старый формат tl_*.json и новый АЗС*_*.json
	Попытка
		НайденныеФайлы = НайтиФайлы(КаталогПуть, Маска, Ложь);
	Исключение
		Лог("Ошибка сканирования каталога " + КаталогПуть + ": " + ОписаниеОшибки(), "Ошибка");
		Возврат Результат;
	КонецПопытки;

	НужнаФильтрация = СписокKind <> Неопределено;
	Если НужнаФильтрация Тогда
		НабKind = НормализоватьСписокKind(СписокKind);
		НужнаФильтрация = НабKind.Количество() > 0;
	КонецЕсли;

	Для Каждого ФайлПакета Из НайденныеФайлы Цикл
		ИдПакета = ИзвлечьИдентификаторПакетаИзИмени(ФайлПакета.Имя);
		УжеЗагружен = ПакетУжеЗагружен(ИдПакета);

		Если УжеЗагружен И Не ВключатьЗагруженные Тогда
			Продолжить;
		КонецЕсли;

		KindФайла = ПрочитатьKindПакета(ФайлПакета.ПолноеИмя);

		Если НужнаФильтрация Тогда
			Если НабKind.Получить(KindФайла) <> Истина Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Стр = Результат.Добавить();
		Стр.ПолныйПуть          = ФайлПакета.ПолноеИмя;
		Стр.ИмяФайла            = ФайлПакета.Имя;
		Стр.ИдентификаторПакета = ИдПакета;
		Стр.Kind                = KindФайла;
		Стр.РазмерКБ            = ФайлПакета.Размер() / 1024;
		Стр.ДатаМодификации     = ФайлПакета.ПолучитьВремяИзменения();
		Стр.УжеЗагружен         = УжеЗагружен;
	КонецЦикла;

	// Сортировка: новые сверху
	Результат.Сортировать("ДатаМодификации УБЫВ");

	Возврат Результат;

КонецФункции

// Переместить обработанный файл в подпапку processed/ (либо переименовать
// добавив суффикс .done — если processed/ недоступна).
//
// Параметры:
//   ПолныйПуть - Строка - путь к обработанному файлу
//
// Возвращаемое значение:
//   Булево - Истина если перенос/переименование успешно
//
Функция ПометитьПакетОбработанным(ПолныйПуть) Экспорт

	Если Не ЗначениеЗаполнено(ПолныйПуть) Тогда
		Возврат Ложь;
	КонецЕсли;
	Файл = Новый Файл(ПолныйПуть);
	Если Не Файл.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;

	// Попытка 1 — перенос в подпапку processed/
	Попытка
		КаталогProcessed = Файл.Путь + "processed";
		КаталогProcessedФайл = Новый Файл(КаталогProcessed);
		Если Не КаталогProcessedФайл.Существует() Тогда
			СоздатьКаталог(КаталогProcessed);
		КонецЕсли;
		НовыйПуть = КаталогProcessed + "\" + Файл.Имя;
		ПереместитьФайл(ПолныйПуть, НовыйПуть);
		Возврат Истина;
	Исключение
	КонецПопытки;

	// Попытка 2 — добавить суффикс .done
	Попытка
		ПереместитьФайл(ПолныйПуть, ПолныйПуть + ".done");
		Возврат Истина;
	Исключение
		Лог("Не удалось пометить файл обработанным " + ПолныйПуть + ": " + ОписаниеОшибки(), "Ошибка");
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Обработать все новые пакеты из каталога OwnCloud за один проход.
// Для каждого нового файла: прочитать → передать в TL_СопуткаСервис.ОбработатьПакет →
// при успехе пометить файл обработанным (перенос в processed/).
//
// Параметры:
//   КаталогПуть - Строка (опционально) - если пусто, берётся из TL_Настройки
//   Проводить   - Булево  - проводить созданные документы (по умолчанию Истина)
//   МаксФайлов  - Число   - ограничение за один проход (по умолчанию 0 — без ограничения)
//   СписокKind  - Массив или СписокЗначений - фильтр по kind документов (опц.)
//
// Возвращаемое значение:
//   Структура (ВсегоНайдено, Обработано, Ошибок, СписокОшибок (Массив строк))
//
Функция ОбработатьВсеНовыеИзКаталога(КаталогПуть = "", Проводить = Истина,
		МаксФайлов = 0, СписокKind = Неопределено) Экспорт

	Итоги = Новый Структура("ВсегоНайдено, Обработано, Ошибок, СписокОшибок",
		0, 0, 0, Новый Массив);

	НовыеПакеты = ПолучитьСписокНовыхПакетов(КаталогПуть, Ложь, СписокKind);
	Итоги.ВсегоНайдено = НовыеПакеты.Количество();

	Лимит = ?(МаксФайлов > 0, Мин(МаксФайлов, НовыеПакеты.Количество()), НовыеПакеты.Количество());

	Для Инд = 0 По Лимит - 1 Цикл
		Стр = НовыеПакеты.Получить(Инд);
		Попытка
			ЧтениеПакета = ПрочитатьПакетИзФайла(Стр.ПолныйПуть);
			Если ЗначениеЗаполнено(ЧтениеПакета.Ошибка) Тогда
				ВызватьИсключение ЧтениеПакета.Ошибка;
			КонецЕсли;

			Результат = TL_СопуткаСервис.ОбработатьПакет(ЧтениеПакета.Пакет, Проводить);

			Если Результат.Ошибки.Количество() > 0 Тогда
				Итоги.Ошибок = Итоги.Ошибок + 1;
				Для Каждого Сооб Из Результат.Ошибки Цикл
					Итоги.СписокОшибок.Добавить(Стр.ИмяФайла + ": " + Сооб);
				КонецЦикла;
			Иначе
				Итоги.Обработано = Итоги.Обработано + 1;
				ПометитьПакетОбработанным(Стр.ПолныйПуть);
			КонецЕсли;
		Исключение
			Итоги.Ошибок = Итоги.Ошибок + 1;
			Итоги.СписокОшибок.Добавить(Стр.ИмяФайла + ": " + ОписаниеОшибки());
			Лог("Ошибка обработки пакета " + Стр.ПолныйПуть + ": " + ОписаниеОшибки(), "Ошибка");
		КонецПопытки;
	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Проверка доступности источника через эндпоинт /health.
//
// Параметры:
//   URL    - Строка - базовый URL (если пусто, берётся из TL_Настройки.URL_ЦБ)
//   Логин  - Строка
//   Пароль - Строка
//
// Возвращаемое значение:
//   Структура - {
//     Доступен   - Булево
//     Ответ      - Соответствие — тело /health или Неопределено
//     Ошибка     - Строка
//   }
//
Функция Healthcheck(URL = "", Логин = "", Пароль = "") Экспорт

	Если Не ЗначениеЗаполнено(URL) Тогда
		URL = TL_Настройки.ПолучитьЗначение("URL_ЦБ", "");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Логин) Тогда
		Логин = TL_Настройки.ПолучитьЗначение("Логин_ЦБ", "");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Пароль) Тогда
		Пароль = TL_Настройки.ПолучитьЗначение("Пароль_ЦБ", "");
	КонецЕсли;

	Результат = Новый Структура("Доступен, Ответ, Ошибка", Ложь, Неопределено, "");

	Если Не ЗначениеЗаполнено(URL) Тогда
		Результат.Ошибка = "URL_ЦБ не задан";
		Возврат Результат;
	КонецЕсли;

	ВспомСтруктура = Новый Структура("Ошибка", "");
	ОтветТело = ВыполнитьЗапросПакета(URL, "/health", Логин, Пароль, ВспомСтруктура);

	Если Не ЗначениеЗаполнено(ОтветТело) Тогда
		Результат.Ошибка = ВспомСтруктура.Ошибка;
		Возврат Результат;
	КонецЕсли;

	ТелоJSON = РазобратьJSON(ОтветТело);
	Если ТелоJSON = Неопределено Тогда
		Результат.Ошибка = "Тело /health не парсится как JSON";
		Возврат Результат;
	КонецЕсли;

	Результат.Ответ = ТелоJSON;
	Результат.Доступен = (ПолучитьЗначениеИзJSON(ТелоJSON, "status", "") = "ok");
	Возврат Результат;

КонецФункции

// Валидировать структуру пакета на минимальные требования контракта.
//
// Параметры:
//   Пакет - Соответствие - десериализованный JSON
//
// Возвращаемое значение:
//   Структура - {
//     Корректен  - Булево
//     Ошибки   - Массив строк
//   }
//
Функция ВалидироватьПакет(Пакет) Экспорт

	Результат = Новый Структура("Корректен, Ошибки", Истина, Новый Массив);

	Если Пакет = Неопределено Тогда
		Результат.Корректен = Ложь;
		Результат.Ошибки.Добавить("Пакет = Неопределено");
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Пакет) <> Тип("Соответствие") Тогда
		Результат.Корректен = Ложь;
		Результат.Ошибки.Добавить("Пакет должен быть JSON-объектом");
		Возврат Результат;
	КонецЕсли;

	Версия = ПолучитьЗначениеИзJSON(Пакет, "ВерсияФормата", "");
	Если Версия <> "1" И Версия <> "2" Тогда
		Результат.Корректен = Ложь;
		Результат.Ошибки.Добавить("ВерсияФормата = '" + Строка(Версия)
			+ "' не поддерживается (ожидались '1' или '2')");
	КонецЕсли;

	// Формат v2: должна присутствовать шапка Смена{} с НомерСмены и Открытием/Закрытием
	Если Версия = "2" Тогда
		Смена = ПолучитьЗначениеИзJSON(Пакет, "Смена", Неопределено);
		Если Смена = Неопределено Тогда
			Результат.Корректен = Ложь;
			Результат.Ошибки.Добавить("ВерсияФормата=2: шапка Смена{} отсутствует");
		Иначе
			НомерСмены = ПолучитьЗначениеИзJSON(Смена, "НомерСмены", "");
			Если Не ЗначениеЗаполнено(НомерСмены) Тогда
				Результат.Корректен = Ложь;
				Результат.Ошибки.Добавить("ВерсияФормата=2: Смена.НомерСмены не задан");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ИдПакета = ПолучитьЗначениеИзJSON(Пакет, "ИдентификаторПакета", "");
	Если Не ЗначениеЗаполнено(ИдПакета) Тогда
		Результат.Корректен = Ложь;
		Результат.Ошибки.Добавить("ИдентификаторПакета не задан");
	КонецЕсли;

	НСИ = ПолучитьЗначениеИзJSON(Пакет, "НСИ", Неопределено);
	Если НСИ = Неопределено ИЛИ ТипЗнч(НСИ) <> Тип("Массив") Тогда
		Результат.Корректен = Ложь;
		Результат.Ошибки.Добавить("Поле НСИ отсутствует или не массив");
	КонецЕсли;

	ДокументыСписок = ПолучитьЗначениеИзJSON(Пакет, "Документы", Неопределено);
	Если ДокументыСписок = Неопределено ИЛИ ТипЗнч(ДокументыСписок) <> Тип("Массив") Тогда
		Результат.Корректен = Ложь;
		Результат.Ошибки.Добавить("Поле Документы отсутствует или не массив");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Безопасное извлечение значения из Соответствие/Структура.
// Дублирует TL_ApiКлиент.ПолучитьЗначение, чтобы не зависеть от него
// (TL_HTTPКлиентЦБ — отдельная подсистема).
//
Функция ПолучитьЗначениеИзJSON(Данные, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт

	Если Данные = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Ключ);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство(Ключ) Тогда
			Возврат Данные[Ключ];
		КонецЕсли;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполнить HTTP-запрос к источнику. Записывает ошибку в ВнешнийРезультат.Ошибка.
//
// Параметры:
//   URL              - Строка - базовый URL (с http:// или https://)
//   Путь             - Строка - путь эндпоинта (начинается с "/")
//   Логин            - Строка - Basic Auth
//   Пароль           - Строка
//   ВнешнийРезультат - Структура - в неё пишется .Ошибка при сбое
//
// Возвращаемое значение:
//   Строка - тело ответа или "" при ошибке
//
Функция ВыполнитьЗапросПакета(URL, Путь, Логин, Пароль, ВнешнийРезультат)

	Попытка
		Части = РазобратьURL(URL);

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Accept", "application/json");

		Если ЗначениеЗаполнено(Логин) Тогда
			ТокенBasic = ПолучитьBase64СтрокуИзДвоичныхДанных(
				ПолучитьДвоичныеДанныеИзСтроки(Логин + ":" + Пароль, "UTF-8", Ложь));
			Заголовки.Вставить("Authorization", "Basic " + СокрЛП(ТокенBasic));
		КонецЕсли;

		ПолныйПуть = Части.БазовыйПуть + Путь;
		Запрос = Новый HTTPЗапрос(ПолныйПуть, Заголовки);

		ЗащСоед = Неопределено;
		Если Части.Защищённое Тогда
			ЗащСоед = Новый ЗащищенноеСоединениеOpenSSL();
		КонецЕсли;

		// Таймаут 30 секунд — пакеты сопутки малы, но НСИ может расти
		Соединение = Новый HTTPСоединение(
			Части.Хост, Части.Порт, , , , 30, ЗащСоед);

		Ответ = Соединение.Получить(Запрос);

		Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
			Возврат Ответ.ПолучитьТелоКакСтроку();
		КонецЕсли;

		ТелоОшибки = "";
		Попытка ТелоОшибки = Ответ.ПолучитьТелоКакСтроку(); Исключение КонецПопытки;

		ТекстОшибки = "HTTP " + XMLСтрока(Ответ.КодСостояния)
			+ " GET " + ПолныйПуть
			+ Символы.ПС + Лев(ТелоОшибки, 500);

		ВнешнийРезультат.Ошибка = ТекстОшибки;
		Лог(ТекстОшибки, "Ошибка");
		Возврат "";

	Исключение
		ТекстОшибки = "Сбой HTTP-запроса GET " + Путь
			+ Символы.ПС + ОписаниеОшибки();
		ВнешнийРезультат.Ошибка = ТекстОшибки;
		Лог(ТекстОшибки, "Ошибка");
		Возврат "";
	КонецПопытки;

КонецФункции

// Разобрать URL на компоненты: Хост, Порт, БазовыйПуть, Защищённое.
//
Функция РазобратьURL(URL)

	Результат = Новый Структура("Хост, Порт, БазовыйПуть, Защищённое",
		"", 80, "", Ложь);

	Адрес = СокрЛП(URL);

	Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Адрес = Сред(Адрес, 9);
		Результат.Защищённое = Истина;
		Результат.Порт = 443;
	ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		Адрес = Сред(Адрес, 8);
	КонецЕсли;

	ПозСлеша = СтрНайти(Адрес, "/");
	Если ПозСлеша > 0 Тогда
		Результат.БазовыйПуть = Сред(Адрес, ПозСлеша);
		Адрес = Лев(Адрес, ПозСлеша - 1);
		Если СтрЗаканчиваетсяНа(Результат.БазовыйПуть, "/") Тогда
			Результат.БазовыйПуть = Лев(Результат.БазовыйПуть,
				СтрДлина(Результат.БазовыйПуть) - 1);
		КонецЕсли;
	КонецЕсли;

	ПозДвоеточия = СтрНайти(Адрес, ":");
	Если ПозДвоеточия > 0 Тогда
		Попытка
			Результат.Порт = Число(Сред(Адрес, ПозДвоеточия + 1));
		Исключение
		КонецПопытки;
		Результат.Хост = Лев(Адрес, ПозДвоеточия - 1);
	Иначе
		Результат.Хост = Адрес;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Десериализовать JSON-строку в Соответствие/Массив.
// Объекты читаются как Соответствие — для надёжности с произвольными ключами.
//
Функция РазобратьJSON(Тело)

	Если Не ЗначениеЗаполнено(Тело) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Возврат ПрочитатьJSON(Чтение, Истина); // Истина = в Соответствие
	Исключение
		Лог("Ошибка разбора JSON: " + ОписаниеОшибки(), "Ошибка");
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Прочитать содержимое текстового файла в строку.
// JSON от источника — UTF-8, без BOM либо с BOM (источник может варьировать).
//
Функция ПрочитатьСодержимоеФайла(Путь)

	// ЧтениеТекста корректно работает с BOM-префиксом и со всеми кириллическими
	// файлами расширения. Старый вариант через Поток.Прочитать() ломается на
	// 8.3.27 из-за обязательного параметра РазмерБуфера.
	ЧтениеТ = Новый ЧтениеТекста(Путь, "UTF-8");
	Содержимое = ЧтениеТ.Прочитать();
	ЧтениеТ.Закрыть();

	// Срезать BOM (U+FEFF), если ЧтениеТекста его не убрал
	Если СтрДлина(Содержимое) > 0 И КодСимвола(Содержимое, 1) = 65279 Тогда
		Содержимое = Сред(Содержимое, 2);
	КонецЕсли;

	Возврат Содержимое;

КонецФункции

// Сформировать query-string по правилам контракта §9.3.
// Параметры — Структура с возможными полями Kind, ПериодС, ПериодПо,
// Организация, Склад, ВидОперации, Limit, Cursor.
//
Функция ПостроитьСтрокуЗапроса(Параметры)

	Куски = Новый Массив;

	ПериодС  = ПолучитьЗначениеСтруктуры(Параметры, "ПериодС", '00010101');
	ПериодПо = ПолучитьЗначениеСтруктуры(Параметры, "ПериодПо", '00010101');

	Если ЗначениеЗаполнено(ПериодС) Тогда
		Куски.Добавить("from=" + Формат(ПериодС, "ДФ=yyyy-MM-dd"));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПериодПо) Тогда
		Куски.Добавить("to=" + Формат(ПериодПо, "ДФ=yyyy-MM-dd"));
	КонецЕсли;

	Kind = ПолучитьЗначениеСтруктуры(Параметры, "Kind", "");
	Если ЗначениеЗаполнено(Kind) Тогда
		Куски.Добавить("kind=" + Kind);
	КонецЕсли;

	Орг = ПолучитьЗначениеСтруктуры(Параметры, "Организация", "");
	Если ЗначениеЗаполнено(Орг) Тогда
		Куски.Добавить("organization=" + Орг);
	КонецЕсли;

	Склад = ПолучитьЗначениеСтруктуры(Параметры, "Склад", "");
	Если ЗначениеЗаполнено(Склад) Тогда
		Куски.Добавить("warehouse=" + Склад);
	КонецЕсли;

	ВидОп = ПолучитьЗначениеСтруктуры(Параметры, "ВидОперации", "");
	Если ЗначениеЗаполнено(ВидОп) Тогда
		// Фильтр имени параметра в URL — кириллический по контракту §9.3,
		// 1С HTTPЗапрос корректно закодирует
		Куски.Добавить("вид_операции=" + ВидОп);
	КонецЕсли;

	Лимит = ПолучитьЗначениеСтруктуры(Параметры, "Limit", 0);
	Если Лимит > 0 Тогда
		Куски.Добавить("limit=" + XMLСтрока(Лимит));
	КонецЕсли;

	Курсор = ПолучитьЗначениеСтруктуры(Параметры, "Cursor", "");
	Если ЗначениеЗаполнено(Курсор) Тогда
		Куски.Добавить("cursor=" + Курсор);
	КонецЕсли;

	Возврат СтрСоединить(Куски, "&");

КонецФункции

// Безопасное извлечение поля из Структуры (для входных параметров клиента).
//
Функция ПолучитьЗначениеСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию)

	Если ТипЗнч(Структура) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если Структура.Свойство(Ключ) Тогда
		Значение = Структура[Ключ];
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Сверка SHA-256 хеша пакета согласно контракту §5.3 / §11.1.
// Источник должен передавать поле "ХешПакета" в JSON. Если поле отсутствует —
// сверка не выполняется (возвращается Истина), чтобы не блокировать пакет.
//
// На A3 нарушение хеша логируется как warning, но не блокирует обработку:
// контракт v0.1 не закрепляет правила канонизации однозначно. Финальная блокировка —
// после согласования v0.2 контракта.
//
Функция СверитьХешПакета(Содержимое, Пакет)

	ОжидаемыйХеш = ПолучитьЗначениеИзJSON(Пакет, "ХешПакета", "");
	Если Не ЗначениеЗаполнено(ОжидаемыйХеш) Тогда
		Возврат Истина; // не передан — пропускаем
	КонецЕсли;

	// Упрощённая первичная сверка: SHA-256 от полученного тела как есть.
	// Каноническая сверка по §5.3 (с удалением поля ХешПакета и сортировкой
	// ключей) — добавляется когда источник зафиксирует канонизацию в v0.2.
	Попытка
		Двоичные = ПолучитьДвоичныеДанныеИзСтроки(Содержимое, "UTF-8", Ложь);
		Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеш.Добавить(Двоичные);
		// ПолучитьHexСтрокуИзДвоичныхДанных — встроенная функция платформы 8.3.10+,
		// возвращает hex без пробелов (UPPERCASE).
		ХешHex = НРег(СокрЛП(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма)));
	Исключение
		Лог("Не удалось вычислить SHA-256: " + ОписаниеОшибки(), "Предупреждение");
		Возврат Истина;
	КонецПопытки;

	Если ВРег(СокрЛП(ОжидаемыйХеш)) = ВРег(ХешHex) Тогда
		Возврат Истина;
	КонецЕсли;

	Лог("Хеш пакета не совпал: ожидалось " + ОжидаемыйХеш
		+ ", получено " + ХешHex
		+ " (warning, не блокирует на A3)",
		"Предупреждение");
	Возврат Ложь;

КонецФункции

// Извлечь ИдентификаторПакета (GUID) из имени файла. Поиск идёт по pattern
// 8-4-4-4-12 шестнадцатеричных символов (стандартный UUID). При отсутствии GUID
// возвращается пустая строка.
//
// Поддерживаемые форматы:
//   tl_<UUID>.json
//   tl_<UUID>_<timestamp>.json
//   tl_synth_rp_<UUID>.json
//   <UUID>.json
//
Функция ИзвлечьИдентификаторПакетаИзИмени(ИмяФайла)

	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат "";
	КонецЕсли;
	Имя = НРег(СокрЛП(ИмяФайла));

	// Сканируем имя в поисках первого GUID-pattern (длина 36 с дефисами)
	Для Поз = 1 По СтрДлина(Имя) - 35 Цикл
		Кусок = Сред(Имя, Поз, 36);
		Если ЭтоВалидныйGUID(Кусок) Тогда
			Возврат Кусок;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Проверка строки на формат GUID (8-4-4-4-12 hex с дефисами).
//
Функция ЭтоВалидныйGUID(Стр)

	Если СтрДлина(Стр) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	// Проверяем позиции дефисов: 9, 14, 19, 24
	Если Сред(Стр, 9, 1) <> "-" ИЛИ Сред(Стр, 14, 1) <> "-"
		ИЛИ Сред(Стр, 19, 1) <> "-" ИЛИ Сред(Стр, 24, 1) <> "-" Тогда
		Возврат Ложь;
	КонецЕсли;
	// Проверяем что остальные позиции — hex
	Для i = 1 По 36 Цикл
		Если i = 9 ИЛИ i = 14 ИЛИ i = 19 ИЛИ i = 24 Тогда
			Продолжить;
		КонецЕсли;
		С = Сред(Стр, i, 1);
		Если Не (С >= "0" И С <= "9") И Не (С >= "a" И С <= "f") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Проверка — был ли пакет с этим ИдентификаторПакета уже загружен.
// Используется регистр TL_СверкаПакета (ИдентификаторПакета — измерение).
//
Функция ПакетУжеЗагружен(ИдентификаторПакета)

	Если Не ЗначениеЗаполнено(ИдентификаторПакета) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Найдено
		|ИЗ РегистрСведений.TL_СверкаПакета
		|ГДЕ ИдентификаторПакета = &ИдПакета");
	Запрос.УстановитьПараметр("ИдПакета", ИдентификаторПакета);
	Попытка
		Возврат Запрос.Выполнить().Выбрать().Следующий();
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Прочитать поле «Тип» (kind) первого документа в JSON-пакете.
// Минимизирует объём работы — читает весь файл и извлекает только нужное поле.
// Возвращает строку kind или пустую строку при ошибке.
//
Функция ПрочитатьKindПакета(ПолныйПуть) Экспорт

	Если Не ЗначениеЗаполнено(ПолныйПуть) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Содержимое = ПрочитатьСодержимоеФайла(ПолныйПуть);
		Пакет = РазобратьJSON(Содержимое);
		Если Пакет = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Документы = ПолучитьЗначениеИзJSON(Пакет, "Документы", Неопределено);
		Если Документы = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Кол = Документы.Количество();
		Если Кол = 0 Тогда
			Возврат "";
		КонецЕсли;
		ПервыйДок = Документы.Получить(0);
		Если ПервыйДок = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(ПолучитьЗначениеИзJSON(ПервыйДок, "Тип", ""));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Привести входной фильтр СписокKind к Соответствие (kind → Истина) для быстрой
// проверки. Принимает Массив, ФиксированныйМассив, СписокЗначений или одну строку.
//
Функция НормализоватьСписокKind(СписокKind)

	Результат = Новый Соответствие;
	Если СписокKind = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Тип = ТипЗнч(СписокKind);
	Если Тип = Тип("Строка") Тогда
		Если ЗначениеЗаполнено(СписокKind) Тогда
			Результат.Вставить(СокрЛП(СписокKind), Истина);
		КонецЕсли;
	ИначеЕсли Тип = Тип("Массив") ИЛИ Тип = Тип("ФиксированныйМассив") Тогда
		Для Каждого Эл Из СписокKind Цикл
			Если ЗначениеЗаполнено(Эл) Тогда
				Результат.Вставить(СокрЛП(Строка(Эл)), Истина);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Тип = Тип("СписокЗначений") Тогда
		Для Каждого Эл Из СписокKind Цикл
			Если ЗначениеЗаполнено(Эл.Значение) Тогда
				Результат.Вставить(СокрЛП(Строка(Эл.Значение)), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Запись в журнал регистрации с событием TL_HTTPКлиентЦБ.
//
Процедура Лог(Текст, Уровень = "Информация")

	Уров = УровеньЖурналаРегистрации.Информация;
	Если Уровень = "Ошибка" Тогда
		Уров = УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли Уровень = "Предупреждение" Тогда
		Уров = УровеньЖурналаРегистрации.Предупреждение;
	КонецЕсли;

	Попытка
		ЗаписьЖурналаРегистрации("TL_HTTPКлиентЦБ", Уров, , , Текст);
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
