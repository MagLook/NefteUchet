////////////////////////////////////////////////////////////////////////////////
// Обработка TL_ПросмотрОшибок, Форма
// Просмотр РегистрСведений.TL_ОшибкиЗагрузки для бухгалтера ГИГ.
//
// Реквизиты формы (для сборки):
//   ДатаНачала             - Дата (DateTime)
//   ДатаОкончания          - Дата (DateTime)
//   ФильтрТипОбъекта       - ПеречислениеСсылка.TL_ТипОбъектаИсточника
//   ФильтрКодОшибки        - ПеречислениеСсылка.TL_КодОшибкиЗагрузки
//   ФильтрИдентификаторПакета - Строка(36)
//   Результат              - ТаблицаЗначений (динамически создаётся)
//
// Команды:
//   ОбновитьСписок         → Обновить()
//   ОчиститьФильтры        → ОчиститьФильтры()
//   ОткрытьПакет           → ОткрытьПакет() — открывает TL_ПросмотрСверки с фильтром по выделенному пакету
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Дефолт период — последние 7 дней
	ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	ДатаНачала    = НачалоДня(ДатаОкончания - 7 * 24 * 60 * 60);
	Если Параметры.Свойство("ФильтрИдентификаторПакета") И ЗначениеЗаполнено(Параметры.ФильтрИдентификаторПакета) Тогда
		ФильтрИдентификаторПакета = Параметры.ФильтрИдентификаторПакета;
		ДатаНачала = '00010101';
		ДатаОкончания = '39991231';
	КонецЕсли;
	УстановитьУсловноеОформление();
	ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	УсловноеОформление.Элементы.Очистить();

	// Критичные коды ошибок — красный фон строки
	// (Перечислимые значения зависят от Enums.TL_КодОшибкиЗагрузки)
	КритичныеКоды = СтрРазделить("ОтсутствуетОбязательноеПоле,СправочникНеНайден,НеверныйТипДанных,ОшибкаЗапроса,ОшибкаПроведения", ",");
	Для Каждого Код Из КритичныеКоды Цикл
		ДобавитьПравилоПоКоду(Код, WebЦвета.МистическаяРоза);
	КонецЦикла;

	// Предупреждения — серый
	Предупреждения = СтрРазделить("ПродолженоПоУмолчанию,ИгнорированоПолитикой", ",");
	Для Каждого Код Из Предупреждения Цикл
		ДобавитьПравилоПоКоду(Код, WebЦвета.СветлоСерый);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДобавитьПравилоПоКоду(КодКакСтрока, Цвет)
	// Достать перечислимое значение по имени; если нет — пропустить
	ЗначениеПеречисления = Неопределено;
	Попытка
		ЗначениеПеречисления = Перечисления.TL_КодОшибкиЗагрузки[КодКакСтрока];
	Исключение
		Возврат;
	КонецПопытки;

	Эл = УсловноеОформление.Элементы.Добавить();
	От = Эл.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	От.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Результат.КодОшибки");
	От.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	От.ПравоеЗначение = ЗначениеПеречисления;
	Эл.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);
	Пол = Эл.Поля.Элементы.Добавить();
	Пол.Поле = Новый ПолеКомпоновкиДанных("Результат");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСписок(Команда) Экспорт
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФильтры(Команда) Экспорт
	ФильтрТипОбъекта = Неопределено;
	ФильтрКодОшибки = Неопределено;
	ФильтрИдентификаторПакета = "";
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПакет(Команда) Экспорт
	ТекСтрока = Элементы.Результат.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Сообщить("Выберите строку с ошибкой");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ТекСтрока.ИдентификаторПакета) Тогда
		Сообщить("У выбранной строки нет идентификатора пакета");
		Возврат;
	КонецЕсли;
	ПараметрыОткрытия = Новый Структура("ФильтрИдентификаторПакета", ТекСтрока.ИдентификаторПакета);
	ОткрытьФорму("Обработка.TL_ПросмотрСверки.Форма.Форма", ПараметрыОткрытия);
КонецПроцедуры

&НаКлиенте
Процедура ПерезагрузитьПакет(Команда) Экспорт
	ТекСтрока = Элементы.Результат.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Сообщить("Выберите строку с ошибкой");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ТекСтрока.ИдентификаторПакета) Тогда
		Сообщить("У выбранной строки нет идентификатора пакета");
		Возврат;
	КонецЕсли;
	Если Вопрос("Перезагрузить пакет " + ТекСтрока.ИдентификаторПакета + "? "
			+ "Уже созданные документы по пакету будут обновлены (идемпотентность через TL_СоответствиеИсточников).",
			РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Результат = ПерезагрузитьПакетНаСервере(ТекСтрока.ИдентификаторПакета);
	Сообщить(Результат);
	ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Функция ПерезагрузитьПакетНаСервере(ИдПакета)
	КаталогПуть = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
	Если Не ЗначениеЗаполнено(КаталогПуть) Тогда
		Возврат "Не настроен каталог OwnCloud (КаталогOwnCloud_ЦБ). Заполните в TL_НастройкаОбменаСопутка или TL_НастройкаОбменаОбщепит.";
	КонецЕсли;
	Попытка
		Файлы = НайтиФайлы(КаталогПуть, "*" + ИдПакета + "*.json", Истина);
	Исключение
		Возврат "Ошибка поиска файлов: " + ОписаниеОшибки();
	КонецПопытки;
	Если Файлы.Количество() = 0 Тогда
		Возврат "Файл пакета не найден в " + КаталогПуть;
	КонецЕсли;
	Попытка
		ФайлПакета = Файлы[0];
		Текст = Новый ЧтениеТекста(ФайлПакета.ПолноеИмя, "UTF-8");
		Содержимое = Текст.Прочитать();
		Текст.Закрыть();
		// Десериализация JSON
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Содержимое);
		Пакет = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		// Вызов обработчика пакета
		TL_СопуткаСервис.ОбработатьПакет(Пакет, Истина);
		Возврат "Пакет " + ИдПакета + " перезагружен из " + ФайлПакета.Имя;
	Исключение
		Возврат "Ошибка при перезагрузке: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьНаСервере()
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ОшЗ.ВремяРегистрации КАК ВремяРегистрации,
		|	ОшЗ.ИдентификаторПакета КАК ИдентификаторПакета,
		|	ОшЗ.НомерЗаписи КАК НомерЗаписи,
		|	ОшЗ.ИсточникUUID КАК ИсточникUUID,
		|	ОшЗ.ТипОбъекта КАК ТипОбъекта,
		|	ОшЗ.Поле КАК Поле,
		|	ОшЗ.КодОшибки КАК КодОшибки,
		|	ОшЗ.ЗначениеИсточника КАК ЗначениеИсточника,
		|	ОшЗ.СообщениеОшибки КАК СообщениеОшибки,
		|	ОшЗ.Документ КАК Документ
		|ИЗ
		|	РегистрСведений.TL_ОшибкиЗагрузки КАК ОшЗ
		|ГДЕ
		|	ОшЗ.ВремяРегистрации МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И (&БезФильтраТипа ИЛИ ОшЗ.ТипОбъекта = &ФильтрТипОбъекта)
		|	И (&БезФильтраКода ИЛИ ОшЗ.КодОшибки = &ФильтрКодОшибки)
		|	И (&БезФильтраПакета ИЛИ ОшЗ.ИдентификаторПакета = &ФильтрИдентификаторПакета)
		|УПОРЯДОЧИТЬ ПО
		|	ОшЗ.ВремяРегистрации УБЫВ";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ФильтрТипОбъекта", ФильтрТипОбъекта);
	Запрос.УстановитьПараметр("БезФильтраТипа", Не ЗначениеЗаполнено(ФильтрТипОбъекта));
	Запрос.УстановитьПараметр("ФильтрКодОшибки", ФильтрКодОшибки);
	Запрос.УстановитьПараметр("БезФильтраКода", Не ЗначениеЗаполнено(ФильтрКодОшибки));
	Запрос.УстановитьПараметр("ФильтрИдентификаторПакета", ФильтрИдентификаторПакета);
	Запрос.УстановитьПараметр("БезФильтраПакета", ПустаяСтрока(ФильтрИдентификаторПакета));

	Результат.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;

	Элементы.КоличествоОшибок.Заголовок = "Найдено ошибок: " + Результат.Количество();
КонецПроцедуры

#КонецОбласти
