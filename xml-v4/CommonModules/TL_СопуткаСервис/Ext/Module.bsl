	Параметры.Вставить("КодОшибки", КодОшибки);
	Параметры.Вставить("ЗначениеИсточника", ЗначениеИсточника);
	Параметры.Вставить("СообщениеОшибки", Сообщение);

	TL_Сверка.ЗаписатьОшибку(Параметры);

	Результат.Ошибки.Добавить(Сообщение);

