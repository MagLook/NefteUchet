// === Унификация имён складов АЗС ===

&НаКлиенте
Процедура ОткрытьУнификациюСкладов(Команда)

	ИнфоОбИзменениях = ПодготовитьТекстПланаУнификации();
	// Структура: ЕстьИзменения, Текст
	Если ИнфоОбИзменениях.ЕстьИзменения Тогда
		Оповещение = Новый ОписаниеОповещения("ОткрытьУнификациюСкладов_Завершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ИнфоОбИзменениях.Текст, РежимДиалогаВопрос.ДаНет, ,
			КодВозвратаДиалога.Нет, "Унификация имён складов АЗС");
	Иначе
		// Изменений нет — но всё равно покажем сводку, чтобы бухгалтер видел что проверка прошла
		ПоказатьПредупреждение(, ИнфоОбИзменениях.Текст, , "Унификация имён складов АЗС");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьУнификациюСкладов_Завершение(Результат, Параметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ПрименитьУнификациюНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПодготовитьТекстПланаУнификации()

	План = TL_Настройки.ПолучитьПланУнификацииСкладовАЗС();

	СтрокиПлана = "";
	СтрокиСводки = "";
	СтрокиКонфликтов = "";
	КолвоПлан = 0;
	КолвоОК   = 0;

	Для Каждого Стр Из План Цикл
		Если Стр.Применить Тогда
			КолвоПлан = КолвоПлан + 1;
			СтрокиПлана = СтрокиПлана + ?(ЗначениеЗаполнено(СтрокиПлана), Символы.ПС, "")
				+ "  ст." + Стр.Код + ":  «" + Стр.ТекущееИмя + "»  →  «" + Стр.ЦелевоеИмя + "»";
		ИначеЕсли ЗначениеЗаполнено(Стр.Конфликт) Тогда
			СтрокиКонфликтов = СтрокиКонфликтов + ?(ЗначениеЗаполнено(СтрокиКонфликтов), Символы.ПС, "")
				+ "  ст." + Стр.Код + ":  " + Стр.Конфликт;
		Иначе
			КолвоОК = КолвоОК + 1;
			СтрокиСводки = СтрокиСводки + ?(ЗначениеЗаполнено(СтрокиСводки), Символы.ПС, "")
				+ "  ✓ ст." + Стр.Код + ":  " + Стр.ТекущееИмя;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура("ЕстьИзменения, Текст", Ложь, "");

	Если КолвоПлан > 0 Тогда
		Результат.ЕстьИзменения = Истина;
		Результат.Текст = "Будут переименованы следующие склады АЗС (" + КолвоПлан + " шт.):"
			+ Символы.ПС + Символы.ПС + СтрокиПлана;
		Если ЗначениеЗаполнено(СтрокиКонфликтов) Тогда
			Результат.Текст = Результат.Текст + Символы.ПС + Символы.ПС
				+ "Пропущены из-за конфликтов имён:" + Символы.ПС + СтрокиКонфликтов;
		КонецЕсли;
		Результат.Текст = Результат.Текст + Символы.ПС + Символы.ПС + "Применить переименование?";
	Иначе
		// Изменений нет — показываем сводку всех проверенных позиций
		Результат.Текст = "Проверка завершена: все " + КолвоОК
			+ " складов АЗС соответствуют стандарту наименования."
			+ Символы.ПС + Символы.ПС + СтрокиСводки;
		Если ЗначениеЗаполнено(СтрокиКонфликтов) Тогда
			Результат.Текст = Результат.Текст + Символы.ПС + Символы.ПС
				+ "Конфликты:" + Символы.ПС + СтрокиКонфликтов;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПрименитьУнификациюНаСервере()

	План = TL_Настройки.ПолучитьПланУнификацииСкладовАЗС();
	Пары = Новый Соответствие;
	Для Каждого Стр Из План Цикл
		Если Стр.Применить Тогда
			Пары.Вставить(Стр.Код, Стр.ЦелевоеИмя);
		КонецЕсли;
	КонецЦикла;

	Рез = TL_Настройки.ПрименитьУнификациюСкладовАЗС(Пары);

	Лог = ?(ЗначениеЗаполнено(ТекстЛога), ТекстЛога + Символы.ПС, "")
		+ "=== Унификация имён складов АЗС ===";
	Для Каждого С Из Рез.Применено Цикл
		Лог = Лог + Символы.ПС + "✓ " + С;
	КонецЦикла;
	Для Каждого О Из Рез.Ошибки Цикл
		Лог = Лог + Символы.ПС + "✗ " + О;
	КонецЦикла;
	Лог = Лог + Символы.ПС + "Итого: переименовано " + Строка(Рез.Применено.Количество())
		+ ", ошибок " + Строка(Рез.Ошибки.Количество());
	ТекстЛога = Лог;

КонецПроцедуры

#КонецОбласти
