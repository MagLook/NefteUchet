////////////////////////////////////////////////////////////////////////////////
// Обработка TL_ПросмотрСверки, Форма
// Просмотр РегистрСведений.TL_СверкаПакета для бухгалтера ГИГ.
//
// Реквизиты формы (для сборки):
//   ДатаНачала                - Дата (DateTime)
//   ДатаОкончания             - Дата (DateTime)
//   ФильтрСтатус              - Строка(50)
//   ФильтрИдентификаторПакета - Строка(36)
//   Результат                 - ТаблицаЗначений (заполняется кодом)
//
// Параметры формы (для открытия из других мест):
//   ФильтрИдентификаторПакета - если передан, открывается с этим фильтром
//
// Команды:
//   ОбновитьСписок            → Обновить()
//   ОчиститьФильтры           → ОчиститьФильтры()
//   ПоказатьОшибкиПакета      → ПоказатьОшибкиПакета()
//   ПоказатьДокументыПакета   → ПоказатьДокументыПакета()
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	ДатаНачала    = НачалоДня(ДатаОкончания - 7 * 24 * 60 * 60);
	Если Параметры.Свойство("ФильтрИдентификаторПакета") И ЗначениеЗаполнено(Параметры.ФильтрИдентификаторПакета) Тогда
		ФильтрИдентификаторПакета = Параметры.ФильтрИдентификаторПакета;
		ДатаНачала = '00010101';
		ДатаОкончания = '39991231';
	КонецЕсли;
	УстановитьУсловноеОформление();
	ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	УсловноеОформление.Элементы.Очистить();

	// «Принято целиком» → светло-зелёный
	ДобавитьПравилоОформления("Результат.Статус", "ПринятоЦеликом",
		WebЦвета.СветлоЗеленый, Истина);

	// «Принято частично» → светло-жёлтый
	ДобавитьПравилоОформления("Результат.Статус", "ПринятоЧастично",
		WebЦвета.СветлоЖелтый, Истина);

	// «Отклонено» → светло-красный
	ДобавитьПравилоОформления("Результат.Статус", "Отклонено",
		WebЦвета.МистическаяРоза, Истина);

	// Расхождение > 0.01 → подсветка колонки Расхождение красным
	Эл = УсловноеОформление.Элементы.Добавить();
	От = Эл.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	От.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Результат.Расхождение");
	От.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	От.ПравоеЗначение = 0.01;
	Эл.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.МистическаяРоза);
	Эл.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));
	Пол = Эл.Поля.Элементы.Добавить();
	Пол.Поле = Новый ПолеКомпоновкиДанных("РезультатРасхождение");
КонецПроцедуры

&НаСервере
Процедура ДобавитьПравилоОформления(ИмяПоля, Значение, Цвет, ВсяСтрока = Ложь)
	Эл = УсловноеОформление.Элементы.Добавить();
	От = Эл.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	От.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	От.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	От.ПравоеЗначение = Значение;
	Эл.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);
	Пол = Эл.Поля.Элементы.Добавить();
	Если ВсяСтрока Тогда
		Пол.Поле = Новый ПолеКомпоновкиДанных("Результат");
	Иначе
		Пол.Поле = Новый ПолеКомпоновкиДанных("Результат" + СтрЗаменить(ИмяПоля, "Результат.", ""));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСписок(Команда) Экспорт
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФильтры(Команда) Экспорт
	ФильтрСтатус = "";
	ФильтрИдентификаторПакета = "";
	ДатаОкончания = КонецДня(ТекущаяДата());
	ДатаНачала    = НачалоДня(ДатаОкончания - 7 * 24 * 60 * 60);
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибкиПакета(Команда) Экспорт
	ТекСтрока = Элементы.Результат.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Сообщить("Выберите строку пакета");
		Возврат;
	КонецЕсли;
	ПараметрыОткрытия = Новый Структура("ФильтрИдентификаторПакета", ТекСтрока.ИдентификаторПакета);
	ОткрытьФорму("Обработка.TL_ПросмотрОшибок.Форма.Форма", ПараметрыОткрытия);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДокументыПакета(Команда) Экспорт
	ТекСтрока = Элементы.Результат.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Сообщить("Выберите строку пакета");
		Возврат;
	КонецЕсли;
	// Открыть стандартный список регистра TL_СоответствиеИсточников с фильтром по пакету
	// (фильтр передать через параметр строки навигационной ссылки)
	ПерейтиПоНавигационнойСсылке(
		"e1cib/list/РегистрСведений.TL_СоответствиеИсточников?"
		+ "Filter.ИдентификаторПоследнегоПакета=" + ТекСтрока.ИдентификаторПакета);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьНаСервере()
	// Поля КодАЗС, НомерСмены, ДатаСмены, ОСЭНомер появились в TL_СверкаПакета
	// с переходом на формат пакета v2 (пакет = смена). Если колонки отсутствуют
	// в Результат-таблице формы (Form.xml ещё не обновлён), ЗаполнитьЗначения
	// тихо пропустит лишние поля выборки.
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	СвП.ИдентификаторПакета КАК ИдентификаторПакета,
		|	СвП.ВремяЗагрузки КАК ВремяЗагрузки,
		|	СвП.Источник КАК Источник,
		|	СвП.ПериодС КАК ПериодС,
		|	СвП.ПериодПо КАК ПериодПо,
		|	СвП.СтрокНСИ КАК СтрокНСИ,
		|	СвП.СтрокДокументов КАК СтрокДокументов,
		|	СвП.СуммаЦБ КАК СуммаЦБ,
		|	СвП.СуммаБП КАК СуммаБП,
		|	СвП.Расхождение КАК Расхождение,
		|	СвП.Статус КАК Статус,
		|	СвП.Комментарий КАК Комментарий,
		|	СвП.КодАЗС КАК КодАЗС,
		|	СвП.НомерСмены КАК НомерСмены,
		|	СвП.ДатаСмены КАК ДатаСмены,
		|	СвП.ОСЭНомер КАК ОСЭНомер,
		|	ЕСТЬNULL(ОшСч.Ошибок, 0) КАК Ошибок,
		|	ЕСТЬNULL(ДокСч.ДоктовБП, 0) КАК ДоктовБП
		|ИЗ
		|	РегистрСведений.TL_СверкаПакета КАК СвП
		|		ЛЕВОЕ СОЕДИНЕНИЕ
		|		(ВЫБРАТЬ
		|			ИдентификаторПакета КАК ИдентификаторПакета,
		|			КОЛИЧЕСТВО(*) КАК Ошибок
		|		ИЗ РегистрСведений.TL_ОшибкиЗагрузки
		|		СГРУППИРОВАТЬ ПО ИдентификаторПакета) КАК ОшСч
		|		ПО СвП.ИдентификаторПакета = ОшСч.ИдентификаторПакета
		|		ЛЕВОЕ СОЕДИНЕНИЕ
		|		(ВЫБРАТЬ
		|			ИдентификаторПоследнегоПакета КАК ИдентификаторПакета,
		|			КОЛИЧЕСТВО(*) КАК ДоктовБП
		|		ИЗ РегистрСведений.TL_СоответствиеИсточников
		|		ГДЕ Тип В (
		|			ЗНАЧЕНИЕ(Перечисление.TL_ТипОбъектаИсточника.Поступление),
		|			ЗНАЧЕНИЕ(Перечисление.TL_ТипОбъектаИсточника.ОтчётОРозничныхПродажах),
		|			ЗНАЧЕНИЕ(Перечисление.TL_ТипОбъектаИсточника.ПКО),
		|			ЗНАЧЕНИЕ(Перечисление.TL_ТипОбъектаИсточника.Перемещение),
		|			ЗНАЧЕНИЕ(Перечисление.TL_ТипОбъектаИсточника.Списание),
		|			ЗНАЧЕНИЕ(Перечисление.TL_ТипОбъектаИсточника.Инвентаризация),
		|			ЗНАЧЕНИЕ(Перечисление.TL_ТипОбъектаИсточника.Оприходование),
		|			ЗНАЧЕНИЕ(Перечисление.TL_ТипОбъектаИсточника.ВыпускБлюд),
		|			ЗНАЧЕНИЕ(Перечисление.TL_ТипОбъектаИсточника.ТребованиеНакладная))
		|		СГРУППИРОВАТЬ ПО ИдентификаторПоследнегоПакета) КАК ДокСч
		|		ПО СвП.ИдентификаторПакета = ДокСч.ИдентификаторПакета
		|ГДЕ
		|	СвП.ВремяЗагрузки МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И (&БезФильтраСтатуса ИЛИ СвП.Статус = &ФильтрСтатус)
		|	И (&БезФильтраПакета ИЛИ СвП.ИдентификаторПакета = &ФильтрИдентификаторПакета)
		|УПОРЯДОЧИТЬ ПО
		|	СвП.ДатаСмены УБЫВ, СвП.КодАЗС, СвП.ВремяЗагрузки УБЫВ";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ФильтрСтатус", ФильтрСтатус);
	Запрос.УстановитьПараметр("БезФильтраСтатуса", ПустаяСтрока(ФильтрСтатус));
	Запрос.УстановитьПараметр("ФильтрИдентификаторПакета", ФильтрИдентификаторПакета);
	Запрос.УстановитьПараметр("БезФильтраПакета", ПустаяСтрока(ФильтрИдентификаторПакета));

	Результат.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;

	// Итоги
	ИтогРасхождение = 0;
	ИтогСуммаЦБ = 0;
	ИтогСуммаБП = 0;
	КолПринятоЦеликом = 0;
	КолПринятоЧастично = 0;
	КолОтклонено = 0;
	Для Каждого Стр Из Результат Цикл
		ИтогРасхождение = ИтогРасхождение + Стр.Расхождение;
		ИтогСуммаЦБ = ИтогСуммаЦБ + Стр.СуммаЦБ;
		ИтогСуммаБП = ИтогСуммаБП + Стр.СуммаБП;
		Если Стр.Статус = "ПринятоЦеликом" Тогда
			КолПринятоЦеликом = КолПринятоЦеликом + 1;
		ИначеЕсли Стр.Статус = "ПринятоЧастично" Тогда
			КолПринятоЧастично = КолПринятоЧастично + 1;
		ИначеЕсли Стр.Статус = "Отклонено" Тогда
			КолОтклонено = КолОтклонено + 1;
		КонецЕсли;
	КонецЦикла;

	Элементы.КоличествоПакетов.Заголовок =
		"Найдено пакетов: " + Результат.Количество()
		+ "    |    Целиком: " + КолПринятоЦеликом
		+ "  Частично: " + КолПринятоЧастично
		+ "  Отклонено: " + КолОтклонено;

	Если Элементы.Найти("ИтогиСумм") <> Неопределено Тогда
		Элементы.ИтогиСумм.Заголовок =
			"Итого сумма ЦБ: " + Формат(ИтогСуммаЦБ, "ЧДЦ=2; ЧРГ=' '")
			+ "    Итого сумма БП: " + Формат(ИтогСуммаБП, "ЧДЦ=2; ЧРГ=' '")
			+ "    Итого расхождение: " + Формат(ИтогРасхождение, "ЧДЦ=2; ЧРГ=' '");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
