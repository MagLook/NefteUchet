Функция ФорматСуммыКомпакт(Сумма)
	Если Сумма >= 1000000 Тогда
		Возврат Формат(Сумма / 1000000, "ЧДЦ=1") + " М";
	ИначеЕсли Сумма >= 1000 Тогда
		Возврат Формат(Сумма / 1000, "ЧДЦ=0") + " К";
	КонецЕсли;
	Возврат Формат(Сумма, "ЧДЦ=0; ЧРГ=' '");
КонецФункции


&НаСервере
Функция Экранировать(Текст)
	Т = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Т = СтрЗаменить(Т, "<", "&lt;");
	Т = СтрЗаменить(Т, ">", "&gt;");
	Т = СтрЗаменить(Т, """", "&quot;");
	Возврат Т;
КонецФункции

// Получить HTML с остатками на складе АКЗС (41.02, литры).
//
&НаСервере
Функция ПолучитьОстаткиСкладаHTML()

	Попытка
		НаимСклада = TL_Настройки.ПолучитьЗначение("Станция_" + XMLСтрока(КодСтанции) + "_Склад", "");
		Если Не ЗначениеЗаполнено(НаимСклада) Тогда
			Возврат "";
		КонецЕсли;

		Склад = Справочники.Склады.НайтиПоНаименованию(НаимСклада, Истина);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			Возврат "";
		КонецЕсли;

		Счёт4102 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.02");

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Субконто1.Наименование КАК Номенклатура,
			|	КоличествоОстатокДт КАК Количество
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет = &Счет, , Субконто2 = &Склад) КАК Остатки
			|ГДЕ
			|	КоличествоОстатокДт > 0
			|УПОРЯДОЧИТЬ ПО
			|	Номенклатура";
		Запрос.УстановитьПараметр("Счет", Счёт4102);
		Запрос.УстановитьПараметр("Склад", Склад);

		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();

		HTML = "";
		Пока Выборка.Следующий() Цикл
			Наим = Строка(Выборка.Номенклатура);
			Кол = Выборка.Количество;

			// Цвет бара по типу топлива
			Если СтрНайти(НРег(Наим), "92") > 0 Тогда
				ЦветБара = "#c8a820";
			ИначеЕсли СтрНайти(НРег(Наим), "95") > 0 Тогда
				ЦветБара = "#3070c0";
			ИначеЕсли СтрНайти(НРег(Наим), "дт") > 0 ИЛИ СтрНайти(НРег(Наим), "дизель") > 0 Тогда
				ЦветБара = "#30a040";
			Иначе
				ЦветБара = "#94A3B8";
			КонецЕсли;

			КолТекст = Формат(Кол, "ЧДЦ=0; ЧРГ=' '");
			HTML = HTML + "<div style=""white-space:nowrap;"">"
				+ "<span style=""display:inline-block; width:8px; height:8px; border-radius:2px;"
				+ " background:" + ЦветБара + "; margin-right:5px; vertical-align:middle;""></span>"
				+ "<b style=""font-size:13px;"">" + КолТекст + "</b>"
				+ "<span style=""color:#94A3B8; font-size:10px;""> л</span> "
				+ "<span style=""color:#94A3B8; font-size:10px;"">" + Наим + "</span>"
				+ "</div>";
		КонецЦикла;

		Возврат HTML;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

