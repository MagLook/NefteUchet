////////////////////////////////////////////////////////////////////////////////
// Обработка TL_Загрузка, Форма
// Расширение ElsyPlus Ledger v3 — рабочее место бухгалтера
//
// Двухпанельная раскладка:
//   ГруппаФильтры       — КодСтанции, ТипДокументаФильтр, ДатаНачала, ДатаОкончания, [Обновить]
//   ГруппаОсновная (горизонтально 50/50):
//     ├── ГруппаЛевая (ДОКУМЕНТЫ 1С)
//     │   ├── ВнутренниеДанные (таблица)
//     │   └── [Провести] [Распровести] [Удалить] [Выбрать все]
//     └── ГруппаПравая (ВНЕШНИЕ ДАННЫЕ)
//         ├── ВнешниеДанные (таблица)
//         └── [◀ Загрузить выбранные] [Выбрать все]
//   HTMLДашборд        — ПолеHTMLДокумента (верхняя полоса с KPI-карточками)
//   ГруппаДетали       — HTMLДетали (ПолеHTMLДокумента, разворачиваемая)
//   ГруппаНижняя (горизонтально):
//     ├── ТекстЛога     — лог операций
//     └── ГруппаНастройки — URLСервера, Логин, Пароль, КодСистемы (свёрнута)
//
// Реквизиты формы:
//   Простые: URLСервера, Логин, Пароль, КодСистемы, КодСтанции,
//            ДатаНачала, ДатаОкончания, ТипДокументаФильтр,
//            ТекстЛога, ТокенAPI, HTMLДашборд, HTMLДетали
//   Таблицы:
//     ВнешниеДанные (9 колонок): Отметка, ТипДокумента, Дата, Станция,
//       НомерСмены, Описание, Сумма, КлючЗагрузки, ДанныеJSON
//     ВнутренниеДанные (11 колонок): Отметка, Статус, ТипДокумента, Дата,
//       Станция, Описание, Сумма, КлючЗагрузки, КлючБазовый, ДанныеJSON, ДокументПредставление
//
// Команды (8):
//   КомандаОбновить, КомандаЗагрузить, КомандаПровести, КомандаРаспровести,
//   КомандаУдалить, КомандаВыбратьВсеВнешние, КомандаВыбратьВсеВнутренние
//
// Настройки/маппинг — через TL_Настройки, TL_РегистрСтатусов (v4).
////////////////////////////////////////////////////////////////////////////////

// === Режимы работы формы ===
// Три независимых контура учёта в одной форме (Нефтепродукты/Сопутка/Общепит).
// Текущий режим хранится в РегистрСведений TL_Настройки.TL_РежимРаботы.
// Без переменных модуля — обычная форма обращается к ним только из клиента.


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаНачала = НачалоМесяца(ТекущаяДата());
	ДатаОкончания = ТекущаяДата();
	ТипДокументаФильтр = "Все";
	КодСтанции = 0;

	// Список «Тип документа для загрузки» зависит от текущего режима
	ЗаполнитьСписокТиповДокументов();

	Попытка
		ЗагрузитьНастройки();
	Исключение
	КонецПопытки;

	// Выпадающий список станций из настроек.
	// Накапливаем все станции в ТаблицуЗначений, затем сортируем по КодЧисло
	// и только потом заливаем в СписокВыбора — иначе порядок зависит от того,
	// как ПолучитьВсеСтанции и API вернули записи.
	Попытка
		ЭлСтанция = Элементы.КодСтанции;
		ЭлСтанция.СписокВыбора.Очистить();
		ЭлСтанция.СписокВыбора.Добавить(0, "Все станции");

		Буфер = Новый ТаблицаЗначений;
		Буфер.Колонки.Добавить("Код", Новый ОписаниеТипов("Число"));
		Буфер.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
		ИзвестныеКоды = Новый Соответствие; // Код → Истина

		// Базовый набор: настроенные станции из локального регистра
		МассивСтанций = TL_Настройки.ПолучитьВсеСтанции();
		Для Каждого Ст Из МассивСтанций Цикл
			Попытка КодЧисло = Число(Ст.Код); Исключение КодЧисло = 0; КонецПопытки;
			Если КодЧисло > 0 И ИзвестныеКоды.Получить(КодЧисло) = Неопределено Тогда
				НоваяСтрока = Буфер.Добавить();
				НоваяСтрока.Код = КодЧисло;
				НоваяСтрока.Представление = TL_Настройки.ОтформатироватьИмяСтанции(КодЧисло, Ст.Наименование);
				ИзвестныеКоды.Вставить(КодЧисло, Истина);
			КонецЕсли;
		КонецЦикла;

		// Тихий discovery: дополняем буфер станциями из API
		Если ЗначениеЗаполнено(URLСервера) И ЗначениеЗаполнено(Логин) И ЗначениеЗаполнено(Пароль) Тогда
			Попытка
				РезОпроса = TL_Настройки.ОпроситьВсеСетиИзAPI(URLСервера, Логин, Пароль);
				Для Каждого ОС Из РезОпроса.Станции Цикл
					КодСтр = XMLСтрока(ОС.Код);
					Имя = ?(ЗначениеЗаполнено(ОС.Наименование), ОС.Наименование, "Станция " + КодСтр);

					// Если у станции уже настроен склад — пропускаем (она уже в буфере).
					СкладСущ = TL_Настройки.НайтиСкладСтанции(ОС.Код);
					Если ЗначениеЗаполнено(СкладСущ) Тогда
						Продолжить;
					КонецЕсли;

					// Сохраняем привязку к сети (с защитой от перезаписи при конфликте)
					СохранКС = TL_Настройки.ПолучитьЧисло("Станция_" + КодСтр + "_КодСистемы", 0);
					Если СохранКС = 0 Тогда
						TL_Настройки.УстановитьЗначение("Станция_" + КодСтр + "_КодСистемы",
							XMLСтрока(ОС.КодСистемы), "Сеть станции (auto)");
					ИначеЕсли СохранКС <> ОС.КодСистемы Тогда
						Продолжить;
					КонецЕсли;
					Если Не ЗначениеЗаполнено(TL_Настройки.ПолучитьЗначение("Станция_" + КодСтр + "_Наименование", "")) Тогда
						TL_Настройки.УстановитьЗначение("Станция_" + КодСтр + "_Наименование",
							Имя, "Имя станции (auto)");
					КонецЕсли;

					// Автосоздание склада если ещё нет
					Попытка
						СкладСсылка = TL_Настройки.ПолучитьИлиСоздатьСкладАЗС(Имя, ОС.Код);
					Исключение
						СкладСсылка = Неопределено;
					КонецПопытки;

					Если ИзвестныеКоды.Получить(ОС.Код) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					ПометкаСклад = ?(СкладСсылка <> Неопределено И ЗначениеЗаполнено(СкладСсылка),
						"", " (не настроен склад)");
					НоваяСтрока = Буфер.Добавить();
					НоваяСтрока.Код = ОС.Код;
					НоваяСтрока.Представление = TL_Настройки.ОтформатироватьИмяСтанции(ОС.Код, Имя) + ПометкаСклад;
					ИзвестныеКоды.Вставить(ОС.Код, Истина);
				КонецЦикла;
			Исключение
				// Тихо игнорируем — API недоступен, остаётся локальный набор
			КонецПопытки;
		КонецЕсли;

		// Сортировка по коду станции (1, 2, 3 ... 8 ... 207, 208, 209, 210)
		Буфер.Сортировать("Код");
		Для Каждого Стр Из Буфер Цикл
			ЭлСтанция.СписокВыбора.Добавить(Стр.Код, Стр.Представление);
		КонецЦикла;

		ЭлСтанция.РежимВыбораИзСписка = Истина;
	Исключение
	КонецПопытки;

	// Автонастройка: если любой критичный параметр пуст — заполнить defaults ГИГ
	Попытка
		Если Не ЗначениеЗаполнено(URLСервера)
			ИЛИ Не ЗначениеЗаполнено(Логин)
			ИЛИ Не ЗначениеЗаполнено(Пароль)
			ИЛИ КодСистемы = 0 Тогда
			TL_Настройки.ИнициализироватьПоУмолчаниюГИГ();
			ЗагрузитьНастройки();
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Проверка подключения к API STS
	СтатусSTS = "";
	Если ЗначениеЗаполнено(URLСервера) И ЗначениеЗаполнено(Логин) Тогда
		Попытка
			Токен = TL_ApiКлиент.Авторизация(URLСервера, Логин, Пароль, КодСистемы);
			Если ЗначениеЗаполнено(Токен) Тогда
				СтатусSTS = "Подключено к STS API";
			Иначе
				СтатусSTS = "Ошибка авторизации STS";
			КонецЕсли;
		Исключение
			СтатусSTS = "Нет связи с STS: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	// Инициализация HTML-панелей
	ИнфоСтанция = "";
	Попытка
		НаимСт = TL_Настройки.ПолучитьЗначение("Станция_" + XMLСтрока(КодСтанции) + "_Наименование", "");
		НаимОрг = TL_Настройки.ПолучитьЗначение("Организация", "");
		Если ЗначениеЗаполнено(НаимСт) Тогда
			ИнфоСтанция = НаимСт + " (код " + XMLСтрока(КодСтанции) + ")";
		КонецЕсли;
		Если ЗначениеЗаполнено(НаимОрг) Тогда
			ИнфоСтанция = ИнфоСтанция + ?(ЗначениеЗаполнено(ИнфоСтанция), " | ", "") + НаимОрг;
		КонецЕсли;
	Исключение
	КонецПопытки;
	// При первом открытии форма восстанавливает последний режим из TL_Настройки.
	// Дашборд должен соответствовать ему, иначе виден чужой KPI/STS-блок
	// (например на Сопутке торчит «Подключено к STS API» от Нефтепродуктов).
	Попытка
		ОбновитьДашборд();
	Исключение
		HTMLДашборд = TL_HTMLГенератор.СформироватьДашборд(0, 0, 0, 0, 0, СтатусSTS, "", 0, ИнфоСтанция, "");
	КонецПопытки;
	HTMLДетали = TL_HTMLГенератор.ПустыеДетали();

	// Скрыть служебные поля (API-параметры, токен, лог)
	Попытка
		Для Каждого ИмяПоля Из СтрРазделить("URLСервера,Логин,Пароль,КодСистемы,ТокенAPI,ТекстЛога", ",") Цикл
			Элемент = Элементы.Найти(ИмяПоля);
			Если Элемент <> Неопределено Тогда
				Элемент.Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

	// Кнопки сортировки для таблиц
	Попытка
		СоздатьКнопкуСортировки("СортВнешнДата",  "Внеш: по дате",  "СортироватьВнешниеПоДате",  "ВнешниеДанные1КоманднаяПанель");
		СоздатьКнопкуСортировки("СортВнешнТип",   "Внеш: по типу",  "СортироватьВнешниеПоТипу",  "ВнешниеДанные1КоманднаяПанель");
		СоздатьКнопкуСортировки("СортВнутрДата",   "Внутр: по дате", "СортироватьВнутренниеПоДате", "ВнутренниеДанные1КоманднаяПанель");
		СоздатьКнопкуСортировки("СортВнутрСтатус", "Внутр: по стат.", "СортироватьВнутренниеПоСтатусу", "ВнутренниеДанные1КоманднаяПанель");
	Исключение
	КонецПопытки;

	// Кнопка «Режим: <текущий>» — переключатель контуров (Нефтепродукты/Сопутка/Общепит)
	// Добавляется ПЕРЕД кнопкой унификации, чтобы стоять слева
	Попытка
		Если Команды.Найти("ПереключитьРежим") = Неопределено Тогда
			КомР = Команды.Добавить("ПереключитьРежим");
			КомР.Действие  = "ПереключитьРежимКлик";
			КомР.Заголовок = ЗаголовокКнопкиРежима();
			КомР.Подсказка = "Переключить режим формы: Нефтепродукты / Сопутка / Общепит";
			КнпР = Элементы.Добавить("ПереключитьРежимКнопка", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
			КнпР.ИмяКоманды = "ПереключитьРежим";
			КнпР.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Кнопка «Унификация имён складов АЗС» — для бухгалтера
	Попытка
		Если Команды.Найти("УнифицироватьСклады") = Неопределено Тогда
			Ком = Команды.Добавить("УнифицироватьСклады");
			Ком.Действие  = "ОткрытьУнификациюСкладов";
			Ком.Заголовок = "Унификация имён складов";
			Ком.Подсказка = "Привести имена складов АЗС к стандарту: «АКЗС/АЗС <Метка> (<Код>)»";
			Кнп = Элементы.Добавить("УнифицироватьСкладыКнопка", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
			Кнп.ИмяКоманды = "УнифицироватьСклады";
			Кнп.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Кнопка «Опросить каталог» — сканирует настроенный OwnCloud-каталог
	Попытка
		Если Команды.Найти("ОпроситьКаталог") = Неопределено Тогда
			Ком = Команды.Добавить("ОпроситьКаталог");
			Ком.Действие  = "ОпроситьКаталогКлик";
			Ком.Заголовок = "Опросить каталог";
			Ком.Подсказка = "Сканировать OwnCloud-каталог обмена, показать новые tl_*.json и их статус";
			Кнп = Элементы.Добавить("ОпроситьКаталогКнопка", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
			Кнп.ИмяКоманды = "ОпроситьКаталог";
			Кнп.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Кнопка «Последние документы» — открывает список последних 50 созданных
	Попытка
		Если Команды.Найти("ПоказатьПоследниеДокументы") = Неопределено Тогда
			Ком = Команды.Добавить("ПоказатьПоследниеДокументы");
			Ком.Действие  = "ПоказатьПоследниеДокументыКлик";
			Ком.Заголовок = "Последние документы";
			Ком.Подсказка = "Список 50 последних документов созданных через TradeLedger";
			Кнп = Элементы.Добавить("ПоказатьПоследниеДокументыКнопка", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
			Кнп.ИмяКоманды = "ПоказатьПоследниеДокументы";
			Кнп.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Кнопка «Экспорт дашборда»
	Попытка
		Если Команды.Найти("ЭкспортДашборда") = Неопределено Тогда
			Ком = Команды.Добавить("ЭкспортДашборда");
			Ком.Действие  = "ЭкспортДашбордаКлик";
			Ком.Заголовок = "Экспорт дашборда";
			Ком.Подсказка = "Сохранить текущее состояние дашборда в HTML-файл для отчётности";
			Кнп = Элементы.Добавить("ЭкспортДашбордаКнопка", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
			Кнп.ИмяКоманды = "ЭкспортДашборда";
			Кнп.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Кнопка «Сбросить регистрацию» теперь добавлена через XML (Form.xml)
	// в строку 1 рядом с «Перезагрузить период» и «Подробный отчёт ошибок».

КонецПроцедуры


// Получить текущий режим работы (сервер). Безопасные значения только из
// фиксированного набора. По умолчанию — Нефтепродукты.
&НаСервере
Функция ПолучитьТекущийРежимНаСервере()
	Реж = "Нефтепродукты";
	Попытка
		Сохр = TL_Настройки.ПолучитьЗначение("TL_РежимРаботы", "Нефтепродукты");
		Если Сохр = "Сопутка" ИЛИ Сохр = "Общепит" ИЛИ Сохр = "Нефтепродукты" Тогда
			Реж = Сохр;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Реж;
КонецФункции


// Заголовок кнопки переключения режима с маркером выбранного контура.
&НаСервере
Функция ЗаголовокКнопкиРежима()
	Возврат "Режим: " + ПолучитьТекущийРежимНаСервере() + " ▼";
КонецФункции


// Заполнить список выбора «Тип документа для загрузки» в зависимости от
// текущего режима. Вызывается при создании формы и при переключении режима.
&НаСервере
Процедура ЗаполнитьСписокТиповДокументов()
	Попытка
		Элемент = Элементы.ТипДокументаФильтр;
		Элемент.Заголовок = "Тип документа для загрузки";
		Элемент.СписокВыбора.Очистить();

		Режим = ПолучитьТекущийРежимНаСервере();
		Если Режим = "Сопутка" Тогда
			Элемент.СписокВыбора.Добавить("Все",       "Все (покупки + продажи + возвраты)");
			Элемент.СписокВыбора.Добавить("ПТУ",       "Только покупки (ПТУ)");
			Элемент.СписокВыбора.Добавить("ОРП",       "Только розничные продажи (ОРП)");
			Элемент.СписокВыбора.Добавить("Возвраты",  "Только возвраты");
		ИначеЕсли Режим = "Общепит" Тогда
			Элемент.СписокВыбора.Добавить("Все",       "Все (выпуск + списания)");
			Элемент.СписокВыбора.Добавить("ОПЗС",      "Только выпуск продукции (ОПЗС)");
			Элемент.СписокВыбора.Добавить("Списания",  "Только списания ингредиентов");
		Иначе
			// Нефтепродукты (по умолчанию)
			Элемент.СписокВыбора.Добавить("Все",       "Все (смены + ТТН)");
			Элемент.СписокВыбора.Добавить("Смены",     "Только смены");
			Элемент.СписокВыбора.Добавить("ТТН",       "Только ТТН");
		КонецЕсли;

		// Сбросить значение фильтра на «Все», если текущее значение отсутствует в новом списке
		Найден = Ложь;
		Для Каждого Эл Из Элемент.СписокВыбора Цикл
			Если Эл.Значение = ТипДокументаФильтр Тогда
				Найден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Найден Тогда
			ТипДокументаФильтр = "Все";
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры


// Обработчик клика по кнопке режима. Открывает выбор из 3 значений.
&НаКлиенте
Процедура ПереключитьРежимКлик(Команда)
	Список = Новый СписокЗначений;
	Список.Добавить("Нефтепродукты", "Нефтепродукты (топливо через STS API)");
	Список.Добавить("Сопутка",       "Сопутка (товары через канал ЦБ)");
	Список.Добавить("Общепит",       "Общепит (выпуск и материалы через канал ЦБ)");
	Выбран = Список.ВыбратьЭлемент("Выберите режим работы");
	Если Выбран = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УстановитьРежимНаСервере(Выбран.Значение);
КонецПроцедуры


&НаСервере
Процедура УстановитьРежимНаСервере(НовыйРежим)
	Если НовыйРежим <> "Нефтепродукты" И НовыйРежим <> "Сопутка" И НовыйРежим <> "Общепит" Тогда
		Возврат;
	КонецЕсли;
	Попытка
		TL_Настройки.УстановитьЗначение("TL_РежимРаботы", НовыйРежим,
			"Текущий режим формы TL_Загрузка (Нефтепродукты/Сопутка/Общепит)");
	Исключение
	КонецПопытки;
	// Обновить заголовок кнопки
	Попытка
		Команды.Найти("ПереключитьРежим").Заголовок = ЗаголовокКнопкиРежима();
	Исключение
	КонецПопытки;
	// Перестроить список «Тип документа для загрузки» под новый режим
	ЗаполнитьСписокТиповДокументов();
	// Перерисовать дашборд под новый режим
	Попытка
		ОбновитьДашборд();
	Исключение
	КонецПопытки;
	// Прямая запись в реквизит формы
	Префикс = "[" + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + "] ";
	Стр = Префикс + "Режим переключён: " + НовыйРежим;
	Если ПустаяСтрока(ТекстЛога) Тогда
		ТекстЛога = Стр;
	Иначе
		ТекстЛога = ТекстЛога + Символы.ПС + Стр;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	Если Не ПроверитьНастройки() Тогда
		Возврат;
	КонецЕсли;

	// Сбросить момент сессии — отчёт об ошибках теперь покажет только то
	// что произошло после этого момента.
	СброситьМоментСессииНаСервере();

	ДобавитьВЛог("Обновление данных...");
	ОбновитьДанныеНаСервере();
	ДобавитьВЛог("Внешних: " + ВнешниеДанные.Количество()
		+ ", в 1С: " + ВнутренниеДанные.Количество());

КонецПроцедуры

&НаСервере
Процедура СброситьМоментСессииНаСервере()
	МоментСессииЗагрузки = ТекущаяДата();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыбранные(Команда)

	КолОтмеченных = ПодсчитатьОтмеченные(ВнешниеДанные);
	Если КолОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте строки для загрузки");
		Возврат;
	КонецЕсли;

	ДобавитьВЛог("Загрузка " + КолОтмеченных + " документов...");
	ЗагрузитьВыбранныеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПровестиВыбранные(Команда)

	КолОтмеченных = ПодсчитатьОтмеченные(ВнутренниеДанные);
	Если КолОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте строки для проведения");
		Возврат;
	КонецЕсли;

	ДобавитьВЛог("Проведение " + КолОтмеченных + " документов...");
	// Двухфазное проведение: ПЕРЕМ → возврат на клиент → КОМПЛ
	// (1С кэширует остатки регистра в рамках серверного вызова,
	//  поэтому КОМПЛ не видит остатки от ПЕРЕМ в одном вызове)
	ПровестиВыбранныеФаза1НаСервере(); // базовые + ПЕРЕМ + online
	ПровестиВыбранныеФаза2НаСервере(); // КОМПЛ (остатки от ПЕРЕМ уже зафиксированы)

КонецПроцедуры

&НаКлиенте
Процедура РаспровестиВыбранные(Команда)

	КолОтмеченных = ПодсчитатьОтмеченные(ВнутренниеДанные);
	Если КолОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте строки для распроведения");
		Возврат;
	КонецЕсли;

	ДобавитьВЛог("Распроведение " + КолОтмеченных + " документов...");
	РаспровестиВыбранныеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранные(Команда)

	КолОтмеченных = ПодсчитатьОтмеченные(ВнутренниеДанные);
	Если КолОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте строки для удаления");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Пометить на удаление " + КолОтмеченных + " документ(ов)?"
		+ Символы.ПС + "Проведённые документы будут сначала распроведены.";
	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьВыбранныеЗавершение", ЭтотОбъект),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранныеЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КолОтмеченных = ПодсчитатьОтмеченные(ВнутренниеДанные);
	ДобавитьВЛог("Удаление " + КолОтмеченных + " документов...");
	УдалитьВыбранныеНаСервере();

	// Автообновление — удалённые документы вернутся в правую панель
	ДобавитьВЛог("Обновление после удаления...");
	ОбновитьДанныеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеВнешние(Команда)
	ПереключитьОтметки(ВнешниеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеВнутренние(Команда)
	ПереключитьОтметки(ВнутренниеДанные);
КонецПроцедуры

