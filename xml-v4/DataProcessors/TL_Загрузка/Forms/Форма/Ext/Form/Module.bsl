	Стр.Описание      = Описание;
	Стр.Сумма         = Сумма;
	Стр.КлючЗагрузки = КлючЗагрузки;
	Стр.ДанныеJSON    = ДанныеJSON;
КонецПроцедуры

// (удалена: ДобавитьСвязанныеДокументы — дочерние видны в деталях основного документа,
//  а проведение/распроведение/удаление работают через регистр TL_СтатусыЗагрузки)

// Нормализовать ответ API со списком смен (3 формата).
//
&НаСервере
Функция НормализоватьОтветСмен(ОтветСмены)

	Смены = Новый Массив;

	Если ТипЗнч(ОтветСмены) = Тип("Массив") Тогда
		Если ОтветСмены.Количество() > 0 Тогда
			Первый = ОтветСмены[0];
			Если ТипЗнч(Первый) = Тип("Соответствие") И Первый.Получить("shift") <> Неопределено Тогда
				Смены = ОтветСмены;
			ИначеЕсли ТипЗнч(Первый) = Тип("Соответствие") И Первый.Получить("shifts") <> Неопределено Тогда
				Вложенные = Первый.Получить("shifts");
				Если ТипЗнч(Вложенные) = Тип("Массив") Тогда
					Смены = Вложенные;
				КонецЕсли;
			Иначе
				Смены = ОтветСмены;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ОтветСмены) = Тип("Соответствие") Тогда
		Вложенные = ОтветСмены.Получить("shifts");
		Если ТипЗнч(Вложенные) = Тип("Массив") Тогда
			Смены = Вложенные;
		КонецЕсли;
	КонецЕсли;

	Возврат Смены;

КонецФункции

// Проверить наличие ненастроенных станций в API.
// Если найдены — записать предупреждение в лог с кодами.
//
&НаСервере
Процедура ПроверитьНенастроенныеСтанции(Токен)

	Попытка
		ВсеСтанции = TL_ApiКлиент.ПолучитьСписокСтанций(URLСервера, Токен, КодСистемы);
	Исключение
		Возврат;
	КонецПопытки;

	Если ВсеСтанции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Ненастроенные = Новый Массив;
	Для Каждого КодСт Из ВсеСтанции Цикл
		Склад = TL_Настройки.НайтиСкладСтанции(КодСт);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			Ненастроенные.Добавить(XMLСтрока(КодСт));
		КонецЕсли;
	КонецЦикла;

	Если Ненастроенные.Количество() > 0 Тогда
		ДобавитьВЛогСервер("Обнаружены ненастроенные станции: "
			+ СтрСоединить(Ненастроенные, ", ")
			+ ". Откройте Настройки расширения для подключения.");
	КонецЕсли;

КонецПроцедуры

// Определить тип документа по суффиксу ключа.
//
&НаСервере
Функция ОпределитьТипПоКлючу(Ключ)
	Если СтрНайти(Ключ, "|КОМПЛ") > 0 Тогда
		Возврат "Комплектация";
	ИначеЕсли СтрНайти(Ключ, "|ПЕРЕМ") > 0 Тогда
		Возврат "Перемещение";
	ИначеЕсли СтрНайти(Ключ, "|ПКО") > 0 Тогда
		Возврат "Кассовый ордер";
	Иначе
		Возврат "Перемещение";
	КонецЕсли;
КонецФункции

// Определить описание по суффиксу ключа.
//
&НаСервере
Функция ОпределитьОписаниеПоКлючу(Ключ)
	Если СтрНайти(Ключ, "|КОМПЛ") > 0 Тогда
		Возврат "т → л";
	ИначеЕсли СтрНайти(Ключ, "|ПЕРЕМ") > 0 Тогда
		Возврат "→ АЗС";
	ИначеЕсли СтрНайти(Ключ, "|ПКО") > 0 Тогда
		Возврат "наличные → касса";
	Иначе
		// Перемещение по оплате: ключ = TL|СМЕНА|65|5|91|online|2
		Части = СтрРазделить(Ключ, "|");
		Если Части.Количество() > 6 Тогда
			Канал = Части[Части.Количество() - 2];
			КодТопл = Части[Части.Количество() - 1];
			ИмяТопл = TL_Настройки.ПолучитьНаименованиеТоплива(КодТопл);
			Возврат "→ " + ВРег(Канал) + ", " + ИмяТопл;
		ИначеЕсли Части.Количество() > 5 Тогда
			Возврат "→ " + ВРег(Части[Части.Количество() - 2]);
		КонецЕсли;
		Возврат "→ склад";
	КонецЕсли;
КонецФункции

// Определить тип документа 1С по ссылке.
//
&НаСервере
Функция ОпределитьТипДокумента(ДокСсылка)
	ИмяТипа = Строка(ТипЗнч(ДокСсылка));
	Если СтрНайти(ИмяТипа, "Перемещение") > 0 Тогда
		Возврат "Перемещение";
	ИначеЕсли СтрНайти(ИмяТипа, "Комплектация") > 0 Тогда
		Возврат "Комплектация";
	ИначеЕсли СтрНайти(ИмяТипа, "Поступление") > 0
			ИЛИ СтрНайти(ИмяТипа, "ПриходныйКассовыйОрдер") > 0 Тогда
		// ПриходныйКассовыйОрдер в БП 3.0 = "Поступление наличных"
		Если СтрНайти(ИмяТипа, "Кассовый") > 0 Тогда
			Возврат "Кассовый ордер";
		КонецЕсли;
		Возврат "ТТН";
	Иначе
		Возврат "Документ";
	КонецЕсли;
КонецФункции

// Определить описание дочернего документа.
//
&НаСервере
Функция ОпределитьОписаниеДочернего(ДокСсылка, ТипДоч)
	Если ТипДоч = "Комплектация" Тогда
		Возврат "т → л";
	ИначеЕсли ТипДоч = "Перемещение" Тогда
		Возврат "→ склад";
	ИначеЕсли ТипДоч = "Кассовый ордер" Тогда
		Возврат "наличные → касса";
	Иначе
		Возврат Строка(ДокСсылка);
	КонецЕсли;
КонецФункции

// Найти ключ загрузки по ссылке документа (обратный поиск).
//
&НаСервере
Функция НайтиКлючПоДокументу(ДокСсылка)
	Попытка
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		Комментарий = ДокОбъект.Комментарий;
		ПозРазделителя = СтрНайти(Комментарий, " | ");
		Если ПозРазделителя > 0 Тогда
			Возврат Лев(Комментарий, ПозРазделителя - 1);
		КонецЕсли;
		Возврат СокрЛП(Комментарий);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Обновить HTML-дашборд (KPI-карточки).
//
&НаСервере
Процедура ОбновитьДашборд()
	Режим = ПолучитьТекущийРежимНаСервере();
	Если Режим = "Сопутка" Тогда
		ОбновитьДашбордСопутка();
	ИначеЕсли Режим = "Общепит" Тогда
		ОбновитьДашбордОбщепит();
	Иначе
		ОбновитьДашбордНефтепродукты();
	КонецЕсли;
КонецПроцедуры


// Режим Нефтепродукты — оригинальная логика (STS API + смены + ТТН)
&НаСервере
Процедура ОбновитьДашбордНефтепродукты()

	КолСмен = 0;
	КолТТН = 0;
	Ошибок = 0;
	СуммаЗаПериод = 0;

	Для Каждого Стр Из ВнешниеДанные Цикл
		Если Стр.ТипДокумента = "Смена" Тогда КолСмен = КолСмен + 1; КонецЕсли;
		Если Стр.ТипДокумента = "ТТН" Тогда КолТТН = КолТТН + 1; КонецЕсли;
		СуммаЗаПериод = СуммаЗаПериод + Стр.Сумма;
	КонецЦикла;
	Для Каждого Стр Из ВнутренниеДанные Цикл
		Если Стр.ТипДокумента = "Смена" Тогда КолСмен = КолСмен + 1; КонецЕсли;
		Если Стр.ТипДокумента = "ТТН" Тогда КолТТН = КолТТН + 1; КонецЕсли;
		Если Стр.ТипДокумента = "Смена" ИЛИ Стр.ТипДокумента = "ТТН" Тогда
			СуммаЗаПериод = СуммаЗаПериод + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;

	Загружено = ВнутренниеДанные.Количество();
	Новых = ВнешниеДанные.Количество();

	СтатусSTS = ?(ЗначениеЗаполнено(ТокенAPI), "STS: подключено", "STS: не подключено");

	ИнфоСтанция = "";
	Попытка
		НаимСтанции = TL_Настройки.ПолучитьЗначение("Станция_" + XMLСтрока(КодСтанции) + "_Наименование", "");
		НаимОрг = TL_Настройки.ПолучитьЗначение("Организация", "");
		Если ЗначениеЗаполнено(НаимСтанции) ИЛИ ЗначениеЗаполнено(НаимОрг) Тогда
			Если ЗначениеЗаполнено(НаимСтанции) Тогда
				ИнфоСтанция = НаимСтанции + " (код " + XMLСтрока(КодСтанции) + ")";
			КонецЕсли;
			Если ЗначениеЗаполнено(НаимОрг) Тогда
				ИнфоСтанция = ИнфоСтанция + ?(ЗначениеЗаполнено(ИнфоСтанция), " | ", "") + НаимОрг;
			КонецЕсли;
			ИнфоСтанция = ИнфоСтанция + " | "
				+ Формат(ДатаНачала, "ДФ='dd.MM'") + " — " + Формат(ДатаОкончания, "ДФ='dd.MM.yyyy'");
		КонецЕсли;
	Исключение
	КонецПопытки;

	ИнфоОстатки = ПолучитьОстаткиСкладаHTML();

	HTMLДашборд = TL_HTMLГенератор.СформироватьДашборд(
		КолСмен + КолТТН, Загружено, Новых, Ошибок, СуммаЗаПериод,
		СтатусSTS, ТекстЛога, КолТТН, ИнфоСтанция, ИнфоОстатки);

КонецПроцедуры


// Режим Сопутка — пакеты OwnCloud (purchase/retail_sale_sidegoods/return_purchase)
&НаСервере
Процедура ОбновитьДашбордСопутка()

	Метрики = МетрикиСопутка();

	KPIМассив = Новый Массив;
	KPIМассив.Добавить(KPIКарточка(Формат(Метрики.КолПТУ, "ЧН=0"),       "ПТУ",       "#3B82F6"));
	KPIМассив.Добавить(KPIКарточка(Формат(Метрики.КолОРП, "ЧН=0"),       "ОРП",       "#16A34A"));
	KPIМассив.Добавить(KPIКарточка(Формат(Метрики.КолВозврат, "ЧН=0"),   "Возвраты",  "#F59E0B"));
	KPIМассив.Добавить(KPIКарточка(Формат(Метрики.НовыхПакетов, "ЧН=0"), "Новых",     "#EAB308"));
	KPIМассив.Добавить(KPIКарточка(Формат(Метрики.Ошибок, "ЧН=0"),       "Ошибок",    "#EF4444"));
	KPIМассив.Добавить(KPIКарточка(ФорматСуммыКомпакт(Метрики.СуммаЗаПериод), "Сумма", "#6B7280"));

	HTMLДашборд = СформироватьДашбордКастом(
