	Параметры.Вставить("shift", Формат(НомерСмены, "ЧГ=0"));

	Возврат ВыполнитьЗапросHTTP(Подключение.URLСервера, "GET", "/v1/report/shift_report", Подключение.Токен, , Параметры);

КонецФункции

