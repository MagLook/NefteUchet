////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_ApiКлиент
// Расширение TradeLedger для 1С:БП 3.0
// Контекст: Сервер, ВызовСервера
// HTTP-клиент для API STS (pos.autooplata.ru/tms)
//
// Эндпоинты:
//   POST /v1/login              → JWT-токен
//   GET  /v1/shifts             → список смен
//   GET  /v1/report/shift_report → полный сменный отчёт
//   GET  /v1/report/receipts    → поступления (ТТН)
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Авторизация в API STS.
// Возвращает JWT-токен или пустую строку при ошибке.
//
// Параметры:
//   URLСервера - Строка - базовый URL (например "https://pos.autooplata.ru/tms")
//   Логин      - Строка
//   Пароль     - Строка
//
// Возвращаемое значение:
//   Строка - JWT-токен или ""
//
Функция Авторизация(URLСервера, Логин, Пароль) Экспорт

	// STS API v2: POST /v2/login с полем user
	ПользовательAPI = Новый Структура;
	ПользовательAPI.Вставить("id", "00000000-0000-0000-0000-000000000000");
	ПользовательAPI.Вставить("name", "System");

	Тело = Новый Структура;
	Тело.Вставить("login", Логин);
	Тело.Вставить("password", Пароль);
	Тело.Вставить("user", ПользовательAPI);

	ТелоJSON = ОбъектВJSON(Тело);

	// Вызов с пробросом ошибок — авторизация критична
	Ответ = ВыполнитьЗапрос(URLСервера, "/v2/login", "POST", "", ТелоJSON, Истина);

	Если Не ЗначениеЗаполнено(Ответ) Тогда
		ВызватьИсключение "API вернул пустой ответ на /v2/login";
	КонецЕсли;

	// STS API возвращает токен как голую строку (возможно в кавычках)
	Токен = СокрЛП(Ответ);
	Токен = СтрЗаменить(Токен, """", ""); // убрать кавычки

	// Если вдруг JSON-объект с полем token (старый формат)
	Если СтрНачинаетсяС(Токен, "{") Тогда
		Данные = РазобратьОтветJSON(Ответ);
		Если Данные <> Неопределено И ТипЗнч(Данные) = Тип("Соответствие") Тогда
			ТокенИзJSON = Данные.Получить("token");
			Если ТокенИзJSON <> Неопределено Тогда
				Возврат Строка(ТокенИзJSON);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Токен;

КонецФункции

// Получить список смен станции.
//
// Возвращаемое значение:
//   Массив из Соответствие - элементы с ключами: station, shift, date, status
//
Функция ПолучитьСписокСмен(URLСервера, Токен, КодСистемы, КодСтанции) Экспорт

	Путь = "/v1/shifts?system=" + XMLСтрока(КодСистемы)
		+ "&station=" + XMLСтрока(КодСтанции);

	Ответ = ВыполнитьЗапрос(URLСервера, Путь, "GET", Токен);

	Если Ответ <> Неопределено Тогда
		Результат = РазобратьОтветJSON(Ответ);
		Если ТипЗнч(Результат) = Тип("Массив") Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Получить полный сменный отчёт (tanks, pumps, payments).
//
// Возвращаемое значение:
//   Соответствие или Неопределено
//
Функция ПолучитьСменныйОтчёт(URLСервера, Токен, КодСистемы, КодСтанции, НомерСмены) Экспорт

	Путь = "/v1/report/shift_report?system=" + XMLСтрока(КодСистемы)
		+ "&station=" + XMLСтрока(КодСтанции)
		+ "&shift=" + XMLСтрока(НомерСмены);

	Ответ = ВыполнитьЗапрос(URLСервера, Путь, "GET", Токен);

	Если Ответ <> Неопределено Тогда
		Возврат РазобратьОтветJSON(Ответ);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Получить данные о поступлениях (ТТН) за смену.
//
// Возвращаемое значение:
//   Массив из Соответствие - элементы ТТН с ключами: ttn, fuel, doc_volume, density и др.
//
Функция ПолучитьПоступления(URLСервера, Токен, КодСистемы, КодСтанции, НомерСмены) Экспорт

	Путь = "/v1/report/receipts?system=" + XMLСтрока(КодСистемы)
		+ "&station=" + XMLСтрока(КодСтанции)
		+ "&shift=" + XMLСтрока(НомерСмены);

	Ответ = ВыполнитьЗапрос(URLСервера, Путь, "GET", Токен);

	Если Ответ <> Неопределено Тогда
		Результат = РазобратьОтветJSON(Ответ);
		Если ТипЗнч(Результат) = Тип("Массив") Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Сериализовать объект (Структура/Массив/Соответствие) в JSON-строку.
//
Функция ОбъектВJSON(Объект) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Объект);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Безопасное извлечение значения из Соответствие/Структура.
//
// Параметры:
//   Данные               - Соответствие, Структура - источник
//   Ключ                 - Строка - имя ключа
//   ЗначениеПоУмолчанию  - Произвольный - возвращается если ключ не найден
//
// Возвращаемое значение:
//   Произвольный
//
Функция ПолучитьЗначение(Данные, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт

	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Ключ);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство(Ключ) Тогда
			Возврат Данные[Ключ];
		КонецЕсли;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Извлечь дату из данных API (строка ISO 8601 или yyyy-MM-dd).
//
// Параметры:
//   Данные - Соответствие, Структура - источник
//   Ключ   - Строка - имя ключа с датой
//
// Возвращаемое значение:
//   Дата - или пустая дата '00010101' при ошибке
//
Функция ПолучитьДатуИзДанных(Данные, Ключ) Экспорт

	Значение = ПолучитьЗначение(Данные, Ключ, "");
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), Строка(Значение));
	Исключение
		Попытка
			С = Строка(Значение);
			Возврат Дата(Число(Лев(С, 4)), Число(Сред(С, 6, 2)), Число(Сред(С, 9, 2)));
		Исключение
			Возврат '00010101';
		КонецПопытки;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполнить HTTP-запрос к API.
//
// Параметры:
//   URLСервера          - Строка - базовый URL
//   Путь                - Строка - путь эндпоинта (напр. "/v2/login")
//   Метод               - Строка - "GET" или "POST"
//   Токен               - Строка - JWT-токен (пустой для авторизации)
//   ТелоЗапроса         - Строка - JSON-тело для POST
//   ВызыватьИсключение  - Булево - Истина = пробросить ошибку, Ложь = вернуть Неопределено
//
// Возвращаемое значение:
//   Строка - тело ответа, или Неопределено при ошибке (если ВызыватьИсключение = Ложь)
//
Функция ВыполнитьЗапрос(URLСервера, Путь, Метод, Токен = "", ТелоЗапроса = "", ВызыватьИсключение = Ложь)

	Попытка
		Части = РазобратьURL(URLСервера);

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");
		Заголовки.Вставить("Accept", "application/json");

		Если ЗначениеЗаполнено(Токен) Тогда
			Заголовки.Вставить("Authorization", "Bearer " + Токен);
		КонецЕсли;

		ПолныйПуть = Части.БазовыйПуть + Путь;
		Запрос = Новый HTTPЗапрос(ПолныйПуть, Заголовки);

		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
		КонецЕсли;

		ЗащСоед = Неопределено;
		Если Части.Защищённое Тогда
			ЗащСоед = Новый ЗащищенноеСоединениеOpenSSL();
		КонецЕсли;

		Соединение = Новый HTTPСоединение(
			Части.Хост, Части.Порт, , , , 15, ЗащСоед);

		Если ВРег(Метод) = "POST" Тогда
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Иначе
			Ответ = Соединение.Получить(Запрос);
		КонецЕсли;

		Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
			Возврат Ответ.ПолучитьТелоКакСтроку();
		КонецЕсли;

		// HTTP ошибка
		ТелоОшибки = "";
		Попытка ТелоОшибки = Ответ.ПолучитьТелоКакСтроку(); Исключение КонецПопытки;

		ТекстОшибки = "HTTP " + XMLСтрока(Ответ.КодСостояния)
			+ " " + Метод + " " + ПолныйПуть
			+ Символы.ПС + ТелоОшибки;

		Если ВызыватьИсключение Тогда
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("TL_ApiКлиент",
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Возврат Неопределено;

	Исключение
		Если ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
		ЗаписьЖурналаРегистрации("TL_ApiКлиент",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Исключение: " + Метод + " " + Путь + Символы.ПС + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Разобрать URL на компоненты: Хост, Порт, БазовыйПуть, Защищённое.
//
Функция РазобратьURL(URLСервера)

	Результат = Новый Структура("Хост, Порт, БазовыйПуть, Защищённое");

	URL = СокрЛП(URLСервера);
	Результат.Защищённое = Ложь;

	Если СтрНачинаетсяС(НРег(URL), "https://") Тогда
		URL = Сред(URL, 9);
		Результат.Защищённое = Истина;
	ИначеЕсли СтрНачинаетсяС(НРег(URL), "http://") Тогда
		URL = Сред(URL, 8);
	КонецЕсли;

	Результат.Порт = ?(Результат.Защищённое, 443, 80);
	Результат.БазовыйПуть = "";

	// Отделить путь от хоста
	ПозСлеша = СтрНайти(URL, "/");
	Если ПозСлеша > 0 Тогда
		Результат.БазовыйПуть = Сред(URL, ПозСлеша);
		URL = Лев(URL, ПозСлеша - 1);
		// Убрать trailing slash
		Если СтрЗаканчиваетсяНа(Результат.БазовыйПуть, "/") Тогда
			Результат.БазовыйПуть = Лев(Результат.БазовыйПуть,
				СтрДлина(Результат.БазовыйПуть) - 1);
		КонецЕсли;
	КонецЕсли;

	// Порт в хосте (host:port)
	ПозДвоеточия = СтрНайти(URL, ":");
	Если ПозДвоеточия > 0 Тогда
		Результат.Порт = Число(Сред(URL, ПозДвоеточия + 1));
		Результат.Хост = Лев(URL, ПозДвоеточия - 1);
	Иначе
		Результат.Хост = URL;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Десериализовать JSON-строку в Соответствие/Массив.
// Объекты читаются как Соответствие (не Структура) для надёжности.
//
Функция РазобратьОтветJSON(ТелоОтвета)

	Если Не ЗначениеЗаполнено(ТелоОтвета) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоОтвета);
		Возврат ПрочитатьJSON(Чтение, Истина); // Истина = в Соответствие
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
