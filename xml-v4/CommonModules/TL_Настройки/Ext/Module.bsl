// Утилита: добавить в массив структуру (Ключ, Значение, Описание).
//
Процедура ДобавитьВ(Массив, Ключ, Значение, Описание)
	Массив.Добавить(Новый Структура("Ключ, Значение, Описание", Ключ, Значение, Описание));
КонецПроцедуры

// Заполнить только регистр TL_МаппингОплат стандартными 15 образцами без перетирания
// остальных настроек. Использует УстановитьМаппингОплатыПоУмолчанию, которая
// не затрагивает уже существующие записи (ручные правки бухгалтера сохраняются).
//
Процедура ЗаполнитьТолькоМаппингОплат() Экспорт

	СкладКарты    = НайтиСкладПоИмени(ПолучитьЗначение("Оплата_cards_Склад",   "Карты"));
	СкладОнлайн   = НайтиСкладПоИмени(ПолучитьЗначение("Оплата_online_Склад",  "ЯНДЕКС"));
	СкладВедомост = НайтиСкладПоИмени(ПолучитьЗначение("Оплата_ledger_Склад",  "Ведомости"));
	СкладТалоны   = НайтиСкладПоИмени(ПолучитьЗначение("Оплата_voucher_Склад", "Талоны"));
	ПустойСклад   = Справочники.Склады.ПустаяСсылка();

	УстановитьМаппингОплатыПоУмолчанию("наличн",       "retail_cash",   ПустойСклад);
	УстановитьМаппингОплатыПоУмолчанию("сбербанк",     "retail_card",   ПустойСклад);
	УстановитьМаппингОплатыПоУмолчанию("viacard",      "cards",         СкладКарты);
	УстановитьМаппингОплатыПоУмолчанию("балтоп",       "cards",         СкладКарты);
	УстановитьМаппингОплатыПоУмолчанию("baltop",       "cards",         СкладКарты);
	УстановитьМаппингОплатыПоУмолчанию("корпоратив",   "cards",         СкладКарты);
	УстановитьМаппингОплатыПоУмолчанию("корп.карты",   "cards",         СкладКарты);
	УстановитьМаппингОплатыПоУмолчанию("топливн",      "cards",         СкладКарты);
	УстановитьМаппингОплатыПоУмолчанию("агора",        "cards",         СкладКарты);
	УстановитьМаппингОплатыПоУмолчанию("инфорком",     "cards",         СкладКарты);  // probe G1 21.05.2026
	УстановитьМаппингОплатыПоУмолчанию("газпромнефть", "cards",         СкладКарты);  // probe G1 21.05.2026
	УстановитьМаппингОплатыПоУмолчанию("мосресурс",    "cards",         СкладКарты);  // probe G1 21.05.2026
	УстановитьМаппингОплатыПоУмолчанию("яндекс",       "online",        СкладОнлайн);
	УстановитьМаппингОплатыПоУмолчанию("мобил",        "online",        СкладОнлайн);
	УстановитьМаппингОплатыПоУмолчанию("benzuber",     "online",        СкладОнлайн);
	УстановитьМаппингОплатыПоУмолчанию("ведомост",     "ledger",        СкладВедомост);
	УстановитьМаппингОплатыПоУмолчанию("талон",        "voucher",       СкладТалоны);
	УстановитьМаппингОплатыПоУмолчанию("прочи",        "writeoff_fuel", ПустойСклад); // план B, 21.05.2026
	УстановитьМаппингОплатыПоУмолчанию("купон",        "",              ПустойСклад); // игнор (купоны на сдачу)
	УстановитьМаппингОплатыПоУмолчанию("прокач",       "",              ПустойСклад); // техпрокачка — возврат в ёмкость

	// Подтянуть склад в УЖЕ существующие записи маппинга, у которых Склад пуст.
	ДозаполнитьСкладыВМаппингеПоУмолчанию();

КонецПроцедуры

// Для существующих записей маппинга с пустым Складом подтянуть склад из настроек канала.
// Не трогает строки, где склад уже указан (значит, бухгалтер сделал переопределение осознанно).
//
Процедура ДозаполнитьСкладыВМаппингеПоУмолчанию() Экспорт

	Попытка
		// Карта: канал → ссылка на склад из настроек
		КаналыСоСкладами = Новый Соответствие;
		КаналыСоСкладами.Вставить("cards",   НайтиСкладПоИмени(ПолучитьЗначение("Оплата_cards_Склад",   "Карты")));
		КаналыСоСкладами.Вставить("online",  НайтиСкладПоИмени(ПолучитьЗначение("Оплата_online_Склад",  "ЯНДЕКС")));
		КаналыСоСкладами.Вставить("ledger",  НайтиСкладПоИмени(ПолучитьЗначение("Оплата_ledger_Склад",  "Ведомости")));
		КаналыСоСкладами.Вставить("voucher", НайтиСкладПоИмени(ПолучитьЗначение("Оплата_voucher_Склад", "Талоны")));

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ОбразецИмени, КаналОплаты, Склад
			|ИЗ РегистрСведений.TL_МаппингОплат";
		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			Канал = Строка(Выборка.КаналОплаты);
			Если КаналыСоСкладами.Получить(Канал) = Неопределено Тогда
				Продолжить; // retail и игнор-каналы — склад не нужен
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.Склад) Тогда
				Продолжить; // уже заполнен — оставляем переопределение бухгалтера
			КонецЕсли;
			ЦелевойСклад = КаналыСоСкладами.Получить(Канал);
			Если Не ЗначениеЗаполнено(ЦелевойСклад) Тогда
				Продолжить; // склад канала не существует в Catalog.Склады
			КонецЕсли;

			Менеджер = РегистрыСведений.TL_МаппингОплат.СоздатьМенеджерЗаписи();
			Менеджер.ОбразецИмени = Выборка.ОбразецИмени;
			Менеджер.Прочитать();
			Если Не Менеджер.Выбран() Тогда Продолжить; КонецЕсли;
			Менеджер.Склад = ЦелевойСклад;
			Менеджер.Записать();
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("TL_Настройки",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось дозаполнить склады в маппинге: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Найти склад по имени с обработкой пустого результата.
//
Функция НайтиСкладПоИмени(Имя)
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Справочники.Склады.ПустаяСсылка();
	КонецЕсли;
	Ссылка = Справочники.Склады.НайтиПоНаименованию(Имя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Возврат Справочники.Склады.ПустаяСсылка();
КонецФункции

// Дописать запись в TL_МаппингОплат только если такого ОбразецИмени ещё нет.
// Это позволяет переинициализации не затирать ручную правку бухгалтера.
//
Процедура УстановитьМаппингОплатыПоУмолчанию(ОбразецИмени, Канал, Склад = Неопределено)

	Попытка
		Менеджер = РегистрыСведений.TL_МаппингОплат.СоздатьМенеджерЗаписи();
		Менеджер.ОбразецИмени = ОбразецИмени;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() Тогда
			Возврат; // уже есть, не трогаем
		КонецЕсли;

		Запись = РегистрыСведений.TL_МаппингОплат.СоздатьМенеджерЗаписи();
		Запись.ОбразецИмени = ОбразецИмени;
		Запись.КаналОплаты = Канал;
		Если Склад <> Неопределено Тогда
			Запись.Склад = Склад;
		КонецЕсли;
		Запись.Записать();
	Исключение
		// Регистр ещё не создан в БД — это нормально при первом запуске до UpdateDBCfg
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
