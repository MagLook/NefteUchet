&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Заголовок") И ЗначениеЗаполнено(Параметры.Заголовок) Тогда
		ЭтаФорма.Заголовок = Параметры.Заголовок;
	КонецЕсли;

	ТипДокумента = "";
	Если Параметры.Свойство("ТипДокумента") Тогда
		ТипДокумента = Параметры.ТипДокумента;
	КонецЕсли;

	ДанныеJSON = "";
	Если Параметры.Свойство("ДанныеJSON") Тогда
		ДанныеJSON = Параметры.ДанныеJSON;
	КонецЕсли;

	// Опциональный КлючБазовый — для подгрузки уже созданных документов БП
	КлючБазовый = "";
	Если Параметры.Свойство("КлючБазовый") Тогда
		КлючБазовый = Параметры.КлючБазовый;
	КонецЕсли;

	// Собрать СвязанныеДокументы (с UUID для кнопок «📂 открыть»)
	СвязанныеДокументы = Неопределено;
	Если ЗначениеЗаполнено(КлючБазовый) Тогда
		СвязанныеДокументы = СобратьСвязанныеДокументыНаСервере(КлючБазовый);
	КонецЕсли;

	// Сопутка/Общепит: ДанныеJSON это путь к JSON-файлу пакета смены
	ЭтоПутьКФайлу = ЗначениеЗаполнено(ДанныеJSON)
		И СтрНайти(ДанныеJSON, ".json") > 0
		И СтрНайти(ДанныеJSON, "\") > 0;

	Если ТипДокумента = "ГотовыйHTML" И Параметры.Свойство("ГотовыйHTML")
			И ЗначениеЗаполнено(Параметры.ГотовыйHTML) Тогда
		// HTML уже собран на стороне вызывающей формы (например ТТН из БД)
		HTMLСодержимое = Параметры.ГотовыйHTML;
	ИначеЕсли (ТипДокумента = "Сопутка" Или ТипДокумента = "Общепит" Или ЭтоПутьКФайлу)
			И ЗначениеЗаполнено(ДанныеJSON) Тогда
		HTMLСодержимое = TL_HTMLГенератор.СформироватьДеталиПакетаСмены(ДанныеJSON, Параметры.Заголовок);
	ИначеЕсли ТипДокумента = "Смена" И ЗначениеЗаполнено(ДанныеJSON) Тогда
		HTMLСодержимое = TL_HTMLГенератор.СформироватьДеталиСмены(
			ДанныеJSON, Параметры.Заголовок, СвязанныеДокументы);
	ИначеЕсли ТипДокумента = "ТТН" И ЗначениеЗаполнено(ДанныеJSON) Тогда
		HTMLСодержимое = TL_HTMLГенератор.СформироватьДеталиТТН(
			ДанныеJSON, Параметры.Заголовок, СвязанныеДокументы);
	ИначеЕсли ТипДокумента = "ОтчётОшибок" Тогда
		// Подробный отчёт ошибок + текущий лог в одной странице.
		// МоментСессии — фильтр: показываем ошибки только с момента последнего «Обновить»
		ТекстЛогаПараметр = "";
		Если Параметры.Свойство("ТекстЛога") Тогда
			ТекстЛогаПараметр = СокрЛП(Параметры.ТекстЛога);
		КонецЕсли;
		МоментОт = Неопределено;
		Если Параметры.Свойство("МоментСессии") И ЗначениеЗаполнено(Параметры.МоментСессии) Тогда
			МоментОт = Параметры.МоментСессии;
		КонецЕсли;
		HTMLСодержимое = TL_HTMLГенератор.СформироватьПолноэкранныйОтчётОшибокИЛог(
			ТекстЛогаПараметр, МоментОт);
	ИначеЕсли ТипДокумента = "Помощь" Тогда
		// Встроенная помощь: оглавление либо конкретная статья по ключу
		Ключ = "";
		Если Параметры.Свойство("КлючПомощи") Тогда
			Ключ = СокрЛП(Параметры.КлючПомощи);
		КонецЕсли;
		Если ПустаяСтрока(Ключ) Тогда
			HTMLСодержимое = TL_HTMLГенератор.СформироватьОглавлениеПомощи();
		Иначе
			HTMLСодержимое = TL_HTMLГенератор.СформироватьСтатьюПомощи(Ключ);
		КонецЕсли;
	Иначе
		HTMLСодержимое = "<!DOCTYPE html><html><body><p>Нет данных</p></body></html>";
	КонецЕсли;

КонецПроцедуры

// Обработчик кликов в HTML-поле — навигация между статьями помощи.
// Срабатывает при клике по ссылкам с data-action="help|<ключ>" в оглавлении.
//
&НаКлиенте
Процедура HTMLПолеПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Element = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Действие = "";
	Попытка Действие = ДанныеСобытия.Element.getAttribute("data-action"); Исключение КонецПопытки;
	Если Действие = Неопределено Тогда Действие = ""; КонецЕсли;

	Если СтрНачинаетсяС(Действие, "help|") Тогда
		СтандартнаяОбработка = Ложь;
		Ключ = Сред(Действие, 6);
		Если Ключ = "оглавление" ИЛИ ПустаяСтрока(Ключ) Тогда
			ПоказатьОглавлениеПомощиНаСервере();
		Иначе
			ПоказатьСтатьюПомощиНаСервере(Ключ);
		КонецЕсли;
	ИначеЕсли СтрНачинаетсяС(Действие, "open|") Тогда
		// open|<ВидДокумента>|<UUID> — открыть документ БП
		СтандартнаяОбработка = Ложь;
		Парам = Сред(Действие, 6);
		Части = СтрРазделить(Парам, "|");
		Если Части.Количество() >= 2 Тогда
			Попытка
				Ссылка = ПолучитьСсылкуНаДокументНаСервере(Части[0], Части[1]);
				Если ЗначениеЗаполнено(Ссылка) Тогда
					ОткрытьЗначение(Ссылка);
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПоказатьОглавлениеПомощиНаСервере()
	HTMLСодержимое = TL_HTMLГенератор.СформироватьОглавлениеПомощи();
КонецПроцедуры

&НаСервере
Процедура ПоказатьСтатьюПомощиНаСервере(Ключ)
	HTMLСодержимое = TL_HTMLГенератор.СформироватьСтатьюПомощи(Ключ);
КонецПроцедуры

// Собрать связанные документы по базовому ключу (с UUID для «📂 открыть»).
//
&НаСервереБезКонтекста
Функция СобратьСвязанныеДокументыНаСервере(КлючБазовый)
	Связанные = Новый Массив;
	СписокДок = TL_РегистрСтатусов.ПолучитьДокументыПоБазовомуКлючу(КлючБазовый);
	// Базовый ключ (ОРП для смены) сортируем первым
	Для Каждого ИнфоДок Из СписокДок Цикл
		ЭтоБазовый = (ИнфоДок.Ключ = КлючБазовый);

		// Тип документа по подключу
		КанальныйСклад = ""; // АЗС → Что
		Если ЭтоБазовый Тогда
			// Базовый = главный документ пакета (ОРП для смены или ПТУ для ТТН)
			Если СтрНайти(КлючБазовый, "|СМЕНА|") > 0 Тогда
				ВидДок = "ОРП";
			Иначе
				ВидДок = "ПТУ";
			КонецЕсли;
		ИначеЕсли СтрНайти(ИнфоДок.Ключ, "|voucher") > 0 Тогда
			ВидДок = "Перемещение"; КанальныйСклад = "АЗС → Талоны";
		ИначеЕсли СтрНайти(ИнфоДок.Ключ, "|cards") > 0 Тогда
			ВидДок = "Перемещение"; КанальныйСклад = "АЗС → Карты";
		ИначеЕсли СтрНайти(ИнфоДок.Ключ, "|online") > 0 Тогда
			ВидДок = "Перемещение"; КанальныйСклад = "АЗС → ЯНДЕКС";
		ИначеЕсли СтрНайти(ИнфоДок.Ключ, "|ledger") > 0 Тогда
			ВидДок = "Перемещение"; КанальныйСклад = "АЗС → Ведомости";
		ИначеЕсли СтрНайти(ИнфоДок.Ключ, "|ПЕРЕМ") > 0 Тогда
			ВидДок = "Перемещение"; КанальныйСклад = "Осн.склад → АЗС";
		ИначеЕсли СтрНайти(ИнфоДок.Ключ, "|КОМПЛ") > 0 Тогда
			ВидДок = "Комплектация"; КанальныйСклад = "тонны → литры";
		ИначеЕсли СтрНайти(ИнфоДок.Ключ, "|ПКО") > 0 Тогда
			ВидДок = "ПКО"; КанальныйСклад = "наличная выручка";
		ИначеЕсли СтрНайти(ИнфоДок.Ключ, "|СПИСАНИЕ") > 0 Тогда
			ВидДок = "Списание"; КанальныйСклад = "Прочие (writeoff_fuel)";
		Иначе
			ВидДок = "?"; КанальныйСклад = ИнфоДок.Ключ;
		КонецЕсли;

		СвязДок = Новый Структура("ТипДокумента, Описание, Статус, UUID, ВидДокумента, Маршрут");
		СвязДок.ТипДокумента = ВидДок;
		СвязДок.Маршрут = КанальныйСклад;
		// Описание = номер документа без типа («ГИ0Г-002793»), без «Перемещение товаров, материалов»
		Если ЗначениеЗаполнено(ИнфоДок.Ссылка) Тогда
			Попытка
				НомДок = СокрЛП(ИнфоДок.Ссылка.Номер);
				ДатаДок = ИнфоДок.Ссылка.Дата;
				СвязДок.Описание = "№" + НомДок + " от " + Формат(ДатаДок, "ДФ='dd.MM.yyyy'");
			Исключение
				СвязДок.Описание = Строка(ИнфоДок.Ссылка);
			КонецПопытки;
		Иначе
			СвязДок.Описание = "(не создан)";
		КонецЕсли;
		СвязДок.Статус = ИнфоДок.Статус;
		Если ЗначениеЗаполнено(ИнфоДок.Ссылка) Тогда
			СвязДок.UUID = XMLСтрока(ИнфоДок.Ссылка.УникальныйИдентификатор());
			СвязДок.ВидДокумента = ВидДок;
		Иначе
			СвязДок.UUID = "";
			СвязДок.ВидДокумента = "";
		КонецЕсли;
		Связанные.Добавить(СвязДок);
	КонецЦикла;
	// Сортировка: ОРП/ПТУ первыми, затем Перемещения по маршруту, затем ПКО, Комплектация, Списание
	Возврат Связанные;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаДокументНаСервере(Вид, UUID)
	Менеджеры = Новый Соответствие;
	Менеджеры.Вставить("Перемещение",   Документы.ПеремещениеТоваров);
	Менеджеры.Вставить("Комплектация",  Документы.КомплектацияНоменклатуры);
	Менеджеры.Вставить("ОРП",           Документы.ОтчетОРозничныхПродажах);
	Менеджеры.Вставить("ПКО",           Документы.ПриходныйКассовыйОрдер);
	Менеджеры.Вставить("Списание",      Документы.СписаниеТоваров);
	Менеджеры.Вставить("ПТУ",           Документы.ПоступлениеТоваровУслуг);
	Менеджеры.Вставить("Инвентаризация", Документы.ИнвентаризацияТоваровНаСкладе);
	Менеджеры.Вставить("Оприходование",  Документы.ОприходованиеТоваров);
	Менеджеры.Вставить("ВозвратПоставщику", Документы.ВозвратТоваровПоставщику);
	М = Менеджеры.Получить(Вид);
	Если М = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Попытка
		Возврат М.ПолучитьСсылку(Новый УникальныйИдентификатор(UUID));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции
