////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_Настройки
// Расширение ElsyPlus Ledger v4 для 1С:БП 3.0
// Контекст: Сервер, Экспорт
//
// Единый модуль настроек И маппинга (заменяет TL_Настройки + TL_Маппинг).
// Все данные хранятся в регистре TL_Настройки (flat key-value).
//
// Ключи маппинга (примеры):
//   Станция_5_Склад         = "АКЗС Витебский"
//   Станция_5_ВремяЗакрытия = "00:00"
//   Топливо_2_Тонны         = "АИ-92(т)"
//   Топливо_2_Литры         = "АИ-92 (л)"
//   Топливо_2_Плотность     = "0.738"
//   Оплата_cards_Склад      = "Карты"
//   Оплата_cards_ТребуетПеремещения = "Да"
//
// Каждая функция маппинга: регистр -> fallback НайтиПоНаименованию.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Получить строковое значение настройки.
//
// Параметры:
//   Ключ                 - Строка - ключ настройки
//   ЗначениеПоУмолчанию  - Строка - если настройка не найдена
//
// Возвращаемое значение:
//   Строка
//
Функция ПолучитьЗначение(Ключ, ЗначениеПоУмолчанию = "") Экспорт

	// Попытка чтения из регистра TL_Настройки
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	TL_Настройки.Значение КАК Значение
			|ИЗ
			|	РегистрСведений.TL_Настройки КАК TL_Настройки
			|ГДЕ
			|	TL_Настройки.Ключ = &Ключ";

		Запрос.УстановитьПараметр("Ключ", Ключ);
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Значение) Тогда
			Возврат Выборка.Значение;
		КонецЕсли;
	Исключение
		// Регистр TL_Настройки не существует — fallback ниже
	КонецПопытки;

	// Fallback: ХранилищеОбщихНастроек (обратная совместимость)
	Попытка
		Зн = ХранилищеОбщихНастроек.Загрузить("TL_" + Ключ);
		Если Зн <> Неопределено И ЗначениеЗаполнено(Зн) Тогда
			Возврат Строка(Зн);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Получить числовое значение настройки.
//
Функция ПолучитьЧисло(Ключ, ЗначениеПоУмолчанию = 0) Экспорт

	СтроковоеЗначение = ПолучитьЗначение(Ключ, XMLСтрока(ЗначениеПоУмолчанию));

	Попытка
		Возврат Число(СтроковоеЗначение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

// Установить значение настройки.
//
// Параметры:
//   Ключ      - Строка
//   Значение  - Строка
//   Описание  - Строка (необязательно)
//
Процедура УстановитьЗначение(Ключ, Значение, Описание = "") Экспорт

	Попытка
		МенеджерЗаписи = РегистрыСведений.TL_Настройки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Ключ = Ключ;
		МенеджерЗаписи.Прочитать();

		МенеджерЗаписи.Ключ = Ключ;
		МенеджерЗаписи.Значение = Значение;

		Если Не ПустаяСтрока(Описание) Тогда
			МенеджерЗаписи.Описание = Описание;
		КонецЕсли;

		МенеджерЗаписи.Записать();
	Исключение
		// Регистр не существует — пишем в ХранилищеОбщихНастроек
		Попытка
			ХранилищеОбщихНастроек.Сохранить("TL_" + Ключ, , Значение);
		Исключение
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

// Установить значение в регистр TL_Настройки ТОЛЬКО если ключа ещё нет.
// Используется в идемпотентном «дополнении» настроек: ручные правки бухгалтера
// не перетираются, только пустые места заполняются дефолтами.
//
// Параметры:
//   Ключ      - Строка - ключ настройки
//   Значение  - Строка - значение по умолчанию
//   Описание  - Строка - человеко-читаемое описание (для подсказок в форме)
//
// Возвращаемое значение:
//   Булево — Истина, если запись была создана (значение действительно установлено).
//
Функция УстановитьЗначениеЕслиНет(Ключ, Значение, Описание = "") Экспорт

	Попытка
		МЗ = РегистрыСведений.TL_Настройки.СоздатьМенеджерЗаписи();
		МЗ.Ключ = Ключ;
		МЗ.Прочитать();
		Если МЗ.Выбран() И ЗначениеЗаполнено(МЗ.Значение) Тогда
			Возврат Ложь; // уже есть осмысленное значение — не трогаем
		КонецЕсли;

		МЗ.Ключ = Ключ;
		МЗ.Значение = Значение;
		Если Не ПустаяСтрока(Описание) Тогда
			МЗ.Описание = Описание;
		КонецЕсли;
		МЗ.Записать();
		Возврат Истина;
	Исключение
		// Регистр не создан в БД — норма при первом запуске до UpdateDBCfg
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Получить время проведения документа (часы и минуты) из настроек.
// Ключи: ВремяДок_СменныйОтчёт, ВремяДок_ПеремещениеТТН, ВремяДок_Комплектация, ВремяДок_ПеремещениеКаналов
//
// Параметры:
//   ТипДокумента - Строка - ключ типа документа
//
// Возвращаемое значение:
//   Структура("Часы, Минуты") - время для установки в дату документа
//
Функция ПолучитьВремяДокумента(ТипДокумента) Экспорт

	ВремяПоУмолчанию = Новый Соответствие;
	ВремяПоУмолчанию.Вставить("СменныйОтчёт", "23:50");
	ВремяПоУмолчанию.Вставить("ПеремещениеТТН", "11:00");
	ВремяПоУмолчанию.Вставить("Комплектация", "13:00");
	ВремяПоУмолчанию.Вставить("ПеремещениеКаналов", "23:50");

	Умолчание = ВремяПоУмолчанию.Получить(ТипДокумента);
	Если Умолчание = Неопределено Тогда
		Умолчание = "12:00";
	КонецЕсли;

	ВремяСтр = ПолучитьЗначение("ВремяДок_" + ТипДокумента, Умолчание);

	Попытка
		ПозДвоеточия = СтрНайти(ВремяСтр, ":");
		Если ПозДвоеточия > 0 Тогда
			Часы = Число(Лев(ВремяСтр, ПозДвоеточия - 1));
			Минуты = Число(Сред(ВремяСтр, ПозДвоеточия + 1));
		Иначе
			Часы = Число(ВремяСтр);
			Минуты = 0;
		КонецЕсли;
	Исключение
		Часы = 12;
		Минуты = 0;
	КонецПопытки;

	Возврат Новый Структура("Часы, Минуты", Часы, Минуты);

КонецФункции

// Применить время документа к дате (НачалоДня + часы + минуты).
//
Функция ПрименитьВремяДокумента(Дата, ТипДокумента) Экспорт

	Время = ПолучитьВремяДокумента(ТипДокумента);
	Возврат НачалоДня(Дата) + Время.Часы * 3600 + Время.Минуты * 60;

КонецФункции

// Получить организацию из настроек.
// Ищет по наименованию из настройки "Организация".
// Fallback: первая неудалённая организация.
//
// Возвращаемое значение:
//   СправочникСсылка.Организации
//
Функция ПолучитьОрганизацию() Экспорт

	Наименование = ПолучитьЗначение("Организация", "");

	Если ЗначениеЗаполнено(Наименование) Тогда
		Результат = Справочники.Организации.НайтиПоНаименованию(Наименование, Истина);
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// Fallback: первая неудалённая
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ссылка
		|ИЗ
		|	Справочник.Организации
		|ГДЕ
		|	НЕ ПометкаУдаления";

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

// Получить основной склад из настроек.
// Fallback: первый неудалённый склад.
//
// Возвращаемое значение:
//   СправочникСсылка.Склады
//
Функция ПолучитьОсновнойСклад() Экспорт

	Наименование = ПолучитьЗначение("ОсновнойСклад", "");

	Если ЗначениеЗаполнено(Наименование) Тогда
		Результат = Справочники.Склады.НайтиПоНаименованию(Наименование, Истина);
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// Fallback: первый неудалённый
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ссылка
		|ИЗ
		|	Справочник.Склады
		|ГДЕ
		|	НЕ ПометкаУдаления";

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Склады.ПустаяСсылка();

КонецФункции

// Получить все известные станции из регистра (динамический скан).
// Возвращает в т.ч. станции без настроенного склада — у них Склад будет пустой,
// но КодСистемы и Наименование всё равно нужны для опроса API.
//
// Возвращаемое значение:
//   Массив из Структура("Код, Наименование, Склад, ВремяЗакрытия, КодСистемы")
//
Функция ПолучитьВсеСтанции() Экспорт

	Результат = Новый Массив;

	Попытка
		// Сначала собираем уникальные коды станций из всех ключей "Станция_X_*"
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ Ключ
			|ИЗ РегистрСведений.TL_Настройки
			|ГДЕ Ключ ПОДОБНО ""Станция_%""
			|УПОРЯДОЧИТЬ ПО Ключ";
		Выборка = Запрос.Выполнить().Выбрать();
		УникальныеКоды = Новый Соответствие; // КодСтр → Истина
		Пока Выборка.Следующий() Цикл
			КлючБезПрефикса = СтрЗаменить(Выборка.Ключ, "Станция_", "");
			ПозПодчёрк = СтрНайти(КлючБезПрефикса, "_");
			Если ПозПодчёрк > 0 Тогда
				КодСтр = Лев(КлючБезПрефикса, ПозПодчёрк - 1);
				Попытка
					Если Число(КодСтр) > 0 Тогда
						УникальныеКоды.Вставить(КодСтр, Истина);
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;

		ГлобКодСистемы = ПолучитьЧисло("КодСистемы", 65);
		Для Каждого КЗ Из УникальныеКоды Цикл
			КодСтр = КЗ.Ключ;
			НаимСклада = ПолучитьЗначение("Станция_" + КодСтр + "_Склад", "");
			СкладСсылка = Справочники.Склады.ПустаяСсылка();
			Если ЗначениеЗаполнено(НаимСклада) Тогда
				СкладСсылка = Справочники.Склады.НайтиПоНаименованию(НаимСклада, Истина);
			КонецЕсли;
			Результат.Добавить(Новый Структура("Код, Наименование, Склад, ВремяЗакрытия, КодСистемы",
				КодСтр,
				ПолучитьЗначение("Станция_" + КодСтр + "_Наименование", "Станция " + КодСтр),
				?(ЗначениеЗаполнено(СкладСсылка), СкладСсылка, НаимСклада),
				ПолучитьЗначение("Станция_" + КодСтр + "_ВремяЗакрытия", "00:00"),
				ПолучитьЧисло("Станция_" + КодСтр + "_КодСистемы", ГлобКодСистемы)));
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Получить КодСистемы для конкретной станции.
// Если не задан — fallback на глобальный КодСистемы (65 для ГИГ).
//
Функция ПолучитьКодСистемыСтанции(КодСтанции) Экспорт

	КодСтр = XMLСтрока(КодСтанции);
	Возврат ПолучитьЧисло("Станция_" + КодСтр + "_КодСистемы", ПолучитьЧисло("КодСистемы", 65));

КонецФункции

// Получить массив уникальных кодов сетей из всех станций.
// Используется для авторизации по каждой сети при загрузке "Все станции".
//
Функция ПолучитьУникальныеСети() Экспорт

	СетиСоответствие = Новый Соответствие;
	ВсеСтанции = ПолучитьВсеСтанции();

	Для Каждого Ст Из ВсеСтанции Цикл
		СетиСоответствие.Вставить(Ст.КодСистемы, Истина);
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого КЗ Из СетиСоответствие Цикл
		Результат.Добавить(КЗ.Ключ);
	КонецЦикла;

	// Fallback: если станций нет, вернуть глобальную сеть
	Если Результат.Количество() = 0 Тогда
		Результат.Добавить(ПолучитьЧисло("КодСистемы", 65));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Получить список всех сетей для опроса в API.
// Сюда входят: глобальная (КодСистемы), коды из настроенных станций
// и доп. сети из ключа "ДополнительныеСети" (через запятую, например "65,15").
//
// Возвращаемое значение:
//   Массив из Число
//
Функция ПолучитьВсеСетиДляОпроса() Экспорт

	НаборСетей = Новый Соответствие;

	// 1) Глобальная
	НаборСетей.Вставить(ПолучитьЧисло("КодСистемы", 65), Истина);

	// 2) Из станций
	Для Каждого Ст Из ПолучитьВсеСтанции() Цикл
		Если Ст.КодСистемы > 0 Тогда
			НаборСетей.Вставить(Ст.КодСистемы, Истина);
		КонецЕсли;
	КонецЦикла;

	// 3) Из ключа "ДополнительныеСети" (например "15, 100")
	Доп = ПолучитьЗначение("ДополнительныеСети", "");
	Если ЗначениеЗаполнено(Доп) Тогда
		Для Каждого Кусок Из СтрРазделить(Доп, ",;", Ложь) Цикл
			Попытка
				КодЧисло = Число(СокрЛП(Кусок));
				Если КодЧисло > 0 Тогда
					НаборСетей.Вставить(КодЧисло, Истина);
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого КЗ Из НаборСетей Цикл
		Результат.Добавить(КЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Опросить STS API по всем известным сетям через /v1/points
// и вернуть полный список ОС (станций) с привязкой к сети.
//
// Параметры:
//   URLСервера - Строка
//   Логин      - Строка
//   Пароль     - Строка
//
// Возвращаемое значение:
//   Структура("Станции, Ошибки"):
//     Станции — Массив из Структура (Код, Наименование, Адрес, КодСистемы)
//     Ошибки  — Массив из Строка
//
Функция ОпроситьВсеСетиИзAPI(URLСервера, Логин, Пароль) Экспорт

	Результат = Новый Структура("Станции, Ошибки", Новый Массив, Новый Массив);

	Для Каждого КодСистемы Из ПолучитьВсеСетиДляОпроса() Цикл
		Попытка
			Токен = TL_ApiКлиент.Авторизация(URLСервера, Логин, Пароль, КодСистемы);
		Исключение
			Результат.Ошибки.Добавить("Сеть " + XMLСтрока(КодСистемы) + ": авторизация — " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		Если Не ЗначениеЗаполнено(Токен) Тогда
			Результат.Ошибки.Добавить("Сеть " + XMLСтрока(КодСистемы) + ": пустой токен");
			Продолжить;
		КонецЕсли;

		Попытка
			ОС = TL_ApiКлиент.ПолучитьСписокОС(URLСервера, Токен, КодСистемы);
		Исключение
			Результат.Ошибки.Добавить("Сеть " + XMLСтрока(КодСистемы) + ": /v1/points — " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Для Каждого Стр Из ОС Цикл
			Результат.Станции.Добавить(Стр);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Получить ставку НДС из настроек (по умолчанию 22%).
// Читает ключ «СтавкаНДС» из регистра: "22" → НДС22, "20" → НДС20.
//
// Возвращаемое значение:
//   ПеречислениеСсылка.СтавкиНДС или Неопределено
//
Функция ПолучитьСтавкуНДС() Экспорт

	СтавкаСтр = ПолучитьЗначение("СтавкаНДС", "22");

	Если СтавкаСтр = "20" Тогда
		Попытка Возврат Перечисления.СтавкиНДС.НДС20; Исключение КонецПопытки;
	КонецЕсли;

	Попытка Возврат Перечисления.СтавкиНДС.НДС22; Исключение КонецПопытки;
	Попытка Возврат Перечисления.СтавкиНДС.НДС20; Исключение КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Сформировать унифицированное имя станции для UI.
// Формат: "<Тип> <Метка> (<Код>)", например "АКЗС Витебский (5)".
// Тип: АКЗС для станций 1-6, АЗС для остальных.
// Метка: краткое имя из словаря по коду; если кода в словаре нет —
// возвращаем fallback (имя из API + код в скобках).
//
// Параметры:
//   КодСтанции - Число
//   ИмяApi     - Строка - имя из API (используется как fallback)
//
// Возвращаемое значение:
//   Строка
//
Функция ОтформатироватьИмяСтанции(КодСтанции, ИмяApi = "") Экспорт

	Код = ?(ТипЗнч(КодСтанции) = Тип("Число"), КодСтанции, 0);
	Попытка Код = Число(КодСтанции); Исключение КонецПопытки;

	Метка = "";
	Тип   = "";

	Если     Код = 1   Тогда Метка = "Непокоренных";   Тип = "АКЗС";
	ИначеЕсли Код = 2   Тогда Метка = "Выборг";          Тип = "АКЗС";
	ИначеЕсли Код = 3   Тогда Метка = "Кудрово";         Тип = "АКЗС";
	ИначеЕсли Код = 4   Тогда Метка = "Первомайское";    Тип = "АКЗС";
	ИначеЕсли Код = 5   Тогда Метка = "Витебский";       Тип = "АКЗС";
	ИначеЕсли Код = 6   Тогда Метка = "Колпино";         Тип = "АКЗС";
	ИначеЕсли Код = 8   Тогда Метка = "Светогорск";      Тип = "АЗС";
	ИначеЕсли Код = 205 Тогда Метка = "Брусничное";      Тип = "АЗС";
	ИначеЕсли Код = 207 Тогда Метка = "Выборг";          Тип = "АЗС";
	ИначеЕсли Код = 208 Тогда Метка = "Выборг";          Тип = "АЗС";
	ИначеЕсли Код = 209 Тогда Метка = "Светогорск";      Тип = "АЗС";
	ИначеЕсли Код = 210 Тогда Метка = "Приморск";        Тип = "АЗС";
	КонецЕсли;

	Если ЗначениеЗаполнено(Метка) Тогда
		Возврат Тип + " " + Метка + " (" + XMLСтрока(Код) + ")";
	КонецЕсли;

	// Fallback — если станция в словаре отсутствует
	Если ЗначениеЗаполнено(ИмяApi) Тогда
		Возврат СокрЛП(Строка(ИмяApi)) + " (" + XMLСтрока(Код) + ")";
	КонецЕсли;
	Возврат "Станция " + XMLСтрока(Код);

КонецФункции

// Сформировать план унификации имён складов АЗС.
// Возвращает ТаблицуЗначений со структурой:
//   Код          - Число
//   СкладСсылка  - СправочникСсылка.Склады или ПустаяСсылка
//   ТекущееИмя   - Строка
//   ЦелевоеИмя   - Строка (по словарю ОтформатироватьИмяСтанции)
//   Применить    - Булево (Истина если требуется переименование, Ложь — уже корректно)
//   Конфликт     - Строка (заполнено если есть другой склад с таким именем)
//
Функция ПолучитьПланУнификацииСкладовАЗС() Экспорт

	План = Новый ТаблицаЗначений;
	План.Колонки.Добавить("Код",          Новый ОписаниеТипов("Число"));
	План.Колонки.Добавить("СкладСсылка");
	План.Колонки.Добавить("ТекущееИмя",   Новый ОписаниеТипов("Строка"));
	План.Колонки.Добавить("ЦелевоеИмя",   Новый ОписаниеТипов("Строка"));
	План.Колонки.Добавить("Применить",    Новый ОписаниеТипов("Булево"));
	План.Колонки.Добавить("Конфликт",     Новый ОписаниеТипов("Строка"));

	Коды = Новый Массив;
	Коды.Добавить(1); Коды.Добавить(2); Коды.Добавить(3); Коды.Добавить(4);
	Коды.Добавить(5); Коды.Добавить(6); Коды.Добавить(8); Коды.Добавить(205);
	Коды.Добавить(207); Коды.Добавить(208); Коды.Добавить(209); Коды.Добавить(210);

	Для Каждого Код Из Коды Цикл
		Стр = План.Добавить();
		Стр.Код         = Код;
		Стр.ЦелевоеИмя  = ОтформатироватьИмяСтанции(Код, "");

		Склад = НайтиСкладСтанции(Код);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			Стр.ТекущееИмя = "(склад не привязан)";
			Стр.Применить  = Ложь;
			Продолжить;
		КонецЕсли;
		Стр.СкладСсылка = Склад;
		Стр.ТекущееИмя  = Строка(Склад);

		Если Стр.ТекущееИмя = Стр.ЦелевоеИмя Тогда
			Стр.Применить = Ложь;
			Продолжить;
		КонецЕсли;

		// Проверка конфликта: существует ли уже другой склад с целевым именем
		Конфл = Справочники.Склады.НайтиПоНаименованию(Стр.ЦелевоеИмя, Истина);
		Если ЗначениеЗаполнено(Конфл) И Конфл <> Склад Тогда
			Стр.Конфликт   = "Имя «" + Стр.ЦелевоеИмя + "» уже занято другим складом";
			Стр.Применить  = Ложь;
		Иначе
			Стр.Применить  = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат План;

КонецФункции

// Применить унификацию имён складов АЗС по плану.
// Принимает массив строковых пар "Код=ЦелевоеИмя" — переименовывает.
// Пишет в журнал регистрации (событие TL_УнификацияСкладов).
//
// Параметры:
//   ПарыКодИмя - Массив строк формата "5=АКЗС Витебский (5)" или Соответствие(Код→Имя)
//
// Возвращаемое значение:
//   Структура("Применено, Ошибки") где
//     Применено - Массив строк "Код: было → стало"
//     Ошибки    - Массив строк
//
Функция ПрименитьУнификациюСкладовАЗС(ПарыКодИмя) Экспорт

	Результат = Новый Структура("Применено, Ошибки", Новый Массив, Новый Массив);

	Соотв = Новый Соответствие;
	Если ТипЗнч(ПарыКодИмя) = Тип("Массив") Тогда
		Для Каждого Стр Из ПарыКодИмя Цикл
			Поз = СтрНайти(Стр, "=");
			Если Поз > 0 Тогда
				Попытка
					Соотв.Вставить(Число(Лев(Стр, Поз - 1)), СокрЛП(Сред(Стр, Поз + 1)));
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПарыКодИмя) = Тип("Соответствие") Тогда
		Соотв = ПарыКодИмя;
	КонецЕсли;

	Для Каждого КЗ Из Соотв Цикл
		Код = КЗ.Ключ;
		Целевое = КЗ.Значение;
		Если Не ЗначениеЗаполнено(Целевое) Тогда
			Продолжить;
		КонецЕсли;

		Склад = НайтиСкладСтанции(Код);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			Результат.Ошибки.Добавить("ст." + Строка(Код) + ": склад не привязан");
			Продолжить;
		КонецЕсли;

		Текущее = Строка(Склад);
		Если Текущее = Целевое Тогда
			Продолжить;
		КонецЕсли;

		// Проверка конфликта
		Конфл = Справочники.Склады.НайтиПоНаименованию(Целевое, Истина);
		Если ЗначениеЗаполнено(Конфл) И Конфл <> Склад Тогда
			Результат.Ошибки.Добавить("ст." + Строка(Код) + ": имя «" + Целевое + "» уже занято");
			Продолжить;
		КонецЕсли;

		Попытка
			Об = Склад.ПолучитьОбъект();
			Об.Наименование = Целевое;
			Об.Записать();
			Результат.Применено.Добавить("ст." + Строка(Код) + ": «" + Текущее + "» → «" + Целевое + "»");
			ЗаписьЖурналаРегистрации("TL_УнификацияСкладов",
				УровеньЖурналаРегистрации.Информация, , Склад,
				"Переименован склад АЗС: «" + Текущее + "» → «" + Целевое + "»");
		Исключение
			Результат.Ошибки.Добавить("ст." + Строка(Код) + ": ошибка записи — " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Маппинг

// ============================================================================
// ДЕЛЕГИРОВАНИЕ В TL_Маппинг (справочники v4)
// Каждая функция сначала пытается TL_Маппинг (справочники TL_АЗС,
// TL_ВидыТоплива, TL_ВидыОплат). Если справочники пусты или не существуют —
// fallback на key-value из регистра TL_Настройки.
// ============================================================================

// Найти склад АЗС по коду станции.
// Приоритет: GUID (Станция_X_СкладGUID) → имя (Станция_X_Склад) → справочник TL_АЗС с масками.
//
// Хранение GUID, а не имени, позволяет бухгалтеру переименовать склад
// в справочнике без потери связи с расширением.
//
Функция НайтиСкладСтанции(КодСтанции) Экспорт

	КодСтр = XMLСтрока(КодСтанции);

	// 1. По GUID — самая надёжная связь.
	// ВАЖНО: ПолучитьСсылку() всегда возвращает ссылку, даже если объект удалён.
	// Поэтому проверяем существование через запрос (Пустая()/ПометкаУдаления
	// не поймает удалённый объект).
	GUIDСтр = ПолучитьЗначение("Станция_" + КодСтр + "_СкладGUID", "");
	Если ЗначениеЗаполнено(GUIDСтр) Тогда
		Попытка
			УникИд = Новый УникальныйИдентификатор(GUIDСтр);
			Склад = Справочники.Склады.ПолучитьСсылку(УникИд);
			Если ЗначениеЗаполнено(Склад) И Не Склад.Пустая() Тогда
				ЗапрПров = Новый Запрос;
				ЗапрПров.УстановитьПараметр("С", Склад);
				ЗапрПров.Текст = "ВЫБРАТЬ 1 ИЗ Справочник.Склады
					|ГДЕ Ссылка = &С И НЕ ПометкаУдаления";
				Если Не ЗапрПров.Выполнить().Пустой() Тогда
					Возврат Склад;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// 2. По имени (старый формат и обратная совместимость)
	НаимСклада = ПолучитьЗначение("Станция_" + КодСтр + "_Склад", "");
	Если ЗначениеЗаполнено(НаимСклада) Тогда
		Склад = Справочники.Склады.НайтиПоНаименованию(НаимСклада, Истина);
		Если ЗначениеЗаполнено(Склад) Тогда
			Возврат Склад;
		КонецЕсли;
	КонецЕсли;

	// 3. Через справочник TL_АЗС (делегат в TL_Маппинг, включая маски)
	Попытка
		Склад = TL_Маппинг.НайтиСкладСтанции(КодСтанции);
		Если ЗначениеЗаполнено(Склад) Тогда
			Возврат Склад;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Справочники.Склады.ПустаяСсылка();

КонецФункции

// Получить или создать склад АЗС: сначала ищет существующий склад
// (точное имя → эвристика по коду станции и типам АЗС/АГЗС/АКЗС),
// и только если ничего не нашёл — создаёт новый элемент.
//
// Параметры:
//   ИмяСклада  - Строка - имя из STS API ("АЗС №208")
//   КодСтанции - Число  - используется для эвристики и записи привязки
//
// Возвращаемое значение:
//   СправочникСсылка.Склады
//
Функция ПолучитьИлиСоздатьСкладАЗС(ИмяСклада, КодСтанции = 0) Экспорт

	Если Не ЗначениеЗаполнено(ИмяСклада) Тогда
		Возврат Справочники.Склады.ПустаяСсылка();
	КонецЕсли;

	// 1. Точное совпадение по имени
	Существующий = Справочники.Склады.НайтиПоНаименованию(ИмяСклада, Истина);
	Если ЗначениеЗаполнено(Существующий) Тогда
		// Сохраняем привязку — чтобы дальше ходило по GUID
		Если КодСтанции > 0 Тогда
			Попытка
				КодСтрВр = XMLСтрока(КодСтанции);
				УстановитьЗначение("Станция_" + КодСтрВр + "_СкладGUID",
					Строка(Существующий.УникальныйИдентификатор()),
					"GUID склада (auto-найден по имени)");
				УстановитьЗначение("Станция_" + КодСтрВр + "_Склад",
					ИмяСклада, "Имя склада (auto-найден по имени)");
			Исключение
			КонецПопытки;
		КонецЕсли;
		Возврат Существующий;
	КонецЕсли;

	// 2. Эвристика: код станции как ОТДЕЛЬНОЕ число в имени склада.
	// «АЗС 208», «АЗС №208», «АЗС 208 г.Выборг», «АГЗС №5», «АКЗС-5» и т.п.
	// НЕ ловит «АЗС 2080», «АЗС 12» при поиске «АЗС 2».
	// Для этого подбираем точные шаблоны с разделителями (пробел/конец/пунктуация).
	Если КодСтанции > 0 Тогда
		КодСтр = XMLСтрока(КодСтанции);
		Попытка
			Запрос = Новый Запрос;
			// Ровно "<префикс> <код>" в конце строки
			Запрос.УстановитьПараметр("М_АЗС_конец",       "АЗС " + КодСтр);
			Запрос.УстановитьПараметр("М_АЗС_номер_конец", "АЗС №" + КодСтр);
			Запрос.УстановитьПараметр("М_АГЗС_конец",      "АГЗС " + КодСтр);
			Запрос.УстановитьПараметр("М_АГЗС_номер_конец","АГЗС №" + КодСтр);
			Запрос.УстановитьПараметр("М_АКЗС_конец",      "АКЗС " + КодСтр);
			Запрос.УстановитьПараметр("М_АКЗС_номер_конец","АКЗС №" + КодСтр);
			// "<префикс> <код> <ещё что-то>" — пробел-разделитель
			Запрос.УстановитьПараметр("М_АЗС_прод",        "АЗС " + КодСтр + " %");
			Запрос.УстановитьПараметр("М_АЗС_номер_прод",  "АЗС №" + КодСтр + " %");
			Запрос.УстановитьПараметр("М_АГЗС_прод",       "АГЗС " + КодСтр + " %");
			Запрос.УстановитьПараметр("М_АГЗС_номер_прод", "АГЗС №" + КодСтр + " %");
			Запрос.УстановитьПараметр("М_АКЗС_прод",       "АКЗС " + КодСтр + " %");
			Запрос.УстановитьПараметр("М_АКЗС_номер_прод", "АКЗС №" + КодСтр + " %");
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 5
				|	Ссылка, Наименование
				|ИЗ
				|	Справочник.Склады
				|ГДЕ
				|	НЕ ПометкаУдаления
				|	И (Наименование ПОДОБНО &М_АЗС_конец
				|	   ИЛИ Наименование ПОДОБНО &М_АЗС_номер_конец
				|	   ИЛИ Наименование ПОДОБНО &М_АГЗС_конец
				|	   ИЛИ Наименование ПОДОБНО &М_АГЗС_номер_конец
				|	   ИЛИ Наименование ПОДОБНО &М_АКЗС_конец
				|	   ИЛИ Наименование ПОДОБНО &М_АКЗС_номер_конец
				|	   ИЛИ Наименование ПОДОБНО &М_АЗС_прод
				|	   ИЛИ Наименование ПОДОБНО &М_АЗС_номер_прод
				|	   ИЛИ Наименование ПОДОБНО &М_АГЗС_прод
				|	   ИЛИ Наименование ПОДОБНО &М_АГЗС_номер_прод
				|	   ИЛИ Наименование ПОДОБНО &М_АКЗС_прод
				|	   ИЛИ Наименование ПОДОБНО &М_АКЗС_номер_прод)
				|УПОРЯДОЧИТЬ ПО Наименование";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ЗаписьЖурналаРегистрации("TL_Настройки",
					УровеньЖурналаРегистрации.Информация, , ,
					"Найден существующий склад для станции " + КодСтр
					+ ": '" + Выборка.Наименование + "' (вместо создания нового '"
					+ ИмяСклада + "')");
				// Сохраняем привязку, чтобы при следующем поиске ходило по GUID,
				// а не делало эвристику заново (а она опасно медленна и не идемпотентна).
				Попытка
					УстановитьЗначение("Станция_" + КодСтр + "_СкладGUID",
						Строка(Выборка.Ссылка.УникальныйИдентификатор()),
						"GUID склада (auto-найден эвристикой)");
					УстановитьЗначение("Станция_" + КодСтр + "_Склад",
						Выборка.Наименование,
						"Имя склада (auto-найден эвристикой)");
				Исключение
				КонецПопытки;
				Возврат Выборка.Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// 3. Не нашли — создаём новый
	НовыйСклад = Справочники.Склады.СоздатьЭлемент();
	НовыйСклад.Наименование = ИмяСклада;

	// Тип склада — Оптовый (как у АКЗС Витебский в текущей рабочей схеме ГИГ).
	Попытка
		Если Метаданные.Справочники.Склады.Реквизиты.Найти("ТипСклада") <> Неопределено Тогда
			НовыйСклад.ТипСклада = Перечисления.ТипыСкладов.Оптовый;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Организация — из настроек
	Попытка
		Орг = ПолучитьОрганизацию();
		Если ЗначениеЗаполнено(Орг)
				И Метаданные.Справочники.Склады.Реквизиты.Найти("Организация") <> Неопределено Тогда
			НовыйСклад.Организация = Орг;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Ответственный — текущий пользователь
	Попытка
		Если Метаданные.Справочники.Склады.Реквизиты.Найти("Ответственный") <> Неопределено Тогда
			НовыйСклад.Ответственный = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя(), Истина);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		НовыйСклад.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("TL_Настройки",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось создать склад '" + ИмяСклада + "': " + ОписаниеОшибки());
		Возврат Справочники.Склады.ПустаяСсылка();
	КонецПопытки;

	ЗаписьЖурналаРегистрации("TL_Настройки",
		УровеньЖурналаРегистрации.Информация, , ,
		"Создан склад '" + ИмяСклада + "' для станции " + XMLСтрока(КодСтанции));

	// Записать привязку в регистр (GUID + имя для обратной совместимости)
	Если КодСтанции > 0 Тогда
		КодСтр = XMLСтрока(КодСтанции);
		УстановитьЗначение("Станция_" + КодСтр + "_СкладGUID",
			Строка(НовыйСклад.Ссылка.УникальныйИдентификатор()), "GUID склада (auto)");
		УстановитьЗначение("Станция_" + КодСтр + "_Склад",
			ИмяСклада, "Имя склада (auto)");
	КонецЕсли;

	Возврат НовыйСклад.Ссылка;

КонецФункции

// Нормализовать дату смены с учётом времени закрытия станции.
// Приоритет: TL_Маппинг (справочник TL_АЗС) → key-value.
//
Функция НормализоватьДатуСмены(ДатаСмены, КодСтанции) Экспорт

	// 1. Через TL_Маппинг (справочник TL_АЗС)
	Попытка
		Возврат TL_Маппинг.НормализоватьДатуСмены(ДатаСмены, КодСтанции);
	Исключение
	КонецПопытки;

	// 2. Fallback: key-value
	Если Не ЗначениеЗаполнено(ДатаСмены) Тогда
		Возврат ДатаСмены;
	КонецЕсли;

	КодСтр = XMLСтрока(КодСтанции);
	ВремяСтр = ПолучитьЗначение("Станция_" + КодСтр + "_ВремяЗакрытия", "00:00");

	Если ВремяСтр = "00:00" ИЛИ Не ЗначениеЗаполнено(ВремяСтр) Тогда
		Возврат НачалоДня(ДатаСмены);
	КонецЕсли;

	Попытка
		ЧасЗакрытия = Число(Лев(ВремяСтр, СтрНайти(ВремяСтр, ":") - 1));
	Исключение
		Возврат НачалоДня(ДатаСмены);
	КонецПопытки;

	Если ЧасЗакрытия = 0 Тогда
		Возврат НачалоДня(ДатаСмены);
	КонецЕсли;

	Если Час(ДатаСмены) < ЧасЗакрытия Тогда
		Возврат НачалоДня(ДатаСмены - 86400);
	КонецЕсли;

	Возврат НачалоДня(ДатаСмены);

КонецФункции

// Найти номенклатуру топлива по внешнему коду API.
// Приоритет: TL_Маппинг (справочник TL_ВидыТоплива + ТЧ по станциям) → key-value → хардкод.
//
Функция НайтиНоменклатуруТоплива(КодТоплива, Единица, КодСтанции = 0) Экспорт

	// 1. Через справочник TL_ВидыТоплива (делегат в TL_Маппинг)
	Попытка
		Номенклатура = TL_Маппинг.НайтиНоменклатуруТоплива(КодТоплива, Единица, КодСтанции);
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			Возврат Номенклатура;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// 2. Fallback: key-value регистр
	КодСтр = Строка(КодТоплива);
	СуффиксЕдиницы = ?(НРег(Единица) = "т", "Тонны", "Литры");
	НаимНоменклатуры = ПолучитьЗначение("Топливо_" + КодСтр + "_" + СуффиксЕдиницы, "");
	Если ЗначениеЗаполнено(НаимНоменклатуры) Тогда
		Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(НаимНоменклатуры, Истина);
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			Возврат Номенклатура;
		КонецЕсли;
	КонецЕсли;

	Возврат Справочники.Номенклатура.ПустаяСсылка();

КонецФункции

// Получить отображаемое наименование топлива по коду API.
// Приоритет: справочник TL_ВидыТоплива → key-value → хардкод.
//
Функция ПолучитьНаименованиеТоплива(КодТоплива) Экспорт

	КодСтр = Строка(КодТоплива);

	// 1. Через справочник TL_ВидыТоплива
	Попытка
		ВидТоплива = TL_Маппинг.НайтиВидТоплива(КодТоплива);
		Если ВидТоплива <> Неопределено Тогда
			Возврат ВидТоплива.Наименование;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// 2. Fallback: key-value
	Наименование = ПолучитьЗначение("Топливо_" + КодСтр + "_Литры", "");
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = ПолучитьЗначение("Топливо_" + КодСтр + "_Тонны", "");
	КонецЕсли;

	Если ЗначениеЗаполнено(Наименование) Тогда
		Наименование = СокрЛП(Наименование);
		Если Прав(Наименование, 4) = " (л)" ИЛИ Прав(Наименование, 4) = " (т)" Тогда
			Наименование = Лев(Наименование, СтрДлина(Наименование) - 4);
		ИначеЕсли Прав(Наименование, 3) = "(л)" ИЛИ Прав(Наименование, 3) = "(т)" Тогда
			Наименование = Лев(Наименование, СтрДлина(Наименование) - 3);
		КонецЕсли;
		Если ЗначениеЗаполнено(Наименование) Тогда
			Возврат СокрЛП(Наименование);
		КонецЕсли;
	КонецЕсли;

	// 3. Fallback: хардкод по справочнику STS service_code → название
	// (0 — служебный «Руб.», не топливо; 7 — СУГ).
	МаппингИмён = Новый Соответствие;
	МаппингИмён.Вставить("1", "АИ-100");
	МаппингИмён.Вставить("2", "АИ-92");
	МаппингИмён.Вставить("3", "АИ-95");
	МаппингИмён.Вставить("4", "АИ-98");
	МаппингИмён.Вставить("5", "ДТ");
	МаппингИмён.Вставить("6", "ДТ зим.");
	МаппингИмён.Вставить("7", "СУГ");

	ИмяТоплива = МаппингИмён.Получить(КодСтр);
	Возврат ?(ИмяТоплива <> Неопределено, ИмяТоплива, КодСтр);

КонецФункции

// Найти вид оплаты по внешнему ключу из API.
// Приоритет: TL_Маппинг (справочник TL_ВидыОплат) → key-value.
//
Функция НайтиВидОплаты(КлючОплаты) Экспорт

	// 1. Через справочник TL_ВидыОплат (делегат в TL_Маппинг)
	Попытка
		Результат = TL_Маппинг.НайтиВидОплаты(КлючОплаты);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// 2. Fallback: key-value регистр
	НаимКанала = ПолучитьЗначение("Оплата_" + КлючОплаты + "_Наименование", "");
	НаимСклада = ПолучитьЗначение("Оплата_" + КлючОплаты + "_Склад", "");
	ТребуетСтр = ПолучитьЗначение("Оплата_" + КлючОплаты + "_ТребуетПеремещения", "");

	Если Не ЗначениеЗаполнено(НаимКанала) И Не ЗначениеЗаполнено(НаимСклада)
		И Не ЗначениеЗаполнено(ТребуетСтр) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТребуетПеремещения = (НРег(ТребуетСтр) = "да" ИЛИ НРег(ТребуетСтр) = "true" ИЛИ НРег(ТребуетСтр) = "1");

	Склад = Справочники.Склады.ПустаяСсылка();
	Если ЗначениеЗаполнено(НаимСклада) Тогда
		Склад = Справочники.Склады.НайтиПоНаименованию(НаимСклада, Истина);
	КонецЕсли;

	НаимКонтр = ПолучитьЗначение("Оплата_" + КлючОплаты + "_Контрагент", "");
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Если ЗначениеЗаполнено(НаимКонтр) Тогда
		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(НаимКонтр, Истина);
	КонецЕсли;

	Возврат Новый Структура("Склад, ТребуетПеремещения, КонтрагентОптовый",
		Склад, ТребуетПеремещения, Контрагент);

КонецФункции

// Получить плотность топлива.
// Приоритет: TL_Маппинг (регистр TL_ПлотностьПартий + справочная) → key-value.
//
Функция ПолучитьПлотность(КодТоплива, КодСтанции = 0, Дата = Неопределено) Экспорт

	// 1. Через TL_Маппинг (регистр ПлотностьПартий + справочная)
	Попытка
		Плотность = TL_Маппинг.ПолучитьПлотность(КодТоплива, КодСтанции, ?(Дата = Неопределено, ТекущаяДата(), Дата));
		Если Плотность > 0 Тогда
			Возврат Плотность;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// 2. Fallback: key-value
	КодСтр = Строка(КодТоплива);
	ПлотностьСтр = ПолучитьЗначение("Топливо_" + КодСтр + "_Плотность", "0");
	Попытка
		Возврат Число(ПлотностьСтр);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Записать плотность партии.
// Приоритет: TL_Маппинг (регистр TL_ПлотностьПартий) → key-value.
//
Процедура ЗаписатьПлотность(КодТоплива, КодСтанции, Дата, Плотность, МассаКг, ОбъёмЛитров, НомерТТН) Экспорт

	Если Плотность = 0 Тогда
		Возврат;
	КонецЕсли;

	// 1. Через TL_Маппинг (регистр TL_ПлотностьПартий)
	Попытка
		TL_Маппинг.ЗаписатьПлотность(КодТоплива, КодСтанции, Дата, Плотность, МассаКг, ОбъёмЛитров, НомерТТН);
		Возврат;
	Исключение
	КонецПопытки;

	// 2. Fallback: key-value
	КодСтр = Строка(КодТоплива);
	ДатаСтр = Формат(Дата, "ДФ='yyyyMMdd'");
	Попытка
		УстановитьЗначение(
			"ПлотностьПартии_" + КодСтр + "_" + ДатаСтр,
			Формат(Плотность, "ЧДЦ=4; ЧРД=."),
			"ТТН №" + НомерТТН + " масса=" + XMLСтрока(МассаКг) + "кг объём=" + XMLСтрока(ОбъёмЛитров) + "л");
	Исключение
		ЗаписьЖурналаРегистрации("TL_Настройки",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось записать плотность: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

