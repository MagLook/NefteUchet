// Проверка идемпотентности на уровне пакета — есть ли запись TL_СверкаПакета
// со статусом ПринятоЦеликом.
//
Функция ПакетУжеЗагружен(ИдентификаторПакета)

	Если Не ЗначениеЗаполнено(ИдентификаторПакета) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Статус ИЗ РегистрСведений.TL_СверкаПакета
		|ГДЕ ИдентификаторПакета = &ИдПакета");
	Запрос.УстановитьПараметр("ИдПакета", ИдентификаторПакета);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И Выборка.Статус = Перечисления.TL_СтатусПакета.ПринятоЦеликом Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Извлечь дату из JSON-поля (поддерживает ISO 8601 и yyyy-MM-dd).
//
Функция ПолучитьДатуИзJSON(Источник, Ключ)

	Значение = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Источник, Ключ, "");
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), Строка(Значение));
	Исключение
		Попытка
			С = Строка(Значение);
			Возврат Дата(Число(Лев(С, 4)), Число(Сред(С, 6, 2)), Число(Сред(С, 9, 2)));
		Исключение
			Возврат '00010101';
		КонецПопытки;
	КонецПопытки;

КонецФункции

// Построить параметры для автосоздания договора из JSON-объекта НСИ.
//
Функция ПостроитьПараметрыДоговора(Объект)

	Параметры = Новый Структура;
	Имя = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Наименование", "");
	Если ЗначениеЗаполнено(Имя) Тогда
		Параметры.Вставить("Наименование", Имя);
	КонецЕсли;

	Номер = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Номер", "");
	Если ЗначениеЗаполнено(Номер) Тогда
		Параметры.Вставить("Номер", Номер);
	КонецЕсли;

	ДатаСтр = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "Дата", "");
	Если ЗначениеЗаполнено(ДатаСтр) Тогда
		Попытка
			Параметры.Вставить("Дата", XMLЗначение(Тип("Дата"), Строка(ДатаСтр)));
		Исключение
		КонецПопытки;
	КонецЕсли;

	Вид = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Объект, "ВидДоговора", "СПоставщиком");
	Параметры.Вставить("ВидДоговора", Вид);

	Возврат Параметры;

КонецФункции

// Безопасная установка реквизита (для опциональных полей которые могут отсутствовать).
