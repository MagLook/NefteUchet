////////////////////////////////////////////////////////////////////////////////
// Обработка TL_НастройкаРасширения, Форма
// Расширение ElsyPlus Ledger v3 — Мастер первоначальной настройки
//
// 4 шага:
//   Шаг 1: Организация, основной склад, поставщик, подключение к API
//   Шаг 2: Станции АЗС → Склады 1С
//   Шаг 3: Виды топлива → Номенклатура (тонны + литры по станциям)
//   Шаг 4: Каналы оплат → Виртуальные склады
//
// Структура формы:
//   ГруппаСтраницы (ГруппаСтраниц, БезЗаголовков):
//     ├── СтраницаШаг1
//     ├── СтраницаШаг2
//     ├── СтраницаШаг3
//     └── СтраницаШаг4
//   ГруппаКнопок (горизонтально):
//     ├── КнопкаНазад
//     ├── Заголовок шага
//     └── КнопкаДалее / КнопкаГотово
//
// Реквизиты формы:
//   Простые:
//     ТекущийШаг (Число), Организация (СправочникСсылка.Организации),
//     ОсновнойСклад (СправочникСсылка.Склады),
//     Поставщик (СправочникСсылка.Контрагенты),
//     URLСервера, Логин, Пароль, КодСистемы, ТекстСтатуса
//   Таблицы:
//     ТаблицаСтанций: КодСтанции, Наименование, Склад, ТипСтанции, ВремяСмены
//     ТаблицаТоплива: ВнешнийКод, Название, НоменклатураТонны, Плотность
//     ТаблицаМаппингЛитры: ВнешнийКод, Станция, НоменклатураЛитры
//     ТаблицаОплат: Наименование, КодВнешний, Склад, ТребуетПеремещения, Контрагент
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТекущийШаг = 0; // не используется — все на одной странице

	// Автонастройка: если настройки пусты — заполнить defaults ГИГ
	Попытка
		Если Не TL_Настройки.НастройкиЗаполнены() Тогда
			TL_Настройки.ИнициализироватьПоУмолчаниюГИГ();
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Загрузить текущие настройки
	Попытка
		ЗагрузитьТекущиеНастройки();
	Исключение
		Попытка
			URLСервера = TL_Настройки.ПолучитьЗначение("URLСервера", "https://pos.autooplata.ru/tms");
			Логин = TL_Настройки.ПолучитьЗначение("Логин", "");
			Пароль = TL_Настройки.ПолучитьЗначение("Пароль", "");
			КодСистемы = TL_Настройки.ПолучитьЧисло("КодСистемы", 0);
		Исключение
		КонецПопытки;
	КонецПопытки;

	// --- Все страницы видимы (без шагов) ---
	Для Шаг = 1 По 4 Цикл
		Страница = Элементы.Найти("СтраницаШаг" + Шаг);
		Если Страница <> Неопределено Тогда
			Страница.Видимость = Истина;
		КонецЕсли;
	КонецЦикла;

	// Скрыть кнопки навигации (Назад/Далее) — оставить Сохранить и Заполнить по умолчанию
	Для Каждого ИмяКнопки Из СтрРазделить("КомандаНазад,КомандаДалее", ",") Цикл
		Кнопка = Элементы.Найти(ИмяКнопки);
		Если Кнопка <> Неопределено Тогда
			Кнопка.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;

	// Переименовать «Готово» в «Сохранить»
	Попытка
		КнГотово = Элементы.Найти("КомандаГотово");
		Если КнГотово <> Неопределено Тогда
			КнГотово.Видимость = Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Кнопка "Заполнить по умолчанию"
	Попытка
		Если Элементы.Найти("КомандаЗаполнитьПоУмолчанию") = Неопределено Тогда
			Команда = Команды.Добавить("КомандаЗаполнитьПоУмолчанию");
			Команда.Действие = "ЗаполнитьПоУмолчанию";
			Команда.Заголовок = "Заполнить по умолчанию";

			Кнопка = Элементы.Добавить("КнопкаЗаполнитьПоУмолчанию", Тип("КнопкаФормы"), Элементы.КомандаГотово.Родитель);
			Кнопка.ИмяКоманды = "КомандаЗаполнитьПоУмолчанию";
			Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// --- Время проведения документов ---
	Попытка
		МассивРеквизитов = Новый Массив;
		ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(5));
		Для Каждого ИмяРекв Из СтрРазделить("ВремяСменныйОтчёт,ВремяПеремещениеТТН,ВремяКомплектация,ВремяПеремещениеКаналов", ",") Цикл
			МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяРекв, ТипСтрока));
		КонецЦикла;
		ИзменитьРеквизиты(МассивРеквизитов);

		ЭтаФорма["ВремяСменныйОтчёт"]       = TL_Настройки.ПолучитьЗначение("ВремяДок_СменныйОтчёт", "23:50");
		ЭтаФорма["ВремяПеремещениеТТН"]      = TL_Настройки.ПолучитьЗначение("ВремяДок_ПеремещениеТТН", "11:00");
		ЭтаФорма["ВремяКомплектация"]        = TL_Настройки.ПолучитьЗначение("ВремяДок_Комплектация", "13:00");
		ЭтаФорма["ВремяПеремещениеКаналов"]  = TL_Настройки.ПолучитьЗначение("ВремяДок_ПеремещениеКаналов", "23:50");

		// Группа «Время» — в корне формы (после всех таблиц)
		КорневаяГруппа = Элементы.Найти("ГруппаСтраницы");
		Если КорневаяГруппа <> Неопределено Тогда
			ГруппаВремя = Элементы.Добавить("ГруппаВремяДокументов", Тип("ГруппаФормы"), КорневаяГруппа);
			ГруппаВремя.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаВремя.Заголовок = "Время проведения документов";
			ГруппаВремя.Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;
			ГруппаВремя.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;

			ПоляВремени = Новый Соответствие;
			ПоляВремени.Вставить("ВремяСменныйОтчёт",       "Сменный отчёт");
			ПоляВремени.Вставить("ВремяПеремещениеТТН",      "Перемещение ТТН");
			ПоляВремени.Вставить("ВремяКомплектация",        "Комплектация");
			ПоляВремени.Вставить("ВремяПеремещениеКаналов",  "Перем. каналов");

			Для Каждого КлючЗначение Из ПоляВремени Цикл
				Поле = Элементы.Добавить(КлючЗначение.Ключ + "Поле", Тип("ПолеФормы"), ГруппаВремя);
				Поле.ПутьКДанным = КлючЗначение.Ключ;
				Поле.Заголовок = КлючЗначение.Значение;
				Поле.Ширина = 10;
				Поле.Вид = ВидПоляФормы.ПолеВвода;
				Поле.ТолькоПросмотр = Ложь;
				Поле.Доступность = Истина;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// --- Поле "Дополнительные сети" (system_id через запятую) ---
	Попытка
		МассивРеквДоп = Новый Массив;
		МассивРеквДоп.Добавить(Новый РеквизитФормы("ДопСети",
			Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50))));
		ИзменитьРеквизиты(МассивРеквДоп);

		ЭтаФорма["ДопСети"] = TL_Настройки.ПолучитьЗначение("ДополнительныеСети", "");

		// Поле помещаем рядом с группой времени документов
		ГруппаДок = Элементы.Найти("ГруппаВремяДокументов");
		Родитель = ?(ГруппаДок <> Неопределено, ГруппаДок.Родитель, Элементы.Найти("ГруппаСтраницы"));
		Если Родитель <> Неопределено Тогда
			ГруппаДопСети = Элементы.Добавить("ГруппаДопСети", Тип("ГруппаФормы"), Родитель);
			ГруппаДопСети.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаДопСети.Заголовок = "Дополнительные сети (system_id через запятую)";
			ГруппаДопСети.Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;

			ПолеДопСети = Элементы.Добавить("ПолеДопСети", Тип("ПолеФормы"), ГруппаДопСети);
			ПолеДопСети.ПутьКДанным = "ДопСети";
			ПолеДопСети.Заголовок = "Сети";
			ПолеДопСети.Ширина = 30;
			ПолеДопСети.Вид = ВидПоляФормы.ПолеВвода;
			ПолеДопСети.ПодсказкаВвода = "Например: 15, 100";
		КонецЕсли;
	Исключение
	КонецПопытки;

	// --- Колонка "Сеть" (КодСистемы) в ТаблицаСтанций ---
	Попытка
		МассивРеквСеть = Новый Массив;
		ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0));
		МассивРеквСеть.Добавить(Новый РеквизитФормы("КодСистемы", ТипЧисло, "ТаблицаСтанций"));
		ИзменитьРеквизиты(МассивРеквСеть);

		ТаблицаСт = Элементы.Найти("ТаблицаСтанций");
		Если ТаблицаСт <> Неопределено Тогда
			// Вставить колонку "Сеть" перед КодСтанции (первой колонкой)
			ПерваяКолонка = Неопределено;
			Для Каждого ПодчЭл Из ТаблицаСт.ПодчиненныеЭлементы Цикл
				ПерваяКолонка = ПодчЭл;
				Прервать;
			КонецЦикла;
			Если ПерваяКолонка <> Неопределено Тогда
				КолонкаСеть = Элементы.Вставить("ТаблицаСтанцийКодСистемы", Тип("ПолеФормы"), ТаблицаСт, ПерваяКолонка);
			Иначе
				КолонкаСеть = Элементы.Добавить("ТаблицаСтанцийКодСистемы", Тип("ПолеФормы"), ТаблицаСт);
			КонецЕсли;
			КолонкаСеть.ПутьКДанным = "ТаблицаСтанций.КодСистемы";
			КолонкаСеть.Заголовок = "Сеть";
			КолонкаСеть.Ширина = 5;
			КолонкаСеть.Вид = ВидПоляФормы.ПолеВвода;
			КолонкаСеть.ТолькоПросмотр = Ложь;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Скрыть API-поля
	Попытка
		Для Каждого ИмяПоля Из СтрРазделить("URLСервера,Логин,Пароль,КодСистемы,ТекстСтатуса", ",") Цикл
			Элемент = Элементы.Найти(ИмяПоля);
			Если Элемент <> Неопределено Тогда
				Элемент.Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Далее(Команда)
	// Не используется — все настройки на одной странице
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	// Не используется
КонецПроцедуры

&НаКлиенте
Процедура Готово(Команда)

	СохранитьВсеНастройкиНаСервере();
	ПоказатьПредупреждение(, "Настройки сохранены.");

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	ТекстСтатуса = "Подключение...";
	ПроверитьПодключениеНаСервере();

КонецПроцедуры

// Заполнить все поля из текущих настроек расширения (key-value + справочники).
//
&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)

	ТекстСтатуса = "Заполнение...";
	ЗаполнитьПоУмолчаниюНаСервере();
	ТекстСтатуса = "Заполнено из настроек расширения";

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчаниюНаСервере()

	// Заполнить регистр defaults ГИГ (если пуст)
	Если Не TL_Настройки.НастройкиЗаполнены() Тогда
		TL_Настройки.ИнициализироватьПоУмолчаниюГИГ();
	КонецЕсли;

	// Шаг 1: API + базовые
	URLСервера = TL_Настройки.ПолучитьЗначение("URLСервера", "https://pos.autooplata.ru/tms");
	Логин = TL_Настройки.ПолучитьЗначение("Логин", "");
	Пароль = TL_Настройки.ПолучитьЗначение("Пароль", "");
	КодСистемы = TL_Настройки.ПолучитьЧисло("КодСистемы", 0);
	Попытка ЭтаФорма["ДопСети"] = TL_Настройки.ПолучитьЗначение("ДополнительныеСети", ""); Исключение КонецПопытки;

	ИмяОрг = TL_Настройки.ПолучитьЗначение("Организация", "");
	Если ЗначениеЗаполнено(ИмяОрг) Тогда
		Организация = Справочники.Организации.НайтиПоНаименованию(ИмяОрг, Истина);
	КонецЕсли;
	ИмяСклада = TL_Настройки.ПолучитьЗначение("ОсновнойСклад", "");
	Если ЗначениеЗаполнено(ИмяСклада) Тогда
		ОсновнойСклад = Справочники.Склады.НайтиПоНаименованию(ИмяСклада, Истина);
	КонецЕсли;
	// Поставщик убран — расширение не работает с поставщиками

	// Шаг 2: Станции — динамический скан (без лимита на код)
	ТаблицаСтанций.Очистить();
	МассивСтанций = TL_Настройки.ПолучитьВсеСтанции();
	Для Каждого Элемент Из МассивСтанций Цикл
		Стр = ТаблицаСтанций.Добавить();
		Попытка Стр.КодСтанции = Число(Элемент.Код); Исключение Стр.КодСтанции = 0; КонецПопытки;
		Стр.Наименование = Элемент.Наименование;
		Стр.Склад = Справочники.Склады.НайтиПоНаименованию(Элемент.Склад, Истина);
		Стр.ВремяСмены = Элемент.ВремяЗакрытия;
		Попытка Стр.КодСистемы = Элемент.КодСистемы; Исключение КонецПопытки;
	КонецЦикла;

	// Шаг 3: Топливо из key-value
	ТаблицаТоплива.Очистить();
	ТаблицаМаппингЛитры.Очистить();
	Для Каждого Код Из СтрРазделить("2,3,5,100", ",") Цикл
		НаимТонн = TL_Настройки.ПолучитьЗначение("Топливо_" + Код + "_Тонны", "");
		НаимЛитры = TL_Настройки.ПолучитьЗначение("Топливо_" + Код + "_Литры", "");
		ПлотностьСтр = TL_Настройки.ПолучитьЗначение("Топливо_" + Код + "_Плотность", "0");
		Если Не ЗначениеЗаполнено(НаимТонн) И Не ЗначениеЗаполнено(НаимЛитры) Тогда Продолжить; КонецЕсли;

		Стр = ТаблицаТоплива.Добавить();
		Стр.ВнешнийКод = Код;
		// Название из тонн или литров
		Имя = НаимТонн;
		Если ЗначениеЗаполнено(Имя) Тогда
			Если Прав(Имя, 3) = "(т)" Тогда Имя = СокрЛП(Лев(Имя, СтрДлина(Имя) - 3)); КонецЕсли;
		Иначе
			Имя = НаимЛитры;
			Если Прав(Имя, 4) = " (л)" Тогда Имя = СокрЛП(Лев(Имя, СтрДлина(Имя) - 4)); КонецЕсли;
		КонецЕсли;
		Стр.Название = Имя;
		Если ЗначениеЗаполнено(НаимТонн) Тогда
			Стр.НоменклатураТонны = Справочники.Номенклатура.НайтиПоНаименованию(НаимТонн, Истина);
		КонецЕсли;
		Попытка Стр.Плотность = Число(ПлотностьСтр); Исключение КонецПопытки;

		// Маппинг литров (единая номенклатура для всех станций)
		Если ЗначениеЗаполнено(НаимЛитры) Тогда
			СтрЛ = ТаблицаМаппингЛитры.Добавить();
			СтрЛ.ВнешнийКод = Код;
			СтрЛ.НоменклатураЛитры = Справочники.Номенклатура.НайтиПоНаименованию(НаимЛитры, Истина);
		КонецЕсли;
	КонецЦикла;

	// Шаг 4: Оплаты из key-value
	ТаблицаОплат.Очистить();
	Для Каждого Канал Из СтрРазделить("retail,cards,online,voucher,ledger", ",") Цикл
		Наим = TL_Настройки.ПолучитьЗначение("Оплата_" + Канал + "_Наименование", "");
		Если Не ЗначениеЗаполнено(Наим) Тогда Продолжить; КонецЕсли;
		Стр = ТаблицаОплат.Добавить();
		Стр.КодВнешний = Канал;
		Стр.Наименование = Наим;
		НаимСкл = TL_Настройки.ПолучитьЗначение("Оплата_" + Канал + "_Склад", "");
		Если ЗначениеЗаполнено(НаимСкл) Тогда
			Стр.Склад = Справочники.Склады.НайтиПоНаименованию(НаимСкл, Истина);
		КонецЕсли;
		ТребуетСтр = TL_Настройки.ПолучитьЗначение("Оплата_" + Канал + "_ТребуетПеремещения", "");
		Стр.ТребуетПеремещения = (НРег(ТребуетСтр) = "да");
		НаимКонтр = TL_Настройки.ПолучитьЗначение("Оплата_" + Канал + "_Контрагент", "");
		Если ЗначениеЗаполнено(НаимКонтр) Тогда
			Стр.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(НаимКонтр, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтанцию(Команда)

	НоваяСтр = ТаблицаСтанций.Добавить();
	НоваяСтр.КодСтанции = 0;
	НоваяСтр.Наименование = "";
	НоваяСтр.ТипСтанции = "АЗС";
	НоваяСтр.ВремяСмены = "07:00";
	Попытка НоваяСтр.КодСистемы = КодСистемы; Исключение КонецПопытки;

КонецПроцедуры

// Загрузить доступные станции из API (auto-discovery).
// Опрашивает все известные сети сразу: глобальную + те, что в станциях,
// + ключ "ДополнительныеСети" (например "15,100").
//
&НаКлиенте
Процедура ЗагрузитьСтанцииИзAPI(Команда)

	Если Не ЗначениеЗаполнено(URLСервера) ИЛИ Не ЗначениеЗаполнено(Логин) Тогда
		ПоказатьПредупреждение(, "Сначала заполните настройки подключения (Шаг 1) и нажмите ""Проверить""");
		Возврат;
	КонецЕсли;

	ТекстСтатуса = "Загрузка станций из всех известных сетей...";
	ЗагрузитьСтанцииИзAPIНаСервере(0); // 0 = все сети

КонецПроцедуры

// Создать начальные остатки топлива (полная цепочка: поступление → перемещение → комплектация).
//
&НаКлиенте
Процедура СоздатьНачальныеОстатки(Команда)

	Если Не ЗначениеЗаполнено(Организация) ИЛИ Не ЗначениеЗаполнено(ОсновнойСклад) Тогда
		ПоказатьПредупреждение(, "Заполните Организацию и Основной склад на Шаге 1");
		Возврат;
	КонецЕсли;

	Если ТаблицаСтанций.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Добавьте хотя бы одну станцию на Шаге 2");
		Возврат;
	КонецЕсли;

	ТекстСтатуса = "Создание начальных остатков...";
	СоздатьНачальныеОстаткиНаСервере();

КонецПроцедуры

&НаСервере
Процедура СоздатьНачальныеОстаткиНаСервере()

	// Берём первую станцию с заполненным складом
	СкладАЗС = Неопределено;
	КонтрагентПоставщик = Неопределено;

	Для Каждого Стр Из ТаблицаСтанций Цикл
		Если ЗначениеЗаполнено(Стр.Склад) Тогда
			СкладАЗС = Стр.Склад;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(СкладАЗС) Тогда
		ТекстСтатуса = "Ошибка: нет станции с заполненным складом";
		Возврат;
	КонецЕсли;

	// Контрагент — ищем поставщика
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты
			|ГДЕ Наименование ПОДОБНО ""%СУРГУТНЕФТЕГАЗ%"" И НЕ ПометкаУдаления");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			КонтрагентПоставщик = Выборка.Ссылка;
		Иначе
			// Любой контрагент
			Запрос2 = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты ГДЕ НЕ ПометкаУдаления");
			Выборка2 = Запрос2.Выполнить().Выбрать();
			Если Выборка2.Следующий() Тогда
				КонтрагентПоставщик = Выборка2.Ссылка;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если Не ЗначениеЗаполнено(КонтрагентПоставщик) Тогда
		ТекстСтатуса = "Ошибка: контрагент не найден";
		Возврат;
	КонецЕсли;

	Попытка
		TL_Маппинг.ИнициализироватьНачальныеОстатки(
			Организация, ОсновнойСклад, СкладАЗС, КонтрагентПоставщик, ТекущаяДата());
		ТекстСтатуса = "Начальные остатки созданы! Поступление + Перемещение + Комплектация проведены.";
	Исключение
		ТекстСтатуса = "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТопливо(Команда)

	НоваяСтр = ТаблицаТоплива.Добавить();
	НоваяСтр.ВнешнийКод = "";
	НоваяСтр.Название = "";
	НоваяСтр.Плотность = 0;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ==========================================================================
//  ЗАГРУЗКА ТЕКУЩИХ НАСТРОЕК
// ==========================================================================

&НаСервере
Процедура ЗагрузитьТекущиеНастройки()

	// Организация
	ИмяОрг = TL_Настройки.ПолучитьЗначение("Организация", "");
	Если ЗначениеЗаполнено(ИмяОрг) Тогда
		Организация = Справочники.Организации.НайтиПоНаименованию(ИмяОрг, Истина);
	КонецЕсли;

	// Основной склад
	ИмяСклада = TL_Настройки.ПолучитьЗначение("ОсновнойСклад", "");
	Если ЗначениеЗаполнено(ИмяСклада) Тогда
		ОсновнойСклад = Справочники.Склады.НайтиПоНаименованию(ИмяСклада, Истина);
	КонецЕсли;

	// Поставщик убран — расширение не работает с поставщиками

	// API
	URLСервера = TL_Настройки.ПолучитьЗначение("URLСервера", "https://pos.autooplata.ru/tms");
	Логин = TL_Настройки.ПолучитьЗначение("Логин", "");
	Пароль = TL_Настройки.ПолучитьЗначение("Пароль", "");
	КодСистемы = TL_Настройки.ПолучитьЧисло("КодСистемы", 0);

	// Загрузить станции + топливо + оплаты из регистра
	ЗаполнитьПоУмолчаниюНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСтанцииИзСправочника()

	ТаблицаСтанций.Очистить();

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КодСтанции,
			|	Наименование,
			|	Склад,
			|	ТипСтанции,
			|	ВремяЗакрытияСмены
			|ИЗ
			|	Справочник.TL_АЗС
			|ГДЕ
			|	НЕ ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	КодСтанции";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр = ТаблицаСтанций.Добавить();
			Стр.КодСтанции = Выборка.КодСтанции;
			Стр.Наименование = Выборка.Наименование;
			Стр.Склад = Выборка.Склад;
			Стр.ТипСтанции = Строка(Выборка.ТипСтанции);
			Стр.ВремяСмены = Формат(Выборка.ВремяЗакрытияСмены, "ДФ='HH:mm'");
			Попытка Стр.КодСистемы = TL_Настройки.ПолучитьКодСистемыСтанции(Выборка.КодСтанции); Исключение КонецПопытки;
		КонецЦикла;
	Исключение
		// Справочник TL_АЗС не существует — начинаем с нуля
	КонецПопытки;

КонецПроцедуры

// ==========================================================================
//  ТАБЛИЦЫ ПО УМОЛЧАНИЮ
// ==========================================================================

&НаСервере
Процедура ЗаполнитьТаблицуТопливаПоУмолчанию()

	// Загрузить из TL_ВидыТоплива если есть
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ВнешнийКод, Наименование, НоменклатураТонны, ПлотностьСправочная
			|ИЗ
			|	Справочник.TL_ВидыТоплива
			|ГДЕ НЕ ПометкаУдаления";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр = ТаблицаТоплива.Добавить();
			Стр.ВнешнийКод = Выборка.ВнешнийКод;
			Стр.Название = Выборка.Наименование;
			Стр.НоменклатураТонны = Выборка.НоменклатураТонны;
			Стр.Плотность = Выборка.ПлотностьСправочная;
		КонецЦикла;

		Если ТаблицаТоплива.Количество() > 0 Тогда
			ЗагрузитьМаппингЛитровИзСправочника();
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Дополнить ОТСУТСТВУЮЩИМИ кодами из полного справочника STS.
	// Если код уже есть в таблице (загружен из справочника или key-value) — пропускаем.
	// 0=Руб(служебный)  1=АИ-100  2=АИ-92  3=АИ-95  4=АИ-98  5=ДТ  6=ДТ зим.  7=СУГ
	ДобавитьТопливоПоУмолчанию("1",   "АИ-100",              0.760);
	ДобавитьТопливоПоУмолчанию("2",   "АИ-92",               0.738);
	ДобавитьТопливоПоУмолчанию("3",   "АИ-95",               0.741);
	ДобавитьТопливоПоУмолчанию("4",   "АИ-98",               0.755);
	ДобавитьТопливоПоУмолчанию("5",   "Дизельное топливо",   0.819);
	ДобавитьТопливоПоУмолчанию("6",   "Дизельное топливо ЗИМА", 0.840);
	ДобавитьТопливоПоУмолчанию("7",   "СУГ",                 0.550);

КонецПроцедуры

&НаСервере
Процедура ДобавитьТопливоПоУмолчанию(Код, Название, Плотность)

	// Пропускаем если код уже есть (загружен из key-value или справочника)
	СуществующаяСтрока = Неопределено;
	Для Каждого СтрТ Из ТаблицаТоплива Цикл
		Если СтрТ.ВнешнийКод = Код Тогда
			СуществующаяСтрока = СтрТ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если СуществующаяСтрока <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Стр = ТаблицаТоплива.Добавить();
	Стр.ВнешнийКод = Код;
	Стр.Название = Название;
	Стр.Плотность = Плотность;

	// Попытка найти номенклатуру тонны
	НомТонн = Справочники.Номенклатура.НайтиПоНаименованию(Название + " (т)", Истина);
	Если Не ЗначениеЗаполнено(НомТонн) Тогда
		НомТонн = Справочники.Номенклатура.НайтиПоНаименованию(Название + "(т)", Истина);
	КонецЕсли;
	Если ЗначениеЗаполнено(НомТонн) Тогда
		Стр.НоменклатураТонны = НомТонн;
	КонецЕсли;

	// Литры — вторая таблица (ТаблицаМаппингЛитры)
	НомЛитры = Справочники.Номенклатура.НайтиПоНаименованию(Название + " (л)", Истина);
	Если Не ЗначениеЗаполнено(НомЛитры) Тогда
		НомЛитры = Справочники.Номенклатура.НайтиПоНаименованию(Название + "(л)", Истина);
	КонецЕсли;
	Если ЗначениеЗаполнено(НомЛитры) Тогда
		СтрЛ = ТаблицаМаппингЛитры.Добавить();
		СтрЛ.ВнешнийКод = Код;
		СтрЛ.НоменклатураЛитры = НомЛитры;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОплатПоУмолчанию()

	Если ТаблицаОплат.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	// Загрузить из TL_ВидыОплат если есть
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Наименование, КодВнешний, Склад, ТребуетПеремещения, КонтрагентОптовый
			|ИЗ
			|	Справочник.TL_ВидыОплат
			|ГДЕ НЕ ПометкаУдаления";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр = ТаблицаОплат.Добавить();
			Стр.Наименование = Выборка.Наименование;
			Стр.КодВнешний = Выборка.КодВнешний;
			Стр.Склад = Выборка.Склад;
			Стр.ТребуетПеремещения = Выборка.ТребуетПеремещения;
			Стр.Контрагент = Выборка.КонтрагентОптовый;
		КонецЦикла;

		Если ТаблицаОплат.Количество() > 0 Тогда
			Возврат;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Значения по умолчанию (каналы реализации ГИГ)
	// retail_cash — наличные, retail_card — банк.карты → отдельные строки в Отчёте о розн. продажах
	ДобавитьОплатуПоУмолчанию("Наличные",           "retail_cash",  Ложь);
	ДобавитьОплатуПоУмолчанию("Банковские карты",    "retail_card",  Ложь);
	// cards — топл./корп. карты всех эмитентов → виртуальный склад "Карты"
	ДобавитьОплатуПоУмолчанию("Топливные/корп. карты",           "cards",   Истина);
	// online — Яндекс, мобильные, Benzuber → виртуальный склад "Онлайн"/"ЯНДЕКС"
	ДобавитьОплатуПоУмолчанию("Онлайн-заказы (Яндекс и др.)",   "online",  Истина);

КонецПроцедуры

&НаСервере
Процедура ДобавитьОплатуПоУмолчанию(Наименование, КодВнешний, ТребуетПеремещения)

	Стр = ТаблицаОплат.Добавить();
	Стр.Наименование = Наименование;
	Стр.КодВнешний = КодВнешний;
	Стр.ТребуетПеремещения = ТребуетПеремещения;

	// Попытка найти склад с таким же названием
	Если ТребуетПеремещения Тогда
		// Ищем склад строго по наименованию канала — без fallback на "Карты"
		// чтобы не перепутать склады разных каналов
		Склад = Справочники.Склады.НайтиПоНаименованию(Наименование, Истина);
		Если ЗначениеЗаполнено(Склад) Тогда
			Стр.Склад = Склад;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// ==========================================================================
//  AUTO-DISCOVERY СТАНЦИЙ ИЗ API
// ==========================================================================

&НаСервере
Процедура ЗагрузитьСтанцииИзAPIНаСервере(КодСетиДляЗагрузки = 0)

	// Сначала сохраним базовые параметры подключения, чтобы ОпроситьВсеСетиИзAPI
	// и ПолучитьВсеСетиДляОпроса видели свежие значения (URL/Логин/Пароль/КодСистемы)
	Попытка
		TL_Настройки.УстановитьЗначение("URLСервера", URLСервера, "URL API STS");
		TL_Настройки.УстановитьЗначение("Логин", Логин, "Логин API");
		TL_Настройки.УстановитьЗначение("Пароль", Пароль, "Пароль API");
		Если КодСистемы > 0 Тогда
			TL_Настройки.УстановитьЗначение("КодСистемы", XMLСтрока(КодСистемы), "Код системы (сети АЗС)");
		КонецЕсли;
	Исключение
	КонецПопытки;

	НайденныеОС = Новый Массив;
	СписокОшибок = Новый Массив;

	Если КодСетиДляЗагрузки = 0 Тогда
		// Все известные сети
		Результат = TL_Настройки.ОпроситьВсеСетиИзAPI(URLСервера, Логин, Пароль);
		НайденныеОС = Результат.Станции;
		СписокОшибок = Результат.Ошибки;
	Иначе
		// Конкретная сеть (старая логика для совместимости)
		Попытка
			Токен = TL_ApiКлиент.Авторизация(URLСервера, Логин, Пароль, КодСетиДляЗагрузки);
			Если Не ЗначениеЗаполнено(Токен) Тогда
				ТекстСтатуса = "Ошибка авторизации для сети " + XMLСтрока(КодСетиДляЗагрузки);
				Возврат;
			КонецЕсли;
			НайденныеОС = TL_ApiКлиент.ПолучитьСписокОС(URLСервера, Токен, КодСетиДляЗагрузки);
		Исключение
			ТекстСтатуса = "Ошибка: " + ОписаниеОшибки();
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Если НайденныеОС.Количество() = 0 Тогда
		ТекстСтатуса = "API не вернул ни одной станции"
			+ ?(СписокОшибок.Количество() > 0, ". " + СтрСоединить(СписокОшибок, "; "), "");
		Возврат;
	КонецЕсли;

	// Собрать существующие коды из таблицы (по комбинации КодСтанции+КодСистемы)
	СуществующиеКлючи = Новый Соответствие;
	Для Каждого Стр Из ТаблицаСтанций Цикл
		Ключ = XMLСтрока(Стр.КодСтанции) + "|" + XMLСтрока(?(Стр.КодСистемы > 0, Стр.КодСистемы, 0));
		СуществующиеКлючи.Вставить(Ключ, Стр);
	КонецЦикла;

	// Добавить новые / обогатить существующие
	КолНовых = 0; КолОбогащённых = 0;
	Для Каждого Стр Из НайденныеОС Цикл
		Ключ = XMLСтрока(Стр.Код) + "|" + XMLСтрока(Стр.КодСистемы);
		Существующая = СуществующиеКлючи.Получить(Ключ);
		Если Существующая <> Неопределено Тогда
			// Уже есть — обогатим именем/адресом если они пустые
			Изменено = Ложь;
			Если Не ЗначениеЗаполнено(Существующая.Наименование)
					ИЛИ СтрНачинаетсяС(Существующая.Наименование, "Станция ") Тогда
				Если ЗначениеЗаполнено(Стр.Наименование) Тогда
					Существующая.Наименование = Стр.Наименование;
					Изменено = Истина;
				КонецЕсли;
			КонецЕсли;
			Если Изменено Тогда КолОбогащённых = КолОбогащённых + 1; КонецЕсли;
			Продолжить;
		КонецЕсли;

		НоваяСтр = ТаблицаСтанций.Добавить();
		НоваяСтр.КодСтанции = Стр.Код;
		ИмяНовой = ?(ЗначениеЗаполнено(Стр.Наименование),
			Стр.Наименование, "Станция " + XMLСтрока(Стр.Код));
		НоваяСтр.Наименование = ИмяНовой;
		НоваяСтр.ТипСтанции = "АЗС";
		НоваяСтр.ВремяСмены = "00:00";
		Попытка НоваяСтр.КодСистемы = Стр.КодСистемы; Исключение КонецПопытки;

		// Поиск или АВТОСОЗДАНИЕ склада. Пользователь сможет переименовать —
		// связь хранится по GUID (НайтиСкладСтанции работает по UUID).
		Склад = Справочники.Склады.НайтиПоНаименованию(ИмяНовой, Истина);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			Попытка
				Склад = TL_Настройки.ПолучитьИлиСоздатьСкладАЗС(ИмяНовой, Стр.Код);
			Исключение
				Склад = Справочники.Склады.ПустаяСсылка();
			КонецПопытки;
		КонецЕсли;
		Если ЗначениеЗаполнено(Склад) Тогда
			НоваяСтр.Склад = Склад;
		КонецЕсли;

		КолНовых = КолНовых + 1;
	КонецЦикла;

	СообщениеЧасти = Новый Массив;
	СообщениеЧасти.Добавить("Найдено в API: " + НайденныеОС.Количество());
	СообщениеЧасти.Добавить("новых: " + КолНовых);
	Если КолОбогащённых > 0 Тогда
		СообщениеЧасти.Добавить("обновлено имён: " + КолОбогащённых);
	КонецЕсли;
	Если СписокОшибок.Количество() > 0 Тогда
		СообщениеЧасти.Добавить("ошибок сетей: " + СписокОшибок.Количество());
	КонецЕсли;
	ТекстСтатуса = СтрСоединить(СообщениеЧасти, ", ") + ".";

КонецПроцедуры

// ==========================================================================
//  ПРОВЕРКА ПОДКЛЮЧЕНИЯ
// ==========================================================================

&НаСервере
Процедура ПроверитьПодключениеНаСервере()

	Попытка
		Токен = TL_ApiКлиент.Авторизация(URLСервера, Логин, Пароль);
		Если Не ЗначениеЗаполнено(Токен) Тогда
			ТекстСтатуса = "Ошибка: пустой токен. Проверьте логин/пароль.";
			Возврат;
		КонецЕсли;

		// Попробуем получить смены
		Смены = TL_ApiКлиент.ПолучитьСписокСмен(URLСервера, Токен, КодСистемы, 0);
		КолСмен = ?(ТипЗнч(Смены) = Тип("Массив"), Смены.Количество(), 0);

		ТекстСтатуса = "OK! Подключение успешно, найдено смен: " + XMLСтрока(КолСмен);
	Исключение
		ТекстСтатуса = "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// ==========================================================================
//  СОХРАНЕНИЕ ВСЕХ НАСТРОЕК
// ==========================================================================

&НаСервере
Процедура СохранитьВсеНастройкиНаСервере()

	// --- Шаг 1: Базовые настройки ---
	Если ЗначениеЗаполнено(Организация) Тогда
		TL_Настройки.УстановитьЗначение("Организация", Строка(Организация), "Организация");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОсновнойСклад) Тогда
		TL_Настройки.УстановитьЗначение("ОсновнойСклад", Строка(ОсновнойСклад), "Основной склад (опт, тонны)");
	КонецЕсли;
	TL_Настройки.УстановитьЗначение("URLСервера", URLСервера, "URL API STS");
	TL_Настройки.УстановитьЗначение("Логин", Логин, "Логин API");
	TL_Настройки.УстановитьЗначение("Пароль", Пароль, "Пароль API");
	TL_Настройки.УстановитьЗначение("КодСистемы", XMLСтрока(КодСистемы), "Код системы (сети АЗС)");

	// Дополнительные сети (system_id через запятую) — поле добавлено динамически
	Попытка
		ЗначДопСети = СокрЛП(ЭтаФорма["ДопСети"]);
		TL_Настройки.УстановитьЗначение("ДополнительныеСети", ЗначДопСети, "Доп. сети для discovery");
	Исключение
	КонецПопытки;

	// --- Шаг 2: Станции АЗС (справочник + key-value) ---
	СохранитьСтанции();
	Для Каждого Стр Из ТаблицаСтанций Цикл
		Если Стр.КодСтанции = 0 Тогда Продолжить; КонецЕсли;
		КодСтр = XMLСтрока(Стр.КодСтанции);
		Если ЗначениеЗаполнено(Стр.Склад) Тогда
			TL_Настройки.УстановитьЗначение("Станция_" + КодСтр + "_Склад", Строка(Стр.Склад), "Склад станции " + КодСтр);
			// GUID — основная связь, не зависит от переименования склада
			Попытка
				TL_Настройки.УстановитьЗначение("Станция_" + КодСтр + "_СкладGUID",
					Строка(Стр.Склад.УникальныйИдентификатор()),
					"GUID склада " + КодСтр);
			Исключение
			КонецПопытки;
		КонецЕсли;
		TL_Настройки.УстановитьЗначение("Станция_" + КодСтр + "_Наименование", Стр.Наименование, "Название станции");
		TL_Настройки.УстановитьЗначение("Станция_" + КодСтр + "_ВремяЗакрытия", ?(ЗначениеЗаполнено(Стр.ВремяСмены), Стр.ВремяСмены, "00:00"), "Время закрытия");
		Попытка
			Если Стр.КодСистемы > 0 Тогда
				TL_Настройки.УстановитьЗначение("Станция_" + КодСтр + "_КодСистемы", XMLСтрока(Стр.КодСистемы), "Сеть станции");
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	// --- Шаг 3: Виды топлива (справочник + key-value) ---
	СохранитьВидыТоплива();
	Для Каждого Стр Из ТаблицаТоплива Цикл
		Если Не ЗначениеЗаполнено(Стр.ВнешнийКод) Тогда Продолжить; КонецЕсли;
		Код = Стр.ВнешнийКод;
		Если ЗначениеЗаполнено(Стр.НоменклатураТонны) Тогда
			TL_Настройки.УстановитьЗначение("Топливо_" + Код + "_Тонны", Строка(Стр.НоменклатураТонны), "Тонны");
		КонецЕсли;
		Если Стр.Плотность > 0 Тогда
			TL_Настройки.УстановитьЗначение("Топливо_" + Код + "_Плотность", Формат(Стр.Плотность, "ЧДЦ=4; ЧРД=."), "Плотность");
		КонецЕсли;
	КонецЦикла;
	// Маппинг литров по станциям → key-value (единая номенклатура)
	Для Каждого Стр Из ТаблицаМаппингЛитры Цикл
		Если ЗначениеЗаполнено(Стр.ВнешнийКод) И ЗначениеЗаполнено(Стр.НоменклатураЛитры) Тогда
			TL_Настройки.УстановитьЗначение("Топливо_" + Стр.ВнешнийКод + "_Литры", Строка(Стр.НоменклатураЛитры), "Литры");
		КонецЕсли;
	КонецЦикла;

	// --- Шаг 4: Виды оплат (справочник + key-value) ---
	СохранитьВидыОплат();
	Для Каждого Стр Из ТаблицаОплат Цикл
		Если Не ЗначениеЗаполнено(Стр.КодВнешний) Тогда Продолжить; КонецЕсли;
		Канал = Стр.КодВнешний;
		TL_Настройки.УстановитьЗначение("Оплата_" + Канал + "_Наименование", Стр.Наименование, "Канал оплаты");
		Если ЗначениеЗаполнено(Стр.Склад) Тогда
			TL_Настройки.УстановитьЗначение("Оплата_" + Канал + "_Склад", Строка(Стр.Склад), "Виртуальный склад");
		КонецЕсли;
		TL_Настройки.УстановитьЗначение("Оплата_" + Канал + "_ТребуетПеремещения", ?(Стр.ТребуетПеремещения, "Да", "Нет"), "Перемещение");
		Если ЗначениеЗаполнено(Стр.Контрагент) Тогда
			TL_Настройки.УстановитьЗначение("Оплата_" + Канал + "_Контрагент", Строка(Стр.Контрагент), "Контрагент");
		КонецЕсли;
	КонецЦикла;

	// --- Маппинг имён оплат API → каналы (предзаполнение) ---
	Попытка
		TL_Маппинг.ЗаполнитьМаппингОплатПоУмолчанию();
	Исключение
	КонецПопытки;

	// --- Время проведения документов (реквизиты добавлены программно) ---
	Попытка
		TL_Настройки.УстановитьЗначение("ВремяДок_СменныйОтчёт",       ЭтаФорма["ВремяСменныйОтчёт"],       "Время: Отчёт о розничных продажах");
		TL_Настройки.УстановитьЗначение("ВремяДок_ПеремещениеТТН",      ЭтаФорма["ВремяПеремещениеТТН"],      "Время: Перемещение тонн (ТТН)");
		TL_Настройки.УстановитьЗначение("ВремяДок_Комплектация",        ЭтаФорма["ВремяКомплектация"],        "Время: Комплектация тонны → литры");
		TL_Настройки.УстановитьЗначение("ВремяДок_ПеремещениеКаналов",  ЭтаФорма["ВремяПеремещениеКаналов"],  "Время: Перемещения по каналам оплат");
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СохранитьСтанции()

	Попытка
		Для Каждого Стр Из ТаблицаСтанций Цикл
			Если Стр.КодСтанции = 0 Тогда
				Продолжить;
			КонецЕсли;

			// Найти или создать элемент справочника TL_АЗС
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
				|ИЗ Справочник.TL_АЗС
				|ГДЕ КодСтанции = &КодСтанции";
			Запрос.УстановитьПараметр("КодСтанции", Стр.КодСтанции);
			Выборка = Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Объект = Выборка.Ссылка.ПолучитьОбъект();
			Иначе
				Объект = Справочники.TL_АЗС.СоздатьЭлемент();
			КонецЕсли;

			Объект.КодСтанции = Стр.КодСтанции;
			Объект.Наименование = Стр.Наименование;
			Объект.Склад = Стр.Склад;
			Объект.Активна = Истина;

			// Тип станции
			Попытка
				Если ЗначениеЗаполнено(Стр.ТипСтанции) Тогда
					Если Стр.ТипСтанции = "АЗС" Тогда
						Объект.ТипСтанции = Перечисления.TL_ТипыСтанций.АЗС;
					ИначеЕсли Стр.ТипСтанции = "КАЗС" Тогда
						Объект.ТипСтанции = Перечисления.TL_ТипыСтанций.КАЗС;
					ИначеЕсли Стр.ТипСтанции = "АКАЗС" Тогда
						Объект.ТипСтанции = Перечисления.TL_ТипыСтанций.АКАЗС;
					ИначеЕсли Стр.ТипСтанции = "АГЗС" Тогда
						Объект.ТипСтанции = Перечисления.TL_ТипыСтанций.АГЗС;
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;

			// Время закрытия смены
			Попытка
				Если ЗначениеЗаполнено(Стр.ВремяСмены) Тогда
					Объект.ВремяЗакрытияСмены = Дата("00010101" + СтрЗаменить(Стр.ВремяСмены, ":", "") + "00");
				КонецЕсли;
			Исключение
			КонецПопытки;

			Объект.Записать();
		КонецЦикла;
	Исключение
		// Справочник TL_АЗС не существует
		ЗаписьЖурналаРегистрации("TL_НастройкаРасширения",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось сохранить станции: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СохранитьВидыТоплива()

	Попытка
		Для Каждого Стр Из ТаблицаТоплива Цикл
			Если Не ЗначениеЗаполнено(Стр.ВнешнийКод) Тогда
				Продолжить;
			КонецЕсли;

			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
				|ИЗ Справочник.TL_ВидыТоплива
				|ГДЕ ВнешнийКод = &ВнешнийКод";
			Запрос.УстановитьПараметр("ВнешнийКод", Стр.ВнешнийКод);
			Выборка = Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Объект = Выборка.Ссылка.ПолучитьОбъект();
			Иначе
				Объект = Справочники.TL_ВидыТоплива.СоздатьЭлемент();
			КонецЕсли;

			Объект.Наименование = Стр.Название;
			Объект.ВнешнийКод = Стр.ВнешнийКод;
			Объект.НоменклатураТонны = Стр.НоменклатураТонны;
			Объект.ПлотностьСправочная = Стр.Плотность;

			// Маппинг литров по станциям
			Объект.МаппингПоСтанциям.Очистить();
			Для Каждого СтрМаппинг Из ТаблицаМаппингЛитры Цикл
				Если СтрМаппинг.ВнешнийКод = Стр.ВнешнийКод
					И ЗначениеЗаполнено(СтрМаппинг.НоменклатураЛитры) Тогда

					НоваяСтр = Объект.МаппингПоСтанциям.Добавить();
					НоваяСтр.АЗС = СтрМаппинг.Станция;
					НоваяСтр.НоменклатураЛитры = СтрМаппинг.НоменклатураЛитры;
				КонецЕсли;
			КонецЦикла;

			Объект.Записать();
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("TL_НастройкаРасширения",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось сохранить виды топлива: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СохранитьВидыОплат()

	Попытка
		Для Каждого Стр Из ТаблицаОплат Цикл
			Если Не ЗначениеЗаполнено(Стр.Наименование) Тогда
				Продолжить;
			КонецЕсли;

			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
				|ИЗ Справочник.TL_ВидыОплат
				|ГДЕ КодВнешний = &КодВнешний";
			Запрос.УстановитьПараметр("КодВнешний", Стр.КодВнешний);
			Выборка = Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Объект = Выборка.Ссылка.ПолучитьОбъект();
			Иначе
				Объект = Справочники.TL_ВидыОплат.СоздатьЭлемент();
			КонецЕсли;

			Объект.Наименование = Стр.Наименование;
			Объект.КодВнешний = Стр.КодВнешний;
			Объект.Склад = Стр.Склад;
			Объект.ТребуетПеремещения = Стр.ТребуетПеремещения;
			Объект.КонтрагентОптовый = Стр.Контрагент;
			Объект.Записать();
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("TL_НастройкаРасширения",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось сохранить виды оплат: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// ==========================================================================
//  ЗАГРУЗКА МАППИНГА ЛИТРОВ ПО СТАНЦИЯМ
// ==========================================================================

&НаСервере
Процедура ЗагрузитьМаппингЛитровИзСправочника()

	ТаблицаМаппингЛитры.Очистить();

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Владелец.ВнешнийКод КАК ВнешнийКод,
			|	МаппингПоСтанциям.АЗС КАК Станция,
			|	МаппингПоСтанциям.НоменклатураЛитры КАК НоменклатураЛитры
			|ИЗ
			|	Справочник.TL_ВидыТоплива.МаппингПоСтанциям КАК МаппингПоСтанциям
			|ГДЕ
			|	НЕ Владелец.ПометкаУдаления";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр = ТаблицаМаппингЛитры.Добавить();
			Стр.ВнешнийКод = Выборка.ВнешнийКод;
			Стр.Станция = Выборка.Станция;
			Стр.НоменклатураЛитры = Выборка.НоменклатураЛитры;
		КонецЦикла;
	Исключение
		// Табличная часть МаппингПоСтанциям не существует
	КонецПопытки;

КонецПроцедуры

// Навигация по шагам убрана — все настройки на одной странице.

#КонецОбласти
