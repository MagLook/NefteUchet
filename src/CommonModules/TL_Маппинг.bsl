////////////////////////////////////////////////////////////////////////////////
// Общий модуль TL_Маппинг
// Расширение ElsyPlus Ledger для 1С:БП 3.0
// Контекст: Сервер, Экспорт
// Центральный модуль маппинга: внешние коды API → объекты 1С.
//
// Каждая функция содержит fallback на текущую логику (хардкод),
// если справочники расширения пусты или не созданы.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Получить контрагента для кассового ордера по складу станции.
// Используется при создании ПКО на розничную выручку (поле Контрагент / ПринятоОт).
// В ручной схеме ГИГ контрагент совпадает с именем склада ("АГЗС Витебский").
//
// Приоритет:
//   1. Ключ TL_Настройки: Станция_<КодСтанции>_КонтрагентКасса (явный маппинг)
//   2. Реквизит TL_АЗС.КонтрагентКасса (если в справочнике расширения)
//   3. Поиск Контрагенты по точному наименованию = наименование склада
//
// Параметры:
//   Склад      - СправочникСсылка.Склады
//   КодСтанции - Число - для маппинга через ключ настройки (необязателен)
//
// Возвращаемое значение:
//   СправочникСсылка.Контрагенты или ПустаяСсылка
//
Функция ПолучитьКонтрагентаКассы(Склад, КодСтанции = 0) Экспорт

	// 1. Явная настройка по коду станции
	Если КодСтанции > 0 Тогда
		Имя = TL_Настройки.ПолучитьЗначение("Станция_" + XMLСтрока(КодСтанции) + "_КонтрагентКасса", "");
		Если ЗначениеЗаполнено(Имя) Тогда
			Контр = Справочники.Контрагенты.НайтиПоНаименованию(Имя, Истина);
			Если ЗначениеЗаполнено(Контр) Тогда
				Возврат Контр;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// 2. Реквизит справочника расширения TL_АЗС.КонтрагентКасса (если заведён)
	Если КодСтанции > 0 Тогда
		Попытка
			АЗС = НайтиАЗС(КодСтанции);
			Если АЗС <> Неопределено Тогда
				Попытка
					Контр = АЗС.КонтрагентКасса;
					Если ЗначениеЗаполнено(Контр) И Не Контр.ПометкаУдаления Тогда
						Возврат Контр;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// 3. Поиск по имени склада
	Если ЗначениеЗаполнено(Склад) Тогда
		Контр = Справочники.Контрагенты.НайтиПоНаименованию(Строка(Склад), Истина);
		Если ЗначениеЗаполнено(Контр) Тогда
			Возврат Контр;
		КонецЕсли;
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Найти АЗС по коду станции из API.
//
// Параметры:
//   КодСтанции - Число - код в API STS (208, 209, 5...)
//
// Возвращаемое значение:
//   СправочникСсылка.TL_АЗС или Неопределено
//
Функция НайтиАЗС(КодСтанции) Экспорт

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Ссылка
			|ИЗ
			|	Справочник.TL_АЗС
			|ГДЕ
			|	КодСтанции = &КодСтанции
			|	И НЕ ПометкаУдаления";

		Запрос.УстановитьПараметр("КодСтанции", КодСтанции);
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
		// Справочник TL_АЗС не существует
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Найти склад АЗС по коду станции.
// Логика: TL_АЗС.Склад → fallback: поиск по маскам имён.
//
// Параметры:
//   КодСтанции - Число
//
// Возвращаемое значение:
//   СправочникСсылка.Склады (пустая ссылка если не найден)
//
Функция НайтиСкладСтанции(КодСтанции) Экспорт

	// 1. Поиск через справочник TL_АЗС
	АЗС = НайтиАЗС(КодСтанции);
	Если АЗС <> Неопределено Тогда
		Попытка
			Склад = АЗС.Склад;
			Если ЗначениеЗаполнено(Склад) И Не Склад.ПометкаУдаления Тогда
				Возврат Склад;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// 2. Fallback: поиск по маскам наименования
	Возврат НайтиСкладПоМаскам(КодСтанции);

КонецФункции

// Найти номенклатуру топлива по внешнему коду.
//
// Параметры:
//   КодТоплива  - Строка - код из API ("92", "95", "DT", "DTw")
//   Единица     - Строка - "л" (литры) или "т" (тонны)
//   КодСтанции  - Число  - код станции (для N:1 маппинга литров по станциям)
//
// Возвращаемое значение:
//   СправочникСсылка.Номенклатура (пустая ссылка если не найдена)
//
Функция НайтиНоменклатуруТоплива(КодТоплива, Единица, КодСтанции = 0) Экспорт

	// 1. Поиск через справочник TL_ВидыТоплива
	ВидТоплива = НайтиВидТоплива(КодТоплива);

	Если ВидТоплива <> Неопределено Тогда

		Если НРег(Единица) = "т" Тогда
			// Тонны: общая номенклатура
			Попытка
				Номенклатура = ВидТоплива.НоменклатураТонны;
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					Возврат Номенклатура;
				КонецЕсли;
			Исключение
			КонецПопытки;
		Иначе
			// Литры: ищем в табличной части МаппингПоСтанциям
			Если КодСтанции > 0 Тогда
				Попытка
					АЗС = НайтиАЗС(КодСтанции);
					Если АЗС <> Неопределено Тогда
						Для Каждого СтрокаМаппинга Из ВидТоплива.МаппингПоСтанциям Цикл
							Если СтрокаМаппинга.АЗС = АЗС Тогда
								Если ЗначениеЗаполнено(СтрокаМаппинга.НоменклатураЛитры) Тогда
									Возврат СтрокаМаппинга.НоменклатураЛитры;
								КонецЕсли;
								Прервать;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

	// 2. Fallback: хардкод маппинг + НайтиПоНаименованию
	Возврат НайтиНоменклатуруFallback(КодТоплива, Единица);

КонецФункции

// Найти вид оплаты по внешнему ключу из API (payments).
//
// Параметры:
//   КлючОплаты - Строка - ключ из JSON payments ("cash", "card", "voucher")
//
// Возвращаемое значение:
//   Структура("Склад, ТребуетПеремещения, КонтрагентОптовый") или Неопределено
//
Функция НайтиВидОплаты(КлючОплаты) Экспорт

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Ссылка.Склад КАК Склад,
			|	Ссылка.ТребуетПеремещения КАК ТребуетПеремещения,
			|	Ссылка.КонтрагентОптовый КАК КонтрагентОптовый
			|ИЗ
			|	Справочник.TL_ВидыОплат
			|ГДЕ
			|	КодВнешний = &КодВнешний
			|	И НЕ ПометкаУдаления";

		Запрос.УстановитьПараметр("КодВнешний", КлючОплаты);
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Возврат Новый Структура("Склад, ТребуетПеремещения, КонтрагентОптовый",
				Выборка.Склад,
				Выборка.ТребуетПеремещения,
				Выборка.КонтрагентОптовый);
		КонецЕсли;
	Исключение
		// Справочник TL_ВидыОплат не существует
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Получить плотность топлива для пересчёта тонны → литры.
// Нормализовать дату смены с учётом времени закрытия станции.
// Если станция закрывает смену в 07:00, то смена открытая 22.03 в 00:01
// относится к финансовому дню 21.03.
//
// Параметры:
//   ДатаСмены   - Дата
//   КодСтанции  - Число
//
// Возвращаемое значение:
//   Дата - нормализованная (начало дня)
//
Функция НормализоватьДатуСмены(ДатаСмены, КодСтанции) Экспорт

	Если Не ЗначениеЗаполнено(ДатаСмены) Тогда
		Возврат ДатаСмены;
	КонецЕсли;

	АЗС = НайтиАЗС(КодСтанции);
	Если АЗС = Неопределено Тогда
		Возврат НачалоДня(ДатаСмены);
	КонецЕсли;

	Попытка
		ВремяЗакрытия = АЗС.ВремяЗакрытияСмены;
	Исключение
		Возврат НачалоДня(ДатаСмены);
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ВремяЗакрытия) Тогда
		Возврат НачалоДня(ДатаСмены);
	КонецЕсли;

	ЧасЗакрытия = Час(ВремяЗакрытия);
	Если ЧасЗакрытия = 0 Тогда
		Возврат НачалоДня(ДатаСмены);
	КонецЕсли;

	Если Час(ДатаСмены) < ЧасЗакрытия Тогда
		Возврат НачалоДня(ДатаСмены - 86400);
	КонецЕсли;

	Возврат НачалоДня(ДатаСмены);

КонецФункции

// Получить плотность топлива для пересчёта тонны → литры.
// Логика: TL_ПлотностьПартий (последняя запись) → fallback: ПлотностьСправочная из TL_ВидыТоплива.
//
// Параметры:
//   КодТоплива  - Строка - внешний код
//   КодСтанции  - Число
//   Дата        - Дата
//
// Возвращаемое значение:
//   Число - плотность (кг/л), 0 если не найдена
//
Функция ПолучитьПлотность(КодТоплива, КодСтанции, Дата) Экспорт

	ВидТоплива = Неопределено;

	// 1. Из регистра TL_ПлотностьПартий (последняя на дату)
	Попытка
		ВидТоплива = НайтиВидТоплива(КодТоплива);
		АЗС = НайтиАЗС(КодСтанции);

		Если ВидТоплива <> Неопределено И АЗС <> Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Плотность
				|ИЗ
				|	РегистрСведений.TL_ПлотностьПартий
				|ГДЕ
				|	ВидТоплива = &ВидТоплива
				|	И АЗС = &АЗС
				|	И ДатаПоступления <= &Дата
				|УПОРЯДОЧИТЬ ПО
				|	ДатаПоступления УБЫВ";

			Запрос.УстановитьПараметр("ВидТоплива", ВидТоплива);
			Запрос.УстановитьПараметр("АЗС", АЗС);
			Запрос.УстановитьПараметр("Дата", Дата);

			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() И Выборка.Плотность > 0 Тогда
				Возврат Выборка.Плотность;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// 2. Fallback: справочная плотность из TL_ВидыТоплива
	Попытка
		Если ВидТоплива <> Неопределено Тогда
			Если ВидТоплива.ПлотностьСправочная > 0 Тогда
				Возврат ВидТоплива.ПлотностьСправочная;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	ЗаписьЖурналаРегистрации("TL_Маппинг",
		УровеньЖурналаРегистрации.Предупреждение, , ,
		"Плотность не найдена: топливо=" + КодТоплива
		+ ", станция=" + XMLСтрока(КодСтанции)
		+ ", дата=" + Формат(Дата, "ДФ='dd.MM.yyyy'"));

	Возврат 0;

КонецФункции

// Записать плотность партии в регистр TL_ПлотностьПартий.
//
Процедура ЗаписатьПлотность(КодТоплива, КодСтанции, Дата, Плотность, МассаКг, ОбъёмЛитров, НомерТТН) Экспорт

	Если Плотность = 0 Тогда
		Возврат;
	КонецЕсли;

	ВидТоплива = НайтиВидТоплива(КодТоплива);
	АЗС = НайтиАЗС(КодСтанции);

	Если ВидТоплива = Неопределено ИЛИ АЗС = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		МенеджерЗаписи = РегистрыСведений.TL_ПлотностьПартий.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ВидТоплива = ВидТоплива;
		МенеджерЗаписи.ДатаПоступления = Дата;
		МенеджерЗаписи.АЗС = АЗС;
		МенеджерЗаписи.Плотность = Плотность;
		МенеджерЗаписи.МассаКг = МассаКг;
		МенеджерЗаписи.ОбъёмЛитров = ОбъёмЛитров;
		МенеджерЗаписи.НомерТТН = НомерТТН;
		МенеджерЗаписи.Записать();
	Исключение
		// Регистр не существует — пропускаем
		ЗаписьЖурналаРегистрации("TL_Маппинг",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось записать плотность: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Инициализировать начальные остатки топлива на складе АЗС.
// Создаёт полную цепочку: Поступление тонн → Перемещение → Комплектация.
// Выполняется внутри 1С — стандартные механизмы заполнения счетов работают.
//
// Параметры:
//   Организация  - СправочникСсылка.Организации
//   ОснСклад     - СправочникСсылка.Склады - основной склад (тонны)
//   АЗССклад     - СправочникСсылка.Склады - склад АЗС (литры)
//   Контрагент   - СправочникСсылка.Контрагенты
//   ДатаДок      - Дата
//
Процедура ИнициализироватьНачальныеОстатки(Организация, ОснСклад, АЗССклад, Контрагент, ДатаДок) Экспорт

	// Данные: наим_тонн, наим_литры (из настроек!), тонны, литры, цена за тонну
	ЛитрыАИ92 = TL_Настройки.ПолучитьЗначение("Топливо_2_Литры", "АИ-92 (л)");
	ЛитрыАИ95 = TL_Настройки.ПолучитьЗначение("Топливо_3_Литры", "АИ-95 (л)");
	ЛитрыДТ   = TL_Настройки.ПолучитьЗначение("Топливо_5_Литры", "Дизельное топливо (л)");
	ТоннАИ92  = TL_Настройки.ПолучитьЗначение("Топливо_2_Тонны", "АИ-92(т)");
	ТоннАИ95  = TL_Настройки.ПолучитьЗначение("Топливо_3_Тонны", "АИ-95(т)");
	ТоннДТ    = TL_Настройки.ПолучитьЗначение("Топливо_5_Тонны", "Дизельное топливо (т)");

	Топливо = Новый Массив;
	Топливо.Добавить(Новый Структура("Тонны, Литры, Кол_Т, Кол_Л, Цена",
		ТоннАИ92, ЛитрыАИ92, 6, 8100, 90500));
	Топливо.Добавить(Новый Структура("Тонны, Литры, Кол_Т, Кол_Л, Цена",
		ТоннАИ95, ЛитрыАИ95, 4, 5400, 95000));
	Топливо.Добавить(Новый Структура("Тонны, Литры, Кол_Т, Кол_Л, Цена",
		ТоннДТ, ЛитрыДТ, 8, 9750, 85000));

	СтавкаНДС = TL_Настройки.ПолучитьСтавкуНДС();

	// --- Счета учёта (явно, т.к. программное создание не заполняет автоматически) ---
	Счёт4101 = Неопределено;
	Счёт4102 = Неопределено;
	Счёт6001 = Неопределено;
	Счёт1903 = Неопределено;
	Попытка Счёт4101 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01"); Исключение КонецПопытки;
	Попытка Счёт4102 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.02"); Исключение КонецПопытки;
	Попытка Счёт6001 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.01"); Исключение КонецПопытки;
	Попытка Счёт1903 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("19.03"); Исключение КонецПопытки;

	// --- Договор контрагента ---
	Договор = Неопределено;
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ДоговорыКонтрагентов
			|ГДЕ Владелец = &К И НЕ ПометкаУдаления");
		Запрос.УстановитьПараметр("К", Контрагент);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Договор = Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// === ШАГ 1: Поступление тонн на Основной склад ===
	Док1 = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	Док1.Дата = ДатаДок;
	Док1.Организация = Организация;
	Док1.Контрагент = Контрагент;
	Док1.Комментарий = "TL|INIT|Начальные остатки";

	Попытка Док1.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Покупка; Исключение КонецПопытки;
	Попытка Док1.Склад = ОснСклад; Исключение КонецПопытки;
	Если ЗначениеЗаполнено(Договор) Тогда
		Попытка Док1.ДоговорКонтрагента = Договор; Исключение КонецПопытки;
	КонецЕсли;
	// Счёт расчётов с контрагентом — в ЗАГОЛОВКЕ документа (кредит проводки)
	Если ЗначениеЗаполнено(Счёт6001) Тогда
		Попытка Док1.СчетУчетаРасчетовСКонтрагентом = Счёт6001; Исключение КонецПопытки;
	КонецЕсли;

	Для Каждого Эл Из Топливо Цикл
		НомТ = Справочники.Номенклатура.НайтиПоНаименованию(Эл.Тонны, Истина);
		Если Не ЗначениеЗаполнено(НомТ) Тогда Продолжить; КонецЕсли;
		Стр = Док1.Товары.Добавить();
		Стр.Номенклатура = НомТ;
		Стр.Количество = Эл.Кол_Т;
		Стр.Цена = Эл.Цена;
		Стр.Сумма = Эл.Кол_Т * Эл.Цена;
		// Счета учёта — явно (имена из метаданных БП 3.0)
		Попытка Стр.СчетУчета = Счёт4101; Исключение КонецПопытки;
		Попытка Стр.СчетРасчетов = Счёт6001; Исключение КонецПопытки;
		Попытка Стр.СчетУчетаНДС = Счёт1903; Исключение КонецПопытки;
		Если ЗначениеЗаполнено(СтавкаНДС) Тогда
			Попытка Стр.СтавкаНДС = СтавкаНДС; Исключение КонецПопытки;
			Попытка Стр.СуммаНДС = Окр(Эл.Кол_Т * Эл.Цена * 22 / 122, 2); Исключение КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Попытка
		Док1.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗаписьЖурналаРегистрации("TL_Маппинг", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка проведения Поступления: " + ОписаниеОшибки());
		ВызватьИсключение "Шаг 1 (Поступление): " + ОписаниеОшибки();
	КонецПопытки;

	// === ШАГ 2: Перемещение тонн: Основной → АЗС ===
	Док2 = Документы.ПеремещениеТоваров.СоздатьДокумент();
	Док2.Дата = ДатаДок;
	Док2.Организация = Организация;
	Док2.Комментарий = "TL|INIT|Перемещение на АЗС";
	Попытка Док2.СкладОтправитель = ОснСклад; Исключение КонецПопытки;
	Попытка Док2.СкладПолучатель = АЗССклад; Исключение КонецПопытки;

	Для Каждого Эл Из Топливо Цикл
		НомТ = Справочники.Номенклатура.НайтиПоНаименованию(Эл.Тонны, Истина);
		Если Не ЗначениеЗаполнено(НомТ) Тогда Продолжить; КонецЕсли;
		Стр = Док2.Товары.Добавить();
		Стр.Номенклатура = НомТ;
		Стр.Количество = Эл.Кол_Т;
		// Счета перемещения (из метаданных: СчетУчета + НовыйСчетУчета)
		Попытка Стр.СчетУчета = Счёт4101; Исключение КонецПопытки;
		Попытка Стр.НовыйСчетУчета = Счёт4101; Исключение КонецПопытки;
	КонецЦикла;

	Попытка
		Док2.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗаписьЖурналаРегистрации("TL_Маппинг", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка проведения Перемещения: " + ОписаниеОшибки());
		ВызватьИсключение "Шаг 2 (Перемещение): " + ОписаниеОшибки();
	КонецПопытки;

	// === ШАГ 3: Комплектация тонны → литры на АЗС ===
	Для Каждого Эл Из Топливо Цикл
		НомТ = Справочники.Номенклатура.НайтиПоНаименованию(Эл.Тонны, Истина);
		НомЛ = Справочники.Номенклатура.НайтиПоНаименованию(Эл.Литры, Истина);
		Если Не ЗначениеЗаполнено(НомТ) ИЛИ Не ЗначениеЗаполнено(НомЛ) Тогда Продолжить; КонецЕсли;

		Док3 = Документы.КомплектацияНоменклатуры.СоздатьДокумент();
		Док3.Дата = ДатаДок;
		Док3.Организация = Организация;
		Док3.Комментарий = "TL|INIT|Комплектация " + Эл.Тонны;
		Попытка Док3.Склад = АЗССклад; Исключение КонецПопытки;
		Попытка Док3.ВидОперации = Перечисления.ВидыОперацийКомплектацияНоменклатуры.Комплектация; Исключение КонецПопытки;

		// Счёт выпуска (литры → 41.02) в заголовке
		Попытка Док3.СчетУчета = Счёт4102; Исключение КонецПопытки;

		// Комплектующие (расход: тонны → 41.01)
		СтрР = Док3.Комплектующие.Добавить();
		СтрР.Номенклатура = НомТ;
		СтрР.Количество = Эл.Кол_Т;
		Попытка СтрР.СчетУчета = Счёт4101; Исключение КонецПопытки;

		// Выпуск (литры)
		Попытка Док3.Номенклатура = НомЛ; Исключение КонецПопытки;
		Попытка Док3.Количество = Эл.Кол_Л; Исключение КонецПопытки;

		Попытка
			Док3.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписьЖурналаРегистрации("TL_Маппинг", УровеньЖурналаРегистрации.Ошибка, , ,
				"Ошибка комплектации " + Эл.Тонны + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Заполнить регистр TL_МаппингОплат стандартными образцами.
// Единый источник правды — TL_Настройки.УстановитьЗначениеПоУмолчаниюГИГ
// (наш минимальный безопасный набор без слишком общих шаблонов вроде «карт» или «безнал»).
//
Процедура ЗаполнитьМаппингОплатПоУмолчанию() Экспорт

	TL_Настройки.УстановитьЗначениеПоУмолчаниюГИГ();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Найти вид топлива по внешнему коду в справочнике TL_ВидыТоплива.
//
Функция НайтиВидТоплива(КодТоплива) Экспорт

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Ссылка
			|ИЗ
			|	Справочник.TL_ВидыТоплива
			|ГДЕ
			|	ВнешнийКод = &ВнешнийКод
			|	И НЕ ПометкаУдаления";

		Запрос.УстановитьПараметр("ВнешнийКод", Строка(КодТоплива));
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
		// Справочник TL_ВидыТоплива не существует
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Fallback: поиск склада по маскам наименования (текущая логика).
//
Функция НайтиСкладПоМаскам(КодСтанции)

	КодСтр = XMLСтрока(КодСтанции);

	ИскатьИмена = Новый Массив;
	ИскатьИмена.Добавить("АЗС-" + КодСтр);
	ИскатьИмена.Добавить("АЗС " + КодСтр);
	ИскатьИмена.Добавить("Станция " + КодСтр);
	ИскатьИмена.Добавить("Ст." + КодСтр);
	ИскатьИмена.Добавить("АКАЗС " + КодСтр);
	ИскатьИмена.Добавить("АКАЗС-" + КодСтр);
	ИскатьИмена.Добавить("АГЗС " + КодСтр);
	ИскатьИмена.Добавить("АГЗС-" + КодСтр);

	Для Каждого Имя Из ИскатьИмена Цикл
		Склад = Справочники.Склады.НайтиПоНаименованию(Имя, Истина);
		Если ЗначениеЗаполнено(Склад) Тогда
			Возврат Склад;
		КонецЕсли;
	КонецЦикла;

	ЗаписьЖурналаРегистрации("TL_Маппинг",
		УровеньЖурналаРегистрации.Предупреждение, , ,
		"Склад не найден для станции " + XMLСтрока(КодСтанции)
		+ ". Проверьте справочник TL_АЗС или наименования складов.");

	Возврат Справочники.Склады.ПустаяСсылка();

КонецФункции

// Fallback: хардкод маппинг кодов топлива → наименования в 1С.
//
Функция НайтиНоменклатуруFallback(КодТоплива, Единица)

	Маппинг = Новый Соответствие;
	Маппинг.Вставить("92",  "АИ-92");
	Маппинг.Вставить("95",  "АИ-95");
	Маппинг.Вставить("98",  "АИ-98");
	Маппинг.Вставить("DT",  "ДТ");
	Маппинг.Вставить("dt",  "ДТ");
	Маппинг.Вставить("ДТ",  "ДТ");
	Маппинг.Вставить("DTw", "ДТ зимн.");

	ИмяТоплива = Маппинг.Получить(Строка(КодТоплива));
	Если ИмяТоплива = Неопределено Тогда
		ИмяТоплива = Строка(КодТоплива);
	КонецЕсли;

	Наименование = ИмяТоплива + " (" + Единица + ")";

	Возврат Справочники.Номенклатура.НайтиПоНаименованию(Наименование, Истина);

КонецФункции

#КонецОбласти
