Перем мРежимПовторнойПроверки;
Перем мРежимРазрешенияКонфликта;

#Область ПрограммныйИнтерфейс

Функция ОбработатьПакет(Пакет) Экспорт

	Предпроверка = ПроверитьПакет(Пакет);
	Если Не Предпроверка.Корректен Тогда
		ЗаписатьПопыткуПослеОтката(Пакет, Предпроверка.Результат,
			Предпроверка.КодОшибки, Предпроверка.ОписаниеОшибки);
		Возврат РезультатОтказаV3(Пакет, Предпроверка.Результат,
			Предпроверка.КодОшибки, Предпроверка.ОписаниеОшибки);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьГруппу(Предпроверка.BusinessKeyHash);
		ЗаблокироватьКомпоненты(Пакет, Предпроверка.BusinessKeyHash);
		мРежимПовторнойПроверки = Истина;
		Повторная = ПроверитьПакет(Пакет);
		мРежимПовторнойПроверки = Ложь;
		Если Не Повторная.Корректен Тогда
			ВызватьИсключение Повторная.КодОшибки + ": " + Повторная.ОписаниеОшибки;
		КонецЕсли;
		Если Повторная.ИдемпотентныйПовтор Тогда
			ПроверитьСуществующиеКомпоненты(Пакет, Повторная.BusinessKeyHash, Истина);
			КомпонентыПовтора = ПолучитьКомпонентыГруппы(Повторная.BusinessKeyHash);
			ЗаписатьПопытку(Пакет, "accepted", "", "");
			ЗафиксироватьТранзакцию();
			Возврат РезультатПринято(Пакет, КомпонентыПовтора);
		КонецЕсли;

		ПроверитьСуществующиеКомпоненты(Пакет, Повторная.BusinessKeyHash);
		АдаптированныйПакет = АдаптироватьПакет(Пакет, Повторная.Политика);
		РезультатЗаписи = TL_СопуткаСервис.ОбработатьАдаптированныйV3ВТранзакции(
			АдаптированныйПакет);
		Если РезультатЗаписи.Ошибки.Количество() > 0 Тогда
			ВызватьИсключение "writer_v3_returned_errors";
		КонецЕсли;
		Компоненты = ЗафиксироватьКомпоненты(Пакет, РезультатЗаписи.Документы,
			Повторная.BusinessKeyHash, Повторная.Ревизия);
		ЗаписатьТекущуюРевизию(Пакет);
		ЗаписатьПопытку(Пакет, "accepted", "", "");
		ЗафиксироватьТранзакцию();
		Возврат РезультатПринято(Пакет, Компоненты);
	Исключение
		мРежимПовторнойПроверки = Ложь;
		ТекстОшибки = ОписаниеОшибки();
		ОтменитьТранзакцию();
		Код = КлассифицироватьОшибку(ТекстОшибки);
		Статус = СтатусПоКодуОшибки(Код);
		ЗаписатьПопыткуПослеОтката(Пакет, Статус, Код, ТекстОшибки);
		Возврат РезультатОтказаV3(Пакет, Статус, Код, ТекстОшибки);
	КонецПопытки;

КонецФункции

Функция РазрешитьNeedsReview(Пакет, Действие, Пользователь, Причина) Экспорт

	Если Не (Действие = "retry" Или Действие = "ack")
		Или ПустаяСтрока(СокрЛП(Пользователь)) Или ПустаяСтрока(СокрЛП(Причина)) Тогда
		Возврат РезультатОтказаV3(Пакет, "rejected", "resolution_invalid",
			"Нужны действие retry|ack, пользователь и причина");
	КонецЕсли;
	BusinessKeyHash = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "BusinessKeyHash", ""));
	Если Не ЕстьОткрытыйNeedsReview(BusinessKeyHash) Тогда
		Возврат РезультатОтказаV3(Пакет, "rejected", "resolution_not_required",
			"Для business key нет открытого needs_review");
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьГруппу(BusinessKeyHash);
		Если Не ЕстьОткрытыйNeedsReview(BusinessKeyHash) Тогда
			ВызватьИсключение "resolution_not_required";
		КонецЕсли;
		Если Действие = "retry" Тогда
			ЗаписатьПопытку(Пакет, "resolved_retry", "manual_resolution",
				Пользователь + ": " + Причина);
			ЗафиксироватьТранзакцию();
			Возврат Новый Структура("Разрешено,Действие,BusinessKeyHash",
				Истина, "retry", BusinessKeyHash);
		КонецЕсли;

		ЗаблокироватьКомпоненты(Пакет, BusinessKeyHash);
		мРежимРазрешенияКонфликта = Истина;
		Проверка = ПроверитьПакет(Пакет);
		мРежимРазрешенияКонфликта = Ложь;
		Если Не Проверка.Корректен Или Проверка.ИдемпотентныйПовтор Тогда
			ВызватьИсключение "resolution_ack_preflight";
		КонецЕсли;
		ДокументыБП = ПолучитьСсылкиКомпонентов(BusinessKeyHash);
		Если ДокументыБП.Количество() = 0 Тогда
			ВызватьИсключение "resolution_ack_components_missing";
		КонецЕсли;
		Для Каждого Ссылка Из ДокументыБП Цикл
			Если ЭтоПроведенныйДокумент(Ссылка) Тогда
				ВызватьИсключение "posted_component";
			КонецЕсли;
		КонецЦикла;
		Компоненты = ЗафиксироватьКомпоненты(Пакет, ДокументыБП,
			BusinessKeyHash, Проверка.Ревизия);
		ЗаписатьТекущуюРевизию(Пакет);
		ЗаписатьПопытку(Пакет, "resolved_ack", "manual_resolution",
			Пользователь + ": " + Причина);
		ЗафиксироватьТранзакцию();
		Возврат РезультатПринято(Пакет, Компоненты);
	Исключение
		мРежимРазрешенияКонфликта = Ложь;
		ТекстОшибки = ОписаниеОшибки();
		ОтменитьТранзакцию();
		ЗаписатьПопыткуПослеОтката(Пакет, "needs_review", "resolution_failed", ТекстОшибки);
		Возврат РезультатОтказаV3(Пакет, "needs_review", "resolution_failed", ТекстОшибки);
	КонецПопытки;

КонецФункции

Функция ПроверитьНСИПакета(Пакет) Экспорт

	Результат = Новый Структура("Корректен,КодОшибки,ОписаниеОшибки,Индекс",
		Ложь, "nsi_invalid", "", Новый Соответствие);
	НСИ = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "НСИ", Новый Массив);
	Если КоличествоБезопасно(НСИ) < 0 Тогда
		Результат.ОписаниеОшибки = "НСИ v3 должна быть массивом";
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из НСИ Цикл
		ТипНСИ = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Элемент, "Тип", ""));
		UUID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Элемент, "ИсточникUUID", "")));
		ДопустимыйТип = ТипНСИ = "Организация" Или ТипНСИ = "Склад"
			Или ТипНСИ = "Контрагент" Или ТипНСИ = "Договор" Или ТипНСИ = "Номенклатура";
		Если ПустаяСтрока(UUID) Или Не ДопустимыйТип
			Или TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Элемент, "ПометкаУдаления", Ложь) Тогда
			Результат.ОписаниеОшибки = "НСИ v3 содержит неполный, неизвестный или удаленный элемент";
			Возврат Результат;
		КонецЕсли;
		Если ТипНСИ = "Номенклатура" Тогда
			Имя = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Элемент, "Наименование", "")));
			КлассSKU = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Элемент, "КлассSKU", ""));
			Если ПустаяСтрока(Имя)
				Или Не (КлассSKU = "Сопутка" Или КлассSKU = "Общепит") Тогда
				Результат.ОписаниеОшибки = "Номенклатура НСИ v3 не содержит имя или точный КлассSKU";
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Ключ = ТипНСИ + "|" + UUID;
		Если Результат.Индекс.Получить(Ключ) <> Неопределено Тогда
			Результат.ОписаниеОшибки = "Повторный элемент НСИ v3: " + Ключ;
			Возврат Результат;
		КонецЕсли;
		Результат.Индекс.Вставить(Ключ, Элемент);
	КонецЦикла;
	Результат.Корректен = Истина;
	Результат.КодОшибки = "";
	Возврат Результат;

КонецФункции

Функция ПроверитьПолнотуИСостав(Пакет)

	Результат = Новый Структура("Корректен,Результат,КодОшибки,ОписаниеОшибки",
		Ложь, "rejected", "completeness_invalid", "");
	ПроверкаНСИ = ПроверитьНСИПакета(Пакет);
	Если Не ПроверкаНСИ.Корректен Тогда
		Результат.КодОшибки = ПроверкаНСИ.КодОшибки;
		Результат.ОписаниеОшибки = ПроверкаНСИ.ОписаниеОшибки;
		Возврат Результат;
	КонецЕсли;
	ИндексНСИ = ПроверкаНСИ.Индекс;
	Полнота = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ПолнотаГруппы", Неопределено);
	Если Полнота = Неопределено
		Или Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Полнота, "Версия", "")) <> "1"
		Или Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Полнота, "Статус", "")) <> "complete" Тогда
		Результат.ОписаниеОшибки = "ПолнотаГруппы должна иметь Версия=1 и Статус=complete";
		Возврат Результат;
	КонецЕсли;

	ОжидаемыеИсточники = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(
		"cheques,cost_snapshot,exact_ttk,payments,production_snapshot,returns,shift_closure", ",") Цикл
		ОжидаемыеИсточники.Вставить(Имя, Ложь);
	КонецЦикла;
	Источники = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Полнота, "Источники", Новый Массив);
	Если КоличествоБезопасно(Источники) <> 7 Тогда
		Результат.ОписаниеОшибки = "ПолнотаГруппы должна содержать ровно семь источников";
		Возврат Результат;
	КонецЕсли;
	Для Каждого Источник Из Источники Цикл
		ТипИсточника = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Источник, "Тип", ""));
		Если ОжидаемыеИсточники.Получить(ТипИсточника) = Неопределено
			Или ОжидаемыеИсточники.Получить(ТипИсточника) Тогда
			Результат.ОписаниеОшибки = "Неизвестный или повторный источник полноты: " + ТипИсточника;
			Возврат Результат;
		КонецЕсли;
		ОжидаемыеИсточники.Вставить(ТипИсточника, Истина);
		Требуется = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Источник, "Требуется", Ложь);
		СтатусИсточника = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Источник, "Статус", ""));
		Количество = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Источник, "Количество", -1);
		SourceHash = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Источник, "SourceHash", ""));
		Если Требуется И СтатусИсточника <> "ready" Тогда
			Результат.ОписаниеОшибки = "Обязательный источник не готов: " + ТипИсточника;
			Возврат Результат;
		КонецЕсли;
		Если СтатусИсточника = "ready" И (Количество < 0 Или Не ЭтоHexV3(SourceHash, 64)) Тогда
			Результат.ОписаниеОшибки = "Некорректный ready-источник: " + ТипИсточника;
			Возврат Результат;
		КонецЕсли;
		Если СтатусИсточника = "not_applicable" И Количество <> 0 Тогда
			Результат.ОписаниеОшибки = "not_applicable источник должен иметь нулевое количество";
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Компоненты = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Полнота, "ОжидаемыеКомпоненты", Новый Массив);
	Если КоличествоБезопасно(Компоненты) = 0 Тогда
		Результат.ОписаниеОшибки = "ОжидаемыеКомпоненты не могут быть пустыми";
		Возврат Результат;
	КонецЕсли;
	КлючиКомпонентов = Новый Соответствие;
	ОжидаемыйПорядок = 1;
	ЕстьAssembly = Ложь;
	ЕстьDisassembly = Ложь;
	КоличествоAssembly = 0;
	КоличествоDisassembly = 0;
	Для Каждого Компонент Из Компоненты Цикл
		Порядок = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Компонент, "Порядок", 0);
		ТипКомпонента = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Компонент, "Тип", ""));
		ИсточникUUID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Компонент, "ИсточникUUID", "")));
		Если Порядок <> ОжидаемыйПорядок
			Или Не (ТипКомпонента = "assembly" Или ТипКомпонента = "retail" Или ТипКомпонента = "disassembly")
			Или ПустаяСтрока(ИсточникUUID) Тогда
			Результат.ОписаниеОшибки = "Некорректная последовательность ОжидаемыеКомпоненты";
			Возврат Результат;
		КонецЕсли;
		КлючКомпонента = ТипКомпонента + "|" + ИсточникUUID;
		Если КлючиКомпонентов.Получить(КлючКомпонента) <> Неопределено Тогда
			Результат.ОписаниеОшибки = "Повторный ожидаемый компонент " + КлючКомпонента;
			Возврат Результат;
		КонецЕсли;
		КлючиКомпонентов.Вставить(КлючКомпонента, Истина);
		ЕстьAssembly = ЕстьAssembly Или ТипКомпонента = "assembly";
		ЕстьDisassembly = ЕстьDisassembly Или ТипКомпонента = "disassembly";
		Если ТипКомпонента = "assembly" Тогда КоличествоAssembly = КоличествоAssembly + 1; КонецЕсли;
		Если ТипКомпонента = "disassembly" Тогда КоличествоDisassembly = КоличествоDisassembly + 1; КонецЕсли;
		ОжидаемыйПорядок = ОжидаемыйПорядок + 1;
	КонецЦикла;

	Документы = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Документы", Новый Массив);
	RetailКоличество = 0;
	ЕстьProduction = Ложь;
	ЕстьБлюда = Ложь;
	ЕстьВозвратБлюд = Ложь;
	Блюда = Новый Соответствие;
	ПроданныеБлюда = Новый Соответствие;
	ВозвращенныеБлюда = Новый Соответствие;
	БлюдаВыпуска = Новый Соответствие;
	Для Каждого Док Из Документы Цикл
		ТипДок = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Тип", ""));
		Роль = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "РольВГруппе", ""));
		ХешДок = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "SourceHash", ""));
		Содержимое = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Содержимое", Неопределено);
		Если ПустаяСтрока(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", "")))
			Или Не ЭтоHexV3(ХешДок, 64) Или Содержимое = Неопределено Тогда
			Результат.ОписаниеОшибки = "Документ v3 не содержит identity/source hash/content";
			Возврат Результат;
		КонецЕсли;
		Если ВычислитьХешЗначения(Содержимое) <> ХешДок Тогда
			Результат.КодОшибки = "source_hash_mismatch";
			Результат.ОписаниеОшибки = "SourceHash документа не совпадает с Содержимое";
			Возврат Результат;
		КонецЕсли;
		Если ТипДок = "production_release" И Роль = "evidence" Тогда
			ЕстьProduction = Истина;
			Для Каждого СтрокаВыпуска Из TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
					Содержимое, "ВыпускБлюд", Новый Массив) Цикл
				БлюдоUUID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
					СтрокаВыпуска, "НоменклатураUUID", ""));
				Если ПустаяСтрока(БлюдоUUID)
					Или ИндексНСИ.Получить("Номенклатура|" + БлюдоUUID) = Неопределено Тогда
					Результат.Результат = "blocked_mapping";
					Результат.КодОшибки = "blocked_mapping";
					Результат.ОписаниеОшибки = "Блюдо production evidence отсутствует в exact НСИ: " + БлюдоUUID;
					Возврат Результат;
				КонецЕсли;
				БлюдаВыпуска.Вставить(БлюдоUUID, Истина);
			КонецЦикла;
			БлюдоUUID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
				Содержимое, "БлюдоUUID", ""));
			Если Не ПустаяСтрока(БлюдоUUID) Тогда
				Если ИндексНСИ.Получить("Номенклатура|" + БлюдоUUID) = Неопределено Тогда
					Результат.Результат = "blocked_mapping";
					Результат.КодОшибки = "blocked_mapping";
					Результат.ОписаниеОшибки = "Блюдо production evidence отсутствует в exact НСИ: " + БлюдоUUID;
					Возврат Результат;
				КонецЕсли;
				БлюдаВыпуска.Вставить(БлюдоUUID, Истина);
			КонецЕсли;
		ИначеЕсли ТипДок = "ingredients_writeoff" И Роль = "absorbed" Тогда
			ПоглощенКомпонентом = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Содержимое,
				"ПоглощенКомпонентом", ""));
			ПоглощенКомпонентами = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Содержимое,
				"ПоглощенКомпонентами", Новый Массив);
			Если ПустаяСтрока(ПоглощенКомпонентом)
				И КоличествоБезопасно(ПоглощенКомпонентами) = 0 Тогда
				Результат.ОписаниеОшибки = "ingredients_writeoff не связан с assembly";
				Возврат Результат;
			КонецЕсли;
		ИначеЕсли ТипДок = "return_sale" И Роль = "embedded" Тогда
			Продолжить;
		ИначеЕсли ТипДок = "retail_sale_sidegoods" И Роль = "materialized" Тогда
			RetailКоличество = RetailКоличество + 1;
			Если TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Содержимое, "Проведен", Истина) Тогда
				Результат.ОписаниеОшибки = "v3 принимает только непроведенный retail";
				Возврат Результат;
			КонецЕсли;
			Продажи = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Содержимое, "Продажи", Новый Массив);
			Возвраты = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Содержимое, "Возвраты", Новый Массив);
			Для Каждого СтрокаПродажи Из Продажи Цикл
				SKUUUID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
					СтрокаПродажи, "НоменклатураUUID", ""));
				Если ПустаяСтрока(SKUUUID)
					Или ИндексНСИ.Получить("Номенклатура|" + SKUUUID) = Неопределено Тогда
					Результат.Результат = "blocked_mapping";
					Результат.КодОшибки = "blocked_mapping";
					Результат.ОписаниеОшибки = "Номенклатура продажи отсутствует в exact НСИ: " + SKUUUID;
					Возврат Результат;
				КонецЕсли;
				ЭлементНСИ = ИндексНСИ.Получить("Номенклатура|" + SKUUUID);
				Если Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрокаПродажи, "КлассSKU", "")) <>
					Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ЭлементНСИ, "КлассSKU", "")) Тогда
					Результат.ОписаниеОшибки = "КлассSKU продажи не совпадает с exact НСИ: " + SKUUUID;
					Возврат Результат;
				КонецЕсли;
				Если ЭтоСтрокаБлюда(СтрокаПродажи) Тогда
					ЕстьБлюда = Истина;
					Блюда.Вставить(SKUUUID, Истина);
					ПроданныеБлюда.Вставить(SKUUUID, Истина);
				КонецЕсли;
			КонецЦикла;
			Для Каждого СтрокаВозврата Из Возвраты Цикл
				SKUUUID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
					СтрокаВозврата, "НоменклатураUUID", ""));
				Если ПустаяСтрока(SKUUUID)
					Или ИндексНСИ.Получить("Номенклатура|" + SKUUUID) = Неопределено Тогда
					Результат.Результат = "blocked_mapping";
					Результат.КодОшибки = "blocked_mapping";
					Результат.ОписаниеОшибки = "Номенклатура возврата отсутствует в exact НСИ: " + SKUUUID;
					Возврат Результат;
				КонецЕсли;
				ЭлементНСИ = ИндексНСИ.Получить("Номенклатура|" + SKUUUID);
				Если Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрокаВозврата, "КлассSKU", "")) <>
					Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ЭлементНСИ, "КлассSKU", "")) Тогда
					Результат.ОписаниеОшибки = "КлассSKU возврата не совпадает с exact НСИ: " + SKUUUID;
					Возврат Результат;
				КонецЕсли;
				Если ЭтоСтрокаБлюда(СтрокаВозврата) Тогда
					ЕстьВозвратБлюд = Истина;
					Блюда.Вставить(SKUUUID, Истина);
					ВозвращенныеБлюда.Вставить(SKUUUID, Истина);
				КонецЕсли;
			КонецЦикла;
			Для Каждого Оплата Из TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Содержимое, "Оплаты", Новый Массив) Цикл
				ВидОплаты = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Оплата, "Вид", ""));
				Если Не (ВидОплаты = "Наличные" Или ВидОплаты = "Безнал") Тогда
					Результат.Результат = "blocked_mapping";
					Результат.КодОшибки = "blocked_mapping";
					Результат.ОписаниеОшибки = "Неизвестный канонический вид оплаты: " + ВидОплаты;
					Возврат Результат;
				КонецЕсли;
				Если ВидОплаты = "Безнал"
					И Не ЗначениеЗаполнено(TL_МаппингЦБ.НайтиВидОплатыРозницаБезСоздания("Безнал")) Тогда
					Результат.Результат = "blocked_mapping";
					Результат.КодОшибки = "blocked_mapping";
					Результат.ОписаниеОшибки = "В БП нет утвержденного вида оплаты Безнал";
					Возврат Результат;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Результат.ОписаниеОшибки = "Недопустимая пара Тип/РольВГруппе: " + ТипДок + "/" + Роль;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Если RetailКоличество <> 1 Тогда
		Результат.ОписаниеОшибки = "В группе должен быть ровно один materialized retail";
		Возврат Результат;
	КонецЕсли;
	Если ПроданныеБлюда.Количество() > 0 И (Не ЕстьAssembly Или Не ЕстьProduction) Тогда
		Результат.ОписаниеОшибки = "Продажа общепита требует production evidence и assembly";
		Возврат Результат;
	КонецЕсли;
	Если ЕстьВозвратБлюд И Не ЕстьDisassembly Тогда
		Результат.ОписаниеОшибки = "Возврат общепита требует disassembly";
		Возврат Результат;
	КонецЕсли;
	Если КоличествоAssembly <> ПроданныеБлюда.Количество()
		Или КоличествоDisassembly <> ВозвращенныеБлюда.Количество() Тогда
		Результат.ОписаниеОшибки = "Число assembly/disassembly не совпадает с числом блюд";
		Возврат Результат;
	КонецЕсли;
	ТТКПоБлюду = Новый Соответствие;
	Для Каждого ТТК Из TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ТТК", Новый Массив) Цикл
		БлюдоUUID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ТТК, "БлюдоUUID", ""));
		Если ПустаяСтрока(БлюдоUUID) Или ТТКПоБлюду.Получить(БлюдоUUID) <> Неопределено
			Или TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ТТК, "РевизияТТК", 0) < 1
			Или Не ЭтоHexV3(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ТТК, "BundleHash", "")), 64) Тогда
			Результат.ОписаниеОшибки = "Некорректная или повторная exact ТТК";
			Возврат Результат;
		КонецЕсли;
		Ингредиенты = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ТТК, "Ингредиенты", Новый Массив);
		Если КоличествоБезопасно(Ингредиенты) = 0 Тогда
			Результат.ОписаниеОшибки = "Exact ТТК не содержит ингредиентов";
			Возврат Результат;
		КонецЕсли;
		Если ИндексНСИ.Получить("Номенклатура|" + БлюдоUUID) = Неопределено Тогда
			Результат.Результат = "blocked_mapping";
			Результат.КодОшибки = "blocked_mapping";
			Результат.ОписаниеОшибки = "Блюдо exact ТТК отсутствует в exact НСИ: " + БлюдоUUID;
			Возврат Результат;
		КонецЕсли;
		ИнгредиентыТТК = Новый Соответствие;
		Для Каждого Ингредиент Из Ингредиенты Цикл
			ИнгредиентUUID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
				Ингредиент, "ИнгредиентUUID", ""));
			Если ПустаяСтрока(ИнгредиентUUID)
				Или ЧислоБезопасноV3(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
					Ингредиент, "Количество", 0)) <= 0 Тогда
				Результат.ОписаниеОшибки = "Exact ТТК содержит пустой ингредиент или количество";
				Возврат Результат;
			КонецЕсли;
			Если ИнгредиентыТТК.Получить(ИнгредиентUUID) <> Неопределено Тогда
				Результат.ОписаниеОшибки = "Exact ТТК содержит повторный ингредиент: " + ИнгредиентUUID;
				Возврат Результат;
			КонецЕсли;
			ИнгредиентыТТК.Вставить(ИнгредиентUUID, Истина);
			Если ИндексНСИ.Получить("Номенклатура|" + ИнгредиентUUID) = Неопределено Тогда
				Результат.Результат = "blocked_mapping";
				Результат.КодОшибки = "blocked_mapping";
				Результат.ОписаниеОшибки = "Ингредиент отсутствует в exact НСИ: " + ИнгредиентUUID;
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
		ТТКПоБлюду.Вставить(БлюдоUUID, Истина);
	КонецЦикла;
	Если ЕстьБлюда И ТТКПоБлюду.Количество() = 0 Тогда
		Результат.Результат = "blocked_mapping";
		Результат.КодОшибки = "blocked_mapping";
		Результат.ОписаниеОшибки = "Для общепита отсутствует exact ТТК";
		Возврат Результат;
	КонецЕсли;
	Для Каждого ПараБлюда Из Блюда Цикл
		Если ИндексНСИ.Получить("Номенклатура|" + ПараБлюда.Ключ) = Неопределено Тогда
			Результат.Результат = "blocked_mapping";
			Результат.КодОшибки = "blocked_mapping";
			Результат.ОписаниеОшибки = "Блюдо отсутствует в exact НСИ: " + ПараБлюда.Ключ;
			Возврат Результат;
		КонецЕсли;
		Если ТТКПоБлюду.Получить(ПараБлюда.Ключ) = Неопределено Тогда
			Результат.ОписаниеОшибки = "Для блюда нет ровно одной exact ТТК: " + ПараБлюда.Ключ;
			Возврат Результат;
		КонецЕсли;
		Если ПроданныеБлюда.Получить(ПараБлюда.Ключ) <> Неопределено
			И БлюдаВыпуска.Получить(ПараБлюда.Ключ) = Неопределено Тогда
			Результат.ОписаниеОшибки = "Для блюда нет production evidence: " + ПараБлюда.Ключ;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Результат.Корректен = Истина;
	Результат.КодОшибки = "";
	Результат.ОписаниеОшибки = "";
	Возврат Результат;

КонецФункции

Функция ПолучитьДовереннуюПолитику(CompanyID, StationID)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| П.PolicyID,
		| П.РевизияПолитики,
		| П.ХешПолитики,
		| П.TransportProducer,
		| П.ДатаОтсечкиТранспорта,
		| П.ОрганизацияUUID,
		| П.СкладUUID
		|ИЗ РегистрСведений.TL_ДоверенныеПолитики КАК П
		|ГДЕ П.CompanyID = &CompanyID
		| И П.StationID = &StationID
		| И П.Активна = ИСТИНА");
	Запрос.УстановитьПараметр("CompanyID", CompanyID);
	Запрос.УстановитьПараметр("StationID", StationID);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура(
		"PolicyID,РевизияПолитики,ХешПолитики,TransportProducer,ДатаОтсечкиТранспорта,ОрганизацияUUID,СкладUUID",
		Выборка.PolicyID, Выборка.РевизияПолитики, Выборка.ХешПолитики,
		Выборка.TransportProducer, Выборка.ДатаОтсечкиТранспорта,
		Выборка.ОрганизацияUUID, Выборка.СкладUUID);
	Если Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПолучитьПолитикиСтанции(StationID)

	Результат = Новый Массив;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ П.CompanyID, П.PolicyID, П.РевизияПолитики, П.ХешПолитики,
		| П.TransportProducer, П.ДатаОтсечкиТранспорта, П.ОрганизацияUUID, П.СкладUUID
		|ИЗ РегистрСведений.TL_ДоверенныеПолитики КАК П
		|ГДЕ П.StationID = &StationID И П.Активна = ИСТИНА");
	Запрос.УстановитьПараметр("StationID", StationID);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура(
			"CompanyID,PolicyID,РевизияПолитики,ХешПолитики,TransportProducer,ДатаОтсечкиТранспорта,ОрганизацияUUID,СкладUUID",
			Выборка.CompanyID, Выборка.PolicyID, Выборка.РевизияПолитики,
			Выборка.ХешПолитики, Выборка.TransportProducer, Выборка.ДатаОтсечкиТранспорта,
			Выборка.ОрганизацияUUID, Выборка.СкладUUID));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПроверитьРевизию(BusinessKeyHash, Ревизия, Хеш)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 РевизияПакета, ХешПакета
		|ИЗ РегистрСведений.TL_ТекущиеРевизии
		|ГДЕ BusinessKeyHash = &BusinessKeyHash");
	Запрос.УстановитьПараметр("BusinessKeyHash", BusinessKeyHash);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ПроверитьПравилоРевизии(Выборка.РевизияПакета,
			Строка(Выборка.ХешПакета), Ревизия, Хеш);
	КонецЕсли;
	Возврат ПроверитьПравилоРевизии(Неопределено, "", Ревизия, Хеш);

КонецФункции

Процедура ЗаблокироватьГруппу(BusinessKeyHash)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.TL_ТекущиеРевизии");
	Элемент.УстановитьЗначение("BusinessKeyHash", BusinessKeyHash);
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ЗаблокироватьКомпоненты(Пакет, BusinessKeyHash)

	Ссылки = Новый Массив;
	Добавленные = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ СсылкаОбъект
		|ИЗ РегистрСведений.TL_КомпонентыГруппы
		|ГДЕ BusinessKeyHash = &BusinessKeyHash");
	Запрос.УстановитьПараметр("BusinessKeyHash", BusinessKeyHash);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьСсылкуДляБлокировки(Ссылки, Добавленные, Выборка.СсылкаОбъект);
	КонецЦикла;
	Для Каждого Док Из TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Документы", Новый Массив) Цикл
		Если Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Тип", "")) = "retail_sale_sidegoods" Тогда
			ИсточникUUID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", ""));
			Ссылка = TL_МаппингЦБ.НайтиСоответствие(
				Перечисления.TL_ТипОбъектаИсточника.ОтчётОРозничныхПродажах, ИсточникUUID);
			ДобавитьСсылкуДляБлокировки(Ссылки, Добавленные, Ссылка);
		КонецЕсли;
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Ссылка Из Ссылки Цикл
		ИмяМетаданных = Ссылка.Метаданные().Имя;
		Если ИмяМетаданных = "ОтчетОРозничныхПродажах"
			Или ИмяМетаданных = "КомплектацияНоменклатуры" Тогда
			Элемент = Блокировка.Добавить("Документ." + ИмяМетаданных);
			Элемент.УстановитьЗначение("Ссылка", Ссылка);
		КонецЕсли;
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ДобавитьСсылкуДляБлокировки(Ссылки, Добавленные, Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Ключ = UUIDСсылки(Ссылка);
	Если ПустаяСтрока(Ключ) Или Добавленные.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Добавленные.Вставить(Ключ, Истина);
	Ссылки.Добавить(Ссылка);
КонецПроцедуры

Процедура ПроверитьСуществующиеКомпоненты(Пакет, BusinessKeyHash, ТребоватьПолныйСостав = Ложь)

	ОжидаемыеКлючи = Новый Соответствие;
	Если ТребоватьПолныйСостав Тогда
		Полнота = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ПолнотаГруппы", Новый Структура);
		Ожидаемые = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Полнота, "ОжидаемыеКомпоненты", Новый Массив);
		Для Каждого ОжидаемыйКомпонент Из Ожидаемые Цикл
			ОжидаемыйКлюч = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
				ОжидаемыйКомпонент, "Тип", "")) + "|" +
				Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
					ОжидаемыйКомпонент, "ИсточникUUID", ""));
			ОжидаемыеКлючи.Вставить(ОжидаемыйКлюч, Истина);
		КонецЦикла;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Тип, ИсточникUUID, SourceHash, СсылкаОбъект, TargetHash, Проведен
		|ИЗ РегистрСведений.TL_КомпонентыГруппы
		|ГДЕ BusinessKeyHash = &BusinessKeyHash");
	Запрос.УстановитьПараметр("BusinessKeyHash", BusinessKeyHash);
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоКомпонентов = 0;
	Пока Выборка.Следующий() Цикл
		КоличествоКомпонентов = КоличествоКомпонентов + 1;
		Если ТребоватьПолныйСостав И ОжидаемыеКлючи.Получить(
			Строка(Выборка.Тип) + "|" + Строка(Выборка.ИсточникUUID)) = Неопределено Тогда
			ВызватьИсключение "component_source_hash_conflict";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.СсылкаОбъект) Тогда
			ВызватьИсключение "target_component_missing";
		КонецЕсли;
		Если Выборка.Проведен Или ЭтоПроведенныйДокумент(Выборка.СсылкаОбъект) Тогда
			ВызватьИсключение "posted_component";
		КонецЕсли;
		Если ЭтоПомеченныйНаУдалениеДокумент(Выборка.СсылкаОбъект) Тогда
			ВызватьИсключение "deleted_component";
		КонецЕсли;
		Если Не ЭтоHexV3(Строка(Выборка.TargetHash), 64)
			Или ВычислитьХешЦели(Выборка.СсылкаОбъект) <> Строка(Выборка.TargetHash) Тогда
			ВызватьИсключение "target_hash_conflict";
		КонецЕсли;
		Если ТребоватьПолныйСостав И (Не ЭтоHexV3(Строка(Выборка.SourceHash), 64)
			Или Строка(Выборка.SourceHash) <> ПолучитьSourceHashКомпонента(
				Пакет, Строка(Выборка.Тип), Строка(Выборка.ИсточникUUID))) Тогда
			ВызватьИсключение "component_source_hash_conflict";
		КонецЕсли;
	КонецЦикла;
	Если ТребоватьПолныйСостав Тогда
		Если КоличествоКомпонентов <> КоличествоБезопасно(Ожидаемые) Тогда
			ВызватьИсключение "target_component_missing";
		КонецЕсли;
	КонецЕсли;

	Для Каждого Док Из TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Документы", Новый Массив) Цикл
		Если Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Тип", "")) = "retail_sale_sidegoods" Тогда
			ИсточникUUID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "ИсточникUUID", ""));
			Ссылка = TL_МаппингЦБ.НайтиСоответствие(
				Перечисления.TL_ТипОбъектаИсточника.ОтчётОРозничныхПродажах, ИсточникUUID);
			Если ЗначениеЗаполнено(Ссылка) И ЭтоПроведенныйДокумент(Ссылка) Тогда
				ВызватьИсключение "posted_component";
			КонецЕсли;
			Если ЗначениеЗаполнено(Ссылка) И ЭтоПомеченныйНаУдалениеДокумент(Ссылка) Тогда
				ВызватьИсключение "deleted_component";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЗафиксироватьКомпоненты(Пакет, ДокументыБП, BusinessKeyHash, Ревизия)

	Кандидаты = Новый Массив;
	Для Каждого Ссылка Из ДокументыБП Цикл
		ТипКомпонента = ТипКомпонентаПоСсылке(Ссылка);
		Если Не ПустаяСтрока(ТипКомпонента) Тогда
			Кандидаты.Добавить(Новый Структура("Тип,Ссылка,Использован",
				ТипКомпонента, Ссылка, Ложь));
		КонецЕсли;
	КонецЦикла;

	Полнота = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ПолнотаГруппы", Новый Структура);
	Ожидаемые = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Полнота, "ОжидаемыеКомпоненты", Новый Массив);
	Набор = РегистрыСведений.TL_КомпонентыГруппы.СоздатьНаборЗаписей();
	Набор.Отбор.BusinessKeyHash.Установить(BusinessKeyHash);
	Результат = Новый Массив;
	Для Каждого Ожидаемый Из Ожидаемые Цикл
		ТипКомпонента = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Ожидаемый, "Тип", ""));
		ИсточникUUID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Ожидаемый, "ИсточникUUID", ""));
		Кандидат = НайтиКандидатКомпонента(Кандидаты, ТипКомпонента, ИсточникUUID);
		Если Кандидат = Неопределено Тогда
			ВызватьИсключение "component_count_mismatch";
		КонецЕсли;
		Кандидат.Использован = Истина;
		TargetHash = ВычислитьХешЦели(Кандидат.Ссылка);
		Если ПустаяСтрока(TargetHash) Тогда
			ВызватьИсключение "target_hash_unavailable";
		КонецЕсли;
		SourceHash = ПолучитьSourceHashКомпонента(Пакет, ТипКомпонента, ИсточникUUID);
		Запись = Набор.Добавить();
		Запись.BusinessKeyHash = BusinessKeyHash;
		Запись.Порядок = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Ожидаемый, "Порядок", 0);
		Запись.Тип = ТипКомпонента;
		Запись.ИсточникUUID = ИсточникUUID;
		Запись.SourceHash = SourceHash;
		Запись.TargetHash = TargetHash;
		Запись.СсылкаОбъект = Кандидат.Ссылка;
		Запись.Проведен = Ложь;
		Запись.РевизияПакета = Ревизия;
		Результат.Добавить(СоздатьРезультатКомпонента(Запись.Порядок,
			ТипКомпонента, ИсточникUUID, Кандидат.Ссылка, SourceHash, TargetHash));
	КонецЦикла;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Не Кандидат.Использован Тогда
			ВызватьИсключение "component_count_mismatch";
		КонецЕсли;
	КонецЦикла;
	Набор.Записать(Истина);
	Возврат Результат;

КонецФункции

Процедура ЗаписатьТекущуюРевизию(Пакет)

	Менеджер = РегистрыСведений.TL_ТекущиеРевизии.СоздатьМенеджерЗаписи();
	Менеджер.BusinessKeyHash = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "BusinessKeyHash", ""));
	Менеджер.BusinessShiftID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "BusinessShiftID", ""));
	Менеджер.ИдентификаторПакета = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ИдентификаторПакета", ""));
	Менеджер.РевизияПакета = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "РевизияПакета", 0);
	Менеджер.ХешПакета = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ХешПакета", ""));
	Менеджер.TransportProducer = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "TransportProducer", ""));
	Менеджер.ПринятоВ = ТекущаяДатаСеанса();
	Менеджер.Записать();

КонецПроцедуры

Процедура ЗаписатьПопытку(Пакет, Результат, КодОшибки, ОписаниеОшибки)

	BusinessKeyHash = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "BusinessKeyHash", ""));
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(МАКСИМУМ(НомерПопытки), 0) КАК ПоследнийНомер
		|ИЗ РегистрСведений.TL_ПопыткиПриема
		|ГДЕ BusinessKeyHash = &BusinessKeyHash");
	Запрос.УстановитьПараметр("BusinessKeyHash", BusinessKeyHash);
	ПоследнийНомер = Запрос.Выполнить().Выгрузить()[0].ПоследнийНомер;
	Менеджер = РегистрыСведений.TL_ПопыткиПриема.СоздатьМенеджерЗаписи();
	Менеджер.AttemptID = Строка(Новый УникальныйИдентификатор);
	Менеджер.BusinessKeyHash = BusinessKeyHash;
	Менеджер.BusinessShiftID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "BusinessShiftID", ""));
	Менеджер.ИдентификаторПакета = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ИдентификаторПакета", ""));
	Менеджер.РевизияПакета = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "РевизияПакета", 0);
	Менеджер.ХешПакета = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ХешПакета", ""));
	Менеджер.TransportProducer = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "TransportProducer", ""));
	Менеджер.НомерПопытки = ПоследнийНомер + 1;
	Менеджер.Результат = Результат;
	Менеджер.КодОшибки = Лев(КодОшибки, 100);
	Менеджер.ОписаниеОшибки = Лев(ОписаниеОшибки, 1000);
	Менеджер.ПолученоВ = ТекущаяДатаСеанса();
	Менеджер.Записать();

КонецПроцедуры

Процедура ЗаписатьПопыткуПослеОтката(Пакет, Результат, КодОшибки, ОписаниеОшибки)

	НачатьТранзакцию();
	Попытка
		BusinessKeyHash = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
			Пакет, "BusinessKeyHash", ""));
		Если СтрДлина(BusinessKeyHash) = 64 Тогда
			ЗаблокироватьГруппу(BusinessKeyHash);
		КонецЕсли;
		ЗаписатьПопытку(Пакет, Результат, КодОшибки, ОписаниеОшибки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьКомпонентыГруппы(BusinessKeyHash)

	Результат = Новый Массив;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Порядок, Тип, ИсточникUUID, СсылкаОбъект, SourceHash, TargetHash, Проведен
		|ИЗ РегистрСведений.TL_КомпонентыГруппы
		|ГДЕ BusinessKeyHash = &BusinessKeyHash
		|УПОРЯДОЧИТЬ ПО Порядок");
	Запрос.УстановитьПараметр("BusinessKeyHash", BusinessKeyHash);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(СоздатьРезультатКомпонента(Выборка.Порядок,
			Выборка.Тип, Выборка.ИсточникUUID, Выборка.СсылкаОбъект,
			Выборка.SourceHash, Выборка.TargetHash));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПолучитьДокументыГруппы(BusinessKeyHash)

	Результат = Новый Массив;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ СсылкаОбъект
		|ИЗ РегистрСведений.TL_КомпонентыГруппы
		|ГДЕ BusinessKeyHash = &BusinessKeyHash
		|УПОРЯДОЧИТЬ ПО Порядок");
	Запрос.УстановитьПараметр("BusinessKeyHash", BusinessKeyHash);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.СсылкаОбъект);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПолучитьСсылкиКомпонентов(BusinessKeyHash)
	Возврат ПолучитьДокументыГруппы(BusinessKeyHash);
КонецФункции

Функция ЕстьОткрытыйNeedsReview(BusinessKeyHash)

	Если ПустаяСтрока(BusinessKeyHash) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Результат
		|ИЗ РегистрСведений.TL_ПопыткиПриема
		|ГДЕ BusinessKeyHash = &BusinessKeyHash
		| И (Результат = ""needs_review""
		|  ИЛИ Результат = ""resolved_retry""
		|  ИЛИ Результат = ""resolved_ack"")
		|УПОРЯДОЧИТЬ ПО НомерПопытки УБЫВ");
	Запрос.УстановитьПараметр("BusinessKeyHash", BusinessKeyHash);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий() И Строка(Выборка.Результат) = "needs_review";

КонецФункции

Функция РезультатПринято(Пакет, Компоненты)

	Результат = БазовыйРезультатV3(Пакет, "accepted", "", "", Компоненты);
	Результат.Статус = Перечисления.TL_СтатусПакета.ПринятоЦеликом;
	Результат.Документы = ПолучитьДокументыГруппы(Строка(
		TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "BusinessKeyHash", "")));
	Возврат Результат;

КонецФункции

Функция РезультатОтказаV3(Пакет, РезультатОбработки, КодОшибки, ОписаниеОшибки)

	Результат = БазовыйРезультатV3(Пакет, РезультатОбработки,
		КодОшибки, ОписаниеОшибки, Новый Массив);
	Если РезультатОбработки = "needs_review" Тогда
		Результат.Статус = Перечисления.TL_СтатусПакета.ТребуетПроверки;
	ИначеЕсли РезультатОбработки = "blocked_mapping" Тогда
		Результат.Статус = Перечисления.TL_СтатусПакета.ЗаблокированоМаппингом;
	Иначе
		Результат.Статус = Перечисления.TL_СтатусПакета.Отклонено;
	КонецЕсли;
	Результат.Ошибки.Добавить(ОписаниеОшибки);
	Возврат Результат;

КонецФункции

Функция БазовыйРезультатV3(Пакет, РезультатОбработки, КодОшибки, ОписаниеОшибки, Компоненты)

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторПакета", Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "ИдентификаторПакета", "")));
	Результат.Вставить("BusinessShiftID", Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "BusinessShiftID", "")));
	Результат.Вставить("BusinessKeyHash", Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "BusinessKeyHash", "")));
	Результат.Вставить("РевизияПакета", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "РевизияПакета", 0));
	Результат.Вставить("ХешПакета", Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "ХешПакета", "")));
	Результат.Вставить("Результат", РезультатОбработки);
	Результат.Вставить("КодОшибки", ?(ПустаяСтрока(КодОшибки), Неопределено, КодОшибки));
	Результат.Вставить("ОписаниеОшибки", ?(ПустаяСтрока(ОписаниеОшибки), Неопределено, ОписаниеОшибки));
	Результат.Вставить("Компоненты", Компоненты);
	Результат.Вставить("Статус", Перечисления.TL_СтатусПакета.Отклонено);
	Результат.Вставить("Документы", Новый Массив);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("ВсегоДокументов", КоличествоБезопасно(
		TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Документы", Новый Массив)));
	Результат.Вставить("ВсегоНСИ", КоличествоБезопасно(
		TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "НСИ", Новый Массив)));
	Возврат Результат;

КонецФункции

Функция СоздатьРезультатКомпонента(Порядок, ТипКомпонента, ИсточникUUID,
	Ссылка, SourceHash, TargetHash)

	Результат = Новый Структура;
	Результат.Вставить("Порядок", Порядок);
	Результат.Вставить("Тип", ТипКомпонента);
	Результат.Вставить("ИсточникUUID", ИсточникUUID);
	Результат.Вставить("СсылкаБП", НавигационнаяСсылка(Ссылка));
	Результат.Вставить("SourceHash", SourceHash);
	Результат.Вставить("TargetHash", TargetHash);
	Результат.Вставить("Проведен", Ложь);
	Результат.Вставить("Результат", "accepted");
	Результат.Вставить("КодОшибки", Неопределено);
	Результат.Вставить("ОписаниеОшибки", Неопределено);
	Возврат Результат;

КонецФункции

Функция АдаптироватьДокументы(Пакет, Политика, ДатаДокумента)

	Результат = Новый Массив;
	Для Каждого ТТК Из TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ТТК", Новый Массив) Цикл
		Рецепт = Новый Структура;
		Рецепт.Вставить("Тип", "recipe");
		Рецепт.Вставить("ИсточникUUID", Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
			ТТК, "ИдентификаторТТК", "")));
		Рецепт.Вставить("БлюдоUUID", Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
			ТТК, "БлюдоUUID", "")));
		Рецепт.Вставить("БлюдоНаименование", "ТТК " + Рецепт.БлюдоUUID);
		Рецепт.Вставить("ВерсияТТК", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ТТК, "РевизияТТК", 0));
		Рецепт.Вставить("ВерсияНабораТТК", Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
			ТТК, "BundleHash", "")));
		Ингредиенты = Новый Массив;
		Для Каждого ИнгредиентV3 Из TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
				ТТК, "Ингредиенты", Новый Массив) Цикл
			Ингредиенты.Добавить(Новый Структура("НоменклатураUUID,Количество,Наименование",
				Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ИнгредиентV3, "ИнгредиентUUID", "")),
				ЧислоБезопасноV3(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ИнгредиентV3, "Количество", 0)), ""));
		КонецЦикла;
		Рецепт.Вставить("Ингредиенты", Ингредиенты);
		Результат.Добавить(Рецепт);
	КонецЦикла;

	RetailV3 = Неопределено;
	Для Каждого ДокV3 Из TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Документы", Новый Массив) Цикл
		Если Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ДокV3, "Тип", "")) = "retail_sale_sidegoods" Тогда
			Если RetailV3 <> Неопределено Тогда
				ВызватьИсключение "retail_component_ambiguous";
			КонецЕсли;
			RetailV3 = ДокV3;
		КонецЕсли;
	КонецЦикла;
	Если RetailV3 = Неопределено Тогда
		ВызватьИсключение "retail_component_missing";
	КонецЕсли;
	Содержимое = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(RetailV3, "Содержимое", Новый Структура);
	Retail = Новый Структура;
	Retail.Вставить("Тип", "retail_sale_sidegoods");
	Retail.Вставить("ИсточникUUID", Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		RetailV3, "ИсточникUUID", "")));
	Retail.Вставить("Дата", ДатаДокумента);
	Retail.Вставить("Организация", Строка(Политика.ОрганизацияUUID));
	Retail.Вставить("Склад", Строка(Политика.СкладUUID));
	Retail.Вставить("Проведен", Ложь);
	Retail.Вставить("ПометкаУдаления", Ложь);
	Товары = АдаптироватьСтрокиRetail(
		TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Содержимое, "Продажи", Новый Массив), ДатаДокумента);
	Возвраты = АдаптироватьСтрокиRetail(
		TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Содержимое, "Возвраты", Новый Массив), ДатаДокумента);
	Retail.Вставить("Товары", Товары);
	Retail.Вставить("ВозвращенныеТовары", Возвраты);
	Retail.Вставить("СуммаДокумента", СуммаСтрокV3(Товары) - СуммаСтрокV3(Возвраты));
	Оплаты = Новый Массив;
	Для Каждого ОплатаV3 Из TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Содержимое, "Оплаты", Новый Массив) Цикл
		Вид = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ОплатаV3, "Вид", ""));
		Если Вид = "cash" Тогда Вид = "Наличные"; КонецЕсли;
		Если Вид = "cashless" Тогда Вид = "Безнал"; КонецЕсли;
		Если Не (Вид = "Наличные" Или Вид = "Безнал") Тогда
			ВызватьИсключение "blocked_mapping: payment";
		КонецЕсли;
		Оплаты.Добавить(Новый Структура("ВидОплаты,Сумма", Вид,
			ЧислоБезопасноV3(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(ОплатаV3, "Сумма", 0))));
	КонецЦикла;
	Retail.Вставить("Оплаты", Оплаты);
	Результат.Добавить(Retail);
	Возврат Результат;

КонецФункции

Функция АдаптироватьСтрокиRetail(СтрокиV3, ДатаДокумента)

	Результат = Новый Массив;
	Для Каждого СтрокаV3 Из СтрокиV3 Цикл
		Количество = ЧислоБезопасноV3(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
			СтрокаV3, "Количество", 0));
		Сумма = ЧислоБезопасноV3(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
			СтрокаV3, "Сумма", 0));
		КлассSKU = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрокаV3, "КлассSKU", ""));
		Ставка = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрокаV3, "СтавкаНДС", "")));
		Если Лев(ВРег(Ставка), 3) <> "НДС" И ВРег(Ставка) <> "БЕЗНДС" Тогда
			Ставка = "НДС" + Ставка;
		КонецЕсли;
		СтрокаRetail = Новый Структура;
		СтрокаRetail.Вставить("Номенклатура", Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
			СтрокаV3, "НоменклатураUUID", "")));
		СтрокаRetail.Вставить("Количество", Количество);
		СтрокаRetail.Вставить("Цена", ?(Количество = 0, 0, Сумма / Количество));
		СтрокаRetail.Вставить("Сумма", Сумма);
		СтрокаRetail.Вставить("СуммаНДС", ЧислоБезопасноV3(
			TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СтрокаV3, "НДС", 0)));
		СтрокаRetail.Вставить("СтавкаНДС", Ставка);
		СтрокаRetail.Вставить("КлассSKU", КлассSKU);
		СтрокаRetail.Вставить("ЭтоБлюдо", ВРег(СокрЛП(КлассSKU)) = "ОБЩЕПИТ");
		СтрокаRetail.Вставить("ДатаРеализации", ДатаДокумента);
		Результат.Добавить(СтрокаRetail);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СуммаСтрокV3(Строки)
	Результат = 0;
	Для Каждого СтрокаДок Из Строки Цикл
		Результат = Результат + СтрокаДок.Сумма;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиКандидатКомпонента(Кандидаты, ТипКомпонента, ИсточникUUID)

	Подходящие = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Не Кандидат.Использован И Кандидат.Тип = ТипКомпонента Тогда
			Подходящие.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Если Подходящие.Количество() = 1 Тогда
		Возврат Подходящие[0];
	КонецЕсли;
	Части = СтрРазделить(ИсточникUUID, ":");
	Если Части.Количество() >= 3 Тогда
		БлюдоUUID = Части[Части.Количество() - 1];
		Блюдо = TL_МаппингЦБ.ПолучитьНоменклатуруПоUUID(БлюдоUUID);
		Если ЗначениеЗаполнено(Блюдо) Тогда
			Для Каждого Кандидат Из Подходящие Цикл
				Попытка
					Если Кандидат.Ссылка.ПолучитьОбъект().Номенклатура = Блюдо Тогда
						Возврат Кандидат;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ТипКомпонентаПоСсылке(Ссылка)

	Попытка
		ИмяМетаданных = Ссылка.Метаданные().Имя;
		Если ИмяМетаданных = "ОтчетОРозничныхПродажах" Тогда
			Возврат "retail";
		ИначеЕсли ИмяМетаданных = "КомплектацияНоменклатуры" Тогда
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект.ВидОперации = Перечисления.ВидыОперацийКомплектацияНоменклатуры.Комплектация Тогда
				Возврат "assembly";
			ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийКомплектацияНоменклатуры.Разукомплектация Тогда
				Возврат "disassembly";
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ПолучитьSourceHashКомпонента(Пакет, ТипКомпонента, ИсточникUUID)

	Документы = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Документы", Новый Массив);
	Если ТипКомпонента = "retail" Или ТипКомпонента = "disassembly" Тогда
		Для Каждого Док Из Документы Цикл
			Если Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Тип", "")) = "retail_sale_sidegoods" Тогда
				Возврат Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "SourceHash", ""));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипКомпонента = "assembly" Тогда
		Для Каждого Док Из Документы Цикл
			Если Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "Тип", "")) = "production_release" Тогда
				Возврат Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Док, "SourceHash", ""));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ВызватьИсключение "component_source_hash_missing";

КонецФункции

Функция ЭтоСтрокаБлюда(СтрокаДок)
	Возврат ВРег(СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		СтрокаДок, "КлассSKU", "")))) = "ОБЩЕПИТ";
КонецФункции

Функция ЭтоПроведенныйДокумент(Ссылка)
	Попытка
		Возврат Ссылка.Проведен;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ЭтоПомеченныйНаУдалениеДокумент(Ссылка)
	Попытка
		Возврат Ссылка.ПометкаУдаления;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ВычислитьХешЦели(Ссылка)
	Попытка
		ИмяМетаданных = Ссылка.Метаданные().Имя;
		Если ИмяМетаданных = "ОтчетОРозничныхПродажах" Тогда
			Проекция = ПроекцияЦелиОРП(Ссылка.ПолучитьОбъект());
		ИначеЕсли ИмяМетаданных = "КомплектацияНоменклатуры" Тогда
			Проекция = ПроекцияЦелиКомплектации(Ссылка.ПолучитьОбъект());
		Иначе
			Возврат "";
		КонецЕсли;
		Возврат ВычислитьХешЗначения(Проекция);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ПроекцияЦелиОРП(Объект)

	Проекция = Новый Структура;
	Проекция.Вставить("ВерсияПроекции", "target-orp-v1");
	Проекция.Вставить("Дата", XMLСтрока(Объект.Дата));
	Проекция.Вставить("Организация", UUIDСсылки(Объект.Организация));
	Проекция.Вставить("Склад", UUIDСсылки(Объект.Склад));
	Проекция.Вставить("СуммаДокумента", Объект.СуммаДокумента);
	Проекция.Вставить("Проведен", Объект.Проведен);
	Проекция.Вставить("ПометкаУдаления", Объект.ПометкаУдаления);
	Товары = Новый Массив;
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		СтрокаПроекции = Новый Структура;
		СтрокаПроекции.Вставить("Номенклатура", UUIDСсылки(СтрокаТовара.Номенклатура));
		СтрокаПроекции.Вставить("Количество", СтрокаТовара.Количество);
		СтрокаПроекции.Вставить("Цена", СтрокаТовара.Цена);
		СтрокаПроекции.Вставить("Сумма", СтрокаТовара.Сумма);
		СтрокаПроекции.Вставить("СуммаНДС", СтрокаТовара.СуммаНДС);
		СтрокаПроекции.Вставить("СтавкаНДС", Строка(СтрокаТовара.СтавкаНДС));
		Товары.Добавить(СтрокаПроекции);
	КонецЦикла;
	Проекция.Вставить("Товары", Товары);
	Оплаты = Новый Массив;
	Для Каждого СтрокаОплаты Из Объект.Оплата Цикл
		Оплаты.Добавить(Новый Структура("ВидОплаты,СуммаОплаты",
			UUIDСсылки(СтрокаОплаты.ВидОплаты), СтрокаОплаты.СуммаОплаты));
	КонецЦикла;
	Проекция.Вставить("Оплаты", Оплаты);
	Возвраты = Новый Массив;
	Для Каждого СтрокаВозврата Из Объект.Возвраты Цикл
		СтрокаПроекции = Новый Структура;
		СтрокаПроекции.Вставить("Номенклатура", UUIDСсылки(СтрокаВозврата.Номенклатура));
		СтрокаПроекции.Вставить("Количество", СтрокаВозврата.Количество);
		СтрокаПроекции.Вставить("Цена", СтрокаВозврата.Цена);
		СтрокаПроекции.Вставить("Сумма", СтрокаВозврата.Сумма);
		СтрокаПроекции.Вставить("СтавкаНДС", Строка(СтрокаВозврата.СтавкаНДС));
		СтрокаПроекции.Вставить("ДатаРеализации", XMLСтрока(СтрокаВозврата.ДатаРеализации));
		Возвраты.Добавить(СтрокаПроекции);
	КонецЦикла;
	Проекция.Вставить("Возвраты", Возвраты);
	Возврат Проекция;

КонецФункции

Функция ПроекцияЦелиКомплектации(Объект)

	Проекция = Новый Структура;
	Проекция.Вставить("ВерсияПроекции", "target-assembly-v1");
	Проекция.Вставить("Дата", XMLСтрока(Объект.Дата));
	Проекция.Вставить("Организация", UUIDСсылки(Объект.Организация));
	Проекция.Вставить("Склад", UUIDСсылки(Объект.Склад));
	Проекция.Вставить("ВидОперации", Строка(Объект.ВидОперации));
	Проекция.Вставить("Номенклатура", UUIDСсылки(Объект.Номенклатура));
	Проекция.Вставить("Количество", Объект.Количество);
	Проекция.Вставить("Проведен", Объект.Проведен);
	Проекция.Вставить("ПометкаУдаления", Объект.ПометкаУдаления);
	Комплектующие = Новый Массив;
	Для Каждого СтрокаКомплектующей Из Объект.Комплектующие Цикл
		СтрокаПроекции = Новый Структура;
		СтрокаПроекции.Вставить("Номенклатура", UUIDСсылки(СтрокаКомплектующей.Номенклатура));
		СтрокаПроекции.Вставить("Количество", СтрокаКомплектующей.Количество);
		Попытка
			СтрокаПроекции.Вставить("ДоляСтоимости", СтрокаКомплектующей.ДоляСтоимости);
		Исключение
			СтрокаПроекции.Вставить("ДоляСтоимости", 0);
		КонецПопытки;
		Комплектующие.Добавить(СтрокаПроекции);
	КонецЦикла;
	Проекция.Вставить("Комплектующие", Комплектующие);
	Возврат Проекция;

КонецФункции

Функция UUIDСсылки(Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат НРег(Строка(Ссылка.УникальныйИдентификатор()));
	Исключение
		Возврат Строка(Ссылка);
	КонецПопытки;
КонецФункции

Функция НавигационнаяСсылка(Ссылка)
	Попытка
		Возврат Строка(ПолучитьНавигационнуюСсылку(Ссылка));
	Исключение
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	КонецПопытки;
КонецФункции

Функция КлассифицироватьОшибку(ТекстОшибки)

	Текст = НРег(ТекстОшибки);
	Для Каждого Код Из СтрРазделить(
		"target_hash_conflict,target_component_missing,deleted_component,posted_component,blocked_mapping,component_count_mismatch,component_mapping_ambiguous,component_source_hash_missing,component_source_hash_conflict,target_hash_unavailable,revision_stale,revision_gap,revision_hash_conflict,revision_without_change,business_hash_mismatch,source_hash_mismatch,producer_policy,contract_invalid,completeness_invalid,retail_component_ambiguous,retail_component_missing", ",") Цикл
		Если СтрНайти(Текст, Код) > 0 Тогда
			Возврат Код;
		КонецЕсли;
	КонецЦикла;
	Если СтрНайти(Текст, "не сопоставлен") > 0 Или СтрНайти(Текст, "не найден") > 0 Тогда
		Возврат "blocked_mapping";
	КонецЕсли;
	Если СтрНайти(Текст, "точной ттк") > 0 Или СтрНайти(Текст, "exact ттк") > 0 Тогда
		Возврат "contract_invalid";
	КонецЕсли;
	Возврат "writer_failure";

КонецФункции

Функция СтатусПоКодуОшибки(Код)

	Если Код = "target_hash_conflict" Или Код = "target_hash_unavailable"
		Или Код = "target_component_missing" Или Код = "deleted_component"
		Или Код = "posted_component" Или Код = "component_source_hash_conflict"
		Или Код = "component_mapping_ambiguous" Тогда
		Возврат "needs_review";
	ИначеЕсли Код = "blocked_mapping" Или Код = "component_count_mismatch"
		Или Код = "component_source_hash_missing" Тогда
		Возврат "blocked_mapping";
	ИначеЕсли СтрНайти("revision_stale,revision_gap,revision_hash_conflict,revision_without_change,business_hash_mismatch,source_hash_mismatch,producer_policy,contract_invalid,completeness_invalid,retail_component_ambiguous,retail_component_missing", Код) > 0 Тогда
		Возврат "rejected";
	КонецЕсли;
	Возврат "retry_wait";

КонецФункции

Функция ВычислитьХешБизнесПроекции(Пакет)

	Попытка
		Проекция = Новый Структура;
		Для Каждого ИмяПоля Из СтрРазделить(
			"BusinessDate,BusinessKeyHash,BusinessShiftAliases,BusinessShiftID,CompanyID,FactOrigin,StationID,Документы,НСИ,ПолнотаГруппы,Смена,ТТК", ",") Цикл
			Проекция.Вставить(ИмяПоля,
				TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, ИмяПоля, Неопределено));
		КонецЦикла;
		Возврат ВычислитьХешЗначения(Проекция);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ВычислитьХешЗначения(Значение)
	Возврат ХешСтроки(КаноническийJSON(Значение));
КонецФункции

Функция ХешСтроки(Текст)
	Двоичные = ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8", Ложь);
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Двоичные);
	Возврат НРег(СокрЛП(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма)));
КонецФункции

Функция КаноническийJSON(Значение)

	ИмяТипа = Строка(ТипЗнч(Значение));
	Если ИмяТипа = "Структура" Или ИмяТипа = "Фиксированная структура"
		Или ИмяТипа = "ФиксированнаяСтруктура" Или ИмяТипа = "Соответствие"
		Или ИмяТипа = "Фиксированное соответствие"
		Или ИмяТипа = "ФиксированноеСоответствие" Тогда
		Ключи = Новый Массив;
		Для Каждого Пара Из Значение Цикл
			Ключи.Добавить(Строка(Пара.Ключ));
		КонецЦикла;
		ОтсортированныеКлючи = Новый Массив;
		Для Каждого Ключ Из Ключи Цикл
			ВставитьКлючВСортировке(ОтсортированныеКлючи, Ключ);
		КонецЦикла;
		Части = Новый Массив;
		Для Каждого Ключ Из ОтсортированныеКлючи Цикл
			Части.Добавить(КаноническийJSON(Ключ) + ":" + КаноническийJSON(
				ПолучитьЗначениеКаноническогоОбъекта(Значение, Ключ, ИмяТипа)));
		КонецЦикла;
		Возврат "{" + СтрСоединить(Части, ",") + "}";
	ИначеЕсли ИмяТипа = "Массив" Или ИмяТипа = "Фиксированный массив"
		Или ИмяТипа = "ФиксированныйМассив" Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(КаноническийJSON(Элемент));
		КонецЦикла;
		Возврат "[" + СтрСоединить(Части, ",") + "]";
	КонецЕсли;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция ПолучитьЗначениеКаноническогоОбъекта(Объект, Ключ, ИмяТипа)
	Если ИмяТипа = "Структура" Или ИмяТипа = "Фиксированная структура"
		Или ИмяТипа = "ФиксированнаяСтруктура" Тогда
		Результат = Неопределено;
		Если Объект.Свойство(Ключ, Результат) Тогда
			Возврат Результат;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Возврат Объект.Получить(Ключ);
КонецФункции

Процедура ВставитьКлючВСортировке(Ключи, НовыйКлюч)
	Для Индекс = 0 По Ключи.Количество() - 1 Цикл
		Если НовыйКлюч < Ключи[Индекс] Тогда
			Ключи.Вставить(Индекс, НовыйКлюч);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Ключи.Добавить(НовыйКлюч);
КонецПроцедуры

Функция КоличествоБезопасно(Коллекция)
	Попытка
		Возврат Коллекция.Количество();
	Исключение
		Возврат -1;
	КонецПопытки;
КонецФункции

Функция ЧислоБезопасноV3(Значение)
	Попытка
		Возврат Число(Значение);
	Исключение
		ВызватьИсключение "contract_invalid: decimal";
	КонецПопытки;
КонецФункции

Функция ПроверитьИдентичностьПакета(Пакет) Экспорт

	Результат = Новый Структура(
		"Корректен,КодОшибки,ОписаниеОшибки,CompanyID,StationID,BusinessKeyHash",
		Ложь, "contract_invalid", "", "", "", "");
	Если Не ПроверитьДекларациюNFCV3(Пакет) Тогда
		Результат.КодОшибки = "unicode_normalization_required";
		Результат.ОписаниеОшибки = "Пакет v3 должен быть полностью нормализован в Unicode NFC producer-ом до hash/queue";
		Возврат Результат;
	КонецЕсли;
	Если Не ПроверитьТочныеПоляJSON(Пакет,
			"ВерсияФормата,ВерсияКонтракта,UnicodeNormalization,ИдентификаторПакета,BusinessShiftID,BusinessShiftAliases,BusinessDate,CompanyID,StationID,BusinessKeyHash,FactOrigin,TransportProducer,РевизияПакета,ИдентификаторПолитики,РевизияПолитики,ХешПолитики,ХешПакета,ПолнотаГруппы,Смена,НСИ,ТТК,Документы") Тогда
		Результат.ОписаниеОшибки = "На верхнем уровне v3 запрещены лишние или повторные поля";
		Возврат Результат;
	КонецЕсли;

	BusinessShiftID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "BusinessShiftID", "")));
	НормализованныйShiftID = НормализоватьUUIDV3(BusinessShiftID);
	Если ПустаяСтрока(НормализованныйShiftID)
		Или BusinessShiftID <> НормализованныйShiftID Тогда
		Результат.КодОшибки = "business_shift_id_invalid";
		Результат.ОписаниеОшибки = "BusinessShiftID должен быть lowercase UUID";
		Возврат Результат;
	КонецЕсли;

	ПереданныйCompanyID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "CompanyID", ""));
	ПереданныйStationID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "StationID", ""));
	Результат.CompanyID = СокрЛП(ПереданныйCompanyID);
	Результат.StationID = СокрЛП(ПереданныйStationID);
	BusinessDate = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "BusinessDate", ""));
	Если ПустаяСтрока(Результат.CompanyID) Или ПустаяСтрока(Результат.StationID)
		Или ПереданныйCompanyID <> Результат.CompanyID
		Или ПереданныйStationID <> Результат.StationID
		Или Не ЭтоКаноническаяДатаV3(BusinessDate) Тогда
		Результат.ОписаниеОшибки = "Некорректная business identity";
		Возврат Результат;
	КонецЕсли;

	ПроекцияКлюча = Новый Структура;
	ПроекцияКлюча.Вставить("BusinessShiftID", НормализованныйShiftID);
	ПроекцияКлюча.Вставить("CompanyID", Результат.CompanyID);
	ПроекцияКлюча.Вставить("StationID", Результат.StationID);
	ВычисленныйBusinessKeyHash = ВычислитьХешЗначения(ПроекцияКлюча);
	ПереданныйBusinessKeyHash = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "BusinessKeyHash", ""));
	Если ПереданныйBusinessKeyHash <> ВычисленныйBusinessKeyHash Тогда
		Результат.КодОшибки = "business_key_mismatch";
		Результат.ОписаниеОшибки = "BusinessKeyHash не совпадает с canonical identity";
		Возврат Результат;
	КонецЕсли;
	Результат.BusinessKeyHash = ВычисленныйBusinessKeyHash;

	ОжидаемыйPacketID = РассчитатьИдентификаторПакетаV3(НормализованныйShiftID);
	ПереданныйPacketID = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "ИдентификаторПакета", ""));
	Если ПереданныйPacketID <> ОжидаемыйPacketID Тогда
		Результат.КодОшибки = "packet_uuid_mismatch";
		Результат.ОписаниеОшибки = "ИдентификаторПакета не равен deterministic UUIDv5";
		Возврат Результат;
	КонецЕсли;

	ПроверкаАлиасов = ПроверитьАлиасыСмены(Пакет, Результат.CompanyID,
		Результат.StationID, BusinessDate);
	Если Не ПроверкаАлиасов.Корректна Тогда
		Результат.КодОшибки = ПроверкаАлиасов.КодОшибки;
		Результат.ОписаниеОшибки = ПроверкаАлиасов.ОписаниеОшибки;
		Возврат Результат;
	КонецЕсли;

	Результат.Корректен = Истина;
	Результат.КодОшибки = "";
	Возврат Результат;

КонецФункции

Функция ПроверитьДекларациюNFCV3(Пакет) Экспорт
	Возврат Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "UnicodeNormalization", "")) = "NFC";
КонецФункции

Функция ПроверитьАлиасыСмены(Пакет, CompanyID, StationID, BusinessDate)

	Результат = Новый Структура("Корректна,КодОшибки,ОписаниеОшибки",
		Ложь, "alias_invalid", "");
	Алиасы = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "BusinessShiftAliases", Новый Массив);
	КоличествоАлиасов = КоличествоБезопасно(Алиасы);
	Если КоличествоАлиасов < 1 Тогда
		Результат.ОписаниеОшибки = "BusinessShiftAliases не массив или пуст";
		Возврат Результат;
	КонецЕсли;
	Происхождение = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "FactOrigin", ""));
	Если Не (Происхождение = "edge" Или Происхождение = "onec_legacy") Тогда
		Результат.ОписаниеОшибки = "Недопустимый FactOrigin";
		Возврат Результат;
	КонецЕсли;

	ВиденныеАлгоритмы = Новый Соответствие;
	ВиденныеХеши = Новый Соответствие;
	ПредыдущийКлюч = "";
	Для Каждого Алиас Из Алиасы Цикл
		Если Не ПроверитьТочныеПоляJSON(Алиас, "Algorithm,AliasHash,Attributes") Тогда
			Результат.ОписаниеОшибки = "Неточный объект BusinessShiftAlias";
			Возврат Результат;
		КонецЕсли;
		Алгоритм = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Алиас, "Algorithm", ""));
		Если Алгоритм = "business-shift-alias-v1" Тогда
			ИменаАтрибутов = "business_date,company_id,internal_shift_no,station_id";
		ИначеЕсли Алгоритм = "business-shift-common-alias-v1" Тогда
			ИменаАтрибутов = "business_date,company_id,ose,station_id";
		Иначе
			Результат.КодОшибки = "alias_algorithm_unknown";
			Результат.ОписаниеОшибки = "Неизвестный Algorithm BusinessShiftAlias";
			Возврат Результат;
		КонецЕсли;
		Атрибуты = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Алиас, "Attributes", Неопределено);
		Если Атрибуты = Неопределено Или Не ПроверитьТочныеПоляJSON(Атрибуты, ИменаАтрибутов) Тогда
			Результат.ОписаниеОшибки = "Неточные Attributes для " + Алгоритм;
			Возврат Результат;
		КонецЕсли;
		Если Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Атрибуты, "company_id", "")) <> CompanyID
			Или Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Атрибуты, "station_id", "")) <> StationID
			Или Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Атрибуты, "business_date", "")) <> BusinessDate Тогда
			Результат.ОписаниеОшибки = "Attributes алиаса не совпадают с business identity";
			Возврат Результат;
		КонецЕсли;
		Если Алгоритм = "business-shift-alias-v1"
			И ПустаяСтрока(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Атрибуты, "internal_shift_no", ""))) Тогда
			Результат.ОписаниеОшибки = "Пустой internal_shift_no";
			Возврат Результат;
		КонецЕсли;
		Если Алгоритм = "business-shift-common-alias-v1"
			И ПустаяСтрока(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Атрибуты, "ose", ""))) Тогда
			Результат.ОписаниеОшибки = "Пустой ose";
			Возврат Результат;
		КонецЕсли;

		ПроекцияАлиаса = Новый Структура;
		ПроекцияАлиаса.Вставить("algorithm", Алгоритм);
		Для Каждого ИмяАтрибута Из СтрРазделить(ИменаАтрибутов, ",") Цикл
			ПроекцияАлиаса.Вставить(ИмяАтрибута,
				TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Атрибуты, ИмяАтрибута, Неопределено));
		КонецЦикла;
		ПереданныйХеш = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Алиас, "AliasHash", ""));
		ВычисленныйХеш = ВычислитьХешЗначения(ПроекцияАлиаса);
		Если ПереданныйХеш <> ВычисленныйХеш Тогда
			Результат.КодОшибки = "alias_hash_mismatch";
			Результат.ОписаниеОшибки = "AliasHash не совпадает с canonical Attributes";
			Возврат Результат;
		КонецЕсли;
		КлючАлиаса = Алгоритм + "|" + ПереданныйХеш;
		Если ВиденныеАлгоритмы.Получить(Алгоритм) <> Неопределено
			Или ВиденныеХеши.Получить(ПереданныйХеш) <> Неопределено
			Или Не ПустаяСтрока(ПредыдущийКлюч) И КлючАлиаса < ПредыдущийКлюч Тогда
			Результат.КодОшибки = "alias_duplicate_or_unsorted";
			Результат.ОписаниеОшибки = "BusinessShiftAliases содержат дубль или не отсортированы";
			Возврат Результат;
		КонецЕсли;
		ВиденныеАлгоритмы.Вставить(Алгоритм, Истина);
		ВиденныеХеши.Вставить(ПереданныйХеш, Истина);
		ПредыдущийКлюч = КлючАлиаса;
	КонецЦикла;

	Если ВиденныеАлгоритмы.Получить("business-shift-common-alias-v1") = Неопределено Тогда
		Результат.ОписаниеОшибки = "Нет common alias смены";
		Возврат Результат;
	КонецЕсли;
	Если Происхождение = "edge"
		И ВиденныеАлгоритмы.Получить("business-shift-alias-v1") = Неопределено Тогда
		Результат.ОписаниеОшибки = "edge требует internal alias смены";
		Возврат Результат;
	КонецЕсли;
	Если Происхождение = "onec_legacy"
		И ВиденныеАлгоритмы.Получить("business-shift-alias-v1") <> Неопределено Тогда
		Результат.ОписаниеОшибки = "onec_legacy не должен присылать internal alias";
		Возврат Результат;
	КонецЕсли;
	Результат.Корректна = Истина;
	Результат.КодОшибки = "";
	Возврат Результат;

КонецФункции

Функция РассчитатьИдентификаторПакетаV3(BusinessShiftID) Экспорт

	NamespaceData = ПолучитьДвоичныеДанныеИзHexСтроки("6ba7b8119dad11d180b400c04fd430c8");
	NameData = ПолучитьДвоичныеДанныеИзСтроки(
		"urn:elsyplus:ledger:accounting-packet:v1:" + НРег(BusinessShiftID), "UTF-8", Ложь);
	SHA1 = Новый ХешированиеДанных(ХешФункция.SHA1);
	SHA1.Добавить(NamespaceData);
	SHA1.Добавить(NameData);
	Hex = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(SHA1.ХешСумма));
	Hex = Лев(Hex, 12) + "5" + Сред(Hex, 14);
	НомерHex = СтрНайти("0123456789abcdef", Сред(Hex, 17, 1)) - 1;
	Остаток = НомерHex - Цел(НомерHex / 4) * 4;
	Hex = Лев(Hex, 16) + Сред("89ab", Остаток + 1, 1) + Сред(Hex, 18);
	Возврат Лев(Hex, 8) + "-" + Сред(Hex, 9, 4) + "-"
		+ Сред(Hex, 13, 4) + "-" + Сред(Hex, 17, 4) + "-" + Сред(Hex, 21);

КонецФункции

Функция НормализоватьUUIDV3(Значение)
	UUID = НРег(СокрЛП(Строка(Значение)));
	Если СтрДлина(UUID) <> 36 Или Сред(UUID, 9, 1) <> "-"
		Или Сред(UUID, 14, 1) <> "-" Или Сред(UUID, 19, 1) <> "-"
		Или Сред(UUID, 24, 1) <> "-" Тогда
		Возврат "";
	КонецЕсли;
	Если Не ЭтоHexV3(СтрЗаменить(UUID, "-", ""), 32) Тогда
		Возврат "";
	КонецЕсли;
	Возврат UUID;
КонецФункции

Функция ЭтоHexV3(Значение, Длина)
	Текст = Строка(Значение);
	Если СтрДлина(Текст) <> Длина Или Текст <> НРег(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789abcdef", Сред(Текст, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЭтоКаноническаяДатаV3(Значение)
	Текст = Строка(Значение);
	Если Не (СтрДлина(Текст) = 10 И Сред(Текст, 5, 1) = "-"
		И Сред(Текст, 8, 1) = "-"
		И ЭтоЦифрыV3(СтрЗаменить(Текст, "-", ""))) Тогда
		Возврат Ложь;
	КонецЕсли;
	Год = Число(Лев(Текст, 4));
	Месяц = Число(Сред(Текст, 6, 2));
	День = Число(Прав(Текст, 2));
	Если Год < 1 Или Месяц < 1 Или Месяц > 12 Или День < 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	ДнейВМесяце = 31;
	Если Месяц = 4 Или Месяц = 6 Или Месяц = 9 Или Месяц = 11 Тогда
		ДнейВМесяце = 30;
	ИначеЕсли Месяц = 2 Тогда
		Високосный = ОстатокЦелогоV3(Год, 400) = 0
			Или (ОстатокЦелогоV3(Год, 4) = 0 И ОстатокЦелогоV3(Год, 100) <> 0);
		ДнейВМесяце = ?(Високосный, 29, 28);
	КонецЕсли;
	Возврат День <= ДнейВМесяце;
КонецФункции

Функция ОстатокЦелогоV3(Значение, Делитель)
	Возврат Значение - Цел(Значение / Делитель) * Делитель;
КонецФункции

Функция ЭтоЦифрыV3(Текст)
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПроверитьТочныеПоляJSON(Объект, ИменаПолей)
	Ожидаемые = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(ИменаПолей, ",") Цикл
		Ожидаемые.Вставить(Имя, Истина);
	КонецЦикла;
	Фактических = 0;
	Попытка
		Для Каждого Пара Из Объект Цикл
			Если Ожидаемые.Получить(Строка(Пара.Ключ)) = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			Фактических = Фактических + 1;
		КонецЦикла;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Фактических = Ожидаемые.Количество();
КонецФункции

Функция ПроверитьLegacyРазрешен(Пакет) Экспорт

	Результат = Новый Структура("Разрешен,КодОшибки,ОписаниеОшибки", Истина, "", "");
	Смена = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Смена", Неопределено);
	Если Смена = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	StationID = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "КодАЗС", "")));
	Если ПустаяСтрока(StationID) Тогда
		Возврат Результат;
	КонецЕсли;
	Политики = ПолучитьПолитикиСтанции(StationID);
	Если Политики.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если Политики.Количество() <> 1 Тогда
		Результат.Разрешен = Ложь;
		Результат.КодОшибки = "trusted_policy_ambiguous";
		Результат.ОписаниеОшибки = "Для legacy-пакета нельзя однозначно выбрать company policy";
		Возврат Результат;
	КонецЕсли;
	Политика = Политики[0];
	Если Политика.ДатаОтсечкиТранспорта <= ТекущаяДатаСеанса()
		И НРег(Строка(Политика.TransportProducer)) = "central_ledger" Тогда
		Результат.Разрешен = Ложь;
		Результат.КодОшибки = "legacy_contract_after_cutover";
		Результат.ОписаниеОшибки = "Legacy transport запрещен доверенной policy";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция РезультатОтказаLegacy(Пакет, КодОшибки, ОписаниеОшибки) Экспорт
	Возврат РезультатОтказаV3(Пакет, "rejected", КодОшибки, ОписаниеОшибки);
КонецФункции

Функция ПроверитьПравилоРевизии(ТекущаяРевизия, ТекущийХеш, ПолученнаяРевизия, ПолученныйХеш) Экспорт

	Результат = Новый Структура("Разрешена,ИдемпотентныйПовтор,Код", Ложь, Ложь, "");
	Текущая = ?(ТекущаяРевизия = Неопределено, 0, ТекущаяРевизия);
	Если Текущая = 0 И ПолученнаяРевизия = 1 Тогда
		Результат.Разрешена = Истина;
	ИначеЕсли ПолученнаяРевизия < Текущая Тогда
		Результат.Код = "revision_stale";
	ИначеЕсли ПолученнаяРевизия > Текущая + 1 Тогда
		Результат.Код = "revision_gap";
	ИначеЕсли ПолученнаяРевизия = Текущая Тогда
		Если ТекущийХеш = ПолученныйХеш Тогда
			Результат.Разрешена = Истина;
			Результат.ИдемпотентныйПовтор = Истина;
		Иначе
			Результат.Код = "revision_hash_conflict";
		КонецЕсли;
	ИначеЕсли ПолученнаяРевизия = Текущая + 1 Тогда
		Если ТекущийХеш = ПолученныйХеш Тогда
			Результат.Код = "revision_without_change";
		Иначе
			Результат.Разрешена = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПолучитьДатуДокументовV3(Пакет) Экспорт

	Смена = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Смена", Новый Структура);
	ЗакрытаВ = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Смена, "ЗакрытаВ", Неопределено);
	Если ЗначениеЗаполнено(ЗакрытаВ) Тогда
		Возврат Строка(ЗакрытаВ);
	КонецЕсли;
	BusinessDate = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "BusinessDate", ""));
	ОСЭ = СокрЛП(Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Смена, "ОСЭ", "")));
	Если Не ЭтоКаноническаяДатаV3(BusinessDate) Или ПустаяСтрока(ОСЭ) Тогда
		ВызватьИсключение "contract_invalid: shift_date_fallback";
	КонецЕсли;
	Возврат BusinessDate;

КонецФункции

Функция АдаптироватьПакет(Пакет, Политика = Неопределено) Экспорт

	Если Политика = Неопределено Тогда
		Политика = ПолучитьДовереннуюПолитику(
			Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "CompanyID", "")),
			Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "StationID", "")));
	КонецЕсли;
	Если Политика = Неопределено Тогда
		ВызватьИсключение "trusted_policy_missing";
	КонецЕсли;

	Итог = Новый Структура;
	Итог.Вставить("ВерсияФормата", "2");
	Итог.Вставить("ИдентификаторПакета", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ИдентификаторПакета", ""));
	Итог.Вставить("Источник", "Ledger v3");
	СменаV3 = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "Смена", Новый Структура);
	ДатаДокумента = ПолучитьДатуДокументовV3(Пакет);
	Смена = Новый Структура;
	Смена.Вставить("КодАЗС", Число(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "StationID", 0)));
	Смена.Вставить("СкладUUID", Строка(Политика.СкладUUID));
	Смена.Вставить("ОрганизацияUUID", Строка(Политика.ОрганизацияUUID));
	Смена.Вставить("НомерСмены", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СменаV3, "ОСЭ", ""));
	Смена.Вставить("НомерСменыВнутр", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СменаV3, "НомерВнутренний", ""));
	Смена.Вставить("ОСЭНомер", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СменаV3, "ОСЭ", ""));
	Смена.Вставить("Открытие", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(СменаV3, "ОткрытаВ", ""));
	Смена.Вставить("Закрытие", ДатаДокумента);
	Итог.Вставить("Смена", Смена);
	Итог.Вставить("НСИ", TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(
		Пакет, "НСИ", Новый Массив));
	Итог.Вставить("Документы", АдаптироватьДокументы(Пакет, Политика, ДатаДокумента));
	Возврат Итог;

КонецФункции

#КонецОбласти

Функция ПроверитьПакет(Пакет) Экспорт

	Результат = Новый Структура(
		"Корректен,Результат,КодОшибки,ОписаниеОшибки,ИдемпотентныйПовтор,CompanyID,StationID,BusinessKeyHash,Ревизия,Хеш,Политика",
		Ложь, "rejected", "contract_invalid", "", Ложь, "", "", "", 0, "", Неопределено);
	Если Не ПроверитьДекларациюNFCV3(Пакет) Тогда
		Результат.КодОшибки = "unicode_normalization_required";
		Результат.ОписаниеОшибки = "Пакет v3 должен быть полностью нормализован в Unicode NFC producer-ом до hash/queue";
		Возврат Результат;
	КонецЕсли;

	Обязательные = СтрРазделить(
		"ВерсияФормата,ВерсияКонтракта,UnicodeNormalization,ИдентификаторПакета,BusinessShiftID,BusinessShiftAliases,BusinessDate,CompanyID,StationID,BusinessKeyHash,FactOrigin,TransportProducer,РевизияПакета,ИдентификаторПолитики,РевизияПолитики,ХешПолитики,ХешПакета,ПолнотаГруппы,Смена,НСИ,ТТК,Документы", ",");
	Для Каждого ИмяПоля Из Обязательные Цикл
		ЗначениеПоля = TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, ИмяПоля, Неопределено);
		Если ЗначениеПоля = Неопределено Тогда
			Результат.ОписаниеОшибки = "Не заполнено обязательное поле " + ИмяПоля;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Если TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ВерсияФормата", "") <> "3"
		Или TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ВерсияКонтракта", "") <> "3.0.0" Тогда
		Результат.ОписаниеОшибки = "Приемник поддерживает только контракт 3.0.0";
		Возврат Результат;
	КонецЕсли;
	Если TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "TransportProducer", "") <> "central_ledger" Тогда
		Результат.КодОшибки = "producer_policy";
		Результат.ОписаниеОшибки = "TransportProducer должен быть central_ledger";
		Возврат Результат;
	КонецЕсли;

	ПроверкаIdentity = ПроверитьИдентичностьПакета(Пакет);
	Если Не ПроверкаIdentity.Корректен Тогда
		Результат.КодОшибки = ПроверкаIdentity.КодОшибки;
		Результат.ОписаниеОшибки = ПроверкаIdentity.ОписаниеОшибки;
		Возврат Результат;
	КонецЕсли;
	Результат.CompanyID = ПроверкаIdentity.CompanyID;
	Результат.StationID = ПроверкаIdentity.StationID;
	Результат.BusinessKeyHash = ПроверкаIdentity.BusinessKeyHash;
	Результат.Хеш = Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ХешПакета", ""));
	Попытка
		Результат.Ревизия = Число(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "РевизияПакета", 0));
	Исключение
		Результат.ОписаниеОшибки = "РевизияПакета должна быть целым числом";
		Возврат Результат;
	КонецПопытки;
	Если Не ЭтоHexV3(Результат.Хеш, 64) Или Результат.Ревизия < 1
		Или Результат.Ревизия <> Цел(Результат.Ревизия) Тогда
		Результат.ОписаниеОшибки = "Некорректная identity/revision v3";
		Возврат Результат;
	КонецЕсли;
	ВычисленныйХеш = ВычислитьХешБизнесПроекции(Пакет);
	Если ПустаяСтрока(ВычисленныйХеш) Или ВычисленныйХеш <> Результат.Хеш Тогда
		Результат.КодОшибки = "business_hash_mismatch";
		Результат.ОписаниеОшибки = "ХешПакета не совпадает с бизнес-проекцией v3";
		Возврат Результат;
	КонецЕсли;
	Если Не мРежимРазрешенияКонфликта
		И ЕстьОткрытыйNeedsReview(Результат.BusinessKeyHash) Тогда
		Результат.Результат = "needs_review";
		Результат.КодОшибки = "explicit_resolution_required";
		Результат.ОписаниеОшибки = "needs_review снимается только явной командой retry|ack";
		Возврат Результат;
	КонецЕсли;

	ПроверкаПолноты = ПроверитьПолнотуИСостав(Пакет);
	Если Не ПроверкаПолноты.Корректен Тогда
		Результат.Результат = ПроверкаПолноты.Результат;
		Результат.КодОшибки = ПроверкаПолноты.КодОшибки;
		Результат.ОписаниеОшибки = ПроверкаПолноты.ОписаниеОшибки;
		Возврат Результат;
	КонецЕсли;

	Политика = ПолучитьДовереннуюПолитику(Результат.CompanyID, Результат.StationID);
	Если Политика = Неопределено Тогда
		Результат.Результат = "blocked_mapping";
		Результат.КодОшибки = "trusted_policy_missing";
		Результат.ОписаниеОшибки = "Нет доверенной policy CompanyID+StationID";
		Возврат Результат;
	КонецЕсли;
	Если Строка(Политика.PolicyID) <> Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ИдентификаторПолитики", ""))
		Или Политика.РевизияПолитики <> TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "РевизияПолитики", 0)
		Или Строка(Политика.ХешПолитики) <> Строка(TL_HTTPКлиентЦБ.ПолучитьЗначениеИзJSON(Пакет, "ХешПолитики", ""))
		Или НРег(Строка(Политика.TransportProducer)) <> "central_ledger" Тогда
		Результат.КодОшибки = "producer_policy";
		Результат.ОписаниеОшибки = "Поля policy пакета не совпадают с доверенной policy";
		Возврат Результат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(TL_МаппингЦБ.ПолучитьОрганизациюПоUUID(
			Строка(Политика.ОрганизацияUUID)))
		Или Не ЗначениеЗаполнено(TL_МаппингЦБ.ПолучитьСкладПоUUID(
			Строка(Политика.СкладUUID))) Тогда
		Результат.Результат = "blocked_mapping";
		Результат.КодОшибки = "blocked_mapping";
		Результат.ОписаниеОшибки = "Организация или склад trusted policy не сопоставлены";
		Возврат Результат;
	КонецЕсли;
	Результат.Политика = Политика;

	ПроверкаРевизии = ПроверитьРевизию(Результат.BusinessKeyHash, Результат.Ревизия, Результат.Хеш);
	Если Не ПроверкаРевизии.Разрешена Тогда
		Результат.КодОшибки = ПроверкаРевизии.Код;
		Результат.ОписаниеОшибки = ПроверкаРевизии.Код;
		Возврат Результат;
	КонецЕсли;
	Результат.ИдемпотентныйПовтор = ПроверкаРевизии.ИдемпотентныйПовтор;
	Результат.Корректен = Истина;
	Возврат Результат;

КонецФункции
