КонецПроцедуры

// Найти связанные документы (Перемещения, Комплектации) по базовому ключу.
//
&НаСервере
Процедура ДобавитьСвязанныеДокументы(КлючБазовый, ЗагруженныеДокументы)
	Для Каждого КЗ Из ЗагруженныеДокументы Цикл
		Если СтрНачинаетсяС(КЗ.Ключ, КлючБазовый + "|") Тогда
			// Это дочерний документ (|ПЕРЕМ, |КОМПЛ, |cash|92 и т.д.)
			Инфо = КЗ.Значение;
			ТипДоч = ОпределитьТипПоКлючу(КЗ.Ключ);
			ОписДоч = ОпределитьОписаниеПоКлючу(КЗ.Ключ);

			Стр = ВнутренниеДанные.Добавить();
			Стр.Отметка              = Ложь;
			Стр.КлючЗагрузки        = КЗ.Ключ;
			Стр.КлючБазовый          = КлючБазовый;
			Стр.ТипДокумента         = ТипДоч;
			Стр.Описание             = ОписДоч;
			Стр.Статус               = Инфо.Статус;
			Стр.ДокументПредставление = Строка(Инфо.Ссылка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Нормализовать ответ API со списком смен (3 формата).
//
&НаСервере
Функция НормализоватьОтветСмен(ОтветСмены)

	Смены = Новый Массив;

	Если ТипЗнч(ОтветСмены) = Тип("Массив") Тогда
		Если ОтветСмены.Количество() > 0 Тогда
			Первый = ОтветСмены[0];
			Если ТипЗнч(Первый) = Тип("Соответствие") И Первый.Получить("shift") <> Неопределено Тогда
				Смены = ОтветСмены;
			ИначеЕсли ТипЗнч(Первый) = Тип("Соответствие") И Первый.Получить("shifts") <> Неопределено Тогда
				Вложенные = Первый.Получить("shifts");
				Если ТипЗнч(Вложенные) = Тип("Массив") Тогда
					Смены = Вложенные;
				КонецЕсли;
			Иначе
				Смены = ОтветСмены;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ОтветСмены) = Тип("Соответствие") Тогда
		Вложенные = ОтветСмены.Получить("shifts");
		Если ТипЗнч(Вложенные) = Тип("Массив") Тогда
			Смены = Вложенные;
		КонецЕсли;
	КонецЕсли;

	Возврат Смены;

КонецФункции

// Определить тип документа по суффиксу ключа.
//
&НаСервере
Функция ОпределитьТипПоКлючу(Ключ)
	Если СтрНайти(Ключ, "|КОМПЛ") > 0 Тогда
		Возврат "Комплектация";
	ИначеЕсли СтрНайти(Ключ, "|ПЕРЕМ") > 0 Тогда
		Возврат "Перемещение";
	Иначе
		Возврат "Перемещение";
	КонецЕсли;
КонецФункции

// Определить описание по суффиксу ключа.
//
&НаСервере
Функция ОпределитьОписаниеПоКлючу(Ключ)
	Если СтрНайти(Ключ, "|КОМПЛ") > 0 Тогда
		Возврат "т → л";
	ИначеЕсли СтрНайти(Ключ, "|ПЕРЕМ") > 0 Тогда
		Возврат "→ АЗС";
	Иначе
		// Перемещение по оплате: извлечь канал из ключа
		Части = СтрРазделить(Ключ, "|");
		Если Части.Количество() > 5 Тогда
			Возврат Части[Части.Количество() - 2]; // Канал оплаты
		КонецЕсли;
		Возврат "→ склад";
	КонецЕсли;
КонецФункции

// Определить тип документа 1С по ссылке.
//
&НаСервере
Функция ОпределитьТипДокумента(ДокСсылка)
	ИмяТипа = Строка(ТипЗнч(ДокСсылка));
	Если СтрНайти(ИмяТипа, "Перемещение") > 0 Тогда
		Возврат "Перемещение";
	ИначеЕсли СтрНайти(ИмяТипа, "Комплектация") > 0 Тогда
		Возврат "Комплектация";
	ИначеЕсли СтрНайти(ИмяТипа, "Поступление") > 0 Тогда
		Возврат "ТТН";
	Иначе
		Возврат "Документ";
	КонецЕсли;
КонецФункции

// Определить описание дочернего документа.
//
&НаСервере
Функция ОпределитьОписаниеДочернего(ДокСсылка, ТипДоч)
	Если ТипДоч = "Комплектация" Тогда
		Возврат "т → л";
	ИначеЕсли ТипДоч = "Перемещение" Тогда
		Возврат "→ склад";
	Иначе
		Возврат Строка(ДокСсылка);
	КонецЕсли;
КонецФункции

// Найти ключ загрузки по ссылке документа (обратный поиск).
//
&НаСервере
Функция НайтиКлючПоДокументу(ДокСсылка)
	Попытка
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		Комментарий = ДокОбъект.Комментарий;
		ПозРазделителя = СтрНайти(Комментарий, " | ");
		Если ПозРазделителя > 0 Тогда
			Возврат Лев(Комментарий, ПозРазделителя - 1);
		КонецЕсли;
		Возврат СокрЛП(Комментарий);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Обновить HTML-дашборд (KPI-карточки).
//
&НаСервере
Процедура ОбновитьДашборд()

	ВсегоСмен = ВнешниеДанные.Количество() + ВнутренниеДанные.Количество();
	Загружено = ВнутренниеДанные.Количество();
	Новых = ВнешниеДанные.Количество();

	// Подсчёт ошибок (документы без ссылки или с проблемами)
	Ошибок = 0;

	// Сумма за период
	СуммаЗаПериод = 0;
	Для Каждого Стр Из ВнешниеДанные Цикл
		СуммаЗаПериод = СуммаЗаПериод + Стр.Сумма;
	КонецЦикла;
	Для Каждого Стр Из ВнутренниеДанные Цикл
		// Считаем только основные документы (Смена, ТТН), не дочерние
		Если Стр.ТипДокумента = "Смена" ИЛИ Стр.ТипДокумента = "ТТН" Тогда
			СуммаЗаПериод = СуммаЗаПериод + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;

	HTMLДашборд = TL_HTMLГенератор.СформироватьДашборд(ВсегоСмен, Загружено, Новых, Ошибок, СуммаЗаПериод);

КонецПроцедуры

// ==========================================================================
//  СЕРВЕРНЫЕ ОБЁРТКИ ДЛЯ HTML-ДЕТАЛЕЙ
//  (HTMLГенератор — серверный модуль, нужны обёртки для вызова с клиента)
// ==========================================================================

// Обновить детали для внешнего документа (правая панель).
//
&НаСервере
Процедура ОбновитьДеталиВнешнегоДокумента(ТипДокумента, ДанныеJSON, Заголовок)

	Если ТипДокумента = "Смена" И ЗначениеЗаполнено(ДанныеJSON) Тогда
		HTMLДетали = TL_HTMLГенератор.СформироватьДеталиСмены(ДанныеJSON, Заголовок);
	ИначеЕсли ТипДокумента = "ТТН" И ЗначениеЗаполнено(ДанныеJSON) Тогда
		HTMLДетали = TL_HTMLГенератор.СформироватьДеталиТТН(ДанныеJSON, Заголовок);
	Иначе
		HTMLДетали = TL_HTMLГенератор.ПустыеДетали();
	КонецЕсли;

КонецПроцедуры

// Обновить детали для внутреннего документа (левая панель) со связанными.
//
&НаСервере
Процедура ОбновитьДеталиВнутреннегоДокумента(КлючБазовый, ДанныеJSON, Заголовок, СвязанныеДокументы)

	Если СтрНайти(КлючБазовый, "|СМЕНА|") > 0 Тогда
		HTMLДетали = TL_HTMLГенератор.СформироватьДеталиСмены(
			ДанныеJSON, Заголовок, СвязанныеДокументы);
	ИначеЕсли СтрНайти(КлючБазовый, "|ТТН|") > 0 Тогда
		HTMLДетали = TL_HTMLГенератор.СформироватьДеталиТТН(
			ДанныеJSON, Заголовок, СвязанныеДокументы);
	Иначе
		HTMLДетали = TL_HTMLГенератор.ПустыеДетали();
	КонецЕсли;

КонецПроцедуры

// Показать пустые детали.
//
&НаСервере
Процедура ОбновитьДеталиПустые()
	HTMLДетали = TL_HTMLГенератор.ПустыеДетали();
КонецПроцедуры

// Найти JSON по ключу: сначала в ВнутренниеДанные, потом ВнешниеДанные.
//
&НаКлиенте
Функция НайтиJSONПоКлючу(КлючБазовый)

	// 1. Ищем в левой панели (ВнутренниеДанные — JSON сохраняется при загрузке)
	Для Каждого Стр Из ВнутренниеДанные Цикл
		Если Стр.КлючЗагрузки = КлючБазовый И ЗначениеЗаполнено(Стр.ДанныеJSON) Тогда
			Возврат Стр.ДанныеJSON;
		КонецЕсли;
	КонецЦикла;

	// 2. Ищем в правой панели (ВнешниеДанные)
	Для Каждого Стр Из ВнешниеДанные Цикл
		Если Стр.КлючЗагрузки = КлючБазовый Тогда
			Возврат Стр.ДанныеJSON;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Вычислить итоговую сумму смены.
//
&НаСервере
Функция ВычислитьСуммуСмены(ДанныеОтчёта)

	Если ДанныеОтчёта = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	// 1. Из sales с фильтрацией купонов (совпадает с тем что загрузится в 1С)
	Если ТипЗнч(ДанныеОтчёта) = Тип("Соответствие") Тогда
		МассивПродаж = ДанныеОтчёта.Получить("sales");
		Если ТипЗнч(МассивПродаж) = Тип("Массив") И МассивПродаж.Количество() > 0 Тогда
			Итого = 0;
			Для Каждого Продажа Из МассивПродаж Цикл
				// Фильтруем купоны — так же как при создании документов
				ТипОплаты = TL_ApiКлиент.ПолучитьЗначение(Продажа, "pay_type", Неопределено);
				Если ТипОплаты <> Неопределено Тогда
					ИмяОпл = НРег(Строка(TL_ApiКлиент.ПолучитьЗначение(ТипОплаты, "name", "")));
					Если СтрНайти(ИмяОпл, "купон") > 0 Тогда
						Продолжить; // Купоны — сервисный, не учитываем в итоге
					КонецЕсли;
				КонецЕсли;

				МассивТоплива = TL_ApiКлиент.ПолучитьЗначение(Продажа, "fuel", Неопределено);
				Если ТипЗнч(МассивТоплива) = Тип("Массив") Тогда
					Для Каждого ЭлементТоплива Из МассивТоплива Цикл
						Выпуск = TL_ApiКлиент.ПолучитьЗначение(ЭлементТоплива, "release", Неопределено);
						Если Выпуск <> Неопределено Тогда
							Попытка
								Итого = Итого + Число(TL_ApiКлиент.ПолучитьЗначение(Выпуск, "cost", 0));
							Исключение
							КонецПопытки;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			Если Итого > 0 Тогда Возврат Итого; КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// 2. Fallback: totals.summ_total (может включать купоны, но лучше чем ничего)
	Если ТипЗнч(ДанныеОтчёта) = Тип("Соответствие") Тогда
		Итоги = ДанныеОтчёта.Получить("totals");
		Если ТипЗнч(Итоги) = Тип("Соответствие") Тогда
			Попытка
				С = Число(Итоги.Получить("summ_total"));
				Если С > 0 Тогда Возврат С; КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	// 3. Fallback: payments (старый формат)
	Если ТипЗнч(ДанныеОтчёта) = Тип("Соответствие") Тогда
		Оплаты = ДанныеОтчёта.Получить("payments");
		Если ТипЗнч(Оплаты) = Тип("Соответствие") Тогда
			Итого = 0;
			Для Каждого КЗ Из Оплаты Цикл
				Попытка Итого = Итого + Число(КЗ.Значение); Исключение КонецПопытки;
			КонецЦикла;
			Возврат Итого;
		КонецЕсли;
	КонецЕсли;

	Возврат 0;

КонецФункции

&НаКлиенте
Функция ПроверитьНастройки()
	Если Не ЗначениеЗаполнено(URLСервера) Тогда
		ДобавитьВЛог("Заполните URL сервера");
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Логин) ИЛИ Не ЗначениеЗаполнено(Пароль) Тогда
		ДобавитьВЛог("Заполните логин и пароль");
		Возврат Ложь;
	КонецЕсли;
	Если КодСистемы = 0 Тогда
		ДобавитьВЛог("Укажите код системы");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ПереключитьОтметки(Таблица)
	ЕстьОтмеченные = Ложь;
	Для Каждого Стр Из Таблица Цикл
		Если Стр.Отметка Тогда ЕстьОтмеченные = Истина; Прервать; КонецЕсли;
	КонецЦикла;
	НовоеЗначение = Не ЕстьОтмеченные;
	Для Каждого Стр Из Таблица Цикл Стр.Отметка = НовоеЗначение; КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ПодсчитатьОтмеченные(Таблица)
	Счётчик = 0;
	Для Каждого Стр Из Таблица Цикл
		Если Стр.Отметка Тогда Счётчик = Счётчик + 1; КонецЕсли;
	КонецЦикла;
	Возврат Счётчик;
КонецФункции

&НаКлиенте
Процедура ДобавитьВЛог(Текст)
	Штамп = Формат(ТекущаяДата(), "ДФ='dd.MM HH:mm'");
	НоваяСтрока = Штамп + "  " + Текст;
	ТекстЛога = ?(ЗначениеЗаполнено(ТекстЛога), НоваяСтрока + Символы.ПС + ТекстЛога, НоваяСтрока);
КонецПроцедуры

&НаСервере
Процедура ДобавитьВЛогСервер(Текст)
	Штамп = Формат(ТекущаяДата(), "ДФ='dd.MM HH:mm'");
	НоваяСтрока = Штамп + "  " + Текст;
	ТекстЛога = ?(ЗначениеЗаполнено(ТекстЛога), НоваяСтрока + Символы.ПС + ТекстЛога, НоваяСтрока);
КонецПроцедуры

#КонецОбласти
