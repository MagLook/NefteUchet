////////////////////////////////////////////////////////////////////////////////
// Обработка TL_НастройкаОбменаСопутка, Форма
// Расширение TradeLedger — настройки приёма пакетов сопутки из ЦБ ЭЛСИ.АЗК.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПроводитьАвтоматически = Истина;
	ЗагрузитьНастройкиНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьНастройки(Команда) Экспорт
	ЗагрузитьНастройкиНаСервере();
	ДобавитьВЛог("Настройки прочитаны из TL_Настройки");
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда) Экспорт
	СохранитьНастройкиНаСервере();
	ДобавитьВЛог("Настройки сохранены");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда) Экспорт
	Если Вопрос("Заполнить значения по умолчанию для ГИГ? Текущие значения формы будут перезаписаны.",
			РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьПоУмолчаниюНаСервере();
	ДобавитьВЛог("Заполнены значения по умолчанию");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКаталог(Команда) Экспорт
	Результат = ПроверитьКаталогНаСервере();
	ДобавитьВЛог(Результат);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьНастройкиНаСервере()
	КаталогOwnCloud         = TL_Настройки.ПолучитьЗначение("КаталогOwnCloud_ЦБ", "");
	КонтрагентИсточник      = ПолучитьСсылкуПоUUID("Сопутка_КонтрагентИсточник_UUID",
		"Справочник.Контрагенты");
	Организация             = ПолучитьСсылкуПоUUID("Сопутка_Организация_UUID",
		"Справочник.Организации");
	СкладПоУмолчанию        = ПолучитьСсылкуПоUUID("Сопутка_Склад_UUID",
		"Справочник.Склады");
	Подразделение           = ПолучитьСсылкуПоUUID("Сопутка_Подразделение_UUID",
		"Справочник.ПодразделенияОрганизаций");
	СтатьяДДСНаличные       = ПолучитьСсылкуПоUUID("Сопутка_СтатьяДДС_UUID",
		"Справочник.СтатьиДвиженияДенежныхСредств");
	ВидОплатыБезнал         = ПолучитьСсылкуПоUUID("Сопутка_ВидОплаты_UUID",
		"Справочник.ВидыОплатОрганизаций");
	Стр = TL_Настройки.ПолучитьЗначение("Сопутка_ПроводитьАвто", "Истина");
	ПроводитьАвтоматически  = (Стр <> "Ложь");
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()
	Если ЗначениеЗаполнено(КаталогOwnCloud) Тогда
		TL_Настройки.УстановитьЗначение("КаталогOwnCloud_ЦБ", КаталогOwnCloud,
			"Каталог обмена ЦБ ↔ БП ГИГ (общий для Сопутки и Общепита)");
	КонецЕсли;
	СохранитьСсылку("Сопутка_КонтрагентИсточник_UUID", КонтрагентИсточник,
		"Контрагент-источник (НЛ в БП ГИГ) для приёма ПТУ сопутки");
	СохранитьСсылку("Сопутка_Организация_UUID", Организация,
		"Организация-получатель (ГИГ) для документов сопутки");
	СохранитьСсылку("Сопутка_Склад_UUID", СкладПоУмолчанию,
		"Склад по умолчанию для сопутки");
	СохранитьСсылку("Сопутка_Подразделение_UUID", Подразделение,
		"Подразделение по умолчанию для сопутки");
	СохранитьСсылку("Сопутка_СтатьяДДС_UUID", СтатьяДДСНаличные,
		"Статья ДДС для наличной выручки сопутки");
	СохранитьСсылку("Сопутка_ВидОплаты_UUID", ВидОплатыБезнал,
		"Вид оплаты для безналичных продаж сопутки");
	TL_Настройки.УстановитьЗначение("Сопутка_ПроводитьАвто",
		?(ПроводитьАвтоматически, "Истина", "Ложь"),
		"Проводить созданные документы сопутки автоматически");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчаниюНаСервере()
	// Организация — первая активная (или с ИНН ГИГ)
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Попытка
			Орг = Справочники.Организации.НайтиПоРеквизиту("ИНН", "7839440090");
			Если Не ЗначениеЗаполнено(Орг) Тогда
				Запрос = Новый Запрос(
					"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Организации ГДЕ НЕ ПометкаУдаления");
				В = Запрос.Выполнить().Выбрать();
				Если В.Следующий() Тогда Орг = В.Ссылка; КонецЕсли;
			КонецЕсли;
			Организация = Орг;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Контрагент-источник — НЛ (по ИНН 7804572748)
	Если Не ЗначениеЗаполнено(КонтрагентИсточник) Тогда
		Попытка
			Кон = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", "7804572748");
			Если ЗначениеЗаполнено(Кон) Тогда КонтрагентИсточник = Кон; КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Склад «АЗС Выборг (208)»
	Если Не ЗначениеЗаполнено(СкладПоУмолчанию) Тогда
		Попытка
			Запрос = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Склады
				|ГДЕ Наименование ПОДОБНО ""%208%"" И НЕ ПометкаУдаления");
			В = Запрос.Выполнить().Выбрать();
			Если В.Следующий() Тогда СкладПоУмолчанию = В.Ссылка; КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Подразделение «АЗС 208 г. Выборг»
	Если Не ЗначениеЗаполнено(Подразделение) Тогда
		Попытка
			Запрос = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПодразделенияОрганизаций
				|ГДЕ Наименование ПОДОБНО ""%208%"" И НЕ ПометкаУдаления");
			В = Запрос.Выполнить().Выбрать();
			Если В.Следующий() Тогда Подразделение = В.Ссылка; КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Статья ДДС «Розничная выручка»
	Если Не ЗначениеЗаполнено(СтатьяДДСНаличные) Тогда
		Попытка
			Стат = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию(
				"Розничная выручка", Истина);
			Если ЗначениеЗаполнено(Стат) Тогда СтатьяДДСНаличные = Стат; КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Вид оплаты «Платежная карта»
	Если Не ЗначениеЗаполнено(ВидОплатыБезнал) Тогда
		Попытка
			В = Справочники.ВидыОплатОрганизаций.НайтиПоНаименованию(
				"Платежная карта", Истина);
			Если ЗначениеЗаполнено(В) Тогда ВидОплатыБезнал = В; КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьКаталогНаСервере()
	Если Не ЗначениеЗаполнено(КаталогOwnCloud) Тогда
		Возврат "Каталог не указан";
	КонецЕсли;
	Попытка
		Ф = Новый Файл(КаталогOwnCloud);
		Если Не Ф.Существует() Тогда
			Возврат "Каталог НЕ существует: " + КаталогOwnCloud;
		КонецЕсли;
		Кол = НайтиФайлы(КаталогOwnCloud, "tl_*.json", Ложь).Количество();
		Возврат "Каталог доступен. Файлов tl_*.json: " + Кол;
	Исключение
		Возврат "Ошибка проверки: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаСервере
Функция ПолучитьСсылкуПоUUID(КлючНастройки, ПолноеИмяТипа)
	Менеджер = ОбщегоНазначения_МенеджерПоИмени(ПолноеИмяТипа);
	Если Менеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	UUIDСтр = TL_Настройки.ПолучитьЗначение(КлючНастройки, "");
	Если Не ЗначениеЗаполнено(UUIDСтр) Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	Попытка
		Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(UUIDСтр));
	Исключение
		Возврат Менеджер.ПустаяСсылка();
	КонецПопытки;
КонецФункции

&НаСервере
Процедура СохранитьСсылку(КлючНастройки, Ссылка, Описание = "")
	Если ЗначениеЗаполнено(Ссылка) Тогда
		TL_Настройки.УстановитьЗначение(КлючНастройки,
			XMLСтрока(Ссылка.УникальныйИдентификатор()), Описание);
	Иначе
		TL_Настройки.УстановитьЗначение(КлючНастройки, "", Описание);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОбщегоНазначения_МенеджерПоИмени(ПолноеИмя)
	Части = СтрРазделить(ПолноеИмя, ".", Истина);
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части[0] = "Справочник" Тогда
		Возврат Справочники[Части[1]];
	ИначеЕсли Части[0] = "Документ" Тогда
		Возврат Документы[Части[1]];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ДобавитьВЛог(Текст)
	Префикс = "[" + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + "] ";
	Если ПустаяСтрока(ТекстЛога) Тогда
		ТекстЛога = Префикс + Текст;
	Иначе
		ТекстЛога = ТекстЛога + Символы.ПС + Префикс + Текст;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
