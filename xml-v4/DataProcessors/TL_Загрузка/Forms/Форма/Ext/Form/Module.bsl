// Добавить строку во ВнутренниеДанные (левая панель).
//
&НаСервере
Процедура ДобавитьВнутреннюю(КлючЗагрузки, КлючБазовый, ТипДокумента, Дата, Станция, Описание, Сумма, ИнфоДок)
	Стр = ВнутренниеДанные.Добавить();
	Стр.Отметка              = Ложь;
	Стр.КлючЗагрузки        = КлючЗагрузки;
	Стр.КлючБазовый          = КлючБазовый;
	Стр.ТипДокумента         = ТипДокумента;
	Стр.Дата                 = Дата;
	Стр.Станция              = Станция;
	Стр.Описание             = Описание;
	Стр.Сумма                = Сумма;
	Стр.Статус               = ИнфоДок.Статус;
	Стр.ДокументПредставление = Строка(ИнфоДок.Ссылка);

	// Извлечь НомерСмены из ключа: TL|СМЕНА|65|5|91 → Части[4]=91
	Части = СтрРазделить(КлючБазовый, "|");
	Если Части.Количество() >= 5 Тогда
		// Парсим Части[4] как номер. Для ТТН там может быть длинный номер ТТН
		// (>10 цифр) — он не помещается в Число(10,0), оставим 0.
		Попытка
			Знач = Число(Части[4]);
			Если Знач > 9999999999 Тогда
				Стр.НомерСмены = 0; // переполнение, ТТН с длинным номером
			Иначе
				Стр.НомерСмены = Знач;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

